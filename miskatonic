    if name == "bldg2":
        return stone_blocks(rng, "#7a7a7e", "#55555a", 8, 5)
    if name == "bldg3":
        g = grid_of("#c8c4b4")
        for y in range(3, 16, 4):
            rect(g, 0, y, 15, y, "#9a968a")
