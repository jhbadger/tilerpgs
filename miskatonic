    def reset_view(self):
        self.overlay = None
        self.overlay_text = None
        self.end_talk()
        self.busy = False
        self.aim = None
        self.menu = None
        self.walking = None
        self.rite = None

    def restore(self, g):
        self.setup_world(int(g["seed"]))
        p = g["player"]
        for k in ("name", "occ", "chars", "skills", "hp", "san", "mp"):
            if k not in p:
                raise ValueError("bad investigator")
        if p["weapon"] not in WEAPONS:
            raise ValueError("bad weapon")
        self.p = p
        self.flags = set(g.get("flags", []))
        self.clues = list(g.get("clues", []))
        self.topics = set(g.get("topics", []))
        self.leaves = list(g.get("leaves", []))
        self.returned = list(g.get("returned", []))
        self.side = {str(k): dict(v) for k, v in g.get("side", {}).items()}
        self.turn = int(g.get("turn", 0))
        self.lost_count = int(g.get("lost", 0))
        self.city = None
        self.reset_view()
        city = self.get_area(("city",))
        city.seen = unpack_bits(g["seen"], CITY_W * CITY_H)
        self.city_pos = g.get("city_pos")
        self.surface = g.get("surface")
        if self.surface:
            self.surface = (tuple(self.surface[0]), self.surface[1])
        key = tuple(g["key"])
        self.area = self.get_area(key)
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        if self.area.grid[self.pos[1]][self.pos[0]] not in WALKABLE and \
                not (self.p["boat"] and self.area.kind == "city"):
            self.pos = list(self.area.start)
        self.say("Arkham, %s." % self.date_text(), "quest")
        self.say("Welcome back, %s. Press ? for help." % self.p["name"],
                 "info")
        self.layout()
        if "won" in self.flags:
            self.show_won()
        elif self.turn >= DEADLINE:
            self.doom()
        elif self.p["hp"] <= 0 or self.p["san"] <= 0:
            self.investigator_lost("dead" if self.p["hp"] <= 0 else "mad")

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "scale": self.scale}
        if getattr(self, "p", None) and getattr(self, "area", None):
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "clues": self.clues,
                "topics": sorted(self.topics), "leaves": self.leaves,
                "returned": self.returned, "side": self.side,
                "turn": self.turn, "lost": self.lost_count,
                "key": list(self.area.key), "pos": self.pos,
                "city_pos": self.city_pos,
                "surface": [list(self.surface[0]), self.surface[1]]
                if self.surface else None,
                "seen": pack_bits(self.get_area(("city",)).seen)}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.root.destroy()

    # ── Areas ──

    def get_area(self, key):
        if key in self.cache:
            return self.cache[key]
        w = self.world
        if key[0] == "city":
            area = make_city(w, self.flags)
            self.populate_city(area)
            area.lit = {(x + dx, y + dy) for y in range(area.h)
                        for x in range(area.w) if area.grid[y][x] == "lamp"
                        for dx in range(-2, 3) for dy in range(-2, 3)
                        if abs(dx) + abs(dy) <= 3}
        elif key[0] == "bld":
            if key[1] not in SITES:
                raise ValueError("bad site")
            area = make_interior(w, key[1])
            for m in area.mobs:
                self.give_errand(m)
        elif key[0] == "dun":
            lid, level = key[1], int(key[2])
            if lid not in LEADS or not 1 <= level <= LEADS[lid].levels:
                raise ValueError("bad level")
            area = make_dungeon(w, lid, level, self.flags)
            key = area.key
            if lid == "vault" and level == LEADS[lid].levels:
                self.summon(area)
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        return area

    def populate_city(self, area):
        """Townsfolk, the sexton, the boatman and runaway cats."""
        rng = random.Random("%s:folk" % self.world["seed"])
        streets = [(x, y) for y in range(area.h) for x in range(area.w)
                   if area.grid[y][x] == "street" and 6 < x < 86
                   and not (RAIL_Y < y < SOUTH_Y[0])]
        area.folk = []
        doorsteps = {(x + dx, y + dy) for x, y in area.links
                     for dx, dy in DIRS}
        streets = [s for s in streets if s not in doorsteps]
        for i in range(26):
            x, y = rng.choice(streets)
            m = make_folk(self.world, rng, i, x, y)
            area.folk.append(m)
        sexton = make_person(self.world, "sexton", 60, 51)
        sexton.roam, sexton.home = {"grass"}, (60, 51)
        boatman = make_person(self.world, "boatman", DOCK[0] - 1, DOCK[1] + 1)
        area.mobs = list(area.folk) + [sexton, boatman]
        self.release_cats(area)

    def summon(self, area):
        """The circle below the island: the Dweller, and its master."""
        if "won" in self.flags:
            return
        cx = sum(x for x, y in area.circle) // len(area.circle)
        cy = sum(y for x, y in area.circle) // len(area.circle)
        area.mobs = [m for m in area.mobs if (m.x, m.y) not in area.circle]
        d = make_monster("dweller", cx, cy, boss=True)
        d.name = "the Dweller Between"
        area.mobs.append(d)
        spots = [s for s in sorted(area.circle) if s != (cx, cy)]
        if "leader_dead" not in self.flags:
            who = self.world["people"][self.world["leader"]]
            x, y = spots[0]
            m = make_monster("master", x, y)
            m.name = who["name"]
            m.boss = True
            m.hp = m.maxhp = m.hp * 2
            m.leader = True
            area.mobs.append(m)
        for x, y in spots[-2:]:
            area.mobs.append(make_monster("cultist", x, y))

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        if area.kind == "city":
            self.night_and_day()
        self.sound.play(sound)
        self.layout()
        self.save()

    def go_outside(self):
        """Out of a building, onto its doorstep in Arkham."""
        city = self.get_area(("city",))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.enter(city, self.city_pos or city.start)
        self.say("You step out into %s." % district(*self.pos), "info")

    def enter_link(self, link, x, y):
        kind, what = link
        if kind == "bld":
            self.city_pos = list(self.pos)
            area = self.get_area(("bld", what))
            self.say("You go into %s." % area.name, "info")
            self.enter(area, area.start)
            return
        self.at_lead(what, x, y)

    def descend(self, lid):
        if self.area.kind == "city":
            self.city_pos = list(self.pos)
        self.surface = (self.area.key, list(self.pos))
        area = self.get_area(("dun", lid, 1))
        self.say("You go down into %s." % area.name.split(",")[0],
                 "info")
        self.enter(area, area.start, "stairs")
        if area.dark and not self.p["items"].get("flashlight"):
            self.say("It is very dark. A flashlight would help.", "bad")

    def change_level(self, delta):
        _, lid, level = self.area.key
        if level + delta == 0:
            key, pos = self.surface
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dun"}
            area = self.get_area(tuple(key))
            self.say("You climb back up, into the air.", "info")
            self.enter(area, pos, "stairs")
            return
        area = self.get_area(("dun", lid, level + delta))
        self.say("You climb %s to level %d." % (
            "down" if delta > 0 else "up", level + delta), "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        n = int(self.log.index("end").split(".")[0])
        if n > 600:
            self.log.delete("1.0", "%d.0" % (n - 500))
        self.log.config(state="disabled")
        self.log.see("end")

    @staticmethod
    def the(mob):
        return mob.name if mob.boss or mob.role else "the " + mob.name

    # ── Numbers ──

    def max_hp(self):
        c = self.p["chars"]
        return (c["CON"] + c["SIZ"] + 1) // 2

    def max_mp(self):
        return self.p["chars"]["POW"]

    def max_san(self):
        return 99 - self.p["skills"]["Cthulhu Mythos"]

    def luck(self):
        return self.p["chars"]["POW"] * 5

    def db(self):
        c = self.p["chars"]
        return damage_bonus(c["STR"], c["SIZ"])

    def in_dark(self):
        return self.area.kind == "dungeon" or (
            self.area.kind == "city" and self.phase() == "night")

    def skill(self, name):
        """A skill's chance now, after disorders and the dark."""
        v = self.p["skills"].get(name, 0)
        dis = self.p["disorder"]
        if dis == "nyctophobia" and self.in_dark():
            v -= 20
        if dis == "tremors" and name in ("Handgun", "Rifle", "Shotgun",
                                         "Locksmith", "First Aid"):
            v -= 20
        if name == "Locksmith" and self.p["items"].get("lockpicks"):
            v += 20
        if self.area.dark and self.light_radius() <= 2 and name in (
                "Spot Hidden", "Handgun", "Rifle", "Shotgun", "Locksmith",
                "Library Use"):
            v -= 20
        return max(1, v)

    def check(self, name, mod=0, quiet=False):
        """Roll D100 against a skill; ticks the skill when it succeeds."""
        chance = max(1, min(99, self.skill(name) + mod))
        r = random.randint(1, 100)
        ok = r <= chance
        if not quiet:
            self.say("[%s %d%%: %d, %s]" % (name, chance, r,
                                            "success" if ok else "failure"),
                     "roll")
        if ok and name != "Cthulhu Mythos" and name not in self.p["checks"]:
            self.p["checks"].append(name)
        return ok

    def best_check(self, names, mod=0):
        best = max(names, key=lambda s: self.skill(s))
        return self.check(best, mod), best

    def char_roll(self, ch, mult=5, mod=0, label=None):
        chance = max(1, min(99, self.p["chars"][ch] * mult + mod))
        r = random.randint(1, 100)
        ok = r <= chance
        self.say("[%s %d%%: %d, %s]" % (label or "%s x%d" % (ch, mult),
                                        chance, r,
                                        "success" if ok else "failure"),
                 "roll")
        return ok

    # ── Time ──

    def now(self):
        return START + datetime.timedelta(minutes=self.turn)

    def clock(self):
        t = self.now()
        return self.turn // DAY + 1, t.hour

    def date_text(self):
        t = self.now()
        return "%s %d %s 1925, %d:%02d %s" % (
            t.strftime("%a"), t.day, t.strftime("%b"),
            (t.hour - 1) % 12 + 1, t.minute, "am" if t.hour < 12 else "pm")

    def phase(self):
        h = self.now().hour
        return ("night" if h >= 21 or h < 5 else "dawn" if h < 7 else
                "dusk" if h >= 19 else "day")

    def pass_time(self, minutes, quiet=False):
        """Time going by in a lump: research, sleep, treatment."""
        before = self.phase()
        p = self.p
        self.turn += minutes
        p["mp"] = min(self.max_mp(), p["mp"] + minutes // 60)
        ins = p["insane"]
        if ins and ins["kind"] != "faint":
            ins["turns"] -= minutes
            if ins["turns"] <= 0:
                self.end_insanity()
        if not quiet and self.phase() != before:
            self.say("It is %s now: %s." % (self.phase(), self.date_text()),
                     "info")
        self.night_and_day()
        if self.turn >= DEADLINE and "won" not in self.flags:
            self.doom()

    def night_and_day(self):
        """At night most townsfolk go home; they come out in the morning."""
        city = self.cache.get(("city",))
        if not city:
            return
        night = self.phase() == "night"
        here = getattr(self, "area", None)
        folk = [m for m in city.folk if not night or m.night_owl]
        city.mobs = [m for m in city.mobs if m not in city.folk or m in folk]
        for m in folk:
            if m not in city.mobs and not city.mob_at(m.x, m.y):
                city.mobs.append(m)
        if not night:
            px, py = self.pos if here is city else (-99, -99)
            city.mobs = [m for m in city.mobs if not m.hostile or m.boss
                         or abs(m.x - px) + abs(m.y - py) <= 6]

    # ── Turns ──

    def on_key(self, ev):
        if self.talk or self.busy or ev.state & 0x0C:
            return
        k = ev.keysym
        self.walking = None
        if self.menu:
            k = k[3:] if k.startswith("KP_") else k
            if k in ("Up", "w", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "space", "KP_Enter"):
                self.menu_pick()
            elif k.isdigit() and 1 <= int(k) <= len(self.menu["items"]):
                self.menu_pick(int(k) - 1)
            else:
                self.menu_cancel()
            return
        if self.overlay:
            if self.overlay in ("won", "doom") and k in ("n", "N"):
                self.new_game()
            elif self.overlay == "lost":
                self.successor()
            elif self.overlay not in ("won", "doom") or k in ("Escape",
                                                              "Return"):
                self.close_overlay()
            return
        if self.aim:
            if k in MOVE_KEYS:
                self.aimed(*MOVE_KEYS[k])
            else:
                self.aim = None
                self.say("Never mind.", "info")
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("e", "E"):
            self.search()
        elif k in ("f", "F"):
            self.ready_fire()
        elif k in ("r", "R"):
            self.reload()
        elif k in ("c", "C"):
            self.choose_spell()
        elif k in ("u", "U"):
            self.use_menu()
        elif k in ("space", "period", "KP_5"):
            self.wait()
        elif k in ("i", "I"):
            self.show_sheet()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def close_overlay(self):
        if self.overlay == "lost":
            self.successor()
            return
        if self.overlay in ("won", "doom"):
            self.action_menu()
            return
        self.overlay = None
        self.render()

    def ready(self):
        return not (self.busy or self.talk or self.overlay or self.menu)

    def move(self, dx, dy):
        if not self.ready():
            return
        p, a = self.p, self.area
        ins = p["insane"]
        if ins and ins["kind"] == "panic" and random.random() < 0.5:
            dx, dy = random.choice(DIRS)
            self.say("Panic takes your legs!", "mad")
        if p["held"]:
            p["held"] -= 1
            self.say("You struggle in its grip!" if p.get("held_by")
                     else "You struggle to your feet.", "bad")
            self.end_turn()
            return
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if a.kind == "inside":
                self.go_outside()
            elif a.kind == "city":
                side = ("n" if y < 0 else "s" if y >= a.h else
                        "w" if x < 0 else "e")
                self.say(EDGE_ROADS[side] + " Your business is in Arkham, "
                         "for now.", "info")
                self.sound.play("bump")
            else:
                self.bump()
            return
        mob = a.mob_at(x, y)
        if mob:
            if mob.hostile and not mob.dominated:
                if ins and ins["kind"] == "panic":
                    self.say("You can't make yourself face it!", "mad")
                    self.end_turn()
                    return
                self.attack(mob)
                self.end_turn()
            elif mob.cat is not None:
                self.catch_cat(mob)
            elif mob.hostile:
                self.say("%s stands, waiting on your will." %
                         cap(self.the(mob)), "mad")
            else:
                self.start_talk(mob)
            return
        t = a.grid[y][x]
        if t == "counter":
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return
        link = a.links.get((x, y))
        if link and t in ("door", "tomb", "cave", "slab", "hatch"):
            self.enter_link(link, x, y)
            return
        if (x, y) in a.signs or t == "sign_n":
            side = a.signs.get((x, y), "n")
            self.say("A signpost. " + EDGE_ROADS[side], "info")
            return
        if t in ("shelf", "case", "bed", "altar", "stone", "statue",
                 "grave", "grave2", "gate", "coffin", "crate", "house",
                 "house2", "house3", "bldg", "bldg2", "bldg3", "fence"):
            self.touch(t, x, y)
            return
        water = a.kind == "city" and t in WATER
        if water and not p["boat"]:
            self.say("The Miskatonic is cold and deep. You'd need a "
                     "boat.", "info")
            self.sound.play("bump")
            return
        if t not in WALKABLE and not water:
            self.bump()
            return
        if water and a.grid[self.pos[1]][self.pos[0]] not in WATER:
            self.say("You push off in your boat and row.", "info")
        self.pos = [x, y]
        if t == "exit":
            self.go_outside()
            return
        if t == "stairs_down":
            self.change_level(1)
            return
        if t == "stairs_up":
            self.change_level(-1)
            return
        self.step_on(x, y)
        slow = a.kind == "dungeon" and self.underfoot(x, y)
        self.end_turn()
        if slow and not self.busy:
            self.end_turn()

    def bump(self):
        self.say("Blocked.", "info")
        self.sound.play("bump")

    def underfoot(self, x, y):
        """Traps and hazards below; True if wading (slow)."""
        a, p = self.area, self.p
        if (x, y) in a.traps:
            a.traps.discard((x, y))
            a.items[(x, y)] = "trap"
            dmg = roll("1d6")
            p["hp"] -= dmg
            self.say("The floor gives way into a pit! (%d)" % dmg, "bad")
            self.flash(x, y)
            self.sound.play("hurt")
        t = a.grid[y][x]
        if t == "steam":
            dmg = roll("1d3")
            p["hp"] -= dmg
            self.say("Scalding steam! (%d)" % dmg, "bad")
            self.sound.play("hurt")
        elif t == "angle":
            spots = [(sx, sy) for sx, sy in self.floor_spots(a)
                     if abs(sx - x) + abs(sy - y) > 4 and not a.mob_at(sx, sy)]
            if spots:
                self.pos = list(random.choice(spots))
                self.say("The angles of the floor fold. You are somewhere "
                         "else.", "mad")
                if random.random() < 0.4:
                    self.san_check("0", "1", "the folding angles")
        elif t == "pool":
            self.say("You wade through black water.", "info")
            return True
        return False

    @staticmethod
    def floor_spots(a):
        if not hasattr(a, "floor_cache"):
            a.floor_cache = [(x, y) for y in range(a.h) for x in range(a.w)
                             if a.grid[y][x] == "dfloor"]
        return a.floor_cache

    def end_turn(self):
        p, a = self.p, self.area
        before = self.phase()
        self.turn += 1
        now = self.phase()
        if now != before:
            if a.kind == "city":
                self.say({"dawn": "Dawn greys the sky over the river.",
                          "day": "The sun is up over Arkham.",
                          "dusk": "The sun sets. The street lamps come on.",
                          "night": "Night. Arkham's doors are locked; "
                                   "other things are out."}[now], "info")
            self.night_and_day()
        if self.turn % 60 == 0 and p["mp"] < self.max_mp():
            p["mp"] += 1
        if self.turn % 240 == 0 and p["hp"] < self.max_hp() and \
                p["disorder"] != "nightmares":
            p["hp"] += 1
        ins = p["insane"]
        if ins and ins["kind"] != "faint":
            ins["turns"] -= 1
            if ins["turns"] <= 0:
                self.end_insanity()
        if p["hp"] <= 0:
            self.collapse()
            return
        if self.turn >= DEADLINE and "won" not in self.flags:
            self.doom()
            return
        if a.kind == "dungeon":
            px, py = self.pos
            for tx, ty in list(a.traps):
                if abs(tx - px) + abs(ty - py) <= 2 and \
                        random.random() < self.skill("Spot Hidden") / 400:
                    a.traps.discard((tx, ty))
                    a.items[(tx, ty)] = "trap"
                    self.say("You spot a trap in the floor.", "info")
        self.render()
        self.horrors()
        for mob in list(a.mobs):
            if self.overlay:
                return
            if mob not in a.mobs or self.area is not a:
                continue
            if mob.hostile:
                self.monster_act(mob)
                if p["hp"] <= 0:
                    self.collapse()
                    return
            else:
                self.wander(mob)
        self.attacked = self.dodged = False
        if a.kind == "city":
            self.spawn_city()
        self.listen()
        self.render()

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        if a.wards and mob.kind and MONSTERS[mob.kind].san and any(
                abs(x - wx) + abs(y - wy) <= 1 for wx, wy in a.wards):
            return False
        if t in WATER:
            return "swim" in MONSTERS[mob.kind].traits if mob.kind else False
        if a.kind == "city":
            return t in CITY_GROUND
        if a.kind == "inside":
            return t in INSIDE_FLOOR
        return t in DUNGEON_FLOOR and t not in ("stairs_up", "stairs_down")

    def monster_act(self, mob):
        m = MONSTERS[mob.kind]
        if mob.dominated:
            mob.dominated -= 1
            if not mob.dominated:
                self.say("%s shakes off your will!" % cap(self.the(mob)),
                         "bad")
            return
        if "slow" in m.traits and self.turn % 2:
            return
        steps = 2 if "fast" in m.traits else 1
        for _ in range(steps):
            if mob not in self.area.mobs or self.p["hp"] <= 0:
                return
            if self.monster_step(mob, m):
                return

    def monster_step(self, mob, m):
        """One move; True if it attacked (and so is done)."""
        a = self.area
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if not mob.aware:
            if dist <= 2 or ((mob.x, mob.y) in self.visible and dist <= 8 and
                             random.randint(1, 100) > self.skill("Sneak")):
                mob.aware = True
            else:
                self.drift(mob)
                return False
        warded = a.wards and m.san and any(
            abs(mob.x - wx) + abs(mob.y - wy) <= 2 for wx, wy in a.wards)
        if mob.flee > 0 or warded:
            mob.flee = max(0, mob.flee - 1)
            for sx, sy in sorted(DIRS, key=lambda d: -abs(px - mob.x - d[0])
                                 - abs(py - mob.y - d[1])):
                if self.can_go(mob, mob.x + sx, mob.y + sy):
                    mob.x += sx
                    mob.y += sy
                    break
            return False
        if dist == 1:
            self.monster_attack(mob)
            return True
        if "bound" in m.traits:
            if m.ranged and dist <= 6 and random.random() < 0.5 and \
                    self.line_clear(a, mob.x, mob.y, px, py):
                self.monster_ranged(mob)
                return True
            return False
        if (m.ranged and (dx == 0 or dy == 0) and dist <= 6
                and self.line_clear(a, mob.x, mob.y, px, py)
                and random.random() < 0.4):
            self.monster_ranged(mob)
            return True
        if "human" in m.traits and mob.hp < mob.maxhp // 3 and not mob.boss \
                and random.random() < 0.3:
            mob.flee = 6
            self.say("%s turns to run!" % cap(self.the(mob)), "info")
            return False
        chase = dist <= 12
        if "erratic" in m.traits and random.random() < 0.4:
            chase = False
        if chase:
            order = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                           abs(py - mob.y - d[1]) + random.random() * 0.5)
        else:
            order = [random.choice(DIRS)]
        for sx, sy in order[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break
        return False

    def drift(self, mob):
        if random.random() < 0.3:
            sx, sy = random.choice(DIRS)
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy

    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        a = self.area
        if (a.inside(x, y) and a.grid[y][x] in mob.roam
                and not a.mob_at(x, y) and [x, y] != self.pos
                and not any((x + ex, y + ey) in a.links for ex, ey in DIRS)
                and (mob.home is None or abs(x - mob.home[0]) +
                     abs(y - mob.home[1]) <= 5)):
            mob.x, mob.y = x, y

    def listen(self):
        """Listen: hear what comes, before it can be seen."""
        px, py = self.pos
        for m in self.area.mobs:
            if (m.hostile and not m.heard and (m.x, m.y) not in self.visible
                    and abs(m.x - px) + abs(m.y - py) <= 9):
                m.heard = True
                if self.check("Listen", quiet=True):
                    self.say("You hear something %s, %s." % (
                        "shuffling" if not m.kind or "fast" not in
                        MONSTERS[m.kind].traits else "skittering",
                        where((px, py), (m.x, m.y))), "bad")

    def spawn_city(self):
        """At night things come out; more of them as Hallowe'en nears."""
        a = self.area
        px, py = self.pos
        a.mobs = [m for m in a.mobs if not m.hostile or m.boss or
                  abs(m.x - px) + abs(m.y - py) <= 26]
        if self.phase() != "night" or random.random() > 0.04:
            return
        if sum(m.hostile for m in a.mobs) >= 3 + self.clock()[0] // 3:
            return
        day = self.clock()[0]
        dist = district(px, py)
        kinds = ["dog", "thug"]
        if day >= 3:
            kinds += ["cultist"]
        if day >= 4 and dist in ("French Hill", "Easttown"):
            kinds += ["ghoul", "ghoul"]
        if day >= 6:
            kinds += ["cultist", "deepone" if "Rivertown" in dist
                      else "ghoul"]
        if day >= 8:
            kinds += ["byakhee"]
        for _ in range(20):
            x = px + random.randint(-12, 12)
            y = py + random.randint(-12, 12)
            if (not a.inside(x, y) or a.grid[y][x] not in CITY_GROUND
                    or (x, y) in self.visible or a.mob_at(x, y)
                    or abs(x - px) + abs(y - py) < 8):
                continue
            a.mobs.append(make_monster(random.choice(kinds), x, y))
            return

    # ── Fighting ──

    def weapon(self):
        return WEAPONS[self.p["weapon"]]

    def harm(self, mob, dmg, how):
        """Damage to a monster after armour and its nature; how is
        "melee", "firearm", "impale" (a firearm or blade that impales) or
        "magic"."""
        m = MONSTERS[mob.kind]
        if "magic_only" in m.traits and how != "magic":
            return 0
        if "half_firearms" in m.traits and how in ("firearm", "impale") \
                and self.weapon().ammo:
            dmg = (dmg + 1) // 2
        if how != "magic":
            dmg -= m.armour
        return max(0, dmg)

    def attack(self, mob):
        p = self.p
        w = self.weapon()
        if w.ammo:
            if p["loaded"].get(p["weapon"], 0) > 0:
                self.shoot(mob, 1)
                return
            self.say("Click. Empty.", "bad")
            if self.reload(free=True):
                return
            w = WEAPONS["Fists"]
        self.attacked = True
        name = p["weapon"] if not w.skill == "Fist/Punch" else "fists"
        r = random.randint(1, 100)
        chance = self.skill(w.skill)
        ok = r <= chance
        self.say("[%s %d%%: %d, %s]" % (w.skill, chance, r,
                                        "hit" if ok else "miss"), "roll")
        if not ok:
            self.say("You swing at %s and miss." % self.the(mob), "info")
            self.sound.play("miss")
            return
        if w.skill not in p["checks"]:
            p["checks"].append(w.skill)
        dmg = roll(w.dmg) + roll(self.db())
        if w.impale and r <= chance // 5:
            dmg += roll(w.dmg)
            self.say("An impale!", "good")
        dmg = self.harm(mob, max(0, dmg), "impale" if w.impale else "melee")
        self.wound(mob, dmg, "You hit %s with your %s" % (self.the(mob),
                                                           name.lower()
                                                           if name ==
                                                           "fists" else
                                                           name))

    def wound(self, mob, dmg, text):
        if dmg <= 0:
            self.say(text + ", to no effect!", "bad")
            self.sound.play("miss")
            return
        mob.hp -= dmg
        mob.aware = True
        self.flash(mob.x, mob.y)
        if mob.hp <= 0:
            self.say(text + ". (%d)" % dmg, "good")
            self.kill(mob)
        else:
            self.say(text + ". (%d)" % dmg, "good")
            self.sound.play("hit")

    def kill(self, mob):
        a = self.area
        if mob in a.mobs:
            a.mobs.remove(mob)
        m = MONSTERS[mob.kind]
        human = "human" in m.traits
        self.say("%s %s." % (cap(self.the(mob)),
                             "falls, and is still" if human else
                             "is destroyed" if mob.kind in (
                                 "zombie", "dweller") else "dies"), "good")
        self.sound.play("kill")
        if getattr(mob, "leaf", None):
            a.items[(mob.x, mob.y)] = "leaf"
            self.say("Something falls from it: a leaf of old parchment.",
                     "gold")
        if mob.leader:
            self.flags.add("leader_dead")
            self.say("The master of the Pale Lantern is dead.", "quest")
        if mob.boss and m.san:
            gain = roll("1d6")
            self.gain_san(gain, "for %s %s" % (
                "stopping" if human else "destroying", self.the(mob)))
        elif human and mob.kind != "madman":
            self.san_check("0", "1", "killing a man")

    def monster_attack(self, mob):
        p = self.p
        m = MONSTERS[mob.kind]
        name = cap(self.the(mob))
        if random.randint(1, 100) > m.atk:
            self.say("%s attacks and misses." % name, "info")
            return
        if not self.attacked and not self.dodged:
            self.dodged = True
            if self.check("Dodge"):
                self.say("%s lunges; you dodge aside." % name, "good")
                self.sound.play("miss")
                return
        dmg = max(1, roll(m.dmg))
        self.hurt(dmg, "%s hits you" % name)
        if "grab" in m.traits and p["hp"] > 0:
            p["held"] = 1
            p["held_by"] = True
            self.say("It seizes you, and its claws tickle horribly!",
                     "bad")

    def hurt(self, dmg, text):
        p = self.p
        p["hp"] -= dmg
        self.say("%s! (%d)" % (text, dmg), "bad")
        self.flash(*self.pos)
        self.sound.play("hurt")
        if self.rite is not None:
            self.rite["hit"] = True
        if p["hp"] > 0 and dmg >= (self.max_hp() + 1) // 2:
            self.say("A major wound.", "bad")
            if not self.char_roll("CON"):
                p["held"] = 1
                p["held_by"] = False
                self.say("You are knocked to the ground.", "bad")

    def monster_ranged(self, mob):
        m = MONSTERS[mob.kind]
        chance, dmg = m.ranged
        what = {"cultist": "fires a revolver", "master": "points and "
                "speaks a word", "migo": "aims a humming tube",
                "witch": "spits a curse",
                "dweller": "lashes out with something like light"}.get(
                    mob.kind, "shoots")
        name = cap(self.the(mob))
        self.sound.play("shot" if mob.kind == "cultist" else "spell")
        self.fly(self.line_path((mob.x, mob.y), tuple(self.pos)), "bullet"
                 if mob.kind == "cultist" else "bolt")
        if random.randint(1, 100) > chance:
            self.say("%s %s at you, and misses." % (name, what), "info")
            return
        self.hurt(roll(dmg), "%s %s at you" % (name, what))

    def collapse(self):
        """At 0 hit points or below: unconscious, or dead."""
        p = self.p
        self.rite = None
        self.walking = None
        if p["hp"] <= -2:
            self.investigator_lost("dead")
            return
        self.say("You fall, and the world goes dark...", "bad")
        self.sound.play("death")
        if self.area.kind == "dungeon" and not self.char_roll(
                "POW", 5, label="Luck"):
            self.investigator_lost("dead")
            return
        self.wake_in_hospital()

    def wake_in_hospital(self, days=1):
        p = self.p
        bill = 10
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        hours = (24 * days + 8 - self.now().hour) % 24 or 24
        self.pass_time(hours * 60 + (days - 1) * DAY, quiet=True)
        if "won" in self.flags or self.turn >= DEADLINE:
            return
        p["hp"] = max(1, min(self.max_hp(), 1 + roll("1d3")))
        p["held"] = 0
        paid = min(bill, p["cash"])
        p["cash"] -= paid
        p["savings"] = max(0, p["savings"] - (bill - paid))
        area = self.get_area(("bld", "hospital"))
        self.city_pos = list(self.door_of("hospital"))
        bed = next((x, y + 1) for y in range(area.h) for x in range(area.w)
                   if area.grid[y][x] == "bed" and
                   area.grid[y + 1][x] in INSIDE_FLOOR)
        self.area, self.pos = area, list(bed)
        self.say("You wake in St. Mary's Hospital, %s. Someone found you "
                 "and brought you in. The bill is $%d." % (
                     self.date_text(), bill), "quest")
        self.layout()
        self.save()

    def door_of(self, sid):
        city = self.get_area(("city",))
        for pos, link in city.links.items():
            if link == ("bld", sid):
                return pos[0], pos[1] + 1
        return city.start

    # ── Firearms ──

    def ready_fire(self):
        if not self.ready():
            return
        p = self.p
        w = self.weapon()
        if not w.ammo:
            guns = [g for g in p["weapons"] if WEAPONS[g].ammo]
            if not guns:
                self.say("You have no gun.", "info")
                return
            p["weapon"] = guns[-1]
            self.say("You draw your %s." % guns[-1], "info")
            w = self.weapon()
        if p["loaded"].get(p["weapon"], 0) <= 0:
            if not self.reload():
                self.say("You have no %s." % w.ammo, "bad")
            return
        self.aim = ("fire",)
        self.say("Fire which way? (arrow keys, or tap)", "info")

    def reload(self, free=False):
        """Load the gun from the box; costs the turn."""
        p = self.p
        w = self.weapon()
        if not w.ammo:
            return False
        have = p["items"].get(w.ammo, 0)
        need = w.cap - p["loaded"].get(p["weapon"], 0)
        if need <= 0 or have <= 0:
            if need <= 0 and not free:
                self.say("It's loaded.", "info")
            return False
        n = min(need, have)
        p["items"][w.ammo] = have - n
        p["loaded"][p["weapon"]] = p["loaded"].get(p["weapon"], 0) + n
        self.say("You reload the %s (%d)." % (p["weapon"],
                                              p["loaded"][p["weapon"]]),
                 "info")
        if not free:
            self.end_turn()
        return True

    def aimed(self, dx, dy):
        what = self.aim
        self.aim = None
        if what[0] == "fire":
            self.fire(dx, dy)
        else:
            self.cast_at(what[1], dx, dy)

    def target_in_line(self, dx, dy, reach):
        a = self.area
        x, y = self.pos
        path = []
        for _ in range(reach):
            x, y = x + dx, y + dy
            if not a.inside(x, y) or a.grid[y][x] in a.opaque or (
                    a.grid[y][x] not in WALKABLE and a.grid[y][x] not in
                    WATER and a.grid[y][x] not in ("counter", "table",
                                                   "pew", "coffin", "crate",
                                                   "grave", "grave2")):
                break
            path.append((x, y))
            mob = a.mob_at(x, y)
            if mob:
                return mob, path
        return None, path

    def fire(self, dx, dy):
        w = self.weapon()
        mob, path = self.target_in_line(dx, dy, w.range)
        if mob is None:
            self.p["loaded"][self.p["weapon"]] -= 1
            self.say("You fire, and hit nothing.", "info")
            self.sound.play("shot")
            self.noise()
            self.fly(path, "bullet")
            self.end_turn()
            return
        dist = abs(mob.x - self.pos[0]) + abs(mob.y - self.pos[1])
        self.fly(path, "bullet")
        self.shoot(mob, dist)
        self.end_turn()

    def shoot(self, mob, dist):
        p = self.p
        w = self.weapon()
        self.attacked = True
        p["loaded"][p["weapon"]] -= 1
        self.sound.play("shot")
        self.noise()
        if not mob.hostile:
            self.say("You hold your fire: that's a person.", "info")
            p["loaded"][p["weapon"]] += 1
            return
        r = random.randint(1, 100)
        chance = self.skill(w.skill) + (20 if dist <= 1 else 0)
        if r >= 99:
            self.say("[%s %d%%: %d, a fumble] The gun jams; you clear it."
                     % (w.skill, chance, r), "bad")
            return
        ok = r <= chance
        self.say("[%s %d%%: %d, %s]" % (w.skill, min(99, chance), r,
                                        "hit" if ok else "miss"), "roll")
        if not ok:
            self.say("You fire at %s and miss." % self.the(mob), "info")
            return
        if w.skill not in p["checks"]:
            p["checks"].append(w.skill)
        dice = w.dmg
        if w.skill == "Shotgun":
            dice = "4d6" if dist <= 2 else "2d6" if dist <= 4 else "1d6"
        dmg = roll(dice)
        if w.impale and r <= chance // 5:
            dmg += roll(dice)
            self.say("An impale!", "good")
        dmg = self.harm(mob, dmg, "impale" if w.impale else "firearm")
        self.wound(mob, dmg, "You shoot %s" % self.the(mob))

    def noise(self):
        """A gunshot wakes the dark, and in daylight calls the police."""
        a = self.area
        px, py = self.pos
        for m in a.mobs:
            if m.hostile and abs(m.x - px) + abs(m.y - py) <= 14:
                m.aware = True
        if a.kind != "dungeon" and self.phase() != "night" and \
                not any(m.hostile for m in a.mobs if (m.x, m.y) in
                        self.visible) and not self.char_roll(
                    "POW", 5, label="Luck"):
            fine = 5
            self.p["cash"] = max(0, self.p["cash"] - fine)
            self.say("A police whistle! An officer fines you $%d for "
                     "discharging a firearm within the town limits." % fine,
                     "bad")

    def fly(self, path, tile):
        """A shot or a spell crossing the squares between."""
        cols, rows, ox, oy, ts = self.view
        c = self.canvas
        for x, y in path[:12]:
            i = x - self.pos[0] + cols // 2
            j = y - self.pos[1] + rows // 2
            if 0 <= i < cols and 0 <= j < rows:
                c.coords(self.missile, ox + i * ts, oy + j * ts)
                c.itemconfig(self.missile, image=self.img[tile],
                             state="normal")
                c.tag_raise(self.missile)
                c.update_idletasks()
                time.sleep(0.025)
        c.itemconfig(self.missile, state="hidden")

    @staticmethod
    def line_path(a, b):
        (x0, y0), (x1, y1) = a, b
        n = max(abs(x1 - x0), abs(y1 - y0))
        return [(x0 + round((x1 - x0) * k / n), y0 + round((y1 - y0) * k / n))
                for k in range(1, n + 1)] if n else []

    # ── Sanity ──

    def horrors(self):
        """The first sight of each kind of horror here costs Sanity."""
        a = self.area
        for m in a.mobs:
            if not m.hostile or (m.x, m.y) not in self.visible:
                continue
            mon = MONSTERS[m.kind]
            if not mon.san or m.kind in a.san_seen:
                continue
            a.san_seen.add(m.kind)
            first = "seen:" + m.kind not in self.flags
            self.flags.add("seen:" + m.kind)
            self.say("You see %s%s." % (
                "it: " if m.boss else "", self.the(m) if m.boss else
                "a " + m.name), "bad" if first else "info")
            if first and mon.hint and (
                    self.p["skills"]["Cthulhu Mythos"] > 0 and
                    self.check("Cthulhu Mythos", quiet=True)) or (
                    m.kind == "dweller" and first):
                self.say("You know it: %s." % mon.hint, "mad")
            self.san_check(*mon.san, what=m.name)
            if self.p["san"] <= 0:
                return

    def san_check(self, made, missed, what=""):
        p = self.p
        r = random.randint(1, 100)
        ok = r <= p["san"]
        self.say("[Sanity %d: %d, %s]" % (p["san"], r,
                                          "made" if ok else "missed"),
                 "roll")
        n = roll(made if ok else missed)
        if n > 0:
            self.lose_san(n, what)
        elif ok:
            self.say("You keep your head.", "info")

    def lose_san(self, n, what=""):
        p = self.p
        before = p["san"]
        p["san"] -= n
        p["sanlog"] = [e for e in p["sanlog"] if self.turn - e[0] < 60]
        p["sanlog"].append([self.turn, n, before])
        self.say("You lose %d Sanity%s." % (n, " (%s)" % what if what else
                                            ""), "mad")
        self.sound.play("horror")
        if p["san"] <= 0:
            p["san"] = 0
            self.investigator_lost("mad")
            return
        if n >= 5 and not p["insane"]:
            self.say("Too much at once.", "mad")
            if self.char_roll("INT", 5, label="Idea"):
                self.go_insane()
        hour = p["sanlog"]
        if not p["disorder"] and sum(e[1] for e in hour) >= max(
                1, hour[0][2] // 5):
            p["disorder"] = random.choice(("nyctophobia", "paranoia",
                                           "tremors", "nightmares"))
            self.say("Something gives way inside you: %s. Only treatment "
                     "at the Sanitarium will mend it." % {
                         "nyctophobia": "a terror of the dark",
                         "paranoia": "you trust no one now",
                         "tremors": "your hands will not stop shaking",
                         "nightmares": "you will dream of this, every "
                                       "night"}[p["disorder"]], "mad")

    def gain_san(self, n, why=""):
        p = self.p
        old = p["san"]
        p["san"] = min(self.max_san(), p["san"] + n)
        if p["san"] > old:
            self.say("You regain %d Sanity%s." % (p["san"] - old,
                                                   " " + why if why else ""),
                     "good")

    def go_insane(self):
        """Temporary insanity: you understand what you saw."""
        kind = random.choice(("faint", "panic", "babble", "hallucinate"))
        turns = {"faint": roll("1d6+2"), "panic": roll("1d6+3"),
                 "babble": roll("1d10") * 10,
                 "hallucinate": roll("1d10") * 10}[kind]
        self.p["insane"] = {"kind": kind, "turns": turns}
        self.say({"faint": "You faint dead away.",
                  "panic": "Panic! You must get away!",
                  "babble": "You are babbling. You can't stop. Nobody can "
                            "understand you.",
                  "hallucinate": "The faces around you are changing. "
                                 "Aren't they?"}[kind], "mad")
        if kind == "faint":
            self.walking = None
            self.busy = True
            self.root.after(300, self.faint_step, turns)

    def faint_step(self, n):
        if self.p["hp"] <= 0 or self.overlay:
            self.busy = False
            return
        if n <= 0:
            self.busy = False
            self.end_insanity()
            self.render()
            return
        self.busy = False
        self.end_turn()
        if self.p["hp"] > 0 and not self.overlay:
            self.busy = True
            self.root.after(250, self.faint_step, n - 1)

    def end_insanity(self):
        ins = self.p["insane"]
        self.p["insane"] = None
        if ins:
            self.say({"faint": "You come to.",
                      "panic": "The panic ebbs. You can think again.",
                      "babble": "You can make words again.",
                      "hallucinate": "The faces settle back into "
                                     "faces."}[ins["kind"]], "good")

    def investigator_lost(self, why):
        """Dead, or mad beyond help: the case passes to another."""
        p = self.p
        self.busy = False
        self.rite = None
        self.menu = None
        self.end_talk()
        self.walking = None
        self.lost_count += 1
        self.sound.play("death")
        if why == "dead":
            text = ("%s IS DEAD.\n\nThe Advertiser will call it an "
                    "accident. Dr. Armitage\nwill know better." % p["name"])
        else:
            text = ("%s IS INSANE.\n\nThe Arkham Sanitarium has a quiet "
                    "room for\nthose who have seen too much. %s will not\n"
                    "leave it." % (p["name"], p["name"]))
        days = max(0, (DEADLINE - self.turn) // DAY)
        self.overlay = "lost"
        self.overlay_text = text + (
            "\n\nBut the case is not over. A friend takes up\nthe notes, "
            "the journal and the clues.\n%d days remain before "
            "Hallowe'en.\n\nPress any key to create the next investigator."
            % days)
        self.save()
        self.render()

    def successor(self):
        self.overlay = None
        who = self.ask_investigator("The next investigator")
        if who is None:
            who = ("Investigator", "Private Investigator",
                   {c: roll(CHAR_DICE[c]) for c in CHARS})
        self.p = self.make_investigator(*who)
        if self.leaves:
            self.say("The police found %s among your predecessor's things, "
                     "and took %s to Dr. Armitage." % (
                         " and ".join(self.world["leaves"][lid]
                                      for lid in self.leaves),
                         "them" if len(self.leaves) > 1 else "it"),
                     "quest")
            for lid in self.leaves:
                self.returned.append(lid)
                self.flags.add("back:" + lid)
            self.leaves = []
            self.armitage_teaches(quiet=True)
        self.cache = {}
        self.surface = None
        self.reset_view()
        self.pass_time((24 + 8 - self.now().hour) * 60, quiet=True)
        area = self.get_area(("bld", "boarding"))
        self.area, self.pos = area, list(self.bed_spot(area))
        self.city_pos = list(self.door_of("boarding"))
        self.say("%s, %s, takes the room on French Hill and the dead "
                 "investigator's notes. %s." % (
                     self.p["name"], self.p["occ"].lower(),
                     self.date_text()), "quest")
        self.layout()
        self.save()

    def doom(self):
        if self.overlay == "doom":
            return
        self.flags.add("doom")
        self.busy = False
        self.menu = None
        self.end_talk()
        self.overlay = "doom"
        self.overlay_text = (
            "MIDNIGHT, HALLOWE'EN.\n\nOn the river island the Pale Lantern "
            "sings,\nand the door in the stone opens.\n\nWhat comes through "
            "is not a thing that Arkham\nwill survive, or remember.\n\n"
            "Leaves returned to Dr. Armitage: %d of 4.\n\nPress N for a new "
            "case." % len(self.returned))
        self.sound.play("horror")
        self.render()

    def show_won(self):
        self.overlay = "won"
        self.overlay_text = (
            "THE DOOR IS CLOSED.\n\nThe Rite of Dismissal echoes under the "
            "island,\nand the Dweller Between goes back to where\nit "
            "belongs. The lantern goes out.\n\nArkham wakes on the 1st of "
            "November to rain,\nand never knows.\n\n%s, %s, with %d "
            "Sanity left%s.\n\nPress N for a new case, or Escape to walk\n"
            "Arkham a while longer." % (
                self.p["name"], self.p["occ"].lower(), self.p["san"],
                "" if not self.lost_count else
                " (%d investigator%s lost)" % (
                    self.lost_count, "s" if self.lost_count > 1 else "")))
        self.render()

    # ── Magic ──

    def choose_spell(self):
        if not self.ready():
            return
        sp = self.p["spells"]
        if not sp:
            self.say("You know no spells. Dr. Armitage may teach you; some "
                     "books might.", "info")
            return
        self.open_menu("Cast which spell? (MP %d)" % self.p["mp"], [
            ("%s (%d MP, %s): %s" % (n, SPELLS[n]["mp"], "%s Sanity" %
                                     SPELLS[n]["san"], SPELLS[n]["desc"]),
             lambda n=n: self.cast(n)) for n in sp])

    def cast(self, name):
        s = SPELLS[name]
        p = self.p
        if p["mp"] < s["mp"]:
            self.say("You haven't the strength: %s needs %d magic points."
                     % (name, s["mp"]), "bad")
            return
        if name == "Rite of Dismissal":
            self.begin_rite()
            return
        if s["aim"]:
            self.aim = ("spell", name)
            self.say("Cast %s which way?" % name, "info")
            return
        p["mp"] -= s["mp"]
        self.lose_san(roll(s["san"]), name)
        if p["san"] <= 0:
            return
        if name == "Elder Sign":
            self.area.wards.add(tuple(self.pos))
            self.area.items[tuple(self.pos)] = "ward"
            self.say("You trace the Elder Sign; it glows, and holds.",
                     "good")
            self.sound.play("spell")
        self.end_turn()

    def cast_at(self, name, dx, dy):
        p = self.p
        s = SPELLS[name]
        mob, path = self.target_in_line(dx, dy, 8)
        p["mp"] -= s["mp"]
        self.sound.play("spell")
        self.fly(path, "bolt")
        self.lose_san(roll(s["san"]), name)
        if p["san"] <= 0:
            return
        if mob is None:
            self.say("The spell goes nowhere.", "info")
        elif name == "Shrivelling":
            self.attacked = True
            mob.aware = True
            if mob.hostile:
                self.wound(mob, self.harm(mob, roll("2d6"), "magic"),
                           "%s shrivels and blackens" % cap(self.the(mob)))
            else:
                self.say("You can't bring yourself to do that to a "
                         "person.", "info")
        elif name == "Dominate":
            pow_ = MONSTERS[mob.kind].pow if mob.kind else 10
            chance = resistance(p["chars"]["POW"], pow_)
            r = random.randint(1, 100)
            self.say("[POW %d against %d: %d%%: %d]" % (
                p["chars"]["POW"], pow_, chance, r), "roll")
            if r <= chance and mob.kind != "dweller":
                mob.dominated = 20
                self.say("%s is yours, for now." % cap(self.the(mob)),
                         "good")
            else:
                self.say("%s resists your will." % cap(self.the(mob)),
                         "bad")
        self.end_turn()

    def begin_rite(self):
        a = self.area
        x, y = self.pos
        if not (a.kind == "dungeon" and getattr(a, "circle", None) and any(
                (x + dx, y + dy) in a.circle for dx, dy in DIRS + ((0, 0),))):
            self.say("The Rite must be spoken in the stone circle below "
                     "the island, or at its threshold.", "info")
            return
        if not any(m.kind == "dweller" for m in a.mobs):
            self.say("There is nothing here to dismiss.", "info")
            return
        self.p["mp"] -= SPELLS["Rite of Dismissal"]["mp"]
        self.say("You begin the Rite of Dismissal: Ashcroft's four "
                 "leaves, in four tongues...", "quest")
        self.rite = {"step": 0, "hit": False}
        self.busy = True
        self.walking = None
        self.root.after(500, self.rite_step)

    def rite_step(self):
        r = self.rite
        if r is None:
            self.busy = False
            return
        self.sound.play("chant")
        self.busy = False
        self.end_turn()
        if self.rite is None or self.overlay:
            self.busy = False
            return
        if r["hit"]:
            r["hit"] = False
            self.say("Pain! Do you keep chanting?", "bad")
            if not self.char_roll("POW", 5, label="POW x5"):
                self.say("The words are gone. The Rite is broken. (Cast it "
                         "again.)", "bad")
                self.rite = None
                return
        r["step"] += 1
        self.say(("The first verse. The air thickens.",
                  "The second verse. The circle burns green.",
                  "The third verse. The Dweller howls.")[r["step"] - 1],
                 "quest")
        if r["step"] < 3:
            self.busy = True
            self.root.after(600, self.rite_step)
            return
        self.rite = None
        self.lose_san(roll(SPELLS["Rite of Dismissal"]["san"]),
                      "the Rite of Dismissal")
        if self.p["san"] <= 0:
            return
        a = self.area
        for m in list(a.mobs):
            if m.kind == "dweller":
                a.mobs.remove(m)
            elif m.hostile and "human" in MONSTERS[m.kind].traits:
                m.flee = 99
        self.flags.add("won")
        self.say("It goes. It goes back. The door is shut.", "quest")
        self.sound.play("quest")
        self.gain_san(roll("2d10"), "for closing the door")
        self.save()
        self.show_won()

    # ── Things ──

    def use_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        for n in ("first aid kit", "laudanum", "whiskey", "elder sign"):
            if p["items"].get(n):
                items.append(("%s (%d): %s" % (cap(n), p["items"][n],
                                               ITEMS[n]),
                              lambda n=n: self.use(n)))
        for b in p["books"]:
            items.append(("Read %s%s" % (b, " (again)" if b in p["read"]
                                         else ""),
                          lambda b=b: self.read(b)))
        for w in p["weapons"]:
            if w != p["weapon"]:
                wp = WEAPONS[w]
                items.append(("Ready %s (%s%s)" % (
                    w, wp.dmg, ", %d loaded" % p["loaded"].get(w, 0)
                    if wp.ammo else ""), lambda w=w: self.ready_weapon(w)))
        if not items:
            self.say("You have nothing to use.", "info")
            return
        self.open_menu("Use what?", items)

    def ready_weapon(self, w):
        self.p["weapon"] = w
        self.say("You ready your %s." % w.lower() if w == "Fists" else
                 "You ready the %s." % w, "info")
        self.render_chrome()

    def use(self, n):
        p = self.p
        if n == "first aid kit":
            if p["hp"] >= self.max_hp():
                self.say("You aren't hurt.", "info")
                return
            p["items"][n] -= 1
            ok, skill = self.best_check(("First Aid", "Medicine"))
            if ok:
                heal = roll("1d3") + (1 if skill == "Medicine" else 0)
                p["hp"] = min(self.max_hp(), p["hp"] + heal)
                self.say("You bind your wounds. (+%d)" % heal, "good")
            else:
                self.say("You fumble with the bandages; little good comes "
                         "of it.", "info")
        elif n in ("laudanum", "whiskey"):
            p["items"][n] -= 1
            self.say("You take a %s." % ("few drops" if n == "laudanum"
                                         else "long pull"), "info")
            if p["insane"]:
                self.end_insanity()
            if "calm:%d" % self.clock()[0] not in self.flags:
                self.flags.add("calm:%d" % self.clock()[0])
                self.gain_san(1, "as your nerves settle")
            self.sound.play("potion")
        elif n == "elder sign":
            if self.area.kind != "dungeon":
                self.say("Better kept for the dark places.", "info")
                return
            p["items"][n] -= 1
            self.area.wards.add(tuple(self.pos))
            self.area.items[tuple(self.pos)] = "ward"
            self.say("You set down the star-stone. Things of the Mythos "
                     "will not come near it.", "good")
        if p["items"].get(n) == 0:
            del p["items"][n]
        self.end_turn()

    def read(self, title):
        """Hours with a book: occult lore, the Mythos, maybe a spell."""
        p = self.p
        b = BOOKS[title]
        if self.area.kind == "dungeon":
            self.say("Not here. Not in the dark, with them about.", "info")
            return
        again = title in p["read"]
        if again and (not b.spell or b.spell in p["spells"]):
            self.say("You have learned all %s has to teach." % title, "info")
            return
        self.say("You read %s for %d hours..." % (title, b.hours), "info")
        self.pass_time(b.hours * 60, quiet=True)
        if b.lang == "Latin" and not again and not self.check("Latin", 10):
            self.say("The Latin defeats you. Perhaps another time.", "bad")
            return
        if not again:
            p["read"].append(title)
            self.say(b.desc, "info")
            if b.occult:
                p["skills"]["Occult"] = min(99, p["skills"]["Occult"] +
                                            b.occult)
                self.say("Occult +%d." % b.occult, "good")
            if b.mythos:
                self.gain_mythos(b.mythos)
            if b.san != "0":
                self.lose_san(roll(b.san), title)
                if p["san"] <= 0:
                    return
        if b.spell and b.spell not in p["spells"]:
            if self.char_roll("INT", 3, label="INT x3"):
                p["spells"].append(b.spell)
                self.say("You learn a spell: %s." % b.spell, "quest")
            else:
                self.say("There is a spell in it, %s, but you can't make "
                         "sense of it yet." % b.spell, "info")
        self.render()

    def gain_mythos(self, n):
        p = self.p
        p["skills"]["Cthulhu Mythos"] = min(99, p["skills"]["Cthulhu Mythos"]
                                            + n)
        self.say("Cthulhu Mythos +%d. Your maximum Sanity falls to %d." % (
            n, self.max_san()), "mad")
        p["san"] = min(p["san"], self.max_san())

    # ── Searching, reading, touching ──

    def search(self):
        if not self.ready():
            return
        a = self.area
        px, py = self.pos
        near = [(x, y) for (x, y) in a.hidden
                if abs(x - px) + abs(y - py) <= 3]
        traps = [(x, y) for (x, y) in a.traps
                 if abs(x - px) + abs(y - py) <= 3]
        cave = (a.kind == "city" and abs(CAVE[0] - px) + abs(CAVE[1] - py)
                <= 4 and a.grid[CAVE[1]][CAVE[0]] != "cave" and
                "woods" in self.world["leads"])
        self.say("You search carefully.", "info")
        if not self.check("Spot Hidden"):
            self.say("You find nothing.", "info")
        else:
            found = False
            for pos in near:
                a.items[pos] = a.hidden.pop(pos)
                found = True
            for pos in traps:
                a.traps.discard(pos)
                a.items[pos] = "trap"
                found = True
            if cave:
                a.grid[CAVE[1]][CAVE[0]] = "cave"
                self.flags.add("found:cave")
                self.learn("woods_known")
                self.say("Behind a screen of brambles: the mouth of a cave.",
                         "gold")
                found = True
            if near or traps:
                self.say("You find something!" if near else
                         "You find a hidden trap.", "gold")
            elif not found:
                self.say("There's nothing here to find.", "info")
        if not any(m.hostile for m in a.mobs if (m.x, m.y) in self.visible):
            self.turn += 4
        self.end_turn()

    def step_on(self, x, y):
        """Things on the floor are picked up (or looked at)."""
        a, p = self.area, self.p
        thing = a.items.get((x, y))
        if not thing or thing in ("trap", "ward"):
            return
        if thing == "bones":
            key = "bones:%s:%d:%d" % (a.key, x, y)
            if key in self.flags:
                return
            self.flags.add(key)
            if getattr(a, "diary_bones", None) == (x, y):
                self.say("A man's body, weeks dead, in the rags of a good "
                         "tweed suit. Professor Ashcroft.", "bad")
                self.san_check("1", "1d6", "Ashcroft's body")
            else:
                self.say("Human bones, gnawed.", "bad")
                self.san_check("0", "1d3", "gnawed bones")
            return
        del a.items[(x, y)]
        if thing == "leaf":
            lid = a.lead
            self.leaves.append(lid)
            self.flags.add("leaf:" + lid)
            self.say("You take %s: four columns of crabbed writing, still "
                     "warm. Bring it to Dr. Armitage." %
                     self.world["leaves"][lid], "quest")
            self.sound.play("quest")
        elif thing == "note":
            self.say(getattr(a, "note", "A scrap of paper, illegible."),
                     "talk")
            self.flags.add("note:%s" % (a.key,))
        elif thing == "book":
            self.flags.add("diary")
            self.learn("diary")
            self.say("Ashcroft's diary. The last entry: 'It is %s. I have "
                     "seen the face under the hood. God help Arkham.'" %
                     self.world["people"][self.world["leader"]]["name"],
                     "quest")
            self.sound.play("gold")
        elif thing == "cash":
            n = roll("1d10+2")
            p["cash"] += n
            self.say("You find $%d." % n, "gold")
            self.sound.play("gold")
        elif thing == "ammo":
            kind = random.choice(list(AMMO))
            n = AMMO[kind][0] // 2
            p["items"][kind] = p["items"].get(kind, 0) + n
            self.say("You find %d %s." % (n, kind), "gold")
            self.sound.play("gold")
        elif thing == "kit":
            p["items"]["first aid kit"] = p["items"].get("first aid kit",
                                                         0) + 1
            self.say("You find a first aid kit.", "gold")
            self.sound.play("gold")
        elif thing == "key":
            self.say("You find a key.", "gold")

    def touch(self, t, x, y):
        """Walking into the furniture of the world."""
        a = self.area
        if t == "shelf" and a.kind == "inside" and \
                SITES[a.site][1] in RESEARCH_WHERE:
            self.research_menu()
        elif t == "shelf":
            self.say("Shelves of %s." % {"bookshop": "old books, dusty",
                                         "drugstore": "bottles and tins",
                                         "hardware": "tools and rope",
                                         "science": "glassware",
                                         "arts": "lecture notes"}.get(
                SITES[a.site][1] if a.site else "", "this and that"),
                "info")
        elif t == "case" and a.site == "library":
            self.necronomicon()
        elif t == "case":
            self.say(random.choice((
                "A Ponape figurine: a squat thing with a face of "
                "tentacles.",
                "A tiara of strange gold, from Innsmouth, 1873.",
                "Arrowheads from Meadow Hill.",
                "A stone with a five-pointed star cut in it.",
                "A mummified hand, labelled 'Witch of Salem (?)'.")), "info")
        elif t == "bed":
            self.bed_menu()
        elif t == "altar":
            self.say("The altar. Candles and a brass cross.", "info")
        elif t in ("coffin", "crate"):
            self.open_loot(x, y)
        elif t == "gate":
            self.gate(x, y)
        elif t == "stone":
            self.say("A standing stone, older than Arkham, cold as winter. "
                     "Its carvings move when you aren't looking.", "info")
        elif t == "statue":
            self.say("A statue: %s." % a.labels.get((x, y), "someone "
                                                     "important"), "info")
        elif t in ("grave", "grave2"):
            self.say("A grave: %s %s, %d-%d." % (
                random.choice(MALE + FEMALE), random.choice(SURNAMES),
                random.randint(1690, 1860), random.randint(1700, 1900)),
                "info")
        elif t.startswith("house"):
            self.say("A private house. The curtains are drawn.", "info")
        else:
            self.bump()

    def open_loot(self, x, y):
        a = self.area
        if (x, y) not in a.loot:
            self.bump()
            return
        a.loot.discard((x, y))
        a.grid[y][x] = "rubble"
        self.flags.add("loot:%s:%d:%d:%d" % (a.key[1], a.key[2], x, y))
        what = "coffin" if a.skin.get("dwall") in ("dwall_crypt",
                                                   "dwall_vault") else "crate"
        self.say("You pry open the %s." % what, "info")
        r = random.random()
        if what == "coffin" and r < 0.3:
            self.say("Inside, someone who should be dead, and is "
                     "not quite.", "bad")
            self.san_check("0", "1d4", "the coffin")
            a.mobs.append(make_monster("zombie", x, y))
            a.grid[y][x] = "dfloor"
        elif r < 0.55:
            self.step_reward(random.choice(("cash", "ammo", "kit")))
        elif r < 0.7:
            self.say("Bones, and nothing else.", "info")
        else:
            self.say("Empty.", "info")
        self.end_turn()

    def step_reward(self, thing):
        a = self.area
        a.items[tuple(self.pos)] = thing
        self.step_on(*self.pos)

    def gate(self, x, y):
        a = self.area
        self.open_menu("An iron gate, locked. Beyond it, the end of "
                       "this place.", [
                           ("Pick the lock (Locksmith %d%%)" %
                            self.skill("Locksmith"),
                            lambda: self.try_gate(x, y, "pick")),
                           ("Force it (STR x5: %d%%)" % min(
                               99, self.p["chars"]["STR"] * 5 +
                               (20 if "Crowbar" in self.p["weapons"]
                                else 0)), lambda: self.try_gate(x, y,
                                                                 "force")),
                           ("Leave it", lambda: None)])
        del a

    def try_gate(self, x, y, how):
        a = self.area
        if how == "pick":
            ok = self.check("Locksmith")
        else:
            ok = self.char_roll("STR", 5, 20 if "Crowbar" in
                                self.p["weapons"] else 0)
            if not ok:
                for m in a.mobs:
                    if m.hostile and abs(m.x - x) + abs(m.y - y) <= 12:
                        m.aware = True
                self.say("The clang echoes through the dark.", "bad")
        if ok:
            a.grid[y][x] = "dfloor"
            self.say("The gate swings open.", "good")
            self.sound.play("door")
        else:
            self.say("It holds.", "info")
        self.end_turn()

    # ── Leads: the ways down ──

    def at_lead(self, lid, x, y):
        p = self.p
        if lid == "vault":
            if "final" in self.flags:
                self.descend("vault")
            else:
                self.say("A slab of black stone, cut with a sign that "
                         "hurts the eye. It will not move, and you feel "
                         "something on the other side lean towards you.",
                         "bad")
                if "felt:slab" not in self.flags:
                    self.flags.add("felt:slab")
                    self.san_check("0", "1d2", "the slab")
            return
        if lid not in self.world["leads"]:
            self.say({
                "crypt": "The mausoleum is chained and silent. Nothing "
                         "here, this time.",
                "witch": "A hatch, nailed down. Under it, only an old "
                         "cellar.",
                "sanitarium": "The basement door. The orderly shakes his "
                              "head: storage, nothing more.",
                "tunnels": "The hatch to the steam tunnels. Only pipes "
                           "and heat down there.",
                "warehouse": "The warehouse is padlocked. Through a crack: "
                             "empty, and smelling of fish.",
                "woods": "A cave, shallow. Only bats."}[lid], "info")
            return
        if lid in self.returned or lid in self.leaves:
            self.say("You have what was down there. You don't need to go "
                     "back.", "info")
            self.open_menu("Go down anyway?", [
                ("Yes", lambda: self.descend(lid)), ("No", lambda: None)])
            return
        if "open:" + lid in self.flags:
            self.descend(lid)
            return
        if lid == "woods":
            self.flags.add("open:woods")
            self.learn("woods_known")
            self.descend("woods")
            return
        key = {"crypt": "mausoleum key", "sanitarium": "basement key",
               "tunnels": "tunnel key"}.get(lid)
        if key and p["items"].get(key):
            self.say("Your %s turns in the lock." % key, "good")
            self.flags.add("open:" + lid)
            self.descend(lid)
            return
        what = {"crypt": "The %s mausoleum: an iron door, chained and "
                         "padlocked." % self.world["fam"],
                "witch": "A trapdoor in the floor, nailed shut. Scratching "
                         "beneath it.",
                "sanitarium": "A heavy door marked BASEMENT, locked.",
                "tunnels": "A steel hatch, locked. A hum comes up through "
                           "it, felt in the teeth.",
                "warehouse": "The Marsh warehouse: a padlocked door, and "
                             "the smell of the sea."}[lid]
        force = self.p["chars"]["STR"] * 5 + (
            25 if "Crowbar" in p["weapons"] else 0) + (
            20 if "bonus:" + lid in self.flags else 0)
        opts = []
        if lid != "witch":
            opts.append(("Pick the lock (Locksmith %d%%)" %
                         self.skill("Locksmith"),
                         lambda: self.try_lead(lid, "pick")))
        opts.append(("Force it (STR x5 %d%%%s)" % (
            min(99, force), ", with the crowbar" if "Crowbar" in
            p["weapons"] else ""), lambda: self.try_lead(lid, "force")))
        if lid == "sanitarium" and self.phase() == "night":
            opts.append(("Slip past the dozing orderly (Sneak %d%%)" %
                         self.skill("Sneak"),
                         lambda: self.try_lead(lid, "sneak")))
        opts.append(("Leave it", lambda: None))
        self.open_menu(what, opts)

    def try_lead(self, lid, how):
        p = self.p
        if how == "pick":
            ok = self.check("Locksmith")
        elif how == "sneak":
            ok = self.check("Sneak")
        else:
            ok = self.char_roll("STR", 5, (25 if "Crowbar" in p["weapons"]
                                           else 0) +
                                (20 if "bonus:" + lid in self.flags else 0))
        self.turn += 10
        if ok:
            self.flags.add("open:" + lid)
            self.say("It gives.", "good")
            self.descend(lid)
            return
        self.say("No luck. Ten minutes wasted.", "info")
        watched = {"witch": "permit:witch" not in self.flags,
                   "sanitarium": True, "tunnels": self.phase() != "night",
                   "warehouse": True}.get(lid, False)
        if how == "force" and watched and not self.char_roll(
                "POW", 5, label="Luck"):
            if lid == "warehouse":
                x, y = self.pos
                spots = [(x + dx, y + dy) for dx in range(-3, 4)
                         for dy in range(-3, 4)
                         if self.area.inside(x + dx, y + dy)
                         and self.area.grid[y + dy][x + dx] in CITY_GROUND
                         and not self.area.mob_at(x + dx, y + dy)
                         and (dx, dy) != (0, 0)]
                if spots:
                    w = make_monster("thug", *random.choice(spots))
                    w.name = "warehouse watchman"
                    w.aware = True
                    self.area.mobs.append(w)
                    self.say("The noise brings the watchman, a man with "
                             "wide wet eyes and a cosh.", "bad")
            else:
                self.say("Someone heard you. You are shown the door, "
                         "firmly.", "bad")
                if self.area.kind == "inside":
                    self.go_outside()
                    return
        self.end_turn()

    # ── Research ──

    def research_menu(self):
        a = self.area
        topics = sorted(t for t in self.topics if t in RESEARCH and
                        "research:" + t not in self.flags)
        if not topics:
            self.say("You browse, but you don't know what you're looking "
                     "for. Words in CAPITALS that people mention can be "
                     "looked up.", "info")
            return
        bonus = RESEARCH_SITES[SITES[a.site][1]] + (
            20 if self.p["occ"] == "Journalist" and SITES[a.site][1] ==
            "newspaper" else 0)
        self.open_menu("Research what? (Library Use %d%%, about two hours)"
                       % min(99, self.skill("Library Use") + bonus),
                       [(t.title(), lambda t=t: self.research(t, bonus))
                        for t in topics] + [("Nothing", lambda: None)])

    def research(self, topic, bonus):
        lid, text, effect = RESEARCH[topic]
        if not self.check("Library Use", bonus):
            self.pass_time(60)
            self.say("An hour of dust and nothing.", "info")
            self.render()
            return
        self.pass_time(120)
        self.flags.add("research:" + topic)
        self.say("Two hours later, you find it:", "info")
        self.say(fill(text, self.world), "talk")
        self.hear(fill(text, self.world))
        if lid and lid not in self.world["leads"]:
            self.say("(Old history. Nothing seems to be stirring there "
                     "now.)", "info")
        elif effect and effect.endswith("_known"):
            self.learn(effect)
        elif effect:
            self.flags.add(effect)
            self.say("(That will make forcing it easier.)", "info")
        self.render()

    def necronomicon(self):
        if "necro_ok" not in self.flags:
            self.say("A locked glass case. Inside, a thick book bound in "
                     "something that is not quite leather. Dr. Armitage "
                     "has the key.", "info")
            return
        if "Necronomicon" not in self.p["books"]:
            self.p["books"].append("Necronomicon")
            self.say("Dr. Armitage unlocks the case for you. 'Read it here, "
                     "and God keep you.' (Use it from your things: U.)",
                     "quest")
        else:
            self.read("Necronomicon")

    def bed_menu(self):
        a = self.area
        kind = SITES[a.site][1] if a.site else ""
        if kind == "boarding":
            self.open_menu("Your bed.", [
                ("Sleep until morning", lambda: self.sleep(True)),
                ("Rest four hours", lambda: self.sleep(False)),
                ("Not now", lambda: None)])
        elif kind == "hotel" and "room:%d" % self.clock()[0] in self.flags:
            self.open_menu("Your hotel room.", [
                ("Sleep until morning", lambda: self.sleep(True)),
                ("Not now", lambda: None)])
        elif kind == "hotel":
            self.say("These rooms are let. Ask the desk clerk for one.",
                     "info")
        else:
            self.say("Someone else's bed.", "info")

    def sleep(self, night):
        p = self.p
        h = self.now().hour
        if night:
            hours = (24 + 7 - h) % 24 or 24
            if hours > 14:
                hours = 4
        else:
            hours = 4
        self.say("You sleep %d hours." % hours, "info")
        self.pass_time(hours * 60, quiet=True)
        if self.overlay:
            return
        p["mp"] = self.max_mp()
        if p["disorder"] == "nightmares":
            self.say("Nightmares. You wake more tired than you lay down.",
                     "mad")
            self.lose_san(1, "nightmares")
        elif hours >= 6:
            heal = roll("1d3")
            p["hp"] = min(self.max_hp(), p["hp"] + heal)
            self.say("You wake, %s. (+%d HP)" % (self.date_text(), heal),
                     "good")
        else:
            self.say("You wake, %s." % self.date_text(), "good")
        self.render()

    def bed_spot(self, area):
        for y in range(area.h):
            for x in range(area.w):
                if area.grid[y][x] == "bed" and y + 1 < area.h and \
                        area.grid[y + 1][x] in INSIDE_FLOOR:
                    return x, y + 1
        return area.start

    # ── Clues ──

    def learn(self, cid):
        if cid in self.clues:
            return
        self.clues.append(cid)
        if cid.endswith("_known"):
            self.flags.add("known:" + cid[:-6])
            if cid == "woods_known":
                city = self.get_area(("city",))
                city.grid[CAVE[1]][CAVE[0]] = "cave"
        self.say("(Your journal has a new entry. J reads it.)", "quest")
        self.sound.play("gold")

    def hear(self, text):
        """Words in CAPITALS: things to ask about, and to research."""
        words = re.findall(r"\b[A-Z][A-Z']{2,}\b", text)
        self.heard = [re.sub(r"'S?$", "", w) for w in words
                      if w not in ("BYE",)]
        for w in words:
            if w in RESEARCH:
                self.topics.add(w)

    # ── Talking ──

    def speaker(self, mob):
        return mob.name if mob.known or mob.role in ("armitage",) else \
            cap(mob.title)

    def npc_say(self, mob, text):
        text = fill(text, self.world)
        self.say("%s: %s" % (self.speaker(mob), text), "talk")
        self.hear(text)

    def start_talk(self, mob):
        p = self.p
        ins = p["insane"]
        if ins and ins["kind"] == "babble":
            self.say("You babble at %s, who backs away from you." %
                     mob.title, "mad")
            return
        if p["disorder"] == "paranoia" and not self.char_roll(
                "POW", 5, label="POW x5, to trust"):
            self.say("You can't bring yourself to trust %s." % mob.title,
                     "mad")
            return
        if ins and ins["kind"] == "hallucinate" and random.random() < 0.3:
            self.say("%s's face slides, like wax. You look away. When you "
                     "look back it is only a face." % cap(mob.title), "mad")
        self.talk = {"mob": mob, "mode": "kw"}
        self.heard = []
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Ask about:")
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        if mob.role == "armitage":
            self.armitage_greet(mob)
            if self.overlay:
                self.end_talk()
                return
            self.talk_menu()
            return
        self.say("You meet %s." % mob.title, "info")
        e = mob.errand
        greet = mob.greet
        if e is not None:
            st = self.side.get(e["id"])
            if st and st["state"] == "active":
                greet = "Oh! It's you. Any luck?"
        self.npc_say(mob, "We're closed. Come back in the morning." if
                     self.closed(mob) else greet)
        for e in self.world["errands"]:
            if e.get("to") == mob.role:
                self.deliver(mob, e)
        if e is not None and self.errand_ready(e):
            self.finish_errand(mob, e)
        if "talked" not in self.flags:
            self.flags.add("talked")
            self.say("(Choose what to ask about, or type a word such as "
                     "NAME, JOB or NEWS and press Return. BYE, or an empty "
                     "line, ends the conversation.)", "info")
        self.talk_menu()

    def closed(self, mob):
        return (mob.shop in CLOSES and self.phase() in ("night",)
                ) or (mob.shop == "boat" and self.phase() == "night")

    def talk_menu(self):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        if t["mode"] == "buy":
            items = [("%d) %s%s" % (i, label, ", $%d" % price if price
                                    else ""),
                      lambda i=i: self.choose_words(str(i)))
                     for i, (label, price, _) in
                     enumerate(self.offers(mob), 1)]
            items.append(("Nothing, thanks", lambda: self.choose_words("")))
            self.open_menu("Buy what? (you have $%d)" % self.p["cash"],
                           items, lambda: self.choose_words(""))
            return
        words = ["NAME", "JOB", "NEWS"]
        if mob.shop:
            words.append("BUY")
        if mob.errand is not None and self.side.get(
                mob.errand["id"], {}).get("state") != "done":
            words.append("HELP")
        if mob.role == "armitage":
            words += ["LEAVES", "LANTERN", "SPELLS"]
        elif mob.role and "LANTERN" in self.topics:
            words.append("LANTERN")
        for w in getattr(self, "heard", []):
            if w not in words and w != "BYE":
                words.append(w)
        self.open_menu("Ask %s about:" % self.speaker(mob),
                       [(w, lambda w=w: self.choose_words(w))
                        for w in words + ["BYE"]],
                       lambda: self.choose_words("bye"))

    def choose_words(self, w):
        self.say("> " + (w or "nothing"), "you")
        self.converse(w.lower())
        self.talk_menu()

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if getattr(self, "p", None) and getattr(self, "area", None):
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if not self.talk:
            return
        self.menu = None
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())
        self.talk_menu()

    def converse(self, w):
        t = self.talk
        mob = t["mob"]
        if t["mode"] == "buy":
            t["mode"] = "kw"
            if w.isdigit():
                self.buy(mob, int(w))
                return
            if not w:
                self.npc_say(mob, "Anything else?")
                return
        if not w or w.startswith("bye"):
            self.npc_say(mob, "Goodbye." if mob.role == "armitage" else
                         random.choice(BYES))
            self.end_talk()
            return
        word = re.sub(r"'s?$", "", w.split()[0])
        if word.startswith("name"):
            mob.known = True
            self.npc_say(mob, "I'm %s." % mob.name if not mob.role else
                         "%s, %s." % (mob.name, mob.title))
            return
        if word[:4] in ERRAND_WORDS and mob.errand is not None:
            self.errand(mob)
            return
        if mob.shop and word[:3] in ("buy", "pur", "sho", "goo", "ser"):
            self.list_offers(mob)
            return
        if mob.leader and word[:4] in ("lant", "cult", "orde", "mast"):
            self.confront(mob)
            return
        if mob.role == "armitage":
            if word[:4] == "leav" and self.returned:
                self.npc_say(mob, "I have %d of the four. %s" % (
                    len(self.returned), "Go to the island!" if
                    "final" in self.flags else "Find the rest."))
                return
            if word[:4] == "lant" and "diary" in self.flags:
                self.npc_say(mob, "%s? It cannot be... and yet it fits. Be "
                             "careful how you accuse such a person." %
                             self.world["people"][self.world["leader"]]
                             ["name"])
                return
        if word[:4] == "spec" and mob.role == "bartender":
            self.flags.add("special")
        reply = next((v for k, v in mob.talk.items()
                      if k[:4] == word[:4] or (len(k) < 4 and
                                               word.startswith(k))), None)
        if reply is None and word[:4] == "heal":
            reply = random.choice(HEALTH)
        if reply is None and mob.shop and len(word) >= 4 and \
                not self.closed(mob) and any(
                    word[:4] in label.lower()
                    for label, _, _ in self.offers(mob)):
            self.list_offers(mob)
            return
        if reply is None:
            reply = next((v for k, v in TOPICS.items()
                          if word.startswith(k)), None)
        if reply is None and word.upper() in RESEARCH:
            reply = "I couldn't tell you much about that. You could look it up at a library, or in the Advertiser's morgue."
        if reply is None:
            reply = random.choice((
                "I don't know anything about that.",
                "Can't help you there.",
                "Hm? I don't follow."))
        self.reply(mob, reply)
        self.render_chrome()

    def reply(self, mob, r):
        """Say a reply: words, or a dict that may roll skills, give things
        and teach clues."""
        if isinstance(r, str):
            self.npc_say(mob, r)
            return
        if "skill" in r:
            flag = r.get("flag")
            if flag and flag in self.flags:
                self.npc_say(mob, "I've done all I'll do for you.")
                return
            tried = "tried:%s:%d" % (flag, self.clock()[0])
            if tried in self.flags:
                self.npc_say(mob, r["fail"])
                return
            ok, used = self.best_check(r["skill"])
            if ok:
                self.npc_say(mob, r["ok"])
                if flag:
                    self.flags.add(flag)
                if r.get("give"):
                    self.p["items"][r["give"]] = 1
                    self.say("You get the %s." % r["give"], "gold")
                    self.sound.play("gold")
            else:
                self.flags.add(tried)
                self.npc_say(mob, r["fail"])
            return
        self.npc_say(mob, r["say"])
        if r.get("learn"):
            self.learn(r["learn"])
        if r.get("topic"):
            self.topics.add(r["topic"])

    def confront(self, mob):
        """Accuse the master of the Pale Lantern."""
        if "diary" not in self.flags:
            self.npc_say(mob, "The pale what? I'm afraid I've no idea what "
                         "you mean.")
            if "psych:lantern" not in self.flags:
                self.flags.add("psych:lantern")
                if self.check("Psychology"):
                    self.say("A flicker in the eyes, gone at once. %s is "
                             "lying." % mob.name, "mad")
                    self.learn("suspect")
            return
        self.npc_say(mob, "So you've read the old fool's diary. A pity. "
                     "For you.")
        self.say("%s's face goes slack and then not slack, and the eyes "
                 "are wrong..." % mob.name, "bad")
        self.end_talk()
        m = MONSTERS["master"]
        mob.kind = "master"
        mob.tile = "master"
        mob.hostile = True
        mob.aware = True
        mob.boss = True
        mob.hp = mob.maxhp = roll(m.hp) * 2
        mob.title = "the master of the Pale Lantern"
        self.flags.add("unmasked")
        self.area.san_seen.add("master")
        self.san_check("0", "1d4", "the master's true face")
        self.render()

    # ── Shops ──

    def offers(self, mob):
        """(label, price, what happens) for what a shop sells."""
        p = self.p
        kind = mob.shop
        o = []

        def give(item, n=1):
            def f():
                p["items"][item] = p["items"].get(item, 0) + n
                self.say("You buy %s." % (item if n == 1 else
                                          "%d %s" % (n, item)), "gold")
            return f
        if kind == "hardware":
            for w in SHOP_WEAPONS:
                if w not in p["weapons"]:
                    o.append((w + " (%s)" % WEAPONS[w].dmg,
                              WEAPONS[w].price, lambda w=w: self.got_gun(w)))
            for ammo, (n, price) in AMMO.items():
                o.append(("%d %s" % (n, ammo), price, give(ammo, n)))
            if not p["items"].get("flashlight"):
                o.append(("A flashlight", 3, give("flashlight")))
        elif kind == "drugstore":
            o += [("A first aid kit", 3, give("first aid kit")),
                  ("Laudanum", 2, give("laudanum"))]
        elif kind == "books":
            for b, info in BOOKS.items():
                if info.price and b not in p["books"]:
                    o.append((b, info.price, lambda b=b: self.got_book(b)))
        elif kind == "speakeasy":
            if "special" not in self.flags:
                return [("A shave", 1, lambda: self.say(
                    "A close shave. You feel almost respectable.", "info"))]
            o += [("A glass of rye", 1, give("whiskey")),
                  ("A word in your ear", 2, lambda: self.tip(mob))]
            if not p["items"].get("lockpicks"):
                o.append(("A set of lockpicks, no questions", 6,
                          give("lockpicks")))
        elif kind == "diner":
            o.append(("A hot meal", 1, self.meal))
        elif kind == "hotel":
            o.append(("A room for the night", 4, self.hotel_room))
        elif kind == "boarding":
            o += [("Sleep until morning", 0, lambda: self.sleep(True)),
                  ("Rest four hours", 0, lambda: self.sleep(False))]
        elif kind == "bank":
            for n in (20, 50):
                if p["savings"] >= n:
                    o.append(("Withdraw $%d (savings $%d)" % (n,
                                                              p["savings"]),
                              0, lambda n=n: self.withdraw(n)))
        elif kind == "hospital":
            o += [("Treat my wounds", 5, self.treat),
                  ("A bed for the night", 10, self.hospital_night)]
        elif kind == "sanitarium":
            o.append(("A day's treatment", 25, self.therapy))
        elif kind == "boat":
            if not p["boat"]:
                o.append(("A rowboat", 3, self.got_boat))
        elif kind == "travel":
            for place in ("Boston", "Kingsport", "Dunwich", "Innsmouth"):
                o.append(("A ticket to %s" % place, 0,
                          lambda place=place: self.travel(mob, place)))
        elif kind == "church":
            o.append(("A donation to the church", 1, self.blessing))
        return o

    def list_offers(self, mob):
        if self.closed(mob):
            self.npc_say(mob, "We're closed for the night.")
            return
        offers = self.offers(mob)
        if not offers:
            self.npc_say(mob, "There's nothing more I can do for you.")
            return
        self.npc_say(mob, "Here's what I have.")
        self.talk["mode"] = "buy"

    def buy(self, mob, n):
        p = self.p
        offers = self.offers(mob)
        if not 1 <= n <= len(offers):
            self.npc_say(mob, "Pardon?")
            return
        label, price, what = offers[n - 1]
        if price >= 5 and mob.shop in ("hardware", "books", "drugstore",
                                       "boat") and self.check("Bargain"):
            price = max(1, price * 4 // 5)
            self.npc_say(mob, "Oh, all right: $%d, and not a cent less." %
                         price)
        if price > p["cash"]:
            if price <= p["savings"] and self.check("Credit Rating"):
                self.npc_say(mob, "A cheque will do, for you.")
                p["savings"] -= price
                what()
                self.render_chrome()
                return
            self.npc_say(mob, "You haven't the money. Try the bank.")
            return
        p["cash"] -= price
        what()
        self.sound.play("gold")
        self.render_chrome()

    def got_gun(self, w):
        p = self.p
        p["weapons"].append(w)
        p["loaded"][w] = 0
        if WEAPONS[w].ammo:
            ammo = WEAPONS[w].ammo
            p["items"][ammo] = p["items"].get(ammo, 0) + AMMO[ammo][0]
        p["weapon"] = w
        self.say("You buy the %s and a box of %s, and ready it." % (
            w, WEAPONS[w].ammo) if WEAPONS[w].ammo else
            "You buy the %s, and ready it." % w, "gold")
        if WEAPONS[w].ammo:
            self.reload(free=True)

    def got_book(self, b):
        self.p["books"].append(b)
        self.say("You buy %s. (U to read it, somewhere safe.)" % b, "gold")

    def got_boat(self):
        self.p["boat"] = True
        self.say("A small, leaky rowboat is yours. Walk out from the dock "
                 "and row.", "gold")

    def tip(self, mob):
        live = [lid for lid in self.world["leads"]
                if "known:" + lid not in self.flags]
        self.npc_say(mob, fill(RUMOURS[random.choice(live)], self.world)
                     if live else "You know as much as I do, friend.")

    def meal(self):
        p = self.p
        key = "meal:%d" % (self.turn // 240)
        self.pass_time(30, quiet=True)
        if key in self.flags:
            self.say("You eat, though you aren't hungry.", "info")
            return
        self.flags.add(key)
        p["hp"] = min(self.max_hp(), p["hp"] + 1)
        p["mp"] = min(self.max_mp(), p["mp"] + 1)
        self.say("Pot roast and pie. You feel more yourself.", "good")

    def hotel_room(self):
        self.flags.add("room:%d" % self.clock()[0])
        self.say("Room 412, fourth floor. The beds are upstairs: walk into "
                 "one to sleep.", "info")

    def withdraw(self, n):
        p = self.p
        p["savings"] -= n
        p["cash"] += n
        self.say("The teller counts out $%d." % n, "gold")

    def treat(self):
        p = self.p
        key = "treat:%d" % self.clock()[0]
        if key in self.flags or p["hp"] >= self.max_hp():
            self.say("The doctor looks you over. 'Rest is what you need.'",
                     "info")
            return
        self.flags.add(key)
        heal = roll("1d3+1")
        p["hp"] = min(self.max_hp(), p["hp"] + heal)
        self.pass_time(30, quiet=True)
        self.say("Stitches and iodine. (+%d HP)" % heal, "good")

    def hospital_night(self):
        p = self.p
        h = self.now().hour
        hours = (24 + 7 - h) % 24 or 24
        self.pass_time(hours * 60, quiet=True)
        if self.overlay:
            return
        heal = roll("2d3")
        p["hp"] = min(self.max_hp(), p["hp"] + heal)
        p["mp"] = self.max_mp()
        self.say("A night under the nurses' care. You wake, %s. (+%d HP)" %
                 (self.date_text(), heal), "good")

    def therapy(self):
        p = self.p
        self.say("A day of rest, talk and hydrotherapy...", "info")
        self.pass_time(DAY, quiet=True)
        if self.overlay:
            return
        p["insane"] = None
        if p["disorder"]:
            self.say("Your %s is gone, or nearly." % p["disorder"], "good")
            p["disorder"] = None
        self.gain_san(roll("1d6"), "under treatment")
        self.say("It is %s." % self.date_text(), "info")
        self.render()

    def blessing(self):
        key = "bless:%d" % self.clock()[0]
        if key in self.flags:
            self.say("The rector thanks you warmly.", "info")
            return
        self.flags.add(key)
        if self.p["insane"]:
            self.end_insanity()
        self.gain_san(1, "in the quiet of the church")

    def travel(self, mob, place):
        self.npc_say(mob, {
            "Boston": "The 4:10 to Boston? You'd be leaving a deal of "
                      "trouble behind. Come back when Arkham's business is "
                      "done.",
            "Kingsport": "Fog's closed the Kingsport road. Another time.",
            "Dunwich": "Dunwich? Nobody goes to Dunwich. Well. Not this "
                       "month.",
            "Innsmouth": "Joe Sargent's bus leaves from Dyer Street, but "
                         "he's not running till November."}[place])

    # ── Dr. Armitage ──

    def armitage_greet(self, mob):
        p = self.p
        self.say("You meet Dr. Henry Armitage, librarian of Miskatonic "
                 "University: old, white-haired, and very tired.", "info")
        if "met_armitage" not in self.flags:
            self.flags.add("met_armitage")
            self.npc_say(mob, "%s? Thank God. Professor ASHCROFT is gone, "
                         "and with him four LEAVES of a manuscript, the "
                         "Rite of Dismissal. The Pale LANTERN has them: an "
                         "old Arkham cult, and they mean to open a door on "
                         "the river ISLAND at midnight on HALLOWEEN." %
                         p["name"])
            self.npc_say(mob, "They will have hidden the leaves where they "
                         "keep their... servants. Find them. Bring each to "
                         "me as you find it. Here: the University's money "
                         "for your expenses.")
            p["cash"] += 20
            self.say("Dr. Armitage gives you $20.", "gold")
            self.learn("case")
            self.topics.update(("ASHCROFT", "LANTERN", "ISLAND"))
            return
        if self.leaves:
            for lid in self.leaves:
                self.returned.append(lid)
                self.flags.add("back:" + lid)
                self.npc_say(mob, "%s! Ashcroft's own hand in the margins. "
                             "Well done." % cap(self.world["leaves"][lid]))
            self.leaves = []
            self.sound.play("level")
            self.improve()
            self.gain_san(roll("1d6"), "with the leaf safe")
            self.armitage_teaches()
            return
        n = len(self.returned)
        self.npc_say(mob, "Go to the island. Speak the Rite in the circle."
                     if "final" in self.flags else
                     "I have %d of the four leaves. Arkham is talking: "
                     "graves, rats, lights. Follow the talk." % n)

    def improve(self):
        """Skill improvement: each skill used well this time may grow."""
        p = self.p
        if not p["checks"]:
            self.say("You have learned nothing new about yourself.",
                     "info")
            return
        self.say("You think over what you have done, and learn from it:",
                 "quest")
        for s in p["checks"]:
            r = random.randint(1, 100)
            if r > p["skills"][s] or r >= 95:
                g = roll("1d10")
                p["skills"][s] = min(99, p["skills"][s] + g)
                self.say("  %s improves to %d%% (+%d)." % (s, p["skills"][s],
                                                           g), "good")
            else:
                self.say("  %s stays at %d%%." % (s, p["skills"][s]), "info")
        p["checks"] = []

    def armitage_teaches(self, quiet=False):
        p = self.p
        n = len(self.returned)
        for need, spell in ((1, "Elder Sign"), (2, "Shrivelling")):
            if n >= need and spell not in p["spells"]:
                p["spells"].append(spell)
                if not quiet:
                    self.say("Dr. Armitage teaches you a spell from "
                             "Ashcroft's notes: %s (%s)." % (
                                 spell, SPELLS[spell]["desc"]), "quest")
        if n >= 3 and "necro_ok" not in self.flags:
            self.flags.add("necro_ok")
            if not quiet:
                self.say("'You have earned the right to read our "
                         "Necronomicon, if you dare. It's in the case "
                         "upstairs.'", "quest")
        if n >= 4 and "final" not in self.flags:
            self.flags.add("final")
            self.learn("rite")
        if n >= 4 and "Rite of Dismissal" not in p["spells"]:
            p["spells"].append("Rite of Dismissal")
            if not quiet:
                self.say("Armitage lays the four leaves side by side, and "
                         "together you read the Rite of Dismissal aloud, "
                         "once, softly. You know it now. 'The island. Before "
                         "midnight on Hallowe'en. The slab will open for "
                         "the Rite.'", "quest")
                self.sound.play("quest")

    # ── Errands ──

    def give_errand(self, mob):
        for e in self.world["errands"]:
            if e["giver"] == mob.role:
                mob.errand = e

    def release_cats(self, area=None):
        a = area or self.cache.get(("city",))
        if a is None:
            return
        a.mobs = [m for m in a.mobs if m.cat is None]
        for e in self.world["errands"]:
            st = self.side.get(e["id"], {}).get("state")
            if e["kind"] == "cat" and st == "active" and \
                    "cat:" + e["id"] not in self.flags:
                x, y = e["spot"]
                while a.mob_at(x, y):
                    x += 1
                cat = Mob("cat", e["cat"], x, y)
                cat.cat = e
                cat.roam, cat.home = {"street", "grass"}, (x, y)
                cat.title = "a black cat"
                a.mobs.append(cat)

    def errand(self, mob):
        e = mob.errand
        st = self.side.get(e["id"])
        if st is None:
            self.side[e["id"]] = {"state": "active"}
            if e["kind"] == "cat":
                self.npc_say(mob, "My cat, %s, has run off. Black as ink. "
                             "Last seen in %s. Bring her home and I'll pay you "
                             "$%d." % (e["cat"], district(*e["spot"]),
                                       e["pay"]))
                self.release_cats()
            else:
                who = self.world["people"][e["to"]]
                self.npc_say(mob, "Would you take %s to %s, %s? They'll "
                             "pay you $%d for your trouble." % (
                                 e["thing"], who["name"], who["title"],
                                 e["pay"]))
                self.say("You take %s." % e["thing"], "info")
        elif st["state"] == "done":
            self.npc_say(mob, "Thank you again!")
        elif self.errand_ready(e):
            self.finish_errand(mob, e)
        else:
            self.npc_say(mob, "Have you found %s?" % e["cat"]
                         if e["kind"] == "cat" else
                         "Have you taken %s to %s yet?" % (
                             e["thing"],
                             self.world["people"][e["to"]]["short"]))

    def errand_ready(self, e):
        return (self.side.get(e["id"], {}).get("state") == "active" and
                e["kind"] == "cat" and "cat:" + e["id"] in self.flags)

    def finish_errand(self, mob, e):
        self.side[e["id"]]["state"] = "done"
        self.npc_say(mob, "%s! Oh, you found her! Here, take this." %
                     e["cat"])
        self.p["cash"] += e["pay"]
        self.say("You get $%d." % e["pay"], "gold")
        self.gain_san(1, "for a small kindness")
        self.sound.play("gold")

    def deliver(self, mob, e):
        st = self.side.get(e["id"])
        if not st or st["state"] != "active":
            return
        st["state"] = "done"
        self.npc_say(mob, "Is that %s? From %s? How kind. Here." % (
            e["thing"], self.world["people"][e["giver"]]["short"]))
        self.p["cash"] += e["pay"]
        self.say("You get $%d." % e["pay"], "gold")
        self.gain_san(1, "for a small kindness")

    def catch_cat(self, mob):
        e = mob.cat
        if self.char_roll("DEX", 5):
            self.area.mobs.remove(mob)
            self.flags.add("cat:" + e["id"])
            self.say("You scoop up %s, who complains, and then purrs." %
                     e["cat"], "good")
            self.sound.play("gold")
        else:
            self.say("The cat slips through your fingers.", "info")
            for _ in range(3):
                self.wander(mob)
        self.end_turn()

    # ── Journal and sheet ──

    def journal(self):
        if self.busy or self.talk:
            return
        if self.overlay == "journal":
            self.close_overlay()
            return
        w = self.world
        lines = ["JOURNAL, %s" % self.date_text().upper(), ""]
        left = DEADLINE - self.turn
        lines.append("%d days, %d hours until midnight on Hallowe'en." % (
            left // DAY, left % DAY // 60))
        lines.append("")
        if "met_armitage" not in self.flags:
            lines.append("Dr. Armitage's telegram: go to the University "
                         "Library, south of the river, at once.")
        for cid in self.clues:
            lines.append("* " + fill(CLUES[cid], w))
        lines.append("")
        lines.append("The leaves:")
        for lid in w["leads"]:
            leaf = w["leaves"][lid]
            if lid in self.returned:
                lines.append("  + %s, with Dr. Armitage" % leaf)
            elif lid in self.leaves:
                lines.append("  * %s: you have it" % leaf)
            elif "known:" + lid in self.flags:
                lines.append("  - one in %s" % fill(LEADS[lid].name, w))
            else:
                lines.append("  - one somewhere in Arkham")
        if self.topics:
            lines += ["", "To research: " + ", ".join(
                sorted(t.title() for t in self.topics
                       if "research:" + t not in self.flags) or ["(none)"])]
        errs = []
        for e in w["errands"]:
            st = self.side.get(e["id"], {}).get("state")
            if st == "active":
                errs.append("Find %s the cat for %s" % (
                    e["cat"], w["people"][e["giver"]]["short"])
                    if e["kind"] == "cat" else "Take %s to %s" % (
                        e["thing"], w["people"][e["to"]]["name"]))
        if errs:
            lines += ["", "Errands:"] + ["  " + s for s in errs]
        wrapped = []
        for ln in lines:
            wrapped += wrap(ln, 64) or [""]
        self.overlay = "journal"
        self.overlay_text = "\n".join(wrapped)
        self.render()

    def show_sheet(self):
        if self.busy or self.talk:
            return
        if self.overlay == "sheet":
            self.close_overlay()
            return
        p = self.p
        c = p["chars"]
        lines = ["%s, %s" % (p["name"], p["occ"]), "",
                 "  ".join("%s %2d" % (k, c[k]) for k in CHARS[:4]),
                 "  ".join("%s %2d" % (k, c[k]) for k in CHARS[4:]), "",
                 "HP %d/%d   MP %d/%d   Sanity %d/%d   Luck %d" % (
                     max(0, p["hp"]), self.max_hp(), p["mp"], self.max_mp(),
                     p["san"], self.max_san(), self.luck()),
                 "Idea %d   Know %d   Damage bonus %s" % (
                     c["INT"] * 5, c["EDU"] * 5, self.db()), ""]
        names = sorted(p["skills"])
        half = (len(names) + 1) // 2
        for i in range(half):
            row = []
            for s in (names[i], names[i + half] if i + half < len(names)
                      else None):
                if s:
                    row.append("%-15s%3d%%%s" % (
                        s, p["skills"][s], "*" if s in p["checks"] else " "))
            lines.append("   ".join(row))
        lines += ["", "* used well: may improve when a leaf goes home."]
        if p["spells"]:
            lines += ["", "Spells: " + ", ".join(p["spells"])]
        if p["books"]:
            lines += ["Books: " + ", ".join(p["books"])]
        if p["disorder"]:
            lines += ["", "Disorder: " + p["disorder"]]
        lines += ["", "Any key closes."]
        self.overlay = "sheet"
        self.overlay_text = "\n".join(lines)
        self.render()

    # ── Menus ──

    def open_menu(self, title, items, cancel=None):
        self.menu = {"title": title, "items": items, "sel": 0,
                     "cancel": cancel}
        self.render()

    def menu_move(self, d):
        m = self.menu
        m["sel"] = (m["sel"] + d) % len(m["items"])
        self.render()

    def menu_pick(self, i=None):
        m, self.menu = self.menu, None
        self.render()
        m["items"][m["sel"] if i is None else i][1]()

    def menu_cancel(self):
        m, self.menu = self.menu, None
        self.render()
        if m["cancel"]:
            m["cancel"]()

    def draw_menu(self):
        c, m = self.canvas, self.menu
        W, H = c.winfo_width(), c.winfo_height()
        if not hasattr(self, "menu_fonts"):
            size = 17 if ANDROID else 14
            self.menu_fonts = (tkfont.Font(family="Helvetica", size=size),
                               tkfont.Font(family="Helvetica", size=size,
                                           weight="bold"))
        f, bold = self.menu_fonts
        rh = f.metrics("linespace") + (18 if ANDROID else 10)
        labels = [label for label, _ in m["items"]]
        title = m["title"]
        bw = min(W - 20, max([f.measure(t) for t in labels] +
                             [bold.measure(title)]) + 40)
        if bold.measure(title) > bw - 40:
            title = "\n".join(wrap(title, max(20, len(title) * (bw - 40) //
                                              bold.measure(title))))
        th = (title.count("\n") + 1) * rh
        fit = max(1, (H - 2 * rh - th) // rh)
        first = max(0, min(m["sel"] - fit // 2, len(labels) - fit))
        shown = labels[first:first + fit]
        bh = len(shown) * rh + th + 16
        x0, y0 = (W - bw) // 2, max(8, (H - bh) // 2)
        c.create_rectangle(x0, y0, x0 + bw, y0 + bh, fill=PANEL,
                           outline=ACCENT, width=2, tags="overlay")
        c.create_text(x0 + 20, y0 + 8 + th // 2, text=title, anchor="w",
                      fill=ACCENT, font=bold, tags="overlay")
        self.menu_rows = []
        for n, label in enumerate(shown):
            i = first + n
            ry = y0 + 8 + th + n * rh
            if i == m["sel"]:
                c.create_rectangle(x0 + 6, ry, x0 + bw - 6, ry + rh,
                                   fill="#2c3320", outline="",
                                   tags="overlay")
            c.create_text(x0 + 20, ry + rh // 2, text=label, anchor="w",
                          fill=INK, font=f, tags="overlay")
            self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))

    def action_menu(self):
        if self.busy or self.talk:
            return
        if self.overlay not in ("won", "doom"):
            self.overlay = None
        items = [("Help", self.show_help), ("Journal", self.journal),
                 ("Investigator", self.show_sheet), ("Map", self.toggle_map),
                 ("Search here", self.search), ("Reload", self.reload),
                 ("Zoom in", lambda: self.zoom(1)),
                 ("Zoom out", lambda: self.zoom(-1)),
                 ("Sound effects %s" % ("on" if self.sound.muted else "off"),
                  self.toggle_mute),
                 ("Music %s" % ("on" if self.sound.music_off else "off"),
                  self.toggle_music),
                 ("New game", self.ask_new_game), ("Quit", self.quit)]
        if self.overlay in ("won", "doom"):
            items = [("New game", self.new_game), ("Quit", self.quit)]
            if self.overlay == "won":
                items.insert(1, ("Keep walking Arkham", self.close_won))
        self.open_menu("Miskatonic", items)

    def close_won(self):
        self.overlay = None
        self.render()

    # ── Taps and walking ──

    def on_tap(self, ev):
        self.walking = None
        if self.menu:
            for x0, y0, x1, y1, i in self.menu_rows:
                if x0 <= ev.x <= x1 and y0 <= ev.y <= y1:
                    self.menu_pick(i)
                    return
            if not self.talk:
                self.menu_cancel()
            return
        if self.busy or self.talk:
            return
        if self.overlay:
            self.close_overlay()
            return
        cols, rows, ox, oy, ts = self.view
        tx = self.pos[0] - cols // 2 + (ev.x - ox) // ts
        ty = self.pos[1] - rows // 2 + (ev.y - oy) // ts
        dx, dy = tx - self.pos[0], ty - self.pos[1]
        step = ((1 if dx > 0 else -1, 0) if abs(dx) >= abs(dy)
                else (0, 1 if dy > 0 else -1))
        if self.aim:
            if (dx, dy) == (0, 0):
                self.aim = None
                self.say("Never mind.", "info")
            else:
                self.aimed(*step)
        elif (dx, dy) == (0, 0):
            self.wait()
        elif abs(dx) + abs(dy) == 1:
            self.move(dx, dy)
        else:
            self.walk_to(tx, ty)

    def passable(self, x, y, goal):
        a = self.area
        if not a.inside(x, y):
            return False
        if (x, y) == goal:
            return True
        t = a.grid[y][x]
        if a.mob_at(x, y) or (x, y) in a.links:
            return False
        if t in WATER:
            return a.kind == "city" and self.p["boat"]
        return t in WALKABLE and t not in ("stairs_up", "stairs_down",
                                           "exit", "steam", "angle")

    def walk_to(self, tx, ty):
        start, goal = tuple(self.pos), (tx, ty)
        prev = {start: None}
        q = deque([start])
        while q and goal not in prev:
            x, y = q.popleft()
            if abs(x - start[0]) + abs(y - start[1]) > 50:
                continue
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if n not in prev and self.passable(n[0], n[1], goal):
                    prev[n] = (x, y)
                    q.append(n)
        if goal not in prev:
            self.say("You can't find a way there.", "info")
            return
        path = []
        while goal != start:
            path.append(goal)
            goal = prev[goal]
        self.walking = path[::-1]
        self.walk_area = self.area
        self.walk_seen = self.hostiles_in_view()
        self.walk_step()

    def hostiles_in_view(self):
        return {id(m) for m in self.area.mobs
                if m.hostile and (m.x, m.y) in self.visible}

    def walk_step(self):
        if (not self.walking or not self.ready()
                or self.area is not self.walk_area):
            self.walking = None
            return
        x, y = self.walking.pop(0)
        before = tuple(self.pos)
        self.move(x - before[0], y - before[1])
        if (tuple(self.pos) != (x, y) or self.hostiles_in_view() -
                self.walk_seen):
            self.walking = None
            return
        if self.walking:
            self.root.after(90, self.walk_step)

    def wait(self):
        if not self.ready():
            return
        if self.p["held"]:
            self.p["held"] -= 1
        self.say("You wait.", "info")
        self.end_turn()

    # ── Drawing ──

    def layout(self):
        if not getattr(self, "area", None):
            return
        c = self.canvas
        c.delete("all")
        ts = 16 * self.scale
        W, H = max(c.winfo_width(), ts * 5), max(c.winfo_height(), ts * 5)
        cols, rows = W // ts, H // ts
        cols -= 1 - cols % 2
        rows -= 1 - rows % 2
        ox, oy = (W - cols * ts) // 2, (H - rows * ts) // 2
        self.view = (cols, rows, ox, oy, ts)
        self.cells = []
        for j in range(rows):
            for i in range(cols):
                x, y = ox + i * ts, oy + j * ts
                self.cells.append((
                    c.create_image(x, y, anchor="nw", state="hidden"),
                    c.create_image(x, y, anchor="nw", state="hidden")))
        self.shown = [(None, None)] * len(self.cells)
        self.fx = c.create_image(0, 0, anchor="nw", state="hidden")
        self.missile = c.create_image(0, 0, anchor="nw", state="hidden")
        self.render()

    @staticmethod
    def line_clear(a, x0, y0, x1, y1):
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        x, y = x0, y0
        while (x, y) != (x1, y1):
            if (x, y) != (x0, y0) and a.grid[y][x] in a.opaque:
                return False
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x += sx
            if e2 <= dx:
                err += dx
                y += sy
        return True

    def light_radius(self):
        a = self.area
        if a.dark:
            return 6 if self.p["items"].get("flashlight") else 2
        if a.kind != "city":
            return None
        ph = self.phase()
        return None if ph == "day" else 9 if ph in ("dawn", "dusk") else 4

    def compute_visible(self):
        a = self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        r = self.light_radius()
        r2 = r * r if r else None
        lit = getattr(a, "lit", set()) if r else set()
        vis = set()
        for y in range(max(0, py - rows // 2), min(a.h, py + rows // 2 + 1)):
            for x in range(max(0, px - cols // 2),
                           min(a.w, px + cols // 2 + 1)):
                if r2 and (x - px) ** 2 + (y - py) ** 2 > r2 and \
                        (x, y) not in lit:
                    continue
                if self.line_clear(a, px, py, x, y):
                    vis.add((x, y))
                    a.seen[y * a.w + x] = 1
        return vis

    def render(self):
        if not self.cells or not getattr(self, "area", None):
            return
        c, a = self.canvas, self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        self.visible = vis = self.compute_visible()
        dim = a.dark or self.light_radius() is not None
        mobs = {(m.x, m.y): m for m in a.mobs}
        ins = self.p["insane"]
        mad = ins and ins["kind"] == "hallucinate"
        x0, y0 = px - cols // 2, py - rows // 2
        for j in range(rows):
            y = y0 + j
            for i in range(cols):
                x = x0 + i
                base = top = None
                if a.inside(x, y):
                    t = a.grid[y][x]
                    if (x, y) in vis:
                        base = self.framed(a.skin.get(t, t))
                        m = mobs.get((x, y))
                        if m:
                            top = m.tile
                            if mad and not m.hostile:
                                top = ("ghoul", "deepone", "zombie",
                                       "witch")[id(m) % 4]
                        else:
                            top = a.items.get((x, y))
                    elif dim and a.seen[y * a.w + x]:
                        base = "~" + a.skin.get(t, t)
                elif a.edge:
                    base = self.framed(a.edge)
                if x == px and y == py:
                    top = ("boat" if a.grid[y][x] in WATER else
                           "investigator")
                top = self.framed(top)
                idx = j * cols + i
                old = self.shown[idx]
                if old == (base, top):
                    continue
                self.shown[idx] = (base, top)
                bid, tid = self.cells[idx]
                if base != old[0]:
                    if base is None:
                        c.itemconfig(bid, state="hidden")
                    elif base[0] == "~":
                        c.itemconfig(bid, image=self.dimg[base[1:]],
                                     state="normal")
                    else:
                        c.itemconfig(bid, image=self.img[base],
                                     state="normal")
                if top != old[1]:
                    if top is None:
                        c.itemconfig(tid, state="hidden")
                    else:
                        c.itemconfig(tid, image=self.img[top],
                                     state="normal")
        c.delete("overlay")
        if self.overlay == "map":
            self.draw_map()
        elif self.overlay == "help":
            self.draw_text_box(HELP)
        elif self.overlay in ("sheet", "journal"):
            self.draw_text_box(self.overlay_text)
        elif self.overlay in ("won", "lost", "doom"):
            self.draw_text_box(self.overlay_text,
                               ACCENT if self.overlay == "won" else BAD)
        if self.menu:
            self.draw_menu()
        self.render_chrome()

    def flash(self, x, y, tile="hit"):
        cols, rows, ox, oy, ts = self.view
        i = x - self.pos[0] + cols // 2
        j = y - self.pos[1] + rows // 2
        if not (0 <= i < cols and 0 <= j < rows):
            return
        self.fx_token += 1
        token = self.fx_token
        self.canvas.coords(self.fx, ox + i * ts, oy + j * ts)
        self.canvas.itemconfig(self.fx, image=self.img[tile], state="normal")
        self.canvas.tag_raise(self.fx)

        def hide():
            if token == self.fx_token:
                self.canvas.itemconfig(self.fx, state="hidden")
        self.root.after(160, hide)

    def draw_text_box(self, text, color=INK):
        c = self.canvas
        W, H = c.winfo_width(), c.winfo_height()
        t = c.create_text(W / 2, H / 2, text=text, fill=color, font=MONO,
                          justify="left", tags="overlay")
        x0, y0, x1, y1 = c.bbox(t)
        r = c.create_rectangle(x0 - 20, y0 - 16, x1 + 20, y1 + 16,
                               fill=PANEL, outline=ACCENT, width=2,
                               tags="overlay")
        c.tag_raise(t, r)

    def draw_map(self):
        c, a = self.canvas, self.get_area(("city",))
        W, H = c.winfo_width(), c.winfo_height()
        rows = []
        for y in range(a.h):
            row = []
            for x in range(a.w):
                if not a.seen[y * a.w + x]:
                    row.append("#000000")
                else:
                    t = a.grid[y][x]
                    row.append("#e05040" if t == "door" else
                               "#f0e080" if t == "lamp" else self.avg[t])
            rows.append("{" + " ".join(row) + "}")
        img = tk.PhotoImage(width=a.w, height=a.h)
        img.put(" ".join(rows))
        z = max(1, min((W - 20) // a.w, (H - 50) // a.h))
        self.map_img = img.zoom(z)
        c.create_rectangle(0, 0, W, H, fill="black", tags="overlay")
        mx, my = (W - a.w * z) / 2, (H - a.h * z) / 2 + 10
        c.create_image(mx, my, image=self.map_img, anchor="nw",
                       tags="overlay")
        small = ("Helvetica", 9 if z < 7 else 11)
        for (x, y), name in a.labels.items():
            if a.seen[y * a.w + x] and a.grid[y][x] in ("door", "tomb",
                                                       "statue", "cave"):
                c.create_text(mx + (x + 0.5) * z, my + y * z - 2,
                              text=name.replace("the ", "", 1),
                              fill="#ffffff", font=small, anchor="s",
                              tags="overlay")
        if self.area is a:
            px, py = self.pos
        else:
            px, py = self.city_pos or a.start
        c.create_rectangle(mx + px * z - 2, my + py * z - 2,
                           mx + (px + 1) * z + 2, my + (py + 1) * z + 2,
                           outline="#ffff00", width=2, tags="overlay")
        c.create_text(W / 2, my - 14, fill=ACCENT, font=MONO, tags="overlay",
                      text="Arkham, Massachusetts   (red: doors; any key "
                      "closes)")

    def render_chrome(self):
        p = self.p
        a = self.area
        here = a.name if a.kind != "city" else "Arkham: " + district(
            *self.pos)
        near = [a.labels[(self.pos[0] + dx, self.pos[1] + dy)]
                for dx, dy in DIRS + ((0, 0),)
                if (self.pos[0] + dx, self.pos[1] + dy) in a.labels]
        if near and a.kind == "city":
            here += ", by " + near[0]
        self.status.config(text=cap(here))
        left = max(0, DEADLINE - self.turn)
        self.turns.config(text="%s   (%d days to Hallowe'en)" % (
            self.date_text(), left // DAY))
        w = self.weapon()
        lines = [p["name"], p["occ"], "",
                 "HP     %2d/%-2d MP %d/%d" % (max(0, p["hp"]), self.max_hp(),
                                             p["mp"], self.max_mp()),
                 "Sanity %2d/%-2d Luck %d" % (p["san"], self.max_san(),
                                             self.luck()),
                 "Cash   $%-5d Bank $%d" % (p["cash"], p["savings"]), "",
                 "Holding", "  %s (%s%s)" % (
                     p["weapon"], w.dmg, ", %d/%d" % (
                         p["loaded"].get(p["weapon"], 0), w.cap)
                     if w.ammo else "")]
        things = []
        for n, v in sorted(p["items"].items()):
            if v:
                things.append("%s%s" % (n, " x%d" % v if v > 1 else ""))
        if p["boat"]:
            things.append("a rowboat")
        if things:
            lines += ["Carrying"] + ["  " + t for t in things]
        if p["spells"]:
            lines += ["Spells"] + ["  " + s for s in p["spells"]]
        lines += ["", "Leaves  %d/4 with Armitage" % len(self.returned)]
        if self.leaves:
            lines.append("  carrying %d" % len(self.leaves))
        best = sorted((s for s in p["skills"] if s != "Cthulhu Mythos"),
                      key=lambda s: -p["skills"][s])[:6]
        lines += ["", "Best skills"] + ["  %-14s%3d%%" % (s, p["skills"][s])
                                        for s in best]
        if p["skills"]["Cthulhu Mythos"]:
            lines.append("  %-14s%3d%%" % ("Cthulhu Mythos",
                                           p["skills"]["Cthulhu Mythos"]))
        self.panel.config(text="\n".join(lines))
        cond = []
        ins = p["insane"]
        if ins:
            cond.append({"faint": "FAINTED", "panic": "PANIC",
                         "babble": "BABBLING",
                         "hallucinate": "HALLUCINATING"}[ins["kind"]])
        if p["disorder"]:
            cond.append(p["disorder"].upper())
        if self.rite is not None:
            cond.append("CHANTING THE RITE")
        if p["held"]:
            cond.append("HELD")
        if 0 < p["hp"] <= self.max_hp() // 3:
            cond.append("BADLY HURT")
        if p["san"] <= self.max_san() // 4:
            cond.append("FRAYED")
        if a.dark and not p["items"].get("flashlight"):
            cond.append("IN THE DARK")
        self.condition.config(text="\n".join(cond))
        self.sound.tune = ("island" if (a.kind == "city" and
                                        district(*self.pos) ==
                                        "the river island") or
                           a.key[:2] == ("dun", "vault")
                           else TUNE_OF[a.kind])

    # ── Commands ──

    def toggle_map(self):
        if self.busy or self.talk:
            return
        self.overlay = None if self.overlay == "map" else "map"
        self.render()

    def show_help(self):
        if self.busy or self.talk:
            return
        self.overlay = None if self.overlay == "help" else "help"
        self.render()

    def zoom(self, d):
        s = min(MAX_ZOOM, max(1, self.scale + d))
        if s != self.scale:
            self.scale = s
            self.scale_images()
            self.layout()

    def toggle_mute(self):
        self.sound.muted = not self.sound.muted
        self.render_chrome()

    def toggle_music(self):
        self.sound.music_off = not self.sound.music_off
        self.sound.tick()
        self.render_chrome()

    def ask_new_game(self):
        if self.busy:
            return
        if self.overlay in ("won", "doom") or messagebox.askyesno(
                "New game", "Abandon this case and start a new one?",
                parent=self.root):
            self.new_game()


# ── Townsfolk ────────────────────────────────────────────────────────────────


def make_folk(world, rng, i, x, y):
    sex = rng.choice("MF")
    tile = rng.choice([t for t in TOWNSFOLK_TILES if
                       (t.startswith("woman") or t == "flapper") ==
                       (sex == "F")])
    first = rng.choice(MALE if sex == "M" else FEMALE)
    name = "%s %s" % (first, rng.choice(SURNAMES))
    job, line, extra = rng.choice(JOBS)
    if i % 9 == 4:
        tile, job, line, extra = ("police", "policeman",
                                  "I walk a beat. Keep out of trouble.", {})
    m = Mob(tile, name, x, y)
    m.title = "a " + job if job[0] not in "aeiou" else "an " + job
    m.greet = rng.choice(GREETINGS)
    r = rng.random()
    if r < 0.45:
        lid = rng.choice(world["leads"])
        news = fill(RUMOURS[lid], world)
    elif r < 0.7:
        news = rng.choice(CULT_RUMOURS)
    else:
        news = rng.choice(TIPS)
    m.talk = {"job": line, "news": news}
    m.talk.update(extra)
    m.roam = {"street", "grass"}
    m.home = (x, y)
    m.night_owl = i < 4
    return m


def cap(s):
    return s[:1].upper() + s[1:]


def wrap(text, width):
    out, line = [], ""
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            out.append(line)
            line = "  " + word if text.startswith("  ") else word
        else:
            line = (line + " " + word) if line else word
    if line:
        out.append(line)
    return out


def compass(dx, dy):
    ns = "north" if dy < 0 else "south" if dy > 0 else ""
    ew = "west" if dx < 0 else "east" if dx > 0 else ""
    if abs(dy) > 2 * abs(dx):
        ew = ""
    elif abs(dx) > 2 * abs(dy):
        ns = ""
    return "-".join(s for s in (ns, ew) if s) or "here"


def where(frm, to):
    return "to the " + compass(to[0] - frm[0], to[1] - frm[1])


# ── Checking ─────────────────────────────────────────────────────────────────


def selftest():
    """Build every map and tune of a few cases, without a window."""
    for seed in range(6):
        w = generate_world(seed)
        flags = set()
        city = make_city(w, flags)
        doors = [p for p, l in city.links.items() if l[0] == "bld"]
        assert len(doors) == len(SITES) - 1, doors
        for sid in SITES:
            if SITES[sid][1] != "lead":
                a = make_interior(w, sid)
                assert a.grid[a.start[1]][a.start[0]] in INSIDE_FLOOR, sid
                for m in a.mobs:
                    fill(m.greet, w)
                    for v in m.talk.values():
                        for s in ([v] if isinstance(v, str) else
                                  [x for x in v.values()
                                   if isinstance(x, str)]):
                            fill(s, w)
        for lid, info in LEADS.items():
            for level in range(1, info.levels + 1):
                a = make_dungeon(w, lid, level, flags)
                assert a.grid[a.start[1]][a.start[0]] == "stairs_up"
                seen, q = {a.start}, deque([a.start])
                while q:
                    x, y = q.popleft()
                    for dx, dy in DIRS:
                        n = (x + dx, y + dy)
                        if n not in seen and a.grid[n[1]][n[0]] in (
                                DUNGEON_FLOOR | {"gate"}):
                            seen.add(n)
                            q.append(n)
                if a.down:
                    assert a.down in seen, (lid, level)
                if level == info.levels and lid != "vault":
                    assert any((m.x, m.y) in seen for m in a.mobs if m.boss)
    for name, tune in MUSIC.items():
        steps = len(tune["melody"].replace("|", " ").split())
        assert steps == len(tune["chords"].split()) * tune["bar"], name
    tiles = all_tiles()
    for name in list(TILE_NEEDED):
        assert name in tiles, name
    print("ok")


TILE_NEEDED = {"master", "thug", "madman", "investigator", "boat", "cat"} | \
    {m.tile for m in MONSTERS.values()}


def main():
    if "--selftest" in sys.argv:
        selftest()
        return
    root = tk.Tk()
    Game(root)
    root.mainloop()


if __name__ == "__main__":
    main()
