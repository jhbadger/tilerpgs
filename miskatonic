            ch = state["chars"]
            desc.config(text=OCCUPATIONS[o]["desc"])
            lines = ["  ".join("%s %2d" % (c, ch[c]) for c in CHARS[:4]),
                     "  ".join("%s %2d" % (c, ch[c]) for c in CHARS[4:]),
                     "",
                     "HP %d  MP %d  Sanity %d  Luck %d" % (
