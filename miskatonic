# ── Dice ─────────────────────────────────────────────────────────────────────


def roll(expr, rng=random):
    """Dice such as '1d6+1d4', '2d6+3', '-1d4', '1d3' or '0'."""
    total = 0
    for sign, term in re.findall(r"([+-]?)(\d+d\d+|\d+)",
                                 str(expr).replace(" ", "")):
        if "d" in term:
            n, s = (int(v) for v in term.split("d"))
            v = sum(rng.randint(1, s) for _ in range(n))
        else:
            v = int(term)
        total += -v if sign == "-" else v
    return total


def dice_max(expr):
    return roll(re.sub(r"(\d+)d(\d+)", lambda m: str(int(m[1]) * int(m[2])),
                       str(expr)))


def damage_bonus(str_, siz):
    """The Damage Bonus table: STR + SIZ."""
    t = str_ + siz
    if t <= 12:
        return "-1d6"
    if t <= 16:
        return "-1d4"
    if t <= 24:
        return "0"
    if t <= 32:
        return "+1d4"
    if t <= 40:
        return "+1d6"
    return "+%dd6" % (2 + (t - 41) // 16)


def resistance(active, passive):
    """The Resistance Table: the chance an active characteristic overcomes
    a passive one."""
    return max(5, min(95, 50 + 5 * (active - passive)))

