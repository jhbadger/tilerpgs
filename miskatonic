                    best[i], p["skills"][best[i]], best[i + 1],
                    p["skills"][best[i + 1]]))
            sheet.config(text="\n".join(lines))

        def reroll():
            state["chars"] = {c: roll(CHAR_DICE[c]) for c in CHARS}
