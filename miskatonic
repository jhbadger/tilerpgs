        for x in (3, 12):
            rect(g, x, 1, x, 4, "#e8e0c8")
            g[0][x] = "#f8d060" if frame == 0 else "#f89030"
        return g
    raise KeyError(name)


def inside_poly(x, y, pts):
    n, inside = len(pts), False
    for i in range(n):
        x0, y0 = pts[i]
        x1, y1 = pts[(i + 1) % n]
        if (y0 > y) != (y1 > y) and x < x0 + (y - y0) * (x1 - x0) / (y1 - y0):
            inside = not inside
    return inside


