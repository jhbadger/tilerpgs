class Area:
    """A map: Arkham, a building, or a level below."""

    def __init__(self, kind, key, grid, name, edge=None, dark=False):
        self.kind, self.key, self.grid, self.name = kind, key, grid, name
        self.h, self.w = len(grid), len(grid[0])
        self.edge = edge
        self.dark = dark
        self.mobs = []
        self.items = {}         # (x, y) -> thing lying there
        self.links = {}         # (x, y) -> ("bld", site) or ("lead", lead)
        self.labels = {}        # (x, y) -> what it is
        self.hidden = {}        # (x, y) -> found by searching
        self.loot = set()       # containers not yet opened
        self.traps = set()
        self.wards = set()
        self.signs = {}
        self.san_seen = set()   # kinds of horror already faced here
        self.skin = {}
        self.seen = bytearray(self.w * self.h)
        self.opaque = OPAQUE[kind]
        self.start = (0, 0)
        self.down = None
        self.site = None

    def inside(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h

    def mob_at(self, x, y):
        for m in self.mobs:
            if m.x == x and m.y == y:
                return m
        return None


class Mob:
    def __init__(self, tile, name, x, y):
        self.tile, self.name, self.x, self.y = tile, name, x, y
        self.kind = None
        self.hostile = False
        self.hp = self.maxhp = 1
        self.boss = False
        self.flee = 0
        self.aware = False
        self.heard = False
        self.dominated = 0
        self.title = name
        self.role = None
        self.talk, self.greet = {}, ""
        self.known = False
        self.shop = None
        self.leader = False
        self.roam = None
        self.home = None
        self.errand = None      # the errand this person gives
        self.cat = None         # a runaway cat: its errand
        self.night_owl = False


def make_monster(kind, x, y, boss=False, rng=random):
    m = MONSTERS[kind]
    mob = Mob(m.tile, m.name, x, y)
    mob.kind = kind
    mob.hostile = True
    mob.hp = max(1, roll(m.hp, rng))
    if boss:
        mob.hp = int(mob.hp * 1.6)
        mob.boss = True
        mob.name = BOSS_TITLES.get(kind, m.name)
    mob.maxhp = mob.hp
    return mob


def role_talk(world, role):
    greet, talk = ROLE_TALK[role]
    talk = dict(talk)
    for lead in world["leads"]:
        talk.update(HOOKS.get(lead, {}).get(role, {}))
    return talk, greet


