                     "Damage bonus %s   Cash $%d" % (
                         damage_bonus(ch["STR"], ch["SIZ"]), p["cash"]), ""]
            best = sorted((s for s in p["skills"] if s != "Cthulhu Mythos"),
                          key=lambda s: -p["skills"][s])[:10]
            for i in range(0, 10, 2):
