def block_rect(bank, i, j, half=None):
    x0 = 7 + 10 * i
    x1 = x0 + 8
    if bank == "n":
        y0, y1 = 6 + 6 * j, 10 + 6 * j
    else:
        y0, y1 = 39 + 7 * j, 44 + 7 * j
    if half == "L":
        x1 = x0 + 3
    elif half == "R":
        x0 += 5
    return x0, y0, x1, y1


def river_rows(x):
    return (26 + round(0.8 * math.sin(x / 9.0)),
            35 + round(0.8 * math.sin(x / 7.0 + 1)))


def district(x, y):
    """The part of Arkham a square lies in."""
    top, bot = river_rows(min(CITY_W - 1, max(0, x)))
    if ((x - ISLAND[0]) / 5.0) ** 2 + ((y - ISLAND[1]) / 3.0) ** 2 <= 1:
        return "the river island"
    if top <= y <= bot:
        return "the Miskatonic River"
    if x < 6:
        return "the woods west of Arkham"
    if y < top:
        if y < 5:
            return "the fields north of Arkham"
        return ("Northside" if x < 36 else "the Merchant District"
                if x < 66 else "Rivertown")
    if y > 66:
        return "the southern outskirts"
    if 16 < x < 46 and y < 59:
        return "Miskatonic University"
    return ("Uptown" if x < 46 else "French Hill" if x < 66
            else "Easttown")


def make_city(world, flags):
    """Arkham, the same every game but for what the case adds."""
    rng = random.Random("arkham-1925")
    W, H = CITY_W, CITY_H
    g = [["grass"] * W for _ in range(H)]
    for y in range(H):              # woods to the west, fields elsewhere
        for x in range(W):
            if x < 6 or (y < 4 and x < 30) or (y > 67 and x < 40):
                g[y][x] = "woods" if rng.random() < 0.85 else "grass"
            elif y < 4 or y > 67 or x > 87:
                g[y][x] = "field" if rng.random() < 0.6 else "grass"
    for x in range(W):              # the river and its banks
        top, bot = river_rows(x)
        for y in range(top, bot + 1):
            g[y][x] = "water"
        g[RAIL_Y][x] = "rail"
        for y in range(RAIL_Y + 1, top):
            g[y][x] = "sand" if rng.random() < 0.3 else "grass"
        for y in range(bot + 1, SOUTH_Y[0]):
            g[y][x] = "sand" if rng.random() < 0.3 else "grass"
    cx, cy = ISLAND
    for y in range(cy - 3, cy + 4):
        for x in range(cx - 5, cx + 6):
            if ((x - cx) / 5.0) ** 2 + ((y - cy) / 3.0) ** 2 <= 1:
                g[y][x] = "grass"
    for x, y in STONES:
        g[y][x] = "stone"
    g[cy][cx] = "slab"
    for y in NORTH_Y:               # streets
        for x in range(STREET_X[0], STREET_X[-1] + 1):
            g[y][x] = "street"
    for y in SOUTH_Y:
        for x in range(STREET_X[0], STREET_X[-1] + 1):
            g[y][x] = "street"
    for x in STREET_X:
        for y in range(NORTH_Y[0], NORTH_Y[-1] + 1):
            g[y][x] = "street"
        for y in range(SOUTH_Y[0], SOUTH_Y[-1] + 1):
            g[y][x] = "street"
    for x in range(0, STREET_X[0]):                 # roads out of town
        g[11][x] = "street"
    for x in range(STREET_X[-1], W):
        g[45][x] = "street"
    for y in range(0, NORTH_Y[0]):
        g[y][46] = "street"
    for y in range(SOUTH_Y[-1], H):
        g[y][46] = "street"
    for x in BRIDGES:               # two lanes wide
        for y in range(RAIL_Y + 1, SOUTH_Y[0]):
            for bx in (x, x + 1):
                g[y][bx] = "bridge" if g[y][bx] == "water" else "street"
    g[DOCK[1]][DOCK[0]] = "dock"
    for y in range(DOCK[1] + 1, SOUTH_Y[0]):
        g[y][DOCK[0]] = "path"

    area = Area("city", ("city",), g, "Arkham", edge="field")
    used = set()
    blocks = [("n", i, j) for i in range(8) for j in range(3)] + \
             [("s", i, j) for i in range(8) for j in range(4)]
    for b in blocks:                # lamps on the corners
        x0, y0, x1, y1 = block_rect(*b)
        g[y0][x0] = "lamp"
    for sid, (name, kind, (bank, i, j, half), look) in SITES.items():
        x0, y0, x1, y1 = block_rect(bank, i, j, half)
        for y in range(y0 + 1, y1 + 1):
            for x in range(x0, x1 + 1):
                g[y][x] = look
        door = ((x0 + x1 + 1) // 2, y1)
        g[door[1]][door[0]] = "door"
        if sid == "warehouse":
            area.links[door] = ("lead", "warehouse")
        else:
            area.links[door] = ("bld", sid)
        area.labels[door] = name if sid != "boarding" else \
            "Mrs. %s's boarding house" % world["people"]["landlady"]["last"]
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                used.add((x, y))
    x0, y0, x1, y1 = block_rect(*PARK)          # Independence Square
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            edge = x in (x0, x1) or y in (y0, y1)
            g[y][x] = ("tree" if edge and (x + y) % 2 else "grass")
            used.add((x, y))
    g[(y0 + y1) // 2][(x0 + x1) // 2] = "statue"
    area.labels[((x0 + x1) // 2, (y0 + y1) // 2)] = "Independence Square"
    for b in LAWNS:                             # the campus
        x0, y0, x1, y1 = block_rect(*b)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                if g[y][x] != "lamp":
                    g[y][x] = rng.choice(("tree", "tree3")) \
                        if rng.random() < 0.18 else "grass"
                used.add((x, y))
    x0, y0, x1, y1 = block_rect("s", 2, 2)
    g[(y0 + y1) // 2][(x0 + x1) // 2] = "statue"
    area.labels[((x0 + x1) // 2, (y0 + y1) // 2)] = "the Dean Halsey statue"
    gx0, gy0, gx1, gy1 = GRAVEYARD                # the Old Arkham Graveyard
    for y in range(gy0, gy1 + 1):
        for x in range(gx0, gx1 + 1):
            edge = x in (gx0, gx1) or y in (gy0, gy1)
            g[y][x] = "fence" if edge else "grass"
            used.add((x, y))
    g[49][gx0] = g[55][gx0] = "grass"
    for y in range(gy0 + 2, gy1, 2):
        for x in range(gx0 + 2, gx1 - 1, 2):
            if rng.random() < 0.7:
                g[y][x] = rng.choice(("grave", "grave", "grave2"))
    mx0, my0, mx1, my1 = MAUSOLEUM
    for y in range(my0, my1 + 1):
        for x in range(mx0, mx1 + 1):
            g[y][x] = "crypt"
    for x in range(mx0, mx1 + 1):
        g[my1 + 1][x] = "grass"
    g[TOMB[1]][TOMB[0]] = "tomb"
    area.links[TOMB] = ("lead", "crypt")
    area.labels[TOMB] = "the %s mausoleum" % world["fam"]
    area.labels[(gx0, 49)] = area.labels[(gx0, 55)] = \
        "the Old Arkham Graveyard"
    for b in blocks:                            # houses everywhere else
        x0, y0, x1, y1 = block_rect(*b)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                if (x, y) in used or g[y][x] == "lamp":
                    continue
                g[y][x] = rng.choice(("tree", "tree2", "tree3")) \
                    if rng.random() < 0.12 else "grass"
        for hy in range(y0 + 1, y1, 3):
            for hx in range(x0, x1 - 1, 4):
                if rng.random() > 0.85:
                    continue
                cells = [(x, y) for y in (hy, hy + 1) for x in
                         (hx, hx + 1, hx + 2) if y <= y1 and x <= x1]
                if any(c in used or g[c[1]][c[0]] == "lamp" for c in cells):
                    continue
                look = rng.choice(("house", "house2", "house3"))
                for x, y in cells:
                    g[y][x] = look
    g[0][45] = g[11 - 1][0] = g[H - 1][47] = g[46][W - 1] = "sign_n"
    area.signs = {(45, 0): "n", (0, 10): "w", (47, H - 1): "s",
                  (W - 1, 46): "e"}
    if "found:cave" in flags or "known:woods" in flags:
        g[CAVE[1]][CAVE[0]] = "cave"
    area.links[CAVE] = ("lead", "woods")
    area.labels[CAVE] = "a cave mouth"
    area.links[ISLAND] = ("lead", "vault")
    area.labels[ISLAND] = "the stone slab"
    for x, y in STONES:
        area.labels[(x, y)] = "a standing stone"
    area.start = (DOCK[0] + 14, SOUTH_Y[3])
    return area


