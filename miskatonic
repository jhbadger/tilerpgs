           "dfloor_cellar", "dwall_tunnel", "dfloor_tunnel", "dwall_brick",
           "dfloor_wet", "dwall_cave", "dfloor_cave", "dwall_vault",
           "dfloor_vault", "pool", "steam", "angle", "circle", "rubble",
           "gate", "coffin", "crate", "dark_altar"]
ANIMATED_TERRAIN = {"water", "lamp", "slab", "pool", "steam", "angle",
                    "circle", "dark_altar"}


def all_tiles():
    """name -> pixel rows, for every tile and animation frame."""
    tiles = {}
    for name in TERRAIN:
        tiles[name] = draw_terrain(name)
        if name in ANIMATED_TERRAIN:
            tiles[name + "@1"] = draw_terrain(name, 1)
    sprites = {}
    for name, (shape, pal) in PEOPLE.items():
        sprites[name] = art_pixels(pal, PERSON_SHAPES[shape])
    for name, (pal, rows) in ART.items():
        sprites[name] = art_pixels(pal, rows)
    still = {"hit", "bolt", "bullet", "ward"} | FLOOR_ITEMS
    for name, px in sprites.items():
        tiles[name] = px
        SPRITES.add(name)
        if name in still:
            continue
        if name == "dweller":
            pal, rows = ART[name]
            swapped = dict(pal, o=pal["O"], O=pal["o"])
            tiles[name + "@1"] = art_pixels(swapped, rows)
        else:           # a bob: up a pixel
            tiles[name + "@1"] = px[1:] + [[None] * 16]
    return tiles

