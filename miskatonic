def make_people(rng):
    people = {}
    for role, (tile, sex, honorific, title) in ROLES.items():
        sex = sex or rng.choice("MF")
        if role == "armitage":
            first, last = "Henry", "Armitage"
        else:
            first = rng.choice(MALE if sex == "M" else FEMALE)
            last = rng.choice(SURNAMES)
        if sex == "F" and tile in ("man", "man2", "man3", "prof", "student",
                                   "doctor"):
            tile = {"doctor": "nurse", "prof": "woman3",
                    "student": "flapper"}.get(tile, "woman2")
        if honorific == "Mr." and sex == "F":
            honorific = "Mrs."
        full = "%s %s" % (first, last)
        short = ("%s %s" % (honorific, last)) if honorific else first
        people[role] = {"first": first, "last": last, "sex": sex,
                        "tile": tile, "name": ("%s %s" % (honorific, full))
                        if honorific else full, "short": short,
                        "title": title}
    return people


def make_person(world, role, x, y):
    who = world["people"][role]
    m = Mob(who["tile"], who["name"], x, y)
    m.role = role
    m.title = who["title"]
    m.shop = SHOPS.get(role)
    m.leader = role == world["leader"]
    m.talk, m.greet = role_talk(world, role)
    return m


def fill(text, world):
    p = world["people"]
    names = {r: v["short"] for r, v in p.items()}
    names.update({r + "_full": v["name"] for r, v in p.items()})
    names.update(fam=world["fam"], FAM=world["fam"].upper(),
                 leader=p[world["leader"]]["short"],
                 leader_full=p[world["leader"]]["name"],
                 leader_title=p[world["leader"]]["title"])
    return text.format(**names)


