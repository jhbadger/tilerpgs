def generate_world(seed):
    """The case: who is who, which leads are live, where the leaves are."""
    rng = random.Random("%s:world" % seed)
    world = {"seed": seed, "fam": rng.choice(OLD_FAMILIES),
             "people": make_people(rng)}
    world["leader"] = rng.choice(LEADER_ROLES)
    leads = rng.sample(CASE_LEADS, 4)
    world["leads"] = leads
    names = list(LEAF_NAMES)
    rng.shuffle(names)
    world["leaves"] = dict(zip(leads, names))
    world["diary"] = rng.choice(leads)
    world["errands"] = make_errands(rng, world)
    return world


