NOTE_STEPS = {"C": 0, "D": 2, "E": 4, "F": 5, "G": 7, "A": 9, "B": 11}


def note_number(name):
    """MIDI note number of a name such as 'C#4' or 'Bb3'."""
    n = NOTE_STEPS[name[0]] + 12 * (int(name[-1]) + 1)
    return n + name[1:-1].count("#") - name[1:-1].count("b")


def freq_of(midi):
    return 440.0 * 2 ** ((midi - 69) / 12)


def chord_note(chord, token):
    """Pitch of pattern token R/T/F<octave> over a chord such as 'F#m'."""
    minor = chord.endswith("m")
    root = note_number((chord[:-1] if minor else chord) + token[1])
    return root + {"R": 0, "T": 3 if minor else 4, "F": 7}[token[0]]


def synth_note(buf, start, n, freq, wave, duty, gain):
    att = int(0.004 * RATE)
    rel = max(1, min(int(0.025 * RATE), n // 3))
    step = freq / RATE
    for k in range(min(n, len(buf) - start)):
        ph = (k * step) % 1.0
        if wave == "square":
            v = 1.0 if ph < duty else -1.0
        else:
            v = 4 * ph - 1 if ph < 0.5 else 3 - 4 * ph
        env = gain * (1 - 0.3 * k / n)
        if k < att:
            env *= k / att
        elif k > n - rel:
            env *= (n - k) / rel
        buf[start + k] += v * env


def synth_drum(buf, start, kind, rng):
    if kind == "k":                                  # falling sine thump
        n = int(0.12 * RATE)
        for k in range(min(n, len(buf) - start)):
            t = k / RATE
            buf[start + k] += 0.35 * (1 - k / n) ** 2 * math.sin(
                2 * math.pi * (110 * t - 160 * t * t))
        return
    n, gain, a = ((int(0.11 * RATE), 0.12, 0.75) if kind == "s"
                  else (int(0.03 * RATE), 0.06, 0.95))
    y = x_prev = 0.0
    for k in range(min(n, len(buf) - start)):
        x = rng.uniform(-1, 1)
        y = a * (y + x - x_prev)                     # high-passed noise
        x_prev = x
        buf[start + k] += y * gain * (1 - k / n) ** 2


def render_tune(tune):
    step = int(RATE * 60 / tune["tempo"])
    chords = tune["chords"].split()
    bar = tune["bar"]
    nsteps = len(chords) * bar
    buf = [0.0] * (nsteps * step)

    def play(tokens, wave, duty, gain, pitch):
        i = 0
        while i < len(tokens):
            j = i + 1
            while j < len(tokens) and tokens[j] == "-":
                j += 1
            if tokens[i] not in ".-":
                synth_note(buf, i * step, (j - i) * step,
                           freq_of(pitch(i, tokens[i])), wave, duty, gain)
            i = j

    melody = tune["melody"].replace("|", " ").split()
    if len(melody) != nsteps:
        raise ValueError("melody has %d steps, not %d" % (len(melody), nsteps))
    wave, duty, gain = tune["lead"]
    play(melody, wave, duty, gain, lambda i, t: note_number(t))
    for wave, duty, gain, pattern in tune["voices"]:
        play(pattern.split() * len(chords), wave, duty, gain,
             lambda i, t: chord_note(chords[i // bar], t))
    rng = random.Random(1)
    for i, t in enumerate(tune["drums"].split() * len(chords)):
        if t != ".":
            synth_drum(buf, i * step, t, rng)
    return [v * MUSIC_VOLUME for v in buf]


# Players.  Each starts a WAV file and returns a handle that, like a
# subprocess, has poll() (None while it plays) and terminate().  On the
# desktop that is a command-line player; Android has none, so there the game
# uses Android's MediaPlayer through pyjnius, or failing that SDL's mixer.

class CommandPlayer:
    def __init__(self, cmd):
        self.cmd = cmd

    def start(self, path):
        return subprocess.Popen(self.cmd + [path], stdout=subprocess.DEVNULL,
                                stderr=subprocess.DEVNULL)

    @classmethod
    def find(cls):
        for cmd in (["afplay"], ["paplay"], ["aplay", "-q"]):
            if shutil.which(cmd[0]):
                return cls(cmd)


class MediaPlayer:
    """Android's android.media.MediaPlayer, reached through pyjnius (pip
    install pyjnius in Pydroid)."""

    class Handle:
        def __init__(self, mp):
            self.mp = mp

        def poll(self):
            if self.mp is None:
                return 0
            try:
                if self.mp.isPlaying():
                    return None
            except Exception:
                pass
            self.terminate()
            return 0

        def terminate(self):
            if self.mp is not None:
                try:
                    self.mp.stop()
                except Exception:
                    pass
                self.mp.release()
                self.mp = None

    def __init__(self, cls):
        self.cls = cls

    def start(self, path):
        mp = self.cls()
        try:
            mp.setDataSource(path)
            mp.prepare()
            mp.start()
        except Exception as e:
            mp.release()
            raise OSError(str(e))
        return self.Handle(mp)

    @classmethod
    def find(cls):
        try:
            import importlib
            jnius = importlib.import_module("jnius")
            return cls(jnius.autoclass("android.media.MediaPlayer"))
        except Exception:
            return None


class MixerPlayer:
    """SDL's mixer, through pygame.  Pydroid chooses how to run a script
    from the modules it imports, so the module's name is put together at
    run time: a Tk game must not be started as an SDL one."""

    class Handle:
        def __init__(self, channel, snd):
            self.channel, self.snd = channel, snd

        def poll(self):
            ch = self.channel
            if ch and ch.get_busy() and ch.get_sound() is self.snd:
                return None
            return 0

        def terminate(self):
            if self.poll() is None:
                self.channel.stop()

    def __init__(self, mixer):
        self.mixer = mixer
        self.sounds = {}

    def start(self, path):
        snd = self.sounds.get(path)
        if snd is None:
            try:
                snd = self.sounds[path] = self.mixer.Sound(path)
            except Exception as e:
                raise OSError(str(e))
        return self.Handle(snd.play(), snd)

    @classmethod
    def find(cls):
        try:
            import importlib
            os.environ.setdefault("PYGAME_HIDE_SUPPORT_PROMPT", "1")
            mixer = importlib.import_module("py" + "game.mixer")
            mixer.init(RATE, -16, 1, 512)
            mixer.set_num_channels(8)
            return cls(mixer)
        except Exception:
            return None


def find_player():
    player = CommandPlayer.find()
    if not player and ANDROID:
        player = MediaPlayer.find()
    return player or MixerPlayer.find()


class Sound:
    def __init__(self):
        self.muted = False
        self.music_off = False
        self.tune = None            # the tune that should be playing
        self.music_proc = None
        self.music_playing = None
        self.music_deadline = 0     # when the playing loop should be over
        self.player = find_player()
        self.files = {}
        self.tunes = {}
        self.lengths = {}           # tune file: seconds
        self.procs = []             # effects still playing
        if self.player:
            atexit.register(self.stop_music)
            self.dir = tempfile.mkdtemp(prefix="miskatonic-")
            atexit.register(shutil.rmtree, self.dir, True)
            threading.Thread(target=self.synthesize, daemon=True).start()

    @staticmethod
    def tone(buf, t0, freq, dur, wave_type="sine", gain=0.25, attack=0.005):
        start = int(t0 * RATE)
        n = int(dur * RATE)
        need = start + n
        if len(buf) < need:
            buf.extend([0.0] * (need - len(buf)))
        for k in range(n):
            t = k / RATE
            if t < attack:
                env = 0.0001 * (gain / 0.0001) ** (t / attack)
            else:
                env = gain * (0.0001 / gain) ** ((t - attack) / (dur - attack))
            ph = (freq * t) % 1.0
            if wave_type == "sine":
                v = math.sin(2 * math.pi * ph)
            elif wave_type == "square":
                v = 1.0 if ph < 0.5 else -1.0
            else:  # triangle
                v = 4 * ph - 1 if ph < 0.5 else 3 - 4 * ph
            buf[start + k] += v * env

    @staticmethod
    def noise(buf, t0, dur, freq=800, gain=0.3):
        """High-passed white-noise burst with an exponential decay."""
        start = int(t0 * RATE)
        n = int(dur * RATE)
        need = start + n
        if len(buf) < need:
            buf.extend([0.0] * (need - len(buf)))
        rc = 1 / (2 * math.pi * freq)
        a = rc / (rc + 1 / RATE)
        y = x_prev = 0.0
        for k in range(n):
            x = random.uniform(-1, 1)
            y = a * (y + x - x_prev)
            x_prev = x
            env = gain * (0.0001 / gain) ** (k / n)
            buf[start + k] += y * env

    def write(self, name, buf, path=None):
        path = path or os.path.join(self.dir, name + ".wav")
        pcm = array.array("h", (int(max(-1.0, min(1.0, v)) * 32000)
                                for v in buf + [0.0] * 200))
        if sys.byteorder == "big":
            pcm.byteswap()
        with wave.open(path, "wb") as w:
            w.setnchannels(1)
            w.setsampwidth(2)
            w.setframerate(RATE)
            w.writeframes(pcm.tobytes())
        self.files[name] = path
        return path

    def synthesize(self):
        tone, noise = self.tone, self.noise
        b = []
        noise(b, 0, 0.07, 1400, 0.3)
        tone(b, 0, 200, 0.07, "square", 0.08)
        self.write("hit", b)
        b = []
        noise(b, 0, 0.06, 3500, 0.12)
        self.write("miss", b)
        b = []
        tone(b, 0, 160, 0.12, "square", 0.14)
        tone(b, 0.05, 110, 0.14, "square", 0.12)
        self.write("hurt", b)
        b = []
        for i, f in enumerate((660, 495, 330, 220)):
            tone(b, i * 0.06, f, 0.1, "triangle", 0.2)
        self.write("kill", b)
        b = []
        tone(b, 0, 1318.5, 0.08, "triangle", 0.18)
        tone(b, 0.06, 1760, 0.14, "triangle", 0.16)
        self.write("gold", b)
        b = []
        for i, f in enumerate((523.25, 659.25, 783.99, 1046.5)):
            tone(b, i * 0.09, f, 0.3, "triangle", 0.22)
        self.write("level", b)
        b = []
        for i in range(3):
            noise(b, i * 0.09, 0.06, 900 - i * 200, 0.2)
        self.write("stairs", b)
        b = []
        noise(b, 0, 0.1, 500, 0.18)
        tone(b, 0, 90, 0.1, "sine", 0.1)
        self.write("door", b)
        b = []
        run = (392.0, 523.25, 659.25, 783.99, 1046.5)
        for i, f in enumerate(run):
            tone(b, i * 0.1, f, 0.45, "triangle", 0.25)
        tone(b, 0.55, 1046.5, 0.8, "triangle", 0.2)
        tone(b, 0.55, 1318.5, 0.8, "triangle", 0.15)
        self.write("quest", b)
        b = []
        for i, f in enumerate((392.0, 349.2, 311.1, 261.6)):
            tone(b, i * 0.22, f, 0.4, "square", 0.1)
        self.write("death", b)
        b = []
        for i in range(8):
            tone(b, i * 0.03, 400 + i * 90, 0.06, "sine", 0.15)
        self.write("potion", b)
        b = []
        tone(b, 0, 110, 0.07, "square", 0.07)
        self.write("bump", b)
        b = []
        tone(b, 0, 300, 0.12, "sine", 0.12)
        tone(b, 0.04, 200, 0.2, "sine", 0.1)
        noise(b, 0, 0.25, 300, 0.2)
        self.write("fire", b)
        b = []
        noise(b, 0, 0.09, 2500, 0.18)
        tone(b, 0, 600, 0.06, "square", 0.05)
        self.write("throw", b)
        b = []
        for i in range(6):
            tone(b, i * 0.035, 1200 + i * 260, 0.12, "sine", 0.12)
        self.write("spell", b)
        b = []
        noise(b, 0, 0.18, 1800, 0.45)
        tone(b, 0, 70, 0.2, "sine", 0.3)
        self.write("shot", b)
        b = []
        for i, f in enumerate((587.3, 554.4, 415.3, 311.1)):
            tone(b, i * 0.05, f, 0.5, "square", 0.06)
            tone(b, i * 0.05, f * 1.06, 0.5, "square", 0.05)
        self.write("horror", b)
        b = []
        for i in range(4):
            tone(b, i * 0.5, 55, 0.12, "sine", 0.35)
            tone(b, i * 0.5 + 0.16, 50, 0.12, "sine", 0.25)
        self.write("heart", b)
        b = []
        for i in range(3):
            tone(b, i * 0.3, 110, 0.6, "triangle", 0.18)
            tone(b, i * 0.3, 164.8, 0.6, "triangle", 0.12)
        self.write("chant", b)
        self.synthesize_music()

    def synthesize_music(self):
        """Render each tune once; the WAVs are cached between runs, named
        by a checksum of the tune so editing a tune re-renders it."""
        order = sorted(MUSIC, key=lambda n: n != (self.tune or "city"))
        for name in order:
            tune = MUSIC[name]
            sig = zlib.crc32(json.dumps([tune, RATE], sort_keys=True).encode())
            path = os.path.join(MUSIC_CACHE, "%s-%08x.wav" % (name, sig))
            if not os.path.exists(path):
                try:
                    os.makedirs(MUSIC_CACHE, exist_ok=True)
                    tmp = path + ".tmp"
                    self.write("music-" + name, render_tune(tune), tmp)
                    os.replace(tmp, path)
                except OSError:
                    path = self.write("music-" + name, render_tune(tune))
            with wave.open(path) as w:
                self.lengths[path] = w.getnframes() / w.getframerate()
            self.tunes[name] = path

    # Music loops by restarting the player whenever it finishes; tick() is
    # called a few times a second.

    def tick(self):
        want = None if self.music_off else self.tunes.get(self.tune)
        proc = self.music_proc
        if proc and proc.poll() is None and time.monotonic() > \
                self.music_deadline:
            self.stop_music()       # a stuck player: start it over
            proc = None
        if want == self.music_playing and proc and proc.poll() is None:
            return
        if want != self.music_playing or (proc and proc.poll() is not None):
            self.stop_music()
        if want:
            try:
                self.music_proc = self.player.start(want)
                self.music_playing = want
                self.music_deadline = (time.monotonic() +
                                       self.lengths.get(want, 60) + 5)
            except OSError:
                self.music_off = True

    def stop_music(self):
        if self.music_proc and self.music_proc.poll() is None:
            self.music_proc.terminate()
        self.music_proc = self.music_playing = None

    def play(self, name):
        """Play an effect, unless too many are still going: if the system's
        audio is stuck, players never exit, and they must not pile up."""
        path = self.files.get(name)
        if self.muted or not path:
            return
        self.procs = [p for p in self.procs if p.poll() is None]
        if len(self.procs) >= 4:
            return
        try:
            self.procs.append(self.player.start(path))
        except OSError:
            pass


# ── Gamepad ──────────────────────────────────────────────────────────────────
#
# Tk knows nothing of gamepads, but on Linux (a Steam Deck included) the
# kernel's joystick devices can be read directly: 8-byte events of time,
# value, type (1 button, 2 axis) and number.  A thread reads them and hands
# them to the Tk loop through a queue.  The numbers below are those of the
# xpad driver (Xbox-style pads and Steam's virtual gamepad); edit them for
# other pads.

PAD_BUTTONS = {0: "a", 1: "b", 2: "x", 3: "y", 4: "lb", 5: "rb",
               6: "view", 7: "start",
               11: "left", 12: "right", 13: "up", 14: "down"}  # d-pad buttons
PAD_STICK = (0, 1)              # left stick x, y axes
PAD_HAT = (6, 7)                # d-pad x, y axes
PAD_DEADZONE = 16000


class Gamepad:
    def __init__(self):
        self.events = queue.Queue()
        if sys.platform.startswith("linux"):
            threading.Thread(target=self.read, daemon=True).start()

    def read(self):
        while True:
            for path in sorted(glob.glob("/dev/input/js*")):
                try:
                    with open(path, "rb") as f:
                        while True:
                            data = f.read(8)
                            if len(data) < 8:
                                break
                            _, value, kind, number = struct.unpack("IhBB",
                                                                   data)
                            if not kind & 0x80:     # skip the initial state
                                self.events.put((kind, number, value))
                except OSError:
                    pass
            time.sleep(2)                           # wait for one to appear


# ── Persistence ──────────────────────────────────────────────────────────────

def load_saved():
    try:
        with open(SAVE_FILE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def pack_bits(b):
    return base64.b64encode(zlib.compress(bytes(b))).decode()


def unpack_bits(s, n):
    b = bytearray(zlib.decompress(base64.b64decode(s)))
    if len(b) != n:
        raise ValueError("bad map")
    return b



