    g = grid_of(base)
    for y in range(16):
        for x in range(16):
            a, b = (x, y) if vertical else (y, x)
            if a % width == width - 1:
                g[y][x] = seam
            elif rng.random() < 0.08:
                g[y][x] = shade(base, 0.9)
    for i in range(4):          # butt joints
        a = rng.randrange(16)
        b = i * width + rng.randrange(width - 1)
        if vertical:
            g[a][min(15, b)] = seam
        else:
            g[min(15, b)][a] = seam
    return g


def water(rng, phase):
    g = grid_of("#1c3644")
    speckle(g, rng, ["#20404e"], 0.3)
    for y in range(2, 16, 4):
        x0 = (y * 5 + phase * 3) % 16
        for k in range(4):
            g[y][(x0 + k) % 16] = "#3a6474"
    return g


def roof(rng, base):
    g = grid_of(base)
    dark = shade(base, 0.72)
    for y in range(16):
        if y % 4 == 3:
            for x in range(16):
                g[y][x] = dark
        else:
            for x in range((y // 4) * 2 % 4, 16, 4):
                g[y][x] = shade(base, 0.85)
    speckle(g, rng, [shade(base, 1.12)], 0.06)
    return g


def tree(rng, colours):
    g = grass(rng)
    rect(g, 7, 11, 8, 15, "#4a3020")
    light, mid, dark = colours
    disc(g, 7.5, 7, 6.6, dark, rng, 0.6)
    disc(g, 7.5, 6.5, 5.6, mid, rng, 0.6)
    disc(g, 6, 5, 2.6, light, rng, 0.5)
    speckle_within(g, rng, mid, [light, dark], 0.12)
    return g


def speckle_within(g, rng, inside, colours, p):
    for y in range(16):
        for x in range(16):
            if g[y][x] == inside and rng.random() < p:
                g[y][x] = rng.choice(colours)


def bookshelf(rng):
    g = grid_of("#4a3020")
    for shelf in (1, 6, 11):
        x = 1
        while x < 15:
            w = rng.choice((1, 1, 2))
            c = rng.choice(("#7a1e1e", "#1e3a6a", "#2e5a2e", "#6a5a1e",
                            "#3a2a4a", "#8a6a3a", "#1a1a1a"))
            top = shelf + rng.choice((0, 0, 1))
            rect(g, x, top, min(14, x + w - 1), shelf + 3, c)
            x += w
        rect(g, 0, shelf + 4, 15, shelf + 4, "#2e1c10")
    return g


def draw_terrain(name, frame=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random(name + str(frame))
    if name == "grass":
        return grass(rng)
    if name == "field":
        g = grid_of("#6b5a35")
        for y in range(1, 16, 3):
            rect(g, 0, y, 15, y, "#55462a")
        speckle(g, rng, ["#8a7845", "#7a6a3e"], 0.15)
        return g
    if name == "sand":
        g = grid_of("#9a8a60")
        speckle(g, rng, ["#aa9a6c", "#8a7a52"], 0.3)
        return g
    if name == "path":
        g = grid_of("#6e5a3c")
        speckle(g, rng, ["#7e6a48", "#5e4a30"], 0.3)
        return g
    if name == "woods":
        g = grid_of("#2a2412")
        for _ in range(7):
            c = rng.choice(("#6e3a1a", "#8a4a1c", "#4b5320", "#7a5a1e",
                            "#5a2a14"))
            disc(g, rng.uniform(1, 14), rng.uniform(1, 14),
                 rng.uniform(2.5, 4.5), c, rng, 0.7)
