def make_errands(rng, world):
    errands = []
    roles = rng.sample(ERRAND_ROLES, 4)
    for n, role in enumerate(roles):
        if n % 2 == 0:
            errands.append({"id": "e%d" % n, "kind": "cat", "giver": role,
                            "cat": rng.choice(PET_NAMES),
                            "pet": rng.choice(PET_KINDS),
                            "spot": (rng.choice(STREET_X[1:-1]),
                                     rng.choice(STREET_Y[1:-1])),
                            "pay": rng.choice((3, 4, 5))})
        else:
            to = rng.choice([r for r in ERRAND_ROLES + ["librarian",
                                                        "scooper", "cook"]
                             if r != role and r not in roles])
            errands.append({"id": "e%d" % n, "kind": "parcel",
                            "giver": role, "to": to,
                            "thing": rng.choice(PARCELS),
                            "pay": rng.choice((2, 3, 4))})
    return errands


