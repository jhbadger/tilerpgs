def block_rect(i, j, half=None):
    x0, x1 = STREET_X[i] + 1, STREET_X[i + 1] - 1
    y0, y1 = STREET_Y[j] + 1, STREET_Y[j + 1] - 1
    if half == "L":
        x1 = x0 + 3
    elif half == "R":
        x0 += 5
    return x0, y0, x1, y1


def coast(y):
    return 7 + round(1.2 * math.sin(y / 5.0))


def district(x, y):
    """The part of Marigold Bay a square lies in."""
    if x <= coast(y):
        return "the Pacific Ocean"
    if PIER_Y[0] <= y <= PIER_Y[1] and x <= 14:
        return "the pier"
    if x < 15:
        return "the beach"
    if x < 18:
        return "the boardwalk"
    if y < 6:
        return "Lover's Point" if x < 30 else "the hills"
    if CAMPUS[0] <= x <= CAMPUS[2] and CAMPUS[1] <= y <= CAMPUS[3]:
        return "Marigold Bay High"
    if MALL_LOT[0] <= x <= MALL_LOT[2] and MALL_LOT[1] <= y <= MALL_LOT[3]:
        return "the Seaview Mall"
    if DRIVEIN[0] <= x <= DRIVEIN[2] and DRIVEIN[1] <= y <= DRIVEIN[3]:
        return "the Starlite Drive-In"
    if x > 78:
        return "the edge of the desert"
    if y < 15:
        return "downtown"
    return "Sunset Heights" if x < 48 else "Palm Grove"


def make_city(world, flags):
    """Marigold Bay, the same every game but for what the week adds."""
    rng = random.Random("marigold-1997")
    W, H = CITY_W, CITY_H
    g = [["grass"] * W for _ in range(H)]
    for y in range(H):
        c = coast(y)
        for x in range(W):
            if x < c:
                g[y][x] = "water"
            elif x == c:
                g[y][x] = "surf"
            elif x < 15:
                g[y][x] = "palm_sand" if rng.random() < 0.03 else "sand"
            elif x < 17:
                g[y][x] = "boardwalk" if 7 <= y <= 56 else "sand"
            elif x == 17:
                g[y][x] = "palm" if y % 3 == 0 else "grass"
            elif y < 6 or x > 78:
                r = rng.random()
                g[y][x] = ("rock" if r < 0.06 else "palm" if r < 0.1 else
                           "hill")
    for y in range(0, 6):               # Lover's Point: cliffs over the sea
        for x in range(coast(y) + 1, 17):
            g[y][x] = "rock" if rng.random() < 0.3 else "hill"
    g[LOOKOUT[1]][LOOKOUT[0]] = "hill"
    g[LOOKOUT[1] + 1][LOOKOUT[0]] = "hill"
    for x in range(coast(PIER_Y[0]) - 5, 15):     # the pier
        for y in PIER_Y:
            if x >= 0:
                g[y][x] = "pier"
    for y in STREET_Y:                  # streets
        for x in range(STREET_X[0], STREET_X[-1] + 1):
            g[y][x] = "street"
    for x in STREET_X:
        for y in range(STREET_Y[0], STREET_Y[-1] + 1):
            g[y][x] = "street"
    for y in range(H):                  # the coast highway, all the way
        g[y][STREET_X[0]] = "street"
    for x in range(STREET_X[-1], W):    # the road east
        g[30][x] = "street"
    for y in range(STREET_Y[0], 0, -1):     # up to the hills
        g[y][38] = "path"
    for y in (8, 22, 40, 52):           # down to the beach
        for x in range(15, 18):
            g[y][x] = "path" if x == 17 else g[y][x]

    area = Area("city", ("city",), g, "Marigold Bay", edge="hill")
    used = set()
    blocks = [(i, j) for i in range(6) for j in range(6)]
    for i, j in blocks:                 # street lights on the corners
        x0, y0, x1, y1 = block_rect(i, j)
        g[y0][x0] = "lamp"
    cx0, cy0, cx1, cy1 = CAMPUS         # Marigold Bay High
    for y in range(cy0, cy1 + 1):
        for x in range(cx0, cx1 + 1):
            g[y][x] = "lawn"
            used.add((x, y))
    for x in range(cx0, cx1 + 1):
        g[20][x] = g[29][x] = "path"
    for y in range(cy0, cy1 + 1):
        g[y][38] = "path"
    for y in range(16, 20):
        for x in range(30, 47):
            g[y][x] = "bldg3"
    for y in range(24, 29):
        for x in range(30, 36):
            g[y][x] = "bldg3"
    for y in range(23, 29):
        for x in range(40, 47):
            g[y][x] = "field"
    g[23][43] = g[28][43] = "goalpost"
    g[22][34] = "statue"
    area.labels[(34, 22)] = "the statue of Marvin the Marigold Bay Marlin"
    mx0, my0, mx1, my1 = MALL_LOT      # Seaview Mall and its parking lot
    for y in range(my0, my1 + 1):
        for x in range(mx0, mx1 + 1):
            g[y][x] = "lot"
            used.add((x, y))
    for y in range(32, 37):
        for x in range(50, 67):
            g[y][x] = "mallwall"
    dx0, dy0, dx1, dy1 = DRIVEIN        # the Starlite Drive-In
    for y in range(dy0, dy1 + 1):
        for x in range(dx0, dx1 + 1):
            g[y][x] = "lot"
            used.add((x, y))
    for x in range(dx0 + 1, dx1):
        g[SCREEN_Y][x] = "screen"
    for y in range(SCREEN_Y + 3, 41, 3):
        for x in range(dx0 + 1, dx1, 3):
            g[y][x] = "speaker"
    for y in range(42, 45):
        for x in range(71, 76):
            g[y][x] = "bldg2"
    for sid, (name, kind, (i, j, half), look) in SITES.items():
        x0, y0, x1, y1 = block_rect(i, j, half)
        for y in range(y0 + 1, y1 + 1):
            for x in range(x0, x1 + 1):
                g[y][x] = look
        door = ((x0 + x1 + 1) // 2, y1)
        g[door[1]][door[0]] = "door"
        area.links[door] = ("bld", sid)
        area.labels[door] = name if sid != "home" else \
            "the %s house" % world["family"]
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                used.add((x, y))
    for sid, (name, kind, door) in BIG_SITES.items():
        g[door[1]][door[0]] = "door"
        area.links[door] = ("bld", sid)
        area.labels[door] = name
    x0, y0, x1, y1 = block_rect(*PARK)          # Marigold Park
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            edge = x in (x0, x1) or y in (y0, y1)
            g[y][x] = "palm" if edge and (x + y) % 3 == 0 else "lawn"
            used.add((x, y))
    g[(y0 + y1) // 2][(x0 + x1) // 2] = "fountain"
    area.labels[((x0 + x1) // 2, (y0 + y1) // 2)] = "Marigold Park"
    x0, y0, x1, y1 = block_rect(4, 0, "R")      # Zeb's lot, out front
    for x in range(x0 - 1, x1 + 2):
        if g[y0][x] not in ("lamp", "door"):
            g[y0][x] = "saucer_lot"
    for i, j in blocks:                         # houses everywhere else
        x0, y0, x1, y1 = block_rect(i, j)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                if (x, y) in used or g[y][x] in ("lamp", "saucer_lot"):
                    continue
                g[y][x] = "palm" if rng.random() < 0.1 else "grass"
        for hy in range(y0 + 1, y1, 3):
            for hx in range(x0, x1 - 1, 4):
                if rng.random() > 0.85:
                    continue
                cells = [(x, y) for y in (hy, hy + 1) for x in
                         (hx, hx + 1, hx + 2) if y <= y1 and x <= x1]
                if any(c in used or g[c[1]][c[0]] in ("lamp", "saucer_lot")
                       for c in cells):
                    continue
                look = rng.choice(("house", "house2", "house3"))
                for x, y in cells:
                    g[y][x] = look
    g[0][19] = g[H - 1][19] = g[29][W - 1] = "sign_n"
    area.signs = {(19, 0): "n", (19, H - 1): "s", (W - 1, 29): "e"}
    g[DRAIN[1]][DRAIN[0]] = "drain"
    area.links[DRAIN] = ("lead", "sewer")
    area.labels[DRAIN] = "a storm drain"
    area.labels[LOOKOUT] = "Lover's Point"
    if "found:saucer" in flags or "known:saucer" in flags:
        sx, sy = SAUCER
        for y in range(sy - 1, sy + 2):
            for x in range(sx - 1, sx + 2):
                g[y][x] = "crater"
        g[sy][sx - 1] = g[sy][sx + 1] = "wreck"
        g[sy][sx] = "hatchway"
    area.links[SAUCER] = ("lead", "saucer")
    area.labels[SAUCER] = "a crashed flying saucer"
    area.start = (STREET_X[1] + 4, STREET_Y[5])
    return area


