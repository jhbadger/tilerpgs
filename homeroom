        return g
    if name == "door":
        g = stucco(rng, "#d8d0c0")
        rect(g, 3, 2, 12, 15, "#3a3a4a")
        rect(g, 4, 3, 11, 15, "#80c0e0")
        rect(g, 7, 3, 8, 15, "#3a3a4a")
        rect(g, 5, 4, 6, 6, "#c0e8f8")
