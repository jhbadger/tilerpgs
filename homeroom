def make_interior(world, sid):
    if sid in SITES:
        name, kind, _, _ = SITES[sid]
    else:
        name, kind, _ = BIG_SITES[sid]
    floor, rows, cast = ROOMS[kind]
    g, spots = [], {}
    for y, row in enumerate(rows):
        line = []
        for x, ch in enumerate(row):
            if ch.isdigit():
                spots[cast[ch]] = (x, y)
                line.append(floor)
            else:
                line.append(ROOM_TILES.get(ch, floor))
        g.append(line)
    if sid == "home":
        name = "the %s house" % world["family"]
    area = Area("inside", ("bld", sid), g, name, edge=None)
    area.site = sid
    for y, row in enumerate(g):
        for x, t in enumerate(row):
            if t == "exit":
                area.start = (x, y - 1)
            elif t in ("hatch", "brokencab"):
                area.links[(x, y)] = ("lead", HATCH_LEADS[sid])
    for role, (x, y) in spots.items():
        if role in world["people"]:
            area.mobs.append(make_person(world, role, x, y))
    return area


