        self.setup_world(random.randrange(1 << 31))
        self.p = self.make_teener(who)
        self.flags = set()
        self.clues = []
        self.topics = set()
        self.shards = []                # leads whose shards you carry
        self.returned = []              # leads whose shards Fizzwick has
        self.side = {}                  # errands: id -> state
        self.turn = 0
        self.funk = 0
        self.city = None
        self.reset_view()
        self.log.config(state="normal")
        self.log.delete("1.0", "end")
        self.log.config(state="disabled")
        self.city_pos = list(self.door_of("school"))
        area = self.get_area(("bld", "school"))
        self.flags.add("been:school")
        desk = next((x, y + 1) for y in range(area.h) for x in range(area.w)
                    if area.grid[y][x] == "desk" and
                    area.grid[y + 1][x] in INSIDE_FLOOR)
        self.area, self.pos = area, list(desk)
        p = self.p
        self.say("Marigold Bay, California. Monday, three o'clock: the last "
                 "bell.", "quest")
        self.say("%s, a %s %s, is stuffing books into a backpack when the "
                 "PA crackles:" % (p["name"], p["kind"].lower(),
                                   p["clique"].lower()))
        self.say("ATTENTION. WOULD %s PLEASE REPORT TO DR. FIZZWICK IN THE "
                 "SCIENCE LAB. IMMEDIATELY. THIS IS NOT A DRILL. WELL, IT IS "
                 "A LITTLE BIT A DRILL." % p["name"].upper(), "talk")
        self.say("The science lab is up the hall, to the east. Arrow keys or "
                 "WASD move; walk into people to talk. Press ? for help.",
                 "info")
        self.layout()
        self.save()

    def reset_view(self):
        self.overlay = None
        self.overlay_text = None
        self.end_talk()
        self.busy = False
        self.aim = None
        self.menu = None
        self.walking = None

    def restore(self, g):
        self.setup_world(int(g["seed"]))
        p = g["player"]
        for k in ("name", "kind", "stats", "knacks", "bonk", "rwp",
                  "powers", "clique"):
            if k not in p:
                raise ValueError("bad Teener")
        if p["weapon"] not in GADGETS or p["clique"] not in CLIQUES:
            raise ValueError("bad gadget")
        self.p = p
        self.flags = set(g.get("flags", []))
        self.swap_world()
        self.clues = list(g.get("clues", []))
        self.topics = set(g.get("topics", []))
        self.shards = list(g.get("shards", []))
        self.returned = list(g.get("returned", []))
        self.side = {str(k): dict(v) for k, v in g.get("side", {}).items()}
        self.turn = int(g.get("turn", 0))
        self.funk = 0
        self.city = None
        self.reset_view()
        city = self.get_area(("city",))
        city.seen = unpack_bits(g["seen"], CITY_W * CITY_H)
        self.city_pos = g.get("city_pos")
        self.surface = g.get("surface")
        if self.surface:
            self.surface = (tuple(self.surface[0]), self.surface[1])
        key = tuple(g["key"])
        self.area = self.get_area(key)
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        if not self.can_stand(*self.pos):
            self.pos = list(self.area.start)
        p["out"] = p["held"] = 0
        self.say("Marigold Bay, %s." % self.date_text(), "quest")
        self.say("Welcome back, %s. Press ? for help." % p["name"], "info")
        self.layout()
        if "won" in self.flags:
            self.show_won()
        elif self.turn >= DEADLINE:
            self.doom()

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "scale": self.scale}
        if getattr(self, "p", None) and getattr(self, "area", None):
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "clues": self.clues,
                "topics": sorted(self.topics), "shards": self.shards,
                "returned": self.returned, "side": self.side,
                "turn": self.turn, "key": list(self.area.key),
                "pos": self.pos, "city_pos": self.city_pos,
                "surface": [list(self.surface[0]), self.surface[1]]
                if getattr(self, "surface", None) else None,
                "seen": pack_bits(self.get_area(("city",)).seen)}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.root.destroy()

    # ── Areas ──

    def get_area(self, key):
        if key in self.cache:
            return self.cache[key]
        w = self.world
        if key[0] == "city":
            area = make_city(w, self.flags)
            self.populate_city(area)
            area.lit = {(x + dx, y + dy) for y in range(area.h)
                        for x in range(area.w) if area.grid[y][x] == "lamp"
                        for dx in range(-2, 3) for dy in range(-2, 3)
                        if abs(dx) + abs(dy) <= 3}
        elif key[0] == "bld":
            if key[1] not in SITES and key[1] not in BIG_SITES:
                raise ValueError("bad site")
            area = make_interior(w, key[1])
            for m in area.mobs:
                self.give_errand(m)
            if key[1] == "gym":
                self.dress_gym(area)
            self.apply_swaps(area)
            if key[1] == "home":
                area.mobs = [m for m in area.mobs if m.role != "dad" or
                             not 8 <= self.now().hour < 18 or
                             self.now().weekday() >= 5]
        elif key[0] == "dun":
            lid, level = key[1], int(key[2])
            if lid not in LEADS or not 1 <= level <= LEADS[lid].levels:
                raise ValueError("bad level")
            area = make_dungeon(w, lid, level, self.flags)
            key = area.key
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        return area

    def populate_city(self, area):
        """Townsfolk, the fisherman, the lifeguard, the Snack Shack and
        runaway pets."""
        rng = random.Random("%s:folk" % self.world["seed"])
        streets = [(x, y) for y in range(area.h) for x in range(area.w)
                   if area.grid[y][x] in ("street", "boardwalk")
                   and 6 <= y <= 54]
        area.folk = []
        doorsteps = {(x + dx, y + dy) for x, y in area.links
                     for dx, dy in DIRS}
        streets = [s for s in streets if s not in doorsteps]
        for i in range(24):
            x, y = rng.choice(streets)
            if area.mob_at(x, y):
                continue
            m = make_folk(self.world, rng, i, x, y)
            area.folk.append(m)
        fisher = make_person(self.world, "fisherman", 2, PIER_Y[0])
        guard = make_person(self.world, "lifeguard", 12, 26)
        guard.roam, guard.home = {"sand"}, (12, 26)
        snack = make_person(self.world, "snack", 16, 20)
        area.mobs = list(area.folk) + [fisher, guard, snack]
        self.apply_swaps(area)
        for m in area.mobs:
            self.give_errand(m)
        self.release_cats(area)

    def dress_gym(self, area):
        """Saturday night: the Formal, and the Hyperdisco."""
        if len(self.returned) >= 4:
            for y, row in enumerate(area.grid):
                for x, t in enumerate(row):
                    if t == "disco_dark" and "won" in self.flags:
                        row[x] = "disco"
        if self.turn < FORMAL:
            return
        area.mobs = [m for m in area.mobs if m.role in ("coach", "prepkid")]
        spots = [(x, y) for y in range(3, 7) for x in range(2, area.w - 2)
                 if area.grid[y][x] == "gymfloor"]
        rng = random.Random(self.turn // 60)
        rng.shuffle(spots)
        for n, name in enumerate(("Judge Glorp of Glorbia",
                                  "Judge Vexa of the Crab Nebula",
                                  "Judge Mmmf of Rigel VII")):
            x, y = 3 + n * 5, 2
            if area.grid[y][x] != "gymfloor":
                x, y = spots.pop()
            m = Mob("judge", name, x, y)
            m.title = "a Galactic party judge"
            m.greet = random.choice(("This party is... adequate so far.",
                                     "Where is the famous Hyperdisco?",
                                     "On my planet the dancing has more "
                                     "legs."))
            m.talk = {"job": "I judge parties for the Galactic Registry of "
                             "Fun Planets.",
                      "news": "We leave at midnight. With or without "
                              "dancing.", "hype": "We have heard of it. "
                              "We have not SEEN it."}
            area.mobs.append(m)
        for i in range(5):
            if not spots:
                break
            x, y = spots.pop()
            m = make_folk(self.world, rng, 100 + i, x, y)
            m.roam = {"gymfloor"}
            area.mobs.append(m)
        date = self.p.get("date")
        if date and spots and not any(m.role == date for m in area.mobs):
            x, y = spots.pop()
            area.mobs.append(make_person(self.world, date, x, y))
        if spots:
            x, y = spots.pop()
            area.mobs.append(make_person(self.world, "fizzwick", x, y))

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        if area.kind == "city":
            self.night_and_day()
        self.sound.play(sound)
        self.layout()
        self.save()

    def go_outside(self):
        """Out of a building, onto its doorstep."""
        a = self.area
        if a.site == "home" and self.p["grounded"] and \
                "sneaked" not in self.flags:
            self.grounded_door()
            return
        if a.site == "gym" and any(m.kind == "borelord" for m in a.mobs):
            self.say("The doors are jammed with grey goo. You'll have to "
                     "deal with the Bore-Lord first!", "bad")
            return
        city = self.get_area(("city",))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.enter(city, self.city_pos or city.start)
        self.say("You step out into %s." % district(*self.pos), "info")

    def enter_link(self, link, x, y):
        kind, what = link
        if kind == "bld":
            if self.p["driving"]:
                self.say("You park, and go in.", "info")
                self.p["driving"] = None
            self.city_pos = list(self.pos)
            if what in ("gym",):
                self.cache.pop(("bld", "gym"), None)
            if what == "home":
                self.cache.pop(("bld", "home"), None)
            area = self.get_area(("bld", what))
            self.flags.add("been:" + what)
            self.say("You go into %s." % area.name, "info")
            self.enter(area, area.start)
            if what == "gym":
                self.gym_arrival()
            return
        self.at_lead(what, x, y)

    def descend(self, lid):
        if self.area.kind == "city":
            self.city_pos = list(self.pos)
        self.p["driving"] = None
        self.surface = (self.area.key, list(self.pos))
        area = self.get_area(("dun", lid, 1))
        self.say("You go down into %s." % area.name.split(",")[0], "info")
        self.enter(area, area.start, "stairs")

    def change_level(self, delta):
        _, lid, level = self.area.key
        if level + delta == 0:
            key, pos = self.surface
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dun"}
            area = self.get_area(tuple(key))
            self.say("You climb back up, into the sunshine (or whatever "
                     "it is up there now).", "info")
            self.enter(area, pos, "stairs")
            return
        area = self.get_area(("dun", lid, level + delta))
        self.say("You go %s to level %d." % (
            "down" if delta > 0 else "up", level + delta), "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        n = int(self.log.index("end").split(".")[0])
        if n > 600:
            self.log.delete("1.0", "%d.0" % (n - 500))
        self.log.config(state="disabled")
        self.log.see("end")

    @staticmethod
    def the(mob):
        return mob.name if mob.boss or mob.role or mob.name[0].isupper() \
            else "the " + mob.name

    # ── Numbers ──

    def on(self, power):
        """Whether a power (or something like one) is working right now."""
        p = self.p
        if power in p["on"]:
            return True
        if power == "Bounce":
            return "Bounce" in p["powers"] or "spring shoes" in p["items"]
        if power == "Super Strength":
            return "Super Strength" in p["powers"] or "Monster Out" in \
                p["on"] or "Lose It" in p["on"]
        if power == "Super Speed":
            return "Super Speed" in p["powers"] or "Lose It" in p["on"]
        return False

    def max_bonk(self):
        p = self.p
        return p["stats"]["Bonk"] + (4 if "Toughness" in p["powers"] or
                                     "Lose It" in p["on"] else 0) + (
            4 if "Monster Out" in p["on"] else 0)

    def stat(self, name):
        """A Stat as it stands now: RWP as your folks feel today, Looks
        with makeup, Bod Monstered Out, and so on."""
        p = self.p
        if name == "RWP":
            return p["rwp"]
        v = p["stats"][name]
        if name == "Looks" and "timestop makeup" in p["items"]:
            v += 1
        if name == "Bod" and "Monster Out" in p["on"]:
            v += 2
        if name in ("Smarts", "Cool") and self.tired():
            v -= 1
        return v

    def knack(self, ctx):
        """The best Knack for a kind of roll: (name, points)."""
        best = (None, 0)
        for k, n in self.p["knacks"].items():
            if KNACKS[k][1] == ctx and n > best[1]:
                best = (k, n)
        return best

    def tired(self):
        return self.turn - self.p["slept"] > 18 * 60 + 15 * 60 * (
            self.p["slept"] == 0)

    def stat_roll(self, stats, ctx=None, diff=0, bonus=0, label=None,
                  quiet=False):
        """A die plus the best of the Stats (plus a Knack) against a die
        plus the difficulty; the other side wins ties.  Returns how much
        you won by (or lost by, as zero or less)."""
        if isinstance(stats, str):
            stats = (stats,)
        best = max(stats, key=self.stat)
        k, kn = self.knack(ctx) if ctx else (None, 0)
        if best == "Luck" and "Lucky Break" in self.p["powers"]:
            bonus += 2
        mine, theirs = random.randint(1, 6), random.randint(1, 6)
        total = mine + self.stat(best) + kn + bonus
        against = theirs + diff
        margin = total - against
        if not quiet:
            parts = ["%s %d" % (best, self.stat(best))]
            if k:
                parts.append("%s %d" % (k, kn))
            if bonus:
                parts.append("%+d" % bonus)
            self.say("[%s%s + die %d = %d vs %d: %s]" % (
                label + ": " if label else "", " + ".join(parts), mine,
                total, against, "made it" if margin > 0 else "no good"),
                "roll")
        return margin

    def ok(self, *a, **kw):
        return self.stat_roll(*a, **kw) > 0

    def lose_rwp(self, n, why):
        p = self.p
        before = p["rwp"]
        p["rwp"] = max(-5, p["rwp"] - n)
        p["rwp_lost"] += n
        self.say("%s RWP -%d (now %d)." % (why, n, p["rwp"]), "bad")
        if p["rwp"] < 0 <= before:
            self.say("Your folks are going to ground you for this.", "bad")

    def gain_rwp(self, n, why):
        p = self.p
        old = p["rwp"]
        p["rwp"] = min(p["stats"]["RWP"], p["rwp"] + n)
        if p["rwp"] > old:
            self.say("%s RWP +%d (now %d)." % (why, p["rwp"] - old,
                                              p["rwp"]), "good")

    def gain_tp(self, n, why):
        self.p["tp"] += n
        self.p["tp_total"] += n
        self.say("+%d Teener Point%s, %s." % (n, "s" if n > 1 else "", why),
                 "gold")

    # ── Time ──

    def now(self):
        return START + datetime.timedelta(minutes=self.turn)

    def clock(self):
        t = self.now()
        return self.turn // DAY + 1, t.hour

    def day_no(self):
        return (self.now() - START.replace(hour=0)).days

    def date_text(self):
        t = self.now()
        return "%s %d:%02d %s" % (
            t.strftime("%a"), (t.hour - 1) % 12 + 1, t.minute,
            "am" if t.hour < 12 else "pm")

    def phase(self):
        h = self.now().hour
        return ("night" if h >= 21 or h < 5 else "dawn" if h < 7 else
                "dusk" if h >= 19 else "day")

    def school_time(self):
        t = self.now()
        return t.weekday() < 5 and SCHOOL_HOURS[0] <= t.hour < \
            SCHOOL_HOURS[1] and self.day_no() >= 1

    def curfew(self):
        """The hour you have to be home by tonight (24 = midnight)."""
        wd = self.now().weekday() if self.now().hour >= 5 else \
            (self.now() - datetime.timedelta(days=1)).weekday()
        return {4: 24, 5: 25}.get(wd, 23)

    def at_home(self):
        return self.area.key == ("bld", "home")

    def at_school(self):
        a = self.area
        return a.key in (("bld", "school"), ("bld", "gym")) or (
            a.kind == "dungeon" and a.lead == "boiler") or (
            a.kind == "city" and district(*self.pos) == "Marigold Bay High")

    def pass_time(self, minutes, quiet=False):
        """Time going by in a lump: research, sleep, class."""
        before = self.phase()
        for _ in range(minutes // 30):
            self.turn += 30
            self.rules_of_the_house()
            if self.overlay:
                return
        self.turn += minutes % 30
        if not quiet and self.phase() != before:
            self.say("It's %s now: %s." % (self.phase(), self.date_text()),
                     "info")
        self.night_and_day()
        if self.turn >= DEADLINE and "won" not in self.flags:
            self.doom()

    def rules_of_the_house(self):
        """Curfew, cutting class, and your folks' moods, checked now and
        then."""
        t = self.now()
        day = self.day_no()
        hour = t.hour + (24 if t.hour < 5 else 0)
        if self.turn >= DEADLINE:
            return
        if hour >= self.curfew() and not self.at_home() and \
                "late:%d:%d" % (day - (t.hour < 5), hour) not in self.flags:
            self.flags.add("late:%d:%d" % (day - (t.hour < 5), hour))
            late = hour - self.curfew()
            if late in (0, 2):
                self.lose_rwp(1, "You're out past curfew!" if not late else
                              "It's %d:00 and you're STILL not home!" %
                              ((t.hour - 1) % 12 + 1))
        if self.school_time() and not self.at_school() and \
                "truant:%d" % day not in self.flags and t.minute < 30:
            if not self.ok("Luck", diff=3, label="Luck, not getting "
                           "caught cutting class"):
                self.flags.add("truant:%d" % day)
                self.say("The truant officer spots you. The school calls "
                         "your folks.", "bad")
                self.lose_rwp(2, "Cutting class!")
        if t.hour == 6 and "morning:%d" % day not in self.flags:
            self.flags.add("morning:%d" % day)
            self.morning()

    def morning(self):
        """A new day: your folks wake up feeling the way they feel."""
        p = self.p
        if p["rwp"] < 0:
            if not p["grounded"]:
                self.say("Your folks have talked it over: you're GROUNDED. "
                         "(RWP below zero. Chores will help.)", "bad")
            p["grounded"] = True
        elif p["grounded"]:
            p["grounded"] = False
            self.say("You're not grounded any more.", "good")
        if not p["rwp_lost"]:
            self.gain_rwp(1, "A whole day without trouble!")
        p["rwp_lost"] = 0
        self.flags.discard("sneaked")
        if "Filthy Rich" in p["powers"]:
            p["cash"] += 100
        if self.now().weekday() == 5:
            p["cash"] += p["allowance"]
            self.say("Saturday: allowance day. +$%d." % p["allowance"],
                     "gold")

    def night_and_day(self):
        """At night most townsfolk go home; they come out in the morning."""
        city = self.cache.get(("city",))
        if not city:
            return
        night = self.phase() == "night"
        here = getattr(self, "area", None)
        folk = [m for m in city.folk if not night or m.night_owl]
        city.mobs = [m for m in city.mobs if m not in city.folk or m in folk]
        for m in folk:
            if m not in city.mobs and not city.mob_at(m.x, m.y):
                city.mobs.append(m)
        if not night:
            px, py = self.pos if here is city else (-99, -99)
            city.mobs = [m for m in city.mobs if not m.hostile or m.boss
                         or abs(m.x - px) + abs(m.y - py) <= 6]

    # ── Turns ──

    def on_key(self, ev):
        if self.talk or self.busy or ev.state & 0x0C:
            return
        k = ev.keysym
        self.walking = None
        if self.menu:
            k = k[3:] if k.startswith("KP_") else k
            if k in ("Up", "w", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "space", "KP_Enter"):
                self.menu_pick()
            elif k.isdigit() and 1 <= int(k) <= len(self.menu["items"]):
                self.menu_pick(int(k) - 1)
            else:
                self.menu_cancel()
            return
        if self.overlay:
            if self.overlay in ("won", "doom") and k in ("n", "N"):
                self.new_game()
            elif self.overlay not in ("won", "doom") or k in ("Escape",
                                                              "Return"):
                self.close_overlay()
            return
        if self.aim:
            if k in MOVE_KEYS:
                self.aimed(*MOVE_KEYS[k])
            else:
                self.aim = None
                self.say("Never mind.", "info")
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("e", "E"):
            self.search()
        elif k in ("f", "F"):
            self.ready_fire()
        elif k in ("c", "C"):
            self.choose_power()
        elif k in ("u", "U"):
            self.use_menu()
        elif k in ("g", "G"):
            self.wheels()
        elif k in ("space", "period", "KP_5"):
            self.wait()
        elif k in ("i", "I"):
            self.show_sheet()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def close_overlay(self):
        if self.overlay in ("won", "doom"):
            self.action_menu()
            return
        self.overlay = None
        self.render()

    def ready(self):
        return not (self.busy or self.talk or self.overlay or self.menu)

    def steps(self):
        """How many squares a step takes you."""
        p, a = self.p, self.area
        if p["driving"]:
            return WHEELS[p["driving"]][0]
        n = 1
        if self.on("Super Speed") or p["rocket"]:
            n = 2
        elif "Run Like Heck" in p["powers"] and a.kind == "city":
            n = 2
        elif p["flying"] and a.kind == "city":
            n = 2
        return n

    def can_stand(self, x, y):
        """Whether you can be on a square, the way you're going now."""
        a, p = self.area, self.p
        t = a.grid[y][x]
        if a.kind == "city":
            mode = WHEELS[p["driving"]][1] if p["driving"] else \
                "air" if p["flying"] else "foot"
            if mode == "road":
                return t in ROAD
            if mode == "air":
                return t in CITY_GROUND or t in WATER or t in (
                    "rock", "palm", "palm_sand", "hedge", "fence", "crater",
                    "speaker", "saucer_lot", "lamp")
            if mode == "surf":
                return t in CITY_GROUND or t in WATER
            if mode == "ground":
                return t in CITY_GROUND
            return t in WALKABLE or t in ("crater", "saucer_lot")
        return t in WALKABLE

    def move(self, dx, dy):
        if not self.ready():
            return
        p = self.p
        fr = p["freak"]
        if fr and fr["kind"] == "run" and random.random() < 0.5:
            dx, dy = random.choice(DIRS)
            self.say("AAAAAH! Your legs run off without you!", "mad")
        if p["held"]:
            p["held"] -= 1
            self.say("You're stuck! You wriggle." if p.get("held_by")
                     else "You pick yourself up.", "bad")
            self.end_turn()
            return
        moved = False
        for i in range(self.steps()):
            r = self.step(dx, dy, first=i == 0)
            if r == "moved":
                moved = True
                if self.area.kind == "dungeon" and \
                        self.area.grid[self.pos[1]][self.pos[0]] != "dfloor":
                    break
                continue
            if r == "done":
                return
            if r == "turn":
                moved = True
            break
        if moved:
            slow = self.area.kind == "dungeon" and self.underfoot(*self.pos)
            self.end_turn()
            if slow and not self.busy and not self.overlay:
                self.end_turn()

    def step(self, dx, dy, first=True):
        """One square: "moved", "turn" (something took the turn), "done"
        (handled, the turn's over or wasn't spent) or "blocked"."""
        p, a = self.p, self.area
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if not first:
                return "blocked"
            if a.kind == "inside":
                self.go_outside()
            elif a.kind == "city":
                side = ("n" if y < 0 else "s" if y >= a.h else
                        "w" if x < 0 else "e")
                self.say(EDGE_ROADS[side] + " Not this week. This week, "
                         "it's the Formal.", "info")
                self.sound.play("bump")
            else:
                self.bump()
            return "done"
        mob = a.mob_at(x, y)
        if mob:
            if not first:
                return "blocked"
            if p["driving"] and mob.hostile:
                self.ram(mob)
                self.end_turn()
            elif mob.hostile and not mob.calm and not mob.ally:
                if p["freak"] and p["freak"]["kind"] == "run":
                    self.say("You can't make yourself go near it!", "mad")
                    self.end_turn()
                    return "done"
                self.attack(mob)
                self.end_turn()
            elif mob.cat is not None:
                self.catch_cat(mob)
            elif mob.ally:
                mob.x, mob.y, self.pos = self.pos[0], self.pos[1], [x, y]
                return "moved"
            elif mob.hostile:
                self.say("%s just wants to be left alone now." %
                         cap(self.the(mob)), "info")
            elif p["driving"]:
                self.say("Beep beep! %s jumps out of the way. Just." %
                         cap(mob.title), "info")
                self.sound.play("bump")
            else:
                self.start_talk(mob)
            return "done"
        t = a.grid[y][x]
        if t == "counter" and first:
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return "done"
        link = a.links.get((x, y))
        if link and t in ("door", "drain", "hatchway", "hatch",
                          "brokencab"):
            if not first:
                return "blocked"
            self.enter_link(link, x, y)
            return "done"
        if (x, y) in a.signs or t == "sign_n":
            if first:
                self.say("A sign. " + EDGE_ROADS[a.signs.get((x, y), "n")],
                         "info")
            return "done" if first else "blocked"
        if t in ("shelf", "case", "bed", "desk", "locker", "cabinet",
                 "brokencab", "disco", "disco_dark", "window", "rack",
                 "fountain", "statue", "gate", "crate", "house", "house2",
                 "house3", "bldg", "bldg2", "bldg3", "mallwall", "screen",
                 "wreck", "saucer_lot", "rock", "goalpost", "booth",
                 "table") and not self.can_stand(x, y):
            if first:
                self.touch(t, x, y)
                return "done"
            return "blocked"
        if a.kind == "city" and t in WATER and not self.can_stand(x, y):
            if first:
                self.say("The Pacific. Cold, wet, and full of surfers. "
                         "You'd need to fly, or a board.", "info")
                self.sound.play("bump")
                return "done"
            return "blocked"
        if not self.can_stand(x, y):
            if first:
                if p["driving"] and a.kind == "city":
                    self.say("Your %s can't go there." % p["driving"],
                             "info")
                    self.sound.play("bump")
                else:
                    self.bump()
                return "done"
            return "blocked"
        self.pos = [x, y]
        if t == "exit":
            self.go_outside()
            return "done"
        if t == "stairs_down":
            self.change_level(1)
            return "done"
        if t == "stairs_up":
            self.change_level(-1)
            return "done"
        if self.step_on(x, y):
            return "turn"
        return "moved"

    def bump(self):
        self.say("Blocked.", "info")
        self.sound.play("bump")

    def underfoot(self, x, y):
        """Banana peels and hazards below; True if wading (slow)."""
        a, p = self.area, self.p
        if p["flying"]:
            return False
        if (x, y) in a.traps:
            a.traps.discard((x, y))
            a.items[(x, y)] = "trap"
            if self.on("Bounce"):
                self.say("A banana peel! You bounce right off it. Boing!",
                         "good")
            elif self.ok("Bod", "balance", diff=4, label="Bod, keeping "
                         "your feet"):
                self.say("A banana peel! You windmill your arms, and stay "
                         "up.", "good")
            else:
                self.say("A banana peel! Your feet go one way and you go "
                         "the other.", "bad")
                self.flash(x, y)
                self.hurt(1, "Splat")
                for m in a.mobs:
                    if m.hostile and abs(m.x - x) + abs(m.y - y) <= 10:
                        m.aware = True
        t = a.grid[y][x]
        if t == "steam":
            self.hurt(1, "A blast of steam frizzes your hair")
        elif t == "zapfloor":
            self.hurt(1, "ZZZT! The floor zaps you")
        elif t == "goo":
            if not self.ok("Bod", "balance", diff=3, quiet=True):
                p["held"] = 1
                p["held_by"] = True
                self.say("You're stuck in pink goo!", "bad")
        elif t == "glitch":
            spots = [(sx, sy) for sx, sy in self.floor_spots(a)
                     if abs(sx - x) + abs(sy - y) > 4 and not a.mob_at(sx, sy)]
            if spots:
                self.pos = list(random.choice(spots))
                self.say("The floor glitches. You are somewhere else. "
                         "Bzzt.", "mad")
        elif t == "sludge":
            self.say("You squelch through sludge. Ew.", "info")
            return True
        return False

    @staticmethod
    def floor_spots(a):
        if not hasattr(a, "floor_cache"):
            a.floor_cache = [(x, y) for y in range(a.h) for x in range(a.w)
                             if a.grid[y][x] == "dfloor"]
        return a.floor_cache

    def end_turn(self):
        p, a = self.p, self.area
        before = self.phase()
        self.turn += 1
        now = self.phase()
        if now != before:
            if a.kind == "city":
                self.say({"dawn": "The sun comes up over the hills.",
                          "day": "Another perfect day in Marigold Bay.",
                          "dusk": "The sun goes down into the Pacific. The "
                                  "street lights flicker on.",
                          "night": "Night. The town goes quiet; the grey "
                                   "men come out."}[now], "info")
            self.night_and_day()
        if self.turn % 30 == 0:
            self.rules_of_the_house()
            if self.overlay:
                return
        if self.turn % 60 == 0 and p["bonk"] < self.max_bonk() and \
                not p["out"]:
            p["bonk"] += 1
        for k in list(p["on"]):
            p["on"][k] -= 1
            if p["on"][k] <= 0:
                del p["on"][k]
                self.power_ends(k)
        fr = p["freak"]
        if fr:
            fr["turns"] -= 1
            if fr["turns"] <= 0:
                self.end_freak()
        if self.turn >= DEADLINE and "won" not in self.flags:
            self.doom()
            return
        if a.kind == "dungeon":
            px, py = self.pos
            for tx, ty in list(a.traps):
                if abs(tx - px) + abs(ty - py) <= 1 and \
                        random.random() < 0.15 + 0.05 * self.stat("Smarts"):
                    a.traps.discard((tx, ty))
                    a.items[(tx, ty)] = "trap"
                    self.say("You spot a banana peel on the floor. Classic.",
                             "info")
        self.render()
        self.first_sight()
        if self.funk > 0:
            self.funk -= 1
            if not self.funk:
                self.say("Time starts again. Everything blinks.", "mad")
            self.render()
            return
        for mob in list(a.mobs):
            if self.overlay:
                return
            if mob not in a.mobs or self.area is not a:
                continue
            if mob.ally:
                self.ally_act(mob)
            elif mob.hostile:
                self.monster_act(mob)
                if p["bonk"] <= 0 and not p["out"]:
                    self.bonked_out()
                    return
            elif mob.follower:
                self.follow(mob)
            else:
                self.wander(mob)
        if a.kind == "city":
            self.spawn_city()
        self.render()

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        if t in WATER:
            return "swim" in MONSTERS[mob.kind].traits if mob.kind else False
        if a.kind == "city":
            return t in CITY_GROUND
        if a.kind == "inside":
            return t in INSIDE_FLOOR
        return t in DUNGEON_FLOOR and t not in ("stairs_up", "stairs_down")

    def hidden_now(self):
        p = self.p
        return any(k in p["on"] for k in ("Nobody Home", "Shapechange",
                                          "Get Small"))

    def monster_act(self, mob):
        m = MONSTERS[mob.kind]
        if mob.stuck:
            mob.stuck -= 1
            if not mob.stuck:
                self.say("%s gets free!" % cap(self.the(mob)), "bad")
            return
        if mob.calm:
            mob.calm -= 1
            self.drift(mob)
            if not mob.calm and not getattr(mob, "tamed", False):
                self.say("%s remembers it was supposed to be mad at you." %
                         cap(self.the(mob)), "bad")
            return
        if getattr(mob, "tamed", False):
            self.drift(mob)
            return
        if "slow" in m.traits and self.turn % 2:
            return
        steps = 2 if "fast" in m.traits else 1
        for _ in range(steps):
            if mob not in self.area.mobs or (self.p["bonk"] <= 0 and
                                             not self.p["out"]):
                return
            if self.monster_step(mob, m):
                return

    def monster_step(self, mob, m):
        """One move; True if it attacked (and so is done)."""
        a = self.area
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if self.p["out"]:
            if dist == 1 and random.random() < 0.3:
                self.say(random.choice((
                    "%s draws a moustache on your face.",
                    "%s pokes you with a stick. You don't notice.",
                    "%s puts a sign on your back: KICK ME.",
                    "%s takes a photo of you drooling.")) %
                    cap(self.the(mob)), "mad")
                if "thief" in m.traits and self.p["cash"]:
                    self.p["cash"] -= 1
                    self.say("And a dollar from your pocket.", "bad")
            return True
        if self.hidden_now() and dist > 1:
            mob.aware = False
        if not mob.aware:
            if (dist <= 1 or ((mob.x, mob.y) in self.visible and dist <= 7
                              and not self.hidden_now()
                              and not self.ok("Bod", "sneak", diff=2,
                                              quiet=True))):
                mob.aware = True
            else:
                self.drift(mob)
                return False
        if mob.flee > 0:
            mob.flee = max(0, mob.flee - 1)
            for sx, sy in sorted(DIRS, key=lambda d: -abs(px - mob.x - d[0])
                                 - abs(py - mob.y - d[1])):
                if self.can_go(mob, mob.x + sx, mob.y + sy):
                    mob.x += sx
                    mob.y += sy
                    break
            return False
        if dist == 1:
            self.monster_attack(mob)
            return True
        if (m.ranged and (dx == 0 or dy == 0) and dist <= 6
                and self.line_clear(a, mob.x, mob.y, px, py)
                and random.random() < 0.4):
            self.monster_ranged(mob)
            return True
        if "human" in m.traits and mob.bonk <= mob.maxbonk // 3 and \
                not mob.boss and random.random() < 0.3:
            mob.flee = 6
            self.say("%s turns and runs!" % cap(self.the(mob)), "info")
            return False
        chase = dist <= 12
        if "erratic" in m.traits and random.random() < 0.4:
            chase = False
        if chase:
            order = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                           abs(py - mob.y - d[1]) + random.random() * 0.5)
        else:
            order = [random.choice(DIRS)]
        for sx, sy in order[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break
        return False

    def drift(self, mob):
        if random.random() < 0.3:
            sx, sy = random.choice(DIRS)
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy

    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        a = self.area
        if (a.inside(x, y) and a.grid[y][x] in mob.roam
                and not a.mob_at(x, y) and [x, y] != self.pos
                and not any((x + ex, y + ey) in a.links for ex, ey in DIRS)
                and (mob.home is None or abs(x - mob.home[0]) +
                     abs(y - mob.home[1]) <= 5)):
            mob.x, mob.y = x, y

    def follow(self, mob):
        """Someone who adores you, a little too much."""
        a = self.area
        px, py = self.pos
        if abs(mob.x - px) + abs(mob.y - py) <= 1:
            if random.random() < 0.05:
                self.say(random.choice((
                    "%s sighs at you, dreamily.",
                    "%s holds your hand. You let go. They hold it again.",
                    "%s writes your name on their arm in ballpoint.",
                    "%s tells everyone you're going steady.")) %
                    mob.name, "mad")
            return
        for sx, sy in sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                             abs(py - mob.y - d[1])):
            x, y = mob.x + sx, mob.y + sy
            if a.inside(x, y) and self.can_go(mob, x, y):
                mob.x, mob.y = x, y
                break

    def spawn_city(self):
        """At night the grey men are out; more of them as Saturday nears.
        After school, bullies."""
        a = self.area
        px, py = self.pos
        a.mobs = [m for m in a.mobs if not m.hostile or m.boss or
                  abs(m.x - px) + abs(m.y - py) <= 26]
        night = self.phase() == "night"
        h = self.now().hour
        if not night and not 15 <= h < 18:
            return
        if random.random() > (0.04 if night else 0.01):
            return
        day = self.day_no()
        if sum(m.hostile for m in a.mobs) >= 2 + day // 2:
            return
        kinds = ["drone", "drone", "dog"] if night else ["bully"]
        if night and day >= 3:
            kinds += ["drone"]
        for _ in range(20):
            x = px + random.randint(-12, 12)
            y = py + random.randint(-12, 12)
            if (not a.inside(x, y) or a.grid[y][x] not in CITY_GROUND
                    or (x, y) in self.visible or a.mob_at(x, y)
                    or abs(x - px) + abs(y - py) < 8):
                continue
            a.mobs.append(make_monster(random.choice(kinds), x, y))
            return

    # ── Clobbering ──

    def weapon(self):
        return GADGETS[self.p["weapon"]]

    def harm(self, mob, n, how):
        """Bonk to a monster after armour and its nature; how is "clobber",
        "zap" or "power"."""
        m = MONSTERS[mob.kind]
        if how == "clobber" and "rubbery" in m.traits and \
                random.random() < 0.5:
            self.say("It's rubbery! Your blow bounces off. Boing.", "info")
            return 0
        if how != "power" and n > 0:
            n = max(1, n - m.armour)        # a hit always tells, a little
        return max(0, n)

    def attack(self, mob):
        """Clobber whatever's in front of you (or zap it point-blank)."""
        p = self.p
        w = self.weapon()
        self.break_cover()
        if w.reach and (w.bonk or not mob.stuck):
            self.shoot(mob, w)
            return
        if w.reach:                 # it's gooped: now clobber it
            w = GADGETS["Hyperdimensional Hammer" if "Hyperdimensional "
                        "Hammer" in p["gadgets"] else "Fists"]
        m = MONSTERS[mob.kind]
        name = "fists" if w is GADGETS["Fists"] else "hammer"
        margin = self.stat_roll("Bod", "clobber", diff=m.bod,
                                label="clobbering")
        if margin <= 0:
            self.say("You swing at %s and miss." % self.the(mob), "info")
            self.sound.play("miss")
            return
        n = w.bonk + (1 if self.on("Super Strength") else 0)
        self.wound(mob, self.harm(mob, n, "clobber"), "You bop %s with "
                   "your %s" % (self.the(mob), name))

    def shoot(self, mob, w):
        m = MONSTERS[mob.kind]
        self.sound.play("shot")
        self.noise()
        if not mob.hostile:
            self.say("You can't zap a person. (Well, you can. You don't.)",
                     "info")
            return
        if self.stat_roll("Bod", "shoot", diff=m.bod,
                          label="aiming") <= 0:
            self.say("You miss %s!" % self.the(mob), "info")
            self.stray(mob, w)
            return
        if not w.bonk:
            mob.stuck = 3
            self.say("Splorch! %s is glued to the floor in pink goop." %
                     cap(self.the(mob)), "good")
            self.flash(mob.x, mob.y, "goopshot")
            return
        self.wound(mob, self.harm(mob, w.bonk, "zap"), "ZAP! You hit %s" %
                   self.the(mob))

    def stray(self, target, w):
        """A miss into a crowd hits somebody else (it's more fun that
        way)."""
        a = self.area
        near = [m for m in a.mobs if m is not target and m.hostile and
                abs(m.x - target.x) + abs(m.y - target.y) <= 1]
        if near and w.bonk:
            m = random.choice(near)
            self.say("The shot goes wild and hits %s instead!" % self.the(m),
                     "good")
            self.wound(m, self.harm(m, w.bonk, "zap"), "It bonks %s" %
                       self.the(m))

    def wound(self, mob, n, text):
        if n <= 0:
            self.say(text + ", to no effect!", "bad")
            self.sound.play("miss")
            return
        mob.bonk -= n
        mob.aware = True
        mob.calm = 0
        self.flash(mob.x, mob.y)
        self.say(text + ". (%d Bonk)" % n, "good")
        if mob.bonk <= 0:
            self.defeat(mob)
        else:
            self.sound.play("hit")

    def defeat(self, mob):
        a = self.area
        if mob in a.mobs:
            a.mobs.remove(mob)
        m = MONSTERS[mob.kind]
        self.say("%s is BONKED! %s" % (cap(self.the(mob)), random.choice((
            "It spins around three times and falls over.",
            "It runs off, smoking slightly.",
            "Stars and little birds circle its head. It wanders away.",
            "It goes POP, like a balloon."))
            if "human" not in m.traits else
            "They run off, smoking slightly, muttering about your "
            "parents."), "good")
        self.sound.play("kill")
        if getattr(mob, "shard", None):
            a.items[(mob.x, mob.y)] = "shard"
            self.say("Something sparkly falls out: a Disco Shard!", "gold")
            self.gain_tp(1, "for bonking %s" % self.the(mob))
        if mob.leader or mob.kind == "borelord":
            self.flags.add("agent_bonked")
            self.say("The Snorrian agent is Bonked! They zip up into the "
                     "sky in a little grey saucer, shaking a little grey "
                     "fist.", "quest")
            self.gain_tp(2, "for saving the Formal from Snorr")
            if mob.kind == "borelord" and self.area.site == "gym":
                self.say("The crowd cheers. Now: the Hyperdisco!", "quest")

    def monster_attack(self, mob):
        p = self.p
        m = MONSTERS[mob.kind]
        name = cap(self.the(mob))
        if "Forcefield" in p["on"]:
            self.say("%s bounces off your forcefield. Bwoing!" % name,
                     "good")
            return
        if self.stat_roll("Bod", "dodge", diff=m.bod, quiet=True) > 0:
            self.say("%s lunges at you; you duck!" % name, "good")
            self.sound.play("miss")
            return
        self.hurt(m.dmg, "%s %s you" % (name, random.choice((
            "bonks", "whacks", "thumps", "boffs"))))
        if p["bonk"] > 0 and "grab" in m.traits:
            p["held"] = 1
            p["held_by"] = True
            self.say("It grabs you and won't let go!", "bad")
        if "thief" in m.traits and p["cash"] > 0:
            n = min(p["cash"], random.randint(1, 6))
            p["cash"] -= n
            p["stolen"] = p.get("stolen", 0) + n
            self.say("%s takes $%d of your lunch money!" % (name, n), "bad")

    def hurt(self, n, text):
        p = self.p
        if "Forcefield" in p["on"]:
            self.say("%s, but your forcefield takes it." % text, "good")
            return
        if p.get("bikini") and n > 0:
            n = max(0, n - 2)
            if not n:
                self.say("%s, but it bounces off your Battle Bikini." %
                         text, "good")
                return
        p["bonk"] -= n
        self.say("%s! (%d Bonk)" % (text, n), "bad")
        self.flash(*self.pos)
        self.sound.play("hurt")
        if p["flying"] and p["bonk"] <= 0:
            self.fall()
        if p["bonk"] == 1 and "Lose It Completely" in p["powers"] and \
                "Lose It" not in p["on"]:
            p["on"]["Lose It"] = 4
            p["bonk"] += 4
            self.say("That does it. You LOSE IT COMPLETELY! Super "
                     "strength! Super speed! Super stubbornness!", "mad")
        if p["bonk"] <= 0 and not p["out"] and not self.busy:
            self.root.after(1, self.bonked_check)

    def bonked_check(self):
        if self.p["bonk"] <= 0 and not self.p["out"] and not self.overlay:
            self.bonked_out()

    def fall(self):
        p = self.p
        p["flying"] = False
        self.say("You fall out of the sky. WHUMP.", "bad")
        if self.area.kind == "city" and self.area.grid[self.pos[1]][
                self.pos[0]] in WATER:
            self.splash()

    def splash(self):
        """In the sea, without a way to stay up: swim for the beach."""
        a = self.area
        x, y = self.pos
        while a.grid[y][x] in WATER and x < a.w - 1:
            x += 1
        self.pos = [x, y]
        self.say("SPLASH. You swim ashore, spluttering.", "bad")

    def monster_ranged(self, mob):
        m = MONSTERS[mob.kind]
        bod, n, what = m.ranged
        name = cap(self.the(mob))
        self.sound.play("spell")
        self.fly(self.line_path((mob.x, mob.y), tuple(self.pos)),
                 "bolt")
        if self.stat_roll("Bod", "dodge", diff=bod, quiet=True) > 0:
            self.say("%s %s at you; you dive out of the way." % (name, what),
                     "info")
            return
        self.hurt(n, "%s %s at you" % (name, what))
        if "freeze" in m.traits or mob.kind in ("drone", "agent"):
            if self.p["bonk"] > 0 and not self.ok(
                    "Cool", "nerve", diff=3, quiet=True):
                self.p["held"] = 1
                self.p["held_by"] = False
                self.say("So... bored... can't... move...", "mad")

    def ram(self, mob):
        m = MONSTERS[mob.kind]
        if self.ok("Driving", "drive", diff=m.bod, label="ramming"):
            self.wound(mob, self.harm(mob, 2, "clobber"), "BEEP BEEP! You "
                       "run %s down (gently)" % self.the(mob))
        else:
            self.say("You swerve, and hit a lamp post instead.", "bad")
            self.hurt(1, "Crunch")
            if self.p["driving"] == "car":
                self.lose_rwp(1, "You dented the car!")

    # ── Bonked ──

    def bonked_out(self):
        """At zero Bonk: stand about looking stupid for a while."""
        p = self.p
        a = self.area
        p["out"] = 1 + max(0, -p["bonk"])
        p["fainted"] = False
        p["held"] = 0
        p["flying"] = False
        self.walking = None
        a.knockouts += 1
        self.say(random.choice((
            "You're BONKED! You stand there looking stupid, smoking "
            "slightly.",
            "BONK! Little birds circle your head, tweeting.",
            "You're BONKED! Your legs turn to spaghetti. Cartoon "
            "spaghetti.")) + " (%d turn%s)" % (p["out"], "s" if p["out"] > 1
                                                else ""), "bad")
        self.sound.play("death")
        self.busy = True
        self.root.after(300, self.out_step)

    def out_step(self):
        p = self.p
        if self.overlay:
            self.busy = False
            return
        if p["out"] <= 0:
            self.busy = False
            self.come_to()
            return
        self.busy = False
        self.end_turn()             # still out: nothing hits you now
        p["out"] -= 1
        if not self.overlay:
            self.busy = True
            self.root.after(250, self.out_step)
        else:
            self.busy = False

    def come_to(self):
        p = self.p
        a = self.area
        if p["fainted"]:
            p["fainted"] = False
            self.say("You come round. Was that you screaming?", "good")
            self.render()
            return
        p["bonk"] = self.max_bonk()
        self.say("You shake your head, and BOING, you're back! (Bonk "
                 "%d)" % p["bonk"], "good")
        if a.kind == "dungeon" and a.knockouts >= 3:
            self.carried_out()
            return
        self.render()

    def carried_out(self):
        """Bonked once too often: you wake up in the nurse's office."""
        p = self.p
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.say("...and the next thing you know, you're somewhere else "
                 "entirely.", "bad")
        self.pass_time(60, quiet=True)
        if self.overlay:
            return
        p["bonk"] = self.max_bonk()
        p["held"] = 0
        p["driving"] = None
        p["flying"] = False
        night = not 7 <= self.now().hour < 18
        sid = "home" if night else "school"
        self.cache.pop(("bld", "home"), None)
        area = self.get_area(("bld", sid))
        self.city_pos = list(self.door_of(sid))
        self.area, self.pos = area, list(self.bed_spot(area))
        if night:
            self.say("You wake up in your own bed, %s, with an ice pack on "
                     "your head. Somebody carried you home. Your mom is "
                     "standing in the doorway with %s arms folded." % (
                         self.date_text(), fill("{mom_his}", self.world)),
                     "quest")
            self.lose_rwp(1, "Brought home at this hour!")
        else:
            self.say("You wake up in the school nurse's office, %s, with "
                     "an ice pack on your head and no idea how you got "
                     "here. Somebody carried you. Somebody strong." %
                     self.date_text(), "quest")
        self.layout()
        self.save()

    def door_of(self, sid):
        city = self.get_area(("city",))
        for pos, link in city.links.items():
            if link == ("bld", sid):
                return pos[0], pos[1] + 1
        return city.start

    # ── Freaking out ──

    def first_sight(self):
        """The first sight of each kind of monster here: keep your Cool."""
        a = self.area
        for m in a.mobs:
            if not m.hostile or not m.kind or (m.x, m.y) not in self.visible:
                continue
            mon = MONSTERS[m.kind]
            if m.kind in a.scared:
                continue
            a.scared.add(m.kind)
            first = "seen:" + m.kind not in self.flags
            self.flags.add("seen:" + m.kind)
            if not first and not m.boss:
                continue
            self.say("You see %s!" % (self.the(m) if m.boss else
                                      "a " + m.name), "bad")
            if first and self.ok("Smarts", "trivia", diff=3, quiet=True):
                self.say("You know about these: %s." % mon.hint, "mad")
            if mon.scare and not self.ok("Cool", "nerve", diff=mon.scare,
                                         label="Cool, not freaking out"):
                self.freak_out()
                return

    def freak_out(self):
        p = self.p
        kind = random.choice(("scream", "run", "faint", "giggle"))
        self.sound.play("horror")
        if kind == "scream":
            p["held"] = 1
            p["held_by"] = False
            self.say("You scream like a little kid. A really little kid.",
                     "mad")
            return
        if kind == "faint":
            self.say("You faint dead away. Boop.", "mad")
            p["out"] = 2
            p["fainted"] = True
            self.walking = None
            self.busy = True
            self.root.after(300, self.out_step)
            return
        p["freak"] = {"kind": kind, "turns": 4 if kind == "run" else 20}
        self.say({"run": "You FREAK OUT and run around in circles!",
                  "giggle": "You get the giggles. You can't stop. Nobody "
                            "can understand a word you say."}[kind], "mad")

    def end_freak(self):
        fr = self.p["freak"]
        self.p["freak"] = None
        if fr:
            self.say({"run": "You get a grip. Mostly.",
                      "giggle": "The giggles wear off. Hee."}[fr["kind"]],
                     "good")

    def noise(self):
        """Zapping wakes things up, and in town gets noticed."""
        a = self.area
        px, py = self.pos
        for m in a.mobs:
            if m.hostile and abs(m.x - px) + abs(m.y - py) <= 12:
                m.aware = True
        if a.kind == "city" and self.phase() != "night" and \
                not any(m.hostile for m in a.mobs if (m.x, m.y) in
                        self.visible) and not self.ok(
                    "Luck", diff=3, quiet=True):
            self.lose_rwp(1, "Somebody calls your folks about you zapping "
                          "things in broad daylight.")

    # ── Firing ──

    def ready_fire(self):
        if not self.ready():
            return
        p = self.p
        if not self.weapon().reach:
            guns = [g for g in p["gadgets"] if GADGETS[g].reach]
            if not guns:
                self.say("You've nothing to fire. (C for powers, if you "
                         "have any.)", "info")
                return
            p["weapon"] = guns[-1]
            self.say("You whip out your %s." % guns[-1], "info")
        self.aim = ("fire",)
        self.say("Fire which way? (arrow keys, or tap)", "info")

    def aimed(self, dx, dy):
        what = self.aim
        self.aim = None
        if what[0] == "fire":
            self.fire(dx, dy)
        elif what[0] == "gun":
            self.gender_zap(dx, dy)
        else:
            self.power_at(what[1], dx, dy)

    def target_in_line(self, dx, dy, reach, people=False):
        a = self.area
        x, y = self.pos
        path = []
        for _ in range(reach):
            x, y = x + dx, y + dy
            if not a.inside(x, y) or a.grid[y][x] in a.opaque or (
                    a.grid[y][x] not in WALKABLE and a.grid[y][x] not in
                    WATER and a.grid[y][x] not in ("counter", "table",
                                                   "desk", "crate",
                                                   "booth")):
                break
            path.append((x, y))
            mob = a.mob_at(x, y)
            if mob and (mob.hostile or people) and not mob.ally:
                return mob, path
        return None, path

    def fire(self, dx, dy):
        w = self.weapon()
        mob, path = self.target_in_line(dx, dy, w.reach)
        self.break_cover()
        self.fly(path, "goopshot" if not w.bonk else "bolt")
        if mob is None:
            self.say("You fire, and hit nothing.", "info")
            self.sound.play("shot")
            self.noise()
        else:
            self.shoot(mob, w)
        self.end_turn()

    def fly(self, path, tile):
        """A zap or a blob of goop crossing the squares between."""
        cols, rows, ox, oy, ts = self.view
        c = self.canvas
        for x, y in path[:12]:
            i = x - self.pos[0] + cols // 2
            j = y - self.pos[1] + rows // 2
            if 0 <= i < cols and 0 <= j < rows:
                c.coords(self.missile, ox + i * ts, oy + j * ts)
                c.itemconfig(self.missile, image=self.img[tile],
                             state="normal")
                c.tag_raise(self.missile)
                c.update_idletasks()
                time.sleep(0.025)
        c.itemconfig(self.missile, state="hidden")

    @staticmethod
    def line_path(a, b):
        (x0, y0), (x1, y1) = a, b
        n = max(abs(x1 - x0), abs(y1 - y0))
        return [(x0 + round((x1 - x0) * k / n), y0 + round((y1 - y0) * k / n))
                for k in range(1, n + 1)] if n else []

    # ── Powers ──

    def break_cover(self):
        """Doing something loud ends hiding powers."""
        p = self.p
        for k in ("Nobody Home", "Shapechange"):
            if k in p["on"]:
                del p["on"][k]
                self.power_ends(k)

    def choose_power(self):
        if not self.ready():
            return
        p = self.p
        if p["freak"] and p["freak"]["kind"] == "giggle":
            self.say("Hee hee hee. You can't concentrate.", "mad")
            return
        mine = [pw for pw in p["powers"] if pw in ACTIVE_POWERS]
        if "pocket phone" in p["items"] and "Telephone" not in mine:
            mine.append("Telephone")
        if not mine:
            self.say("You don't have any powers you can use like that. "
                     "Gadgets (U) might help.", "info")
            return
        items = []
        for pw in mine:
            label = pw
            if pw in p["on"]:
                label += " (on: %d)" % p["on"][pw]
            elif pw == "Fly" and p["flying"]:
                label += " (land)"
            elif p["rest"].get(pw, 0) > self.turn:
                label += " (resting: %d min)" % (p["rest"][pw] - self.turn)
            elif pw == "Magical Girl":
                label += " (%d wishes)" % self.wishes_left()
            items.append((label + ": " + POWERS[pw].split(":")[0]
                          .split(".")[0], lambda pw=pw: self.use_power(pw)))
        self.open_menu("Use which power?", items)

    def wishes_left(self):
        w = self.p["wishes"]
        if w[0] != self.day_no():
            w[0], w[1] = self.day_no(), 3
        return w[1]

    def use_power(self, pw):
        p = self.p
        if p["rest"].get(pw, 0) > self.turn:
            self.say("You're still recovering from the last time.", "info")
            return
        if pw in AIMED_POWERS:
            self.aim = ("power", pw)
            self.say("%s which way?" % pw, "info")
            return
        if pw == "Fly":
            if self.area.kind == "inside":
                self.say("Not indoors! Think of the ceiling.", "info")
                return
            p["flying"] = not p["flying"]
            if not p["flying"] and self.area.kind == "city" and \
                    self.area.grid[self.pos[1]][self.pos[0]] in WATER:
                self.splash()
            self.say("You take off! Whee!" if p["flying"] else
                     "You come in to land.", "good")
            self.sound.play("spell")
            self.end_turn()
            return
        if pw == "Teleport":
            places = sorted(s[5:] for s in self.flags if s.startswith(
                "been:"))
            self.open_menu("Teleport where?", [
                (fill(SITES[s][0] if s in SITES else BIG_SITES[s][0],
                      self.world) if s != "home" else "Home",
                 lambda s=s: self.teleport(s)) for s in places] +
                [("Never mind", lambda: None)])
            return
        if pw == "Telephone":
            self.telephone()
            return
        if pw == "Magical Girl":
            self.magical_girl()
            return
        if pw == "Boy/Girl/Boy":
            self.boy_girl()
            self.end_turn()
            return
        if pw == "Temporal Funk":
            self.funk = 5
            p["rest"][pw] = self.turn + POWER_REST[pw]
            self.say("You snap your fingers. Time stops. A seagull hangs in "
                     "the air, mid-squawk.", "mad")
            self.sound.play("spell")
            self.render()
            return
        if pw == "Three's a Crowd":
            self.copies()
            return
        if pw == "Incredible Cute":
            self.cute()
            return
        if pw in p["on"]:
            del p["on"][pw]
            self.power_ends(pw)
            self.end_turn()
            return
        turns = {"Monster Out": 20, "Forcefield": 6, "Shapechange": 20,
                 "Get Small": 30, "Nobody Home": 30}[pw]
        if pw == "Monster Out":
            p["bonk"] += 4
            self.sound.play("horror")
            self.say("You MONSTER OUT: fifty feet of rubber, roaring!",
                     "mad")
            if self.area.kind == "city" and self.phase() != "night":
                self.say("Somebody screams. Somebody else calls your folks.",
                         "bad")
                self.lose_rwp(1, "Monstering out in public!")
            for m in self.area.mobs:
                if not m.hostile and m.roam and self.area.kind == "city":
                    m.flee = 4
        else:
            self.say({"Forcefield": "A shimmering bubble pops up around "
                                    "you.",
                      "Shapechange": "You turn into a potted plant. A very "
                                     "convincing potted plant.",
                      "Get Small": "You shrink to the size of a mouse. "
                                   "Squeak!",
                      "Nobody Home": "You switch off. Nobody notices you "
                                     "now. Nobody ever did, really."}[pw],
                     "good")
            self.sound.play("spell")
        p["on"][pw] = turns
        if pw in POWER_REST:
            p["rest"][pw] = self.turn + POWER_REST[pw]
        if pw in ("Shapechange", "Nobody Home", "Get Small"):
            for m in self.area.mobs:
                if m.hostile and abs(m.x - self.pos[0]) + \
                        abs(m.y - self.pos[1]) > 1:
                    m.aware = False
        self.end_turn()

    def power_ends(self, pw):
        p = self.p
        if pw == "Monster Out":
            p["bonk"] = min(p["bonk"], self.max_bonk())
            self.say("You shrink back down to Teener size. Your clothes "
                     "survive, mostly.", "info")
        elif pw == "Lose It":
            p["bonk"] = max(1, min(p["bonk"], self.max_bonk()))
            self.say("You calm down. Whew. Sorry, everybody.", "info")
        elif pw in ("Forcefield", "Shapechange", "Get Small",
                    "Nobody Home"):
            self.say({"Forcefield": "Your forcefield goes pop.",
                      "Shapechange": "You turn back into you.",
                      "Get Small": "You grow back to your usual size.",
                      "Nobody Home": "People can see you again."}[pw],
                     "info")

    def power_at(self, pw, dx, dy):
        p = self.p
        reach = {"Zap": 8, "Breathe Fire": 3, "Deep Freeze": 6,
                 "Telemove": 6, "Talk to Aliens": 6, "Read Minds": 1,
                 "Bonk Drain": 1}[pw]
        people = pw in ("Read Minds", "Talk to Aliens")
        mob, path = self.target_in_line(dx, dy, reach, people)
        self.sound.play("spell")
        if pw == "Read Minds":
            if not mob or mob.hostile:
                self.say("There's nobody there to read.", "info")
            else:
                self.read_mind(mob)
            self.end_turn()
            return
        if pw == "Telemove":
            self.telemove(path)
            self.end_turn()
            return
        if pw == "Breathe Fire":
            self.break_cover()
            self.fly(path, "fire")
            hit = [self.area.mob_at(*s) for s in path]
            hit = [m for m in hit if m and m.hostile and not m.ally]
            if not hit:
                self.say("WHOOSH! You scorch the scenery.", "info")
            for m in hit:
                self.wound(m, self.harm(m, 2, "power"), "WHOOSH! You "
                           "toast %s" % self.the(m))
            if self.area.kind == "city" and self.phase() != "night" and \
                    not self.ok("Luck", diff=3, quiet=True):
                self.lose_rwp(1, "You scorched somebody's hedge.")
            self.end_turn()
            return
        if mob is None:
            self.fly(path, "bolt")
            self.say("Nothing there.", "info")
            self.end_turn()
            return
        m = MONSTERS[mob.kind] if mob.kind else None
        if pw == "Talk to Aliens":
            self.talk_to_alien(mob)
            self.end_turn()
            return
        self.break_cover()
        if pw == "Zap":
            self.fly(path, "bolt")
            if self.stat_roll("Bod", "shoot", diff=m.bod,
                              label="zapping") > 0:
                self.wound(mob, self.harm(mob, 2, "power"), "ZZAP! You "
                           "zap %s" % self.the(mob))
            else:
                self.say("Your zap goes wide.", "info")
        elif pw == "Deep Freeze":
            self.fly(path, "bolt")
            if self.stat_roll("Bod", "shoot", diff=m.bod,
                              label="freezing") > 0:
                mob.stuck = 2
                self.wound(mob, self.harm(mob, 1, "power"), "You freeze "
                           "%s solid" % self.the(mob))
            else:
                self.say("You freeze the air. It's nice and cool now.",
                         "info")
        elif pw == "Bonk Drain":
            n = min(2, mob.bonk)
            p["bonk"] = min(self.max_bonk(), p["bonk"] + n)
            self.wound(mob, n, "You drain Bonk from %s (very rude)" %
                       self.the(mob))
        self.end_turn()

    def telemove(self, path):
        a = self.area
        for x, y in path:
            if (x, y) in a.items and a.items[(x, y)] not in ("trap", "goo"):
                thing = a.items.pop((x, y))
                a.items[tuple(self.pos)] = thing
                self.say("You frown. It floats over to you.", "good")
                self.step_on(*self.pos)
                return
            m = a.mob_at(x, y)
            if m and m.hostile and not m.boss:
                m.stuck = 2
                self.say("You hold %s in mid-air, kicking." % self.the(m),
                         "good")
                return
        self.say("You wave your fingers about. Nothing nearby moves.",
                 "info")

    def talk_to_alien(self, mob):
        """Talk to anything; some of them only wanted someone to
        listen."""
        if not mob.hostile:
            self.say("You talk to %s, and they talk back. In English. It "
                     "was always going to be English." % mob.title, "info")
            return
        m = MONSTERS[mob.kind]
        if mob.boss:
            self.say("%s says: 'You talk to monsters? Cool. I'm still going "
                     "to bonk you.'" % cap(self.the(mob)), "talk")
            return
        if self.ok("Cool", "trivia", diff=m.bod, label="talking it round"):
            mob.calm = 99
            mob.tamed = True
            mob.aware = False
            self.say(random.choice((
                "%s just wanted somebody to listen. It sniffles, and "
                "wanders off.",
                "You tell %s about the Formal. It's never been to a dance. "
                "It's going to think about its life.",
                "%s didn't know it was supposed to be scary. It apologises."
            )) % cap(self.the(mob)), "good")
        else:
            self.say("%s says something rude in monster." %
                     cap(self.the(mob)), "info")

    def read_mind(self, mob):
        """Three things at once; you catch one."""
        w = self.world
        thoughts = ["homework", "lunch", random.choice((
            "whether that zit is noticeable", "the Formal",
            "a song that won't go away", "their cat"))]
        if mob.leader:
            thoughts = ["SNORR SNORR SNORR", "grey, everything grey",
                        "the gym must not dance"]
        elif mob.role in DATE_ROLES:
            thoughts[2] = "who to go to the FORMAL with" + (
                " (maybe you!)" if random.random() < 0.5 else "")
        elif mob.talk:
            for k, v in mob.talk.items():
                if isinstance(v, dict) and v.get("learn"):
                    thoughts[2] = fill(v["say"], w) if "say" in v else \
                        thoughts[2]
                    break
        pick = random.choice(thoughts)
        self.say("You read %s's mind. Three things at once... you catch "
                 "one: '%s'" % (mob.title, pick), "mad")
        if mob.leader:
            self.learn("suspect")
        self.hear(pick)

    def teleport(self, sid):
        p = self.p
        p["driving"] = None
        p["flying"] = False
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        city = self.get_area(("city",))
        self.say("You squint, and BAMF: you're outside %s." % (
            "your house" if sid == "home" else fill(
                (SITES.get(sid) or BIG_SITES[sid])[0], self.world)), "good")
        self.enter(city, self.door_of(sid), "stairs")
        self.end_turn()

    def telephone(self):
        self.open_menu("Dial an imaginary phone. Who?", [
            ("Dr. Fizzwick (a hint)", self.call_fizzwick),
            ("Home (smooth things over)", self.call_home),
            ("A random number", self.call_random),
            ("Hang up", lambda: None)])

    def call_fizzwick(self):
        live = [lid for lid in self.world["leads"]
                if "known:" + lid not in self.flags and lid not in
                self.returned and lid not in self.shards]
        self.say("Dr. Fizzwick: " + (fill(RUMOURS[random.choice(live)],
                                          self.world) if live else
                                     "You know as much as I do! Go, go!"),
                 "talk")
        if live:
            self.hear(RUMOURS[live[0]])
        self.end_turn()

    def call_home(self):
        key = "phoned:%d" % self.day_no()
        if key in self.flags:
            self.say("Mom: 'You already called today, honey. Is everything "
                     "all right? Are you eating?'", "talk")
            return
        self.flags.add(key)
        if self.ok("RWP", "parents", diff=3, label="sweet-talking"):
            self.say("Mom: 'Oh, that's so thoughtful of you to call!'",
                     "talk")
            self.gain_rwp(1, "A nice phone call home.")
        else:
            self.say("Mom: 'Where ARE you? Do you know what time it is?'",
                     "talk")
        self.end_turn()

    def call_random(self):
        self.say(random.choice((
            "A deep voice: 'It's for you.' Click.",
            "'Galactic Pizza, can I take your order?'",
            "'Is your refrigerator running? Then you'd better... oh, it's "
            "you.'",
            "Heavy breathing. It's a Glorbian. They always breathe like "
            "that.",
            "'Sorry, wrong number. Wrong galaxy, actually.'")), "talk")
        self.end_turn()

    def magical_girl(self):
        if self.wishes_left() <= 0:
            self.say("You wrinkle your nose. Nothing. Out of wishes until "
                     "tomorrow.", "info")
            return
        self.open_menu("Wrinkle your nose and wish for...", [
            ("All better (full Bonk)", lambda: self.wish("heal")),
            ("Take me home", lambda: self.wish("home")),
            ("Some pocket money", lambda: self.wish("cash")),
            ("Make the monsters go away", lambda: self.wish("away")),
            ("Never mind", lambda: None)])

    def wish(self, what):
        p = self.p
        p["wishes"][1] -= 1
        self.sound.play("spell")
        self.say("You wrinkle your nose. Twinkle!", "mad")
        if what == "heal":
            p["bonk"] = self.max_bonk()
            self.say("You feel fantastic.", "good")
        elif what == "cash":
            p["cash"] += 20
            self.say("Twenty dollars appear in your pocket.", "gold")
        elif what == "away":
            gone = [m for m in self.area.mobs if m.hostile and not m.boss
                    and (m.x, m.y) in self.visible]
            for m in gone:
                self.area.mobs.remove(m)
            self.say("POOF! %s" % ("They're gone." if gone else
                                   "Nothing happens, because there was "
                                   "nothing to happen to."), "good")
        if random.random() < 0.5:
            self.repercussion()
        if what == "home":
            self.go_home()
            return
        self.end_turn()

    def repercussion(self):
        """Every wish has a catch."""
        p = self.p
        r = random.randrange(5)
        if r == 0:
            self.say("...and it starts raining frogs.", "mad")
            a = self.area
            x, y = self.pos
            for dx, dy in DIRS[:2]:
                if a.inside(x + dx, y + dy) and self.can_stand(x + dx,
                                                               y + dy):
                    f = make_monster("frog", x + dx, y + dy)
                    f.calm = 99
                    f.tamed = True
                    a.mobs.append(f)
        elif r == 1:
            self.say("...and your hair turns bright green. It'll grow out.",
                     "mad")
        elif r == 2:
            self.say("...and your mom finds out. Moms always find out.",
                     "mad")
            self.lose_rwp(1, "Wishing without asking.")
        elif r == 3 and p["cash"] >= 5:
            p["cash"] -= 5
            self.say("...and five dollars vanish from your pocket. Magic "
                     "isn't free.", "mad")
        else:
            self.say("...and nothing bad happens! Yet.", "mad")

    def boy_girl(self):
        p = self.p
        p["swapped"] = not p["swapped"]
        self.sound.play("spell")
        self.say("ZORP! You're %s now. Your clothes %s." % (
            "a guy" if (p["sex"] == "M") != p["swapped"] else "a girl",
            random.choice(("came along, luckily",
                           "didn't quite make the trip",
                           "fit, surprisingly"))), "mad")

    def aim_gun(self):
        self.aim = ("gun",)
        self.say("Zap who? (arrow keys, or tap)", "info")

    def gender_zap(self, dx, dy):
        """The Boy/Girl Gun, on somebody else."""
        mob, path = self.target_in_line(dx, dy, 6, people=True)
        self.sound.play("spell")
        self.fly(path, "bolt")
        if mob is None:
            self.say("ZORP! The beam hits nothing. Somewhere, a seagull is "
                     "very confused.", "info")
        elif mob.ally:
            self.say("ZORP! Your copy is the other you now. You both find "
                     "this very weird.", "mad")
            mob.tile = SWAP_TILES.get(mob.tile, mob.tile)
        elif mob.kind == "bully" and mob.hostile:
            self.reform_bully(mob)
        elif getattr(mob, "reformed", False):
            self.unreform_bully(mob)
        elif mob.hostile:
            mob.stuck = max(mob.stuck, 2)
            self.say("ZORP! %s is now a %s %s. It stops to think about "
                     "that." % (cap(self.the(mob)), random.choice((
                         "lady", "gentleman")), mob.name.replace(
                             "the ", "")), "mad")
        else:
            key = "swapped:" + (mob.role or mob.name)
            if key in self.flags:
                self.flags.discard(key)
            else:
                self.flags.add(key)
            self.flags.add("zapped:" + (mob.role or mob.name))
            if mob.role:
                swap_person(self.world["people"][mob.role], mob.role)
            self.swap_mob(mob)
            self.say(random.choice((
                "ZORP! %s is the other one now, pats their new hair, and "
                "screams.",
                "ZORP! %s looks down, then up, then at you. They're going "
                "to remember this. So is their mom.",
                "ZORP! %s's clothes didn't make the trip. Off they go, "
                "behind a potted plant.")) % mob.name, "mad")
            if mob.role and mob.role == self.p.get("date"):
                self.npc_say(mob, "Hey! We're still going to the Formal, "
                             "right? Like this?")
            elif mob.role in ("mom", "dad"):
                self.lose_rwp(1, "Zapping your folks!")
            elif not mob.alien and self.area.kind == "city" and \
                    self.phase() != "night" and not self.ok(
                        "Luck", diff=3, quiet=True):
                self.lose_rwp(1, "Somebody tells your folks what you did "
                              "with that gun.")
        self.end_turn()

    def swap_mob(self, mob):
        """A person's look, name and title after the gun (or after it
        again)."""
        mob.swapped = not getattr(mob, "swapped", False)
        if mob.swapped:
            mob.plain_tile, mob.plain_title = mob.tile, mob.title
            mob.tile = SWAP_TILES.get(mob.tile, mob.tile)
            mob.title = swap_words(mob.title)
        else:
            mob.tile = getattr(mob, "plain_tile", mob.tile)
            mob.title = getattr(mob, "plain_title", mob.title)
        if mob.role:
            who = self.world["people"][mob.role]
            mob.name, mob.title = who["name"], fill(who["title"], self.world)

    def swap_world(self):
        """After loading: the people the gun has already changed."""
        for f in self.flags:
            role = f[8:]
            if f.startswith("swapped:") and role in self.world["people"]:
                swap_person(self.world["people"][role], role)

    def reform_bully(self, mob):
        """A bully, zapped: she turns out to be the sweetest kid in town."""
        rng = random.Random()
        mob.hostile = False
        mob.reformed = True
        mob.swapped = True
        mob.aware = False
        mob.stuck = mob.flee = 0
        mob.tile = "sweetie"
        mob.name = "%s %s" % (rng.choice(FEMALE), rng.choice(SURNAMES))
        mob.title = "a former school bully"
        mob.roam = {"street", "grass", "lawn", "boardwalk", "lot", "path",
                    "floor", "tile", "carpet", "dfloor"}
        mob.home = (mob.x, mob.y)
        mob.greet = "Hiii! Oh my gosh. I'm SO sorry about the lunch money " \
            "thing. I don't know what I was thinking."
        mob.talk = {
            "job": "I used to take lunch money. Now I bake cookies and "
                   "volunteer at the animal shelter. It's a whole new me!",
            "news": random.choice(TIPS + SNORR_RUMOURS),
            "sorr": "I really am sorry. Being mean is SO much work. Being "
                    "nice is way easier. Who knew?",
            "lunc": "Your lunch money! I gave some back. The rest I spent "
                    "on candy. I'm sorry! I'll make it up to you.",
            "cook": "Chocolate chip. I'll bring you some on Saturday.",
        }
        self.flags.add("zapped:" + mob.name)
        self.sound.play("level")
        self.say("ZORP! The bully goes pink, and sparkly, and... cute? "
                 "%s blinks big eyes at you, then bursts into happy "
                 "tears." % mob.name, "mad")
        if "reformed_bully" not in self.flags:
            self.flags.add("reformed_bully")
            back = min(10, max(3, self.p.get("stolen", 0)))
            self.p["cash"] += back
            self.p["items"]["cosmo cake"] = self.p["items"].get(
                "cosmo cake", 0) + 1
            self.say("She presses $%d and a Cosmo Cake into your hands. "
                     "'For all the lunches. I'm so sorry!'" % back, "gold")
            self.gain_tp(1, "for turning a bully into a sweetheart")

    def unreform_bully(self, mob):
        """Zapped back: and he remembers."""
        mob.hostile = True
        mob.reformed = False
        mob.swapped = False
        mob.aware = True
        mob.tile = "bully"
        mob.name = MONSTERS["bully"].name
        mob.title = mob.name
        mob.bonk = mob.maxbonk = MONSTERS["bully"].bonk + 2
        self.sound.play("horror")
        self.say("ZORP! Oh no. The bully's back, and he remembers "
                 "EVERYTHING. Especially the pink.", "bad")

    def likes_change(self, mob):
        """Some people like what the gun did. Some really don't."""
        if getattr(mob, "reformed", False):
            return True
        return random.Random("%s:%s:likes" % (
            self.world["seed"], mob.role or mob.name)).random() < 0.5

    def about_change(self, mob):
        likes = self.likes_change(mob)
        if getattr(mob, "swapped", False):
            self.npc_say(mob, random.choice((
                "Honestly? I love it. I've never felt more me. Thanks!",
                "It's great! Everybody says the new look really works. "
                "Don't you dare change me back.",
                "I was mad at first. Now I'm thinking of keeping it.")
                if likes else (
                "Change me back! Right now!",
                "I'm not mad. I'm extremely, extremely mad. Fix it.",
                "My own mother didn't recognise me. Zap me back. Please.")))
            if not likes:
                self.say("(Zap them again to change them back.)", "info")
            elif "liked:" + (mob.role or mob.name) not in self.flags:
                self.flags.add("liked:" + (mob.role or mob.name))
                self.gain_tp(1, "for making somebody's week")
        else:
            self.npc_say(mob, random.choice((
                "You changed me back. Thanks... I guess. I kind of miss "
                "it.", "Back to boring old me. Aw.")
                if likes else (
                "Thank you for changing me back. Never, ever do that "
                "again.", "Phew. Me again. Keep that gun away from me.")))

    def apply_swaps(self, area):
        """People zapped with the Boy/Girl Gun stay zapped all week."""
        for m in area.mobs:
            if "swapped:" + (m.role or m.name) in self.flags and \
                    not getattr(m, "swapped", False):
                self.swap_mob(m)

    def copies(self):
        p = self.p
        a = self.area
        x, y = self.pos
        made = 0
        for dx, dy in DIRS:
            if made == 2:
                break
            nx, ny = x + dx, y + dy
            if a.inside(nx, ny) and self.can_stand(nx, ny) and \
                    not a.mob_at(nx, ny) and a.grid[ny][nx] not in (
                        "exit", "stairs_up", "stairs_down"):
                m = Mob(self.teen_tile(), p["name"], nx, ny)
                m.ally = 15
                m.title = "a copy of you"
                a.mobs.append(m)
                made += 1
        if not made:
            self.say("There's no room for more of you here.", "info")
            return
        p["rest"]["Three's a Crowd"] = self.turn + POWER_REST[
            "Three's a Crowd"]
        self.say("POP POP! There are %d of you now. You all say 'cool' at "
                 "the same time." % (made + 1), "good")
        self.end_turn()

    def ally_act(self, mob):
        a = self.area
        mob.ally -= 1
        if mob.ally <= 0:
            a.mobs.remove(mob)
            self.say("One of your copies goes pop.", "info")
            return
        for dx, dy in DIRS:
            t = a.mob_at(mob.x + dx, mob.y + dy)
            if t and t.hostile and not t.calm and not t.ally:
                if random.random() < 0.5:
                    self.wound(t, self.harm(t, 1, "clobber"),
                               "Your copy bops %s" % self.the(t))
                return
        px, py = self.pos
        for sx, sy in sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                             abs(py - mob.y - d[1])):
            if abs(px - mob.x) + abs(py - mob.y) <= 2:
                break
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break

    def cute(self):
        p = self.p
        p["rest"]["Incredible Cute"] = self.turn + POWER_REST[
            "Incredible Cute"]
        n = 0
        for m in self.area.mobs:
            if m.hostile and not m.boss and (m.x, m.y) in self.visible:
                m.calm = 3
                n += 1
        self.say("You turn on the cute. %s" % ("Awwww, goes everything. "
                                               "Nobody wants to hit you."
                                               if n else "Nobody's there "
                                               "to see it. Shame."),
                 "good")
        if random.random() < 1 / 6:
            self.admirer()
        self.end_turn()

    def admirer(self):
        """Too much of a good thing."""
        if "admirer" in self.flags:
            return
        self.flags.add("admirer")
        rng = random.Random()
        sex = rng.choice("MF")
        m = Mob(rng.choice(("kid3", "girl3", "nerd")), rng.choice(
            MALE if sex == "M" else FEMALE) + " " + rng.choice(SURNAMES),
            0, 0)
        m.title = "your number one fan"
        m.follower = True
        m.greet = "Hi! Hi! It's me! Hi!"
        m.talk = {"job": "Following you around! Isn't it great?",
                  "news": "You're the news! You're ALWAYS the news!"}
        self.p["admirer"] = m.name
        self.say("Uh oh. %s has fallen madly in love with you. They're "
                 "going to follow you everywhere now. EVERYWHERE." % m.name,
                 "mad")
        self.place_follower()

    def place_follower(self):
        name = self.p.get("admirer")
        a = self.area
        if not name or a.kind == "dungeon" or any(
                m.follower or m.name == name for m in a.mobs):
            return
        x, y = self.pos
        for dx, dy in DIRS:
            if a.inside(x + dx, y + dy) and not a.mob_at(x + dx, y + dy) \
                    and a.grid[y + dy][x + dx] in (CITY_GROUND |
                                                   INSIDE_FLOOR):
                m = Mob("kid3", name, x + dx, y + dy)
                m.title = "your number one fan"
                m.follower = True
                m.greet = random.choice(("Hi! Hi! It's me!",
                                         "I saved you a seat!",
                                         "I wrote you a poem. It's forty "
                                         "pages."))
                m.talk = {"job": "Following you around! Isn't it great?",
                          "news": "You're the news! You're ALWAYS the "
                                  "news!",
                          "go": "Go away? Ha ha! You're so funny!"}
                a.mobs.append(m)
                return

    # ── Gadgets and snacks ──

    def use_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        for n in ("soda", "burger", "cosmo cake", "ice cream",
                  "bonk regenerator", "popcorn grenade", "soopergloo",
                  "teleport doormat", "instant hole", "pocket phone",
                  "boy/girl gun", "rocket sneakers", "battle bikini"):
            if p["items"].get(n):
                label = ITEMS[n][0].split(":")[0]
                if n == "rocket sneakers":
                    label = ("Take off" if p["rocket"] else "Lace up") + \
                        " the rocket sneakers"
                elif n == "battle bikini":
                    label = ("Take off" if p.get("bikini") else "Put on") + \
                        " the Cosmic Battle Bikini"
                elif p["items"][n] > 1:
                    label += " (%d)" % p["items"][n]
                items.append((cap(label), lambda n=n: self.use(n)))
        for w in p["gadgets"]:
            if w != p["weapon"]:
                g = GADGETS[w]
                items.append(("Hold your %s (%s)" % (w if w != "Fists" else
                                                     "fists", g.note),
                              lambda w=w: self.hold(w)))
        if not items:
            self.say("You've got nothing to use. The mall sells gadgets.",
                     "info")
            return
        self.open_menu("Use what?", items)

    def hold(self, w):
        self.p["weapon"] = w
        self.say("You put up your fists." if w == "Fists" else
                 "You hold your %s." % w, "info")
        self.render_chrome()

    def use(self, n):
        p = self.p
        if n in FOOD:
            if p["bonk"] >= self.max_bonk():
                self.say("You're not hungry. (Your Bonk's full.)", "info")
                return
            gain = FOOD[n]
            p["bonk"] = min(self.max_bonk(), p["bonk"] + gain)
            self.say({"soda": "Glug glug. BURP.",
                      "burger": "Om nom nom.",
                      "cosmo cake": "Cream-filled goodness, from space.",
                      "ice cream": "Brain freeze! Worth it."}[n] +
                     " (+%d Bonk)" % gain, "good")
            self.sound.play("potion")
        elif n == "bonk regenerator":
            if p["bonk"] >= self.max_bonk():
                self.say("Your Bonk is as full as it gets.", "info")
                return
            p["bonk"] = min(self.max_bonk(), p["bonk"] + 2)
            self.say("You zap yourself with the Bonk Regenerator Ray. "
                     "Tingly! (+2 Bonk)", "good")
            self.sound.play("potion")
        elif n == "popcorn grenade":
            hit = [m for m in self.area.mobs if m.hostile and
                   (m.x, m.y) in self.visible]
            for m in hit:
                m.stuck = 4
                self.flash(m.x, m.y, "popcorn")
            self.say("FWOOMPH! A paisley explosion, and everything's "
                     "buried in hot buttered popcorn.%s" % (
                         " Nothing can move for a while." if hit else ""),
                     "good")
            self.sound.play("fire")
        elif n == "soopergloo":
            hit = [self.area.mob_at(self.pos[0] + dx, self.pos[1] + dy)
                   for dx, dy in DIRS]
            hit = [m for m in hit if m and m.hostile]
            if not hit:
                self.say("Nothing next to you to glue.", "info")
                return
            for m in hit:
                m.stuck = 5
            self.say("Pssst. Glued to the floor!", "good")
        elif n == "teleport doormat":
            p["items"][n] -= 1
            if not p["items"][n]:
                del p["items"][n]
            self.say("You unfold the doormat and step on it. FOOMP.", "good")
            self.go_home()
            return
        elif n == "instant hole":
            a = self.area
            if a.kind != "dungeon" or not a.down:
                self.say("Better save it for somewhere with a down.",
                         "info")
                return
            p["items"][n] -= 1
            if not p["items"][n]:
                del p["items"][n]
            self.say("You spray a black circle on the floor, step on it, "
                     "and fall through. Whee!", "good")
            self.change_level(1)
            return
        elif n == "pocket phone":
            self.telephone()
            return
        elif n == "boy/girl gun":
            self.open_menu("Point the Boy/Girl Gun at...", [
                ("Yourself", lambda: (self.boy_girl(), self.end_turn())),
                ("Someone else (pick a direction)", self.aim_gun),
                ("Never mind", lambda: None)])
            return
        elif n == "rocket sneakers":
            p["rocket"] = not p["rocket"]
            if p["rocket"]:
                self.say("You lace up the rocket sneakers and say 'Go!'. "
                         "VWOOSH.", "good")
            elif self.ok("Driving", "drive", diff=2,
                         label="stopping on a dime"):
                self.say("'Stop!' You stop on a dime.", "good")
            else:
                self.say("'Stop!' Your sneakers stop. You don't.", "bad")
                self.hurt(1, "Faceplant")
        elif n == "battle bikini":
            p["bikini"] = not p.get("bikini")
            if p["bikini"]:
                if "Battle Bikini Blaster" not in p["gadgets"]:
                    p["gadgets"].append("Battle Bikini Blaster")
                p["weapon"] = "Battle Bikini Blaster"
                self.say("You suit up in the Cosmic Battle Bikini: armour, "
                         "rocket boots, and a HUGE gun.", "good")
            else:
                if "Battle Bikini Blaster" in p["gadgets"]:
                    p["gadgets"].remove("Battle Bikini Blaster")
                if p["weapon"] == "Battle Bikini Blaster":
                    p["weapon"] = p["gadgets"][-1]
                self.say("You take off the Battle Bikini. Breezy.", "info")
        if n not in WORN and n not in ("pocket phone", "boy/girl gun") and \
                n in p["items"]:
            p["items"][n] -= 1
            if p["items"][n] <= 0:
                del p["items"][n]
        self.end_turn()

    def go_home(self):
        p = self.p
        p["driving"] = None
        p["flying"] = False
        self.cache = {k: v for k, v in self.cache.items()
                      if k[0] not in ("dun",) and k != ("bld", "home")}
        area = self.get_area(("bld", "home"))
        self.city_pos = list(self.door_of("home"))
        self.enter(area, self.bed_spot(area), "stairs")
        self.say("You're home.", "info")

    # ── Wheels ──

    def teen_tile(self):
        p = self.p
        sex = p["sex"] if not p["swapped"] else ("F" if p["sex"] == "M"
                                                 else "M")
        return TEEN_TILES[(p["kind"], sex)]

    def wheels(self):
        if not self.ready():
            return
        p, a = self.p, self.area
        if p["driving"]:
            what = p["driving"]
            here = a.grid[self.pos[1]][self.pos[0]]
            if here in WATER:
                self.say("Not here! You'd sink.", "info")
                return
            if not self.can_stand_on_foot(*self.pos):
                self.say("You can't get out here.", "info")
                return
            p["driving"] = None
            if what in ("saucer", "superdrive") and not self.ok(
                    "Driving", "drive", diff=1, label="landing"):
                self.hurt(1, "You land with a bump")
            else:
                self.say("You park your %s and hop out." % what, "info")
            self.end_turn()
            return
        if a.kind != "city":
            self.say("Your wheels are parked outside. (Cartoon parking: "
                     "they're always right outside.)", "info")
            return
        if not p["wheels"]:
            self.say("You don't have any wheels. Zeb's saucer lot, "
                     "downtown, has a deal for you.", "info")
            return
        if len(p["wheels"]) > 1:
            self.open_menu("Take which?", [
                (w.title(), lambda w=w: self.drive(w)) for w in p["wheels"]]
                + [("Walk", lambda: None)])
            return
        self.drive(p["wheels"][0])

    def can_stand_on_foot(self, x, y):
        t = self.area.grid[y][x]
        return t in WALKABLE or t in ("crater", "saucer_lot")

    def drive(self, w):
        p = self.p
        p["driving"] = w
        if not self.can_stand(*self.pos):
            p["driving"] = None
            self.say("You can't get your %s going here. %s" % (
                w, "Cars go on roads." if w == "car" else ""), "info")
            return
        p["flying"] = False
        diff = {"car": 1, "saucer": 3, "jetbike": 3, "superdrive": 4,
                "board": 3}.get(w, 2)
        margin = self.stat_roll("Driving", "drive", diff=diff,
                                label="taking off" if w != "car" else
                                "starting the car")
        if margin <= -3:
            p["driving"] = None
            self.hurt(min(3, -margin - 2), "You stall, and bang your head "
                      "on the steering thing")
        elif margin <= 0:
            self.say("You bounce off the curb, but you're off.", "info")
        else:
            self.say({"car": "You start up the family car. It smells like "
                             "french fries.",
                      "saucer": "Your saucer hums up off the ground.",
                      "jetbike": "VROOOM! The jetbike leaps forward.",
                      "superdrive": "Your souped-up saucer screams into "
                                    "the air.",
                      "board": "You hop on the antigravity boogie board. "
                               "Cowabunga!"}.get(w, "You're off!"),
                     "good")
        self.sound.play("fire")
        self.end_turn()

    # ── Searching and touching ──

    def search(self):
        if not self.ready():
            return
        a = self.area
        px, py = self.pos
        near = [(x, y) for (x, y) in a.hidden
                if abs(x - px) + abs(y - py) <= 3]
        traps = [(x, y) for (x, y) in a.traps
                 if abs(x - px) + abs(y - py) <= 3]
        saucer = (a.kind == "city" and abs(SAUCER[0] - px) +
                  abs(SAUCER[1] - py) <= 5 and
                  a.grid[SAUCER[1]][SAUCER[0]] != "hatchway" and
                  "saucer" in self.world["leads"])
        self.say("You look around carefully.", "info")
        if not self.ok("Smarts", "figure", diff=3, label="searching"):
            self.say("You find nothing. Not even lint.", "info")
        else:
            found = False
            for pos in near:
                a.items[pos] = a.hidden.pop(pos)
                found = True
            for pos in traps:
                a.traps.discard(pos)
                a.items[pos] = "trap"
                found = True
            if saucer:
                self.flags.add("found:saucer")
                self.learn("saucer_known")
                self.reveal_saucer()
                self.say("Behind a clump of bushes: a crater, and a dented "
                         "flying saucer, humming softly to itself.", "gold")
                found = True
            if near or traps:
                self.say("You find something!" if near else
                         "You find a banana peel. Somebody's idea of a "
                         "joke.", "gold")
            elif not found:
                self.say("There's nothing here to find.", "info")
        if not any(m.hostile for m in a.mobs if (m.x, m.y) in self.visible):
            self.turn += 4
        self.end_turn()

    def reveal_saucer(self):
        city = self.get_area(("city",))
        sx, sy = SAUCER
        for y in range(sy - 1, sy + 2):
            for x in range(sx - 1, sx + 2):
                city.grid[y][x] = "crater"
        city.grid[sy][sx - 1] = city.grid[sy][sx + 1] = "wreck"
        city.grid[sy][sx] = "hatchway"

    def step_on(self, x, y):
        """Things on the floor are picked up (or read); True if that took
        the turn."""
        a, p = self.area, self.p
        thing = a.items.get((x, y))
        if not thing or thing in ("trap", "goo"):
            return False
        del a.items[(x, y)]
        if thing == "shard":
            lid = a.lead
            self.shards.append(lid)
            self.flags.add("shard:" + lid)
            self.say("You pick up %s. It's warm, and it hums disco. Bring "
                     "it to Dr. Fizzwick!" % self.world["shards"][lid],
                     "quest")
            self.sound.play("quest")
        elif thing == "note" and getattr(a, "dossier", None) == (x, y):
            self.flags.add("dossier")
            p["items"]["dossier"] = 1
            self.learn("dossier")
            self.say("A grey folder stamped SNORR. Inside: 'AGENT IN PLACE: "
                     "%s. Objective: no dancing.'" % self.world["people"][
                         self.world["agent"]]["name"].upper(), "quest")
            self.sound.play("gold")
        elif thing == "note":
            self.say(getattr(a, "note", "A scrap of paper. Illegible."),
                     "talk")
            self.flags.add("note:%s" % (a.key,))
        elif thing == "cash":
            n = roll("1d6+2")
            p["cash"] += n
            self.say("You find $%d. Finders keepers!" % n, "gold")
            self.sound.play("gold")
        elif thing == "snack":
            what = random.choice(("cosmo cake", "soda", "burger"))
            p["items"][what] = p["items"].get(what, 0) + 1
            self.say("You find %s, still in the wrapper." %
                     ITEMS[what][0].split(":")[0], "gold")
            self.sound.play("gold")
        elif thing == "gadget":
            what = random.choice(("soopergloo", "popcorn grenade",
                                  "bonk regenerator", "instant hole",
                                  "spring shoes"))
            p["items"][what] = p["items"].get(what, 0) + 1
            self.say("You find %s!" % ITEMS[what][0].split(":")[0], "gold")
            self.sound.play("gold")
        elif thing == "tokens":
            p["items"]["tokens"] = p["items"].get("tokens", 0) + 5
            self.say("You find five arcade tokens.", "gold")
        return False

    def touch(self, t, x, y):
        """Walking into the furniture of the world."""
        a = self.area
        kind = a.site or ""
        if t == "shelf" and kind in RESEARCH_SITES:
            self.research_menu()
        elif t == "shelf":
            self.say("Shelves of %s." % {
                "home": "your mom's romance novels",
                "school": "beakers, and a jar with something in it",
                "zeb": "saucer parts",
                "cityhall": "binders",
                "florist": "flowers",
                "mall": "gadgets in blister packs"}.get(kind,
                                                        "this and that"),
                "info")
        elif t == "desk" and kind == "school":
            self.class_menu()
        elif t == "desk":
            self.say("A desk. Somebody carved 'SNORR RULEZ' in it. Huh.",
                     "info")
        elif t == "locker":
            self.say(random.choice((
                "Your locker. It smells like gym socks. It always will.",
                "Somebody's locker. There's a photo of a Glorbian pop star "
                "taped inside.",
                "A locker. Something inside it is ticking.")), "info")
        elif t == "case":
            self.say(random.choice((
                "The trophy case: Marigold Bay High, 1974 Dodgeball "
                "Champions.",
                "A glass case. Inside: a moon rock, a real one.",
                "A display of Glorbian art. It's all grey. Hmm.")), "info")
        elif t == "bed":
            self.bed_menu()
        elif t == "window" and kind == "home":
            self.window_menu()
        elif t == "cabinet":
            self.play_arcade()
        elif t == "brokencab":
            self.at_lead("arcade", x, y)
        elif t in ("disco", "disco_dark"):
            self.hyperdisco()
        elif t == "crate":
            self.open_loot(x, y)
        elif t == "gate":
            self.gate(x, y)
        elif t == "rack":
            self.say("A rack of clothes. Neon, mostly.", "info")
        elif t == "fountain":
            self.say("You toss a penny in the fountain and wish for a date "
                     "to the Formal.", "info")
        elif t == "statue":
            self.say("%s." % cap(a.labels.get((x, y), "a statue")), "info")
        elif t == "screen":
            self.say("The drive-in screen. Something's been scratched on "
                     "the back: 'ROW Z'.", "info")
        elif t in ("wreck",):
            self.say("A dented flying saucer. A sticker on it says MY OTHER "
                     "SAUCER IS A SAUCER.", "info")
        elif t == "saucer_lot":
            self.say("A used saucer for sale. $150, or best offer. Ask Zeb "
                     "inside.", "info")
        elif t.startswith("house"):
            self.say("Somebody's house. A dog barks inside.", "info")
        elif t == "rock" and abs(x - LOOKOUT[0]) + abs(y - LOOKOUT[1]) <= 2:
            self.say("Lover's Point: the whole Pacific, and the whole town, "
                     "and a lot of initials carved in the rock.", "info")
        else:
            self.bump()

    def play_arcade(self):
        p = self.p
        if not p["items"].get("tokens"):
            self.say("A game called ZORB ATTACK. It wants tokens. The "
                     "manager sells them.", "info")
            return
        p["items"]["tokens"] -= 1
        if not p["items"]["tokens"]:
            del p["items"]["tokens"]
        self.pass_time(10, quiet=True)
        if self.ok(("Driving", "Bod"), "drive", diff=4, label="playing"):
            self.say("NEW HIGH SCORE! You put in your initials. Everybody "
                     "goes 'whoa'.", "good")
            if "highscore" not in self.flags:
                self.flags.add("highscore")
                self.gain_tp(1, "for the high score")
        else:
            self.say("GAME OVER. You were robbed. That jump was totally "
                     "there.", "info")
        self.render()

    def open_loot(self, x, y):
        a = self.area
        if (x, y) not in a.loot:
            self.bump()
            return
        a.loot.discard((x, y))
        a.grid[y][x] = "crate_open"
        self.flags.add("loot:%s:%d:%d:%d" % (a.key[1], a.key[2], x, y))
        self.say("You rip open the box.", "info")
        r = random.random()
        if r < 0.15:
            self.say("A jack-in-the-box! BOING!", "bad")
            self.hurt(1, "It boffs you on the nose")
        elif r < 0.3:
            kind = random.choice(LEADS[a.lead].monsters)
            self.say("Something was in there, and it's annoyed.", "bad")
            spots = [(x + dx, y + dy) for dx, dy in DIRS
                     if a.inside(x + dx, y + dy) and
                     a.grid[y + dy][x + dx] in DUNGEON_FLOOR and
                     not a.mob_at(x + dx, y + dy) and
                     [x + dx, y + dy] != self.pos]
            if spots:
                m = make_monster(kind, *spots[0])
                m.aware = True
                a.mobs.append(m)
        elif r < 0.8:
            a.items[tuple(self.pos)] = random.choice(("cash", "snack",
                                                      "gadget", "tokens"))
            self.step_on(*self.pos)
        else:
            self.say("Styrofoam peanuts. Just styrofoam peanuts.", "info")
        self.end_turn()

    def gate(self, x, y):
        p = self.p
        opts = [("Fix the lock (Smarts, Fixit, vs 4)",
                 lambda: self.try_gate(x, y, "fix")),
                ("Kick it in (Bod, vs %d)" % (1 if self.on(
                    "Super Strength") else 5),
                 lambda: self.try_gate(x, y, "kick"))]
        if "Get Small" in p["powers"] or "Get Small" in p["on"]:
            opts.append(("Get Small and squeeze under",
                         lambda: self.try_gate(x, y, "small")))
        if "Telemove" in p["powers"]:
            opts.append(("Telemove the bolt (Smarts, vs 3)",
                         lambda: self.try_gate(x, y, "telemove")))
        if "Talk to Aliens" in p["powers"]:
            opts.append(("Ask the door nicely",
                         lambda: self.try_gate(x, y, "talk")))
        opts.append(("Leave it", lambda: None))
        self.open_menu("A big red door: KEEP OUT. THIS MEANS YOU. Beyond "
                       "it, the end of this place.", opts)

    def try_gate(self, x, y, how):
        a = self.area
        if how == "fix":
            ok = self.ok("Smarts", "fix", diff=4, label="fixing")
        elif how == "kick":
            ok = self.ok("Bod", "clobber", diff=1 if self.on(
                "Super Strength") else 5, label="kicking")
            if not ok:
                for m in a.mobs:
                    if m.hostile and abs(m.x - x) + abs(m.y - y) <= 12:
                        m.aware = True
                self.say("BONG. That echoed.", "bad")
        elif how == "telemove":
            ok = self.ok("Smarts", "fix", diff=3, label="telemoving")
        elif how == "talk":
            self.say("The door says: 'Oh. Well, since you asked.'", "talk")
            ok = True
        else:
            self.say("You shrink, and squeeze under the door, and pop back "
                     "to size on the other side... and open it.", "good")
            ok = True
        if ok:
            a.grid[y][x] = "dfloor"
            self.say("The door swings open.", "good")
            self.sound.play("door")
        else:
            self.say("It holds.", "info")
        self.end_turn()

    # ── The ways down ──

    def at_lead(self, lid, x, y):
        p = self.p
        if lid not in self.world["leads"]:
            self.say({
                "boiler": "The janitor's hatch. Below, only a boiler and a "
                          "lot of mops.",
                "mall": "EMPLOYEES ONLY. Through the crack: boxes of shoes. "
                        "Nothing weird. This week.",
                "sewer": "A storm drain. It smells like a storm drain. "
                         "Nothing glows.",
                "saucer": "Just a crater. The saucer's gone.",
                "arcade": "The broken machine says OUT OF ORDER. Today it "
                          "means it.",
                "drivein": "Stairs to the reel store. Just reels, and "
                           "dust."}[lid], "info")
            return
        if lid in self.returned or lid in self.shards:
            self.say("You've got the shard from down there already.",
                     "info")
            self.open_menu("Go down anyway?", [
                ("Yes", lambda: self.descend(lid)), ("No", lambda: None)])
            return
        if "open:" + lid in self.flags:
            self.descend(lid)
            return
        self.learn(lid + "_known")
        if lid == "boiler" and p["items"].get("janitor keys"):
            self.say("The janitor's keys fit. Of course they do.", "good")
            self.flags.add("open:boiler")
            self.descend(lid)
            return
        if lid == "drivein" and "booth_ok" in self.flags:
            self.flags.add("open:drivein")
            self.descend(lid)
            return
        what = {"boiler": "The hatch in the janitor's closet. Locked. A "
                          "smell of floor polish comes up through it.",
                "mall": "EMPLOYEES ONLY. The mall cop is standing right "
                        "there, arms folded.",
                "sewer": "A storm drain, glowing faintly green. The grate's "
                         "bolted down.",
                "saucer": "The saucer's hatch. A little screen says, in "
                          "Zorbian and then in English: PASSWORD?",
                "arcade": "The cabinet with no name. OUT OF ORDER. INSERT "
                          "10 TOKENS. The screen flickers: it's hungry.",
                "drivein": "Stairs down, behind a door marked REELS. "
                           "Something down there is going 'blorp'."}[lid]
        opts = []
        guarded = lid == "mall"
        if lid == "arcade":
            have = p["items"].get("tokens", 0)
            if have < 10:
                self.say(what + " (You have %d tokens.)" % have, "info")
                return
            opts += [("Feed it 10 tokens and fix it (Smarts, Fixit, vs 4)",
                      lambda: self.try_lead(lid, "fix")),
                     ("Feed it 10 tokens and play like a maniac (Driving, "
                      "vs 5)", lambda: self.try_lead(lid, "play"))]
        elif guarded:
            opts += [("Talk your way past (Smarts or Cool, vs 5)",
                      lambda: self.try_lead(lid, "talk")),
                     ("Flirt your way past (Looks, vs 5)",
                      lambda: self.try_lead(lid, "flirt")),
                     (fill("Wait till {mallcop_he} looks away, and sneak "
                            "(Bod, vs 4)", self.world),
                      lambda: self.try_lead(lid, "sneak"))]
        else:
            opts.append(("Fix the lock (Smarts, Fixit, vs %d)" % (
                5 if lid == "saucer" else 4),
                lambda: self.try_lead(lid, "fix")))
            opts.append(("Force it (Bod, vs %d)" % self.force_diff(lid),
                         lambda: self.try_lead(lid, "force")))
            if lid == "drivein":
                opts.append(("Sneak past the projectionist (Bod, vs 4)",
                             lambda: self.try_lead(lid, "sneak")))
        if lid == "saucer":
            opts.append(("Tell it you're the captain (Smarts%s, vs %d)" % (
                ", Fake Out" if "Fake Out" in p["powers"] else "",
                1 if "Fake Out" in p["powers"] else 5),
                lambda: self.try_lead(lid, "fakeout")))
            opts.append(("Remember the Zorbian for 'please' (Smarts, "
                         "trivia, vs 4)",
                         lambda: self.try_lead(lid, "trivia")))
        for pw, label in (("Get Small", "Get Small and slip through"),
                          ("Shapechange", "Shapechange into something "
                                          "that belongs there"),
                          ("Nobody Home", "Switch off and walk past"),
                          ("Swap Shop", "Swap bodies with the mall cop"),
                          ("Talk to Aliens", "Talk to it"),
                          ("Connections", "Drop a name: you know a guy")):
            if pw in p["powers"] and not (pw == "Swap Shop" and
                                          not guarded) and not (
                    pw in ("Shapechange", "Nobody Home", "Connections") and
                    lid in ("sewer", "saucer", "arcade")):
                opts.append((label, lambda pw=pw: self.try_lead(lid, pw)))
        opts.append(("Leave it", lambda: None))
        self.open_menu(what, opts)

    def force_diff(self, lid):
        d = {"boiler": 6, "sewer": 4, "saucer": 6, "drivein": 4}.get(lid, 5)
        if "bonus:" + lid in self.flags:
            d -= 2
        if self.on("Super Strength"):
            d -= 4
        return max(1, d)

    def try_lead(self, lid, how):
        p = self.p
        if lid == "arcade" and how in ("fix", "play"):
            p["items"]["tokens"] -= 10
            if not p["items"]["tokens"]:
                del p["items"]["tokens"]
        if how == "fix":
            ok = self.ok("Smarts", "fix", diff=5 if lid == "saucer" and
                         "bonus:saucer" not in self.flags else 4,
                         label="fixing")
        elif how == "play":
            ok = self.ok("Driving", "drive", diff=5, label="playing")
        elif how == "force":
            ok = self.ok("Bod", "clobber", diff=self.force_diff(lid),
                         label="forcing")
        elif how == "talk":
            ok = self.ok(("Smarts", "Cool"), "convince", diff=5,
                         label="talking")
        elif how == "flirt":
            ok = self.ok("Looks", "date", diff=5, label="flirting")
        elif how == "sneak":
            ok = self.ok("Bod", "sneak", diff=4, label="sneaking")
        elif how == "fakeout":
            ok = self.ok("Smarts", "convince", diff=1 if "Fake Out" in
                         p["powers"] else 5, label="faking out")
        elif how == "trivia":
            ok = self.ok("Smarts", "trivia", diff=4, label="remembering")
        else:
            ok = True
            self.say({"Get Small": "You shrink to mouse size and scamper "
                                   "through a gap.",
                      "Shapechange": "You turn into a stack of boxes. "
                                     "Nobody looks twice at a stack of "
                                     "boxes.",
                      "Nobody Home": "You switch off and stroll past. "
                                     "Nobody notices. Story of your life.",
                      "Swap Shop": "You swap bodies with the mall cop, "
                                   "let yourself through, and swap back. " +
                                   fill("{mallcop_He}'s very confused.",
                                        self.world),
                      "Talk to Aliens": "You have a heart-to-heart with "
                                        "it. It lets you in.",
                      "Connections": "'I know your boss's cousin.' "
                                     "'...Fine. Go on.'"}[how], "good")
        self.turn += 10
        if ok:
            self.flags.add("open:" + lid)
            self.say("You're in!", "good")
            self.descend(lid)
            return
        self.say("No luck. Ten minutes wasted.", "info")
        if lid == "arcade":
            self.say("The machine burps. Your tokens are gone.", "bad")
        if how in ("force", "sneak", "talk", "flirt") and lid in (
                "boiler", "mall", "drivein") and not self.ok(
                    "Luck", diff=3, quiet=True):
            self.say({"boiler": "The janitor catches you. 'DETENTION!'",
                      "mall": "The mall cop walks you to the exit. 'And "
                              "stay out!'",
                      "drivein": "The projectionist shoos you out."}[lid],
                     "bad")
            if lid == "boiler":
                self.lose_rwp(1, "Detention!")
            if self.area.kind == "inside":
                self.go_outside()
                return
        self.end_turn()

    # ── Research ──

    def research_menu(self):
        a = self.area
        topics = sorted(t for t in self.topics if t in RESEARCH and
                        "research:" + t not in self.flags)
        if not topics:
            self.say("You browse, but you don't know what you're looking "
                     "for. Words in CAPITALS that people mention can be "
                     "looked up.", "info")
            return
        bonus = RESEARCH_SITES[a.site]
        self.open_menu("Look up what? (Smarts, about an hour)",
                       [(t.title(), lambda t=t: self.research(t, bonus))
                        for t in topics] + [("Nothing", lambda: None)])

    def research(self, topic, bonus):
        lid, text, effect = RESEARCH[topic]
        if not self.ok("Smarts", "figure", diff=3, bonus=bonus,
                       label="looking it up"):
            self.pass_time(30)
            self.say("Half an hour of microfiche and a headache.", "info")
            self.render()
            return
        self.pass_time(60)
        self.flags.add("research:" + topic)
        self.say("An hour later, you find it:", "info")
        self.say(fill(text, self.world), "talk")
        self.hear(fill(text, self.world))
        if lid and lid not in self.world["leads"]:
            self.say("(Old news. Nothing's happening there this week.)",
                     "info")
        elif effect and effect.endswith("_known"):
            self.learn(effect)
        elif effect:
            self.flags.add(effect)
            self.say("(That'll make getting in easier.)", "info")
        self.render()

    # ── Home and school ──

    def bed_menu(self):
        a = self.area
        if a.site == "home":
            self.open_menu("Your bed. It's unmade. It's always unmade.", [
                ("Sleep until morning", lambda: self.sleep(True)),
                ("Take a nap (2 hours)", lambda: self.sleep(False)),
                ("Not now", lambda: None)])
        elif a.site == "school":
            self.say("The nurse's cot. 'Only if you're sick, dear.'",
                     "info")
        else:
            self.say("Somebody else's bed.", "info")

    def sleep(self, night):
        p = self.p
        h = self.now().hour
        if night:
            hours = (24 + 7 - h) % 24 or 24
            if hours > 14:
                hours = 2
        else:
            hours = 2
        self.say("You sleep %d hours. Zzz." % hours, "info")
        self.pass_time(hours * 60, quiet=True)
        if self.overlay:
            return
        if hours >= 5:
            p["slept"] = self.turn
            p["bonk"] = self.max_bonk()
        self.say("You wake up, %s.%s" % (self.date_text(), (
            " " + random.choice(("Mom's making pancakes.",
                                 "Your little %s is banging on the door." %
                                 fill("{sib}", self.world),
                                 "The radio's playing the Formal song "
                                 "again."))) if hours >= 5 else ""),
            "good")
        self.render()

    def bed_spot(self, area):
        for y in range(area.h):
            for x in range(area.w):
                if area.grid[y][x] == "bed" and y + 1 < area.h and \
                        area.grid[y + 1][x] in INSIDE_FLOOR:
                    return x, y + 1
        return area.start

    def class_menu(self):
        if not self.school_time():
            self.say("A desk. Class is over for the day.", "info")
            return
        self.open_menu("It's a school day. Sit through class until 3?", [
            ("Sit through class", self.go_to_class),
            ("Not now (keep cutting it close)", lambda: None)])

    def go_to_class(self):
        t = self.now()
        mins = (SCHOOL_HOURS[1] - t.hour) * 60 - t.minute
        self.say("You sit through %s. %s" % (
            random.choice(("algebra", "history", "chemistry", "English",
                           "Galactic Studies")),
            random.choice(("The teacher drones. You doodle.",
                           "A note gets passed to you. It just says 'HI'.",
                           "Somebody's antennae block the blackboard.",
                           "There's a pop quiz. You pass. Probably."))),
            "info")
        self.pass_time(mins, quiet=True)
        if self.overlay:
            return
        day = self.day_no()
        if "class:%d" % day not in self.flags:
            self.flags.add("class:%d" % day)
            self.gain_rwp(1, "A good report from school!")
            if self.ok("Smarts", "figure", diff=3, quiet=True):
                live = [lid for lid in self.world["leads"]
                        if "known:" + lid not in self.flags]
                if live:
                    text = fill(RUMOURS[random.choice(live)], self.world)
                    self.say("In the hall after the bell, you overhear: "
                             "'%s'" % text, "talk")
                    self.hear(text)
        self.say("RRRRING! It's %s. School's out." % self.date_text(),
                 "quest")
        self.render()

    def window_menu(self):
        p = self.p
        if not p["grounded"]:
            self.say("Your bedroom window. You could climb out of it, but "
                     "the door's right there.", "info")
            return
        self.open_menu("Your bedroom window. You're grounded. Climb out?", [
            ("Sneak out (Bod, vs 3)", self.sneak_out),
            ("No, be good", lambda: None)])

    def sneak_out(self):
        if self.ok("Bod", "sneak", diff=3, label="sneaking out"):
            self.flags.add("sneaked")
            self.say("You climb out the window and down the drainpipe. "
                     "Freedom!", "good")
            self.go_outside()
        else:
            self.say("CRASH. You knock over the lamp. 'WHAT was that?'",
                     "bad")
            self.lose_rwp(1, "Caught sneaking out!")
            self.end_turn()

    def grounded_door(self):
        self.say("Mom: 'And where do YOU think you're going? You're "
                 "GROUNDED, young Teener.'", "talk")
        self.open_menu("You're grounded.", [
            ("Beg (RWP, Whine & Wheedle, vs 5)", self.beg),
            ("Do your chores first", self.chores),
            ("Fine. Stay in.", lambda: None)])

    def beg(self):
        key = "begged:%d" % self.day_no()
        if key in self.flags:
            self.say("Mom: 'I said NO.'", "talk")
            return
        self.flags.add(key)
        if self.ok("RWP", "parents", diff=5, label="begging"):
            self.say("Mom: 'Oh... all right. But be home by curfew!'",
                     "talk")
            self.flags.add("sneaked")
        else:
            self.say("Mom: 'Nice try.'", "talk")

    def chores(self):
        key = "chores:%d" % self.day_no()
        if key in self.flags:
            self.say("You've already done your chores today. You could do "
                     "more. You won't.", "info")
            return
        self.flags.add(key)
        self.pass_time(30, quiet=True)
        self.say("You take out the trash, do the dishes, and feed the "
                 "goldfish (a normal one).", "info")
        self.gain_rwp(1, "Chores!")
        if self.p["grounded"] and self.p["rwp"] >= 0:
            self.p["grounded"] = False
            self.say("Mom: 'Fine. You're ungrounded. Don't make me "
                     "regret it.'", "talk")
        self.render()

    def ask_money(self, mob):
        key = "advance:%d" % self.day_no()
        if key in self.flags:
            self.npc_say(mob, "I already gave you money today. What do you "
                         "do with it all?")
            return
        self.flags.add(key)
        if self.p["rwp"] < 0:
            self.npc_say(mob, "Money? After what you did? Ha!")
            return
        if self.ok("RWP", "parents", diff=4, label="asking for money"):
            self.p["cash"] += 10
            self.npc_say(mob, "Here's ten dollars. Don't tell your father.")
            self.sound.play("gold")
        else:
            self.npc_say(mob, "Money doesn't grow on trees, you know. Or on "
                         "Zorb. I asked.")

    # ── Clues ──

    def learn(self, cid):
        if cid in self.clues:
            return
        self.clues.append(cid)
        if cid.endswith("_known"):
            self.flags.add("known:" + cid[:-6])
            if cid == "saucer_known":
                self.reveal_saucer()
        self.say("(Your journal has a new entry. J reads it.)", "quest")
        self.sound.play("gold")

    def hear(self, text):
        """Words in CAPITALS: things to ask about, and to look up."""
        words = re.findall(r"\b[A-Z][A-Z']{2,}\b", text)
        self.heard = [re.sub(r"'S?$", "", w) for w in words
                      if w not in ("BYE", "HI") and
                      not re.fullmatch(r"[IVXLC]+", w)]
        for w in words:
            if w in RESEARCH:
                self.topics.add(w)

    # ── Talking ──

    def speaker(self, mob):
        return mob.name if mob.known or mob.role in ("fizzwick", "mom",
                                                     "dad") else \
            cap(mob.title)

    def npc_say(self, mob, text):
        text = fill(text, self.world)
        self.say("%s: %s" % (self.speaker(mob), text), "talk")
        self.hear(text)

    def start_talk(self, mob):
        p = self.p
        fr = p["freak"]
        if fr and fr["kind"] == "giggle":
            self.say("You try to talk to %s, but it all comes out as "
                     "giggles. They back away." % mob.title, "mad")
            return
        if "Get Small" in p["on"]:
            self.say("You squeak at %s. They don't hear you. You're the "
                     "size of a mouse." % mob.title, "info")
            return
        self.talk = {"mob": mob, "mode": "kw"}
        self.heard = []
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Ask about:")
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        if mob.role == "fizzwick":
            self.fizzwick_greet(mob)
            if self.overlay:
                self.end_talk()
                return
            self.talk_menu()
            return
        self.say("You talk to %s." % mob.title, "info")
        e = mob.errand
        greet = mob.greet
        if e is not None:
            st = self.side.get(e["id"])
            if st and st["state"] == "active":
                greet = "Oh! It's you. Any luck?"
        if getattr(mob, "reformed", False) and "met:" + mob.name in \
                self.flags:
            greet = random.choice(("Hi, friend!", "Want a cookie? I made "
                                   "cookies!", "You're my favourite "
                                   "person. Don't tell anyone."))
        elif getattr(mob, "reformed", False):
            self.flags.add("met:" + mob.name)
        elif getattr(mob, "swapped", False):
            greet = "Hey! Check out the new me!" if self.likes_change(mob) \
                else "You! You did this! Change me back!"
        elif p.get("date") and p.get("date") == mob.role:
            greet = random.choice(("Hi, you! Saturday's going to be "
                                   "great.", "Hey, date!",
                                   "I bought shoes. For Saturday."))
        self.npc_say(mob, "We're closed. Come back tomorrow." if
                     self.closed(mob) else greet)
        for e in self.world["errands"]:
            if e.get("to") == mob.role:
                self.deliver(mob, e)
        if e is not None and self.errand_ready(e):
            self.finish_errand(mob, e)
        if "talked" not in self.flags:
            self.flags.add("talked")
            self.say("(Choose what to ask about, or type a word such as "
                     "NAME, JOB or NEWS and press Return. BYE, or an empty "
                     "line, ends the conversation.)", "info")
        self.talk_menu()

    def closed(self, mob):
        return mob.shop in CLOSES and (self.phase() == "night" or (
            mob.shop == "lunch" and not 11 <= self.now().hour < 14))

    def talk_menu(self):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        if t["mode"] == "buy":
            items = [("%d) %s%s" % (i, label, ", $%d" % price if price
                                    else ""),
                      lambda i=i: self.choose_words(str(i)))
                     for i, (label, price, _) in
                     enumerate(self.offers(mob), 1)]
            items.append(("Nothing, thanks", lambda: self.choose_words("")))
            self.open_menu("Buy what? (you have $%d)" % self.p["cash"],
                           items, lambda: self.choose_words(""))
            return
        words = ["NAME", "JOB", "NEWS"]
        if mob.shop:
            words.append("BUY")
        if mob.errand is not None and self.side.get(
                mob.errand["id"], {}).get("state") != "done":
            words.append("HELP")
        if mob.role == "fizzwick":
            words += ["HYPERDISCO", "SHARDS", "SNORR"]
        elif mob.role in ("mom", "dad"):
            words += ["MONEY", "CHORES"]
        elif mob.role and "SNORR" in self.topics and mob.role in \
                AGENT_ROLES:
            words.append("SNORR")
        if "zapped:" + (mob.role or mob.name) in self.flags:
            words.append("CHANGE")
        if mob.role in DATE_ROLES and "FORMAL" not in words:
            words.append("FORMAL")
        for w in getattr(self, "heard", []):
            if w not in words and w != "BYE":
                words.append(w)
        self.open_menu("Ask %s about:" % self.speaker(mob),
                       [(w, lambda w=w: self.choose_words(w))
                        for w in words + ["BYE"]],
                       lambda: self.choose_words("bye"))

    def choose_words(self, w):
        self.say("> " + (w or "nothing"), "you")
        self.converse(w.lower())
        self.talk_menu()

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if getattr(self, "p", None) and getattr(self, "area", None):
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if not self.talk:
            return
        self.menu = None
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())
        self.talk_menu()

    def converse(self, w):
        t = self.talk
        mob = t["mob"]
        if t["mode"] == "buy":
            t["mode"] = "kw"
            if w.isdigit():
                self.buy(mob, int(w))
                return
            if not w:
                self.npc_say(mob, "Anything else?")
                return
        if not w or w.startswith("bye"):
            self.npc_say(mob, random.choice(BYES))
            self.end_talk()
            return
        word = re.sub(r"'s?$", "", w.split()[0])
        if word.startswith("name"):
            mob.known = True
            self.npc_say(mob, "I'm %s." % mob.name if not mob.role else
                         "%s, %s." % (mob.name, mob.title))
            return
        if word[:4] in ERRAND_WORDS and mob.errand is not None:
            self.errand(mob)
            return
        if mob.shop and word[:3] in ("buy", "pur", "sho", "sel"):
            self.list_offers(mob)
            return
        if word[:4] in ("chan", "zap", "zapp", "swit", "swap", "gun") and \
                "zapped:" + (mob.role or mob.name) in self.flags:
            self.about_change(mob)
            return
        if mob.role in ("mom", "dad") and word[:4] in ("mone", "allo",
                                                       "cash"):
            self.ask_money(mob)
            return
        if mob.role in ("mom", "dad") and word[:4] in ("chor", "tras"):
            self.chores()
            return
        if word[:4] in ("form", "date", "prom", "danc") and \
                mob.role in DATE_ROLES:
            self.ask_out(mob)
            return
        if mob.leader and word[:4] in ("snor", "grey", "gray", "agen"):
            self.confront(mob)
            return
        if mob.role in AGENT_ROLES and word[:4] == "snor":
            self.npc_say(mob, random.choice((
                "Snorr? Never heard of it. Sounds very dull.",
                "Is that a band? I don't follow the bands.",
                "Snorr? Ha ha. No.")))
            return
        if mob.role == "fizzwick" and word[:4] == "shar" and self.returned:
            self.npc_say(mob, "I have %d of the four. %s" % (
                len(self.returned), "The Hyperdisco's ready! Saturday, the "
                "gym, eight o'clock!" if len(self.returned) >= 4 else
                "Keep going!"))
            return
        reply = next((v for k, v in mob.talk.items()
                      if k[:4] == word[:4] or (len(k) < 4 and
                                               word.startswith(k))), None)
        if reply is None and word[:4] in ("heal", "how'", "how"):
            reply = random.choice(HEALTH)
        if reply is None and mob.shop and len(word) >= 4 and \
                not self.closed(mob) and any(
                    word[:4] in label.lower()
                    for label, _, _ in self.offers(mob)):
            self.list_offers(mob)
            return
        if reply is None:
            reply = next((v for k, v in TOPICS.items()
                          if word.startswith(k)), None)
        if reply is None and word.upper() in RESEARCH:
            reply = "Like, I don't know much about that. Look it up at the library?"
        if reply is None:
            reply = random.choice((
                "I don't know anything about that.",
                "Huh?",
                "Like, I have no idea what you're talking about."))
        self.reply(mob, reply)
        self.render_chrome()

    def reply(self, mob, r):
        """Say a reply: words, or a dict that may roll, give things and
        teach clues."""
        if isinstance(r, str):
            self.npc_say(mob, r)
            return
        if "stat" in r:
            flag = r.get("flag")
            if flag and flag in self.flags:
                self.npc_say(mob, "I've done all I'm going to do for you.")
                return
            tried = "tried:%s:%d" % (flag, self.day_no())
            if tried in self.flags:
                self.npc_say(mob, r["fail"])
                return
            bonus = 3 if mob.alien and "Fake Out" in self.p["powers"] \
                else 0
            if self.ok(r["stat"], r.get("knack"), diff=r.get("diff", 3),
                       bonus=bonus, label="persuading"):
                self.npc_say(mob, r["ok"])
                if flag:
                    self.flags.add(flag)
                if r.get("give"):
                    self.p["items"][r["give"]] = 1
                    self.say("You get the %s." % r["give"], "gold")
                    self.sound.play("gold")
            else:
                self.flags.add(tried)
                self.npc_say(mob, r["fail"])
            return
        self.npc_say(mob, r["say"])
        if r.get("learn"):
            self.learn(r["learn"])
        if r.get("topic"):
            self.topics.add(r["topic"])

    # ── Dates ──

    def ask_out(self, mob):
        """Ask someone to the Formal: Cool (or Looks) against their Cool
        (or Smarts)."""
        p = self.p
        role = mob.role
        if p.get("date") == role:
            self.npc_say(mob, "We're already going together, silly!")
            return
        if p.get("date"):
            self.npc_say(mob, "Aren't you going with %s? I heard you were "
                         "going with %s." % ((self.world["people"][
                             p["date"]]["first"],) * 2))
            return
        key = "asked:%s:%d" % (role, self.day_no())
        if key in self.flags:
            self.npc_say(mob, "You asked me already today! Ask me "
                         "tomorrow. Maybe.")
            return
        self.flags.add(key)
        them = self.world["dates"][role]
        bonus = 0
        notes = []
        if p["items"].get("corsage"):
            bonus += 2
            notes.append("the corsage")
        if p["items"].get("formalwear"):
            bonus += 1
        if "Incredible Cute" in p["powers"]:
            bonus += 2
        if mob.alien and "Fake Out" in p["powers"]:
            bonus += 3
            notes.append("telling them it's an Earth custom")
        if any(e["giver"] == role and self.side.get(e["id"], {}).get(
                "state") == "done" for e in self.world["errands"]):
            bonus += 2
        stat = "Cool" if self.stat("Cool") + self.knack("date")[1] >= \
            self.stat("Looks") + self.knack("charm")[1] else "Looks"
        self.say("You take a deep breath and ask %s to the Formal%s." % (
            mob.name, " (with %s)" % " and ".join(notes) if notes else ""),
            "info")
        margin = self.stat_roll(stat, "date" if stat == "Cool" else "charm",
                                diff=max(them["cool"], them["smarts"]),
                                bonus=bonus, label="asking")
        if margin <= 0:
            self.npc_say(mob, random.choice((
                "Oh! Um. I think I'm washing my hair Saturday.",
                "That's so sweet. No.",
                "I'm kind of waiting for somebody else to ask? Sorry.",
                "Ha ha! Oh, you're serious.")))
            return
        p["date"] = role
        if p["items"].get("corsage"):
            del p["items"]["corsage"]
        mob.known = True
        self.npc_say(mob, random.choice((
            "Yes! YES! I mean, sure. Cool.",
            "I thought you'd never ask!",
            "Okay! Pick me up at seven-thirty. Don't be late.")))
        self.sound.play("level")
        self.gain_tp(1, "for getting a date")
        if margin >= 6:
            self.say("Uh oh. That went TOO well. %s is gazing at you like "
                     "you're a cheeseburger." % mob.name, "mad")
            self.p["admirer"] = mob.name
            self.flags.add("admirer")
            self.npc_say(mob, "I'm never going to leave your side. Ever. "
                         "EVER.")

    def confront(self, mob):
        """Ask the Snorrian agent about Snorr."""
        if "dossier" not in self.flags and "suspect" not in self.clues:
            self.npc_say(mob, "Snorr? Never heard of it. Sounds very dull.")
            if "doubt:snorr" not in self.flags:
                self.flags.add("doubt:snorr")
                if self.ok("Smarts", "figure", diff=4,
                           label="seeing through it"):
                    self.say("Their left eye twitches. Grey sweat. %s is "
                             "lying." % mob.name, "mad")
                    self.learn("suspect")
            return
        self.npc_say(mob, "So. You know. A pity. This town was so close to "
                     "being perfectly, wonderfully BORING.")
        self.say("%s's skin goes grey, then greyer. Their tie straightens "
                 "itself. Their eyes go flat as a spreadsheet." % mob.name,
                 "bad")
        self.end_talk()
        m = MONSTERS["agent"]
        mob.kind = "agent"
        mob.tile = "agent"
        mob.hostile = True
        mob.aware = True
        mob.boss = True
        mob.bonk = mob.maxbonk = m.bonk
        mob.title = "the Snorrian agent"
        self.flags.add("unmasked")
        self.area.scared.add("agent")
        self.render()

    # ── Shops ──

    def offers(self, mob):
        """(label, price, what happens) for what a shop sells."""
        p = self.p
        kind = mob.shop
        o = []

        def give(item, n=1):
            def f():
                p["items"][item] = p["items"].get(item, 0) + n
                self.say("You buy %s." % ITEMS[item][0].split(":")[0],
                         "gold")
            return f

        def item(name):
            return (cap(ITEMS[name][0].split(":")[0]), ITEMS[name][1],
                    give(name))
        if kind == "burger":
            o += [item("burger"), item("soda")]
        elif kind == "snacks":
            o += [item("soda"), item("cosmo cake"), item("burger")]
        elif kind == "cakes":
            o += [item("cosmo cake"), item("soda")]
        elif kind == "icecream":
            o.append(item("ice cream"))
        elif kind == "tokens":
            o += [("Five tokens", 1, give("tokens", 5)),
                  ("Ten tokens", 2, give("tokens", 10))]
        elif kind == "flowers":
            o.append(item("corsage"))
        elif kind == "formal":
            if not p["items"].get("formalwear"):
                o.append(item("formalwear"))
        elif kind == "gadgets":
            for g in ("Hyperdimensional Hammer", "Zap Gun", "Goop Gun"):
                if g not in p["gadgets"]:
                    o.append(("%s (%s)" % (g, GADGETS[g].note),
                              GADGETS[g].price,
                              lambda g=g: self.got_gadget(g)))
            for n in ("popcorn grenade", "soopergloo", "bonk regenerator",
                      "pocket phone", "spring shoes", "rocket sneakers",
                      "boy/girl gun", "teleport doormat", "instant hole",
                      "timestop makeup", "battle bikini"):
                if n in WORN + ("pocket phone", "boy/girl gun") and \
                        p["items"].get(n):
                    continue
                o.append(item(n))
        elif kind == "wheels":
            if "jetbike" not in p["wheels"]:
                o.append(("A jetbike (very fast, can't swim)", 200,
                          lambda: self.got_wheels("jetbike")))
            if not any(w in p["wheels"] for w in ("saucer", "superdrive")):
                o.append(("A used flying saucer (flies over anything)",
                          150, lambda: self.got_wheels("saucer")))
            elif "saucer" in p["wheels"]:
                o.append(("A superdrive for your saucer", 250,
                          lambda: self.got_wheels("superdrive")))
        elif kind == "surf":
            if "board" not in p["wheels"]:
                o.append(("An antigravity boogie board (rides the waves, "
                          "and the streets)", 100,
                          lambda: self.got_wheels("board")))
            o.append(("Surf wax", 1, lambda: self.say(
                "You buy surf wax. It smells like coconut.", "info")))
        elif kind == "nurse":
            o.append(("An ice pack (+2 Bonk)", 0, self.ice_pack))
        elif kind == "lunch":
            o.append(("School lunch (+1 Bonk)", 1, self.school_lunch))
        elif kind == "home":
            o += [("Ask for money", 0, lambda: self.ask_money(mob)),
                  ("Do your chores", 0, self.chores)]
        return o

    def list_offers(self, mob):
        if self.closed(mob):
            self.npc_say(mob, "We're closed!")
            return
        offers = self.offers(mob)
        if not offers:
            self.npc_say(mob, "I've got nothing else you'd want.")
            return
        self.npc_say(mob, "Here's what we've got.")
        self.talk["mode"] = "buy"

    def buy(self, mob, n):
        p = self.p
        offers = self.offers(mob)
        if not 1 <= n <= len(offers):
            self.npc_say(mob, "Huh?")
            return
        label, price, what = offers[n - 1]
        if price and "Connections" in p["powers"]:
            price = max(1, price * 4 // 5)
            self.npc_say(mob, "Oh, you're a friend of a friend! Discount: "
                         "$%d." % price)
        elif price >= 20 and "haggle:%s:%d" % (mob.role, self.day_no()) \
                not in self.flags:
            self.flags.add("haggle:%s:%d" % (mob.role, self.day_no()))
            if self.ok(("Cool", "Smarts"), "convince", diff=4,
                       label="haggling"):
                price = price * 4 // 5
                self.npc_say(mob, "Fine, fine: $%d. You drive a hard "
                             "bargain." % price)
        if price > p["cash"]:
            self.npc_say(mob, "You're $%d short. Ask your folks?" %
                         (price - p["cash"]))
            return
        p["cash"] -= price
        what()
        self.sound.play("gold")
        self.render_chrome()

    def got_gadget(self, g):
        p = self.p
        p["gadgets"].append(g)
        p["weapon"] = g
        self.say("You buy the %s. It comes with a little instruction "
                 "booklet in forty languages, none of them English." % g,
                 "gold")

    def got_wheels(self, w):
        p = self.p
        if w == "superdrive":
            p["wheels"] = [x if x != "saucer" else "superdrive"
                           for x in p["wheels"]]
            self.say("Zeb bolts a superdrive onto your saucer. 'She'll do "
                     "three squares a step now. Don't tell your mom.'",
                     "gold")
            return
        p["wheels"].append(w)
        self.say({"jetbike": "A jetbike! It looks like a Harley that "
                             "swallowed a rocket. (G to ride.)",
                  "saucer": "A used saucer, painted Cosmovomit Green. It's "
                            "yours. (G to fly.)",
                  "board": "An antigravity boogie board! (G to ride; it "
                           "goes over water.)"}[w], "gold")

    def ice_pack(self):
        p = self.p
        key = "ice:%d" % (self.turn // 60)
        if key in self.flags or p["bonk"] >= self.max_bonk():
            self.say("The nurse looks you over. 'You're fine. Back to "
                     "class.'", "info")
            return
        self.flags.add(key)
        p["bonk"] = min(self.max_bonk(), p["bonk"] + 2)
        self.say("An ice pack on the head. Ahhh. (+2 Bonk)", "good")

    def school_lunch(self):
        p = self.p
        p["bonk"] = min(self.max_bonk(), p["bonk"] + 1)
        self.pass_time(20, quiet=True)
        self.say("Sloppy joe, tater tots, a carton of milk. The sloppy joe "
                 "looks back at you. (+1 Bonk)", "good")

    # ── Dr. Fizzwick and the Formal ──

    def fizzwick_greet(self, mob):
        p = self.p
        self.say("You meet Dr. Ida Fizzwick, science teacher: lab coat, "
                 "safety goggles, eyebrows slightly singed.", "info")
        if "met_fizzwick" not in self.flags:
            self.flags.add("met_fizzwick")
            self.npc_say(mob, "%s! Thank goodness. Shut the door. Marigold "
                         "Bay High is hosting the Galactic Spring FORMAL on "
                         "Saturday, and someone has smashed the HYPERDISCO "
                         "into four SHARDS and hidden them all over town."
                         % p["name"])
            self.npc_say(mob, "No Hyperdisco, no party; no party, and Earth "
                         "gets listed as a rest stop. Find the shards. "
                         "Bring them to me. And Teener, if you smell "
                         "anything grey, it's SNORR. Here: twenty dollars "
                         "from the Formal committee.")
            p["cash"] += 20
            self.say("Dr. Fizzwick gives you $20.", "gold")
            self.learn("case")
            self.topics.update(("HYPERDISCO", "SNORR"))
            return
        if self.shards:
            for lid in self.shards:
                self.returned.append(lid)
                self.flags.add("back:" + lid)
                self.npc_say(mob, "%s! Look at it sparkle!" %
                             cap(self.world["shards"][lid]))
            n = len(self.shards)
            self.shards = []
            self.sound.play("level")
            self.gain_tp(2 * n, "for bringing shards home")
            self.fizzwick_gives()
            return
        n = len(self.returned)
        self.npc_say(mob, "The Hyperdisco's ready! The gym, Saturday, eight "
                     "o'clock. Switch it on and DANCE." if n >= 4 else
                     "I have %d of the four shards. Keep listening to the "
                     "town: weird stuff means shards." % n)

    def fizzwick_gives(self):
        p = self.p
        n = len(self.returned)
        gifts = {1: ("Zap Gun", "a Zap Gun from her desk drawer"),
                 2: ("Goop Gun", "a Goop Gun, slightly used"),
                 3: ("popcorn grenade", "two popcorn grenades")}
        for k in range(1, n + 1):
            flag = "gift:%d" % k
            if k not in gifts or flag in self.flags:
                continue
            self.flags.add(flag)
            what, text = gifts[k]
            if what in GADGETS:
                if what in p["gadgets"]:
                    p["items"]["bonk regenerator"] = p["items"].get(
                        "bonk regenerator", 0) + 1
                    text = "a Bonk Regenerator Ray"
                else:
                    p["gadgets"].append(what)
            else:
                p["items"][what] = p["items"].get(what, 0) + 2
            self.say("Dr. Fizzwick gives you %s. 'For emergencies. And "
                     "science.'" % text, "gold")
        if n >= 4 and "final" not in self.flags:
            self.flags.add("final")
            self.learn("final")
            self.say("Dr. Fizzwick fits the last shard in place with a "
                     "pair of tweezers. 'It's done! It's in the gym. "
                     "Saturday, eight o'clock, you switch it on. And wear "
                     "something NICE.'", "quest")
            self.sound.play("quest")

    def gym_arrival(self):
