def make_folk(world, rng, i, x, y):
    tile = rng.choice(TOWNSFOLK_TILES)
    sex = "F" if tile in ("girl", "girl2", "girl3", "suit_f", "mom") else "M"
    teen = tile.startswith(("kid", "girl", "surfer"))
    first = rng.choice((MALE if sex == "M" else FEMALE) if teen else
                       (ADULT_MALE if sex == "M" else ADULT_FEMALE))
    name = "%s %s" % (first, rng.choice(SURNAMES))
    job, line, extra = rng.choice(JOBS)
    extra = dict(extra)
    alien = extra.pop("alien", False)
    if alien:
        tile = rng.choice(("exchange", "merchant", "zeb"))
        name = rng.choice(ALIEN_NAMES)
    if i % 9 == 4:
        tile, job, line, extra = ("cop", "police officer",
                                  "I keep the peace. And the aliens' "
                                  "saucers out of the no-parking zones.",
                                  {})
    m = Mob(tile, name, x, y)
    m.title = "a " + job if job[0] not in "aeiou" else "an " + job
    m.alien = alien
    m.greet = rng.choice(GREETINGS)
    r = rng.random()
    if r < 0.45:
        lid = rng.choice(world["leads"])
        news = fill(RUMOURS[lid], world)
    elif r < 0.7:
        news = rng.choice(SNORR_RUMOURS)
    else:
        news = rng.choice(TIPS)
    m.talk = {"job": line, "news": news}
    m.talk.update(extra)
    m.roam = {"street", "grass", "boardwalk", "lawn"}
    m.home = (x, y)
    m.night_owl = i < 4
    return m


def cap(s):
    return s[:1].upper() + s[1:]


def wrap(text, width):
    out, line = [], ""
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            out.append(line)
            line = "  " + word if text.startswith("  ") else word
        else:
            line = (line + " " + word) if line else word
    if line:
        out.append(line)
    return out


