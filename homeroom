        """The agent's last try: Monstered Out, in the gym."""
        a = self.area
        who = self.world["people"][self.world["agent"]]
        self.say("You reach for the switch... and the gym doors burst "
                 "open. It's %s, %s! 'NO DANCING!' they bellow, and MONSTER "
                 "OUT: fifty feet of grey, Snorrian rubber." % (
                     who["name"], who["title"]), "bad")
        self.sound.play("horror")
        x, y = self.pos
        spots = sorted(((sx, sy) for sy in range(a.h) for sx in range(a.w)
                        if a.grid[sy][sx] == "gymfloor" and
                        not a.mob_at(sx, sy) and [sx, sy] != self.pos),
                       key=lambda s: -abs(s[1] - y))
        bx, by = spots[0]
        m = make_monster("borelord", bx, by, boss=True)
        m.name = "the Bore-Lord (%s)" % who["name"]
        m.leader = True
