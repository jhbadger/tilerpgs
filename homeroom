def generate_world(seed):
    """The week: who is who, which leads are live, where the shards are."""
    rng = random.Random("%s:world" % seed)
    world = {"seed": seed, "people": make_people(rng),
             "family": rng.choice(SURNAMES),
             "exchange_world": rng.choice(ALIEN_WORLDS)}
    world["agent"] = rng.choice(AGENT_ROLES)
    leads = rng.sample(CASE_LEADS, 4)
    world["leads"] = leads
    names = list(SHARD_NAMES)
    rng.shuffle(names)
    world["shards"] = dict(zip(leads, names))
    world["dossier"] = rng.choice(leads)
    world["dates"] = {r: {"cool": rng.randint(2, 5), "smarts": rng.randint(
        2, 5)} for r in DATE_ROLES}
    world["errands"] = make_errands(rng, world)
    return world


