    def give_errand(self, mob):
        for e in self.world["errands"]:
            if e["giver"] == mob.role:
                mob.errand = e

    def release_cats(self, area=None):
        a = area or self.cache.get(("city",))
        if a is None:
            return
        a.mobs = [m for m in a.mobs if m.cat is None]
        for e in self.world["errands"]:
            st = self.side.get(e["id"], {}).get("state")
            if e["kind"] == "cat" and st == "active" and \
                    "cat:" + e["id"] not in self.flags:
                x, y = e["spot"]
                while a.mob_at(x, y):
                    x += 1
                pet = Mob("pet", e["cat"], x, y)
                pet.cat = e
                pet.roam, pet.home = {"street", "grass", "lawn"}, (x, y)
                pet.title = "a %s" % e["pet"]
                a.mobs.append(pet)

    def errand(self, mob):
        e = mob.errand
        st = self.side.get(e["id"])
        if st is None:
            self.side[e["id"]] = {"state": "active"}
            if e["kind"] == "cat":
                self.npc_say(mob, "My %s, %s, got out! Fuzzy, about this "
                             "big, answers to %s (sometimes). Last seen %s. "
                             "Bring %s home and I'll give you $%d!" % (
                                 e["pet"], e["cat"], e["cat"], district(
                                     *e["spot"]).replace("the ", "near the ",
                                                         1)
                                 if district(*e["spot"]).startswith("the")
                                 else "in " + district(*e["spot"]),
                                 "it", e["pay"]))
                self.release_cats()
            else:
                who = self.world["people"][e["to"]]
                self.npc_say(mob, "Could you take %s to %s, %s? They'll "
                             "give you $%d for it." % (
                                 e["thing"], who["name"],
                                 fill(who["title"], self.world), e["pay"]))
                self.say("You take %s." % e["thing"], "info")
        elif st["state"] == "done":
            self.npc_say(mob, "Thanks again! You're the best!")
        elif self.errand_ready(e):
            self.finish_errand(mob, e)
        else:
            self.npc_say(mob, "Did you find %s yet?" % e["cat"]
                         if e["kind"] == "cat" else
                         "Did you take %s to %s yet?" % (
                             e["thing"],
                             self.world["people"][e["to"]]["short"]))

    def errand_ready(self, e):
        return (self.side.get(e["id"], {}).get("state") == "active" and
                e["kind"] == "cat" and "cat:" + e["id"] in self.flags)

    def finish_errand(self, mob, e):
        self.side[e["id"]]["state"] = "done"
        self.npc_say(mob, "%s! You found %s! Here, take this." % (
            e["cat"], "it"))
        self.p["cash"] += e["pay"]
        self.say("You get $%d." % e["pay"], "gold")
        self.gain_tp(1, "for a good deed")
        self.sound.play("gold")

    def deliver(self, mob, e):
        st = self.side.get(e["id"])
        if not st or st["state"] != "active":
            return
        st["state"] = "done"
        self.npc_say(mob, "Is that %s? From %s? Cool. Here." % (
            e["thing"], self.world["people"][e["giver"]]["short"]))
        self.p["cash"] += e["pay"]
        self.say("You get $%d." % e["pay"], "gold")
        self.gain_tp(1, "for a good deed")

