def make_people(rng):
    people = {}
    for role, (tile, sex, honorific, title, alien) in ROLES.items():
        sex = sex or rng.choice("MF")
        teen = role.endswith("kid") or role in ("cheer", "mallrat",
                                                "prepkid2", "patron",
                                                "patron2", "sibling",
                                                "snack", "lifeguard",
                                                "videoclerk", "arcademgr")
        if role == "fizzwick":
            first, last = "Ida", "Fizzwick"
        elif alien:
            first, last = rng.choice(ALIEN_NAMES), ""
        else:
            first = rng.choice((MALE if sex == "M" else FEMALE) if teen else
                               (ADULT_MALE if sex == "M" else ADULT_FEMALE))
            last = rng.choice(SURNAMES)
        if sex == "F" and tile in ("suit", "teacher", "clerk", "kid", "kid2",
                                   "kid3", "jock", "nerd", "punk", "surfer",
                                   "principal", "coach"):
            tile = {"suit": "suit_f", "teacher": "teacher_f",
                    "clerk": "clerk_f", "principal": "suit_f",
                    "coach": "teacher_f", "jock": "girl2", "nerd": "girl",
                    "punk": "girl3", "surfer": "girl2"}.get(tile, "girl")
        elif sex == "M" and tile in ("girl", "girl2", "girl3", "clerk_f",
                                     "teacher_f", "suit_f"):
            tile = {"clerk_f": "clerk", "teacher_f": "teacher",
                    "suit_f": "suit"}.get(tile, "kid3")
        if honorific == "Mr." and sex == "F":
            honorific = "Ms."
        elif honorific == "Mrs." and sex == "M":
            honorific = "Mr."
        full = ("%s %s" % (first, last)).strip()
        short = ("%s %s" % (honorific, last)) if honorific and last else \
            first
        if role in ("mom", "dad"):
            full = short = cap(role)
        people[role] = {"first": first, "last": last, "sex": sex,
                        "tile": tile, "name": ("%s %s" % (honorific, full))
                        if honorific and role not in ("mom", "dad")
                        else full, "short": short, "title": title,
                        "alien": alien, "teen": teen, "hon": honorific}
    return people


# The Boy/Girl Gun: honorifics and words that change with it.
SWAP_HONORIFICS = {"Mr.": "Ms.", "Ms.": "Mr.", "Mrs.": "Mr."}
SWAP_WORDS = {"mom": "dad", "dad": "mom", "brother": "sister",
              "sister": "brother", "guy": "gal", "gal": "guy",
              "lady": "man", "man": "lady", "girl": "boy", "boy": "girl",
              "nephew": "niece", "niece": "nephew"}


def swap_words(text):
    """A title such as 'the ice cream lady', the other way round."""
    def sub(m):
        w = m.group(0)
        new = SWAP_WORDS[w.lower()]
        return cap(new) if w[0].isupper() else new
    return re.sub(r"\b(%s)\b" % "|".join(SWAP_WORDS), sub, text,
                  flags=re.IGNORECASE)


def swap_person(who, role):
    """Zapped: the other sex, with the honorific and title to match.
    Zapped again: back as they were."""
    if "plain" in who:
        who.update(who.pop("plain"))
        return
    who["plain"] = {k: who[k] for k in ("sex", "name", "short", "title")}
    who["sex"] = "F" if who["sex"] == "M" else "M"
    who["title"] = swap_words(who["title"])
    hon = SWAP_HONORIFICS.get(who["hon"], who["hon"])
    if role in ("mom", "dad"):
        who["name"] = who["short"] = swap_words(who["name"])
    elif who["hon"]:
        full = ("%s %s" % (who["first"], who["last"])).strip()
        who["name"] = "%s %s" % (hon, full)
        if who["last"]:
            who["short"] = "%s %s" % (hon, who["last"])


def make_person(world, role, x, y):
    who = world["people"][role]
    m = Mob(who["tile"], who["name"], x, y)
    m.role = role
    m.title = fill(who["title"], world)
    m.shop = SHOPS.get(role)
    m.leader = role == world["agent"]
    m.alien = who["alien"]
    m.talk, m.greet = role_talk(world, role)
    return m


def fill(text, world):
    p = world["people"]
    names = {r: v["short"] for r, v in p.items()}
    names.update({r + "_full": v["name"] for r, v in p.items()})
    ag = p[world["agent"]]
    names.update(agent=ag["short"], agent_full=ag["name"],
                 agent_title=ag["title"], world=world["exchange_world"],
                 family=world["family"],
                 sib="brother" if p["sibling"]["sex"] == "M" else "sister")
    for r, v in p.items():
        m = v["sex"] == "M"
        names.update({r + "_he": "he" if m else "she",
                      r + "_He": "He" if m else "She",
                      r + "_his": "his" if m else "her",
                      r + "_him": "him" if m else "her",
                      r + "_kin": "nephew" if m else "niece",
                      r + "_title": v["title"]})
    return text.format(**names)


