# Things on the floor: their tile, and what stepping on them gives.
FLOOR_ITEMS = {"note", "shard", "snack", "gadget", "cash", "tokens", "trap"}


def art_pixels(palette, rows):
    if len(rows) != 16 or any(len(r) != 16 for r in rows):
        raise ValueError("tile art must be 16 x 16")
    return [[None if ch == "." else palette[ch] for ch in r] for r in rows]


def shade(c, f):
    r, g, b = (int(c[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(v * f)))
                                    for v in (r, g, b))


def mix(a, b, t):
    ra, ga, ba = (int(a[i:i + 2], 16) for i in (1, 3, 5))
    rb, gb, bb = (int(b[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % (round(ra + (rb - ra) * t),
                              round(ga + (gb - ga) * t),
                              round(ba + (bb - ba) * t))


def grid_of(c):
    return [[c] * 16 for _ in range(16)]


def speckle(g, rng, colors, p):
    for y in range(16):
        for x in range(16):
            if rng.random() < p:
                g[y][x] = rng.choice(colors)


def rect(g, x0, y0, x1, y1, c):
    for y in range(max(0, y0), min(16, y1 + 1)):
        for x in range(max(0, x0), min(16, x1 + 1)):
            g[y][x] = c


def disc(g, cx, cy, r, c, rng=None, jitter=0.0):
    for y in range(16):
        for x in range(16):
            d = math.hypot(x - cx, y - cy)
            if d <= r + (rng.uniform(-jitter, jitter) if rng else 0):
                g[y][x] = c


def stone_blocks(rng, base, mortar, bw=6, bh=4):
    g = grid_of(mortar)
    for row in range(16 // bh):
        off = (row % 2) * (bw // 2)
        for x in range(-bw, 16, bw):
            c = shade(base, rng.uniform(0.88, 1.1))
            rect(g, x + off, row * bh, x + off + bw - 2, row * bh + bh - 2, c)
    return g


def planks(rng, base, seam, vertical=False, width=4):
    g = grid_of(base)
    for y in range(16):
        for x in range(16):
            a, b = (x, y) if vertical else (y, x)
            if a % width == width - 1:
                g[y][x] = seam
            elif rng.random() < 0.08:
                g[y][x] = shade(base, 0.9)
    for i in range(4):          # butt joints
        a = rng.randrange(16)
        b = i * width + rng.randrange(width - 1)
        if vertical:
            g[a][min(15, b)] = seam
        else:
            g[min(15, b)][a] = seam
    return g


def roof(rng, base):
    g = grid_of(base)
    dark = shade(base, 0.72)
    for y in range(16):
        if y % 4 == 3:
            for x in range(16):
                g[y][x] = dark
        else:
            for x in range((y // 4) * 2 % 4, 16, 4):
                g[y][x] = shade(base, 0.85)
    speckle(g, rng, [shade(base, 1.12)], 0.06)
    return g


def speckle_within(g, rng, inside, colours, p):
    for y in range(16):
        for x in range(16):
            if g[y][x] == inside and rng.random() < p:
                g[y][x] = rng.choice(colours)


def bookshelf(rng):
    g = grid_of("#4a3020")
    for shelf in (1, 6, 11):
        x = 1
        while x < 15:
            w = rng.choice((1, 1, 2))
            c = rng.choice(("#7a1e1e", "#1e3a6a", "#2e5a2e", "#6a5a1e",
                            "#3a2a4a", "#8a6a3a", "#1a1a1a"))
            top = shelf + rng.choice((0, 0, 1))
            rect(g, x, top, min(14, x + w - 1), shelf + 3, c)
            x += w
        rect(g, 0, shelf + 4, 15, shelf + 4, "#2e1c10")
    return g




GRASS = ("#4aa040", "#58b04a", "#3e9038", "#f0e060", "#f080a0")


def grass(rng):
    g = grid_of(GRASS[0])
    speckle(g, rng, GRASS[1:3], 0.35)
    speckle(g, rng, GRASS[3:], 0.02)
    return g


def sand(rng):
    g = grid_of("#e8d498")
    speckle(g, rng, ["#f0dca8", "#d8c488"], 0.3)
    return g


def asphalt(rng):
    g = grid_of("#4a4a50")
    speckle(g, rng, ["#55555c", "#404046"], 0.3)
    return g


def stucco(rng, base):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.06), shade(base, 0.94)], 0.3)
    return g


def palm(rng, under):
    g = under(rng)
    for y in range(5, 16):          # a trunk with rings, leaning a little
        x = 7 + (15 - y) // 6
        rect(g, x, y, x + 1, y, "#8a6a3a" if y % 2 else "#a8844a")
    for ang in (200, 235, 270, 305, 340, 160, 20):   # fronds, drooping
        a = math.radians(ang)
        for k in range(7):
            x = 8 + math.cos(a) * k
            y = 4 + math.sin(a) * k * 0.7 + k * k * 0.07
            for dy in (0, 1):
                xi, yi = int(round(x)), int(round(y)) + dy
                if 0 <= xi < 16 and 0 <= yi < 16:
                    g[yi][xi] = "#2a8a3a" if dy else "#4ac05a"
    disc(g, 8, 4.5, 1.3, "#6a4a2a")
    return g


def draw_terrain(name, frame=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random(name + str(frame))
    if name == "grass":
        return grass(rng)
    if name == "lawn":
        g = grid_of("#50b048")
        for x in range(0, 16, 4):
            rect(g, x, 0, x + 1, 15, "#5ac052")
        return g
    if name == "hill":
        g = grid_of("#c8a858")
        speckle(g, rng, ["#b89848", "#d8b868", "#8aa040"], 0.3)
        return g
    if name == "field":
        g = grid_of("#3a9a3a")
        for x in range(0, 16, 8):
            rect(g, x, 0, x, 15, "#f0f0f0")
        speckle(g, rng, ["#48a848"], 0.2)
        return g
    if name == "sand":
        return sand(rng)
    if name == "path":
        g = grid_of("#c8c4b8")
        rect(g, 0, 7, 15, 7, "#a8a498")
        rect(g, 7, 0, 7, 15, "#a8a498")
        speckle(g, rng, ["#d0ccc0"], 0.1)
        return g
    if name == "street":
        g = asphalt(rng)
        rect(g, 6, 7, 9, 8, "#e0c040")
        return g
    if name == "lot":
        g = asphalt(rng)
        rect(g, 0, 0, 0, 7, "#e8e8e8")
        rect(g, 8, 0, 8, 7, "#e8e8e8")
        return g
    if name in ("water", "surf"):
        g = grid_of("#2a70b0")
        speckle(g, rng, ["#2a64a0", "#3a80c0"], 0.3)
        for y in range(2, 16, 5):
            x0 = (y * 3 + frame * 4) % 16
            for k in range(5):
                g[y][(x0 + k) % 16] = "#70b0e0"
        if name == "surf":
            for y in range(16):
                x = 12 + (2 if (y + frame * 3) % 6 < 3 else 0)
                rect(g, x, y, 15, y, "#f0f8ff")
                rect(g, x - 1, y, x - 1, y, "#b0d8f0")
        return g
    if name == "boardwalk":
        return planks(rng, "#c09868", "#8a6a44")
    if name == "pier":
        g = planks(rng, "#a88458", "#6a5034", vertical=True)
        rect(g, 0, 0, 0, 15, "#5a4028")
        rect(g, 15, 0, 15, 15, "#5a4028")
        return g
    if name == "rock":
        g = grid_of("#c8a858")
        disc(g, 7.5, 8.5, 6.5, "#8a8478", rng, 0.8)
        disc(g, 6, 7, 4, "#a8a294", rng, 0.6)
        disc(g, 5, 5.5, 1.5, "#c0bcb0")
        return g
    if name == "palm":
        return palm(rng, grass)
    if name == "palm_sand":
        return palm(rng, sand)
    if name == "palm_dense":
        g = grid_of("#1e5a24")
        for _ in range(9):
            disc(g, rng.uniform(1, 14), rng.uniform(1, 14),
                 rng.uniform(2, 3.5), rng.choice(("#2a8a3a", "#3aaa4a",
                                                  "#226a2e")), rng, 0.6)
        return g
    if name == "hedge":
        g = grass(rng)
        rect(g, 0, 3, 15, 13, "#2a7a30")
        speckle_within(g, rng, "#2a7a30", ["#3a9a3a", "#1e5a24",
                                            "#f080a0"], 0.25)
        return g
    if name in ("house", "house2", "house3"):
        return roof(rng, {"house": "#e07a5a", "house2": "#5aa0c8",
                          "house3": "#e0b85a"}[name])
    if name == "bldg":
        return stucco(rng, "#f0e0c0")
    if name == "bldg2":
        g = stucco(rng, "#a0c8e0")
        for y in range(2, 16, 5):
            for x in range(1, 16, 5):
                rect(g, x, y, x + 2, y + 2, "#3a6a9a")
        return g
    if name == "bldg3":
        return stone_blocks(rng, "#b8503a", "#8a3a2a", 4, 3)
    if name == "mallwall":
