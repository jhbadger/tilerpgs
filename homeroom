def selftest():
    """Build every map and tune of a few weeks, without a window."""
    for seed in range(6):
        w = generate_world(seed)
        flags = set()
        city = make_city(w, flags)
        doors = [p for p, l in city.links.items() if l[0] == "bld"]
        assert len(doors) == len(SITES) + len(BIG_SITES), doors
        for (x, y), l in city.links.items():
            assert city.grid[y][x] in ("door", "drain", "hatchway",
                                       "hill"), (x, y, city.grid[y][x])
            if l[0] == "bld":
                assert city.grid[y + 1][x] in CITY_GROUND, (l, x, y)
        for sid in list(SITES) + list(BIG_SITES):
            a = make_interior(w, sid)
            assert all(len(r) == a.w for r in a.grid), sid
            assert a.grid[a.start[1]][a.start[0]] in INSIDE_FLOOR, sid
            for m in a.mobs:
                fill(m.greet, w)
                for v in m.talk.values():
                    for s in ([v] if isinstance(v, str) else
                              [x for x in v.values()
                               if isinstance(x, str)]):
                        fill(s, w)
        for lid, info in LEADS.items():
            for level in range(1, info.levels + 1):
                a = make_dungeon(w, lid, level, flags)
                assert a.grid[a.start[1]][a.start[0]] == "stairs_up"
                seen, q = {a.start}, deque([a.start])
                while q:
                    x, y = q.popleft()
                    for dx, dy in DIRS:
                        n = (x + dx, y + dy)
                        if n not in seen and a.grid[n[1]][n[0]] in (
                                DUNGEON_FLOOR | {"gate"}):
                            seen.add(n)
                            q.append(n)
                if a.down:
                    assert a.down in seen, (lid, level)
                if level == info.levels:
                    assert any((m.x, m.y) in seen for m in a.mobs if m.boss)
        for text in list(RUMOURS.values()) + [v[1] for v in
                                              RESEARCH.values()]:
            fill(text, w)
        for cid, text in CLUES.items():
            fill(text, w)
    for name, tune in MUSIC.items():
        steps = len(tune["melody"].replace("|", " ").split())
        assert steps == len(tune["chords"].split()) * tune["bar"], name
    tiles = all_tiles()
    for name in list(TILE_NEEDED):
        assert name in tiles, name
    for (kind, sex), t in TEEN_TILES.items():
        assert t in tiles, t
    print("ok")


