        if "won" in self.flags:
            self.say("The Hyperdisco spins, and spins, and the whole "
                     "Galaxy is dancing.", "good")
            return
        if len(self.returned) < 4:
            self.say("The Hyperdisco, dark and dented, with %d of its four "
                     "shards. Dr. Fizzwick has the rest... once you find "
