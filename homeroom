    @staticmethod
    def roll_teener(rng=random):
        """Everything rolled for a new Teener: Stats, table dice, Knack
        points and allowance."""
        stats = {s: rng.randint(1, 6) for s in STATS}
        return {"stats": stats, "tables": {t: rng.randint(1, 6)
                                           for t in ALIEN_TABLES},
                "human": rng.randint(1, 6) + rng.randint(1, 6),
                "knack_die": rng.randint(1, 6),
                "allowance": 5 * (rng.randint(1, 6) + rng.randint(1, 6)),
                "weeks": rng.randint(1, 6)}

    @staticmethod
    def powers_of(kind, rolled, tables):
        if kind == "Human":
            got = ["Fake Out", HUMAN_TABLE[rolled["human"]]]
        else:
            got = [ALIEN_TABLES[t][rolled["tables"][t] - 1] for t in tables]
        out = []
        for pw in got:
            if pw != "Nothing" and pw not in out:
                out.append(pw)
        return out

    @staticmethod
    def make_teener(who):
        """A Teener from what the creation dialog chose."""
        rolled = who["rolled"]
        stats = dict(who["stats"])
        c = CLIQUES[who["clique"]]
        knacks = {}
        points = rolled["knack_die"]
        while points > 0 and any(knacks.get(k, 0) < 3 for k in c["knacks"]):
            for k in c["knacks"]:
                if points and knacks.get(k, 0) < 3:
                    knacks[k] = knacks.get(k, 0) + 1
                    points -= 1
        powers = list(who["powers"])
        cash = rolled["allowance"] * rolled["weeks"]
        if "Filthy Rich" in powers:
            cash += 500
        wheels = []
        if who["kind"] == "Human":
            wheels.append("car")
        elif "Teleport" not in powers:
            wheels.append("saucer")
        p = {"name": who["name"], "kind": who["kind"], "sex": who["sex"],
             "clique": who["clique"], "stats": stats, "knacks": knacks,
             "powers": powers, "traits": list(c["traits"]),
             "cash": cash, "allowance": rolled["allowance"],
             "items": dict(c["items"]),
             "gadgets": ["Fists"] + list(c["gadgets"]), "tp": 0,
             "tp_total": 0, "freak": None, "out": 0, "fainted": False,
             "held": 0, "on": {}, "rest": {}, "flying": False,
             "driving": None, "wheels": wheels, "date": None,
             "wishes": [0, 3], "swapped": False, "rocket": False,
             "grounded": False, "slept": 0, "rwp": stats["RWP"],
             "rwp_lost": 0}
        p["weapon"] = p["gadgets"][-1]
        p["bonk"] = stats["Bonk"] + (4 if "Toughness" in powers else 0)
        return p

