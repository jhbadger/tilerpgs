def block_rect(i, j, half=None):
    x0, x1 = LANE_X[i] + 1, LANE_X[i + 1] - 1
    y0, y1 = LANE_Y[j] + 1, LANE_Y[j + 1] - 1
    if half == "L":
        x1 = x0 + 3
    elif half == "R":
        x0 += 5
    return x0, y0, x1, y1


def brook(y):
    return 60 + round(1.5 * math.sin(y / 6.0))


def in_lake(x, y, pad=0.0):
    cx, cy, rx, ry = LAKE
    return ((x - cx) / (rx + pad)) ** 2 + ((y - cy) / (ry + pad)) ** 2 <= 1


def district(x, y):
    """The part of Clover Vale a square lies in."""
    if x < 8:
        return "the Hollow Wood"
    if in_lake(x, y, 1.5):
        return "Lily Lake"
    if KEEP[0] <= x <= KEEP[2] and KEEP[1] <= y <= KEEP[3]:
        return "Thornwall Keep"
    if y < 11:
        if TOWER[0] - 3 <= x <= TOWER[2] + 3:
            return "the Star Tower knoll"
        return "Pebble Hill" if x < 58 else "the north-east hills"
    if abs(x - brook(y) - 0.5) <= 1.5 and y < 45:
        return "Willowbrook"
    if x > 58:
        return "the east meadows"
    if y > 45:
        return "Pippin Orchard"
    if SQUARE[0] <= x <= SQUARE[2] and SQUARE[1] <= y <= SQUARE[3]:
        return "the Town Square"
    if x < 12:
        return "the edge of the Hollow Wood"
    return "the High Street" if y < 28 else "Bramble Lane"


def make_city(world, flags):
    """Clover Vale, the same every game but for what the week adds."""
    rng = random.Random("clovervale")
    W, H = CITY_W, CITY_H
    g = [["grass"] * W for _ in range(H)]
    for y in range(H):
        for x in range(W):
            r = rng.random()
            if x < 7:
                g[y][x] = "forest"
            elif x < 11:
                g[y][x] = "tree" if r < 0.35 else "pine" if r < 0.5 else \
                    "grass"
            elif y < 10:
                g[y][x] = "rock" if r < 0.06 else "pine" if r < 0.1 else \
                    "hill"
            elif r < 0.12:
                g[y][x] = "meadow"
    for y in range(H):                  # Willowbrook, down into the lake
        if y > 44:
            break
        for x in (brook(y), brook(y) + 1):
            g[y][x] = "brook"
        if g[y][brook(y) + 2] == "grass" and rng.random() < 0.3:
            g[y][brook(y) + 2] = "reeds"
    for y in range(H):                  # Lily Lake and its shore
        for x in range(W):
            if in_lake(x, y):
                g[y][x] = "water"
            elif in_lake(x, y, 1.3) and g[y][x] not in ("brook",):
                g[y][x] = "sand"
    for y in LANE_Y:                    # the lanes
        for x in range(LANE_X[0], LANE_X[-1] + 1):
            g[y][x] = "path"
    for x in LANE_X:
        for y in range(LANE_Y[0], LANE_Y[-1] + 1):
            g[y][x] = "path"
    for y in (LANE_Y[0], LANE_Y[2]):    # east, over the brook
        for x in range(LANE_X[-1], W if y == LANE_Y[0] else 77):
            g[y][x] = "bridge" if g[y][x] == "brook" else "path"
    for x in range(WOODPATH[0], LANE_X[0]):     # west, into the wood
        g[WOODPATH[1]][x] = "path"
    for y in range(0, LANE_Y[0]):       # the north road
        g[y][42] = "path"
    for y in range(LANE_Y[-1], H):      # the south road
        g[y][32] = "path"
    for y in range(MINE[1] + 1, LANE_Y[0]):
        g[y][MINE[0]] = "path"
    for y in range(TOWER[3] + 1, LANE_Y[0]):
        g[y][48] = "path"
    for y in range(CLOUDSTAIR[1] + 1, LANE_Y[0]):
        g[y][CLOUDSTAIR[0]] = "path"
    for y in range(LANE_Y[-1], BOATHOUSE[1]):
        g[y][BOATHOUSE[0]] = "path"
    for y in range(LANE_Y[2] + 1, KEEPGATE[1]):
        g[y][KEEPGATE[0]] = "path"
    for x in range(FARM[0] + 3, 33):    # the farm track
        g[FARM[3] + 2][x] = "path"
    for y in range(FARM[3] + 1, FARM[3] + 3):
        g[y][27] = "path"

    area = Area("city", ("city",), g, "Clover Vale", edge="grass")
    used = set()
    blocks = [(i, j) for i in range(4) for j in range(4)]
    for i, j in blocks:                 # lantern posts on the corners
        x0, y0, x1, y1 = block_rect(i, j)
        g[y0][x0] = "lamp"
    x0, y0, x1, y1 = SQUARE             # the Town Square
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = "cobble"
            used.add((x, y))
    g[24][27] = "well"
    g[24][37] = "fountain"
    area.labels[(37, 24)] = "the fountain in the Town Square"
    area.labels[(27, 24)] = "the wishing well"
    for x, y in ((23, 21), (41, 21), (23, 27), (41, 27)):
        g[y][x] = "lamp"
    x0, y0, x1, y1 = HALL               # the Lantern Hall and its bell tower
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = "hall"
            used.add((x, y))
    g[y0][32] = "belltower"
    x0, y0, x1, y1 = TOWER              # the Star Tower
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = "tower"
    x0, y0, x1, y1 = FARM               # Pippin Orchard
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = "cottage2"
    x0, y0, x1, y1 = ORCHARD
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = "orchard" if x % 2 and y % 2 else "grass"
    for y in range(46, 57):
        for x in range(34, 48):
            g[y][x] = "haybale" if rng.random() < 0.04 else "field"
    x0, y0, x1, y1 = KEEP               # the ruins of Thornwall Keep
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            edge = x in (x0, x1) or y in (y0, y1)
            g[y][x] = ("stonewall" if rng.random() < 0.7 else "ruin") \
                if edge else ("ruin" if rng.random() < 0.3 else "hill")
    for sid, (name, kind, (i, j, half), look) in SITES.items():
        x0, y0, x1, y1 = block_rect(i, j, half)
        for y in range(y0 + 1, y1 + 1):
            for x in range(x0, x1 + 1):
                g[y][x] = look
        door = ((x0 + x1 + 1) // 2, y1)
        g[door[1]][door[0]] = "door"
        area.links[door] = ("bld", sid)
        area.labels[door] = name
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                used.add((x, y))
    for sid, (name, kind, door) in BIG_SITES.items():
        g[door[1]][door[0]] = "door"
        area.links[door] = ("bld", sid)
        area.labels[door] = name
    x0, y0, x1, y1 = block_rect(*GREEN)     # the Clover Green
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            edge = x in (x0, x1) or y in (y0, y1)
            g[y][x] = "tree" if edge and (x + y) % 3 == 0 else \
                "flowers" if (x * 7 + y * 3) % 5 == 0 else "meadow"
            used.add((x, y))
    area.labels[((x0 + x1) // 2, (y0 + y1) // 2)] = "the Clover Green"
    for i, j in blocks:                     # cottages everywhere else
        x0, y0, x1, y1 = block_rect(i, j)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                if (x, y) in used or g[y][x] == "lamp":
                    continue
                r = rng.random()
                g[y][x] = "tree" if r < 0.08 else "flowers" if r < 0.12 \
                    else "grass"
        for hy in range(y0 + 1, y1, 3):
            for hx in range(x0, x1 - 1, 4):
                if rng.random() > 0.85:
                    continue
                cells = [(x, y) for y in (hy, hy + 1) for x in
                         (hx, hx + 1, hx + 2) if y <= y1 and x <= x1]
                if any(c in used or g[c[1]][c[0]] == "lamp" for c in cells):
                    continue
                look = rng.choice(("cottage", "cottage2", "cottage3"))
                for x, y in cells:
                    g[y][x] = look
    g[0][42] = g[H - 1][32] = g[LANE_Y[0]][W - 1] = "sign_n"
    area.signs = {(42, 0): "n", (32, H - 1): "s", (W - 1, LANE_Y[0]): "e"}
    g[MINE[1]][MINE[0]] = "mineshaft"
    area.links[MINE] = ("lead", "mine")
    area.labels[MINE] = "the old gem mine"
    g[WOODPATH[1]][WOODPATH[0]] = "woodpath"
    area.links[WOODPATH] = ("lead", "wood")
    area.labels[WOODPATH] = "the old trail into the Hollow Wood"
    g[BOATHOUSE[1]][BOATHOUSE[0]] = "boathouse"
    area.links[BOATHOUSE] = ("lead", "lake")
    area.labels[BOATHOUSE] = "the boathouse"
    g[KEEPGATE[1]][KEEPGATE[0]] = "keepgate"
    area.links[KEEPGATE] = ("lead", "ruins")
    area.labels[KEEPGATE] = "the gate of Thornwall Keep"
    g[CLOUDSTAIR[1]][CLOUDSTAIR[0]] = "cloudstair" if "known:cloud" in \
        flags else "hill"
    area.links[CLOUDSTAIR] = ("lead", "cloud")
    area.labels[CLOUDSTAIR] = "the cloud stair"
    area.start = (LANE_X[1] + 2, LANE_Y[4])
    return area


