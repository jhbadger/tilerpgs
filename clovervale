def make_folk(world, rng, i, x, y):
    tile = rng.choice(TOWNSFOLK_TILES)
    name = pony_name(rng)
    job, line, extra = rng.choice(JOBS)
    extra = dict(extra)
    if i % 9 == 4:
        tile, job, line, extra = ("folk12", "town watch pony",
                                  "I keep an eye on things. Lately there's "
                                  "a lot of grey to keep an eye on.", {})
    m = Mob(tile, name, x, y)
    m.title = an(job)
    m.greet = rng.choice(GREETINGS)
    r = rng.random()
    if r < 0.45:
        lid = rng.choice(world["leads"])
        news = fill(RUMOURS[lid], world)
    elif r < 0.7:
        news = rng.choice(GLOOM_RUMOURS)
    else:
        news = rng.choice(TIPS)
    m.talk = {"job": line, "news": news}
    m.talk.update(extra)
    m.roam = {"path", "cobble", "grass", "meadow"}
    m.home = (x, y)
    m.night_owl = i < 4
    return m


def cap(s):
    return s[:1].upper() + s[1:]


def an(s):
    vowel = s[:1] in "aeiou" and not s.startswith(("uni", "use", "eu"))
    return ("an " if vowel else "a ") + s


def wrap(text, width):
    out, line = [], ""
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            out.append(line)
            line = "  " + word if text.startswith("  ") else word
        else:
            line = (line + " " + word) if line else word
    if line:
        out.append(line)
    return out


