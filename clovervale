# Things on the floor: their tile, and what stepping on them gives.
FLOOR_ITEMS = {"note", "stone", "snack", "gear", "coins", "trap"}

GRASS = ("#5aae48", "#66bc52", "#4e9e40", "#f0e060", "#f0a0c0", "#ffffff")


def grass(rng):
    g = grid_of(GRASS[0])
    speckle(g, rng, GRASS[1:3], 0.35)
    speckle(g, rng, GRASS[3:], 0.015)
    return g


def dirt(rng):
    g = grid_of("#c8a070")
    speckle(g, rng, ["#d4ae80", "#b89060"], 0.3)
    return g


def oak(rng, under, fruit=None):
    g = under(rng)
    rect(g, 7, 10, 8, 15, "#7a5030")
    rect(g, 6, 14, 9, 15, "#6a4428")
    disc(g, 7.5, 6, 6, "#2e7a2e", rng, 0.6)
    disc(g, 6.5, 5, 4.2, "#3c9a3c", rng, 0.6)
    disc(g, 5.5, 4, 1.8, "#58b850")
    if fruit:
        for _ in range(6):
            x, y = rng.randrange(3, 13), rng.randrange(2, 10)
            if g[y][x] != GRASS[0]:
                g[y][x] = fruit
    return g


def cloud_tile(rng, base, frame=0):
    g = grid_of(base)
    for _ in range(5):
        disc(g, rng.uniform(2, 13), rng.uniform(2, 13), rng.uniform(2.5, 4),
             "#ffffff", rng, 0.5)
    if frame:
        speckle(g, rng, ["#fff8d0"], 0.03)
    return g


def thatch(rng, base):
    g = grid_of(base)
    for y in range(16):
        for x in range(16):
            if (x + (y // 3) * 2) % 3 == 0:
                g[y][x] = shade(base, 0.86)
            elif rng.random() < 0.1:
                g[y][x] = shade(base, 1.1)
        if y % 5 == 4:
            for x in range(16):
                g[y][x] = shade(base, 0.7)
    return g


def draw_terrain(name, frame=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random(name + str(frame))
    if name == "grass":
        return grass(rng)
    if name == "meadow":
        g = grass(rng)
        speckle(g, rng, ["#f0e060", "#f080a0", "#ffffff", "#a080f0"], 0.08)
        return g
    if name == "flowers":
        g = grass(rng)
        for y in range(1, 16, 4):
            for x in range(1 + (y // 4) % 2 * 2, 16, 4):
                c = rng.choice(("#f04060", "#f0e040", "#f080d0", "#8060f0",
                                "#ffffff"))
                rect(g, x, y, x + 1, y + 1, c)
                g[min(15, y + 2)][x] = "#2e7a2e"
        return g
    if name == "path":
        return dirt(rng)
    if name == "cobble":
        g = stone_blocks(rng, "#b8b0a0", "#8a8478", 4, 4)
        return g
    if name == "field":
        g = grid_of("#8a6a3a")
        for y in range(1, 16, 4):
            for x in range(16):
                g[y][x] = "#5aae48" if (x + y) % 3 else "#7ac060"
                g[y + 1][x] = "#4e9e40"
        return g
    if name == "hill":
        g = grid_of("#8ab060")
        speckle(g, rng, ["#7aa050", "#9ac070", "#a8a080"], 0.3)
        return g
    if name == "sand":
        g = grid_of("#e8d8a0")
        speckle(g, rng, ["#f0e0b0", "#d8c890"], 0.3)
        return g
    if name in ("water", "brook"):
        g = grid_of("#3a80c8" if name == "water" else "#4a90d0")
        speckle(g, rng, ["#3474b8", "#4a90d8"], 0.3)
