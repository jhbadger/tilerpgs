    # ── Errands ──

    def give_errand(self, mob):
        for e in self.world["errands"]:
            if e["giver"] == mob.role:
                mob.errand = e


    def release_pets(self, area=None):
        a = area or self.cache.get(("city",))
        if a is None:
            return
        a.mobs = [m for m in a.mobs if m.pet is None]
        for e in self.world["errands"]:
            st = self.side.get(e["id"], {}).get("state")
            if e["kind"] == "pet" and st == "active" and \
                    "pet:" + e["id"] not in self.flags:
                x, y = e["spot"]
                while a.mob_at(x, y):
                    x += 1
                pet = Mob("pet", e["pet"], x, y)
                pet.pet = e
                pet.roam, pet.home = {"path", "grass", "meadow"}, (x, y)
                pet.title = "a %s" % e["beast"]
                a.mobs.append(pet)

    def errand(self, mob):
        e = mob.errand
        st = self.side.get(e["id"])
        if st is None:
            self.side[e["id"]] = {"state": "active"}
            if e["kind"] == "pet":
                self.npc_say(mob, "My %s, %s, got out! Fluffy, about so "
                             "big, comes to %s (sometimes). Last seen in %s. "
                             "Bring %s home, please, please!" % (
                                 e["beast"], e["pet"], e["pet"],
                                 district(*e["spot"]), "it"))
                self.release_pets()
            else:
                who = self.world["people"][e["to"]]
                self.npc_say(mob, "Could you take %s to %s, %s? I'd go, "
                             "but I'm busy being little." % (
                                 e["thing"], who["name"],
                                 fill(who["title"], self.world)))
                self.say("You take %s." % e["thing"], "info")
        elif st["state"] == "done":
            self.npc_say(mob, "Thanks again! You're the best!")
        elif self.errand_ready(e):
            self.finish_errand(mob, e)
        else:
            self.npc_say(mob, "Did you find %s yet?" % e["pet"]
                         if e["kind"] == "pet" else
                         "Did you take %s to %s yet?" % (
                             e["thing"],
                             self.world["people"][e["to"]]["short"]))

    def errand_ready(self, e):
        return (self.side.get(e["id"], {}).get("state") == "active" and
                e["kind"] == "pet" and "pet:" + e["id"] in self.flags)

    def finish_errand(self, mob, e):
        self.side[e["id"]]["state"] = "done"
        self.npc_say(mob, "%s! You found %s! Oh, thank you! Here, take "
                     "this. And you're my friend now. That's the rules." % (
                         e["pet"], "them"))
        self.p["coins"] += e["pay"]
        self.say("You get %d coins." % e["pay"], "gold")
        self.befriended(e["giver"])
        self.gain_fp(1, "for a good deed")
        self.sound.play("gold")

    def deliver(self, mob, e):
        st = self.side.get(e["id"])
        if not st or st["state"] != "active":
            return
        st["state"] = "done"
        self.npc_say(mob, "Is that %s? From %s? How lovely! Here, for your "
                     "trouble." % (e["thing"],
                                   self.world["people"][e["giver"]]["short"]))
        self.p["coins"] += e["pay"]
        self.say("You get %d coins." % e["pay"], "gold")
        self.befriended(e["giver"])
        self.gain_fp(1, "for a good deed")

    def catch_pet(self, mob):
        e = mob.pet
        if self.ok(("Animal Handling", "Finesse"), 10, label="catching"):
            self.area.mobs.remove(mob)
            self.flags.add("pet:" + e["id"])
            self.say("You scoop up %s, who wriggles, and then snuggles." %
                     e["pet"], "good")
            self.sound.play("gold")
        else:
            self.say("%s slips out from under your hooves!" % e["pet"],
                     "info")
            for _ in range(3):
                self.wander(mob)
        self.end_turn()

