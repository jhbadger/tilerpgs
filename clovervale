ICON_NAME = "clovervale"


def icon_mix(a, b, t):
    t = min(max(t, 0.0), 1.0)
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def icon_heart(u, v):
    """Inside the unit heart, tip at v=-1.2 or so, lobes up."""
    a = u * u + v * v - 1
    return a * a * a - u * u * v * v * v <= 0


def icon_art(x, y):
    cx, cy = 0.5, 0.44
    hill = 0.84 - 0.05 * math.cos((x - 0.3) * 5)
    dx, dy = x - cx, y - cy
    for k in range(4):
        ang = k * math.pi / 2 + math.pi / 4
        # local frame: out = along the leaf, side = across it
        ox, oy = math.cos(ang), math.sin(ang)
        out = dx * ox + dy * oy
        side = -dx * oy + dy * ox
        u, v = side / 0.12, (out - 0.135) / 0.12
        if icon_heart(u, v):
            if abs(side) < 0.008 and out < 0.2:
                return (80, 170, 80)              # midrib
            shade = 0.25 + 0.5 * (out / 0.26)
            return icon_mix((120, 214, 110), (54, 150, 64), shade)
    # stem
    down = y - cy
    if 0 < down < 0.46 and abs(x - (cx + 0.12 * down + 0.5 * down * down)
                               ) < 0.022:
        return (52, 128, 60)
    # a lucky golden horseshoe, open end up, on the hill
    hx, hy = x - 0.22, y - 0.80
    d = math.hypot(hx, hy)
    if 0.045 <= d <= 0.085 and not (hy < 0 and abs(hx) < -hy * 0.75):
        for a in (0.9, 1.6, 2.34, 3.04):                  # nail holes
            if math.hypot(hx - 0.065 * math.cos(a),
                          hy - 0.065 * math.sin(a)) < 0.009:
                return (150, 100, 30)
        return icon_mix((255, 214, 90), (210, 150, 40), (hy + 0.08) / 0.16)
    if y > hill:
        return icon_mix((136, 206, 120), (84, 160, 86), (y - hill) / 0.15)
    sky = icon_mix((150, 200, 250), (250, 190, 220), y / 0.84)
    for sx, sy, s in ((0.15, 0.14, 0.05), (0.84, 0.2, 0.04),
                       (0.78, 0.66, 0.035), (0.18, 0.64, 0.03)):
        ax, ay = abs(x - sx), abs(y - sy)
        if ax * ay < s * s * 0.03 and ax + ay < s:
            return (255, 250, 230)                # sparkles
    glow = max(0.0, 1 - math.hypot(dx, dy) / 0.42)
    return icon_mix(sky, (255, 236, 150), glow * 0.8)


def icon_rr(x, y, x0, y0, x1, y1, r):
    """True inside the rounded rectangle (x0,y0)-(x1,y1) with corner radius r."""
    cx = min(max(x, x0 + r), x1 - r)
    cy = min(max(y, y0 + r), y1 - r)
    return math.hypot(x - cx, y - cy) <= r


def icon_sample(x, y):
    """RGB of the icon at (x, y) in the unit square, or None (transparent)."""
    if not icon_rr(x, y, 0.0, 0.0, 1.0, 1.0, 0.2):
        return None
    return icon_art(x, y)


def icon_render_png(size):
    n = 4 if size <= 256 else 2
    rows = []
    for py in range(size):
        row = bytearray([0])                     # PNG filter type 0
        for px in range(size):
            ra = ga = ba = aa = 0
            for sy in range(n):
                for sx in range(n):
                    c = icon_sample((px + (sx + 0.5) / n) / size,
                                    (py + (sy + 0.5) / n) / size)
                    if c:
                        ra += c[0]
                        ga += c[1]
                        ba += c[2]
                        aa += 1
            if aa:
                row += bytes((ra // aa, ga // aa, ba // aa,
                              255 * aa // (n * n)))
            else:
                row += b"\0\0\0\0"
        rows.append(bytes(row))

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
    return (b"\x89PNG\r\n\x1a\n" +
            chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 6, 0, 0, 0)) +
            chunk(b"IDAT", zlib.compress(b"".join(rows), 9)) +
            chunk(b"IEND", b""))


# ICNS entry types holding PNG data, with the pixel size of each
ICON_ICNS_TYPES = [(b"icp4", 16), (b"icp5", 32), (b"ic11", 32), (b"ic12", 64),
                   (b"ic07", 128), (b"ic13", 256), (b"ic08", 256),
                   (b"ic14", 512), (b"ic09", 512)]


def icon_make_icns():
    """An .icns file written directly (no iconutil needed)."""
    pngs = {}
    body = b""
    for tag, size in ICON_ICNS_TYPES:
        if size not in pngs:
            pngs[size] = icon_render_png(size)
        body += tag + struct.pack(">I", len(pngs[size]) + 8) + pngs[size]
    return b"icns" + struct.pack(">I", len(body) + 8) + body


def icon_build_app(dest):
    """Build a macOS <name>.app bundle (with icon) in dest."""
    app = os.path.join(dest, ICON_NAME + ".app")
    if os.path.exists(app):
        shutil.rmtree(app)
    macos = os.path.join(app, "Contents", "MacOS")
    res = os.path.join(app, "Contents", "Resources")
    os.makedirs(macos)
    os.makedirs(res)
    shutil.copy(os.path.abspath(__file__), os.path.join(res, ICON_NAME + ".py"))
    launcher = os.path.join(macos, ICON_NAME)
    with open(launcher, "w") as fh:
        fh.write('#!/bin/sh\nexec "%s" "$(dirname "$0")/../Resources/%s.py" '
                 '"$@"\n' % (sys.executable, ICON_NAME))
    os.chmod(launcher, 0o755)
    with open(os.path.join(res, ICON_NAME + ".icns"), "wb") as fh:
        fh.write(icon_make_icns())
    info = {
        "CFBundleName": ICON_NAME,
        "CFBundleDisplayName": ICON_NAME,
        "CFBundleIdentifier": "org.badgerjh." + ICON_NAME,
        "CFBundleExecutable": ICON_NAME,
        "CFBundleIconFile": ICON_NAME,
        "CFBundlePackageType": "APPL",
        "CFBundleShortVersionString": "1.0",
        "NSHighResolutionCapable": True,
    }
    with open(os.path.join(app, "Contents", "Info.plist"), "wb") as fh:
        plistlib.dump(info, fh)
    return app


def icon_args(args):
    """Handle --build-app [DIR] and --icon-png SIZE [OUT]; True if handled."""
    if args[:1] == ["--build-app"]:
        print(icon_build_app(args[1] if len(args) > 1 else
                             os.path.dirname(os.path.abspath(__file__))))
        return True
    if args[:1] == ["--icon-png"] and len(args) >= 2:
        with open(args[2] if len(args) > 2 else ICON_NAME + ".png", "wb") as fh:
            fh.write(icon_render_png(int(args[1])))
        return True
    return False


def set_window_icon(root):
    try:
        root._icon = tk.PhotoImage(data=ICON_PNG)
        root.iconphoto(True, root._icon)
    except tk.TclError:
        pass


