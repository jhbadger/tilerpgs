def selftest():
    """Build every map and tune of a few weeks, without a window."""
    for seed in range(6):
        w = generate_world(seed)
        flags = set()
        for city in (make_city(w, flags), make_city(w, {"known:cloud"})):
            doors = [p for p, l in city.links.items() if l[0] == "bld"]
            assert len(doors) == len(SITES) + len(BIG_SITES), doors
            for (x, y), l in city.links.items():
                assert city.grid[y][x] in ("door", "mineshaft", "woodpath",
                                           "cloudstair", "boathouse",
                                           "keepgate", "hill"), (
                    x, y, city.grid[y][x])
                if l[0] == "bld":
                    assert city.grid[y + 1][x] in CITY_GROUND, (l, x, y)
                else:
                    assert any(city.grid[y + dy][x + dx] in CITY_GROUND
                               for dx, dy in DIRS), (l, x, y)
            seen, q = {city.start}, deque([city.start])
            while q:
                x, y = q.popleft()
                for dx, dy in DIRS:
                    n = (x + dx, y + dy)
                    if city.inside(*n) and n not in seen and \
                            city.grid[n[1]][n[0]] in WALKABLE:
                        seen.add(n)
                        if city.grid[n[1]][n[0]] in CITY_GROUND:
                            q.append(n)
            for pos, l in city.links.items():
                if city.grid[pos[1]][pos[0]] != "hill":
                    assert pos in seen, ("unreachable", l, pos)
        for sid in list(SITES) + list(BIG_SITES):
            a = make_interior(w, sid)
            assert all(len(r) == a.w for r in a.grid), sid
            assert a.grid[a.start[1]][a.start[0]] in INSIDE_FLOOR, sid
            for m in a.mobs:
                fill(m.greet, w)
                for v in m.talk.values():
                    for s in ([v] if isinstance(v, str) else
                              [x for x in v.values()
                               if isinstance(x, str)]):
                        fill(s, w)
        for lid, info in LEADS.items():
            for level in range(1, info.levels + 1):
                a = make_dungeon(w, lid, level, flags)
                assert a.grid[a.start[1]][a.start[0]] == "stairs_up"
                seen, q = {a.start}, deque([a.start])
                while q:
                    x, y = q.popleft()
                    for dx, dy in DIRS:
                        n = (x + dx, y + dy)
                        if n not in seen and a.grid[n[1]][n[0]] in (
                                DUNGEON_FLOOR | {"gate"}):
                            seen.add(n)
                            q.append(n)
                if a.down:
                    assert a.down in seen, (lid, level)
                if level == info.levels:
                    assert any((m.x, m.y) in seen for m in a.mobs if m.boss)
        for text in list(RUMOURS.values()) + [v[1] for v in
                                              RESEARCH.values()]:
            fill(text, w)
        for cid, text in CLUES.items():
            fill(text, w)
        for role in ROLE_TALK:
            assert role in ROLES, role
    for o in ORIGINS:
        for c in CALLINGS:
            for h in HEARTS:
                p = Game.make_pony({"name": "Test", "sex": "F", "origin": o,
                                    "calling": c, "heart": h, "look": 0,
                                    "base": {e: 3 for e in ESSENCES}})
                for e in ESSENCES:
                    assert sum(n for s, n in p["skills"].items()
                               if SKILL_ESSENCE[s] == e and
                               s != "Spellcasting") <= p["ess"][e], (o, c, h)
                assert p["health"] >= 2
    for name, tune in MUSIC.items():
        steps = len(tune["melody"].replace("|", " ").split())
        assert steps == len(tune["chords"].split()) * tune["bar"], name
    tiles = all_tiles()
    clash = set(TERRAIN) & (set(PEOPLE) | set(ART))
    assert not clash, clash
    for name in list(TILE_NEEDED):
        assert name in tiles, name
    for kind, m in MONSTERS.items():
        assert m.soothe in SKILL_HELP, kind
        assert kind in TAMED_TALK or m.soothe in TAMED_TALK, kind
    print("ok")


