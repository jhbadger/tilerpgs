    def reset_view(self):
        self.overlay = None
        self.overlay_text = None
        self.end_talk()
        self.busy = False
        self.aim = None
        self.menu = None
        self.walking = None

    def restore(self, g):
        self.setup_world(int(g["seed"]))
        p = g["player"]
        for k in ("name", "origin", "calling", "heart", "ess", "skills",
                  "health", "items", "on", "spells"):
            if k not in p:
                raise ValueError("bad pony")
        if p["origin"] not in ORIGINS or p["calling"] not in CALLINGS or \
                p["heart"] not in HEARTS or p["look"] not in range(4):
            raise ValueError("bad pony")
        self.p = p
        self.flags = set(g.get("flags", []))
        self.clues = list(g.get("clues", []))
        self.topics = set(g.get("topics", []))
        self.stones = list(g.get("stones", []))
        self.returned = list(g.get("returned", []))
        self.side = {str(k): dict(v) for k, v in g.get("side", {}).items()}
        self.turn = int(g.get("turn", 0))
        self.city = None
        self.reset_view()
        city = self.get_area(("city",))
        city.seen = unpack_bits(g["seen"], CITY_W * CITY_H)
        self.city_pos = g.get("city_pos")
        self.surface = g.get("surface")
        if self.surface:
            self.surface = (tuple(self.surface[0]), self.surface[1])
        key = tuple(g["key"])
        self.area = self.get_area(key)
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        if not self.can_stand(*self.pos):
            self.pos = list(self.area.start)
        p["out"] = p["held"] = 0
        self.say("Clover Vale, %s." % self.date_text(), "quest")
        self.say("Welcome back, %s. Press ? for help." % p["name"], "info")
        self.layout()
        if "won" in self.flags:
            self.show_won()
        elif self.turn >= DEADLINE:
            self.doom()

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "scale": self.scale}
        if getattr(self, "p", None) and getattr(self, "area", None):
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "clues": self.clues,
                "topics": sorted(self.topics), "stones": self.stones,
                "returned": self.returned, "side": self.side,
                "turn": self.turn, "key": list(self.area.key),
                "pos": self.pos, "city_pos": self.city_pos,
                "surface": [list(self.surface[0]), self.surface[1]]
                if getattr(self, "surface", None) else None,
                "seen": pack_bits(self.get_area(("city",)).seen)}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.root.destroy()


    # ── Areas ──

    def get_area(self, key):
        if key in self.cache:
            return self.cache[key]
        w = self.world
        if key[0] == "city":
            area = make_city(w, self.flags)
            self.populate_city(area)
            area.lit = {(x + dx, y + dy) for y in range(area.h)
                        for x in range(area.w) if area.grid[y][x] == "lamp"
                        for dx in range(-2, 3) for dy in range(-2, 3)
                        if abs(dx) + abs(dy) <= 3}
        elif key[0] == "bld":
            if key[1] not in SITES and key[1] not in BIG_SITES:
                raise ValueError("bad site")
            area = make_interior(w, key[1])
            for m in area.mobs:
                self.give_errand(m)
            if key[1] == "hall":
                self.dress_hall(area)
            if self.unmasked() and any(m.leader for m in area.mobs):
                area.mobs = [m for m in area.mobs if not m.leader]
        elif key[0] == "dun":
            lid, level = key[1], int(key[2])
            if lid not in LEADS or not 1 <= level <= LEADS[lid].levels:
                raise ValueError("bad level")
            area = make_dungeon(w, lid, level, self.flags)
            key = area.key
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        return area

    def unmasked(self):
        return "unmasked" in self.flags

    def populate_city(self, area):
        """Townsponies, the ponies at the edges of town, and runaway
        pets."""
        rng = random.Random("%s:folk" % self.world["seed"])
        lanes = [(x, y) for y in range(area.h) for x in range(area.w)
                 if area.grid[y][x] in ("path", "cobble")
                 and 12 <= y <= 44 and 12 <= x <= 52]
        area.folk = []
        doorsteps = {(x + dx, y + dy) for x, y in area.links
                     for dx, dy in DIRS}
        lanes = [s for s in lanes if s not in doorsteps]
        for i in range(24):
            x, y = rng.choice(lanes)
            if area.mob_at(x, y):
                continue
            m = make_folk(self.world, rng, i, x, y)
            area.folk.append(m)
        out = []
        for role, (x, y), roam in (
                ("foreman", (MINE[0] + 1, MINE[1] + 3), None),
                ("woodward", (WOODPATH[0] + 3, WOODPATH[1] - 1), None),
                ("captain", (CLOUDSTAIR[0] + 1, CLOUDSTAIR[1] + 4),
                 {"hill", "grass", "meadow"}),
                ("flyerkid", (CLOUDSTAIR[0] - 3, CLOUDSTAIR[1] + 6),
                 {"hill", "grass", "meadow"}),
                ("ferry", (BOATHOUSE[0] - 1, BOATHOUSE[1] - 1), None),
                ("seller", (30, 22), None)):
            m = make_person(self.world, role, x, y)
            if roam:
                m.roam, m.home = roam, (x, y)
            out.append(m)
        area.mobs = list(area.folk) + out
        if self.unmasked():
            area.mobs = [m for m in area.mobs if not m.leader]
        for m in area.mobs:
            self.give_errand(m)
        self.release_pets(area)

    def dress_hall(self, area):
        """Saturday night: Lantern Night, and the Great Lantern."""
        if "won" in self.flags:
            for row in area.grid:
                for x, t in enumerate(row):
                    if t == "lantern_dark":
                        row[x] = "lantern_lit"
        if self.turn < LANTERN:
            return
        spots = [(x, y) for y in range(4, 7) for x in range(2, area.w - 2)
                 if area.grid[y][x] == "floor" and not area.mob_at(x, y)]
        rng = random.Random(self.turn // 60)
        rng.shuffle(spots)
        for i in range(7):
            if not spots:
                break
            x, y = spots.pop()
            m = make_folk(self.world, rng, 100 + i, x, y)
            m.roam = {"floor"}
            m.home = (x, y)
            m.crowd = True
            area.mobs.append(m)
        for role in ("thistlewick", "baker", "teacher", "farmkid"):
            if spots and not (role == self.world["agent"] and
                              self.unmasked()):
                x, y = spots.pop()
                m = make_person(self.world, role, x, y)
                m.crowd = True
                area.mobs.append(m)

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        if area.kind == "city":
            self.night_and_day()
        self.sound.play(sound)
        self.layout()
        self.save()

    def go_outside(self):
        """Out of a building, onto its doorstep."""
        a = self.area
        if a.site == "hall" and any(m.kind == "wyrm" for m in a.mobs):
            self.say("The doors are sealed with grey fog. You'll have to "
                     "deal with the Wyrm first!", "bad")
            return
        city = self.get_area(("city",))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.enter(city, self.city_pos or city.start)
        self.say("You step out into %s." % district(*self.pos), "info")

    def enter_link(self, link, x, y):
        kind, what = link
        if kind == "bld":
            self.p["flying"] = self.p["flying"] and "Wings" in self.p["on"]
            self.city_pos = list(self.pos)
            if what == "hall":
                self.cache.pop(("bld", "hall"), None)
            area = self.get_area(("bld", what))
            self.flags.add("been:" + what)
            self.say("You go into %s." % area.name, "info")
            self.enter(area, area.start)
            if what == "hall":
                self.hall_arrival()
            return
        self.at_lead(what, x, y)

    def descend(self, lid):
        if self.area.kind == "city":
            self.city_pos = list(self.pos)
        self.surface = (self.area.key, list(self.pos))
        area = self.get_area(("dun", lid, 1))
        self.say("You go into %s." % fill(LEADS[lid].name, self.world),
                 "info")
        self.enter(area, area.start, "stairs")

    def change_level(self, delta):
        _, lid, level = self.area.key
        if level + delta == 0:
            key, pos = self.surface
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dun"}
            area = self.get_area(tuple(key))
            self.say("You climb back out, blinking, into the daylight (or "
                     "whatever it is up here now).", "info")
            self.enter(area, pos, "stairs")
            return
        area = self.get_area(("dun", lid, level + delta))
        self.say("You go %s to level %d." % (
            "down" if delta > 0 else "up", level + delta), "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        n = int(self.log.index("end").split(".")[0])
        if n > 600:
            self.log.delete("1.0", "%d.0" % (n - 500))
        self.log.config(state="disabled")
        self.log.see("end")

    @staticmethod
    def the(mob):
        return mob.name if mob.boss or mob.role or mob.name[0].isupper() \
            else "the " + mob.name

    # ── Numbers ──

    def max_health(self):
        return self.health_of(self.p)

    def defense(self, essence):
        p = self.p
        return 10 + p["ess"][essence] + (
            2 if "Shield" in p["on"] and essence in ("Strength", "Speed")
            else 0)

    def companion_here(self):
        return bool(self.p.get("companion")) and any(
            m.ally for m in self.area.mobs)

    def shifts(self, skill, ctx=None):
        """The upshifts (and downshifts) that come with you: how many, and
        why."""
        p = self.p
        n, why = 0, []

        def add(k, w):
            nonlocal n
            n += k
            why.append(w)
        if skill == CALLINGS[p["calling"]]["skills"][0]:
            add(1, "heartmark")
        if (p["origin"], skill) in (("Pegasus", "Acrobatics"),
                                    ("Meadow pony", "Survival")):
            add(1, p["origin"].split()[0].lower())
        if skill == {"Honesty": "Alertness", "Laughter": "Performance",
                     "Wonder": "Spellcasting"}.get(p["heart"]):
            add(1, p["heart"].lower())
        if p["heart"] == "Kindness" and ctx in ("befriend", "heal"):
            add(1, "kindness")
        if skill == "Technology" and p["items"].get("toolkit"):
            add(1, "toolkit")
        if skill == "Athletics" and p["items"].get("rope"):
            add(1, "rope")
        if "Knack" in p["on"]:
            add(1, "knack")
        if ctx == "befriend" and "Kindred" in p["on"]:
            add(2, "kindred tongue")
        if self.companion_here():
            add(2 if p["heart"] == "Loyalty" else 1, "a friend's help")
        if self.tired() and SKILL_ESSENCE[skill] in ("Smarts", "Social") \
                and skill != "Spellcasting":
            add(-1, "tired")
        return n, why

    @staticmethod
    def roll_rank(rank):
        """The Skill dice of a rank, rolled: (total, whether one came up
        its highest)."""
        if rank <= 0:
            return 0, False
        rolls = [(random.randint(1, s), s) for s in
                 RANK_DICE[min(rank, AUTO_RANK - 1)]]
        return sum(v for v, _ in rolls), any(v == s for v, s in rolls)

    def test(self, skills, dif, label=None, shift=0, edge=0, ctx=None,
             quiet=False, rank=None):
        """A Skill Test: a d20 plus the best of the Skills' dice (after
        shifts) against a Difficulty.  Returns how much you made it by (zero
        or more) or missed it by (less than zero); self.crit says whether it
        was a Critical Success."""
        if isinstance(skills, str):
            skills = (skills,)
        p = self.p

        def base(s):
            return p["skills"].get(s, 0) if rank is None else rank
        best = max(skills, key=lambda s: base(s) + self.shifts(s, ctx)[0] +
                   (0.5 if s in p["specs"] else 0))
        r = base(best)
        sh, why = self.shifts(best, ctx)
        sh += shift
        trained = r > 0 or rank is not None
        if "Edge" in p["on"]:
            edge += 1
        if not trained:
            edge -= 1
        e = r + sh if trained else max(0, sh)
        d20 = random.randint(1, 20)
        if edge:
            other = random.randint(1, 20)
            d20 = max(d20, other) if edge > 0 else min(d20, other)
        crit = False
        if e >= AUTO_RANK:
            sk, total = 0, max(dif, d20)
        elif best in p["specs"] and rank is None and e <= 6:
            rolls = [(random.randint(1, RANK_DICE[k][0]), RANK_DICE[k][0])
                     for k in range(1, e + 1)]
            sk = max(v for v, _ in rolls) if rolls else 0
            crit = any(v == s for v, s in rolls)
            total = d20 + sk
        else:
            sk, crit = self.roll_rank(e)
            total = d20 + sk
        margin = total - dif
        self.crit = crit and margin >= 0
        if not quiet:
            what = "%s %s" % (best, die_name(e) if e > 0 else "no die")
            if best in p["specs"] and rank is None:
                what += " (specialized)"
            if sh:
                what += " (%s%d: %s)" % ("+" if sh > 0 else "", sh,
                                         ", ".join(why + (["help"] if shift
                                                          else [])))
            if edge:
                what += ", %s" % ("Edge" if edge > 0 else "Snag")
            if not trained:
                what += ", untrained"
            self.say("[%s%s: d20 %d + %d = %d vs %d: %s]" % (
                label + ", " if label else "", what, d20, sk, total, dif,
                "CRITICAL!" if self.crit else "success" if margin >= 0
                else "fumble!" if d20 == 1 else "no good"), "roll")
        if d20 == 1 and margin < 0:
            self.gain_fp(1, "for a glorious fumble")
        return margin

    def ok(self, *a, **kw):
        return self.test(*a, **kw) >= 0

    def gain_fp(self, n, why):
        self.p["fp"] += n
        self.p["fp_total"] += n
        self.say("+%d Friendship Point%s, %s." % (n, "s" if n > 1 else "",
                                                  why), "gold")

    def tired(self):
        return self.turn - self.p["slept"] > 18 * 60

    # ── Time ──

    def now(self):
        return START + datetime.timedelta(minutes=self.turn)

    def day_no(self):
        return (self.now() - START.replace(hour=0)).days

    def date_text(self):
        t = self.now()
        return "%s %d:%02d %s" % (
            t.strftime("%a"), (t.hour - 1) % 12 + 1, t.minute,
            "am" if t.hour < 12 else "pm")

    def phase(self):
        h = self.now().hour
        return ("night" if h >= 21 or h < 5 else "dawn" if h < 7 else
                "dusk" if h >= 19 else "day")


    def pass_time(self, minutes, quiet=False):
        """Time going by in a lump: research, sleep."""
        before = self.phase()
        for _ in range(minutes // 30):
            self.turn += 30
            self.daily()
            if self.overlay:
                return
        self.turn += minutes % 30
        if not quiet and self.phase() != before:
            self.say("It's %s now: %s." % (self.phase(), self.date_text()),
                     "info")
        self.night_and_day()
        if self.turn >= DEADLINE and "won" not in self.flags:
            self.doom()

    def daily(self):
        if self.now().hour == 6 and "morning:%d" % self.day_no() not in \
                self.flags:
            self.flags.add("morning:%d" % self.day_no())
            self.morning()

    def morning(self):
        """A new day: your friends' good wishes come back."""
        p = self.p
        if p["fp"] < 3:
            p["fp"] = 3
            self.say("A new day! Your friends' good wishes are with you. "
                     "(Friendship Points back up to 3.)", "gold")
        if self.now().weekday() == 5:
            self.say("Saturday! Lantern Night is tonight, at sunset.",
                     "quest")

    def night_and_day(self):
        """At night most townsfolk go home; they come out in the morning."""
        city = self.cache.get(("city",))
        if not city:
            return
        night = self.phase() == "night"
        here = getattr(self, "area", None)
        folk = [m for m in city.folk if not night or m.night_owl]
        city.mobs = [m for m in city.mobs if m not in city.folk or m in folk]
        for m in folk:
            if m not in city.mobs and not city.mob_at(m.x, m.y):
                city.mobs.append(m)
        if not night:
            px, py = self.pos if here is city else (-99, -99)
            city.mobs = [m for m in city.mobs if not m.hostile or m.boss
                         or abs(m.x - px) + abs(m.y - py) <= 6]


    # ── Turns ──

    def on_key(self, ev):
        if self.talk or self.busy or ev.state & 0x0C:
            return
        k = ev.keysym
        self.walking = None
        if self.menu:
            k = k[3:] if k.startswith("KP_") else k
            if k in ("Up", "w", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "space", "KP_Enter"):
                self.menu_pick()
            elif k.isdigit() and 1 <= int(k) <= len(self.menu["items"]):
                self.menu_pick(int(k) - 1)
            else:
                self.menu_cancel()
            return
        if self.overlay:
            if self.overlay in ("won", "doom") and k in ("n", "N"):
                self.new_game()
            elif self.overlay not in ("won", "doom") or k in ("Escape",
                                                              "Return"):
                self.close_overlay()
            return
        if self.aim:
            if k in MOVE_KEYS:
                self.aimed(*MOVE_KEYS[k])
            else:
                self.aim = None
                self.say("Never mind.", "info")
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("e", "E"):
            self.search()
        elif k in ("f", "F"):
            self.ready_throw()
        elif k in ("t", "T"):
            self.ready_befriend()
        elif k in ("c", "C"):
            self.choose_power()
        elif k in ("u", "U"):
            self.use_menu()
        elif k in ("space", "period", "KP_5"):
            self.wait()
        elif k in ("i", "I"):
            self.show_sheet()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def close_overlay(self):
        if self.overlay in ("won", "doom"):
            self.action_menu()
            return
        self.overlay = None
        self.render()

    def ready(self):
        return not (self.busy or self.talk or self.overlay or self.menu)


    def steps(self):
        """How many squares a step takes you."""
        return 2 if self.p["flying"] and self.area.kind == "city" else 1

    def can_stand(self, x, y):
        """Whether you can be on a square, the way you're going now."""
        a, p = self.area, self.p
        t = a.grid[y][x]
        if p["flying"] and a.kind == "city":
            return t in WALKABLE or t in WATER or t in FLY_OVER
        return t in WALKABLE

    def move(self, dx, dy):
        if not self.ready():
            return
        p = self.p
        fr = p["freak"]
        if fr and fr["kind"] == "run" and random.random() < 0.5:
            dx, dy = random.choice(DIRS)
            self.say("Eeeeek! Your hooves gallop off without you!", "mad")
        if p["held"]:
            p["held"] -= 1
            self.say("You're held fast! You wriggle." if p.get("held_by")
                     else "You pull yourself together.", "bad")
            self.end_turn()
            return
        moved = False
        for i in range(self.steps()):
            r = self.step(dx, dy, first=i == 0)
            if r == "moved":
                moved = True
                continue
            if r == "done":
                return
            if r == "turn":
                moved = True
            break
        if moved:
            slow = self.area.kind == "dungeon" and self.underfoot(*self.pos)
            self.end_turn()
            if slow and not self.busy and not self.overlay:
                self.end_turn()

    TOUCHABLE = {"shelf", "case", "bed", "desk", "oven", "fireplace",
                 "barrel", "plant", "rack", "toys", "scope", "lantern_dark",
                 "lantern_lit", "window", "fountain", "well", "gate",
                 "crate", "cottage", "cottage2", "cottage3", "timber",
                 "stonewall", "hall", "tower", "belltower", "ruin", "rock",
                 "orchard", "tree", "pine", "haybale", "table", "hedge",
                 "fence", "reeds", "lamp", "counter"}

    def step(self, dx, dy, first=True):
        """One square: "moved", "turn" (something took the turn), "done"
        (handled, the turn's over or wasn't spent) or "blocked"."""
        a = self.area
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if not first:
                return "blocked"
            if a.kind == "inside":
                self.go_outside()
            elif a.kind == "city":
                side = ("n" if y < 0 else "s" if y >= a.h else
                        "w" if x < 0 else "e")
                self.say(EDGE_ROADS[side] + " Not this week, though. This "
                         "week it's Lantern Night.", "info")
                self.sound.play("bump")
            else:
                self.bump()
            return "done"
        mob = a.mob_at(x, y)
        if mob:
            if not first:
                return "blocked"
            if mob.hostile:
                if self.p["freak"] and self.p["freak"]["kind"] == "run":
                    self.say("You can't make yourself go near it!", "mad")
                    self.end_turn()
                    return "done"
                self.attack(mob)
                self.end_turn()
            elif mob.pet is not None:
                self.catch_pet(mob)
            elif mob.ally or mob.tamed or mob.crowd:
                if mob.tamed and random.random() < 0.25:
                    self.npc_say(mob, mob.greet)
                elif mob.crowd and random.random() < 0.25:
                    self.say("You squeeze past %s. 'Ooh, excuse me!'" %
                             mob.title, "info")
                mob.x, mob.y, self.pos = self.pos[0], self.pos[1], [x, y]
                return "moved"
            else:
                self.start_talk(mob)
            return "done"
        t = a.grid[y][x]
        if t == "counter" and first:
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return "done"
        link = a.links.get((x, y))
        if link and t in ("door", "mineshaft", "woodpath", "cloudstair",
                          "boathouse", "keepgate", "hatch"):
            if not first:
                return "blocked"
            self.enter_link(link, x, y)
            return "done"
        if (x, y) in a.signs or t == "sign_n":
            if first:
                self.say("A signpost. " + EDGE_ROADS[a.signs.get((x, y),
                                                                 "n")],
                         "info")
            return "done" if first else "blocked"
        if t in self.TOUCHABLE and not self.can_stand(x, y):
            if first:
                self.touch(t, x, y)
                return "done"
            return "blocked"
        if a.kind == "city" and t in WATER and not self.can_stand(x, y):
            if first:
                self.say("%s: cool, wet and deep. You'd need wings to cross "
                         "it, or a bridge." % cap(district(x, y)), "info")
                self.sound.play("bump")
                return "done"
            return "blocked"
        if not self.can_stand(x, y):
            if first:
                self.bump()
                return "done"
            return "blocked"
        self.pos = [x, y]
        if t == "exit":
            self.go_outside()
            return "done"
        if t == "stairs_down":
            self.change_level(1)
            return "done"
        if t == "stairs_up":
            self.change_level(-1)
            return "done"
        if self.step_on(x, y):
            return "turn"
        return "moved"

    def bump(self):
        self.say("Blocked.", "info")
        self.sound.play("bump")


    def underfoot(self, x, y):
        """Slippery mud and the hazards below; True if it's slow going."""
        a, p = self.area, self.p
        if p["flying"]:
            return False
        if (x, y) in a.traps:
            a.traps.discard((x, y))
            a.items[(x, y)] = "trap"
            if self.ok("Acrobatics", 12, label="keeping your hooves"):
                self.say("A slick of mud! You skid, wobble, and stay up.",
                         "good")
            else:
                self.say("A slick of mud! Your hooves go one way and you go "
                         "the other.", "bad")
                self.flash(x, y)
                self.hurt(1, "Splat")
                for m in a.mobs:
                    if m.hostile and abs(m.x - x) + abs(m.y - y) <= 10:
                        m.aware = True
        t = a.grid[y][x]
        if t == "thorns":
            if not self.ok("Conditioning", 10, quiet=True):
                self.hurt(1, "Thorns! Ow, ow, ow")
            return True
        if t == "gap":
            if p["origin"] == "Pegasus":
                return False
            if p["items"].get("cloud boots") or "Wings" in p["on"]:
                self.say("The cloud's thin here, but your %s hold you up." %
                         ("cloud boots" if p["items"].get("cloud boots")
                          else "wings"), "info")
                return False
            self.say("The cloud's too thin here! You fall right through... "
                     "and land, WHUMP, back where you came in.", "bad")
            self.pos = list(a.start)
            self.hurt(1, "Oof")
            return False
        if t == "deep":
            if p["items"].get("bubble charm"):
                self.say("You wade into the deep water, breathing bubbles.",
                         "info")
            elif not self.ok("Athletics", 12, quiet=True):
                self.hurt(1, "You swallow half the pond")
            else:
                self.say("You swim through the deep water.", "info")
            return True
        if t == "spring":
            spots = [(sx, sy) for sx, sy in self.floor_spots(a)
                     if abs(sx - x) + abs(sy - y) > 4 and not a.mob_at(sx, sy)]
            if spots:
                self.pos = list(random.choice(spots))
                self.say("BOING! A loose spring flings you across the "
                         "attic.", "mad")
            return False
        if t == "mist":
            if p["heart"] == "Laughter" or self.ok("Performance", 10,
                                                   quiet=True):
                self.say("Grey mist curls round your hooves. You hum a "
                         "silly tune at it, and it backs off.", "info")
            else:
                p["held"] = 1
                p["held_by"] = False
                self.say("Grey mist settles on you. Everything seems so... "
                         "pointless. You just stand there a moment.", "mad")
            return False
        if t == "rubble":
            self.say("You pick your way over the rubble.", "info")
            return True
        if t == "mud":
            self.say("Squelch.", "info")
            return True
        return False

    @staticmethod
    def floor_spots(a):
        if not hasattr(a, "floor_cache"):
            a.floor_cache = [(x, y) for y in range(a.h) for x in range(a.w)
                             if a.grid[y][x] == "dfloor"]
        return a.floor_cache


    def end_turn(self):
        p, a = self.p, self.area
        before = self.phase()
        self.turn += 1
        now = self.phase()
        if now != before:
            if a.kind == "city":
                self.say({"dawn": "The sun comes up over Pebble Hill.",
                          "day": "Another lovely day in Clover Vale.",
                          "dusk": "The sun goes down behind the Hollow Wood. "
                                  "The lantern posts flicker on.",
                          "night": "Night. The valley goes quiet, and the "
                                   "gloomlings come out."}[now], "info")
            self.night_and_day()
        if self.turn % 30 == 0:
            self.daily()
            if self.overlay:
                return
        if self.turn % 60 == 0 and p["health"] < self.max_health() and \
                not p["out"]:
            p["health"] += 1
        if p["sc"] < p["skills"].get("Spellcasting", 0):
            p["sc"] += 1
        for k in list(p["on"]):
            p["on"][k] -= 1
            if p["on"][k] <= 0:
                del p["on"][k]
                self.power_ends(k)
        fr = p["freak"]
        if fr:
            fr["turns"] -= 1
            if fr["turns"] <= 0:
                self.end_freak()
        if self.turn >= DEADLINE and "won" not in self.flags:
            self.doom()
            return
        if a.kind == "dungeon":
            px, py = self.pos
            for tx, ty in list(a.traps):
                if abs(tx - px) + abs(ty - py) <= 1 and random.random() < \
                        0.15 + 0.04 * p["skills"].get("Alertness", 0):
                    a.traps.discard((tx, ty))
                    a.items[(tx, ty)] = "trap"
                    self.say("You spot a slick of mud on the floor. Nearly!",
                             "info")
        self.render()
        self.first_sight()
        for mob in list(a.mobs):
            if self.overlay:
                return
            if mob not in a.mobs or self.area is not a:
                continue
            if mob.ally:
                self.ally_act(mob)
            elif mob.hostile:
                self.monster_act(mob)
                if p["health"] <= 0 and not p["out"]:
                    self.defeated()
                    return
            else:
                self.wander(mob)
        if a.kind == "city":
            self.spawn_city()
        self.render()

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        if t in WATER:
            return "swim" in MONSTERS[mob.kind].traits if mob.kind else False
        if a.kind == "city":
            return t in CITY_GROUND
        if a.kind == "inside":
            return t in INSIDE_FLOOR
        return t in DUNGEON_FLOOR and t not in ("stairs_up", "stairs_down")

    def hidden_now(self):
        return "Hush" in self.p["on"]

    def monster_act(self, mob):
        m = MONSTERS[mob.kind]
        if mob.stuck:
            mob.stuck -= 1
            if not mob.stuck:
                self.say("%s shakes itself and comes on again!" %
                         cap(self.the(mob)), "bad")
            return
        if mob.calm:
            mob.calm -= 1
            self.drift(mob)
            return
        if "slow" in m.traits and self.turn % 2:
            return
        steps = 2 if "fast" in m.traits else 1
        for _ in range(steps):
            if mob not in self.area.mobs or not mob.hostile or (
                    self.p["health"] <= 0 and not self.p["out"]):
                return
            if self.monster_step(mob, m):
                return

    def monster_step(self, mob, m):
        """One move; True if it attacked (and so is done)."""
        a = self.area
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if self.p["out"]:
            if dist == 1 and random.random() < 0.3:
                self.say(random.choice((
                    "%s braids your tail into knots.",
                    "%s draws a moustache on you in berry juice.",
                    "%s pokes you. You don't notice.",
                    "%s puts a daisy behind your ear. How rude.")) %
                    cap(self.the(mob)), "mad")
                if "thief" in m.traits and self.p["coins"]:
                    self.p["coins"] -= 1
                    self.say("And a coin from your saddlebag.", "bad")
            return True
        if self.hidden_now() and dist > 1:
            mob.aware = False
        if not mob.aware:
            if (dist <= 1 or ((mob.x, mob.y) in self.visible and dist <= 7
                              and not self.hidden_now()
                              and not self.ok("Infiltration", 9,
                                              quiet=True))):
                mob.aware = True
            else:
                self.drift(mob)
                return False
        if mob.flee > 0:
            mob.flee = max(0, mob.flee - 1)
            for sx, sy in sorted(DIRS, key=lambda d: -abs(px - mob.x - d[0])
                                 - abs(py - mob.y - d[1])):
                if self.can_go(mob, mob.x + sx, mob.y + sy):
                    mob.x += sx
                    mob.y += sy
                    break
            return False
        if dist == 1:
            self.monster_attack(mob)
            return True
        if (m.ranged and (dx == 0 or dy == 0) and dist <= 6
                and self.line_clear(a, mob.x, mob.y, px, py)
                and random.random() < 0.4):
            self.monster_ranged(mob)
            return True
        if "talker" in m.traits and mob.health <= mob.maxhealth // 3 and \
                not mob.boss and random.random() < 0.3:
            mob.flee = 6
            self.say("%s turns tail and runs!" % cap(self.the(mob)), "info")
            return False
        chase = dist <= 12
        if "erratic" in m.traits and random.random() < 0.4:
            chase = False
        if chase:
            order = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                           abs(py - mob.y - d[1]) + random.random() * 0.5)
        else:
            order = [random.choice(DIRS)]
        for sx, sy in order[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break
        return False

    def drift(self, mob):
        if random.random() < 0.3:
            sx, sy = random.choice(DIRS)
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy

    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        a = self.area
        if (a.inside(x, y) and a.grid[y][x] in mob.roam
                and not a.mob_at(x, y) and [x, y] != self.pos
                and not any((x + ex, y + ey) in a.links for ex, ey in DIRS)
                and (mob.home is None or abs(x - mob.home[0]) +
                     abs(y - mob.home[1]) <= 5)):
            mob.x, mob.y = x, y


    def spawn_city(self):
        """At night the gloomlings are out, more of them as Saturday nears.
        In the afternoons, a bully, or a goose."""
        a = self.area
        px, py = self.pos
        a.mobs = [m for m in a.mobs if not m.hostile or m.boss or
                  abs(m.x - px) + abs(m.y - py) <= 26]
        night = self.phase() == "night"
        h = self.now().hour
        if not night and not 15 <= h < 18:
            return
        if random.random() > (0.04 if night else 0.01):
            return
        day = self.day_no()
        if sum(m.hostile for m in a.mobs) >= 2 + day // 2:
            return
        kinds = ["gloomling", "gloomling", "shadowbat"] if night else \
            ["bully", "goose"]
        for _ in range(20):
            x = px + random.randint(-12, 12)
            y = py + random.randint(-12, 12)
            if (not a.inside(x, y) or a.grid[y][x] not in CITY_GROUND
                    or (x, y) in self.visible or a.mob_at(x, y)
                    or abs(x - px) + abs(y - py) < 8):
                continue
            a.mobs.append(make_monster(random.choice(kinds), x, y))
            return

    # ── Scuffles ──

    def harm(self, mob, n):
        """What a blow does to a monster: armour turns half of them."""
        if "armour" in MONSTERS[mob.kind].traits and not self.crit and \
                random.random() < 0.5:
            self.say("CLANG! It's armoured, and that just bounced off.",
                     "info")
            return 0
        return n

    def attack(self, mob):
        """Hooves first: a scuffle with whatever's in front of you."""
        m = MONSTERS[mob.kind]
        self.break_cover()
        if self.test(("Might", "Finesse"), m.defense,
                     label="scuffling") < 0:
            self.say("You swing a hoof at %s and miss." % self.the(mob),
                     "info")
            self.sound.play("miss")
            return
        self.wound(mob, self.harm(mob, 2 if self.crit else 1), "You %s %s" % (
            random.choice(("bonk", "bop", "boop", "bump")), self.the(mob)))

    def wound(self, mob, n, text):
        if n <= 0:
            self.say(text + ", to no effect!", "bad")
            self.sound.play("miss")
            return
        mob.health -= n
        mob.aware = True
        mob.calm = 0
        self.flash(mob.x, mob.y)
        self.say(text + ". (%d Health)" % n, "good")
        if mob.health <= 0:
            self.defeat(mob)
        else:
            self.sound.play("hit")

    def defeat(self, mob):
        a = self.area
        if mob in a.mobs:
            a.mobs.remove(mob)
        m = MONSTERS[mob.kind]
        if "spook" in m.traits:
            how = "It fades away with a sad little sigh."
        elif m.soothe == "Technology":
            how = "It winds down with a sorry little sproing."
        elif "talker" in m.traits:
            how = "That's enough for them! They stomp off, grumbling."
        else:
            how = random.choice(("It's had enough, and scurries off into the "
                                 "dark.", "It flops over, sulks, and slinks "
                                 "away.", "It runs off with its tail between "
                                 "its legs."))
        self.say("%s is beaten! %s" % (cap(self.the(mob)), how), "good")
        self.sound.play("kill")
        if getattr(mob, "stone", None):
            a.items[(mob.x, mob.y)] = "stone"
            self.say("Something glowing falls to the floor: a Heartstone!",
                     "gold")
            self.gain_fp(1, "for standing up to %s" % self.the(mob))
        if mob.leader or mob.kind in ("gloom", "wyrm"):
            self.flags.add("agent_done")
            self.say("The Gloom is beaten! It shrinks to a wisp of grey and "
                     "blows away on the wind, out over the hills.", "quest")
            self.gain_fp(2, "for saving Lantern Night from the Greymist")
            if mob.kind == "wyrm" and self.area.site == "hall":
                self.say("The hall cheers. Now: the Great Lantern!", "quest")

    def monster_attack(self, mob):
        p = self.p
        m = MONSTERS[mob.kind]
        name = cap(self.the(mob))
        sk, _ = self.roll_rank(m.atk)
        if random.randint(1, 20) + sk < self.defense("Speed"):
            self.say("%s lunges at you; you skip out of the way!" % name,
                     "good")
            self.sound.play("miss")
            return
        self.hurt(m.dmg, "%s %s you" % (name, random.choice((
            "bumps", "nips", "thumps", "wallops") if "talker" not in m.traits
            else ("shoves", "kicks", "bumps", "thumps"))))
        if p["health"] > 0 and "grab" in m.traits:
            p["held"] = 1
            p["held_by"] = True
            self.say("It grabs you and won't let go!", "bad")
        if p["health"] > 0 and "gloomy" in m.traits and \
                p["heart"] != "Laughter" and random.random() < 0.4:
            p["held"] = 1
            p["held_by"] = False
            self.say("Its touch is cold and grey. For a moment you can't "
                     "think why you'd bother doing anything at all.", "mad")
        if "thief" in m.traits and p["coins"] > 0:
            n = min(p["coins"], random.randint(1, 4))
            p["coins"] -= n
            mob.stolen = getattr(mob, "stolen", 0) + n
            self.say("%s grabs %d coin%s from your saddlebag!" % (
                name, n, "s" if n > 1 else ""), "bad")

    def hurt(self, n, text):
        p = self.p
        p["health"] -= n
        self.say("%s! (%d Health)" % (text, n), "bad")
        self.flash(*self.pos)
        self.sound.play("hurt")
        if p["flying"] and p["health"] <= 0:
            self.fall()
        if p["health"] <= 0 and not p["out"] and not self.busy:
            self.root.after(1, self.defeated_check)

    def defeated_check(self):
        if self.p["health"] <= 0 and not self.p["out"] and not self.overlay:
            self.defeated()

    def fall(self):
        p = self.p
        p["flying"] = False
        self.say("You tumble out of the sky. Oof.", "bad")
        if self.area.kind == "city" and self.area.grid[self.pos[1]][
                self.pos[0]] in WATER:
            self.splash()

    def splash(self):
        """In the water, without wings: swim for the nearest bank."""
        a = self.area
        x, y = self.pos
        best = None
        for r in range(1, 14):
            for dx in range(-r, r + 1):
                for dy in (-r, r) if abs(dx) != r else range(-r, r + 1):
                    if a.inside(x + dx, y + dy) and \
                            a.grid[y + dy][x + dx] in CITY_GROUND and \
                            not a.mob_at(x + dx, y + dy):
                        best = (x + dx, y + dy)
                        break
                if best:
                    break
            if best:
                break
        if best:
            self.pos = list(best)
        self.say("SPLASH. You paddle to the bank, dripping.", "bad")

    def monster_ranged(self, mob):
        m = MONSTERS[mob.kind]
        rank, n, what = m.ranged
        name = cap(self.the(mob))
        self.sound.play("spell")
        self.fly(self.line_path((mob.x, mob.y), tuple(self.pos)), "bolt")
        sk, _ = self.roll_rank(rank)
        if random.randint(1, 20) + sk < self.defense("Speed"):
            self.say("%s %s at you; you duck." % (name, what), "info")
            return
        self.hurt(n, "%s %s at you" % (name, what))

    # ── Defeated ──

    def defeated(self):
        """At zero Health: too worn out to go on, for a while."""
        p = self.p
        a = self.area
        p["out"] = 3
        p["fainted"] = False
        p["held"] = 0
        p["flying"] = False
        self.walking = None
        a.knockouts += 1
        self.say(random.choice((
            "You're DEFEATED! Too worn out to go on, you lie down in a "
            "heap.",
            "That's it: your legs fold up under you. DEFEATED.",
            "You sit down hard, all the fight gone out of you. DEFEATED.")) +
            " (%d turns)" % p["out"], "bad")
        self.sound.play("death")
        self.busy = True
        self.root.after(300, self.out_step)

    def out_step(self):
        p = self.p
        if self.overlay:
            self.busy = False
            return
        if p["out"] <= 0:
            self.busy = False
            self.come_to()
            return
        self.busy = False
        self.end_turn()             # still out: nothing hits you now
        p["out"] -= 1
        if not self.overlay:
            self.busy = True
            self.root.after(250, self.out_step)
        else:
            self.busy = False


    def come_to(self):
        p = self.p
        a = self.area
        if p["fainted"]:
            p["fainted"] = False
            self.say("You come round. Was that you squeaking?", "good")
            self.render()
            return
        p["health"] = max(1, (self.max_health() + 1) // 2)
        self.say("You pick yourself up and shake out your mane. (Health "
                 "%d)" % p["health"], "good")
        if a.kind != "inside" and a.knockouts >= 3:
            self.carried_out()
            return
        gone = []
        for m in list(a.mobs):          # they've won: they lose interest
            if m.hostile and not m.boss and abs(m.x - self.pos[0]) + \
                    abs(m.y - self.pos[1]) <= 4:
                if a.kind == "city":
                    a.mobs.remove(m)
                    gone.append(m)
                else:
                    m.calm = 8
                    m.aware = False
        if gone:
            self.say("%s wanders off, very pleased with %s." % (
                cap(self.the(gone[0])), "itself" if len(gone) == 1 else
                "themselves"), "info")
        self.render()

    def carried_out(self):
        """Defeated once too often: you wake up somewhere safe."""
        p = self.p
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.say("...and the next thing you know, you're somewhere else "
                 "entirely.", "bad")
        self.pass_time(60, quiet=True)
        if self.overlay:
            return
        p["health"] = self.max_health()
        p["held"] = 0
        p["flying"] = False
        night = not 7 <= self.now().hour < 20
        sid = "home" if night else "healer"
        area = self.get_area(("bld", sid))
        self.city_pos = list(self.door_of(sid))
        self.area, self.pos = area, list(self.bed_spot(area))
        if night:
            self.say(fill("You wake up in your own bed, %s, tucked in. "
                          "Somepony carried you home. Your little {sib} is "
                          "fast asleep at the foot of the bed." %
                          self.date_text(), self.world), "quest")
        else:
            self.say("You wake up in the Healer's Cottage, %s, with a "
                     "bandage on your nose. 'Somepony found you and carried "
                     "you here,' says Nurse. 'Go gently, now.'" %
                     self.date_text(), "quest")
        self.layout()
        self.save()

    def door_of(self, sid):
        city = self.get_area(("city",))
        for pos, link in city.links.items():
            if link == ("bld", sid):
                return pos[0], pos[1] + 1
        return city.start


    # ── The jitters ──

    def first_sight(self):
        """The first sight of each kind of monster here: keep your nerve."""
        a = self.area
        for m in a.mobs:
            if not m.hostile or not m.kind or (m.x, m.y) not in self.visible:
                continue
            mon = MONSTERS[m.kind]
            if m.kind in a.scared:
                continue
            a.scared.add(m.kind)
            first = "seen:" + m.kind not in self.flags
            self.flags.add("seen:" + m.kind)
            if not first and not m.boss:
                continue
            self.say("You see %s!" % (self.the(m) if m.boss else
                                      an(m.name)), "bad")
            if first and self.ok("Culture", 12, quiet=True):
                self.say("You know about these: %s." % mon.hint, "mad")
            if mon.scare:
                d20 = random.randint(1, 20)
                sk, _ = self.roll_rank(mon.scare)
                will = self.defense("Smarts")
                scared = d20 + sk >= will
                self.say("[Scariness: d20 %d + %d = %d vs your Willpower "
                         "%d: %s]" % (d20, sk, d20 + sk, will,
                                      "the jitters!" if scared else
                                      "you keep your nerve"), "roll")
                if scared:
                    self.freak_out()
                    return

    def freak_out(self):
        p = self.p
        kind = random.choice(("freeze", "run", "faint", "giggle"))
        self.sound.play("horror")
        if kind == "freeze":
            p["held"] = 1
            p["held_by"] = False
            self.say("You freeze, like a bunny in a lantern beam.", "mad")
            return
        if kind == "faint":
            self.say("You faint clean away. Flump.", "mad")
            p["out"] = 2
            p["fainted"] = True
            self.walking = None
            self.busy = True
            self.root.after(300, self.out_step)
            return
        p["freak"] = {"kind": kind, "turns": 4 if kind == "run" else 20}
        self.say({"run": "You panic and gallop round in circles!",
                  "giggle": "You get the nervous giggles. You can't stop! "
                            "Nopony can make out a word you say."}[kind],
                 "mad")

    def end_freak(self):
        fr = self.p["freak"]
        self.p["freak"] = None
        if fr:
            self.say({"run": "You get a grip. Mostly.",
                      "giggle": "The giggles wear off. Hee."}[fr["kind"]],
                     "good")

    def noise(self):
        """Pies and beams wake things up."""
        a = self.area
        px, py = self.pos
        for m in a.mobs:
            if m.hostile and abs(m.x - px) + abs(m.y - py) <= 12:
                m.aware = True

    # ── Throwing and befriending ──

    def throwables(self):
        return [n for n in THROWN if self.p["items"].get(n)]

    def ready_throw(self):
        if not self.ready():
            return
        th = self.throwables()
        if not th:
            self.say("You've nothing to throw. The bakery sells berry pies, "
                     "and the general store buckballs.", "info")
            return
        if len(th) > 1:
            self.open_menu("Throw what?", [
                (cap(ITEMS[n][0].split(":")[0]),
                 lambda n=n: self.aim_throw(n)) for n in th] +
                [("Never mind", lambda: None)])
            return
        self.aim_throw(th[0])

    def aim_throw(self, n):
        self.aim = ("throw", n)
        self.say("Throw the %s which way? (arrow keys, or tap)" % n, "info")

    def ready_befriend(self):
        if not self.ready():
            return
        fr = self.p["freak"]
        if fr and fr["kind"] == "giggle":
            self.say("Hee hee hee. You can't get a word out.", "mad")
            return
        self.aim = ("befriend",)
        self.say("Befriend which way? (arrow keys, or tap)", "info")

    def aimed(self, dx, dy):
        what = self.aim
        self.aim = None
        if what[0] == "throw":
            self.throw(what[1], dx, dy)
        elif what[0] == "befriend":
            self.befriend_at(dx, dy)
        else:
            self.power_at(what[1], dx, dy)

    def target_in_line(self, dx, dy, reach, people=False):
        a = self.area
        x, y = self.pos
        path = []
        for _ in range(reach):
            x, y = x + dx, y + dy
            if not a.inside(x, y) or a.grid[y][x] in a.opaque or (
                    a.grid[y][x] not in WALKABLE and a.grid[y][x] not in
                    WATER and a.grid[y][x] not in (
                        "counter", "table", "desk", "crate", "barrel",
                        "haybale", "fence", "hedge", "reeds")):
                break
            path.append((x, y))
            mob = a.mob_at(x, y)
            if mob and (mob.hostile or people) and not mob.ally:
                return mob, path
        return None, path

    def throw(self, n, dx, dy):
        p = self.p
        mob, path = self.target_in_line(dx, dy, 6)
        self.break_cover()
        p["items"][n] -= 1
        if not p["items"][n]:
            del p["items"][n]
        self.fly(path, "pie" if n == "berry pie" else "ball")
        self.sound.play("throw")
        self.noise()
        if mob is None:
            self.say("Splat. You pie the floor." if n == "berry pie" else
                     "The buckball bounces off into the distance.", "info")
        elif self.test("Targeting", MONSTERS[mob.kind].defense,
                       label="throwing") < 0:
            self.say("You miss %s!" % self.the(mob), "info")
        elif n == "berry pie":
            mob.stuck = 5 if self.crit else 3
            mob.aware = True
            self.flash(mob.x, mob.y, "pie")
            self.say("SPLAT! %s gets a berry pie right in the face, and "
                     "can't see a thing!" % cap(self.the(mob)), "good")
        else:
            self.wound(mob, self.harm(mob, 2 if self.crit else 1),
                       "THWACK! The buckball bounces off %s" %
                       self.the(mob))
        self.end_turn()

    def befriend_at(self, dx, dy):
        mob, path = self.target_in_line(dx, dy, 3, people=True)
        if mob is None:
            self.say("There's nothing there to make friends with.", "info")
            return
        if not mob.hostile:
            if mob.pet is not None:
                self.catch_pet(mob)
            elif mob.tamed:
                self.start_talk(mob)
            else:
                self.say("%s is already friendly!" % cap(self.the(mob)
                                                        if mob.kind else
                                                        mob.title), "info")
            return
        self.befriend(mob)
        self.end_turn()

    def befriend(self, mob):
        """Kindness first: make a friend of a monster.  A guardian takes a
        few goes."""
        p = self.p
        m = MONSTERS[mob.kind]
        need = befriend_need(mob.kind)
        edge = 1 if (p["heart"] == "Laughter" and "spook" in m.traits and
                     m.soothe == "Performance") else 0
        shift = 2 if "soft:" + mob.kind in self.flags else 0
        self.break_cover()
        self.say({"Animal Handling": "You hold out a hoof to %s and speak "
                                    "softly.",
                  "Persuasion": "You talk to %s, kindly and honestly.",
                  "Technology": "You feel around %s for its winding key.",
                  "Performance": "You pull your silliest face at %s and do "
                                 "a little dance."}[m.soothe] %
                 self.the(mob), "info")
        if self.test(m.soothe, m.will, label="befriending", shift=shift,
                     edge=edge, ctx="befriend") < 0:
            mob.aware = True
            self.say("%s isn't ready to listen. Not yet." %
                     cap(self.the(mob)) if mob.boss else
                     "%s doesn't want to know." % cap(self.the(mob)), "info")
            return
        mob.won += 2 if self.crit else 1
        mob.calm = 2
        if mob.won < need:
            self.say("%s softens, just a little. (%d of %d)" % (
                cap(self.the(mob)), mob.won, need), "good")
            return
        self.tame(mob)

    def tame(self, mob):
        p = self.p
        m = MONSTERS[mob.kind]
        mob.hostile = False
        mob.tamed = True
        mob.aware = False
        mob.stuck = 0
        mob.home = (mob.x, mob.y)
        mob.roam = DUNGEON_FLOOR | CITY_GROUND | INSIDE_FLOOR
        greet, talk = TAMED_TALK.get(mob.kind, TAMED_TALK[m.soothe])
        mob.greet, mob.talk = greet, dict(talk)
        mob.title = m.name if mob.boss else "a friendly " + m.name
        self.say({"Animal Handling": "%s sniffs your hoof, and then nuzzles "
                                    "it. You've made a friend!",
                  "Persuasion": "%s listens. Really listens. And then, "
                                "slowly, smiles. You've made a friend!",
                  "Technology": "You find the key on %s and wind it gently "
                                "down. It ticks happily. You've made a "
                                "friend!",
                  "Performance": "%s giggles, then laughs, then laughs so "
                                 "hard the grey falls right off it. You've "
                                 "made a friend!"}[m.soothe] %
                 cap(self.the(mob)), "good")
        self.sound.play("level")
        p["pals"] += 1
        if getattr(mob, "stolen", 0):
            p["coins"] += mob.stolen
            self.say("%s gives you back your %d coins. 'Sorry.'" % (
                cap(self.the(mob)), mob.stolen), "gold")
            mob.stolen = 0
        if getattr(mob, "stone", None):
            lid = mob.stone
            mob.stone = None
            self.got_stone(lid, "%s gives you %s. 'Here. It was never "
                                "mine, really.'" % (
                                    cap(self.the(mob)),
                                    self.world["stones"][lid]))
            self.gain_fp(2, "for making a friend of %s" % self.the(mob))
        elif mob.leader or mob.kind in ("gloom", "wyrm"):
            self.flags.update(("agent_done", "agent_friend"))
            self.say("The grey melts away like fog in the morning sun, and "
                     "what's left is a small, shy wisp of mist with big "
                     "eyes. 'Nopony ever asked me to the festival,' it "
                     "whispers. 'Not once. Not in four hundred years.'",
                     "quest")
            self.gain_fp(3, "for making a friend of the Greymist")
        elif p["heart"] == "Kindness" or p["pals"] % 3 == 0:
            self.gain_fp(1, "for making a friend")

    def fly(self, path, tile):
        """A zap or a blob of goop crossing the squares between."""
        cols, rows, ox, oy, ts = self.view
        c = self.canvas
        for x, y in path[:12]:
            i = x - self.pos[0] + cols // 2
            j = y - self.pos[1] + rows // 2
            if 0 <= i < cols and 0 <= j < rows:
                c.coords(self.missile, ox + i * ts, oy + j * ts)
                c.itemconfig(self.missile, image=self.img[tile],
                             state="normal")
                c.tag_raise(self.missile)
                c.update_idletasks()
                time.sleep(0.025)
        c.itemconfig(self.missile, state="hidden")

    @staticmethod
    def line_path(a, b):
        (x0, y0), (x1, y1) = a, b
        n = max(abs(x1 - x0), abs(y1 - y0))
        return [(x0 + round((x1 - x0) * k / n), y0 + round((y1 - y0) * k / n))
                for k in range(1, n + 1)] if n else []


    # ── Talents and spells ──

    def break_cover(self):
        """Doing something loud ends a Hush."""
        if "Hush" in self.p["on"]:
            del self.p["on"]["Hush"]
            self.power_ends("Hush")

    def talents(self):
        return {"Pegasus": ["Fly"], "Meadow pony": ["Buck"],
                "Unicorn": ["Telekinesis"]}[self.p["origin"]]

    TALENTS = {"Fly": "take to the air, over water and hedges and holes",
               "Buck": "a mighty kick: a monster, a stuck gate, a tree",
               "Telekinesis": "fetch something from four squares away, or "
                              "hold a monster still"}

    def choose_power(self):
        if not self.ready():
            return
        p = self.p
        if p["freak"] and p["freak"]["kind"] == "giggle":
            self.say("Hee hee hee. You can't concentrate.", "mad")
            return
        items = []
        for t in self.talents():
            label = t
            if t == "Fly":
                label = "Land" if p["flying"] else "Fly"
            items.append(("%s: %s" % (label, self.TALENTS[t]),
                          lambda t=t: self.use_power(t)))
        for s in p["spells"]:
            cost, dif, aimed, what = SPELLS[s]
            items.append(("%s (-%d, DIF %d): %s" % (s, cost, dif, what),
                          lambda s=s: self.use_power(s)))
        items.append(("Never mind", lambda: None))
        sc = p["skills"].get("Spellcasting", 0)
        self.open_menu("Talents and spells" + (
            " (Spellcasting %s, now %s)" % (die_name(sc), die_name(p["sc"]))
            if p["spells"] else ""), items)

    def use_power(self, pw):
        p = self.p
        if pw == "Fly":
            if self.area.kind == "inside":
                self.say("Not indoors! Think of the ceiling.", "info")
                return
            p["flying"] = not p["flying"]
            if not p["flying"] and self.area.kind == "city" and \
                    self.area.grid[self.pos[1]][self.pos[0]] in WATER:
                self.splash()
            self.say("You spread your wings and take off! Whee!" if
                     p["flying"] else "You flutter down to land.", "good")
            self.sound.play("spell")
            self.end_turn()
            return
        if pw in ("Buck", "Telekinesis") or SPELLS[pw][2]:
            self.aim = ("power", pw)
            self.say("%s which way?" % pw, "info")
            return
        self.cast(pw)

    def power_at(self, pw, dx, dy):
        if pw == "Buck":
            self.buck(dx, dy)
        elif pw == "Telekinesis":
            self.telekinesis(dx, dy)
        else:
            self.cast(pw, dx, dy)

    def cast(self, s, dx=0, dy=0):
        """Pay for a spell (it tires your Spellcasting, or past that your
        Health), cast it, and see what happens."""
        p = self.p
        cost, dif, aimed, what = SPELLS[s]
        mob = None
        path = []
        if s in ("Sparkle Beam", "Push Beam"):
            mob, path = self.target_in_line(dx, dy, 6)
            if mob:
                dif = max(dif, MONSTERS[mob.kind].defense)
        left = p["sc"] - cost
        if left < 0:
            if -left >= p["health"]:
                self.say("You're far too worn out to cast that. Rest a "
                         "moment, and let your magic come back.", "info")
                return
            p["sc"] = 0
            self.hurt(-left, "You push yourself to cast it, and it takes "
                             "it out of you")
        else:
            p["sc"] = left
        if s in ("Sparkle Beam", "Push Beam"):
            self.break_cover()
            self.noise()
        self.sound.play("spell")
        horn = "horn" if p["origin"] == "Unicorn" else "magic"
        if self.test("Spellcasting", dif, label="casting " + s,
                     rank=p["sc"]) < 0:
            self.say("Your %s fizzles. Pfft." % horn, "info")
            self.end_turn()
            return
        if s in ("Sparkle Beam", "Push Beam"):
            self.fly(path, "bolt")
            if not mob:
                self.say("A beam of coloured light! It hits nothing. "
                         "Pretty, though.", "info")
            else:
                if s == "Push Beam":
                    for _ in range(3):
                        if self.can_go(mob, mob.x + dx, mob.y + dy):
                            mob.x += dx
                            mob.y += dy
                self.wound(mob, self.harm(mob, 2 if self.crit else 1),
                           "Your beam %s %s" % (
                               "shoves" if s == "Push Beam" else "zaps",
                               self.the(mob)))
        elif s == "Shield":
            p["on"]["Shield"] = 10
            self.say("A shimmering shield pops up around you.", "good")
        elif s == "Mend":
            n = min(2, self.max_health() - p["health"])
            p["health"] += n
            self.say("Warm light knits you back together. (+%d Health)" % n,
                     "good")
        elif s == "Glow":
            p["on"]["Glow"] = 60
            self.say("Your %s glows like a little lantern." % horn, "good")
        elif s == "Knack":
            p["on"]["Knack"] = 10
            self.say("You feel a knack for things coming on.", "good")
        elif s == "Blink":
            self.blink(dx, dy)
        elif s == "Butterfly Wings":
            p["on"]["Wings"] = 60
            if self.area.kind != "inside":
                p["flying"] = True
            self.say("Shimmering butterfly wings sprout from your back!%s" %
                     (" You flutter up." if p["flying"] else ""), "good")
        elif s == "Kindred Tongue":
            p["on"]["Kindred"] = 20
            self.say("The squeaks and growls around you turn into words.",
                     "good")
        elif s == "Hush":
            p["on"]["Hush"] = 20
            for m in self.area.mobs:
                if m.hostile and abs(m.x - self.pos[0]) + \
                        abs(m.y - self.pos[1]) > 1:
                    m.aware = False
            self.say("A hush falls around you. Nothing notices you now.",
                     "good")
        elif s == "Wayfinder":
            self.wayfind()
        self.end_turn()

    def blink(self, dx, dy):
        a = self.area
        x, y = self.pos
        best = None
        for k in range(1, 6):
            nx, ny = x + dx * k, y + dy * k
            if not a.inside(nx, ny) or a.grid[ny][nx] in a.opaque:
                break
            if self.can_stand(nx, ny) and not a.mob_at(nx, ny) and \
                    (nx, ny) not in a.links:
                best = (nx, ny)
        if not best:
            self.say("Flash! ...and you're right where you were.", "info")
            return
        self.pos = list(best)
        self.say("Flash! You're over there now.", "good")
        self.step_on(*best)

    @staticmethod
    def compass(dx, dy):
        if not dx and not dy:
            return "right here"
        ns = "north" if dy < -abs(dx) / 2 else "south" if dy > abs(dx) / 2 \
            else ""
        ew = "west" if dx < -abs(dy) / 2 else "east" if dx > abs(dy) / 2 \
            else ""
        return "-".join(w for w in (ns, ew) if w)

    def wayfind(self):
        a = self.area
        x, y = self.pos
        what = self.p["origin"] == "Unicorn" and "Your horn" or "Something"
        if a.kind == "dungeon":
            boss = next((m for m in a.mobs if getattr(m, "stone", None)),
                        None)
            spot = (boss.x, boss.y) if boss else a.down
            if not spot:
                self.say("%s tugs you nowhere at all. There's nothing more "
                         "to find down here." % what, "info")
                return
            self.say("%s tugs you %s." % (what, self.compass(
                spot[0] - x, spot[1] - y)), "good")
            return
        if a.kind == "inside":
            self.say("Indoors, all you can feel is the way out.", "info")
            return
        left = [lid for lid in self.world["leads"]
                if lid not in self.returned and lid not in self.stones]
        if not left:
            self.say("%s tugs you towards the Star Tower. You've found "
                     "them all!" % what, "good")
            return
        spots = {"mine": MINE, "wood": WOODPATH, "cloud": CLOUDSTAIR,
                 "lake": BOATHOUSE, "ruins": KEEPGATE,
                 "attic": self.door_of("toyshop")}
        lid = min(left, key=lambda l: abs(spots[l][0] - x) +
                  abs(spots[l][1] - y))
        sx, sy = spots[lid]
        self.say("%s tugs you %s, towards %s." % (
            what, self.compass(sx - x, sy - y), district(sx, sy)), "good")
        self.learn(lid + "_known")

    def buck(self, dx, dy):
        """Turn round and kick, with both back hooves."""
        a = self.area
        x, y = self.pos[0] + dx, self.pos[1] + dy
        mob = a.mob_at(x, y) if a.inside(x, y) else None
        t = a.grid[y][x] if a.inside(x, y) else None
        if mob and not mob.hostile:
            self.say("You wouldn't buck a friend!", "info")
            return
        self.sound.play("bump")
        if mob:
            m = MONSTERS[mob.kind]
            if self.test("Might", m.defense, label="bucking", shift=1) < 0:
                self.say("You buck, and miss. Very athletic, though.",
                         "info")
            else:
                if self.can_go(mob, mob.x + dx, mob.y + dy):
                    mob.x += dx
                    mob.y += dy
                self.wound(mob, self.harm(mob, 3 if self.crit else 2),
                           "You turn and BUCK %s with both back hooves" %
                           self.the(mob))
        elif t == "gate":
            self.try_gate(x, y, "buck")
            return
        elif t == "crate":
            self.say("You buck the chest open. CRACK.", "info")
            self.open_loot(x, y)
            return
        elif t == "rubble":
            if self.ok("Might", 10, label="bucking"):
                a.grid[y][x] = "dfloor"
                self.say("You buck the rubble out of the way.", "good")
        elif t == "orchard":
            key = "apple:%d:%d:%d" % (x, y, self.day_no())
            if key in self.flags:
                self.say("THUMP. Leaves fall. No more apples today.",
                         "info")
            elif self.ok("Might", 10, label="bucking"):
                self.flags.add(key)
                self.p["items"]["apple"] = self.p["items"].get("apple",
                                                               0) + 1
                self.say("THUMP. An apple drops neatly into your "
                         "saddlebag.", "gold")
        elif t in ("tree", "pine"):
            self.say("THUMP. A squirrel glares down at you.", "info")
        else:
            self.say("You buck the empty air. Very athletic.", "info")
        self.end_turn()

    def telekinesis(self, dx, dy):
        a = self.area
        mob, path = self.target_in_line(dx, dy, 4)
        x, y = self.pos
        for k in range(1, 5):
            cx, cy = x + dx * k, y + dy * k
            if not a.inside(cx, cy):
                break
            if a.grid[cy][cx] == "crate" and (cx, cy) in a.loot:
                self.say("Your horn glows; the chest's lid creaks open.",
                         "good")
                self.open_loot(cx, cy)
                return
            if (cx, cy) not in path:
                break
        for px, py in path:
            if (px, py) in a.items and a.items[(px, py)] != "trap":
                thing = a.items.pop((px, py))
                a.items[tuple(self.pos)] = thing
                self.say("Your horn glows. It floats over to you.", "good")
                self.step_on(*self.pos)
                self.end_turn()
                return
        if mob and not mob.boss:
            if self.ok("Alertness", MONSTERS[mob.kind].defense,
                       label="holding it"):
                mob.stuck = 2
                self.say("You hold %s in mid-air, kicking." % self.the(mob),
                         "good")
            else:
                self.say("It wriggles out of your grip.", "info")
        else:
            self.say("Your horn glows. Nothing nearby moves.", "info")
        self.end_turn()

    def power_ends(self, pw):
        p = self.p
        if pw == "Wings":
            self.say("Your butterfly wings fade away.", "info")
            if p["flying"] and p["origin"] != "Pegasus":
                p["flying"] = False
                self.say("You float gently down.", "info")
                if self.area.kind == "city" and self.area.grid[
                        self.pos[1]][self.pos[0]] in WATER:
                    self.splash()
            return
        text = {"Shield": "Your shield goes pop.",
                "Glow": "The glow fades.",
                "Knack": "The knack wears off.",
                "Kindred": "The animal voices fade back into squeaks and "
                           "growls.",
                "Hush": "Things can notice you again.",
                "Edge": "Your lucky streak runs out."}.get(pw)
        if text:
            self.say(text, "info")

    # ── Friends ──

    def ally_act(self, mob):
        """A friend who came along: helps out, and keeps up."""
        a = self.area
        for dx, dy in DIRS:
            t = a.mob_at(mob.x + dx, mob.y + dy)
            if t and t.hostile and not t.calm:
                if random.random() < 0.5:
                    self.wound(t, self.harm(t, 1), "%s bumps %s" % (
                        mob.name.split()[0], self.the(t)))
                return
        px, py = self.pos
        for sx, sy in sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                             abs(py - mob.y - d[1])):
            if abs(px - mob.x) + abs(py - mob.y) <= 2:
                break
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break

    def place_companion(self):
        """Your friend comes along: into each place you go."""
        role = self.p.get("companion")
        a = self.area
        for m in list(a.mobs):
            if m.ally and m.role != role:
                m.ally = False
                if m.visitor:
                    a.mobs.remove(m)
        if not role:
            return
        for m in a.mobs:
            if m.role == role:
                m.ally = True
                return
        x, y = self.pos
        for dx, dy in DIRS:
            nx, ny = x + dx, y + dy
            if a.inside(nx, ny) and not a.mob_at(nx, ny) and \
                    a.grid[ny][nx] in (CITY_GROUND | INSIDE_FLOOR |
                                       {"dfloor"}) and \
                    (nx, ny) not in a.links:
                m = make_person(self.world, role, nx, ny)
                m.ally = m.visitor = True
                a.mobs.append(m)
                return

    def invite(self, mob):
        p = self.p
        role = mob.role
        if role not in p["friends"]:
            self.npc_say(mob, "Come with you? I hardly know you!")
            return
        if role not in COMPANIONS:
            self.npc_say(mob, "Oh, I'd love to, but I've got my work to "
                         "see to. Come and tell me all about it after!")
            return
        if p["companion"] == role:
            self.npc_say(mob, "I'm right here, silly!")
            return
        if p["companion"]:
            self.dismiss()
        p["companion"] = role
        mob.ally = True
        self.npc_say(mob, random.choice((
            "Really? Yes! Let's go!", "Adventure! I'll get my scarf.",
            "I thought you'd never ask!")))
        self.say("%s comes along with you. (Talk to them and say STAY to "
                 "send them home.)" % mob.name, "good")
        self.end_talk()

    def dismiss(self):
        role = self.p["companion"]
        self.p["companion"] = None
        for m in list(self.area.mobs):
            if m.role == role and m.ally:
                m.ally = False
                if m.visitor:
                    self.area.mobs.remove(m)

    # ── Things in the saddlebags ──

    def use_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        for n in ("apple", "cupcake", "hay sandwich", "carrot cake",
                  "berry pie", "salve", "confetti popper", "sleepy dust",
                  "buckball"):
            if p["items"].get(n):
                label = ITEMS[n][0].split(":")[0]
                if n in THROWN:
                    label = ("Throw " if n == "buckball" else
                             "Throw or eat ") + label
                elif p["items"][n] > 1:
                    label += " (%d)" % p["items"][n]
                items.append((cap(label), lambda n=n: self.use(n)))
        if not items:
            self.say("You've nothing to use just now. The shops on the "
                     "High Street will see you right.", "info")
            return
        items.append(("Never mind", lambda: None))
        self.open_menu("Use what?", items)

    def use(self, n):
        p = self.p
        if n == "berry pie":
            self.open_menu("A berry pie: throw it, or eat it?", [
                ("Throw it", lambda: self.aim_throw(n)),
                ("Eat it (+2 Health)", lambda: self.eat(n)),
                ("Never mind", lambda: None)])
            return
        if n == "buckball":
            self.aim_throw(n)
            return
        if n in FOOD:
            self.eat(n)
            return
        if n == "salve":
            if p["health"] >= self.max_health():
                self.say("You're as right as rain already.", "info")
                return
            p["health"] = min(self.max_health(), p["health"] + 2)
            self.say("You dab on the salve. It smells of mint. (+2 Health)",
                     "good")
            self.sound.play("potion")
        elif n == "confetti popper":
            hit = [m for m in self.area.mobs if m.hostile and
                   (m.x, m.y) in self.visible]
            for m in hit:
                m.stuck = 3
                self.flash(m.x, m.y, "confetti")
            self.say("POP! A storm of confetti, glitter and streamers.%s" % (
                " Everything in sight is too dazzled to move." if hit else
                ""), "good")
            self.sound.play("fire")
        elif n == "sleepy dust":
            hit = [self.area.mob_at(self.pos[0] + dx, self.pos[1] + dy)
                   for dx, dy in DIRS]
            hit = [m for m in hit if m and m.hostile]
            if not hit:
                self.say("There's nothing next to you to put to sleep.",
                         "info")
                return
            for m in hit:
                m.stuck = 6
            self.say("You puff the sleepy dust. Yawn... snore.", "good")
        p["items"][n] -= 1
        if p["items"][n] <= 0:
            del p["items"][n]
        self.end_turn()

    def eat(self, n):
        p = self.p
        if p["health"] >= self.max_health():
            self.say("You're full. (Your Health is as good as it gets.)",
                     "info")
            return
        gain = FOOD[n]
        p["health"] = min(self.max_health(), p["health"] + gain)
        self.say({"apple": "Crunch. Juicy!",
                  "cupcake": "Sprinkles everywhere. Worth it.",
                  "hay sandwich": "A good, honest hay sandwich.",
                  "carrot cake": "Mmm. Cream cheese icing.",
                  "berry pie": "It's all over your face. Delicious."}[n] +
                 " (+%d Health)" % gain, "good")
        self.sound.play("potion")
        p["items"][n] -= 1
        if p["items"][n] <= 0:
            del p["items"][n]
        self.end_turn()

    def you_tile(self):
        p = self.p
        return "you_%s_%d" % (p["origin"].split()[0].lower(), p["look"])

    # ── Searching and touching ──

    def search(self):
        if not self.ready():
            return
        a = self.area
        px, py = self.pos
        near = [(x, y) for (x, y) in a.hidden
                if abs(x - px) + abs(y - py) <= 3]
        traps = [(x, y) for (x, y) in a.traps
                 if abs(x - px) + abs(y - py) <= 3]
        stair = (a.kind == "city" and abs(CLOUDSTAIR[0] - px) +
                 abs(CLOUDSTAIR[1] - py) <= 5 and
                 a.grid[CLOUDSTAIR[1]][CLOUDSTAIR[0]] != "cloudstair" and
                 "cloud" in self.world["leads"])
        self.say("You look around carefully.", "info")
        if not self.ok("Alertness", 12, label="searching"):
            self.say("You find nothing. Not even a button.", "info")
        else:
            found = False
            for pos in near:
                a.items[pos] = a.hidden.pop(pos)
                found = True
            for pos in traps:
                a.traps.discard(pos)
                a.items[pos] = "trap"
                found = True
            if stair:
                self.learn("cloud_known")
                self.say("Up on the hilltop, where the air shimmers: steps, "
                         "made of cloud, climbing up into the sky!", "gold")
                found = True
            if near or traps:
                self.say("You find something!" if near else
                         "You find a slick of mud. Nearly put your hoof in "
                         "it.", "gold")
            elif not found:
                self.say("There's nothing here to find.", "info")
        if not any(m.hostile for m in a.mobs if (m.x, m.y) in self.visible):
            self.turn += 4
        self.end_turn()

    def reveal_stair(self):
        city = self.get_area(("city",))
        city.grid[CLOUDSTAIR[1]][CLOUDSTAIR[0]] = "cloudstair"

    def got_stone(self, lid, text):
        self.stones.append(lid)
        self.flags.add("stone:" + lid)
        self.say(text + " It's warm, and it glows like a hearth. Bring it "
                 "to Grandmare Thistlewick!", "quest")
        self.sound.play("quest")

    def step_on(self, x, y):
        """Things on the floor are picked up (or read); True if that took
        the turn."""
        a, p = self.area, self.p
        thing = a.items.get((x, y))
        if not thing or thing == "trap":
            return False
        del a.items[(x, y)]
        if thing == "stone":
            self.got_stone(a.lead, "You pick up %s." %
                           self.world["stones"][a.lead])
        elif thing == "note" and getattr(a, "letter", None) == (x, y):
            self.flags.add("letter")
            p["items"]["grey letter"] = 1
            self.learn("letter")
            self.say("A letter sealed with grey wax. Inside: 'All goes well. "
                     "The Lantern will stay dark.' And it's signed: %s." %
                     self.world["people"][self.world["agent"]]["name"],
                     "quest")
            self.sound.play("gold")
        elif thing == "note":
            self.say(getattr(a, "note", "A scrap of paper. Illegible."),
                     "talk")
            self.flags.add("note:%s" % (a.key,))
        elif thing == "coins":
            n = roll("1d6+2")
            p["coins"] += n
            self.say("You find %d coins. Lucky!" % n, "gold")
            self.sound.play("gold")
        elif thing == "snack":
            what = random.choice(("cupcake", "apple", "hay sandwich"))
            p["items"][what] = p["items"].get(what, 0) + 1
            self.say("You find %s, wrapped in a napkin." %
                     ITEMS[what][0].split(":")[0], "gold")
            self.sound.play("gold")
        elif thing == "gear":
            what = random.choice(("sleepy dust", "confetti popper", "salve",
                                  "buckball", "berry pie"))
            p["items"][what] = p["items"].get(what, 0) + 1
            self.say("You find %s!" % ITEMS[what][0].split(":")[0], "gold")
            self.sound.play("gold")
        return False

