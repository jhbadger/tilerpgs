    def pep_talk(self):
        p = self.p
        if p["health"] >= self.max_health():
            self.say("You're feeling fine already!", "info")
            return
        p["fp"] -= 1
        p["health"] = self.max_health()
        self.say("You think of your friends, and how they'd cheer you on. "
                 "You stand up straighter. (Health %d)" % p["health"],
                 "good")
        self.render_chrome()

