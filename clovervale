        people[role] = {"first": first, "sex": sex, "tile": tile,
                        "name": full, "short": short, "title": title,
                        "young": young, "hon": honorific}
    return people


def make_person(world, role, x, y):
    who = world["people"][role]
    m = Mob(who["tile"], who["name"], x, y)
    m.role = role
    m.title = fill(who["title"], world)
    m.shop = SHOPS.get(role)
    m.leader = role == world["agent"]
    m.talk, m.greet = role_talk(world, role)
    return m


def fill(text, world):
    p = world["people"]
    names = {r: v["short"] for r, v in p.items()}
    names.update({r + "_full": v["name"] for r, v in p.items()})
    ag = p[world["agent"]]
    names.update(agent=ag["short"], agent_full=ag["name"],
                 agent_title=ag["title"],
                 agent_he="he" if ag["sex"] == "M" else "she",
                 agent_him="him" if ag["sex"] == "M" else "her",
                 sib="brother" if p["sibling"]["sex"] == "M" else "sister")
    for r, v in p.items():
        m = v["sex"] == "M"
        names.update({r + "_he": "he" if m else "she",
                      r + "_He": "He" if m else "She",
                      r + "_his": "his" if m else "her",
                      r + "_him": "him" if m else "her",
                      r + "_title": v["title"]})
    return text.format(**names)


