    # ── Taps and walking ──

    def on_tap(self, ev):
        self.walking = None
        if not self.cells:
            return
        if self.menu:
            for x0, y0, x1, y1, i in self.menu_rows:
                if x0 <= ev.x <= x1 and y0 <= ev.y <= y1:
                    self.menu_pick(i)
                    return
            if not self.talk:
                self.menu_cancel()
            return
        if self.busy or self.talk:
            return
        if self.overlay:
            self.close_overlay()
            return
        cols, rows, ox, oy, ts = self.view
        tx = self.pos[0] - cols // 2 + (ev.x - ox) // ts
        ty = self.pos[1] - rows // 2 + (ev.y - oy) // ts
        dx, dy = tx - self.pos[0], ty - self.pos[1]
        step = ((1 if dx > 0 else -1, 0) if abs(dx) >= abs(dy)
                else (0, 1 if dy > 0 else -1))
        if self.aim:
            if (dx, dy) == (0, 0):
                self.aim = None
                self.say("Never mind.", "info")
            else:
                self.aimed(*step)
        elif (dx, dy) == (0, 0):
            self.wait()
        elif abs(dx) + abs(dy) == 1:
            self.move(dx, dy)
        else:
            self.walk_to(tx, ty)


    def passable(self, x, y, goal):
        a = self.area
        if not a.inside(x, y):
            return False
        if (x, y) == goal:
            return True
        t = a.grid[y][x]
        m = a.mob_at(x, y)
        if (m and not (m.ally or m.tamed or m.crowd)) or (x, y) in a.links:
            return False
        return self.can_stand(x, y) and t not in (
            "stairs_up", "stairs_down", "exit", "thorns", "gap", "spring",
            "mist", "deep")

    def walk_to(self, tx, ty):
        start, goal = tuple(self.pos), (tx, ty)
        prev = {start: None}
        q = deque([start])
        while q and goal not in prev:
            x, y = q.popleft()
            if abs(x - start[0]) + abs(y - start[1]) > 50:
                continue
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if n not in prev and self.passable(n[0], n[1], goal):
                    prev[n] = (x, y)
                    q.append(n)
        if goal not in prev:
            self.say("You can't find a way there.", "info")
            return
        path = []
        while goal != start:
            path.append(goal)
            goal = prev[goal]
        self.walking = path[::-1]
        self.walk_area = self.area
        self.walk_seen = self.hostiles_in_view()
        self.walk_step()

    def hostiles_in_view(self):
        return {id(m) for m in self.area.mobs
                if m.hostile and not m.calm and (m.x, m.y) in self.visible}

    def walk_step(self):
        if (not self.walking or not self.ready()
                or self.area is not self.walk_area):
            self.walking = None
            return
        before = tuple(self.pos)
        x, y = self.walking.pop(0)
        self.move(x - before[0], y - before[1])
        if tuple(self.pos) != (x, y):
            # a fast step may have gone further along the path
            while self.walking and tuple(self.pos) != (x, y):
                x, y = self.walking.pop(0)
            if tuple(self.pos) != (x, y):
                self.walking = None
                return
        if self.hostiles_in_view() - self.walk_seen:
            self.walking = None
            return
        if self.walking:
            self.root.after(90, self.walk_step)

    def wait(self):
        if not self.ready():
            return
        if self.p["held"]:
            self.p["held"] -= 1
        self.say("You wait.", "info")
        self.end_turn()


    # ── Drawing ──

    def layout(self):
        if not getattr(self, "area", None):
            return
        c = self.canvas
        c.delete("all")
        ts = 16 * self.scale
        W, H = max(c.winfo_width(), ts * 5), max(c.winfo_height(), ts * 5)
        cols, rows = W // ts, H // ts
        cols -= 1 - cols % 2
        rows -= 1 - rows % 2
        ox, oy = (W - cols * ts) // 2, (H - rows * ts) // 2
        self.view = (cols, rows, ox, oy, ts)
        self.cells = []
        for j in range(rows):
            for i in range(cols):
                x, y = ox + i * ts, oy + j * ts
                self.cells.append((
                    c.create_image(x, y, anchor="nw", state="hidden"),
                    c.create_image(x, y, anchor="nw", state="hidden")))
        self.shown = [(None, None)] * len(self.cells)
        self.fx = c.create_image(0, 0, anchor="nw", state="hidden")
        self.missile = c.create_image(0, 0, anchor="nw", state="hidden")
        self.place_companion()
        self.render()

    @staticmethod
    def line_clear(a, x0, y0, x1, y1):
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        x, y = x0, y0
        while (x, y) != (x1, y1):
            if (x, y) != (x0, y0) and a.grid[y][x] in a.opaque:
                return False
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x += sx
            if e2 <= dx:
                err += dx
                y += sy
        return True


    def light_radius(self):
        a, p = self.area, self.p
        if a.dark:
            return 9 if "Glow" in p["on"] else 7 if p["items"].get(
                "lantern") else 5 if p["origin"] == "Unicorn" else 4
        if a.kind != "city":
            return None
        ph = self.phase()
        if ph == "day":
            return None
        r = 10 if ph in ("dawn", "dusk") else 5
        if "Glow" in p["on"] or p["items"].get("lantern"):
            r += 3
        return r

    def compute_visible(self):
        a = self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        r = self.light_radius()
        r2 = r * r if r else None
        lit = getattr(a, "lit", set()) if r else set()
        vis = set()
        for y in range(max(0, py - rows // 2), min(a.h, py + rows // 2 + 1)):
            for x in range(max(0, px - cols // 2),
                           min(a.w, px + cols // 2 + 1)):
                if r2 and (x - px) ** 2 + (y - py) ** 2 > r2 and \
                        (x, y) not in lit:
                    continue
                if self.line_clear(a, px, py, x, y):
                    vis.add((x, y))
                    a.seen[y * a.w + x] = 1
        return vis

    def render(self):
        if not self.cells or not getattr(self, "area", None):
            return
        c, a = self.canvas, self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        self.visible = vis = self.compute_visible()
        dim = a.dark or self.light_radius() is not None
        mobs = {(m.x, m.y): m for m in a.mobs}
        you = self.you_tile()
        x0, y0 = px - cols // 2, py - rows // 2
        for j in range(rows):
            y = y0 + j
            for i in range(cols):
                x = x0 + i
                base = top = None
                if a.inside(x, y):
                    t = a.grid[y][x]
                    if (x, y) in vis:
                        base = self.framed(a.skin.get(t, t))
                        m = mobs.get((x, y))
                        if m:
                            top = m.tile
                        else:
                            top = a.items.get((x, y))
                    elif dim and a.seen[y * a.w + x]:
                        base = "~" + a.skin.get(t, t)
                elif a.edge:
                    base = self.framed(a.edge)
                if x == px and y == py:
                    top = you
                top = self.framed(top)
                idx = j * cols + i
                old = self.shown[idx]
                if old == (base, top):
                    continue
                self.shown[idx] = (base, top)
                bid, tid = self.cells[idx]
                if base != old[0]:
                    if base is None:
                        c.itemconfig(bid, state="hidden")
                    elif base[0] == "~":
                        c.itemconfig(bid, image=self.dimg[base[1:]],
                                     state="normal")
                    else:
                        c.itemconfig(bid, image=self.img[base],
                                     state="normal")
                if top != old[1]:
                    if top is None:
                        c.itemconfig(tid, state="hidden")
                    else:
                        c.itemconfig(tid, image=self.img[top],
                                     state="normal")
        c.delete("overlay")
        if self.overlay == "map":
            self.draw_map()
        elif self.overlay == "help":
            self.draw_text_box(HELP)
        elif self.overlay in ("sheet", "journal"):
            self.draw_text_box(self.overlay_text)
        elif self.overlay in ("won", "doom"):
            self.draw_text_box(self.overlay_text,
                               ACCENT if self.overlay == "won" else BAD)
        if self.menu:
            self.draw_menu()
        self.render_chrome()

    def flash(self, x, y, tile="hit"):
        cols, rows, ox, oy, ts = self.view
        i = x - self.pos[0] + cols // 2
        j = y - self.pos[1] + rows // 2
        if not (0 <= i < cols and 0 <= j < rows):
            return
        self.fx_token += 1
        token = self.fx_token
        self.canvas.coords(self.fx, ox + i * ts, oy + j * ts)
        self.canvas.itemconfig(self.fx, image=self.img[tile], state="normal")
        self.canvas.tag_raise(self.fx)

        def hide():
            if token == self.fx_token:
                self.canvas.itemconfig(self.fx, state="hidden")
        self.root.after(160, hide)

    def draw_text_box(self, text, color=INK):
        c = self.canvas
        W, H = c.winfo_width(), c.winfo_height()
        t = c.create_text(W / 2, H / 2, text=text, fill=color, font=MONO,
                          justify="left", tags="overlay")
        x0, y0, x1, y1 = c.bbox(t)
        r = c.create_rectangle(x0 - 20, y0 - 16, x1 + 20, y1 + 16,
                               fill=PANEL, outline=ACCENT, width=2,
                               tags="overlay")
        c.tag_raise(t, r)


    def draw_map(self):
        c, a = self.canvas, self.get_area(("city",))
        W, H = c.winfo_width(), c.winfo_height()
        rows = []
        for y in range(a.h):
            row = []
            for x in range(a.w):
                if not a.seen[y * a.w + x]:
                    row.append("#000000")
                else:
                    t = a.grid[y][x]
                    row.append("#ff5aa0" if t == "door" or (x, y) in
                               a.links and t != "hill" else
                               "#fff0a0" if t == "lamp" else self.avg[t])
            rows.append("{" + " ".join(row) + "}")
        img = tk.PhotoImage(width=a.w, height=a.h)
        img.put(" ".join(rows))
        z = max(1, min((W - 20) // a.w, (H - 50) // a.h))
        self.map_img = img.zoom(z)
        c.create_rectangle(0, 0, W, H, fill="black", tags="overlay")
        mx, my = (W - a.w * z) / 2, (H - a.h * z) / 2 + 10
        c.create_image(mx, my, image=self.map_img, anchor="nw",
                       tags="overlay")
        small = ("Helvetica", 9 if z < 7 else 11)
        for (x, y), name in a.labels.items():
            if a.seen[y * a.w + x] and (a.grid[y][x] in (
                    "door", "mineshaft", "woodpath", "boathouse", "keepgate",
                    "cloudstair", "fountain", "well") or
                    name == "the Clover Green"):
                c.create_text(mx + (x + 0.5) * z, my + y * z - 2,
                              text=name.replace("the ", "", 1),
                              fill="#ffffff", font=small, anchor="s",
                              tags="overlay")
        if self.area is a:
            px, py = self.pos
        else:
            px, py = self.city_pos or a.start
        c.create_rectangle(mx + px * z - 2, my + py * z - 2,
                           mx + (px + 1) * z + 2, my + (py + 1) * z + 2,
                           outline="#ffff00", width=2, tags="overlay")
        c.create_text(W / 2, my - 14, fill=ACCENT, font=MONO, tags="overlay",
                      text="Clover Vale   (pink: doors and ways in; any key "
                           "closes)")

    def render_chrome(self):
        p = self.p
        a = self.area
        w = self.world
        here = a.name if a.kind != "city" else "Clover Vale: " + district(
            *self.pos)
        near = [a.labels[(self.pos[0] + dx, self.pos[1] + dy)]
                for dx, dy in DIRS + ((0, 0),)
                if (self.pos[0] + dx, self.pos[1] + dy) in a.labels]
        if near and a.kind == "city":
            here += ", by " + near[0]
        self.status.config(text=cap(here))
        left = LANTERN - self.turn
        self.turns.config(text="%s   (%s)" % (
            self.date_text(), "%d days to Lantern Night" % (left // DAY)
            if left >= DAY else "%d hours to Lantern Night" % (left // 60)
            if left > 0 else "IT'S LANTERN NIGHT"))
        lines = [p["name"], "%s %s" % (p["origin"].split()[0].title()
                                       if p["origin"] != "Meadow pony"
                                       else "Meadow pony", p["calling"]),
                 "Heart of %s" % p["heart"], "Level %d" % p["level"], "",
                 "Health %2d/%-2d FP %d" % (max(0, p["health"]),
                                           self.max_health(), p["fp"]),
                 "Coins  %-5d" % p["coins"]]
        if p["spells"]:
            lines.append("Magic  %s (now %s)" % (
                die_name(p["skills"].get("Spellcasting", 0)),
                die_name(p["sc"])))
        lines.append("")
        things = []
        for n, v in sorted(p["items"].items()):
            if v:
                things.append("%s%s" % (n, " x%d" % v if v > 1 else ""))
        if things:
            lines += ["Carrying"] + ["  " + t for t in things]
        if p["companion"]:
            lines += ["", "With you: %s" % w["people"][p["companion"]][
                "first"]]
        lines += ["", "Heartstones %d/4 home" % len(self.returned)]
        if self.stones:
            lines.append("  carrying %d" % len(self.stones))
        if p["grow"]:
            lines += ["", "You can grow! (Menu)"]
        self.panel.config(text="\n".join(lines))
        cond = []
        if p["out"]:
            cond.append("FAINTED" if p["fainted"] else "DEFEATED")
        fr = p["freak"]
        if fr:
            cond.append({"run": "PANICKING", "giggle": "GIGGLING"}[
                fr["kind"]])
        if p["held"]:
            cond.append("HELD FAST")
        if self.tired():
            cond.append("TIRED")
        if p["flying"]:
            cond.append("FLYING")
        for k, label in (("Shield", "SHIELDED"), ("Glow", "GLOWING"),
                         ("Knack", "KNACK"), ("Kindred", "KINDRED TONGUE"),
                         ("Hush", "HUSHED"), ("Edge", "LUCKY"),
                         ("Wings", "BUTTERFLY WINGS")):
            if k in p["on"]:
                cond.append(label)
        if 0 < p["health"] <= self.max_health() // 3:
            cond.append("WORN OUT")
        self.condition.config(text="\n".join(cond))
        self.sound.tune = ("festival" if a.site == "hall" and (
            self.turn >= LANTERN or "won" in self.flags)
            else TUNE_OF[a.kind])

    # ── Commands ──

    def toggle_map(self):
