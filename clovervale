def generate_world(seed):
    """The week: who is who, which leads are live, where the stones are."""
    rng = random.Random("%s:world" % seed)
    world = {"seed": seed, "people": make_people(rng)}
    world["agent"] = rng.choice(AGENT_ROLES)
    leads = rng.sample(CASE_LEADS, 4)
    world["leads"] = leads
    names = list(STONE_NAMES)
    rng.shuffle(names)
    world["stones"] = dict(zip(leads, names))
    world["letter"] = rng.choice(leads)
    world["errands"] = make_errands(rng, world)
    return world


