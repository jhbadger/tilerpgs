class Area:
    """A map: Clover Vale, a building, or a level below."""

    def __init__(self, kind, key, grid, name, edge=None, dark=False):
        self.kind, self.key, self.grid, self.name = kind, key, grid, name
        self.h, self.w = len(grid), len(grid[0])
        self.edge = edge
        self.dark = dark
        self.mobs = []
        self.items = {}         # (x, y) -> thing lying there
        self.links = {}         # (x, y) -> ("bld", site) or ("lead", lead)
        self.labels = {}        # (x, y) -> what it is
        self.hidden = {}        # (x, y) -> found by searching
        self.loot = set()       # chests not yet opened
        self.traps = set()
        self.signs = {}
        self.scared = set()     # kinds of monster already faced here
        self.knockouts = 0
        self.skin = {}
        self.seen = bytearray(self.w * self.h)
        self.opaque = OPAQUE[kind]
        self.start = (0, 0)
        self.down = None
        self.site = None

    def inside(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h

    def mob_at(self, x, y):
        for m in self.mobs:
            if m.x == x and m.y == y:
                return m
        return None


class Mob:
    def __init__(self, tile, name, x, y):
        self.tile, self.name, self.x, self.y = tile, name, x, y
        self.kind = None
        self.hostile = False
        self.health = self.maxhealth = 1
        self.boss = False
        self.flee = 0
        self.aware = False
        self.stuck = 0          # dazzled, asleep, held or pied
        self.calm = 0           # turns of not minding you
        self.tamed = False      # befriended
        self.won = 0            # befriendings so far (a boss needs more)
        self.title = name
        self.role = None
        self.talk, self.greet = {}, ""
        self.known = False
        self.shop = None
        self.leader = False
        self.roam = None
        self.home = None
        self.errand = None      # the errand this pony gives
        self.pet = None         # a runaway pet: its errand
        self.ally = False       # a friend who came along
        self.visitor = False    # ...and isn't from round here
        self.crowd = False      # at Lantern Night: squeeze past
        self.night_owl = False


def make_monster(kind, x, y, boss=False, rng=random):
    m = MONSTERS[kind]
    mob = Mob(m.tile, m.name, x, y)
    mob.kind = kind
    mob.hostile = True
    mob.health = mob.maxhealth = m.health
    mob.boss = boss or "boss" in m.traits
    return mob


def befriend_need(kind):
    found = re.search(r"befriend(\d)", MONSTERS[kind].traits)
    return int(found.group(1)) if found else 1


def role_talk(world, role):
    greet, talk = ROLE_TALK[role]
    talk = dict(talk)
    for lead in world["leads"]:
        talk.update(HOOKS.get(lead, {}).get(role, {}))
    return talk, greet


