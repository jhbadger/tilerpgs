    def wish(self):
        p = self.p
        key = "wish:%d" % self.day_no()
        if not p["coins"]:
            self.say("You'd toss a coin in the fountain and make a wish, if "
                     "you had a coin.", "info")
            return
        p["coins"] -= 1
        if key in self.flags:
            self.say("You toss a coin in the fountain. Plink.", "info")
            return
        self.flags.add(key)
        self.say("You toss a coin in the fountain and make a wish. You feel "
                 "lucky.", "good")
        p["on"]["Edge"] = 30

    def open_loot(self, x, y):
        a = self.area
        if (x, y) not in a.loot:
            self.bump()
            return
        a.loot.discard((x, y))
        a.grid[y][x] = "crate_open"
        self.flags.add("loot:%s:%d:%d:%d" % (a.key[1], a.key[2], x, y))
        self.say("You open the chest.", "info")
        r = random.random()
        if r < 0.15:
            self.say("A spring-loaded boxing glove! BOING!", "bad")
            self.hurt(1, "It boffs you on the nose")
        elif r < 0.3:
            kind = random.choice(LEADS[a.lead].monsters)
            self.say("Something was in there, and it's cross.", "bad")
            spots = [(x + dx, y + dy) for dx, dy in DIRS
                     if a.inside(x + dx, y + dy) and
                     a.grid[y + dy][x + dx] in DUNGEON_FLOOR and
                     not a.mob_at(x + dx, y + dy) and
                     [x + dx, y + dy] != self.pos]
            if spots:
                m = make_monster(kind, *spots[0])
                m.aware = True
                a.mobs.append(m)
        elif r < 0.8:
            a.items[tuple(self.pos)] = random.choice(("coins", "snack",
                                                      "gear", "coins"))
            self.step_on(*self.pos)
        else:
            self.say("Cobwebs. Just cobwebs.", "info")
        self.end_turn()

    def gate(self, x, y):
        p = self.p
        opts = [("Buck it open (Might, DIF 14)",
                 lambda: self.try_gate(x, y, "buck")),
                ("Pick the lock (Infiltration, DIF 13)",
                 lambda: self.try_gate(x, y, "pick")),
                ("Work the latch (Technology, DIF 12)",
                 lambda: self.try_gate(x, y, "fix"))]
        if p["origin"] == "Unicorn":
            opts.append(("Lift the bar inside with telekinesis (Alertness, "
                         "DIF 12)", lambda: self.try_gate(x, y, "lift")))
        opts.append(("Leave it", lambda: None))
        self.open_menu("A heavy old door, barred and bolted. Beyond it, the "
                       "heart of this place.", opts)

    def try_gate(self, x, y, how):
        a = self.area
        skill, dif = {"buck": ("Might", 14), "pick": ("Infiltration", 13),
                      "fix": ("Technology", 12),
                      "lift": ("Alertness", 12)}[how]
        shift = 1 if how == "buck" and self.p["origin"] == "Meadow pony" \
            else 0
        ok = self.ok(skill, dif, label={"buck": "bucking", "pick": "picking",
                                        "fix": "fiddling", "lift":
                                        "lifting"}[how], shift=shift)
        if not ok and how == "buck":
            for m in a.mobs:
                if m.hostile and abs(m.x - x) + abs(m.y - y) <= 12:
                    m.aware = True
            self.say("BOOM. That echoed.", "bad")
        if ok:
            a.grid[y][x] = "dfloor"
            self.say("The door creaks open.", "good")
            self.sound.play("door")
        else:
            self.say("It holds.", "info")
        self.end_turn()

    # ── The ways down ──

    def at_lead(self, lid, x, y):
        p = self.p
        if lid not in self.world["leads"]:
            self.say({
                "mine": "The old mine. Boarded up, quiet, and full of "
                        "nothing but dust this week.",
                "wood": "The old trail into the Hollow Wood. The wood is "
                        "quiet. Peaceful, even. Nothing's stirring in there "
                        "this week.",
                "cloud": "The cloud stair. Up top, the old castle's empty, "
                         "just clouds being clouds.",
                "lake": "The boathouse. Inside: a rowing boat, some nets, "
                        "and a very surprised duck.",
                "attic": "The ladder up to the attic. Up there: dusty "
                         "clockwork, all wound down. Nothing's dancing.",
                "ruins": "The gate of Thornwall Keep. Behind it: rubble and "
                         "sunshine and a lot of nettles."}[lid], "info")
            return
        if lid in self.returned or lid in self.stones:
            self.say("You've got the Heartstone from down there already.",
                     "info")
            self.open_menu("Go in anyway?", [
                ("Yes", lambda: self.descend(lid)), ("No", lambda: None)])
            return
        if "open:" + lid in self.flags:
            self.descend(lid)
            return
        self.learn(lid + "_known")
        free = None
        if lid == "mine" and p["items"].get("mine key"):
            free = "The foreman's key fits the padlock. Click."
        elif lid == "wood" and "wood_ok" in self.flags:
            free = "You follow the warden's directions, the moss on the "\
                "north side of the trees, deep into the wood."
        elif lid in ("wood", "ruins") and p["flying"]:
            free = "You fly up over the %s, and drop down on the other "\
                "side." % ("brambles" if lid == "wood" else "wall")
        elif lid == "cloud" and (p["flying"] or p["origin"] == "Pegasus" or
                                 p["items"].get("cloud boots")):
            free = "Up the cloud stair you go, step by springy step."
        elif lid == "lake" and "ferry_ok" in self.flags:
            free = "The ferry pony rows you over the deep water to the "\
                "grotto's mouth."
        elif lid == "lake" and p["items"].get("bubble charm"):
            free = "You put on the bubble charm and wade right in."
        elif lid == "attic" and "attic_ok" in self.flags:
            free = "Up the ladder you go."
        if free:
            self.say(free, "good")
            self.flags.add("open:" + lid)
            self.descend(lid)
            return
        bonus = -3 if "bonus:" + lid in self.flags else 0
        what = {"mine": "The old mine. A gate of iron bars, padlocked, and "
                        "behind it the dark, and a smell of gems and "
                        "digging.",
                "wood": "The old trail into the Hollow Wood, choked with "
                        "brambles. They seem to lean towards you.",
                "cloud": "The cloud stair, soft and white, climbing into the "
                         "sky. Your hoof goes straight through the first "
                         "step. You can't walk on clouds: you'd need wings, "
                         "or cloud boots.",
                "lake": "The boathouse. The grotto's mouth is out across "
                        "the deep water, under the willows.",
                "attic": "The ladder to the attic. Above, something goes "
                         "tick, tick, tick, and something hums a little "
                         "tune.",
                "ruins": "The gate of Thornwall Keep: an old portcullis, "
                         "rusted shut."}[lid]
        opts = []
        if lid == "mine":
            opts += [("Buck the gate (Might, DIF %d)" % (14 + bonus),
                      lambda: self.try_lead(lid, "Might", 14 + bonus)),
                     ("Pick the padlock (Infiltration, DIF 15)",
                      lambda: self.try_lead(lid, "Infiltration", 15))]
        elif lid == "wood":
            opts += [("Find the old way in (Survival, DIF 13)",
                      lambda: self.try_lead(lid, "Survival", 13)),
                     ("Push through the brambles (Might, DIF 15)",
                      lambda: self.try_lead(lid, "Might", 15))]
        elif lid == "cloud":
            self.say(what, "info")
            return
        elif lid == "lake":
            opts.append(("Swim for it (Athletics, DIF 14)",
                         lambda: self.try_lead(lid, "Athletics", 14)))
            if any(m.role == "ferry" for m in self.area.mobs):
                opts.append(("Pay the ferry pony 3 coins to row you over",
                             self.pay_ferry))
        elif lid == "attic":
            opts += [("Creep up while Tock isn't looking (Infiltration, "
                      "DIF 13)",
                      lambda: self.try_lead(lid, "Infiltration", 13)),
                     ("Ask Tock nicely (Persuasion, DIF 13)",
                      lambda: self.try_lead(lid, "Persuasion", 13))]
        elif lid == "ruins":
            opts += [("Work the old winch (Technology, DIF %d)" % (
                14 + bonus), lambda: self.try_lead(lid, "Technology",
                                                   14 + bonus)),
                     ("Buck the portcullis (Might, DIF 16)",
                      lambda: self.try_lead(lid, "Might", 16))]
        opts.append(("Leave it", lambda: None))
        self.open_menu(what, opts)

    def pay_ferry(self):
        p = self.p
        if p["coins"] < 3:
            self.say("The ferry pony looks at your coins, and then at you. "
                     "'Three. Not %d.'" % p["coins"], "talk")
            return
        p["coins"] -= 3
        self.flags.update(("ferry_ok", "open:lake"))
        self.say("The ferry pony pockets the coins and rows you over to the "
                 "grotto's mouth. 'Mind the turtle.'", "good")
        self.descend("lake")

    def try_lead(self, lid, skill, dif):
        shift = 1 if skill == "Might" and self.p["origin"] == "Meadow pony" \
            else 0
        ok = self.ok(skill, dif, shift=shift, label={
            "Might": "bucking", "Infiltration": "sneaking",
            "Survival": "finding the way", "Athletics": "swimming",
            "Technology": "working the winch",
            "Persuasion": "asking"}[skill])
        self.turn += 10
        if ok:
            self.flags.add("open:" + lid)
            self.say("You're in!", "good")
            self.descend(lid)
            return
        self.say("No luck. Ten minutes wasted.", "info")
        if lid == "lake" and skill == "Athletics":
            self.hurt(1, "You swallow half the lake")
        if lid == "attic" and skill == "Infiltration" and \
                self.area.kind == "inside":
            self.say("Tock catches you on the ladder. 'Down! Down! It's not "
                     "safe!' He shoos you out of the shop.", "bad")
            self.go_outside()
            return
        self.end_turn()

    # ── Research ──

    def research_menu(self):
        a = self.area
        topics = sorted(t for t in self.topics if t in RESEARCH and
                        "research:" + t not in self.flags)
        if not topics:
            self.say("You browse, but you don't know what you're looking "
                     "for. Words in CAPITALS that ponies mention can be "
                     "looked up.", "info")
            return
        bonus = RESEARCH_SITES[a.site]
        self.open_menu("Look up what? (Science, about an hour)",
                       [(t.title(), lambda t=t: self.research(t, bonus))
                        for t in topics] + [("Nothing", lambda: None)])

    def research(self, topic, bonus):
        lid, text, effect = RESEARCH[topic]
        if not self.ok(("Science", "Culture"), 12, shift=bonus,
                       label="looking it up"):
            self.pass_time(30)
            self.say("Half an hour of dusty pages and a sneezing fit.",
                     "info")
            self.render()
            return
        self.pass_time(60)
        self.flags.add("research:" + topic)
        self.say("An hour later, you find it:", "info")
        self.say(fill(text, self.world), "talk")
        self.hear(fill(text, self.world))
        if lid and lid not in self.world["leads"]:
            self.say("(Old news. Nothing's happening there this week.)",
                     "info")
        elif effect and effect.endswith("_known"):
            self.learn(effect)
        elif effect:
            self.flags.add(effect)
            self.say("(That'll help.)", "info")
        if self.p["heart"] == "Wonder" and "wonder:" + topic not in \
                self.flags:
            self.flags.add("wonder:" + topic)
            self.gain_fp(1, "for the wonder of finding things out")
        self.render()

    # ── Beds ──

    def bed_menu(self):
        a = self.area
        if a.site == "home":
            self.open_menu("Your bed. The quilt your gran made.", [
                ("Sleep until morning", lambda: self.sleep(True)),
                ("Take a nap (2 hours)", lambda: self.sleep(False)),
                ("Not now", lambda: None)])
        elif a.site == "inn":
            self.open_menu("A bed at the Haystack Inn: three coins a "
                           "night.", [
                               ("Take a room until morning (3 coins)",
                                lambda: self.sleep(True, 3)),
                               ("Not now", lambda: None)])
        elif a.site == "healer":
            if self.p["health"] < self.max_health():
                self.say("Nurse tucks you in. 'Half an hour's rest, and "
                         "you'll be right as rain.'", "talk")
                self.pass_time(30, quiet=True)
                self.p["health"] = self.max_health()
                self.say("You feel much better. (Health %d)" %
                         self.p["health"], "good")
                self.render()
            else:
                self.say("Nurse: 'Beds are for poorly ponies, dear.'",
                         "talk")
        else:
            self.say("Somepony else's bed.", "info")

    def sleep(self, night, cost=0):
        p = self.p
        if cost and p["coins"] < cost:
            self.say("You haven't got %d coins." % cost, "info")
            return
        p["coins"] -= cost
        h = self.now().hour
        if night:
            hours = (24 + 7 - h) % 24 or 24
            if hours > 14:
                hours = 2
        else:
            hours = 2
        self.say("You sleep %d hours. Zzz." % hours, "info")
        self.pass_time(hours * 60, quiet=True)
        if self.overlay:
            return
        if hours >= 5:
            p["slept"] = self.turn
            p["health"] = self.max_health()
            p["sc"] = p["skills"].get("Spellcasting", 0)
        self.say("You wake up, %s.%s" % (self.date_text(), (
            " " + random.choice(("Birds are singing.",
                                 fill("Your little {sib} is bouncing on "
                                      "the end of the bed.", self.world),
                                 "Somepony's baking. You can smell it from "
                                 "here."))) if hours >= 5 else ""),
            "good")
        self.render()

    def bed_spot(self, area):
        for y in range(area.h):
            for x in range(area.w):
                if area.grid[y][x] == "bed" and y + 1 < area.h and \
                        area.grid[y + 1][x] in INSIDE_FLOOR:
                    return x, y + 1
        return area.start


    # ── Clues ──

    def learn(self, cid):
        if cid in self.clues:
            return
        self.clues.append(cid)
        if cid.endswith("_known"):
            self.flags.add("known:" + cid[:-6])
            if cid == "cloud_known":
                self.reveal_stair()
        self.say("(Your journal has a new entry. J reads it.)", "quest")
        self.sound.play("gold")

    def hear(self, text):
        """Words in CAPITALS: things to ask about, and to look up."""
        words = re.findall(r"\b[A-Z][A-Z']{2,}\b", text)
        self.heard = [re.sub(r"'S?$", "", w) for w in words
                      if w not in ("BYE", "HI") and
                      not re.fullmatch(r"[IVXLC]+", w)]
        for w in words:
            if w in RESEARCH:
                self.topics.add(w)


    # ── Talking ──

    def speaker(self, mob):
        return cap(mob.name) if mob.known or mob.role in (
            "thistlewick", "sibling") or (mob.kind and mob.boss) else \
            cap(mob.title)

    def npc_say(self, mob, text):
        text = fill(text, self.world)
        self.say("%s: %s" % (self.speaker(mob), text), "talk")
        self.hear(text)


    def start_talk(self, mob):
        p = self.p
        fr = p["freak"]
        if fr and fr["kind"] == "giggle":
            self.say("You try to talk to %s, but it all comes out as "
                     "giggles. They back away." % mob.title, "mad")
            return
        self.talk = {"mob": mob, "mode": "kw"}
        self.heard = []
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Ask about:")
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        if mob.role == "thistlewick":
            self.mentor_greet(mob)
            if self.overlay:
                self.end_talk()
                return
            self.talk_menu()
            return
        self.say("You talk to %s." % (self.the(mob) if mob.kind else
                                      mob.title), "info")
        e = mob.errand
        greet = mob.greet
        if e is not None:
            st = self.side.get(e["id"])
            if st and st["state"] == "active":
                greet = "Oh! It's you. Any luck?"
        if mob.ally:
            greet = random.choice(("What's next?", "I'm right behind you!",
                                   "This is the best day ever."))
        elif mob.role in p["friends"]:
            greet = random.choice(("Hello, friend!", "Oh, it's you! "
                                   "Hello!", "My favourite pony!"))
        self.npc_say(mob, "We're closed. Come back in the morning." if
                     self.closed(mob) else greet)
        for e in self.world["errands"]:
            if e.get("to") == mob.role:
                self.deliver(mob, e)
        if e is not None and self.errand_ready(e):
            self.finish_errand(mob, e)
        if "talked" not in self.flags:
            self.flags.add("talked")
            self.say("(Choose what to ask about, or type a word such as "
                     "NAME, JOB or NEWS and press Return. BYE, or an empty "
                     "line, ends the conversation.)", "info")
        self.talk_menu()

    def closed(self, mob):
        return mob.shop in CLOSES and self.phase() == "night"

    def talk_menu(self):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        if t["mode"] == "buy":
            items = [("%d) %s%s" % (i, label, ", %d coin%s" % (
                price, "s" if price > 1 else "") if price else ""),
                lambda i=i: self.choose_words(str(i)))
                for i, (label, price, _) in enumerate(self.offers(mob), 1)]
            items.append(("Nothing, thanks", lambda: self.choose_words("")))
            self.open_menu("Buy what? (you have %d coins)" % self.p["coins"],
                           items, lambda: self.choose_words(""))
            return
        if t["mode"] == "give":
            gifts = [g for g in GIFTS if self.p["items"].get(g)]
            self.open_menu("Give %s what?" % self.speaker(mob), [
                (cap(ITEMS[g][0].split(":")[0]),
                 lambda g=g: self.give(mob, g)) for g in gifts] +
                [("Nothing", lambda: self.choose_words("never mind"))],
                lambda: self.choose_words("never mind"))
            return
        words = ["NAME", "JOB", "NEWS"]
        if mob.shop:
            words.append("BUY")
        if mob.errand is not None and self.side.get(
                mob.errand["id"], {}).get("state") != "done":
            words.append("HELP")
        if mob.role == "thistlewick":
            words += ["GREAT LANTERN", "HEARTSTONES", "GREYMIST"]
        elif mob.role and "GREYMIST" in self.topics and mob.role in \
                AGENT_ROLES:
            words.append("GREYMIST")
        if mob.role and not mob.kind and any(self.p["items"].get(g)
                                             for g in GIFTS):
            words.append("GIVE")
        if mob.role in self.p["friends"] and mob.role in COMPANIONS:
            words.append("STAY" if mob.ally else "COME")
        for w in getattr(self, "heard", []):
            if w not in words and w != "BYE":
                words.append(w)
        self.open_menu("Ask %s about:" % self.speaker(mob),
                       [(w, lambda w=w: self.choose_words(w))
                        for w in words + ["BYE"]],
                       lambda: self.choose_words("bye"))

    def choose_words(self, w):
        self.say("> " + (w or "nothing"), "you")
        self.converse(w.lower())
        self.talk_menu()

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if getattr(self, "p", None) and getattr(self, "area", None):
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if not self.talk:
            return
        self.menu = None
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())
        self.talk_menu()


    def converse(self, w):
        t = self.talk
        mob = t["mob"]
        if t["mode"] in ("buy", "give"):
            mode, t["mode"] = t["mode"], "kw"
            if mode == "buy" and w.isdigit():
                self.buy(mob, int(w))
                return
            if not w or w == "never mind":
                self.npc_say(mob, "Anything else?")
                return
        if not w or w.startswith("bye"):
            self.npc_say(mob, random.choice(BYES))
            self.end_talk()
            return
        word = re.sub(r"'s?$", "", w.split()[0])
        if word.startswith("name"):
            mob.known = True
            self.npc_say(mob, "I'm %s." % mob.name if not mob.role else
                         "%s, %s." % (mob.name, mob.title))
            return
        if word[:4] in ERRAND_WORDS and mob.errand is not None:
            self.errand(mob)
            return
        if mob.shop and word[:3] in ("buy", "pur", "sho", "sel"):
            self.list_offers(mob)
            return
        if word[:4] in ("give", "gift", "pres") and mob.role and \
                not mob.kind:
            if not any(self.p["items"].get(g) for g in GIFTS):
                self.npc_say(mob, "That's sweet. But you haven't got "
                             "anything to give!")
                return
            t["mode"] = "give"
            return
        if word[:4] in ("come", "join", "foll") and mob.role:
            self.invite(mob)
            return
        if word[:4] in ("stay", "home", "go") and mob.ally and \
                mob.role == self.p.get("companion"):
            self.dismiss()
            self.npc_say(mob, "Right you are! I'll be about. Come and "
                         "find me.")
            self.end_talk()
            return
        if mob.leader and word[:4] in ("grey", "gray", "gloo", "mist"):
            self.confront(mob)
            return
        if mob.role in AGENT_ROLES and word[:4] in ("grey", "gray", "gloo"):
            self.npc_say(mob, random.choice((
                "The Greymist? A foals' tale. Nothing to worry about.",
                "Grey? I hadn't noticed anything grey.",
                "Ha ha. No. Is that the time?")))
            return
        if mob.role == "thistlewick" and word[:4] in ("hear", "ston") and \
                self.returned:
            self.npc_say(mob, "I have %d of the four. %s" % (
                len(self.returned), "The Great Lantern is ready! Saturday, "
                "the Lantern Hall, at sunset!" if len(self.returned) >= 4
                else "Keep looking, dear!"))
            return
        reply = next((v for k, v in mob.talk.items()
                      if k[:4] == word[:4] or (len(k) < 4 and
                                               word.startswith(k))), None)
        if reply is None and word[:4] in ("heal", "how'", "how"):
            reply = random.choice(HEALTH)
        if reply is None and mob.shop and len(word) >= 4 and \
                not self.closed(mob) and any(
                    word[:4] in label.lower()
                    for label, _, _ in self.offers(mob)):
            self.list_offers(mob)
            return
        if reply is None and not mob.kind:
            reply = next((v for k, v in TOPICS.items()
                          if word.startswith(k)), None)
        if reply is None and word.upper() in RESEARCH and not mob.kind:
            reply = "I don't know much about that. Look it up at the " \
                    "Inkwell Library?"
        if reply is None:
            reply = random.choice((
                "I don't know anything about that.",
                "Hmm?",
                "I've no idea what you mean, dear.")) if not mob.kind else \
                "It tilts its head at you, puzzled."
        self.reply(mob, reply)
        self.render_chrome()

    def reply(self, mob, r):
        """Say a reply: words, or a dict that may roll, give things and
        teach clues."""
        if isinstance(r, str):
            self.npc_say(mob, r)
            return
        if "skill" in r:
            flag = r.get("flag")
            if flag and flag in self.flags:
                self.npc_say(mob, "I've done all I'm going to do for you.")
                return
            tried = "tried:%s:%d" % (flag, self.day_no())
            if tried in self.flags:
                self.npc_say(mob, r["fail"])
                return
            if self.ok(r["skill"], r.get("diff", 12),
                       shift=1 if mob.role in self.p["friends"] else 0,
                       label="persuading"):
                self.npc_say(mob, r["ok"])
                if flag:
                    self.flags.add(flag)
                if r.get("give"):
                    self.p["items"][r["give"]] = 1
                    self.say("You get the %s." % r["give"], "gold")
                    self.sound.play("gold")
            else:
                self.flags.add(tried)
                self.npc_say(mob, r["fail"])
            return
        self.npc_say(mob, r["say"])
        if r.get("learn"):
            self.learn(r["learn"])
        if r.get("topic"):
            self.topics.add(r["topic"])

    def give(self, mob, g):
        """A gift: a friend made, and Friendship Points for a generous
        heart."""
        p = self.p
        self.talk["mode"] = "kw"
        p["items"][g] -= 1
        if not p["items"][g]:
            del p["items"][g]
        self.say("> (you give %s %s)" % (self.speaker(mob),
                                         ITEMS[g][0].split(":")[0]), "you")
        if "gift:" + mob.role in self.flags:
            self.npc_say(mob, "Another one? You're too kind! Thank you!")
            self.talk_menu()
            return
        self.flags.add("gift:" + mob.role)
        self.npc_say(mob, random.choice((
            "For me? Oh! Thank you! You're a real friend.",
            "Oh, that's lovely! I'll treasure it.",
            "You didn't have to! ...I'm glad you did.")))
        self.befriended(mob.role)
        self.gain_fp(2 if p["heart"] == "Generosity" else 1,
                     "for a gift from the heart")
        self.talk_menu()

    def befriended(self, role):
        p = self.p
        if role and role not in p["friends"]:
            p["friends"].append(role)
            if role in COMPANIONS:
                self.say("%s is your friend now. (Ask a friend to COME "
                         "along.)" % self.world["people"][role]["name"],
                         "good")

    def confront(self, mob):
        """Ask the Gloom about the Greymist."""
        if "letter" not in self.flags and "suspect" not in self.clues:
            self.npc_say(mob, "The Greymist? A foals' tale. Nothing to "
                         "worry about. Run along now.")
            if "doubt:grey" not in self.flags:
                self.flags.add("doubt:grey")
                if self.ok("Alertness", 14, edge=1 if self.p["heart"] ==
                           "Honesty" else 0, label="seeing through it"):
                    self.say("Their smile doesn't reach their eyes. Their "
                             "eyes are grey. %s is fibbing." % mob.name,
                             "mad")
                    self.learn("suspect")
            return
        self.npc_say(mob, "So. You know. What a pity. Clover Vale was so "
                     "close to being perfectly, wonderfully GREY.")
        self.say(fill("The colour drains out of {agent_full}, mane, coat "
                      "and all, until {agent_he}'s grey as fog, with eyes "
                      "as flat as a wet Tuesday.", self.world), "bad")
        self.end_talk()
        m = MONSTERS["gloom"]
        mob.kind = "gloom"
        mob.tile = "gloom"
        mob.hostile = True
        mob.aware = True
        mob.boss = True
        mob.health = mob.maxhealth = m.health
        mob.title = "the Gloom"
        mob.name = "the Gloom (%s)" % mob.name
        mob.shop = None
        self.flags.add("unmasked")
        self.area.scared.add("gloom")
        self.render()

    # ── Shops ──

    def offers(self, mob):
        """(label, price, what happens) for what a shop sells."""
        p = self.p
        kind = mob.shop
        o = []

        def give(item, n=1):
            def f():
                p["items"][item] = p["items"].get(item, 0) + n
                self.say("You buy %s." % ITEMS[item][0].split(":")[0],
                         "gold")
            return f

        def item(name):
            return (cap(ITEMS[name][0].split(":")[0]), ITEMS[name][1],
                    give(name))
        if kind == "bakery":
            o += [item("cupcake"), item("carrot cake"), item("berry pie")]
        elif kind == "tea":
            o += [item("hay sandwich"), item("carrot cake")]
        elif kind in ("farm", "juice"):
            o += [item("apple"), item("hay sandwich")]
        elif kind == "general":
            for n in ("lantern", "rope", "toolkit", "cloud boots",
                      "bubble charm"):
                if not p["items"].get(n):
                    o.append(item(n))
            o += [item("salve"), item("sleepy dust"), item("buckball"),
                  item("confetti popper")]
        elif kind == "boutique":
            if not p["items"].get("festival ribbon"):
                o.append(item("festival ribbon"))
            o += [item("friendship bracelet"), item("flower crown")]
        elif kind == "healer":
            o.append(("Patching up (Health back to full)", 0, self.patch_up))
            o.append(item("salve"))
        elif kind == "inn":
            o.append(("A room for the night (pick a bed)", 0,
                      lambda: self.say("The innkeeper waves at the beds. "
                                       "'Any you like. Three coins.'",
                                       "talk")))
            o.append(item("hay sandwich"))
        return o

    def list_offers(self, mob):
        if self.closed(mob):
            self.npc_say(mob, "We're closed!")
            return
        offers = self.offers(mob)
        if not offers:
            self.npc_say(mob, "I've got nothing else you'd want.")
            return
        self.npc_say(mob, "Here's what we've got.")
        self.talk["mode"] = "buy"


    def buy(self, mob, n):
        p = self.p
        offers = self.offers(mob)
        if not 1 <= n <= len(offers):
            self.npc_say(mob, "Hmm?")
            return
        label, price, what = offers[n - 1]
        if price and p["heart"] == "Generosity":
            price = max(1, price * 4 // 5)
            self.npc_say(mob, "For you, a friend's price: %d." % price)
        elif price >= 10 and "haggle:%s:%d" % (mob.role, self.day_no()) \
                not in self.flags:
            self.flags.add("haggle:%s:%d" % (mob.role, self.day_no()))
            if self.ok(("Streetwise", "Persuasion"), 13, label="haggling"):
                price = price * 4 // 5
                self.npc_say(mob, "Oh, go on then: %d." % price)
        if price > p["coins"]:
            self.npc_say(mob, "You're %d coin%s short, dear." % (
                price - p["coins"], "s" if price - p["coins"] > 1 else ""))
            return
        p["coins"] -= price
        what()
        self.sound.play("gold")
        self.render_chrome()

    def patch_up(self):
        p = self.p
        if p["health"] >= self.max_health():
            self.say("Nurse looks you over. 'Not a scratch on you. Off you "
                     "go.'", "talk")
            return
        p["health"] = self.max_health()
        self.say("Nurse cleans you up, puts a plaster on your knee, and "
                 "gives you a lollipop. (Health %d)" % p["health"], "good")

    # ── Grandmare Thistlewick and Lantern Night ──

    def mentor_greet(self, mob):
        p = self.p
        self.say("You meet Grandmare Thistlewick, the wizard of the Star "
                 "Tower: a pointed hat, a beard of silver mane, and "
                 "spectacles on a chain.", "info")
        if "met_mentor" not in self.flags:
            self.flags.add("met_mentor")
            self.npc_say(mob, "%s! At last. Sit, sit. Something dreadful "
                         "has happened. The four HEARTSTONES have been "
                         "taken from the GREAT Lantern, and hidden all over "
                         "the valley." % p["name"])
            self.npc_say(mob, "If the Lantern isn't lit on Lantern Night, "
                         "the GREYMIST comes down out of the hills and the "
                         "colour goes out of everything for a hundred "
                         "years. Find the stones. Bring them to me. And "
                         "dear, if you meet anything grey, be kind to it, "
                         "if you can. Here: ten coins from the festival "
                         "fund.")
            p["coins"] += 10
            self.say("Grandmare Thistlewick gives you 10 coins.", "gold")
            self.learn("case")
            self.topics.update(("HEARTSTONES", "GREYMIST", "LANTERN"))
            return
        if self.stones:
            for lid in self.stones:
                self.returned.append(lid)
                self.flags.add("back:" + lid)
                self.npc_say(mob, "%s! Oh, look at it glow!" %
                             cap(self.world["stones"][lid]))
            n = len(self.stones)
            self.stones = []
            self.sound.play("level")
            self.gain_fp(2 * n, "for bringing the Heartstones home")
            for _ in range(n):
                self.level_up()
            self.mentor_gives()
            return
        n = len(self.returned)
        self.npc_say(mob, "The Great Lantern is ready! The Lantern Hall, "
                     "Saturday, at sunset. Light it, and SING." if n >= 4
                     else "I have %d of the four Heartstones. Keep "
                     "listening, dear: where odd things gather, there the "
                     "stones will be." % n)

    def level_up(self):
        p = self.p
        p["level"] += 1
        p["grow"] += 1
        self.say("You reach level %d! (Choose how you grow from the "
                 "Menu.)" % p["level"], "gold")

    def mentor_gives(self):
        p = self.p
        n = len(self.returned)
        for k in range(1, n + 1):
            flag = "lesson:%d" % k
            if flag in self.flags:
                continue
            self.flags.add(flag)
            spell = next((s for s in LESSONS if s not in p["spells"]), None)
            if spell:
                p["spells"].append(spell)
                if not p["skills"].get("Spellcasting"):
                    p["skills"]["Spellcasting"] = 1
                    p["sc"] = 1
                self.say("Grandmare Thistlewick teaches you a spell: %s, %s. "
                         "'Horn or no horn, dear. Magic is everywhere.' (C "
                         "casts it.)" % (spell, SPELLS[spell][3]), "gold")
            gift = {1: ("salve", 2), 2: ("cloud boots" if not p["items"].get(
                "cloud boots") else "bubble charm", 1),
                3: ("confetti popper", 2)}.get(k)
            if gift and not (gift[0] in WORN and p["items"].get(gift[0])):
                p["items"][gift[0]] = p["items"].get(gift[0], 0) + gift[1]
                self.say("And she gives you %s%s." % (
                    ITEMS[gift[0]][0].split(":")[0],
                    " (two of them)" if gift[1] > 1 else ""), "gold")
        if n >= 4 and "final" not in self.flags:
            self.flags.add("final")
            self.learn("final")
            self.say("Grandmare Thistlewick takes the last Heartstone down "
                     "to the Lantern Hall herself, and sets it in the Great "
                     "Lantern with a click. 'There. Saturday, at sunset, "
                     "you light it. And wear a RIBBON.'", "quest")
            self.sound.play("quest")

    def grow_menu(self):
        p = self.p
        if not p["grow"]:
            self.say("You'll grow when Grandmare Thistlewick has another "
                     "Heartstone home.", "info")
            return
        items = []
        for e in ESSENCES:
            for s in SKILLS[e] + (("Spellcasting",) if e == "Smarts" and
                                  p["skills"].get("Spellcasting") else ()):
                r = p["skills"].get(s, 0)
                if r < 6:
                    items.append(("%s %s -> %s  (%s)" % (
                        s, die_name(r), die_name(r + 1), SKILL_HELP[s]),
                        lambda s=s: self.grow(s)))
        items.append(("Later", lambda: None))
        self.open_menu("You've grown! Raise a Skill (and its Essence): %d "
                       "to choose" % p["grow"], items)

    def grow(self, s):
        p = self.p
        before = self.max_health()
        p["grow"] -= 1
        p["skills"][s] = p["skills"].get(s, 0) + 1
        p["ess"][SKILL_ESSENCE[s]] += 1
        if s == "Spellcasting":
            p["sc"] = p["skills"][s]
        p["health"] += self.max_health() - before
        self.say("Your %s goes up to %s, and your %s to %d." % (
            s, die_name(p["skills"][s]), SKILL_ESSENCE[s],
            p["ess"][SKILL_ESSENCE[s]]), "good")
        self.render_chrome()
        if p["grow"]:
            self.grow_menu()

    def hall_arrival(self):
        if self.turn < LANTERN or "won" in self.flags:
            return
        self.say("Lantern Night! Bunting, a cake the size of a cart, the "
                 "fiddler tuning up, and the whole valley here in its best "
                 "ribbons.", "quest")
        if not self.p["items"].get("festival ribbon"):
            self.say("Everypony's wearing a festival ribbon but you. "
                     "Somepony tuts.", "bad")
        if len(self.returned) < 4:
            self.say("The Great Lantern hangs dark over the stage. It's "
                     "missing %d Heartstone%s." % (
                         4 - len(self.returned),
                         "s" if 4 - len(self.returned) > 1 else ""), "bad")

    def great_lantern(self):
        if "won" in self.flags:
            self.say("The Great Lantern shines, and shines, and the whole "
                     "valley is singing.", "good")
            return
        if len(self.returned) < 4:
            self.say("The Great Lantern, dark, with %d of its four "
                     "Heartstones. Grandmare Thistlewick will set the rest "
                     "in it... once you find them." % len(self.returned),
                     "info")
            return
        if self.turn < LANTERN:
            self.say("The Great Lantern, with all four Heartstones in "
                     "place. Not yet! Saturday, at sunset. (It's %s.)" %
                     self.date_text(), "info")
            return
        a = self.area
        if "agent_done" not in self.flags and not any(
                m.kind == "wyrm" for m in a.mobs):
            self.wyrm()
            return
        if any(m.kind == "wyrm" and m.hostile for m in a.mobs):
            self.say("Not with the Greymist Wyrm in the hall!", "bad")
            return
        self.light()

    def wyrm(self):
        """The Gloom's last try: the Greymist itself, in the Lantern
        Hall."""
        a = self.area
        who = self.world["people"][self.world["agent"]]
        self.say(fill("You reach for the Lantern... and the doors blow "
                      "open, and a grey fog pours in. In the middle of it is "
                      "{agent_full}, {agent_title}! 'NO LANTERN!' "
                      "{agent_he} howls, and the fog rises up around "
                      "{agent_him} into the Greymist Wyrm, long as the hall "
                      "and grey as rain.", self.world), "bad")
        self.sound.play("horror")
        x, y = self.pos
        spots = sorted(((sx, sy) for sy in range(a.h) for sx in range(a.w)
                        if a.grid[sy][sx] == "floor" and
                        not a.mob_at(sx, sy) and [sx, sy] != self.pos),
                       key=lambda s: -abs(s[1] - y))
        bx, by = spots[0]
        m = make_monster("wyrm", bx, by, boss=True)
        m.name = "the Greymist Wyrm (%s)" % who["name"]
        m.leader = True
        m.aware = True
        a.mobs = [mob for mob in a.mobs if mob.hostile or mob.ally or
                  mob.role in ("festival", "thistlewick")] + [m]
        for mob in a.mobs:
            if not mob.hostile:
                mob.roam = None
        self.render()

    def light(self):
        a = self.area
        for row in a.grid:
            for x, t in enumerate(row):
                if t == "lantern_dark":
                    row[x] = "lantern_lit"
        self.flags.add("won")
        self.say("You touch the Great Lantern, and the four Heartstones "
                 "catch, one after another: dawn, dusk, hearth and hope. "
                 "Light pours out of the windows of the Lantern Hall and "
                 "down the valley, and up on the hills the Greymist turns "
                 "tail and rolls away for another year.", "quest")
        self.sound.play("quest")
        if self.ok("Performance", 12, label="leading the Lantern song"):
            self.say("You lead the Lantern song, and the whole valley joins "
                     "in. Even the gloomlings hum along.", "good")
            self.flags.add("sang")
        self.save()
        self.render()
        self.root.after(1200, self.show_won)

    def rating(self):
        p = self.p
        return 1 + ("agent_done" in self.flags) + bool(
            p["items"].get("festival ribbon")) + ("sang" in self.flags) + (
            len(p["friends"]) >= 3)

