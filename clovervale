# ── Dice ─────────────────────────────────────────────────────────────────────


def roll(expr, rng=random):
    """Dice such as '1d6+1d4', '2d6+3', '-1d4', '1d3' or '0'."""
    total = 0
    for sign, term in re.findall(r"([+-]?)(\d+d\d+|\d+)",
                                 str(expr).replace(" ", "")):
        if "d" in term:
            n, s = (int(v) for v in term.split("d"))
            v = sum(rng.randint(1, s) for _ in range(n))
        else:
            v = int(term)
        total += -v if sign == "-" else v
    return total


# The Skill die ladder: rank 1 is a d2, rank 6 a d12; past that a Skill rolls
# two d8s, then three d6s, then simply succeeds.
RANK_DICE = {1: (2,), 2: (4,), 3: (6,), 4: (8,), 5: (10,), 6: (12,),
             7: (8, 8), 8: (6, 6, 6)}
AUTO_RANK = 9


def die_name(rank):
    if rank <= 0:
        return "-"
    if rank >= AUTO_RANK:
        return "auto"
    d = RANK_DICE[rank]
    return "d%d" % d[0] if len(d) == 1 else "%dd%d" % (len(d), d[0])


