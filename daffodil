    def dress_her(self, c, new=False):
        d = self.d
        first = "clothes" not in self.p["quests"]
        if new:
            self.take_item(c)
            d["wardrobe"].append(c)
            self.her_say("dress")
            self.affection(1, "loves it" if c in ("evening gown",
