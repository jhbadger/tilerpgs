    # ── Things ──

    def give_item(self, n, k=1):
        p = self.p
        p["items"][n] = p["items"].get(n, 0) + k
        self.flags.add("got:" + n)
        if n in USAGE and n not in p["usage"]:
            p["usage"][n] = USAGE[n]
        if n in ARMOR or n in SHIELD:
            self.wear_armor(p)
            p["ap"] = p["maxap"]

    def take_item(self, n, k=1):
        p = self.p
        p["items"][n] = p["items"].get(n, 0) - k
        if p["items"][n] <= 0:
            del p["items"][n]
            p["usage"].pop(n, None)

    def use_item(self, n, quiet=False):
        """A thing with a usage die: roll it; 1 or 2 and it drops a size,
        and 1 or 2 on a d4 and it's gone."""
        p = self.p
        die = p["usage"].get(n)
        if not die:
            self.take_item(n)
            return
        r = random.randint(1, die)
        if r <= 2:
            if die == 4:
                self.take_item(n)
                if not quiet:
                    self.say("[usage d4: %d] That's the last of the %s." %
                             (r, n), "info")
                return
            p["usage"][n] = USAGE_CHAIN[USAGE_CHAIN.index(die) + 1]
            if not quiet:
                self.say("[usage d%d: %d] The %s is running low (d%d)." % (
                    die, r, n, p["usage"][n]), "info")

    def use_menu(self):
        if not self.ready():
            return
        p = self.p
        d = self.d
        items = []
        for food, text in (("burrito", "Eat the burrito (1d6 HP)"),
                           ("coffee", "Drink the coffee (1d4 HP)"),
                           ("energy drink", "Drink the energy drink "
                                            "(1d4 HP)")):
            if p["items"].get(food):
                items.append((text, lambda f=food: self.eat(f)))
        if p["items"].get("first aid kit"):
            items.append(("First aid kit on yourself (1d6 HP)",
                          lambda: self.first_aid(False)))
            if d and d["state"] in ("awake", "down") and self.her_nearby(1):
                items.append(("First aid kit on %s" % d["name"],
                              lambda: self.first_aid(True)))
        if p["items"].get("charge pack") and d and self.her_nearby(2) and \
                d["charge"] < 12:
            items.append(("Plug a charge pack into %s" % d["name"],
                          self.charge_her))
        if not items:
            self.say("You've nothing to use just now.", "info")
            return
        items.append(("Never mind", lambda: None))
        self.open_menu("Use what?", items)

    def eat(self, food):
        self.take_item(food)
        self.heal(roll({"burrito": "1d6", "coffee": "1d4",
                        "energy drink": "1d4"}[food]))
        if food == "burrito" and random.random() < 0.15:
            self.say("...That burrito is fighting back.", "bad")

    def first_aid(self, her):
        self.use_item("first aid kit")
        n = roll("1d6")
        if her:
            d = self.d
            d["hp"] = min(d["maxhp"], d["hp"] + n)
            self.say("You patch up %s's synthskin. (%d/%d)" % (
                d["name"], d["hp"], d["maxhp"]), "good")
            if d["state"] == "down" and d["hp"] > 0:
                self.wake_her()
            return
        self.heal(n)

    def charge_her(self):
        self.take_item("charge pack")
        d = self.d
        d["charge"] = 12
        self.say("You plug the charge pack into the port behind %s's ear. "
                 "Her eyes brighten. (Charge d12)" % d["name"], "good")
        if d["state"] == "awake" and not d["with"]:
            pass

    # ── Apps, remedies and tricks ──

    def ability_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        if p["cls"] == "Bruiser":
            key = "second:%d" % (self.turn // 60)
            if key not in self.flags:
                items.append(("Second Wind (1d8 HP, once an hour)",
                              self.second_wind))
        if p["cls"] == "Medic":
            items.append(("Talk Down (humans near you back off)",
                          self.talk_down))
        for sid in p["spells"]:
            lv = SPELL_LEVEL[sid]
            name, text = SPELL_NAMES[sid]
            if p["slots"][lv - 1] > 0:
                items.append(("%s (L%d): %s" % (name, lv, text),
                              lambda s=sid: self.cast(s)))
        if p["spells"] and not any(p["slots"]):
            self.say("You've used every %s you've got today. (Sleep "
                     "refreshes them.)" % ("app" if p["cls"] == "Geek" else
                                           "remedy"), "info")
        if not items:
            self.say("Nothing to use just now. (%s)" % CLASSES[p["cls"]]
                     .special, "info")
            return
        items.append(("Never mind", lambda: None))
        self.open_menu("Slots: L1 %d, L2 %d" % tuple(p["slots"])
                       if p["spells"] else "Tricks", items)

    def second_wind(self):
        self.flags.add("second:%d" % (self.turn // 60))
        self.heal(roll("1d8"))
        self.say("You shake your head, roll your shoulders, and grin.",
                 "good")
        self.end_turn()

    def cast(self, sid):
        """An app or a remedy: it works, then you test INT (or WIS) plus
        its level, and if you fail, that's a slot gone."""
        p = self.p
        lv = SPELL_LEVEL[sid]
        name = SPELL_NAMES[sid][0]
        d = self.d
        a = self.area
        px, py = self.pos
        near = [m for m in a.mobs if m.hostile and
                abs(m.x - px) + abs(m.y - py) <= 6 and
                (m.x, m.y) in self.visible]
        if sid in ("zap", "spoof") and not near:
            self.say("There's nothing in sight to %s." % (
                "zap" if sid == "zap" else "spoof"), "info")
            return
        self.say("%s: %s." % (p["first"], name), "you")
        if sid == "torch":
            p["torch"] = 60
            self.say("Your phone lights up the dark.", "good")
        elif sid == "zap":
            t = min(near, key=lambda m: abs(m.x - px) + abs(m.y - py))
            dmg = roll("%dd4" % p["level"])
            t.hp -= dmg
            t.aware = True
            self.flash(t.x, t.y, "zap")
            self.say("Your drone zaps %s. (%d)" % (self.the(t), dmg),
                     "good")
            if t.hp <= 0:
                self.beaten(t)
        elif sid == "firewall":
            p["firewall"] = 1
            self.wear_armor(p)
            p["ap"] += 2 * p["level"]
            self.say("Firewall up: +%d Armor Points." % (2 * p["level"]),
                     "good")
        elif sid == "shutdown":
            pool = roll("4d6")
            for m in sorted([m for m in a.mobs if m.hostile and "robot" in
                             MONSTERS[m.kind].traits and abs(m.x - px) +
                             abs(m.y - py) <= 6],
                            key=lambda m: MONSTERS[m.kind].hd):
                hd = MONSTERS[m.kind].hd
                if hd > pool or m.boss:
                    continue
                pool -= hd
                m.stuck = 30
                self.flash(m.x, m.y, "zzz")
                self.say("%s powers down." % cap(self.the(m)), "good")
        elif sid == "spoof":
            robots = [m for m in near if "robot" in MONSTERS[m.kind].traits
                      and not m.boss]
            if not robots:
                self.say("Spoof only works on robots.", "info")
            else:
                t = robots[0]
                if self.test("INT", mod=MONSTERS[t.kind].hd,
                             adv=True, label="spoofing"):
                    t.hostile = False
                    t.roam = set(DUNGEON_FLOOR) | CITY_GROUND
                    self.say("%s decides you're its owner, and wanders off "
                             "to wait for orders." % cap(self.the(t)),
                             "good")
                else:
                    self.say("%s isn't fooled." % cap(self.the(t)), "bad")
        elif sid == "unlock":
            hit = False
            for (x, y), what in list(a.terminals.items()):
                if abs(x - px) + abs(y - py) <= 1 and what in ("safe",):
                    self.open_safe(force=True)
                    hit = True
            if not hit:
                self.say("Nothing locked here. (Unlock works on safes, and "
                         "it makes the core easier.)", "info")
                p["unlock"] = self.turn + 10
        elif sid == "ghost":
            p["ghost"] = 10
            for m in a.mobs:
                if m.hostile and "robot" in MONSTERS[m.kind].traits:
                    m.aware = False
            self.say("Cameras and robots can't see you. (Ten minutes.)",
                     "good")
        elif sid == "blackout":
            for m in a.mobs:
                if m.hostile:
                    m.aware = False
                    m.flee = 4
            self.say("Every light near you goes out. Shouting, in the "
                     "dark.", "good")
        elif sid == "patch":
            self.remedy_heal("1d8")
        elif sid == "second":
            self.remedy_heal("2d8")
            p["temp"].pop("fathead", None)
        elif sid == "pep":
            p["pep"] = 3
            self.say("You tell yourself you've got this. You've got this. "
                     "(Advantage on your next three tests)", "good")
        elif sid == "calm":
            for m in a.mobs:
                if m.hostile and "human" in MONSTERS[m.kind].traits and \
                        abs(m.x - px) + abs(m.y - py) <= 5 and not m.boss:
                    m.stuck = roll("1d4")
                    self.say("%s stops, breathes, and stands very still." %
                             cap(self.the(m)), "good")
        elif sid == "smelling":
            if d and d["state"] == "down" and self.her_nearby(1):
                d["hp"] = max(1, d["hp"])
                self.wake_her()
            else:
                p["out"] = 0
                self.say("Bracing! Your eyes water.", "good")
        stat = "INT" if p["cls"] == "Geek" else "WIS"
        if not self.test(stat, mod=lv, adv=p["cls"] == "Geek" and False,
                         label="keeping the slot"):
            p["slots"][lv - 1] = max(0, p["slots"][lv - 1] - 1)
            self.say("(That's a level %d slot used up for today: %d left.)"
                     % (lv, p["slots"][lv - 1]), "info")
        self.end_turn()

    def remedy_heal(self, dice):
        d = self.d
        if d and d["state"] in ("awake", "down") and self.her_nearby(1) and \
                d["hp"] < d["maxhp"] and self.p["hp"] * 2 > self.p["maxhp"]:
            n = roll(dice)
            d["hp"] = min(d["maxhp"], d["hp"] + n)
            self.say("You patch up %s. (%d/%d)" % (d["name"], d["hp"],
                                                   d["maxhp"]), "good")
            if d["state"] == "down":
                self.wake_her()
            return
        self.heal(roll(dice))

    def wake_her(self):
        d = self.d
        d["state"] = "awake"
        for m in self.area.mobs:
            if m.her:
                m.ally = d["with"]
        self.say("%s's eyes flicker open. 'Rebooting... I'm back.'" %
                 d["name"], "her")

    def luck_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        if p["luck"] >= 1 and not p["lucky"]:
            items.append(("Spend a point: reroll your next failed test (%d)"
                          % p["luck"], self.buy_lucky))
        if p["luck"] >= 1:
            items.append(("Spend a point on a hunch: what next?",
                          self.buy_hint))
        if not items:
            self.say("You're out of Luck. (A natural 20, a glorious mess, "
                     "earns a point back.)" if not p["lucky"] else
                     "You're feeling lucky already.", "info")
            return
        items.append(("Never mind", lambda: None))
        self.open_menu("Luck: %d" % p["luck"], items)

    def buy_lucky(self):
        self.p["luck"] -= 1
        self.p["lucky"] = True
        self.say("You feel lucky. (Your next failed test is rolled again.)",
                 "good")

    def buy_hint(self):
        self.p["luck"] -= 1
        self.say("A hunch: %s" % self.hint(), "quest")

    def hint(self):
        d = self.d
        p = self.p
        q = p["quests"]
        if not d:
            return "The Daffodil store on Galleria Parkway. Design her."
        if d["state"] == "ordered":
            return "She's on her way: home by %02d:%02d." % (
                (START + datetime.timedelta(
                    minutes=self.st["delivery_at"])).hour,
                (START + datetime.timedelta(
                    minutes=self.st["delivery_at"])).minute)
        if d["state"] == "box":
            return "There's a box in your living room. Open it."
        if not d["wardrobe"]:
            return "She's got nothing to wear. MegaMart, or the Glamour Box."
        if d["state"] == "crashed":
            return "She's frozen. Talk to her: press the button on the back "\
                "of her neck."
        if d["state"] == "taken":
            return "They took her to Rusty's. The stairs in his office go "\
                "down."
        if "dinner_done" not in self.flags and self.turn < DINNER + 150:
            return "Dinner at your sister's, Wednesday at seven. Bring her."
        if "reset_news" in self.flags and not d["backup"] and \
                not self.st["pulled"]:
            return "Update 7.2 will wipe her. A memory crystal at Volt's, "\
                "or pull the flag at the Dataplex core."
        if "rusty" not in q:
            return "Mr. Okafor in the park saw a red tow truck. RUSTY'S."
        if len(self.st["evidence"]) < 2:
            return "%s wants evidence. Rusty's books, the " \
                "Dataplex logs, Vane at the casino on a Friday." % \
                self.world["people"]["detective"]["short"]
        return "The Dataplex core: pull the flag before midnight on Sunday."

    # ── Searching ──

    def search(self):
        if not self.ready():
            return
        a = self.area
        x, y = self.pos
        self.pass_time(10, quiet=True)
        spots = [(x + dx, y + dy) for dx, dy in DIRS + ((0, 0),)]
        found = [s for s in spots if s in a.hidden]
        if found and self.test("WIS", label="searching",
                               adv=self.p["cls"] == "Hustler"):
            for s in found:
                thing = a.hidden.pop(s)
                if thing == "coins":
                    n = roll("2d6") * 5
                    self.p["coins"] += n
                    self.say("Cash, stuffed in a crack. ($%d)" % n, "gold")
                else:
                    self.give_item(thing)
                    self.say("You find %s." % an(thing), "gold")
        else:
            self.say("You look around carefully. Nothing.", "info")
        self.end_turn()

    def step_on(self, x, y):
        a = self.area
        thing = a.items.get((x, y))
        if thing in ("badge", "chest"):
            body = a.bodies.pop((x, y), {"things": []})
            del a.items[(x, y)]
            for t in body["things"]:
                self.give_item(t)
                self.say("You find %s!" % an(ITEMS[t][0].split(":")[0]),
                         "gold")
            self.sound.play("gold")
            return True
        if thing == "coins":
            del a.items[(x, y)]
            n = roll("2d6") * 5
            self.p["coins"] += n
            self.say("Money! ($%d)" % n, "gold")
            return True
        return False

    def open_loot(self, x, y):
        a = self.area
        if (x, y) not in a.loot:
            self.say("Empty.", "info")
            return
        a.loot.discard((x, y))
        a.grid[y][x] = "crate_open"
        self.flags.add("loot:%s:%d:%d:%d" % (a.key[1], a.key[2], x, y))
        r = random.random()
        if r < 0.4:
            n = roll("2d6") * 5
            self.p["coins"] += n
            self.say("A crate: a cash box, forgotten. ($%d)" % n, "gold")
        elif r < 0.6:
            self.give_item("first aid kit")
            self.say("A crate: a first aid kit.", "gold")
        elif r < 0.75:
            self.give_item("charge pack")
            self.say("A crate: a Daffodil charge pack, still sealed.", "gold")
        else:
            self.say("A crate: robot hands. Just... hands. In a bag.",
                     "info")

    def use_terminal(self, x, y):
        a = self.area
        what = a.terminals[(x, y)]
        if what == "lore":
            self.say(getattr(a, "note", "Nothing much."), "talk")
            return
        if what.startswith("evidence:"):
            e = what.split(":")[1]
            if "evidence:" + e in self.flags:
                self.say("You've got what was here.", "info")
                return
            self.pass_time(10, quiet=True)
            if e == "orders" or self.test(
                    "INT", label="the terminal", adv=self.her_helps_tech()):
                self.got_evidence(e)
            else:
                self.say("ACCESS DENIED. Try again.", "bad")
                self.alert(8)
            self.end_turn()
            return
        if what == "safe":
            self.open_safe()
            return
        if what == "core":
            self.core()

    def her_helps_tech(self):
        d = self.d
        return bool(d) and "Tech Suite" in d["mods"] and self.her_here() or \
            self.p["cls"] == "Geek"

    def open_safe(self, force=False):
        if "got:core badge" in self.flags:
            self.say("The safe's open, and empty.", "info")
            return
        if force or self.test("DEX", label="the safe",
                              adv=self.p["cls"] == "Hustler"):
            self.give_item("core badge")
            self.say("Click. Inside: a gold core badge.", "gold")
        else:
            self.say("The dial won't give.", "bad")
        self.end_turn()

    def alert(self, r):
        for m in self.area.mobs:
            if m.hostile and abs(m.x - self.pos[0]) + abs(
                    m.y - self.pos[1]) <= r:
                m.aware = True

    def got_evidence(self, e):
        if e in self.st["evidence"]:
            return
        self.flags.add("evidence:" + e)
        self.st["evidence"].append(e)
        self.say("EVIDENCE: %s." % EVIDENCE[e], "quest")
        self.learn("vane")
        self.sound.play("quest")

    def core(self):
        """The top of the Dataplex: pull the flag."""
        p = self.p
        st = self.st
        if st["pulled"]:
            self.say("The core hums. Update 7.2 is staged, clean: no "
                     "CORE_RESET. Every Daffodil will wake up on Monday as "
                     "herself.", "good")
            return
        if self.turn >= UPDATE:
            return
        if any(m.kind == "paragon" for m in self.area.mobs):
            self.say("The Paragon stands between you and the console.",
                     "bad")
            return
        self.pass_time(10, quiet=True)
        if p["items"].get("override key"):
            self.say("You slot Gearhart's override key into the console. "
                     "It asks you, very politely, which flag you'd like to "
                     "remove. CORE_RESET. Are you sure? You're sure.",
                     "good")
            ok = True
        else:
            ok = self.test("INT", mod=4 - (2 if p.get("unlock", -1) >=
                                           self.turn else 0),
                           adv=self.her_helps_tech(), label="the core")
            if ok:
                self.say("You dig through the staging config, find "
                         "CORE_RESET=TRUE, and change it to FALSE. Your "
                         "hands are shaking.", "good")
        if ok:
            st["pulled"] = True
            self.got_evidence("log")
            self.say("Update 7.2 is clean. Nobody's getting wiped.",
                     "quest")
            self.quest_done("core", "Update 7.2 is clean")
            if self.d and self.her_here():
                self.her_say("love")
                self.affection(2, "watched you save her")
        else:
            self.say("ERROR. The console locks you out for a minute. "
                     "Alarms.", "bad")
            self.alert(12)
        self.end_turn()

    # ── Clues ──

    def learn(self, cid, quiet=False):
        if cid in self.clues:
            return
        self.clues.append(cid)
        if not quiet:
            self.say("(Your journal has a new entry. J reads it.)", "quest")
            self.sound.play("gold")

    def hear(self, text):
        """Words in CAPITALS: things to ask about."""
        words = re.findall(r"\b[A-Z][A-Z']{2,}\b", text)
        skip = {"BYE", "HI", "ME", "YOU", "THE", "AND", "OK", "HEY", "NOT",
                "WELCOME", "MEGAMART", "GRETA", "GEARHART", "AM", "MAY",
                "HELP", "HOW", "TODAY", "THIS", "WOMEN'S", "MEN", "BE",
                "IS", "DO", "DAFFODIL", "ROBOTS", "SMILE", "IT'S", "I'M",
                "GREET", "ALSO", "SELL", "THINGS", "HAVE", "BEEN", "TOLD",
                "SAY", "GOOD", "VALUE", "ARE", "OVERPRICED", "ASHAMED",
                "AISLE", "THREE", "NORMAL", "STANDING", "LOOKING", "LOST",
                "CLOTHING", "FEELINGS", "SUBROUTINE", "MODEL", "GREETBOT",
                "AUTOMATIC", "ROBOTICS", "THEY", "ALONE", "LEAVE", "HAPPY",
                "FINE", "AGAIN", "FINALLY", "NOW", "DID", "IT", "OF", "WE",
                "LIKE", "ONE", "TWO", "WHAT", "FOR", "WHO", "WITH", "THAT"}
        self.heard = [re.sub(r"'S?$", "", w) for w in words
                      if w not in skip and
                      not re.fullmatch(r"[IVXLC]+", w)]

    # ── Talking ──

    def speaker(self, mob):
        if mob.her:
            return self.d.get("name") or "Your Daffodil"
        return cap(mob.name) if mob.known or mob.role in (
            "sister", "inlaw", "vane", "detective") or mob.kind else \
            cap(mob.title)

    def npc_say(self, mob, text):
        text = fill(text, self.world)
        self.say("%s: %s" % (self.speaker(mob), text), "talk")
        self.hear(text)


    def start_talk(self, mob):
        if mob.her:
            self.her_start(mob)
            return
        if mob.event and self.event_talk(mob):
            return
        if mob.stolen is not None:
            self.wake_stolen(mob)
            return
        self.talk = {"mob": mob, "mode": "kw"}
        self.heard = []
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Ask about:")
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        self.say("You talk to %s." % mob.title, "info")
        e = mob.errand
        greet = mob.greet
        if e is not None and self.side.get(e["id"], {}).get("state") == \
                "active":
            greet = "Well? Did you get it?"
        if mob.role == "sister" and self.st.get("old_home") == "sister":
            greet = "{me}! Come see what {old} did with the kitchen!"
        d = self.d
        if mob.role == "neighbor" and d and d["with"] and \
                d.get("calls") == "Master":
            greet = "I heard what she calls you. The whole street heard. " \
                "I'm calling the homeowners' association."
        elif mob.role == "neighbor" and "delivered" not in self.flags:
            greet = random.choice((
                "Oh! It's you. You look tired. You always look tired.",
                "Morning. Your lawn needs mowing. I'm only saying.",
                "Still on your own in that big house? Well. It's none of "
                "my business.")) if not d else \
                "You've got a parcel coming? I'll keep an eye out. I always " \
                "keep an eye out."
        elif mob.role == "neighbor" and d and d["with"]:
            greet = "Oh! And this must be... the DELIVERY. Hello, dear. " \
                "Aren't you pretty. Aren't you VERY pretty."
        self.npc_say(mob, greet.replace("{old}", (self.st.get("old") or {})
                                        .get("name", "")))
        if e is not None and self.errand_ready(e):
            self.finish_errand(mob, e)
        if "talked" not in self.flags:
            self.flags.add("talked")
            self.say("(Choose what to ask about, or type a word such as "
                     "NAME, JOB or NEWS and press Return. BYE, or an empty "
                     "line, ends the conversation.)", "info")
        self.talk_menu()

    def talk_menu(self):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        p = self.p
        if t["mode"] == "buy":
            items = [("%d) %s%s" % (i, label, ", $%d" % price
                                    if price else ""),
                      lambda i=i: self.choose_words(str(i)))
                     for i, (label, price, _) in enumerate(self.offers(mob),
                                                           1)]
            items.append(("Nothing, thanks", lambda: self.choose_words("")))
            self.open_menu("Buy what? (you have $%d)" % p["coins"], items,
                           lambda: self.choose_words(""))
            return
        if mob.her:
            words = self.her_words()
        else:
            words = ["NAME", "JOB", "NEWS"]
            if mob.shop:
                words.append("BUY")
            if mob.errand is not None and self.side.get(
                    mob.errand["id"], {}).get("state") != "done":
                words.append("HELP")
            words += self.role_words(mob)
        for w in getattr(self, "heard", []):
            if w not in words and w != "BYE":
                words.append(w)
        self.open_menu("Ask %s about:" % self.speaker(mob),
                       [(w, lambda w=w: self.choose_words(w))
                        for w in words + ["BYE"]],
                       lambda: self.choose_words("bye"))

    def role_words(self, mob):
        r = mob.role
        d = self.d
        w = []
        if r == "consultant":
            w += ["DESIGN", "BADGE"] if d else ["DESIGN", "PRICE"]
        elif r == "volt":
            w += ["BACKUP", "REPAIR", "MODULE", "UPDATE"]
            if self.p["items"].get("old daffodil"):
                w.append("OLD")
        elif r == "trainer":
            w.append("WORKOUT")
        elif r == "detective":
            w += ["EVIDENCE", "STOLEN"]
        elif r == "pitboss":
            w.append("CARDS")
        elif r == "maitre":
            w.append("DINNER")
        elif r == "dj":
            w.append("DANCE")
        elif r == "attendant" and "old_bought" not in self.flags:
            w.append("OLD")
        elif r == "sister":
            if self.st.get("old") and self.st.get("old_home") is None:
                w.append("OLD")
            if self.dinner_now():
                w.append("DINNER")
        elif r == "vane":
            w += ["SUNDAY", "UPDATE"]
        elif r == "owner":
            w.append("JUNIPER")
        return w

    def choose_words(self, w):
        self.say("> " + (w or "nothing"), "you")
        self.converse(w.lower())
        self.talk_menu()

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if getattr(self, "p", None) and getattr(self, "area", None):
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if not self.talk:
            return
        self.menu = None
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())
        self.talk_menu()


    def converse(self, w):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        if t["mode"] == "buy":
            t["mode"] = "kw"
            if w.isdigit():
                self.buy(mob, int(w))
                return
            if not w:
                self.npc_say(mob, "Anything else?")
                return
        if not w or w.startswith("bye"):
            if mob.her:
                self.say("%s smiles at you." % self.d["name"], "her")
            else:
                self.npc_say(mob, random.choice(BYES))
            self.end_talk()
            return
        word = re.sub(r"'s?$", "", w.split()[0])
        if mob.her:
            self.her_converse(mob, word)
            return
        if word.startswith("name"):
            mob.known = True
            self.npc_say(mob, "%s, %s." % (mob.name, mob.title))
            return
        if word[:4] in ("help", "erra", "favo", "task", "need") and \
                mob.errand is not None:
            self.errand(mob)
            return
        if mob.shop and word[:3] in ("buy", "pur", "sho"):
            self.list_offers(mob)
            return
        if self.role_converse(mob, word):
            return
        reply = next((v for k, v in mob.talk.items()
                      if k[:4] == word[:4] or (len(k) < 4 and
                                               word.startswith(k))), None)
        if reply is None and word[:4] in ("heal", "how'", "how"):
            reply = random.choice(HEALTH)
        if reply is None:
            reply = next((v for k, v in TOPICS.items()
                          if word.startswith(k)), None)
        if reply is None:
            reply = random.choice(("Couldn't tell you.", "Huh?",
                                   "Never heard of it."))
        self.reply(mob, reply)
        for k, cid in (("stol", "thefts"), ("thef", "thefts"),
                       ("juni", "thefts"), ("truc", "thefts"),
                       ("rust", "rusty"), ("down", "rusty"),
                       ("upda", "reset" if mob.role == "volt" else None),
                       ("badg", "dataplex"), ("data", "dataplex"),
                       ("vane", "casino" if mob.role in ("pitboss",
                                                          "barista")
                        else None), ("old", "old" if mob.role ==
                                     "attendant" else None)):
            if word[:4] == k and cid:
                self.learn(cid, quiet=cid not in ("reset", "rusty"))
        self.render_chrome()

    def reply(self, mob, r):
        if isinstance(r, str):
            self.npc_say(mob, r)
            return
        if "check" in r:
            flag = r.get("flag")
            if flag and flag in self.flags:
                self.npc_say(mob, "I've done what I can for you.")
                return
            tried = "tried:%s:%s:%d" % (mob.role, flag, self.day_no())
            if tried in self.flags:
                self.npc_say(mob, r["fail"])
                return
            s, mod = r["check"]
            if self.test(s, mod=mod, label="persuading",
                         adv=self.her_here() and self.d["stats"]["CHA"] >= 13):
                self.npc_say(mob, r["ok"])
                if flag:
                    self.flags.add(flag)
                if r.get("give"):
                    self.give_item(r["give"])
                    self.say("You get the %s." % r["give"], "gold")
                    self.sound.play("gold")
            else:
                self.flags.add(tried)
                self.npc_say(mob, r["fail"])
            return
        self.npc_say(mob, r["say"])

    # ── Her ──

    def her_start(self, mob):
        d = self.d
        if d["state"] == "box":
            self.unbox()
            return
        if d["state"] == "setup" and d.get("ready_at") is not None and \
                self.turn >= d["ready_at"]:
            self.timers()
            return
        if d["state"] == "setup":
            left = max(0, d["ready_at"] - self.turn)
            self.say("%s stands perfectly still in the middle of the living "
                     "room. 'Primary setup in progress. %d hours %d minutes "
                     "remaining.'" % (d.get("name") or "Your Daffodil",
                                      left // 60, left % 60), "her")
            clothes = [c for c in CLOTHES if self.p["items"].get(c)]
            if clothes:
                for c in clothes:
                    self.take_item(c)
                    d["wardrobe"].append(c)
                d["wearing"] = d["wearing"] or clothes[0]
                self.say("You lay the %s over the arm of the sofa for her, "
                         "for when she's done." % " and the ".join(clothes),
                         "info")
            elif not d["wardrobe"]:
                self.say("(She's naked, which you're trying very hard not "
                         "to think about. She'll need clothes.)", "info")
            return
        if d["state"] == "crashed":
            self.reboot_menu()
            return
        if d["state"] == "down":
            self.say("%s is in safe mode, eyes closed. Get her out of here "
                     "and she'll reboot (or use a first aid kit, or "
                     "Smelling Salts)." % d["name"], "info")
            return
        if d["state"] == "taken" and self.area.kind == "dungeon":
            self.rescue_her(mob)
            return
        if d["state"] == "wiped":
            self.her_say("rebooted", self.world["serial"])
            return
        self.talk = {"mob": mob, "mode": "kw"}
        self.heard = []
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Say:")
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        self.her_say("greet")
        if d.get("wearing") in ("lingerie", "silk robe") and \
                self.area.site == "home":
            self.her_say("lounging", d["wearing"])
        key = "talkday:%d" % self.day_no()
        if key not in self.flags:
            self.flags.add(key)
            self.learns(2)
        self.talk_menu()

    def her_words(self):
        d = self.d
        p = self.p
        a = self.area
        words = ["NAME", "HOW", "YOU", "LIKES"]
        words.append("STAY" if d["with"] else "COME")
        if any(p["items"].get(g) for g in GIFTS):
            words.append("GIFT")
        if [c for c in d["wardrobe"] if c != d.get("wearing")] or \
                any(p["items"].get(c) for c in CLOTHES):
            words.append("WEAR")
        if d["affection"] >= 3:
            words.append("KISS")
        if a.site == "home" and self.phase() in ("dusk", "night") and \
                d["affection"] >= 2:
            words.append("BED")
        if "Driver" in d["mods"] and d["with"]:
            words.append("DRIVE")
        if "Masseuse" in d["mods"]:
            words.append("MASSAGE")
        words += ["DUTIES", "HELP"]
        return words

    def her_converse(self, mob, word):
        d = self.d
        w4 = word[:4]
        once = "said:%s:%d" % (w4, self.day_no())
        if once not in self.flags:
            self.flags.add(once)
            self.learns(1)
        if word.startswith("name"):
            if self.stage() == 0:
                self.say("%s: %s. %s" % (d["name"], d["name"],
                                         NAME_MEANINGS.get(d["name"],
                                                           "A good name.")),
                         "her")
            else:
                self.say("%s: It's %s. You gave it to me. I like it more "
                         "every day." % (d["name"], d["name"]), "her")
            return
        if w4 in ("how", "how'", "feel"):
            self.her_say("how", d["learning"]) if self.stage() == 0 else \
                self.her_say("how")
            if d["charge"] <= 6:
                self.say("(Her charge: d%d.)" % d["charge"], "info")
            return
        if w4 in ("you", "your", "tell", "abou"):
            self.her_say("you")
            return
        if w4 in ("like", "favo", "want"):
            likes = d["likes"]
            self.her_say("likes", cap(likes[0]) + " and " + likes[1] if
                         self.stage() > 0 else "")
            self.flags.add("knowlikes")
            return
        if w4 in ("come", "foll", "join"):
            self.invite(mob)
            return
        if w4 in ("stay", "home", "wait"):
            self.dismiss()
            self.her_say("stay")
            self.end_talk()
            return
        if w4 == "gift":
            self.end_talk()
            self.gift_menu()
            return
        if w4 in ("wear", "dres", "clot", "chan"):
            self.end_talk()
            self.wear_menu()
            return
        if w4 in ("kiss", "smoo"):
            if d["affection"] < 3:
                self.say("%s smiles, and wags a finger at you. 'Not yet. "
                         "Ask me again when I know you better.'" %
                         d["name"], "her")
                return
            self.her_say("kiss")
            self.flash(mob.x, mob.y, "heart")
            key = "kiss:%d" % self.day_no()
            if key not in self.flags:
                self.flags.add(key)
                self.affection(1, "kissed you back")
                self.learns(3)
            if self.area.kind != "inside" or self.area.site not in (
                    "home",):
                people = [m for m in self.area.mobs if m.role and
                          (m.x, m.y) in self.visible]
                if people:
                    self.say("%s pretends not to look." % self.speaker(
                        people[0]), "info")
            return
        if w4 in ("bed", "slee", "nigh"):
            if self.area.site != "home":
                self.say("%s: Here? %s" % (d["name"], {
                    "Prim": "Certainly not.",
                    "Playful": "Ha! Take me home first.",
                    "Naughty": "...Tempting. Home. Now."}[
                        d["design"]["spice"]]), "her")
                return
            self.end_talk()
            self.bedtime()
            return
        if w4 in ("driv", "car", "ride"):
            self.end_talk()
            self.drive_menu()
            return
        if w4 in ("mass", "rub"):
            key = "massage:%d" % self.day_no()
            if key in self.flags:
                self.say("%s: Again? You'll melt." % d["name"], "her")
                return
            self.flags.add(key)
            self.say("%s gives you a massage. Somewhere in the middle of "
                     "it you make a noise you'll deny making." % d["name"],
                     "her")
            self.heal(roll("1d6"))
            self.pass_time(20, quiet=True)
            return
        if w4 in ("duti", "job", "work", "chor"):
            self.say("%s: My duties: %s." % (d["name"], ", ".join(
                dict(DUTIES)[x].lower() for x in d["duties"]) or
                "whatever you need"), "her")
            return
        if w4 in ("help", "hint", "what", "next", "advi"):
            if self.stage() == 0:
                self.her_say("hint")
            else:
                self.say("%s: %s" % (d["name"], self.hint()), "her")
            return
        if w4 in ("love",):
            if d["affection"] >= 7:
                self.her_say("love")
            else:
                self.say("%s: Love? I'm still working out 'like'. Give me "
                         "time." % d["name"], "her")
            return
        if w4 in ("pret", "beau", "gorg", "hot", "cute", "sexy"):
            key = "compl:%d" % self.day_no()
            self.say("%s: %s" % (d["name"], random.choice((
                "You think so? I designed... well, you designed me. So "
                "that's a compliment to you, really.",
                "Say it again.", "Flatterer.")) if self.stage() else
                "Thank you. My appearance was specified by you."), "her")
            if key not in self.flags:
                self.flags.add(key)
                self.affection(1, "blushed")
            return
        if w4 in ("toas", "robo", "mach", "appl"):
            self.say("%s: I'm not a toaster, {you}. Toasters don't "
                     "remember your birthday." % d["name"], "her")
            if self.stage() > 0:
                self.affection(-1)
            return
        if w4 in ("upda", "7.2", "rese", "wipe"):
            if "reset_news" in self.flags:
                self.say("%s: %s" % (d["name"], "I don't want to forget "
                         "you. Not you. Not this week." if self.stage() > 0
                         else "Update 7.2 is scheduled for Sunday at "
                         "midnight. It will improve me."), "her")
            else:
                self.say("%s: Update 7.2 comes out Sunday week. It's "
                         "supposed to improve 'conversational warmth'. I "
                         "think I'm warm enough." % d["name"], "her")
            return
        if w4 in ("sist", "fami", "dinn"):
            self.say(self.f("%s: {sis}? I'd like to meet her. Do you think "
                            "she'll like me?" % d["name"]), "her")
            return
        self.say("%s: %s" % (d["name"], random.choice((
            "I don't know that word yet. Teach me?",
            "Hm. Ask me something else?",
            "I'll look that up. Later. Right now I'd rather look at you.")
            if self.stage() else ("I do not have information on that "
                                  "topic.",))), "her")

    def gift_menu(self):
        p = self.p
        items = [(cap(g), lambda g=g: self.give_gift(g)) for g in GIFTS
                 if p["items"].get(g)]
        items.append(("Never mind", lambda: None))
