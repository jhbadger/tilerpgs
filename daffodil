STOLEN_NAMES = ["Juniper", "Clementine", "Rosalind", "Delphine", "Marigold",
                "Wren", "Ophelia", "Bianca"]


def make_stolen(rng):
    names = ["Juniper"] + rng.sample(STOLEN_NAMES[1:], 2)
    out = []
    for i, name in enumerate(names):
        out.append({"name": name, "owner": "owner" if i == 0 else None,
                    "design": {"frame": "F", "skin": rng.randrange(6),
                               "hair": "Copper red" if i == 0 else
                               rng.choice(sorted(HAIR)),
                               "style": rng.choice(HAIRSTYLES),
                               "eyes": rng.choice(sorted(EYE_COLORS))},
                    "wearing": rng.choice(("sundress", "jeans",
                                           "little black dress"))})
    return out


def generate_world(seed):
    """The week: who is who, where things are."""
    rng = random.Random("%s:world" % seed)
    world = {"seed": seed, "people": make_people(rng)}
    world["stolen"] = make_stolen(rng)
    world["evidence"] = {e: list(rng.choice(p))
                         for e, p in EVIDENCE_PLACES.items()}
    events = list(EVENTS)
    rng.shuffle(events)
    world["events"] = {d: (events[d - 1], rng.randint(11, 15))
                       for d in range(1, 7)}
    world["errands"] = [dict(e) for e in ERRANDS]
    world["serial"] = "%05d-PFN-%03d-XGN-F%04d" % (
        rng.randrange(100000), rng.randrange(1000), rng.randrange(10000))
    world["hero_name"] = person_name(rng, "M")
    return world


