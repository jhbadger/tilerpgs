def block_rect(i, j, half=None):
    x0, x1 = COR_X[i] + 2, COR_X[i + 1] - 2
    y0, y1 = COR_Y[j] + 2, COR_Y[j + 1] - 2
    if half == "L":
        x1 = x0 + 4
    elif half == "R":
        x0 = x1 - 4
    return x0, y0, x1, y1


def district(x, y):
    """Where in town a square is."""
    for cy, name in STREETS.items():
        if abs(y - cy) <= 1 and COR_X[0] - 1 <= x <= COR_X[-1] + 1:
            near = min(COR_X, key=lambda c: abs(c - x))
            return name + (" at %s Avenue" % AVENUES[near]
                           if abs(near - x) <= 1 else "")
    for cx, name in AVENUES.items():
        if abs(x - cx) <= 1 and COR_Y[0] - 1 <= y <= COR_Y[-1] + 1:
            return name + " Avenue"
    x0, y0, x1, y1 = block_rect(*SQUARE)
    if x0 <= x <= x1 and y0 <= y <= y1:
        return "Bellwether Park"
    x0, y0, x1, y1 = block_rect(0, 1)
    if x0 - 1 <= x <= x1 + 1 and y0 - 1 <= y <= y1 + 1:
        return "your front yard"
    if not (COR_X[0] <= x <= COR_X[-1] and COR_Y[0] <= y <= COR_Y[-1]):
        return "the greenbelt at the edge of town"
    return "a parking lot"


def make_city(world, flags):
    """Bellwether: the same every game but for what's been done."""
    rng = random.Random("bellwether")
    W, H = CITY_W, CITY_H
    g = [[("grass" if rng.random() < 0.85 else "flowers") for _ in range(W)]
         for _ in range(H)]
    area = Area("city", ("city",), g, "Bellwether", edge="grass")
    for x in range(W):              # the creek path along the top
        g[1][x] = "path"
    for y in range(H):
        for x in range(W):
            if (x < 2 or x >= W - 2 or y >= H - 2 or y in (0, 2)) and \
                    rng.random() < 0.4:
                g[y][x] = rng.choice(("tree", "hedge", "tree"))
    for j in range(3):
        for i in range(4):
            x0, y0, x1, y1 = block_rect(i, j)
            for y in range(y0 - 1, y1 + 2):
                for x in range(x0 - 1, x1 + 2):
                    g[y][x] = "lot"
    for y in COR_Y:                     # the streets: road, sidewalks
        for x in range(COR_X[0] - 1, COR_X[-1] + 2):
            g[y][x] = "road"
            for dy in (-1, 1):
                if g[y + dy][x] != "road":
                    g[y + dy][x] = "sidewalk"
    for x in COR_X:
        for y in range(COR_Y[0] - 1, COR_Y[-1] + 2):
            g[y][x] = "road"
            for dx in (-1, 1):
                if g[y][x + dx] != "road":
                    g[y][x + dx] = "sidewalk"
    for x in COR_X:
        for y in COR_Y:
            g[y][x] = "crossing"
    for y in range(COR_Y[0] - 1, COR_Y[-1] + 2, 4):     # streetlamps
        for x in (COR_X[0] - 1, COR_X[-1] + 1):
            if g[y][x] == "sidewalk":
                g[y][x] = "lamp"
    for x in range(COR_X[0] + 3, COR_X[-1], 5):
        for y in (COR_Y[1] - 1, COR_Y[1] + 1, COR_Y[2] - 1):
            if g[y][x] == "sidewalk":
                g[y][x] = "lamp"
    # Bellwether Park: lawns, paths, the fountain, the duck pond
    x0, y0, x1, y1 = block_rect(*SQUARE)
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = rng.choice(("grass", "grass", "grass", "flowers"))
    cx, cy = (x0 + x1) // 2, (y0 + y1) // 2
    for x in range(x0, x1 + 1):
        g[cy][x] = "path"
    for y in range(y0, y1 + 1):
        g[y][cx] = "path"
    for x, y in ((x0, y0), (x1, y0), (x0, y1), (x1, y1), (x0 + 2, y0 + 1),
                 (x1 - 2, y1 - 1)):
        g[y][x] = "tree"
    g[cy][cx] = "fountain"
    area.labels[(cx, cy)] = "the fountain"
    for y in range(y0 + 1, y0 + 4):
        for x in range(x1 - 4, x1 - 1):
            g[y][x] = "pool"
    area.labels[(x1 - 3, y0 + 2)] = "the duck pond"
    area.pond = (x1 - 3, y0 + 2)
    for x, y in ((cx - 2, cy - 1), (cx + 2, cy + 1)):
        g[y][x] = "plaza"
    area.park = (x0, y0, x1, y1)
    # the places
    for sid, (name, kind, (i, j, half), look) in SITES.items():
        bx0, by0, bx1, by1 = block_rect(i, j, half)
        if sid == "home":
            # a little house, set back behind a lawn and a hedge
            for y in range(by0, by1 + 1):
                for x in range(bx0, bx1 + 1):
                    g[y][x] = "grass"
            for x in range(bx0, bx1 + 1):
                g[by1 + 1][x] = "hedge"
            hx0, hx1 = bx0 + 2, bx1 - 2
            for y in range(by0, by1 - 3):
                for x in range(hx0, hx1 + 1):
                    g[y][x] = look
            door = ((hx0 + hx1 + 1) // 2, by1 - 4)
            for y in range(door[1] + 1, by1 + 2):
                g[y][door[0]] = "path"
            for x in (hx0, hx1):
                g[by1 - 2][x] = "flowers"
            g[door[1]][door[0]] = "door"
            area.links[door] = ("bld", sid)
            area.labels[door] = "your house"
            continue
        for y in range(by0, by1 + 1):
            for x in range(bx0, bx1 + 1):
                g[y][x] = look
        if sid in ("casino", "galleria", "club", "dataplex"):
            g[by0][(bx0 + bx1) // 2] = "sign"
        if sid == "gearhart":
            g[by0][(bx0 + bx1) // 2] = "billboard"
        if sid == "scrapyard":
            for y in range(by0, by1 + 1):
                for x in range(bx0, bx1 + 1):
                    g[y][x] = "fence" if (x in (bx0, bx1) or y in (by0, by1)
                                          ) else rng.choice(("lot", "lot",
                                                             "steel"))
            for x in range(bx0 + 3, bx1 - 2):
                for y in range(by1 - 4, by1):
                    g[y][x] = "lot"
            for y in range(by1 - 4, by1 + 1):
                for x in range(bx0 + 4, bx0 + 9):
                    g[y][x] = "steel"
            door = (bx0 + 6, by1)
            g[door[1]][door[0]] = "door"
            for y in range(by1 - 3, by1):
                g[y][door[0]] = "steel"
            area.links[door] = ("bld", sid)
            area.labels[door] = name
            continue
        door = ((bx0 + bx1 + 1) // 2, by1)
        g[door[1]][door[0]] = "door"
        area.links[door] = ("bld", sid)
        area.labels[door] = name
    area.start = (COR_X[1] - 1, COR_Y[1] + 1)
    return area


