    for role, (tile, sex, honorific, title) in ROLES.items():
        name = None
        while not name or name in used or name.split()[-1] in {
                n.split()[-1] for n in used}:
            name = person_name(rng, sex)
        used.add(name)
        first, last = name.split()
        if role == "volt":
            name, first, last = "Volt " + last, "Volt", last
        if role == "rusty_npc":
            name, first, last = "Rusty " + last, "Rusty", last
        if role == "vane":
            name, first, last = "Preston Vane", "Preston", "Vane"
        if role == "martbot":
            name, first, last = "Greta Greeter", "Greta", "Greeter"
        full = ("%s %s" % (honorific, name)) if honorific else name
        short = ("%s %s" % (honorific, name.split()[-1])) if honorific \
            else first
        people[role] = {"first": first, "sex": sex, "tile": tile,
                        "name": full, "short": short, "title": title,
                        "hon": honorific}
    return people


