    # ── Journal and sheets ──

    def journal(self):
        if self.busy or self.talk:
            return
        if self.overlay == "journal":
            self.close_overlay()
            return
        p = self.p
        lines = ["JOURNAL, %s" % self.date_text().upper(), ""]
        left = UPDATE - self.turn
        if "reset_news" in self.flags and left > 0:
            lines.append("Update 7.2 in %d hours %d minutes (Sunday "
                         "midnight)." % (left // 60, left % 60))
            lines.append("")
        for cid in self.clues:
            lines.append("* " + self.f(CLUES[cid]))
        if self.st["evidence"]:
            lines += ["", "Evidence: " + "; ".join(
                EVIDENCE[e] for e in self.st["evidence"])]
        if self.st["rescued"]:
            lines += ["", "Rescued: " + ", ".join(
                self.world["stolen"][i]["name"]
                for i in self.st["rescued"])]
        done = {"buy": "Bought a Daffodil", "setup": "Woke her up",
                "clothes": "Dressed her", "fit": "Fit for duty",
                "dinner": "Dinner with your sister", "date": "A date",
                "dance": "Won the dance-off", "casino": "Beat the casino",
                "rusty": "Shut down the chop shop",
                "rescue_her": "Got her back", "rescued": "Freed them all",
                "juniper": "Juniper home", "backup": "A backup crystal",
                "old": "A home for the old Daffodil",
                "vane": "Vane arrested", "core": "Pulled the flag"}
        if p["quests"]:
            lines += ["", "Done: " + ", ".join(done.get(q, q)
                                              for q in p["quests"])]
        wrapped = []
        for ln in lines:
            wrapped += wrap(ln, 66) or [""]
        self.overlay = "journal"
        self.overlay_text = "\n".join(wrapped)
        self.render()

