        self.say("%s's face changes, all at once, like a light coming on. "
                 "'{you}? What happened? Why are you looking at me like "
                 "that?'".replace("{you}", self.f("{you}")) % d["name"],
                 "her")
        self.say("You hold on to her for a long time. All of her, it turns "
                 "out, lived on a server on Mill Road.", "info")
        self.affection(1, "held on")
