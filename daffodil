class Area:
    """A map: the town, a building, or a level below."""

    def __init__(self, kind, key, grid, name, edge=None, dark=False):
        self.kind, self.key, self.grid, self.name = kind, key, grid, name
        self.h, self.w = len(grid), len(grid[0])
        self.edge = edge
        self.dark = dark
        self.mobs = []
        self.items = {}         # (x, y) -> thing lying there
        self.bodies = {}        # (x, y) -> what's in a chest
        self.links = {}         # (x, y) -> ("bld", site) or ("lead", lead)
        self.labels = {}        # (x, y) -> what it is
        self.hidden = {}        # (x, y) -> found by searching
        self.loot = set()       # crates not yet opened
        self.terminals = {}     # (x, y) -> what a terminal holds
        self.skin = {}
        self.seen = bytearray(self.w * self.h)
        self.opaque = OPAQUE[kind]
        self.start = (0, 0)
        self.down = None
        self.site = None
        self.lead = None
        self.specials = []
        self.spots = {}
        self.bonked = 0
        self.lit = set()


    def inside(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h

    def mob_at(self, x, y):
        for m in self.mobs:
            if m.x == x and m.y == y:
                return m
        return None


class Mob:
    def __init__(self, tile, name, x, y):
        self.tile, self.name, self.x, self.y = tile, name, x, y
        self.kind = None
        self.hostile = False
        self.hp = 1
        self.boss = False
        self.flee = 0
        self.aware = False
        self.stuck = 0
        self.title = name
        self.role = None
        self.her = False        # your Daffodil
        self.stolen = None      # which stolen Daffodil this is
        self.talk, self.greet = {}, ""
        self.known = False
        self.shop = None
        self.roam = None
        self.errand = None
        self.ally = False
        self.visitor = False
        self.event = None
        self.met = False


def make_monster(kind, x, y, boss=False, rng=random):
    m = MONSTERS[kind]
    mob = Mob(m.tile, m.name, x, y)
    mob.kind = kind
    mob.hostile = True
    mob.hp = max(2, roll("%dd8" % m.hd, rng)) if m.hd > 1 else \
        roll("1d6", rng)
    mob.boss = boss or "boss" in m.traits
    return mob


def role_talk(world, role):
    greet, talk = ROLE_TALK.get(role, ("...", {}))
    return dict(talk), greet


def blank(w, h, tile):
    return [[tile] * w for _ in range(h)]


def make_dungeon(world, lid, level, flags):
    """One level below or above: rooms and passages, its troublemakers and
    its things, the same each time it is made (but for what's been done)."""
    info = LEADS[lid]
    rng = random.Random("%s:%s:%d" % (world["seed"], lid, level))
    W, H = 36, 26
    last = level == info.levels
    for attempt in range(80):
        g = blank(W, H, "dwall")
        rooms = []
        want = rng.randint(6, 8)
        for _ in range(400):
            if len(rooms) >= want:
                break
            w, h = rng.randint(4, 8), rng.randint(3, 6)
            if last and len(rooms) == want - 1:
                w, h = 8, 5
            x, y = rng.randint(1, W - w - 1), rng.randint(1, H - h - 1)
            if any(x <= r[2] + 2 and r[0] <= x + w + 1 and
                   y <= r[3] + 2 and r[1] <= y + h + 1 for r in rooms):
                continue
            rooms.append((x, y, x + w - 1, y + h - 1))
        if len(rooms) < 5:
            continue
        rooms.sort(key=lambda r: r[0] + r[2] + rng.random())
        centers = [((r[0] + r[2]) // 2, (r[1] + r[3]) // 2) for r in rooms]

        def carve(a, b):
            (ax, ay), (bx, by) = a, b
            if rng.random() < 0.5:
                pts = [(x, ay) for x in range(min(ax, bx), max(ax, bx) + 1)]
                pts += [(bx, y) for y in range(min(ay, by), max(ay, by) + 1)]
            else:
                pts = [(ax, y) for y in range(min(ay, by), max(ay, by) + 1)]
                pts += [(x, by) for x in range(min(ax, bx), max(ax, bx) + 1)]
            for x, y in pts:
                g[y][x] = "dfloor"
        for r in rooms:
            for y in range(r[1], r[3] + 1):
                for x in range(r[0], r[2] + 1):
                    g[y][x] = "dfloor"
        for a, b in zip(centers, centers[1:]):
            carve(a, b)
        for _ in range(2):
            i, j = sorted(rng.sample(range(len(rooms) - 1), 2))
            carve(centers[i], centers[j])
        break
    end = rooms[-1]
    theme = THEMES[lid][level]
    name = LEVEL_NAMES[(lid, level)]
    area = Area("dungeon", ("dun", lid, level), g, "%s: %s" % (
        cap(info.name), name), dark=info.dark)
    area.skin = {"dwall": "dwall_" + theme, "dfloor": "dfloor_" + theme}
    area.lead = lid
    sx, sy = centers[0]
    g[sy][sx] = "stairs_up"
    area.start = (sx, sy)
    ex, ey = centers[-1]
    floor_spots = [(x, y) for y in range(H) for x in range(W)
                   if g[y][x] == "dfloor"]
    end_cells = {(x, y) for x in range(end[0], end[2] + 1)
                 for y in range(end[1], end[3] + 1)}

    def free(n, far=6, within=None, must=False):
        """Up to n free floor squares at least far from the stairs: and
        if must, n of them, nearer if need be, or anywhere."""
        for f, w in ((far, within), (3, within), (2, None)):
            spots = [p for p in (w or floor_spots)
                     if g[p[1]][p[0]] == "dfloor" and p not in area.items
                     and abs(p[0] - sx) + abs(p[1] - sy) >= f
                     and not area.mob_at(*p) and p not in area.bodies
                     and p not in area.terminals]
            if len(spots) >= n or not must:
                break
        return rng.sample(spots, min(n, len(spots)))

    def doorway(c):
        return any((c[0] + dx, c[1] + dy) not in end_cells and
                   g[c[1] + dy][c[0] + dx] != "dwall"
                   for dx, dy in DIRS)
    edge = [c for c in end_cells if c != (ex, ey) and not doorway(c) and
            (c[0] in (end[0], end[2]) or c[1] in (end[1], end[3])) and
            not any(doorway((c[0] + dx, c[1] + dy)) for dx, dy in DIRS
                    if (c[0] + dx, c[1] + dy) in end_cells)]
    if not last:
        g[ey][ex] = "stairs_down"
        area.down = (ex, ey)
    if last and info.boss and lid == "chopshop" and \
            "beat:%s" % lid not in flags:
        area.mobs.append(make_monster(info.boss, ex, ey, boss=True, rng=rng))
    inner = [(x, y) for r in rooms[1:-1] for x in range(r[0] + 1, r[2])
             for y in range(r[1] + 1, r[3])]
    if info.hazard:
        for x, y in free(rng.randint(3, 7), 3, inner):
            g[y][x] = info.hazard
    for n in range(rng.randint(2, 3)):
        x, y = rng.choice(inner or floor_spots)
        if g[y][x] != "dfloor" or (x, y) == (ex, ey) or (x, y) in end_cells:
            continue
        if "loot:%s:%d:%d:%d" % (lid, level, x, y) in flags:
            g[y][x] = "crate_open"
        else:
            g[y][x] = "crate"
            area.loot.add((x, y))
    lore = LORE.get((lid, level))
    if lore:
        for x, y in free(1, 5, inner):
            area.terminals[(x, y)] = "lore"
            g[y][x] = "terminal" if lid == "dataplex" else "crate_open"
            area.note = lore
    for e, place in world["evidence"].items():
        if place == [lid, level] and "evidence:" + e not in flags:
            for x, y in free(1, 8, inner if lid == "dataplex" else
                             [c for c in edge] or inner, must=True):
                area.terminals[(x, y)] = "evidence:" + e
                g[y][x] = "terminal" if lid == "dataplex" else "desk"
    if (lid, level) == ("chopshop", 2):
        # the stolen Daffodils, in a row of pods along the wall
        area.pods = []
        for i, (x, y) in enumerate(free(len(world["stolen"]), 3, edge,
                                        must=True)):
            area.pods.append((i, x, y))
    if (lid, level) == ("dataplex", 1) and "got:red badge" not in flags:
        for x, y in free(1, 8, must=True):
            area.items[(x, y)] = "badge"
            area.bodies[(x, y)] = {"things": ["red badge"]}
    if (lid, level) == ("dataplex", 2) and "got:core badge" not in flags:
        for x, y in free(1, 10, edge, must=True):
            g[y][x] = "safe"
            area.terminals[(x, y)] = "safe"
    if (lid, level) == ("dataplex", 3):
        area.core = (ex, ey)
        g[ey][ex] = "server"
        area.terminals[(ex, ey)] = "core"
        racks = free(4, 3, edge)
        for x, y in racks:
            g[y][x] = "server"

        def cut_off():
            seen, q = {(sx, sy)}, deque([(sx, sy)])
            while q:
                x, y = q.popleft()
                for dx, dy in DIRS:
                    c = (x + dx, y + dy)
                    if c not in seen and g[c[1]][c[0]] in DUNGEON_FLOOR:
                        seen.add(c)
                        q.append(c)
            return [c for c in end_cells if g[c[1]][c[0]] == "dfloor" and
                    c not in seen] or ([] if any(
                        (ex + dx, ey + dy) in seen for dx, dy in DIRS)
                        else [(ex, ey)])
        while racks and cut_off():
            x, y = racks.pop()
            g[y][x] = "dfloor"
        if "beat:dataplex" not in flags:
            middle = [c for c in end_cells if c[0] not in (end[0], end[2])
                      and c[1] not in (end[1], end[3]) and c != (ex, ey)]
            for x, y in free(1, 2, middle, must=True):
                area.mobs.append(make_monster("paragon", x, y, boss=True,
                                              rng=rng))
    for x, y in free(rng.randint(1, 2), 4):     # found by searching
        area.hidden[(x, y)] = rng.choice(("coins", "coins", "first aid kit"))
    n = 2 + level
    for x, y in free(n, 7):
        if (x, y) in end_cells and last and info.boss:
            continue
        kinds = info.monsters
        kind = kinds[min(len(kinds) - 1, rng.randrange(1 + level))] \
            if rng.random() < 0.7 else rng.choice(kinds)
        area.mobs.append(make_monster(kind, x, y, rng=rng))
    area.free_spots = [p for p in free(6, 8)]
    return area


