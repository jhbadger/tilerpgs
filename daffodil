    def bed_spot(self, area):
        for y in range(area.h):
            for x in range(area.w):
                if area.grid[y][x] == "bed" and y + 1 < area.h and \
                        area.grid[y + 1][x] in INSIDE_FLOOR:
                    return x, y + 1
        return area.start


    def her_nearby(self, r=4):
        x, y = self.pos
        return any(m.her and abs(m.x - x) + abs(m.y - y) <= r
                   for m in self.area.mobs)

    # ── Home ──

    def bed_menu(self):
        items = [("Rest an hour (Armor back; HP once a day)",
                  lambda: self.rest(60)),
                 ("Sleep until morning", self.sleep_night)]
        d = self.d
        if d and d["state"] == "awake" and self.phase() in ("dusk", "night") \
                and d["affection"] >= 2:
            items.insert(0, ("Go to bed with %s" % d["name"], self.bedtime))
        items.append(("Not now", lambda: None))
        self.open_menu("Your bed", items)

    def rest(self, minutes):
        """An hour's rest: your Armor Points back, and once a day, a hit
        die of HP."""
        p = self.p
        self.say("You lie down.", "info")
        self.pass_time(minutes, quiet=True)
        if self.overlay or self.interrupt:
            self.render()
            return
        p["firewall"] = 0
        self.wear_armor(p)
        p["ap"] = p["maxap"]
        key = "restheal:%d" % self.day_no()
        if key not in self.flags:
            self.flags.add(key)
            n = random.randint(1, CLASSES[p["cls"]].die)
            if self.d and "Masseuse" in self.d["mods"] and \
                    self.d["state"] == "awake":
                n += random.randint(1, 6)
                self.say("%s works the knots out of your shoulders while "
                         "you rest." % self.d["name"], "her")
            self.heal(n)
        self.say("Better. (HP %d/%d, Armor %d)" % (p["hp"], p["maxhp"],
                                                   p["ap"]), "good")
        self.render()

    def sleep_night(self, with_her=False):
        t = self.clock()
        if 7 * 60 <= t < 20 * 60:
            self.say("It's the middle of the day.", "info")
            return
        until = (7 * 60 - t) % DAY
        if not with_her:
            self.say("You turn in.", "info")
        self.sleeping = True
        try:
            self.pass_time(until, quiet=True)
        finally:
            self.sleeping = False
        if self.overlay:
            return
        self.wake_rested()

    def wake_rested(self):
        p = self.p
        p["hp"] = p["maxhp"]
        p["firewall"] = 0
        self.wear_armor(p)
        p["ap"] = p["maxap"]
        self.refill_slots(p)
        d = self.d
        if d and d["state"] == "awake" and (d.get("where", "home") == "home"
                                            or self.area.site == "home"):
            d["charge"] = 12
            d["hp"] = d["maxhp"] = self.her_max_hp()
        self.say("You wake up rested. It's %s." % self.date_text(), "good")
        if d and d["state"] == "awake":
            self.her_say("morning")
            if "Gourmet Chef" in d["mods"]:
                self.say("(Breakfast by a Gourmet Chef module: you feel "
                         "like a new person.)", "good")
        self.layout()

    def bedtime(self):
        """Fade to black."""
        d = self.d
        self.her_say("bed")
        self.flash(*self.pos, "heart")
        key = "bed:%d" % self.day_no()
        if key not in self.flags:
            self.flags.add(key)
            if d["affection"] < 6:
                self.affection(1, "fell asleep in your arms")
            self.learns(5)
        self.say("...", "info")
        self.sleep_night(with_her=True)
        if d["state"] == "awake":
            self.flags.add("nights")

    def home_meal(self):
        d = self.d
        key = "meal:%d:%d" % (self.day_no(), self.clock() // 360)
        if key in self.flags:
            self.say("You've eaten.", "info")
            return
        self.flags.add(key)
        if d and d["state"] == "awake" and d.get("where", "home") == "home":
            chef = "Gourmet Chef" in d["mods"]
            n = roll("2d6" if chef else "1d6")
            self.say("%s cooks for you: %s. (She doesn't eat. She watches "
                     "you eat, which is somehow nice.)" % (
                         d["name"], random.choice((
                             "coq au vin", "pad thai", "a perfect omelette",
                             "lasagna", "salmon with dill", "shakshuka")
                             if chef else ("spaghetti", "grilled cheese",
                                           "a salad you didn't ask for",
                                           "chili"))), "her")
            self.heal(n)
            self.learns(1)
        else:
            self.say("You open the fridge. Mustard. You eat a spoonful of "
                     "mustard, standing up, in the dark.", "info")
            self.heal(1)
