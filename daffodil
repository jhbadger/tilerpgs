                                                 dlg.winfo_reqheight()) //
                                            2))))
        dlg.grab_set()
        root.wait_window(dlg)
        return result.get("design")

    def checkout(self, des, mods):
        """Paying: cash, or Easy Pay."""
        p = self.p
        price = self.design_price(mods)
        items = []
        if p["coins"] >= price:
            items.append(("Pay cash: $%d" % price,
                          lambda: self.ordered(des, mods, price, 0)))
        credit = min(3000, price)
        down = price - credit
        if p["coins"] >= down:
            items.append(("Easy Pay: $%d down, $%d on credit" % (down,
                                                                credit),
                          lambda: self.ordered(des, mods, down, credit)))
        if not items:
            self.say("Even with Easy Pay, that's more than you've got. "
                     "Fewer modules?", "bad")
            return
        items.append(("Think about it", lambda: None))
        self.open_menu("Your Daffodil: $%d" % price, items)

    def ordered(self, des, mods, cash, credit):
        p = self.p
        p["coins"] -= cash
        p["debt"] += credit
        stats = self.her_stats(des, mods)
        likes = [LIKES_OF[des["mind"]][0], LIKES_OF[des["spice"]]]
        self.d = {"design": des, "mods": list(mods), "stats": stats,
                  "name": None, "calls": "your name", "duties": ["house"],
                  "style": "middle", "wearing": None, "wardrobe": [],
                  "state": "ordered", "ready_at": None, "learning": 0,
                  "affection": 0, "hp": 10, "maxhp": 10, "charge": 12,
                  "with": False, "where": "home", "backup": False,
                  "likes": likes, "gifts": []}
        self.d["hp"] = self.d["maxhp"] = self.her_max_hp()
        self.st["delivery_at"] = self.turn + DELIVERY
        self.dnames()
        self.paint_people()
        cons = next((m for m in self.area.mobs if m.role == "consultant"),
                    None)
        line = "Congratulations! She'll be delivered to your door in three "\
            "hours. Three! Go home, tidy up. Maybe buy some CLOTHES? They "\
            "come... um. Without."
        if cons:
            self.npc_say(cons, line)
        else:
            self.say(line, "talk")
        self.learn("delivery")
        self.sound.play("quest")
        self.quest_done("buy", "you did it: you bought a Daffodil")

    def delivered(self):
        d = self.d
        d["state"] = "box"
        self.flags.add("delivered")
        self.cache.pop(("bld", "home"), None)
        if self.area.site == "home":
            self.cache[("bld", "home")] = self.area
            self.place_specials(self.area)
            self.say("The doorbell. A delivery drone sets down a silver box "
                     "with a big yellow daffodil on it, beeps twice, and "
                     "flies off. You carry it into the living room. It's "
                     "heavy. Not too heavy.", "quest")
        else:
            self.say("Your phone: DAFFODIL. 'Your Companion has been "
                     "delivered! She's waiting for you at home.' Across "
                     "town, presumably, your neighbor is watching a silver "
                     "box on your doorstep.", "quest")

    def unbox(self):
        """The box: tape, peanuts, the Quick Setup card, the button."""
