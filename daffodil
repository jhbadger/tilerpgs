        preview.pack()
        desc = tk.Label(mid, bg=PANEL, fg=INK_DIM, justify="left",
                        font=F("Helvetica", 11), wraplength=S(220))
        desc.pack(anchor="w", pady=(6, 0))
        tk.Label(right, text="Modules", bg=PANEL, fg=ACCENT,
                 font=F("Helvetica", 12, "bold")).pack(anchor="w")
        mods = {}
        for m, (price, text) in MODULES.items():
            v = tk.IntVar(value=1 if price == 0 else 0)
