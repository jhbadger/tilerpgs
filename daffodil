                       "yellow daffodil on it.", [
                           ("Slit the tape carefully with a kitchen knife",
                            lambda: self.unbox_step(1)),
                           ("Rip it open like it's Christmas",
                            lambda: self.unbox_step(1, rip=True)),
                           ("Not yet", lambda: None)])

