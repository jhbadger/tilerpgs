    # ── Nights out ──

    def gamble(self):
        """Blackjack: three hands, INT to count; a counter gets noticed."""
        p = self.p
        d = self.d
        key = "cards:%d" % self.day_no()
        if key in self.flags:
            self.say("The pit boss has had enough of you for one day.",
                     "info")
            return
        if p["coins"] < 100:
            self.say("The table minimum is $100.", "info")
            return
        self.flags.add(key)
        p["coins"] -= 100
        maths = d and "Mathematics" in d["mods"] and self.her_here()
        wins = 0
        for hand in range(3):
            if self.test("INT", adv=maths, label="hand %d" % (hand + 1)):
                wins += 1
        if maths:
            self.say("%s, in your ear: 'Statistically, you should hit.'" %
                     d["name"], "her")
        if wins == 3:
            p["coins"] += 600
            self.say("Three hands, three wins. $600. The pit boss starts "
                     "walking over. A bouncer starts walking over.", "gold")
            x, y = self.pos
            for dx, dy in DIRS:
                if self.can_go(Mob("x", "x", 0, 0), x + dx, y + dy):
                    m = make_monster("bouncer", x + dx, y + dy)
                    m.aware = True
                    self.area.mobs.append(m)
                    break
            self.say("'Sir. A word. Outside.' Time to go. (Or not.)", "bad")
        elif wins == 2:
            p["coins"] += 300
            self.say("You win $300.", "gold")
        else:
            self.say("The house wins. The house always wins.", "bad")
        if d and self.her_here():
            self.learns(5)
        if wins >= 2:
            self.quest_done("casino", "you beat the Lucky Star")

    def dance(self, mob):
        d = self.d
        p = self.p
        h = self.now().hour
        if not (23 <= h or h < 1) or WEEKDAYS[(self.day_no() - (
                1 if h < 4 else 0)) % 7] not in ("Friday", "Saturday"):
            self.npc_say(mob, "Dance-off's at eleven, Friday and Saturday. "
                         "Come back then.")
            return
        key = "dance:%d" % self.day_no()
        if key in self.flags:
            self.npc_say(mob, "You've danced tonight. Let somebody else "
                         "lose.")
            return
        if not d or not self.her_here():
            self.npc_say(mob, "You need a partner, honey.")
            return
        self.flags.add(key)
        lead = "Dance" in d["mods"]
        self.say("The lights go down. The music comes up. %s takes your "
                 "hand%s." % (d["name"], " and LEADS" if lead else ""),
                 "info")
        mine = self.test("DEX", adv=lead, label="your feet")
        hers = self.her_test("DEX", label="%s dancing" % d["name"])
        self.pass_time(15, quiet=True)
        if mine and hers:
            p["coins"] += 200
