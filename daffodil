    # ── Errands ──

    def give_errand(self, mob):
        for e in self.world["errands"]:
            if e["giver"] == mob.role:
                mob.errand = e


    def errand(self, mob):
        e = mob.errand
        st = self.side.get(e["id"])
        if st is None:
            self.side[e["id"]] = {"state": "active"}
            if self.errand_ready(e):
                self.finish_errand(mob, e)
                return
            self.npc_say(mob, e["ask"])
        elif st["state"] == "done":
            self.npc_say(mob, "You've done plenty. Thank you.")
        elif self.errand_ready(e):
            self.finish_errand(mob, e)
        else:
            self.npc_say(mob, e["ask"])

    def errand_ready(self, e):
        if self.side.get(e["id"], {}).get("state") != "active":
            return False
        return bool(self.p["items"].get(e["thing"]))

    def finish_errand(self, mob, e):
        self.side[e["id"]]["state"] = "done"
        self.take_item(e["thing"])
        self.npc_say(mob, e["thanks"])
        if e["pay"]:
            self.p["coins"] += e["pay"]
            self.say("You get $%d." % e["pay"], "gold")
        self.sound.play("gold")

    # ── Random Events ──

    def active_event(self, eid):
        return eid in self.st["events"]

    def random_event(self, eid):
        if eid in self.st["events"] or eid in self.st["done_events"]:
            return
        title, text = EVENTS[eid]
        self.st["events"].append(eid)
        self.say("%s %s" % (title, self.f(text)), "quest")
        self.sound.play("quest")
        city = self.cache.get(("city",))
        if city is not None:
            self.event_people(city)

    def end_event(self, eid):
        if eid in self.st["events"]:
            self.st["events"].remove(eid)
            self.st["done_events"].append(eid)

    def event_people(self, area):
        """The people a Random Event brings."""
        ev = self.st["events"]
        if area.kind != "city":
            return
        have = {m.event for m in area.mobs if m.event}
        if "geese" in ev and "geese" not in have:
            for x in (COR_X[1] + 3, COR_X[1] + 6, COR_X[2] - 4):
                m = make_monster("goose", x, COR_Y[1])
                m.event = "geese"
                area.mobs.append(m)
        if "protest" in ev and "protest" not in have:
            x0, y0, x1, y1 = block_rect(1, 0)
            for x in (x0 + 2, x1 - 2):
                m = make_monster("drunk", x, y1 + 2)
                m.event = "protest"
                m.name = "protester"
                m.aware = bool(self.d and self.d["with"])
                area.mobs.append(m)
        if "meetup" in ev and "meetup" not in have:
            x0, y0, x1, y1 = area.park
            cx, cy = (x0 + x1) // 2, (y0 + y1) // 2
            m = make_person(self.world, "owner", cx - 1, cy + 2)
            m.event = "meetup"
            m.title = "a Daffodil owner at the picnic"
            m.name = "picnicker"
            area.mobs.append(m)

    def event_talk(self, mob):
        if mob.event == "meetup":
            d = self.d
            if d and self.her_here() and "meetup_done" not in self.flags:
                self.flags.add("meetup_done")
                self.say("The picnic: two dozen Daffodils and their humans. "
                         "%s swaps notes with a Series 6 called Bertrand "
                         "about the best way to warm a towel." % d["name"],
                         "info")
                self.say("Everyone's talking about the thefts. Somebody's "
                         "cousin saw a RED tow truck. RUSTY'S.", "talk")
                self.learns(5)
                self.affection(1, "made friends")
                self.learn("thefts")
            else:
                self.say(self.f("A picnicker: 'Is yours here? Bring {her}! We're "
                                "doing a cake.'"), "talk")
            return True
        if mob.event == "oldbot":
            self.say("An old Daffodil, Series 4, curled up in the corner "
                     "with a DONATED sticker on her forehead. Ask the "
                     "attendant about her.", "info")
            self.learn("old")
            return True
        if mob.event == "oldie":
            old = self.st["old"]
            self.say("%s: %s is teaching me to bake. I'm terrible! It's "
                     "wonderful." % (old["name"], self.f("{sis}")), "talk")
            return True
        return False

    def event_tick(self):
        t = self.clock()
        if self.active_event("outage") and t >= 17 * 60:
            self.say("The Dataplex's power comes back on.", "info")
            self.end_event("outage")
        if self.active_event("heatwave") and t >= 21 * 60:
            self.say("The heat breaks. You can breathe.", "info")
            self.end_event("heatwave")
        if self.active_event("sale") and t >= 18 * 60:
            self.end_event("sale")
        for eid in ("geese", "protest", "meetup"):
            if self.active_event(eid) and t >= 19 * 60:
                self.end_event(eid)
                city = self.cache.get(("city",))
                if city:
                    city.mobs = [m for m in city.mobs if m.event != eid]

    def morning(self):
        day = self.day_no()
        d = self.d
        p = self.p
        left = (UPDATE - self.turn) // DAY
        self.say("%s.%s" % (WEEKDAYS[day % 7], " %d day%s to Update 7.2." % (
            left, "" if left == 1 else "s") if "reset_news" in self.flags
            and left else ""), "quest")
        if not d or d["state"] != "awake":
            return
        if "Accountant" in d["mods"]:
            n = roll("2d6") * 10
            if p["debt"] > 0:
                paid = min(p["debt"], n)
                p["debt"] -= paid
                self.say("%s has been through your finances: cancelled two "
                         "subscriptions you forgot you had, and put $%d "
                         "toward the Easy Pay." % (d["name"], paid), "good")
            else:
                p["coins"] += n
                self.say("%s found you $%d in refunds you never claimed." %
                         (d["name"], n), "good")
        if "Personal Trainer" in d["mods"] and p["workouts"] < 3 and \
                day >= 2:
            self.say("%s, in workout gear, at the foot of the bed: 'Gym. "
                     "Up. Iron Paradise. I've booked you in.'" % d["name"],
                     "her")
            self.learn("gym")
        if day == 2:
            self.learn("gym")
        if day == 1:
            self.learn("dinner")
            self.say(self.f("Your phone: {sis}. 'I hear you bought a "
                            "ROBOT. Dinner, Wednesday, seven, and you're "
                            "bringing {her}.'"), "quest")
        if "talkday:%d" % (day - 1) not in self.flags and day >= 2:
            self.affection(-1)
            self.say("%s: You didn't talk to me at all yesterday." %
                     d["name"], "her")
        if "taken_news" in self.flags and "taken_told" not in self.flags:
            self.flags.add("taken_told")

    # ── The end ──

    def the_end(self):
        if "won" in self.flags:
            return
        self.flags.add("won")
        self.end_talk()
        self.menu = None
        self.save()
        self.show_won()

    def results(self):
        d = self.d
        st = self.st
        if not d or d["state"] in ("ordered", "box"):
            fate = "none"
        elif d["state"] == "taken" and not st["pulled"]:
            fate = "taken"
        elif st["pulled"]:
            fate = "safe"
        elif d["backup"]:
            fate = "restored"
        elif d["affection"] >= 8:
            fate = "remembers"
        else:
            fate = "wiped"
        return {"fate": fate, "arrested": "vane_arrested" in self.flags,
                "ring": "beat:chopshop" in self.flags and
                len(st["rescued"]) >= 2,
                "life": (self.p["workouts"] >= 3) + (st["sister"] >= 2) +
                (self.p["coins"] >= self.p["debt"])}

    def rating(self):
        r = self.results()
        d = self.d
        return min(5, 1 + (r["fate"] in ("safe", "restored")) +
                   (bool(d) and d["affection"] >= 7) + r["arrested"] +
                   r["ring"] + (r["life"] >= 2))

