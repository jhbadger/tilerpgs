    # ── What people do ──

    def role_converse(self, mob, word):
        r = mob.role
        w4 = word[:4]
        p = self.p
        if r == "consultant" and w4 in ("desi", "buy", "orde"):
            self.end_talk()
            self.design_studio()
            return True
        if r == "volt":
            if w4 in ("upda", "7.2") and "reset_news" not in self.flags:
                self.npc_say(mob, "7.2? Haven't looked at it. Daffodil "
                             "pushes an update every month. Usually it "
                             "just changes the font.")
                return True
            if w4 in ("back", "crys"):
                self.backup(mob)
                return True
            if w4 in ("repa", "fix"):
                self.repair_her(mob)
                return True
            if w4 in ("modu", "inst"):
                self.end_talk()
                self.module_menu(mob)
                return True
            if w4 == "old" and p["items"].get("old daffodil"):
                self.fix_old(mob)
                return True
        if r == "trainer" and w4 in ("work", "trai", "exer"):
            self.workout(mob)
            return True
        if r == "detective" and w4 in ("evid", "proo", "warr"):
            self.give_evidence(mob)
            return True
        if r == "pitboss" and w4 in ("card", "game", "blac", "gamb"):
            self.end_talk()
            self.gamble()
            return True
        if r == "maitre" and w4 in ("dinn", "tabl", "date"):
            self.bistro(mob)
            return True
        if r == "dj" and w4 in ("danc", "cont"):
            self.dance(mob)
            return True
        if r == "attendant" and w4 == "old":
            self.buy_old(mob)
            return True
        if r == "sister" and w4 == "old" and self.st.get("old"):
            self.old_to_sister(mob)
            return True
        if r == "sister" and w4 in ("dinn", "eat") and self.dinner_now():
            self.end_talk()
            self.sister_dinner()
            return True
        if r == "vane" and w4 in ("sund", "upda") and \
                self.area.site == "casino":
            self.vane_brags(mob)
            return True
        if r == "neighbor" and w4 in ("deli", "daff", "box") and \
                "delivered" not in self.flags:
            self.npc_say(mob, "A delivery? For YOU? Well, I'll be watching "
                         "for it." if self.d else "What delivery? Are you "
                         "expecting something? You're never expecting "
                         "anything.")
            return True
        if r == "owner" and w4 in ("juni",) and \
                "juniper_rescued" in self.flags:
            self.reunion(mob)
            return True
        return False

    def backup(self, mob):
        d = self.d
        if not d or d["state"] != "awake":
            self.npc_say(mob, "Back up what? Bring {her} in.")
            return
        if d["backup"]:
            self.npc_say(mob, "{She}'s on the crystal. Whatever happens "
                         "Sunday, I can put her back.")
            return
        if not self.her_here():
            self.npc_say(mob, "Bring {her} in. I can't back up a Daffodil "
                         "over the phone.")
            return
        if self.p["coins"] < 500:
            self.npc_say(mob, "Crystal's five hundred. You've got $%d." %
                         self.p["coins"])
            return
        self.p["coins"] -= 500
        self.pass_time(60, quiet=True)
        d["backup"] = True
        self.npc_say(mob, "Done. {She}'s on the crystal: everything {she} is, "
                     "right now. It sits on my shelf. Sunday, if 7.2 wipes "
                     "her, I put her back.")
        self.say("%s: It tickled. Did it tickle you? It tickled me." %
                 d["name"], "her")
        self.affection(1, "feels safe")
        self.quest_done("backup", "she's safe on a crystal")

    def repair_her(self, mob):
        d = self.d
        if not d or not self.her_nearby(3):
            self.npc_say(mob, "Bring {her} here and I'll have a look.")
            return
        if d["hp"] >= d["maxhp"]:
            self.npc_say(mob, "{She}'s in perfect shape. Lucky you.")
            return
        if self.p["coins"] < 50:
            self.npc_say(mob, "Fifty bucks.")
            return
        self.p["coins"] -= 50
        self.pass_time(20, quiet=True)
        d["hp"] = d["maxhp"]
        if d["state"] == "down":
            self.wake_her()
        self.npc_say(mob, "Good as new. Better. I tightened a few things.")

    def module_menu(self, mob):
        d = self.d
        if not d:
            self.npc_say(mob, "Buy a Daffodil first, then talk to me.")
            return
        items = []
        for m, (price, text) in MODULES.items():
            if m not in d["mods"] and price:
                items.append(("%s ($%d): %s" % (m, price, text),
                              lambda m=m, price=price: self.install(m,
                                                                    price)))
        items.append(("Never mind", lambda: None))
        self.open_menu("Volt's modules", items)

    def install(self, m, price):
        d = self.d
        if self.p["coins"] < price:
            self.say("Volt: That's $%d. Come back with it." % price, "talk")
            return
        if not self.her_nearby(3):
            self.say("Volt: I need her here to install it.", "talk")
            return
        self.p["coins"] -= price
        d["mods"].append(m)
        d["stats"] = self.her_stats(d["design"], d["mods"])
        d["maxhp"] = self.her_max_hp()
        self.pass_time(30, quiet=True)
        self.say("Volt installs the %s module. %s blinks. 'Oh! I know %s "
                 "now. I know SO much %s.'" % (
                     m, d["name"], m.lower(), m.lower()), "her")

    def buy_old(self, mob):
        if "old_bought" in self.flags:
            self.npc_say(mob, "You already bought her.")
            return
        if self.p["coins"] < 20:
            self.npc_say(mob, "Twenty bucks.")
            return
        self.p["coins"] -= 20
        self.flags.add("old_bought")
        self.give_item("old daffodil")
        self.area.mobs = [m for m in self.area.mobs if m.event != "oldbot"]
        self.npc_say(mob, "She's yours. Careful, she's heavier than she "
                     "looks. Volt might get her going.")
        self.learn("old")

    def fix_old(self, mob):
        if self.p["coins"] < 150:
            self.npc_say(mob, "Hundred and fifty to get her running.")
            return
        self.p["coins"] -= 150
        self.take_item("old daffodil")
        self.pass_time(60, quiet=True)
        rng = random.Random("%s:old" % self.world["seed"])
        names = [n for n in DAFFODIL_NAMES if not self.d or
                 n != self.d["name"]]
