def masculine(text):
    """A line about her, about him instead: she, her, herself."""
    def her(m):
        sep, nxt = m.group(2), m.group(3).lower()
        obj = not nxt or nxt in OBJECT_NEXT or any(c in sep for c in
                                                   ".,!?;:)'\"")
        out = "him" if obj else "his"
        return out.capitalize() if m.group(1)[0] == "H" else out
    text = re.sub(r"\bherself\b", "himself", text)
    text = re.sub(r"\bHerself\b", "Himself", text)
    text = re.sub(r"\bhers\b", "his", text)
    text = re.sub(r"\bshe\b", "he", text)
    text = re.sub(r"\bShe\b", "He", text)
    return re.sub(r"\b([Hh]er)\b(?=(\W*)([A-Za-z']*))", her, text)


def cap(s):
    return s[:1].upper() + s[1:]


def an(s):
    vowel = s[:1] in "aeiou" and not s.startswith(("uni", "use", "eu"))
    return ("an " if vowel else "a ") + s if not s.startswith(("a ",)) \
        else s


def wrap(text, width):
    out, line = [], ""
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            out.append(line)
            line = "  " + word if text.startswith("  ") else word
        else:
            line = (line + " " + word) if line else word
    if line:
        out.append(line)
    return out


