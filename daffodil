def make_interior(world, sid, flags):
    name, kind, _, _ = SITES[sid]
    floor, rows, cast = ROOMS[kind]
    g, spots, specials = [], {}, []
    for y, row in enumerate(rows):
        line = []
        for x, ch in enumerate(row):
            if ch.isdigit():
                spots[cast[ch]] = (x, y)
                line.append(floor)
            elif ch == "x":
                specials.append((x, y))
                line.append("rug" if sid == "home" else floor)
            else:
                line.append(ROOM_TILES.get(ch, floor))
        g.append(line)
    area = Area("inside", ("bld", sid), g, name, edge=None)
    area.site = sid
    area.specials = specials
    area.spots = spots
    for y, row in enumerate(rows):
        for x, ch in enumerate(row):
            if ch == "+":
                area.start = (x, y - 1)
            elif ch == "u":
                area.links[(x, y)] = ("lead", LIFT_LEADS[sid])
    return area


