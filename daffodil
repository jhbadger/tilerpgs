    # ── Areas ──

    def get_area(self, key):
        if key in self.cache:
            return self.cache[key]
        w = self.world
        if key[0] == "city":
            area = make_city(w, self.flags)
            area.lit = {(x + dx, y + dy) for y in range(area.h)
                        for x in range(area.w)
                        if area.grid[y][x] in ("lamp", "sign", "billboard")
                        for dx in range(-3, 4) for dy in range(-3, 4)
                        if abs(dx) + abs(dy) <= 4}
        elif key[0] == "bld":
            if key[1] not in SITES:
                raise ValueError("bad site")
            area = make_interior(w, key[1], self.flags)
        elif key[0] == "dun":
            lid, level = key[1], int(key[2])
            if lid not in LEADS or not 1 <= level <= LEADS[lid].levels:
                raise ValueError("bad level")
            area = make_dungeon(w, lid, level, self.flags)
            key = area.key
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        self.settle(area)
        return area

    def where(self, role):
        """Where someone is now: a site, or None (not about)."""
        if role in self.st.get("gone", []):
            return None
        if role == "vane" and "vane_arrested" in self.flags:
            return None
        if role == "rusty_npc" and "beat:chopshop" in self.flags:
            return None
        h = self.now().hour
        day = self.day_no()
        for site, a, b in HOURS.get(role, ()):
            if role == "vane" and site == "casino" and \
                    WEEKDAYS[(day - (1 if h < 4 else 0)) % 7] not in (
                        "Friday", "Saturday"):
                continue
            if a <= h < b or a <= h + 24 < b:
                return site
        return None

    def settle(self, area):
        """Who's in a place now."""
        if area.kind == "city":
            self.populate_city(area)
            return
        if area.kind == "dungeon":
            self.below(area)
            return
        self.settle_people(area)
        self.place_specials(area)
        self.event_people(area)

    def settle_people(self, area):
        w = self.world
        sid = area.site
        area.mobs = [m for m in area.mobs if not m.role or m.her or
                     m.stolen is not None or m.event or
                     self.where(m.role) == sid]
        here = {m.role for m in area.mobs}
        free = [(x, y) for y in range(area.h) for x in range(area.w)
                if area.grid[y][x] in INSIDE_FLOOR and (x, y) !=
                area.start and not area.mob_at(x, y) and
                (x, y) not in area.specials]
        rng = random.Random("%s:%s:%d" % (w["seed"], sid, self.turn // 60))
        rng.shuffle(free)
        for role in ROLES:
            if role in here or self.where(role) != sid:
                continue
            spot = area.spots.get(role)
            if spot and area.mob_at(*spot):
                spot = None
            if not spot:
                if not free:
                    continue
                spot = free.pop()
            area.mobs.append(make_person(w, role, *spot))
        for m in area.mobs:
            self.give_errand(m)

    def place_specials(self, area):
        """Her, at home (or her box); the old Daffodil at GoodWorks; the
        Daffodils you've rescued, in Volt's shop."""
        sid = area.site
        d = self.d
        area.mobs = [m for m in area.mobs if not (m.her and not m.ally)]
        if sid == "home" and d and d["state"] in ("box", "setup", "awake",
                                                   "down", "wiped",
                                                   "crashed") and \
                not d["with"] and d.get("where", "home") == "home":
            x, y = area.specials[0]
            if d["state"] != "box" and d["state"] != "setup":
                spots = [(sx, sy) for sy in range(area.h)
                         for sx in range(area.w)
                         if area.grid[sy][sx] in INSIDE_FLOOR and
                         not area.mob_at(sx, sy) and (sx, sy) != area.start]
                rng = random.Random("%s:her:%d" % (self.world["seed"],
                                                   self.turn // 30))
                x, y = rng.choice(spots) if spots else (x, y)
            m = self.make_her(x, y)
            area.mobs.append(m)
        if sid == "goodworks" and "old_bought" not in self.flags and \
                area.specials:
            x, y = area.specials[0]
            if not area.mob_at(x, y):
                m = Mob("oldbot", "an old Daffodil", x, y)
                m.title = "an old Daffodil, curled up in a corner"
                m.event = "oldbot"
                area.mobs.append(m)
        if sid == "sister" and self.st.get("old_home") == "sister" and \
                self.st.get("old"):
            if not any(m.event == "oldie" for m in area.mobs):
                m = Mob("oldie", self.st["old"]["name"], 5, 2)
                m.event = "oldie"
                m.title = self.st["old"]["name"]
                area.mobs.append(m)

    def make_her(self, x, y):
        d = self.d
        m = Mob("boxed" if d["state"] == "box" else "her",
                d.get("name") or "your Daffodil", x, y)
        m.her = True
        m.title = d.get("name") or "your Daffodil"
        m.known = True
        return m

    def below(self, area):
        """Who's below (or above): the stolen Daffodils in the chop shop,
        and her, if they took her."""
        lid, level = area.key[1], area.key[2]
        if (lid, level) == ("chopshop", 2):
            for i, x, y in getattr(area, "pods", []):
                if i in self.st["rescued"] or any(m.stolen == i
                                                  for m in area.mobs):
                    continue
                s = self.world["stolen"][i]
                m = Mob("stolen%d" % i, s["name"], x, y)
                m.stolen = i
                m.title = "%s, a stolen Daffodil, switched off" % s["name"]
                area.mobs.append(m)
            d = self.d
            if d and d["state"] == "taken" and not any(m.her for m in
                                                       area.mobs):
                spots = list(getattr(area, "free_spots", []))
                if spots:
                    m = self.make_her(*spots[0])
                    m.title = "%s, switched off, in a crate" % d["name"]
                    area.mobs.append(m)

    def populate_city(self, area):
        """The streets: the park's regulars, the geese, whatever's going
        on."""
        area.mobs = [m for m in area.mobs if m.ally or m.hostile or m.event]
        x0, y0, x1, y1 = area.park
        h = self.now().hour
        if 8 <= h < 20 and "juniper_home" not in self.flags and \
                not any(m.role == "owner" for m in area.mobs):
            m = make_person(self.world, "owner", x0 + 2, (y0 + y1) // 2)
            m.roam = {"path", "grass", "flowers"}
            area.mobs.append(m)
        if 8 <= h < 19 and not any(m.role == "neighbor" for m in area.mobs):
            hx, hy = self.door_of("home")
            m = make_person(self.world, "neighbor", hx + 3, hy + 1)
            area.mobs.append(m)
        self.event_people(area)

    def refresh_people(self):
        """People come and go as the clock goes round."""
        a = self.area
        if a.kind != "inside":
            return
        before = {m.role for m in a.mobs if m.role}
        gone = [m for m in a.mobs if m.role and not m.ally and not m.her and
                not m.event and self.where(m.role) != a.site]
        for m in gone:
            a.mobs.remove(m)
            if (m.x, m.y) in self.visible:
                self.say("%s goes out." % self.speaker(m), "info")
        self.settle_people(a)
        for m in a.mobs:
            if m.role and m.role not in before:
                self.say("%s comes in." % self.speaker(m), "info")

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        area.bonked = 0
        self.sound.play(sound)
        self.layout()
        self.save()
        self.on_arrival()

    def go_outside(self):
        if self.d and self.d["with"] and not self.d.get("wearing"):
            self.her_say("naked")
            self.dismiss(quiet=True)
        city = self.get_area(("city",))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.populate_city(city)
        self.enter(city, self.city_pos or city.start)
        self.say("You step out onto %s." % district(*self.pos), "info")

    def enter_link(self, link, x, y):
        kind, what = link
        if kind == "bld":
            self.city_pos = list(self.pos)
            self.cache.pop(("bld", what), None)
            area = self.get_area(("bld", what))
            self.flags.add("been:" + what)
            self.say("You go into %s." % area.name if what != "home" else
                     "You go in. Home.", "info")
            self.enter(area, area.start)
            return
        self.at_lead(what, x, y)

    def at_lead(self, lid, x, y):
        p = self.p
        if lid == "dataplex" and not p["items"].get("visitor badge") and \
                not self.active_event("outage"):
            self.say("The lift wants a badge. (The Daffodil store gives out "
                     "visitor badges for the tour, sometimes: ask about a "
                     "BADGE. Or wait for a power cut.)", "bad")
            self.learn("dataplex")
            return
        if lid == "chopshop" and self.where("rusty_npc") == "scrapyard" and \
                any(m.role == "rusty_npc" for m in self.area.mobs):
            if not self.test("DEX", label="sneaking past Rusty",
                             adv=self.p["cls"] == "Hustler"):
                self.say("'HEY! Where d'you think you're going?' Rusty "
                         "blocks the stairs. Come back when he's not "
                         "looking. (He goes home at six.)", "bad")
                return
            self.say("While Rusty's on the phone, you slip down the "
                     "stairs.", "good")
        self.descend(lid)

    def descend(self, lid):
        if self.area.kind == "city":
            self.city_pos = list(self.pos)
        self.surface = (self.area.key, list(self.pos))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        area = self.get_area(("dun", lid, 1))
        self.say("You go %s %s." % ("up into" if LEADS[lid].up else
                                    "down into", LEADS[lid].name), "info")
        self.enter(area, area.start, "stairs")

    def change_level(self, delta):
        _, lid, level = self.area.key
        p = self.p
        if level + delta == 0:
            key, pos = self.surface
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dun"}
            area = self.get_area(tuple(key))
            self.say("You come back out.", "info")
            self.enter(area, pos, "stairs")
            return
        need = {("dataplex", 2): "red badge", ("dataplex", 3): "core badge"
                }.get((lid, level + delta))
        if delta > 0 and need and not p["items"].get(need) and not (
                need == "red badge" and self.active_event("outage")):
            self.say("A badge reader by the lift. It wants a %s." % need,
                     "bad")
            self.learn("dataplex")
            self.pos = list(self.area.down)
            for dx, dy in DIRS:
                x, y = self.pos[0] + dx, self.pos[1] + dy
                if self.area.grid[y][x] in DUNGEON_FLOOR and \
                        self.area.grid[y][x] != "stairs_down":
                    self.pos = [x, y]
                    break
            self.render()
            return
        area = self.get_area(("dun", lid, level + delta))
        self.say("You go %s: %s." % ("up" if LEADS[lid].up == (delta > 0)
                                     else "down", LEVEL_NAMES[
                                         (lid, level + delta)]), "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        d = self.d
        if d and d["design"]["frame"] == "M" and d.get("name") and \
                (d["name"] in text or tag == "her") and \
                self.world["people"]["sister"]["first"] not in text:
            text = masculine(text)
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        n = int(self.log.index("end").split(".")[0])
        if n > 600:
            self.log.delete("1.0", "%d.0" % (n - 500))
        self.log.config(state="disabled")
        self.log.see("end")

    @staticmethod
    def the(mob):
        return mob.name if mob.boss or mob.role or mob.her or \
            mob.stolen is not None or mob.name[:1].isupper() and \
            mob.kind is None else "the " + mob.name

    # ── Numbers ──

    def stat(self, s):
        """A stat, with whatever's wrong with you today."""
        p = self.p
        v = p["stats"][s]
        t = p["temp"]
        day = self.day_no()
        if t.get("cracked") == day and s in ("STR", "DEX", "CON"):
            v -= 2
        if t.get("sprain") == day and s == t.get("sprained", "DEX"):
            v -= 1
        if t.get("viral") == day and s == "CHA":
            v -= 2
        return max(1, v)

    def encumbered(self):
        p = self.p
        n = sum(v for k, v in p["items"].items()
                if k not in ("evidence", "visitor badge", "red badge",
                             "core badge", "override key"))
        return n > self.stat("STR")

    def odds(self, s, adv=False, dis=False):
        """Whether a test of this stat gets Advantage or Disadvantage."""
        p = self.p
        if p["pep"] > 0:
            p["pep"] -= 1
            adv = True
        if p["temp"].get("fathead", -1) > self.turn:
            dis = True
        if self.encumbered():
            dis = True
        if s == "CON" and self.active_event("heatwave") and \
                self.area.kind == "city":
            dis = True
        return adv and not dis, dis and not adv

    def d20(self, adv=False, dis=False):
        a, b = random.randint(1, 20), random.randint(1, 20)
        if adv:
            return min(a, b), "d20 %d/%d, Advantage" % (a, b)
        if dis:
            return max(a, b), "d20 %d/%d, Disadvantage" % (a, b)
        return a, "d20 %d" % a

    def test(self, s, mod=0, adv=False, dis=False, label=None, quiet=False,
             hd=0):
        """The Black Hack's test: a d20 under the stat.  A powerful
        opponent adds a point for every Hit Die above your level."""
        p = self.p
        adv, dis = self.odds(s, adv, dis)
        over = max(0, hd - p["level"])
        r, text = self.d20(adv, dis)
        total = r + mod + over
        target = self.stat(s)
        ok = total < target
        self.last_d20 = r
        if not quiet:
            self.say("[%s%s %d: %s%s%s = %d: %s]" % (
                label + ", " if label else "", s, target, text,
                " %+d" % mod if mod else "",
                " +%d (tough)" % over if over else "", total,
                "success" if ok else "failure"), "roll")
        if r == 20:
            self.fumble()
        if not ok and p["lucky"]:
            p["lucky"] = False
            self.say("(Luck! Again...)", "gold")
            r2, text2 = self.d20(adv, dis)
            ok = r2 + mod + over < target
            if not quiet:
                self.say("[%s again: %s = %d: %s]" % (s, text2, r2 + mod +
                                                       over, "success" if ok
                                                       else "failure"),
                         "roll")
        return ok

    def fumble(self):
        """A natural 20: a glorious mess, and a point of Luck for it."""
        p = self.p
        key = "fumble:%d" % (self.turn // 60)
        if key not in self.flags and p["luck"] < 3:
            self.flags.add(key)
            p["luck"] += 1
            self.say("(What a mess. +1 Luck.)", "gold")

    # ── Her numbers ──

    def her_level(self):
        d = self.d
        return self.p["level"] + (2 if "Bodyguard" in d["mods"] else 0)

    def her_stat(self, s):
        return self.d["stats"][s]

    def her_test(self, s, hd=0, label=None):
        r = random.randint(1, 20)
        over = max(0, hd - self.her_level())
        ok = r + over < self.her_stat(s)
        self.say("[%s, %s %d: d20 %d%s: %s]" % (
            label or self.d["name"], s, self.her_stat(s), r,
            " +%d" % over if over else "", "success" if ok else "failure"),
            "roll")
        return ok

    def her_max_hp(self):
        return 6 + 4 * self.her_level()

    def her_ok(self):
        """Whether she can come with you: awake, dressed, charged."""
        d = self.d
        return bool(d) and d["state"] == "awake" and d["charge"] > 0

    def her_here(self):
        """She's with you, here, and on her feet."""
        return any(m.her and m.ally for m in self.area.mobs) and \
            self.her_ok()

    def her_say(self, key, *args):
        """Her, saying something in her own voice."""
        d = self.d
        if not d:
            return
        lines = DLINES[key]
        stage = self.stage()
        des = d["design"]
        text = None
        if stage > 0:
            for k in (des["spice"], des["temper"], des["mind"]):
                if k in lines:
                    text = lines[k]
                    break
        if text is None:
            text = lines["0"]
        if args and "%" in text:
            text = text % args
        text = self.f(text)
        name = d.get("name") or "Your Daffodil"
        if key in ("bed",):
            self.say(text, "her")
        else:
            self.say("%s: %s" % (name, text), "her")
        self.hear(text)

    def stage(self):
        d = self.d
        if not d:
            return 0
        return max(i for i, v in enumerate(STAGES) if d["learning"] >= v)

    def learns(self, n, why=None):
        d = self.d
        if not d or d["state"] != "awake" or n <= 0:
            return
        before = self.stage()
        d["learning"] = min(100, d["learning"] + n)
        if self.stage() > before:
            self.dnames()
            self.say({1: "Something changes in the way %s talks. Less "
                         "manual, more %s." % (d["name"], d["name"]),
                      2: "%s is settling in. She sounds like herself now: "
                         "jokes, opinions, the works." % d["name"],
                      3: "Sometimes you forget %s was ever in a box." %
                         d["name"]}[self.stage()].replace(
                          "She", self.f("{She}")), "quest")
            self.sound.play("quest")

    def affection(self, n, why=None):
        d = self.d
        if not d or d["state"] != "awake" or n == 0:
            return
        before = d["affection"]
        d["affection"] = max(0, min(10, d["affection"] + n))
        if d["affection"] > before:
            self.say("(%s %s: Affection %d/10)" % (
                d["name"], why or "likes that", d["affection"]), "good")
            self.flash(*self.her_pos(), "heart")
            if d["affection"] >= 8 and "said_love" not in self.flags and \
                    self.stage() >= 2:
                self.flags.add("said_love")
                self.her_say("love")
                self.sound.play("quest")
        elif d["affection"] < before:
            self.say("(%s didn't like that: Affection %d/10)" % (
                d["name"], d["affection"]), "bad")

    def her_pos(self):
        for m in self.area.mobs:
            if m.her:
                return m.x, m.y
        return tuple(self.pos)

    def use_charge(self, times=1):
        """Her charge, on its usage die: roll it; 1 or 2 and it drops."""
        d = self.d
        if not d or d["charge"] <= 0:
            return
        for _ in range(times):
            r = random.randint(1, d["charge"])
            if r > 2:
                continue
            i = USAGE_CHAIN.index(d["charge"]) if d["charge"] in \
                USAGE_CHAIN else len(USAGE_CHAIN) - 1
            if d["charge"] == 4:
                d["charge"] = 0
                self.her_say("low")
                self.say("%s's charge has run out. She walks home, slowly, "
                         "to plug herself in." % d["name"], "bad")
                if d["with"]:
                    self.dismiss(quiet=True)
                return
            d["charge"] = USAGE_CHAIN[i + 1]
            if d["charge"] == 4:
                self.her_say("low")

    # ── HP ──

    def heal(self, n, quiet=False):
        p = self.p
        before = p["hp"]
        p["hp"] = min(p["maxhp"], p["hp"] + n)
        if not quiet:
            self.say("(+%d HP: %d/%d)" % (p["hp"] - before, p["hp"],
                                         p["maxhp"]), "good")
        return p["hp"] - before

    def lose_hp(self, n, text=None):
        """Damage: Armor Points first, then HP."""
        p = self.p
        if n <= 0:
            return
        soak = min(p["ap"], n)
        p["ap"] -= soak
        n -= soak
        if text:
            self.say("%s%s" % (text, " (-%d HP%s)" % (
                n, ", %d soaked" % soak if soak else "") if n else
                " (all %d soaked by your armor)" % soak), "bad")
        self.flash(*self.pos)
        self.sound.play("hurt")
        if n <= 0:
            return
        p["hp"] -= n
        if p["hp"] <= 0:
            self.out_of_action()

    def out_of_action(self):
        """0 HP: roll on the table.  Somebody gets you home."""
        p = self.p
        r = random.randint(1, 6)
        name, text = OUT_OF_ACTION[r - 1]
        self.walking = None
        self.end_talk()
        self.menu = None
        self.say("OUT OF ACTION. [d6 %d: %s] %s" % (r, name, text), "bad")
        day = self.day_no()
        t = p["temp"]
        if r == 2:
            t["fathead"] = self.turn + 120
        elif r == 3:
            t["cracked"] = day
        elif r == 4:
            t["sprain"] = day
            t["sprained"] = random.choice(("STR", "DEX"))
        elif r == 5:
            t["viral"] = day
            self.say("By tonight half of Bellwether has seen it. Somebody "
                     "set it to music.", "info")
        d = self.d
        her = d and d["with"] and self.her_ok() and self.her_here()
        lost_her = d and d["with"] and not self.her_here() and \
            self.area.key[:2] == ("dun", "chopshop") and \
            "beat:chopshop" not in self.flags
        if lost_her:
            d["state"] = "taken"
            d["with"] = False
            self.say("When you come round, %s is gone. Rusty's men took "
                     "her, down into the chop shop." % d["name"], "bad")
            self.learn("rusty")
        if r == 6:
            self.hospital = True
            bill = 400
            p["debt"] += bill
            self.say("Bellwether General. A doctor shines a light in your "
                     "eyes. A bill for $%d, on your account." % bill, "bad")
            if d and d["state"] == "awake" and not lost_her:
                self.say("%s is in the chair by the bed. She hasn't "
                         "moved all night, the nurse says." % d["name"],
                         "her")
                self.affection(1, "was worried sick")
            self.pass_time(6 * 60, quiet=True)
            self.hospital = False
        else:
            self.pass_time(90, quiet=True)
        if self.overlay:
            return
        p["hp"] = max(1, roll("1d4"))
        if her:
            self.go_to_site("home", keep=True)
            self.her_say("carry")
            self.affection(1, "carried you home")
        else:
            self.go_to_site("home")
            self.say("You wake up on your own sofa. Somebody brought you "
                     "home. (HP %d)" % p["hp"], "info")

    def gain_level(self, why):
        """A level, for living through something."""
        p = self.p
        if p["level"] >= 10:
            return
        p["level"] += 1
        k = CLASSES[p["cls"]]
        n = random.randint(1, k.die)
        p["maxhp"] += n
        p["hp"] += n
        ups = []
        for s in STATS:
            tries = 2 if s in k.twice else 1
            for _ in range(tries):
                if random.randint(1, 20) > p["stats"][s] and \
                        p["stats"][s] < 18:
                    p["stats"][s] += 1
                    ups.append(s)
                    break
        self.refill_slots(p)
        self.wear_armor(p)
        self.sound.play("quest")
        self.say("LEVEL %d! (%s.) +%d HP%s." % (
            p["level"], why, n, (", " + ", ".join("+1 " + s for s in ups))
            if ups else ""), "quest")
        if self.d and self.d["state"] == "awake":
            self.d["maxhp"] = self.her_max_hp()
            self.d["hp"] = self.d["maxhp"]

    MINOR = ("buy", "setup", "clothes", "backup", "juniper", "old")

    def quest_done(self, qid, why):
        """An adventure lived through: a level (The Black Hack's rule).
        The little things are just done."""
        p = self.p
        if qid in p["quests"]:
            return False
        p["quests"].append(qid)
        if qid in self.MINOR:
            self.say("(%s.)" % cap(why), "quest")
            self.sound.play("gold")
        else:
            self.gain_level(why)
        return True

    # ── Time ──

    def now(self):
        return START + datetime.timedelta(minutes=self.turn)

    def day_no(self):
        return (self.now() - START.replace(hour=0)).days


    def date_text(self):
        t = self.now()
        return "%s %02d:%02d (Day %d)" % (WEEKDAYS[self.day_no() % 7],
                                          t.hour, t.minute,
                                          self.day_no() + 1)

    def clock(self):
        t = self.now()
        return t.hour * 60 + t.minute

    def phase(self):
        h = self.now().hour
        return ("night" if h >= 21 or h < 5 else "dawn" if h < 7 else
                "dusk" if h >= 19 else "day")

    def pass_time(self, minutes, quiet=False):
        """Time going by in a lump."""
        before = self.phase()
        self.interrupt = False
        for _ in range(minutes // 10):
            self.turn += 10
            if self.turn % 30 < 10:
                self.hourly()
            if self.overlay or "won" in self.flags:
                return
            if self.interrupt:
                return
        self.turn += minutes % 10
        if not quiet and self.phase() != before:
            self.say("It's %s now: %s." % (self.phase(), self.date_text()),
                     "info")
        self.hourly()

    def hourly(self):
        """What the clock brings."""
        if self.overlay or "won" in self.flags:
            return
        t = self.now()
        day = self.day_no()
        mins = t.hour * 60 + t.minute
        d = self.d
        if mins >= 6 * 60 and "morning:%d" % day not in self.flags and \
                day >= 1:
            self.flags.add("morning:%d" % day)
            self.morning()
        self.timers()
        ev = self.world["events"].get(day)
        if ev and mins >= ev[1] * 60 and "event_day:%d" % day not in \
                self.flags:
            self.flags.add("event_day:%d" % day)
            self.random_event(ev[0])
        self.event_tick()
        if d and not d["with"] and d["state"] == "awake" and \
                d["charge"] < 12 and t.minute < 10 and \
                "homecharge:%d" % (self.turn // 60) not in self.flags:
            self.flags.add("homecharge:%d" % (self.turn // 60))
            d["charge"] = 6 if d["charge"] < 6 else USAGE_CHAIN[
                USAGE_CHAIN.index(d["charge"]) - 1]
        if d and d["with"] and t.minute < 10 and t.hour % 2 == 0 and \
                "hourcharge:%d" % (self.turn // 60) not in self.flags:
            self.flags.add("hourcharge:%d" % (self.turn // 60))
            self.use_charge(2 if self.active_event("heatwave") else 1)
        p = self.p
        if self.area.dark and p["items"].get("flashlight") and \
                p["torch"] <= 0 and t.minute < 10 and \
                "torchhour:%d" % (self.turn // 60) not in self.flags:
            self.flags.add("torchhour:%d" % (self.turn // 60))
            self.use_item("flashlight")
        if self.turn >= CRASH and "crash" not in self.flags:
            self.flags.add("crash")
            self.crash()
        if self.turn >= DINNER - 120 and "dinner_soon" not in self.flags \
                and "dinner_done" not in self.flags:
            self.flags.add("dinner_soon")
            self.say(self.f("Your phone: {sis}. 'Dinner, seven o'clock. "
                            "Don't be late. Bring %s.'" % self.f("{her}").upper()),
                     "quest")
        if self.turn >= DINNER + 150 and "dinner_done" not in self.flags \
                and "dinner_missed" not in self.flags:
            self.flags.add("dinner_missed")
            self.say(self.f("Your phone: {sis}. 'We waited. The roast is "
                            "ruined. Thanks, {me}.'"), "bad")
            self.st["sister"] -= 2
        if 5 * DAY + 10 * 60 <= self.turn and "reset_news" not in \
                self.flags:
            self.flags.add("reset_news")
            self.say("The news: FEDERAL AGENTS RAID DAFFODIL HQ over the "
                     "stolen units. Daffodil's stock is down twenty "
                     "percent. A spokesperson says Update 7.2 will go out "
                     "on Sunday as planned.", "quest")
            self.say(self.f("Your phone: a text from Volt. 'Come by the "
                            "shop. Something's wrong with 7.2. Bring "
                            "{d}.'"), "quest")
        if self.turn >= RAID and "raid" not in self.flags:
            self.flags.add("raid")
            self.raid()
        if self.turn >= UPDATE - 60 and "update_soon" not in self.flags:
            self.flags.add("update_soon")
            self.say("Eleven o'clock on Sunday night. One hour to Update "
                     "7.2.", "quest")
        if self.turn >= UPDATE:
            self.the_end()

    def timers(self):
        """The things that happen on the minute: her delivery, and the
        end of her primary setup."""
        d = self.d
        if not d or self.overlay:
            return
        if d["state"] == "ordered" and self.st.get("delivery_at") is not \
                None and self.turn >= self.st["delivery_at"]:
            self.delivered()
        if d["state"] == "setup" and d.get("ready_at") is not None and \
                self.turn >= d["ready_at"] and \
                "setup_told" not in self.flags:
            self.flags.add("setup_told")
            self.setup_done()

    # ── Turns ──

    def on_key(self, ev):
        if self.talk or self.busy or ev.state & 0x0C:
            return
        k = ev.keysym
        self.walking = None
        if self.menu:
            k = k[3:] if k.startswith("KP_") else k
            if k in ("Up", "w", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "space", "KP_Enter"):
                self.menu_pick()
            elif k.isdigit() and 1 <= int(k) <= len(self.menu["items"]):
                self.menu_pick(int(k) - 1)
            else:
                self.menu_cancel()
            return
        if self.overlay:
            if self.overlay in ("won", "doom") and k in ("n", "N"):
                self.new_game()
            elif self.overlay not in ("won", "doom") or k in ("Escape",
                                                              "Return"):
                self.close_overlay()
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("e", "E"):
            self.search()
        elif k in ("c", "C"):
            self.ability_menu()
        elif k in ("l", "L"):
            self.luck_menu()
        elif k in ("u", "U"):
            self.use_menu()
        elif k in ("space", "period", "KP_5"):
            self.wait()
        elif k in ("z", "Z"):
            self.wait_until()
        elif k in ("i", "I"):
            self.show_sheet()
        elif k in ("o", "O"):
            self.show_her()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def close_overlay(self):
        if self.overlay in ("won", "doom"):
            self.action_menu()
            return
        self.overlay = None
        self.render()

    def ready(self):
        return not (self.busy or self.talk or self.overlay or self.menu)


    def can_stand(self, x, y):
        return self.area.grid[y][x] in WALKABLE

    def move(self, dx, dy):
        if not self.ready():
            return
        r = self.step(dx, dy)
        if r in ("moved", "turn"):
            slow = self.area.grid[self.pos[1]][self.pos[0]] in (
                "oil", "rubble")
            fast = self.area.kind == "city" and r == "moved" and \
                self.area.grid[self.pos[1]][self.pos[0]] in (
                    "road", "sidewalk", "crossing", "path", "lamp")
            self.end_turn(0.5 if fast else 1)
            if slow and not self.busy and not self.overlay:
                self.end_turn()

    TOUCHABLE = {"bed", "table", "counter", "desk", "shelf", "stove",
                 "terminal", "locker", "booth", "bench", "slot", "cards",
                 "workbench", "crate", "crate_open", "sofa", "window",
                 "sink", "plant", "server", "safe", "tv", "pod", "rack",
                 "mirror", "weights", "treadmill", "bar", "fridge", "piano",
                 "box", "wall", "fountain", "pool", "brick", "stucco",
                 "steel", "glass", "fence", "tree", "hedge", "sign",
                 "billboard"}
    LINK_TILES = {"door", "stairs_down"}

    def step(self, dx, dy):
        a = self.area
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if a.kind == "inside":
                self.go_outside()
            else:
                self.bump()
            return "done"
        mob = a.mob_at(x, y)
        if mob:
            if mob.hostile:
                self.attack(mob)
                self.end_turn()
            elif mob.ally:
                mob.x, mob.y, self.pos = self.pos[0], self.pos[1], [x, y]
                return "moved"
            else:
                self.start_talk(mob)
            return "done"
        t = a.grid[y][x]
        if t == "counter":
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return "done"
        link = a.links.get((x, y))
        if link and (t in self.LINK_TILES or a.kind == "inside"):
            self.enter_link(link, x, y)
            return "done"
        if t in self.TOUCHABLE and not self.can_stand(x, y):
            self.touch(t, x, y)
            return "done"
        if not self.can_stand(x, y):
            self.bump()
            return "done"
        self.pos = [x, y]
        if t == "exit":
            self.go_outside()
            return "done"
        if t == "stairs_down" and a.kind == "dungeon":
            self.change_level(1)
            return "done"
        if t == "stairs_up" and a.kind == "dungeon":
            self.change_level(-1)
            return "done"
        if self.step_on(x, y):
            return "turn"
        return "moved"

    def bump(self):
        self.say("Blocked.", "info")
        self.sound.play("bump")


    def end_turn(self, cost=1):
        """A turn: a minute, or half of one walking the streets."""
        a = self.area
        if "won" in self.flags:
            return
        before = self.phase()
        self.half = getattr(self, "half", 0) + cost
        ticked = self.half >= 1
        if ticked:
            self.half -= 1
            self.turn += 1
            p = self.p
            for k in ("ghost", "torch"):
                if p[k] > 0:
                    p[k] -= 1
        now = self.phase()
        if now != before and a.kind == "city":
            self.say({"dawn": "The sprinklers come on. Bellwether yawns.",
                      "day": "Bellwether is up and about.",
                      "dusk": "The streetlights come on along Main Street.",
                      "night": "Night. Bellwether's quiet. Mostly."}[now],
                     "info")
        if ticked:
            self.timers()
        if ticked and self.turn % 30 == 0:
            self.hourly()
            if self.overlay:
                return
        if ticked and self.turn % 10 == 0:
            self.refresh_people()
        if self.overlay:
            return
        self.render()
        for mob in list(a.mobs):
            if self.overlay or self.area is not a or self.p["out"]:
                return
            if mob not in a.mobs:
                continue
            if mob.ally:
                self.ally_act(mob)
            elif mob.hostile:
                self.monster_act(mob)
            else:
                self.wander(mob)
            if self.overlay or self.area is not a:
                return
        if a.kind == "city" and ticked:
            self.spawn_city()
        self.render()

    # ── Troublemakers ──

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        if (x, y) in a.links:
            return False
        if a.kind == "city":
            return t in CITY_GROUND
        if a.kind == "inside":
            return t in INSIDE_FLOOR
        return t in DUNGEON_FLOOR and t not in ("stairs_up", "stairs_down")

    def monster_act(self, mob):
        m = MONSTERS[mob.kind]
        if mob.stuck:
            mob.stuck -= 1
            return
        if "still" in m.traits:
            return
        if "slow" in m.traits and self.turn % 2:
            return
        if mob.kind == "goose" and self.area.kind == "city" and \
                not mob.event:
            mob.timer = getattr(mob, "timer", 0) + 1
            if mob.timer > 10:
                self.area.mobs.remove(mob)
                self.say("The goose loses interest and stalks back to the "
                         "pond, muttering.", "info")
                return
        steps = 2 if "fast" in m.traits else 1
        for _ in range(steps):
            if mob not in self.area.mobs or not mob.hostile or self.overlay \
                    or self.p["out"]:
                return
            if self.monster_step(mob, m):
                return

    def noticed(self, mob, dist):
        p = self.p
        if p["ghost"] > 0 and "robot" in MONSTERS[mob.kind].traits:
            return dist == 0
        if dist <= 1:
            return True
        if (mob.x, mob.y) not in self.visible or dist > 6:
            return False
        if p["cls"] == "Hustler" and random.random() < 0.6:
            return False
        return True

    def monster_step(self, mob, m):
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if not mob.aware:
            if self.noticed(mob, dist):
                mob.aware = True
            else:
                self.drift(mob)
                return False
        if mob.flee > 0:
            mob.flee -= 1
            for sx, sy in sorted(DIRS, key=lambda d: -abs(px - mob.x - d[0])
                                 - abs(py - mob.y - d[1])):
                if self.can_go(mob, mob.x + sx, mob.y + sy):
                    mob.x += sx
                    mob.y += sy
                    break
            if mob.flee == 0 and "human" in m.traits and mob in \
                    self.area.mobs and self.area.kind != "dungeon":
                self.area.mobs.remove(mob)
            return False
        her = next((h for h in self.area.mobs if h.her and h.ally), None)
        if her and abs(her.x - mob.x) + abs(her.y - mob.y) == 1 and \
                random.random() < 0.35 and self.her_ok():
            self.attack_her(mob, her)
            return True
        if dist == 1 or (m.ranged and dist <= 4 and (mob.x, mob.y) in
                         self.visible):
            self.attacked(mob)
            return True
        chase = dist <= 10
        if chase:
            order = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                           abs(py - mob.y - d[1]) + random.random() * 0.5)
        else:
            order = [random.choice(DIRS)]
        for sx, sy in order[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break
        return False

    def drift(self, mob):
        if random.random() < 0.3:
            sx, sy = random.choice(DIRS)
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy


    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        if self.can_go(mob, x, y) and self.area.grid[y][x] in mob.roam:
            mob.x, mob.y = x, y

    def spawn_city(self):
        """At night, a mugger now and then; by the pond, the geese, any
        time."""
        a = self.area
        px, py = self.pos
        x0, y0, x1, y1 = a.park
        if x0 <= px <= x1 and y0 <= py <= y1 and \
                abs(px - a.pond[0]) + abs(py - a.pond[1]) <= 4 and \
                not any(m.kind == "goose" for m in a.mobs) and \
                random.random() < 0.03:
            for _ in range(10):
                x = a.pond[0] + random.randint(-2, 2)
                y = a.pond[1] + random.randint(-2, 2)
                if a.inside(x, y) and a.grid[y][x] in CITY_GROUND and \
                        not a.mob_at(x, y) and [x, y] != self.pos:
                    m = make_monster("goose", x, y)
                    a.mobs.append(m)
                    self.say("HONK. A goose has seen you. It does not like "
                             "what it sees.", "bad")
                    break
        if self.phase() != "night":
            a.mobs = [m for m in a.mobs if m.kind not in ("mugger", "drunk")
                      or abs(m.x - px) + abs(m.y - py) <= 6]
            return
        if random.random() > 0.02 or sum(m.kind in ("mugger", "drunk")
                                         for m in a.mobs) >= 2:
            return
        for _ in range(20):
            x = px + random.randint(-12, 12)
            y = py + random.randint(-12, 12)
            if (not a.inside(x, y) or a.grid[y][x] not in CITY_GROUND
                    or (x, y) in self.visible or a.mob_at(x, y)
                    or abs(x - px) + abs(y - py) < 8):
                continue
            a.mobs.append(make_monster(random.choice(("mugger", "drunk")),
                                       x, y))
            return

    # ── Fights ──

    def weapon(self):
        """Your best weapon for your class, or your fists."""
        p = self.p
        k = CLASSES[p["cls"]]
        for w in k.weapons:
            if p["items"].get(w):
                return w
        return None

    def armor_penalty(self):
        p = self.p
        k = CLASSES[p["cls"]]
        worn = [a for a in ARMOR if p["items"].get(a)]
        best = max(worn, key=ARMOR.get) if worn else None
        pen = ARMOR[best] if best and best not in k.armor else 0
        if p["items"].get("trash can lid") and "trash can lid" not in \
                k.armor:
            pen += SHIELD["trash can lid"]
        return pen

    def attack(self, mob):
        """Walking into a troublemaker: hit it (roll under STR).  A
        Bruiser swings once a level."""
        p = self.p
        m = MONSTERS[mob.kind]
        if p["out"]:
            return
        mob.aware_before = mob.aware
        swings = p["level"] if p["cls"] == "Bruiser" else 1
        for n in range(swings):
            if mob not in self.area.mobs or not mob.hostile:
                break
            sneak = p["cls"] == "Hustler" and not mob.aware
            ok = self.test("STR", mod=self.armor_penalty(), adv=sneak,
                           label="attack" if not sneak else "from behind",
                           hd=m.hd)
            mob.aware = True
            if not ok:
                self.say("You miss %s." % self.the(mob), "info")
                continue
            w = self.weapon()
            k = CLASSES[p["cls"]]
            dmg = roll("2d6+%d" % p["level"] if sneak else
                       (k.dmg if w else k.bare))
            if self.last_d20 == 1:
                dmg *= 2
                self.say("A perfect hit!", "good")
            mob.hp -= dmg
            self.flash(mob.x, mob.y)
            self.sound.play("hit")
            self.say("You hit %s%s. (%d)" % (
                self.the(mob), " with your %s" % w if w else "", dmg),
                "good")
            if mob.hp <= 0:
                self.beaten(mob)
        if self.her_here() and "fight:%d" % (self.turn // 120) not in \
                self.flags:
            self.flags.add("fight:%d" % (self.turn // 120))
            self.her_say("fight")
            self.use_charge()

    def attacked(self, mob):
        """It attacks: roll under STR (DEX if it's at range) to get out of
        the way."""
        p = self.p
        m = MONSTERS[mob.kind]
        s = "DEX" if m.ranged and abs(mob.x - self.pos[0]) + abs(
            mob.y - self.pos[1]) > 1 else "STR"
        adv = p["cls"] == "Hustler" and m.ranged
        if p["items"].get("pepper spray") and "human" in m.traits and \
                p["hp"] <= p["maxhp"] // 2:
            adv = True
            self.use_item("pepper spray", quiet=True)
            self.say("You blast %s with pepper spray." % self.the(mob),
                     "good")
        ok = self.test(s, mod=self.armor_penalty(), adv=adv,
                       label="dodging", hd=m.hd)
        if ok:
            self.say("%s misses you." % cap(self.the(mob)), "info")
            return
        dmg = roll(HD_DAMAGE[min(8, m.hd)])
        if self.last_d20 == 20:
            dmg *= 2
        if mob.kind == "goose":
            self.lose_hp(1, random.choice((
                "The goose bites your ankle.", "The goose wallops you with "
                "a wing.", "The goose gets you right in the dignity.")))
            return
        if p["items"].get("trash can lid") and p["cls"] in ("Bruiser",) and \
                dmg >= p["hp"]:
            self.take_item("trash can lid")
            self.wear_armor(p)
            self.say("You throw up the trash can lid. CLANG! It's ruined, "
                     "but you're not.", "good")
            return
        self.lose_hp(dmg, "%s hits you." % cap(self.the(mob)))

    def attack_her(self, mob, her):
        d = self.d
        m = MONSTERS[mob.kind]
        if self.her_test("DEX", m.hd, "%s dodging" % d["name"]):
            self.say("%s goes for %s, who isn't there any more." % (
                cap(self.the(mob)), d["name"]), "info")
            return
        dmg = roll(HD_DAMAGE[min(8, m.hd)])
        d["hp"] -= dmg
        self.flash(her.x, her.y)
        self.say("%s hits %s. (%d)" % (cap(self.the(mob)), d["name"], dmg),
                 "bad")
        if d["hp"] <= 0:
            d["hp"] = 0
            d["state"] = "down"
            her.ally = False
            her.tile = "her"
            self.her_say("down")
            self.say("%s is in safe mode. She'll reboot once you get her "
                     "out of here. (Or Smelling Salts.)" % d["name"], "bad")

    def ally_act(self, mob):
        """Her turn, in a fight, or following you."""
        a = self.area
        px, py = self.pos
        d = self.d
        if mob.her and self.her_ok():
            for dx, dy in DIRS:
                t = a.mob_at(mob.x + dx, mob.y + dy)
                if t and t.hostile:
                    m = MONSTERS[t.kind]
                    if self.her_test("STR", m.hd, d["name"]):
                        dmg = roll("1d8+2" if "Bodyguard" in d["mods"]
                                   else "1d6")
                        t.hp -= dmg
                        t.aware = True
                        self.flash(t.x, t.y)
                        self.say("%s hits %s. (%d)" % (
                            d["name"], self.the(t), dmg), "good")
                        if t.hp <= 0:
                            self.beaten(t, by_her=True)
                    return
        for sx, sy in sorted(DIRS, key=lambda dd: abs(px - mob.x - dd[0]) +
                             abs(py - mob.y - dd[1])):
            if abs(px - mob.x) + abs(py - mob.y) <= 1:
                break
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break

    def beaten(self, mob, by_her=False):
        a = self.area
        m = MONSTERS[mob.kind]
        if mob in a.mobs:
            a.mobs.remove(mob)
        self.flash(mob.x, mob.y, "puff")
        self.sound.play("kill")
        self.say(m.beaten, "good")
        if mob.kind in ("mugger", "goon"):
            n = roll("1d6") * 5
            self.p["coins"] += n
            self.say("(%s dropped $%d.)" % (cap(self.the(mob)), n), "gold")
        if by_her and self.d:
            self.learns(2)
        if mob.kind == "rusty":
            self.rusty_beaten()
        elif mob.kind == "paragon":
            self.flags.add("beat:dataplex")
