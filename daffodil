    # ── The raid ──

    def raid(self):
        """Friday night: Rusty's men come for her."""
        d = self.d
        if not d or "beat:chopshop" in self.flags or d["with"] or \
                d["state"] not in ("awake",) or getattr(self, "hospital",
                                                        False):
            return
        if self.area.site == "home":
            self.say("Two in the morning. The power goes off. Then the "
                     "back door opens, very quietly, and two men in "
                     "grease-black overalls come in with a dolly.", "bad")
            for x, y in ((7, 6), (9, 7)):
                if not self.area.mob_at(x, y) and [x, y] != self.pos:
                    m = make_monster("goon", x, y)
                    m.aware = True
                    self.area.mobs.append(m)
            self.interrupt = True
            return
        d["state"] = "taken"
        d["where"] = "taken"
        self.cache.pop(("bld", "home"), None)
        self.flags.add("taken_news")

