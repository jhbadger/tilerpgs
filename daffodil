           "mat", "dance", "wall", "exit"] + list(FURNITURE) + \
    ["dwall_" + t for t in THEME_NAMES] + \
    ["dfloor_" + t for t in THEME_NAMES] + \
    ["cable", "oil", "rubble", "stairs_down", "stairs_up"]
ANIMATED_TERRAIN = {"lamp", "glass", "fountain", "pool", "sign",
                    "billboard", "flowers", "dance", "stove", "window",
                    "server", "tv", "pod", "mirror", "treadmill", "oil"}


def all_tiles():
    """name -> pixel rows, for every tile and animation frame."""
    tiles = {}
    for name in TERRAIN:
        tiles[name] = draw_terrain(name)
        if name in ANIMATED_TERRAIN:
            tiles[name + "@1"] = draw_terrain(name, 1)
    sprites = {}
    for name, (shape, pal) in PEOPLE.items():
        sprites[name] = art_pixels(pal, PERSON_SHAPES[shape])
    for name, (pal, rows) in ART.items():
        sprites[name] = art_pixels(pal, rows)
    still = {"hit", "heart", "sparkle", "puff", "zzz", "zap"} | FLOOR_ITEMS
    for name, px in sprites.items():
        tiles[name] = px
        SPRITES.add(name)
        if name in still:
            continue
        tiles[name + "@1"] = px[1:] + [[None] * 16]     # a bob: up a pixel
    return tiles

