    def talk_down(self):
        """The Medic's Talk Down: every human troublemaker near you tests
        your WIS, plus its Hit Dice, or backs off."""
        near = [m for m in self.area.mobs if m.hostile and "human" in
                MONSTERS[m.kind].traits and abs(m.x - self.pos[0]) +
                abs(m.y - self.pos[1]) <= 5]
        if not near:
            self.say("There's nobody here to talk down.", "info")
            return
        for m in near:
            if m.kind == "rusty":
                self.say("Rusty isn't listening to anybody.", "bad")
                continue
            if self.test("WIS", mod=MONSTERS[m.kind].hd, label="talking "
                         "down " + self.the(m)):
                m.flee = 10
                self.say("%s backs off, hands up." % cap(self.the(m)),
                         "good")
        self.end_turn()

