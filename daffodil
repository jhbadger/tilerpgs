        self.ask_duties()

    def ask_duties(self):
        d = self.d
        if getattr(self, "headless", False):
            d["duties"] = ["house", "cook"]
            d["style"] = "middle"
            self.name_her(DAFFODIL_NAMES[0] if d["design"]["frame"] == "F"
                          else DAFFODIL_NAMES_M[0])
            return

        def duty(k):
            d["duties"] = sorted({"house", k})
            self.say("You: %s." % dict(DUTIES)[k], "you")
            self.open_menu("'What clothing, if any, do you wish me to "
                           "wear?'", [(t, lambda k=k: style(k))
                                      for k, t in STYLES])

        def style(k):
            d["style"] = k
            self.say("You: %s." % dict(STYLES)[k], "you")
            if k == "provocative":
                self.say("Your Daffodil: Provocatively. Understood. Within "
                         "the law.", "her")
            self.ask_name()
        self.open_menu("'What initial duties do you wish me to have?'",
                       [(t, lambda k=k: duty(k)) for k, t in DUTIES])

    def ask_name(self):
        """'What name would you like me to answer to?'"""
        d = self.d
        root = self.root
        names = DAFFODIL_NAMES if d["design"]["frame"] == "F" else \
            DAFFODIL_NAMES_M
        dlg = tk.Toplevel(root, bg=PANEL, padx=16, pady=12)
        dlg.title("Her name")
        dlg.transient(root)
        dlg.resizable(False, False)
        tk.Label(dlg, text="'What name would you like me to answer to?'",
                 bg=PANEL, fg=ACCENT, font=F("Helvetica", 13, "bold")
                 ).pack(anchor="w")
        tk.Label(dlg, text="(A book of virtue names is open on your phone.)",
                 bg=PANEL, fg=INK_DIM, font=F("Helvetica", 11, "italic")
                 ).pack(anchor="w")
        e = tk.Entry(dlg, bg=LOG_BG, fg=INK, insertbackground=INK,
                     font=F(*MONO), width=20, highlightthickness=0)
        e.insert(0, random.choice(names))
        e.pack(anchor="w", pady=6)
        grid = tk.Frame(dlg, bg=PANEL)
        grid.pack(anchor="w")
        for n, nm in enumerate(names[:12]):
            tk.Button(grid, text=nm, width=9, highlightbackground=PANEL,
                      command=lambda nm=nm: (e.delete(0, "end"),
                                             e.insert(0, nm))).grid(
                row=n // 4, column=n % 4, padx=1, pady=1)
        out = {}

        def ok(_=None):
            out["name"] = " ".join(e.get().split())[:16]
            dlg.destroy()
        tk.Button(dlg, text="That's her name", command=ok,
                  highlightbackground=PANEL).pack(anchor="e", pady=(8, 0))
        dlg.bind("<Return>", ok)
        e.focus_set()
        e.select_range(0, "end")
        self.fit_dialog(dlg)
        dlg.geometry("+%d+%d" % (
            root.winfo_rootx() + max(0, (root.winfo_width() -
                                         dlg.winfo_reqwidth()) // 2),
            root.winfo_rooty() + max(0, min(60, (root.winfo_height() -
                                                 dlg.winfo_reqheight()) //
                                            2))))
        dlg.grab_set()
        root.wait_window(dlg)
        self.name_her(out.get("name") or random.choice(names))

    def name_her(self, name):
        d = self.d
        d["name"] = cap(name)
        d["ready_at"] = self.turn + SETUP1
        self.dnames()
        self.say("You: %s. Your name is %s." % (d["name"], d["name"]), "you")
        self.say("%s: %s. %s" % (d["name"], d["name"], NAME_MEANINGS.get(
            d["name"], "That is a good name.")), "her")
        for m in self.area.mobs:
            if m.her:
                m.name = m.title = d["name"]
        self.say("Then %s goes perfectly still. Six hours. And %s's "
                 "naked. You should probably do something about that." % (
                     self.f("{she}"), self.f("{she}")), "info")
        self.learn("setup")

    def setup_done(self):
        """Six hours later: 'The primary setup procedure is complete.'"""
        d = self.d
        d["state"] = "awake"
        d["affection"] = max(d["affection"], 1)
        self.cache.pop(("bld", "home"), None)
        if self.area.site == "home":
            self.cache[("bld", "home")] = self.area
            self.say(("You wake in the night: %s is standing by the bed, "
                      "looking down at you." if getattr(self, "sleeping",
                                                        False) else
                      "You turn round and jump: %s is standing right "
                      "behind you.") % d["name"], "quest")
            self.say("%s: The primary setup procedure is complete. The "
                     "secondary setup procedure requires approximately "
                     "thirty-six hours. During this period I will be "
                     "capable of other activities." % d["name"], "her")
            if d["wardrobe"]:
                self.dressed_up()
            self.ask_calls()
        else:
            self.say("Your phone buzzes: DAFFODIL. '%s's primary setup is "
                     "complete!'" % d["name"], "quest")
            self.flags.add("needs_calls")

    def dressed_up(self):
        """She finds the clothes you left out."""
        d = self.d
        if "dressed_up" in self.flags:
            return
        self.flags.add("dressed_up")
        c = d["wearing"]
        self.say("%s picks up the %s, and holds it against herself, and "
                 "smiles: the first real smile. She goes off to wash up and "
                 "change, and comes back in it, and twirls, and bounces "
                 "twice on her toes." % (d["name"], c), "her")
        self.paint_people()
        self.quest_done("clothes", "she's got something to wear")

    def ask_calls(self):
        d = self.d
        self.flags.discard("needs_calls")

        def call(k):
            d["calls"] = k
            self.dnames()
            if k == "Master":
                self.her_say("master")
                self.say("(Your neighbor is going to LOVE this.)", "info")
            else:
                self.say("%s: Very well, %s." % (d["name"],
                                                 self.f("{you}")), "her")
            self.say("(Talk to her: walk into her. She learns from "
                     "everything you do together.)", "info")
            self.quest_done("setup", "she's awake")
        if getattr(self, "headless", False):
            call("your name")
            return
        self.open_menu("'What should I call you?'",
                       [("%s" % ({"your name": self.p["first"]}.get(k, k)),
                         lambda k=k: call(k)) for k in CALLS])

    # ── The crash ──

    def crash(self):
        d = self.d
        if not d or d["state"] != "awake":
            return
        d["state"] = "crashed"
        here = d["with"] or (self.area.site == "home")
        self.dismiss(quiet=True)
        if here:
            self.say("In the middle of a sentence, %s stops. Just stops. "
                     "Mouth open, eyes open, nothing behind them." %
                     d["name"], "bad")
        else:
            self.say("Your phone: DAFFODIL TECH SUPPORT. 'A small service "
                     "update was pushed at 23:38. A small percentage of "
                     "Companion units have failed to reboot.'", "bad")
        self.say("(Tech support's known issues page: 'Your Companion may "
                 "be restarted with the button on the back of the neck.')",
                 "info")
        self.cache.pop(("bld", "home"), None)

    def reboot_menu(self):
        d = self.d
        self.open_menu(self.mf("%s isn't moving. Her eyes are open, and "
                               "empty." % d["name"]), [
                           (self.mf("Press the button on her neck: one, "
                                    "two, three"), self.reboot),
                           ("Not yet", lambda: None)])

    def reboot(self):
        d = self.d
        self.say("One. Two. Three.", "you")
        self.say("%s blinks. Stands. Looks at you without the least "
                 "recognition." % d["name"], "info")
        self.her_say("rebooted", self.world["serial"])
        self.say("...", "info")
        self.say("%s: Restoring from Dataplex backup. 12 percent. 58 "
                 "percent. 100 percent." % d["name"], "her")
