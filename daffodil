        "................", "................", "................",
        "................")),
}

# Things on the floor: their tile, and what stepping on them gives.
FLOOR_ITEMS = {"badge", "chest", "coins", "boxed", "oldbot"}

def grass(rng, base="#5a9a4a"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.12), shade(base, 0.88), "#6aaa52"], 0.4)
    for _ in range(5):
        x, y = rng.randrange(16), rng.randrange(1, 16)
        g[y][x] = g[y - 1][x] = shade(base, 1.25)
    return g


def boarding(rng, base="#a8784a", seam="#7a5028", width=4):
    """Floorboards, running across."""
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.07), shade(base, 0.93)], 0.3)
    for y in range(0, 16, width):
        rect(g, 0, y, 15, y, seam)
        x = rng.randrange(16)
        rect(g, x, y + 1, x, y + width - 1, seam)
    return g


def bricks(rng, base="#8a4a3a", mortar="#4a2a20"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.1), shade(base, 0.88)], 0.3)
    for y in range(0, 16, 4):
        rect(g, 0, y, 15, y, mortar)
        off = 0 if y % 8 == 0 else 4
        for x in range(off, 16, 8):
            rect(g, x, y, x, y + 3, mortar)
    return g


def papered(rng, base, stripe, dado="#5a3a2a"):
    """A papered wall, striped, with a wooden dado below."""
    g = grid_of(base)
    for x in range(0, 16, 4):
        rect(g, x, 0, x, 10, stripe)
    rect(g, 0, 11, 15, 15, dado)
    rect(g, 0, 11, 15, 11, shade(dado, 1.4))
    speckle(g, rng, [shade(base, 0.96)], 0.05)
    return g


def concrete(rng, base="#a8a49c"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.06), shade(base, 0.92)], 0.35)
    return g


FURNITURE = ("bed", "table", "counter", "desk", "shelf", "stove",
             "terminal", "locker", "booth", "bench", "slot", "cards",
             "workbench", "crate", "crate_open", "sofa", "window", "sink",
             "plant", "server", "safe", "tv", "pod", "rack", "mirror",
             "weights", "treadmill", "bar", "fridge", "piano", "box")


def draw_terrain(name, frame=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random(name + str(frame))
    # ── the town ──
    if name == "road":
        return concrete(rng, "#4a4a50")
    if name == "crossing":
        g = concrete(rng, "#4a4a50")
        for x in range(0, 16, 4):
            rect(g, x, 0, x + 1, 15, "#e8e8e0")
        return g
    if name == "sidewalk":
        g = concrete(rng, "#c8c4bc")
        rect(g, 0, 7, 15, 7, "#a8a49c")
        rect(g, 7, 0, 7, 15, "#a8a49c")
        return g
    if name == "plaza":
        g = concrete(rng, "#d8ccb8")
        for y in range(0, 16, 8):
            rect(g, 0, y, 15, y, "#b8ac98")
        for x in range(0, 16, 8):
            rect(g, x, 0, x, 15, "#b8ac98")
        return g
    if name == "grass":
        return grass(rng)
    if name == "path":
        g = grid_of("#d8c098")
        speckle(g, rng, ["#c8b088", "#e4d0a8"], 0.4)
        return g
    if name == "flowers":
        g = grass(rng)
        for _ in range(7):
            x, y = rng.randrange(1, 15), rng.randrange(1, 15)
            c = rng.choice(("#f0d040", "#f06a8a", "#f4f4f4", "#e0a020"))
            g[y][x] = c
            if frame and x < 15:
                g[y][x + 1] = shade(c, 0.8)
        return g
    if name == "tree":
        g = grass(rng)
        rect(g, 6, 10, 9, 15, "#6a4a2a")
        disc(g, 7.5, 6, 6, "#3a7a3a")
        disc(g, 5.5, 5, 3, "#4a8a4a")
        return g
    if name == "hedge":
        g = grid_of("#3a6a32")
        speckle(g, rng, ["#4a7a3a", "#2a5a2a", "#5a8a42"], 0.6)
        return g
    if name == "lot":
        g = grid_of("#7a7a7a")
        speckle(g, rng, ["#6a6a6a", "#8a8a8a", "#5a5a5a"], 0.5)
        for y in (3, 11):
            rect(g, 0, y, 3, y, "#e8e8e0")
        return g
    if name == "lamp":
        g = draw_terrain("sidewalk")
        rect(g, 7, 4, 8, 15, "#3a3a3a")
        rect(g, 4, 1, 11, 4, "#f8e8a0" if frame else "#f0d070")
        return g
    if name == "brick":
        return bricks(rng, "#a85a42", "#6a3a2a")
    if name == "stucco":
        g = grid_of("#f0e0c8")
        speckle(g, rng, ["#e4d4bc", "#f8ecd8"], 0.3)
        rect(g, 0, 14, 15, 15, "#c8a87a")
        return g
    if name == "steel":
        g = grid_of("#8a9098")
        for x in range(0, 16, 3):
            rect(g, x, 0, x, 15, "#6a7078")
        return g
    if name == "glass":
        g = grid_of("#4a7aa0")
        for x in range(0, 16, 8):
            rect(g, x, 0, x, 15, "#d0d8e0")
        for y in range(0, 16, 8):
            rect(g, 0, y, 15, y, "#d0d8e0")
        rect(g, 2, 2, 4, 3, "#9ac0e0" if frame else "#7aa0c0")
        return g
    if name == "fence":
        g = grass(rng)
        for y in range(16):
            for x in range(16):
                if (x + y) % 4 == 0 or (x - y) % 4 == 0:
                    g[y][x] = "#9a9aa0"
        return g
    if name == "gate":
        g = draw_terrain("lot")
        for y in range(16):
            for x in range(16):
                if ((x + y) % 4 == 0 or (x - y) % 4 == 0) and 2 < x < 13:
                    g[y][x] = "#c0c0c8"
        return g
    if name == "fountain":
        g = concrete(rng, "#d8ccb8")
        disc(g, 7.5, 7.5, 7, "#c0b8a8")
        disc(g, 7.5, 7.5, 5.5, "#4a8ac0")
        for y in range(16):
            for x in range(16):
                if g[y][x] == "#4a8ac0" and (x + y * 2 + frame) % 5 == 0:
                    g[y][x] = "#a0d0f0"
        rect(g, 7, 5, 8, 9, "#f0f8ff" if frame else "#d0e8f8")
        return g
    if name == "pool":
        g = grid_of("#3a8ac8")
        for y in range(16):
            for x in range(16):
                if (x + y * 2 + frame) % 7 == 0:
                    g[y][x] = "#8ac8f0"
        return g
    if name == "sign":
        g = grid_of("#1a1a24")
        rect(g, 1, 4, 14, 11, "#f0d040" if frame else "#d0b020")
        rect(g, 3, 6, 12, 9, "#fff8d0")
        return g
    if name == "billboard":
        g = grid_of("#2a2a34")
        rect(g, 0, 2, 15, 12, "#3a8a3a")
        disc(g, 7.5, 7, 3.5, "#f0d040" if frame else "#e0c030")
        disc(g, 7.5, 7, 1.5, "#e08a20")
        rect(g, 7, 13, 8, 15, "#5a5a5a")
        return g
    if name == "door":
        g = draw_terrain("stucco")
        rect(g, 3, 1, 12, 15, "#5a3a1a")
        rect(g, 4, 2, 11, 7, "#7a4a22")
        rect(g, 10, 9, 10, 9, "#e0c040")
        return g
    # ── indoors ──
    if name == "floor":
        return boarding(rng)
    if name == "boards":
        return boarding(rng, "#8a6a42", "#5a4228", 5)
    if name == "tiles":
        g = grid_of("#eceae4")
        for y in range(16):
            for x in range(16):
                if x % 8 == 0 or y % 8 == 0:
                    g[y][x] = "#c8c4bc"
        return g
    if name == "carpet":
        g = grid_of("#5a3a6a")
        speckle(g, rng, ["#6a4a7a", "#4a2a5a"], 0.3)
        return g
    if name == "rug":
        g = grid_of("#b04a3a")
        rect(g, 1, 1, 14, 14, "#d0a040")
        rect(g, 3, 3, 12, 12, "#b04a3a")
        rect(g, 6, 6, 9, 9, "#f0e0b0")
        return g
    if name == "mat":
        g = grid_of("#2a2a34")
        speckle(g, rng, ["#34343e"], 0.3)
        rect(g, 0, 0, 15, 0, "#e04a2a")
        rect(g, 0, 15, 15, 15, "#e04a2a")
        return g
    if name == "dance":
        g = grid_of("#1a1a24")
        cols = ("#f040a0", "#40a0f0", "#f0d040", "#40f0a0")
        for by in range(2):
            for bx in range(2):
                c = cols[(bx + by * 2 + frame) % 4]
                rect(g, bx * 8 + 1, by * 8 + 1, bx * 8 + 6, by * 8 + 6, c)
        return g
    if name == "wall":
        return papered(rng, "#e8dcc8", "#d8c8b0", "#7a5a3a")
    if name == "exit":
        g = boarding(rng)
        rect(g, 4, 6, 11, 15, "#3a2a1a")
        rect(g, 5, 6, 10, 6, "#f0e0a0")
        return g
    if name in FURNITURE:
        g = boarding(rng)
        wood = "#6a3a1a"
        if name == "bed":
            rect(g, 1, 1, 14, 14, wood)
            rect(g, 2, 2, 13, 5, "#f4f4f4")
            rect(g, 2, 6, 13, 13, "#c05a7a")
        elif name == "table":
            rect(g, 1, 3, 14, 11, "#8a5a2a")
            rect(g, 2, 12, 3, 15, wood)
            rect(g, 12, 12, 13, 15, wood)
            rect(g, 5, 5, 10, 8, "#f4f4f4")
        elif name == "counter":
            rect(g, 0, 2, 15, 13, "#9a7a5a")
            rect(g, 0, 2, 15, 4, "#e8e0d0")
        elif name == "desk":
            rect(g, 1, 3, 14, 12, "#5a2a12")
            rect(g, 3, 5, 7, 8, "#f4f0e0")
        elif name == "shelf":
            rect(g, 0, 0, 15, 15, wood)
            for y in (1, 6, 11):
                for x in range(1, 15):
                    if rng.random() < 0.8:
                        rect(g, x, y, x, y + 3, rng.choice((
                            "#a02a2a", "#2a5a8a", "#3a7a3a", "#c0a030",
                            "#8a8a8a", "#e0d8c0")))
        elif name == "stove":
            rect(g, 1, 1, 14, 14, "#e8e8ec")
            for x in (4, 10):
                disc(g, x, 4, 1.5, "#e04010" if frame else "#5a5a5a")
            rect(g, 3, 8, 12, 13, "#3a3a40")
        elif name in ("terminal", "server"):
            rect(g, 1, 1, 14, 14, "#2a2c34")
            rect(g, 3, 3, 12, 8, "#0a2a3a")
            for y in (4, 6):
                rect(g, 4, y, rng.randrange(6, 11), y,
                     "#40e0f0" if name == "terminal" else "#40f080")
            if name == "server":
                for y in range(10, 14, 2):
                    for x in range(3, 13, 3):
                        g[y][x] = "#f04040" if (x + y + frame) % 3 else \
                            "#40f040"
        elif name == "locker":
            rect(g, 2, 0, 13, 15, "#5a6a7a")
            rect(g, 7, 0, 8, 15, "#3a4a5a")
        elif name == "booth":
            rect(g, 0, 2, 15, 13, "#7a2a3a")
            rect(g, 2, 5, 13, 10, "#f0e8d8")
        elif name == "bench":
            rect(g, 1, 6, 14, 9, "#8a5a2a")
            rect(g, 2, 10, 3, 13, "#3a3a3a")
            rect(g, 12, 10, 13, 13, "#3a3a3a")
        elif name == "slot":
            rect(g, 3, 1, 12, 15, "#c0a030")
            rect(g, 4, 3, 11, 7, "#1a1a1a")
            for x in (5, 7, 9):
                g[5][x] = rng.choice(("#f02020", "#f0f020", "#20f020"))
            rect(g, 13, 3, 13, 7, "#c02020")
        elif name == "cards":
            rect(g, 0, 2, 15, 13, "#1a6a3a")
            rect(g, 4, 6, 6, 9, "#f4f4f4")
            rect(g, 9, 6, 11, 9, "#f4f4f4")
        elif name == "workbench":
            rect(g, 0, 3, 15, 12, "#7a6a5a")
            rect(g, 2, 5, 5, 7, "#c0c0c8")
            rect(g, 8, 6, 12, 7, "#d0a020")
        elif name in ("crate", "crate_open"):
            rect(g, 1, 3, 14, 14, "#8a6a4a")
            rect(g, 1, 8, 14, 8, "#5a3a1a")
            if name == "crate_open":
                rect(g, 3, 5, 12, 12, "#2a1a10")
        elif name == "sofa":
            rect(g, 0, 3, 15, 14, "#f0f0ec")
            rect(g, 2, 6, 13, 11, "#d8d8d4")
        elif name == "window":
            g = papered(rng, "#e8dcc8", "#d8c8b0", "#7a5a3a")
            rect(g, 2, 1, 13, 10, "#f0f0f0")
            rect(g, 3, 2, 12, 9, "#a0d0f0" if frame else "#90c0e8")
        elif name == "sink":
            rect(g, 1, 3, 14, 13, "#d8dce4")
            rect(g, 3, 5, 12, 11, "#8ab0d0")
        elif name == "plant":
            rect(g, 5, 10, 10, 14, "#a05a2a")
            disc(g, 7.5, 6, 4.5, "#3a8a3a")
            g[4][6] = g[6][9] = "#f0d040"
        elif name == "safe":
            rect(g, 2, 2, 13, 14, "#3a3a44")
            disc(g, 7.5, 8, 2.5, "#c0c0c8")
        elif name == "tv":
            rect(g, 0, 2, 15, 12, "#1a1a1a")
            rect(g, 1, 3, 14, 10, "#6a8ab0" if frame else "#5a7aa0")
        elif name == "pod":
            rect(g, 3, 0, 12, 15, "#f0f0f4")
            rect(g, 4, 1, 11, 14, "#f8e890" if frame else "#f0e080")
            rect(g, 6, 3, 9, 12, "#f0c8a0")
        elif name == "rack":
            rect(g, 1, 2, 14, 2, "#8a8a94")
            for x in range(2, 14, 3):
                rect(g, x, 3, x + 1, 13, rng.choice((
                    "#f06a8a", "#3a6ae0", "#f0d040", "#1a1a22", "#c03a5a",
                    "#f4f4f4")))
        elif name == "mirror":
            g = papered(rng, "#e8dcc8", "#d8c8b0", "#7a5a3a")
            rect(g, 3, 1, 12, 14, "#c0a040")
            rect(g, 4, 2, 11, 13, "#d8e8f0" if frame else "#c8d8e8")
        elif name == "weights":
            g = draw_terrain("mat")
            rect(g, 2, 7, 13, 8, "#9a9aa0")
            rect(g, 1, 4, 3, 11, "#2a2a2a")
            rect(g, 12, 4, 14, 11, "#2a2a2a")
        elif name == "treadmill":
            g = draw_terrain("mat")
            rect(g, 2, 3, 13, 14, "#3a3a3a")
            for y in range(4, 14, 2):
                rect(g, 3, y, 12, y, "#5a5a5a" if (y // 2 + frame) % 2 else
                     "#4a4a4a")
            rect(g, 2, 1, 13, 2, "#c0c0c8")
        elif name == "bar":
            rect(g, 0, 2, 15, 13, "#2a1a24")
            rect(g, 0, 2, 15, 4, "#c0a040")
            for x in (3, 7, 11):
                rect(g, x, 6, x + 1, 10, rng.choice(("#40c0e0", "#e04040",
                                                     "#f0d040")))
        elif name == "fridge":
            rect(g, 2, 0, 13, 15, "#e8ecf0")
            rect(g, 2, 6, 13, 6, "#a8acb0")
            rect(g, 11, 2, 11, 4, "#5a5a5a")
            rect(g, 11, 8, 11, 11, "#5a5a5a")
        elif name == "piano":
            rect(g, 0, 1, 15, 14, "#1a1a1a")
            rect(g, 1, 9, 14, 13, "#f4f4f4")
            for x in range(2, 14, 2):
                rect(g, x, 9, x, 11, "#1a1a1a")
        elif name == "box":
            rect(g, 1, 2, 14, 14, "#d8dce4")
            rect(g, 1, 2, 14, 3, "#9aa0ac")
            disc(g, 7.5, 8, 3, "#f0d040")
            disc(g, 7.5, 8, 1.2, "#e08a20")
        return g
    # ── below and above ──
    if name.startswith("dwall_"):
        k = name[6:]
        if k == "yard":
            g = grid_of("#5a5048")
            for _ in range(6):
                disc(g, rng.randrange(16), rng.randrange(16), 2,
                     rng.choice(("#7a5a3a", "#6a6a70", "#8a3a2a")))
            return g
        if k == "shop":
            return bricks(rng, "#5a5450", "#2a2624")
        if k == "office":
            g = grid_of("#d8dce4")
            rect(g, 0, 13, 15, 15, "#8a90a0")
            return g
        if k == "servers":
            g = grid_of("#2a2e3a")
            for y in range(2, 16, 4):
                rect(g, 1, y, 14, y, "#3a5a8a")
            return g
        if k == "core":
            g = grid_of("#1a1e2a")
            for y in range(2, 16, 4):
                rect(g, 1, y, 14, y, "#e0b030")
            return g
    if name.startswith("dfloor_"):
        k = name[7:]
        if k == "yard":
            g = grid_of("#8a7a6a")
            speckle(g, rng, ["#7a6a5a", "#9a8a7a", "#6a5a4a"], 0.6)
            return g
        if k == "shop":
            return concrete(rng, "#6a6a64")
        if k == "office":
            g = grid_of("#a8b0c0")
            speckle(g, rng, ["#98a0b0"], 0.3)
            return g
        if k == "servers":
            g = grid_of("#3a3e4a")
            for y in range(0, 16, 4):
                for x in range(0, 16, 4):
                    g[y][x] = "#5a6a8a"
            return g
        if k == "core":
            g = grid_of("#2a2e3a")
            for y in range(0, 16, 4):
                for x in range(0, 16, 4):
                    g[y][x] = "#e0b030"
            return g
    if name == "cable":
        g = draw_terrain("dfloor_servers")
        for x in range(16):
            g[7 + (x // 4) % 2][x] = "#e0a020"
        return g
    if name == "oil":
        g = draw_terrain("dfloor_shop")
        disc(g, 7.5, 8, 5, "#1a1a20")
        if frame:
            g[6][6] = "#5a3a7a"
        return g
    if name == "rubble":
        g = draw_terrain("dfloor_yard")
        for _ in range(5):
            disc(g, rng.randrange(16), rng.randrange(16), 1.5, "#5a4a3a")
        return g
    if name in ("stairs_down", "stairs_up"):
        g = grid_of("#2a2420")
        for i in range(5):
            c = shade("#8a8a94", 1 - i * 0.15) if name == "stairs_down" \
                else shade("#8a8a94", 0.45 + i * 0.15)
            rect(g, 1, 1 + i * 3, 14, 2 + i * 3, c)
        return g
    raise KeyError(name)


