            names.update({"she": "he" if m else "she",
                          "She": "He" if m else "She",
                          "her": "him" if m else "her",
                          "Her": "Him" if m else "Her",
                          "hers": "his" if m else "hers",
                          "herself": "himself" if m else "herself",
                          "gf": "boyfriend" if m else "girlfriend",
                          "girl": "guy" if m else "girl"})
            call = d.get("calls", "your name")
