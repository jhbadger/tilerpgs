    def pad_poll(self):
        while True:
            try:
                kind, number, value = self.pad.events.get_nowait()
            except queue.Empty:
                break
            name = PAD_BUTTONS.get(number) if kind & 1 else None
            if name in ("left", "right", "up", "down"):
                self.pad_hold({"left": (-1, 0), "right": (1, 0),
                               "up": (0, -1), "down": (0, 1)}[name]
                              if value else None)
            elif name and value:
                self.pad_button(name)
            elif kind & 2 and number in PAD_STICK + PAD_HAT:
                self.pad_axes[number] = value
                held = None
                for ax, ay in (PAD_HAT, PAD_STICK):
                    vx, vy = self.pad_axes.get(ax, 0), self.pad_axes.get(ay, 0)
                    if max(abs(vx), abs(vy)) > PAD_DEADZONE:
                        held = ((1 if vx > 0 else -1, 0) if abs(vx) >= abs(vy)
                                else (0, 1 if vy > 0 else -1))
                        break
                if held != self.pad_dir:
                    self.pad_hold(held)
        self.root.after(30, self.pad_poll)

    def pad_hold(self, d):
        self.pad_dir = d
        if d:
            self.pad_direction(d)
            self.root.after(350, self.pad_repeat, d)

    def pad_repeat(self, d):
        if self.pad_dir == d:
            self.pad_direction(d)
            self.root.after(160, self.pad_repeat, d)

    def pad_direction(self, d):
        self.walking = None
        if self.menu:
            self.menu_move(-1 if d in ((0, -1), (-1, 0)) else 1)
        elif self.busy or self.talk:
            pass
        elif self.overlay:
            self.close_overlay()
        elif self.aim:
            self.aimed(*d)
        else:
            self.move(*d)

    def pad_button(self, name):
        self.walking = None
        if self.busy:
            return
        if self.menu:
            if name == "a":
                self.menu_pick()
            elif name == "b":
                self.menu_cancel()
            return
        if self.talk:
            return
        if self.overlay:
            if name == "start":
                self.action_menu()
            else:
                self.close_overlay()
            return
        {"a": self.wait, "x": self.ability_menu, "y": self.luck_menu,
         "lb": self.use_menu, "rb": self.journal, "view": self.toggle_map,
         "start": self.action_menu}.get(name, lambda: None)()

    def aimed(self, dx, dy):
        self.aim = None

    def animate(self):
        """Flip every animated square to its other frame."""
        self.frame ^= 1
        if self.cells and not self.overlay:
            c = self.canvas
            for idx, (base, top) in enumerate(self.shown):
                nb, nt = self.framed(base), self.framed(top)
                if (nb, nt) == (base, top):
                    continue
                self.shown[idx] = (nb, nt)
                bid, tid = self.cells[idx]
                if nb != base:
                    c.itemconfig(bid, image=self.img[nb])
                if nt != top:
                    c.itemconfig(tid, image=self.img[nt])
        self.root.after(500, self.animate)

    def framed(self, name):
        if not name or name[0] == "~":
            return name
        root = name[:-2] if name.endswith("@1") else name
        return root + "@1" if self.frame and root in self.animated else root

    def music_tick(self):
        self.sound.tick()
        self.root.after(100, self.music_tick)


    # ── Images ──

    def load_images(self):
        """The tiles, darkened copies of the terrain for squares remembered
        but not seen, and an average colour of each for the map."""
        self.base, self.dark, self.avg = {}, {}, {}
        for name, px in all_tiles().items():
            img = tk.PhotoImage(width=16, height=16)
            if name.split("@")[0] in SPRITES:
                for y, row in enumerate(px):
                    x = 0
                    while x < 16:
                        c = row[x]
                        x1 = x
                        while x1 < 16 and row[x1] == c:
                            x1 += 1
                        if c:
                            img.put(c, to=(x, y, x1, y + 1))
                        x = x1
            else:
                img.put(" ".join("{" + " ".join(r) + "}" for r in px))
                dark = tk.PhotoImage(width=16, height=16)
                dark.put(" ".join("{" + " ".join(shade(c, 0.36) for c in r)
                                  + "}" for r in px))
                self.dark[name] = dark
                tot = [0, 0, 0]
                for r in px:
                    for c in r:
                        for i in range(3):
                            tot[i] += int(c[1 + 2 * i:3 + 2 * i], 16)
                self.avg[name] = "#%02x%02x%02x" % tuple(v // 256
                                                        for v in tot)
            self.base[name] = img
        self.scale_images()

    def scale_images(self):
        s = self.scale
        self.img = {n: i.zoom(s) for n, i in self.base.items()}
        self.animated = {n for n in self.img if n + "@1" in self.img}
        self.dimg = {n: i.zoom(s) for n, i in self.dark.items()}


    def paint_people(self):
        """The tiles made for each game: you, her, and the Daffodils who've
        gone missing."""
        looks = {}
        p = self.p
        sh, pal = PEOPLE["hero_" + p["sex"]]
        looks["you"] = (pal, PERSON_SHAPES[sh])
        if self.d:
            looks["her"] = daffodil_art(self.d)
        for i, s in enumerate(self.world["stolen"]):
            looks["stolen%d" % i] = daffodil_art(s)
        if self.st.get("old"):
            looks["oldie"] = daffodil_art(self.st["old"])
        for name, (pal, rows) in looks.items():
            px = art_pixels(pal, rows)
            for n, frame in ((name, px), (name + "@1",
                                          px[1:] + [[None] * 16])):
                img = tk.PhotoImage(width=16, height=16)
                for y, row in enumerate(frame):
                    for x, c in enumerate(row):
                        if c:
                            img.put(c, to=(x, y, x + 1, y + 1))
                self.base[n] = img
            SPRITES.add(name)
        self.scale_images()
        if self.cells:
            # every image was just replaced: the map needs drawing afresh
            self.layout()

