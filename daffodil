def pronouns(sex, key):
    m = sex == "M"
    return {"he": "he" if m else "she", "He": "He" if m else "She",
            "his": "his" if m else "her", "him": "him" if m else "her",
            "His": "His" if m else "Her",
            "himself": "himself" if m else "herself"}[key]


def fill(text, world, extra=None):
    """Text with the town's names in it, and hers."""
    p = world["people"]
    names = {r: v["short"] for r, v in p.items()}
    names.update({r + "_full": v["name"] for r, v in p.items()})
    names.update({r + "_first": v["first"] for r, v in p.items()})
    for r, v in p.items():
        for k in ("he", "He", "his", "him", "His"):
            names["%s_%s" % (r, k)] = pronouns(v["sex"], k)
        names[r + "_title"] = v["title"]
    names.update(world.get("dnames") or DEFAULT_DNAMES)
    if extra:
        names.update(extra)
    return text.format(**names)


