    def invite(self, mob):
        d = self.d
        if d["with"]:
            self.say("%s: I'm right here." % d["name"], "her")
            return
        if not d.get("wearing"):
            self.her_say("naked")
            return
        if d["charge"] <= 0:
            self.her_say("low")
            return
        d["with"] = True
        d["where"] = "with"
        mob.ally = True
        self.her_say("come")
        self.say("%s comes with you. (Talk to her and say STAY to send her "
                 "home.)" % d["name"], "good")
        self.end_talk()

    def place_companion(self):
        d = self.d
        a = self.area
        for m in list(a.mobs):
            if m.her and m.ally and not (d and d["with"]):
                m.ally = False
                if m.visitor:
                    a.mobs.remove(m)
        if not d or not d["with"]:
            return
        for m in a.mobs:
            if m.her:
                m.ally = d["state"] == "awake"
                return
        x, y = self.pos
        for dx, dy in DIRS:
            nx, ny = x + dx, y + dy
            if a.inside(nx, ny) and not a.mob_at(nx, ny) and \
                    a.grid[ny][nx] in (CITY_GROUND | INSIDE_FLOOR |
                                       DUNGEON_FLOOR) and \
                    (nx, ny) not in a.links:
                m = self.make_her(nx, ny)
                m.ally = d["state"] == "awake"
                m.visitor = True
                a.mobs.append(m)
                return

    def dismiss(self, quiet=False):
        d = self.d
        if not d or not d["with"]:
            return
        d["with"] = False
        d["where"] = "home"
        for m in list(self.area.mobs):
            if m.her:
                m.ally = False
                if m.visitor or self.area.site != "home":
                    self.area.mobs.remove(m)
        if self.area.site == "home":
            if not any(m.her for m in self.area.mobs):
                self.place_specials(self.area)
        else:
            self.cache.pop(("bld", "home"), None)
        if not quiet:
            self.say("%s heads home." % d["name"], "info")

    # ── Shops ──

    def offers(self, mob):
        """(label, price, what happens) for what someone will sell you."""
        p = self.p
        half = self.active_event("sale") and mob.shop == "megamart"

        def give(item):
            def f():
                self.give_item(item)
                self.say("You get %s." % ITEMS[item][0].split(":")[0],
                         "gold")
            return f

        def item(name):
            price = ITEMS[name][1]
            if half:
                price = max(1, price // 2)
            return (cap(ITEMS[name][0]), price, give(name))
        stock = {
            "megamart": ("sundress", "jeans", "workout gear", "flashlight",
                         "pepper spray", "first aid kit", "denim jacket",
                         "bat", "a book", "a puzzle", "chocolates",
                         "energy drink", "burrito", "trash can lid"),
            "boutique": ("lingerie", "little black dress", "silk robe",
                         "evening gown", "perfume", "a necklace",
                         "sunglasses", "roses", "leather jacket"),
            "cafe": ("coffee", "burrito", "music"),
            "repair": ("charge pack", "stun baton", "kevlar vest",
                       "tire iron", "knife"),
            "gym": ("energy drink",),
            "galleria": ("charge pack", "a necklace", "roses"),
        }.get(mob.shop, ())
        return [item(n) for n in stock
                if not (n in ARMOR or n in WEAPONS or n in SHIELD) or
                not p["items"].get(n)]

    def list_offers(self, mob):
        if self.closed(mob):
            self.npc_say(mob, "We're closed!")
            return
        offers = self.offers(mob)
        if not offers:
            self.npc_say(mob, "I've got nothing else you'd want.")
            return
        self.npc_say(mob, "Here's what we've got.")
        self.talk["mode"] = "buy"


    def closed(self, mob):
        return False

    def buy(self, mob, n):
        p = self.p
        offers = self.offers(mob)
        if not 1 <= n <= len(offers):
            self.npc_say(mob, "What's that?")
            return
        label, price, what = offers[n - 1]
        if price > p["coins"]:
            self.npc_say(mob, "That's $%d. You've got $%d." % (price,
                                                              p["coins"]))
            return
        p["coins"] -= price
        what()
        self.sound.play("gold")
        if mob.role == "martbot" and any(label.lower().startswith(c)
                                         for c in CLOTHES):
            if "aisle3" not in self.flags:
                self.flags.add("aisle3")
                self.npc_say(mob, "WOMEN'S CLOTHING. EXCELLENT CHOICE. "
                             "THE GENTLEMAN IN AISLE THREE WAS VERY "
                             "BRAVE. :)")
        self.render_chrome()

    # ── The Daffodil store ──

    def her_stats(self, des, mods):
        st = {s: 10 for s in STATS}
        for table, key in ((BUILDS, des["build"]), (FACES, des["face"]),
                           (MINDS, des["mind"])):
            for name, m, _ in table:
                if name == key:
                    for s, n in m.items():
                        st[s] += n
        bonus = {"Bodyguard": {"STR": 3, "DEX": 2},
                 "Personal Trainer": {"CON": 2}, "Tech Suite": {"INT": 2},
                 "Dance": {"DEX": 1}, "Mathematics": {"INT": 1}}
        for mod in mods:
            for s, n in bonus.get(mod, {}).items():
                st[s] += n
        return {s: max(3, min(18, v)) for s, v in st.items()}

    @staticmethod
    def design_price(mods):
        return BASE_PRICE + sum(MODULES[m][0] for m in mods)

    @staticmethod
    def random_design(rng):
        return {"frame": "F", "build": rng.choice(BUILDS)[0],
                "height": rng.choice(HEIGHTS), "skin": rng.randrange(6),
                "hair": rng.choice(sorted(HAIR)),
                "style": rng.choice(HAIRSTYLES),
                "eyes": rng.choice(sorted(EYE_COLORS)),
                "face": rng.choice(FACES)[0], "voice": rng.choice(VOICES),
                "temper": rng.choice(TEMPERS)[0],
                "mind": rng.choice(MINDS)[0],
                "spice": rng.choice(SPICES)[0]}

    def design_studio(self):
        """The Design Studio: every dial on the website, and a preview."""
        if self.d:
            self.say("The Design Studio screen: 'WELCOME BACK! Your "
                     "Daffodil is already in your life!' It plays a little "
                     "fanfare.", "info")
