    @staticmethod
    def roll_hero(rng=random):
        """Stats on 3d6, in order; after a 15 or better, the next is on
        2d6+2.  And your savings."""
        stats, prev = [], 0
        for _ in STATS:
            v = roll("2d6+2", rng) if prev >= 15 else roll("3d6", rng)
            stats.append(v)
            prev = v
        return {"stats": stats, "hp": rng.random(),
                "coins": 1500 + roll("3d6", rng) * 100}

    @staticmethod
    def make_hero(who):
        """You, from what the creation dialog chose."""
        r = who["rolled"]
        k = CLASSES[who["cls"]]
        stats = dict(zip(STATS, r["stats"]))
        if who.get("swap"):
            a, b = who["swap"]
            stats[a], stats[b] = stats[b], stats[a]
        first, _, last = who["name"].partition(" ")
        hp = 4 + k.die                  # a kind start: the hit die's best
        p = {"name": who["name"], "first": first, "last": last or first,
             "sex": who["sex"], "cls": who["cls"], "level": 1,
             "stats": stats, "base": dict(stats), "hp": hp, "maxhp": hp,
             "ap": 0, "items": {}, "usage": {}, "coins": r["coins"],
             "debt": 0, "luck": 1, "lucky": False, "used": {}, "out": 0,
             "held": 0, "temp": {}, "workouts": 0, "quests": [],
             "pep": 0, "firewall": 0, "ghost": 0, "torch": 0, "slots": [0, 0],
             "spells": [], "wins": 0, "dances": 0}
        start = {"Bruiser": ("bat", "denim jacket"),
                 "Hustler": ("knife", "denim jacket"),
                 "Medic": ("tire iron", "denim jacket", "first aid kit"),
                 "Geek": ("stun baton", "denim jacket")}[who["cls"]]
        for n in start:
            p["items"][n] = 1
            if n in USAGE:
                p["usage"][n] = USAGE[n]
        rng = random.Random("%s:%s" % (who["name"], who["cls"]))
        if who["cls"] == "Geek":
            book = [s for lv in APPS.values() for s, _, _ in lv]
            p["spells"] = sorted(rng.sample(book, min(len(book),
                                                      roll("1d4+2", rng))),
                                 key=book.index)
            if "torch" not in p["spells"]:
                p["spells"].insert(0, "torch")
        elif who["cls"] == "Medic":
            book = [s for lv in REMEDIES.values() for s, _, _ in lv]
            p["spells"] = sorted(rng.sample(book, roll("1d4", rng)),
                                 key=book.index)
            if "patch" not in p["spells"]:
                p["spells"].insert(0, "patch")
        Game.refill_slots(p)
        Game.wear_armor(p)
        return p

    @staticmethod
    def refill_slots(p):
        table = GEEK_SLOTS if p["cls"] == "Geek" else MEDIC_SLOTS \
            if p["cls"] == "Medic" else None
        p["slots"] = list(table[min(10, p["level"])]) if table else [0, 0]

    @staticmethod
    def wear_armor(p):
        """Your best armor (and a lid, if you've one): its Armor Points."""
        best = max([ARMOR[a] for a in ARMOR if p["items"].get(a)] or [0])
        lid = SHIELD["trash can lid"] if p["items"].get("trash can lid") \
            else 0
        p["maxap"] = best + lid + 2 * p["level"] * bool(p.get("firewall"))
        p["ap"] = min(p.get("ap", 0), p["maxap"]) if p.get("ap") else \
            p["maxap"]

