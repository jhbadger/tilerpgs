            "style": "Bob", "eyes": "Brown"}, "wearing": "jeans"}
        self.st["old"] = old
        self.paint_people()
        self.npc_say(mob, "Series 4. Old as dirt, but her core's clean. "
                     "Somebody loved her, once. She says her name's %s." %
                     old["name"])
        self.say("%s: Hello. I'm %s. Thank you. I was in that box a long "
                 "time. Is there somewhere I could be useful?" % (
                     old["name"], old["name"]), "talk")
        if self.d and self.her_nearby(4) and self.d["state"] == "awake":
            self.her_say("jealous")
        self.say(self.f("(Someone who needs help with the house... {sis}?)"),
                 "info")

    def old_to_sister(self, mob):
        old = self.st["old"]
        self.st["old_home"] = "sister"
        self.st["sister"] += 2
        self.npc_say(mob, "For ME? She needs a home? ...{me}. Oh, {me}. "
                     "Come here, sweetheart. What's your name? %s? That's "
                     "a lovely name." % old["name"])
        self.say("Your sister cries a little. Then she shows %s where the "
                 "good dishes are." % old["name"], "good")
        self.cache.pop(("bld", "sister"), None)
        self.quest_done("old", "%s has a home" % old["name"])

    def workout(self, mob):
        p = self.p
        d = self.d
        key = "workout:%d" % self.day_no()
        if key in self.flags:
            self.npc_say(mob, "Once a day. Muscles grow when you REST.")
            return
        if p["coins"] < 20:
            self.npc_say(mob, "Twenty bucks.")
            return
        p["coins"] -= 20
        self.flags.add(key)
        self.pass_time(60, quiet=True)
        trainer = d and "Personal Trainer" in d["mods"] and self.her_here()
        self.npc_say(mob, "Again. AGAIN. Did I say stop? I did not say "
                     "stop.")
        if trainer:
            self.say("%s counts your reps in a voice you can't argue with. "
                     "'Twenty more, {you}.'".replace(
                         "{you}", self.f("{you}")) % d["name"], "her")
        if self.test("CON", adv=trainer, label="the workout"):
            p["workouts"] += 1
            self.say("You survive. You feel... good? (Workouts: %d of 3)" %
                     p["workouts"] if p["workouts"] <= 3 else
                     "You keep in shape. You almost enjoy it.", "good")
            if p["workouts"] >= 3 and "fit" not in p["quests"]:
                s = "STR" if p["stats"]["STR"] <= p["stats"]["CON"] else \
                    "CON"
                p["stats"][s] = min(18, p["stats"][s] + 1)
                self.say("Your jeans are loose. Your %s goes up by one." % s,
                         "quest")
                self.quest_done("fit", "fit for duty")
                if d:
                    self.affection(1, "is proud of you")
        else:
            self.say("You collapse on the mat and lie there making a "
                     "noise like a deflating air mattress.", "bad")
            self.lose_hp(1)
        if d and self.her_here():
            self.learns(3)

    def give_evidence(self, mob):
        ev = self.st["evidence"]
        if not ev:
            self.npc_say(mob, "Nothing yet? Come back with something I can "
                         "take to a judge.")
            return
        if self.st["warrant"]:
            self.npc_say(mob, "We've got him. Thanks to you.")
            return
        self.npc_say(mob, "Let's see. %s." % "; ".join(
            EVIDENCE[e].split(":")[0] for e in ev))
        if len(ev) < 2:
            self.npc_say(mob, "It's something. It's not enough. Two pieces "
                         "and I'll get a warrant.")
            return
        self.st["warrant"] = True
        self.flags.add("vane_arrested")
        self.npc_say(mob, "That's enough. More than enough. I'm getting a "
                     "warrant for Preston Vane, tonight.")
        self.say("By morning it's on every screen in Bellwether: GEARHART "
                 "VP ARRESTED IN DAFFODIL THEFT RING.", "quest")
        if "log" in ev and not self.st["pulled"]:
            self.st["pulled"] = True
            self.say("And with the Dataplex log in evidence, Daffodil's "
                     "engineers find the CORE_RESET flag in Update 7.2 and "
                     "pull it. Nobody's getting wiped.", "quest")
        self.cache = {k: v for k, v in self.cache.items()
                      if k != ("bld", "gearhart")}
        self.quest_done("vane", "Preston Vane is in handcuffs")

    def vane_brags(self, mob):
        if "evidence:tape" in self.flags:
            self.npc_say(mob, "Get lost. I'm winning.")
            return
        d = self.d
