                     "pearlescent, not a single mole. Real-looking. You "
                     "brush away more. Hair, wrapped in plastic. You tip "
                     "the box over.", "info")
            self.open_menu("What's in the box?", [
                ("Look", lambda: self.unbox_step(2))])
            return
        if n == 2:
            self.say(self.f("{She} rolls out onto the carpet, curled up "
                            "tight, knees to chin, like something sleeping. "
                            "No manual. Just a card: QUICK SETUP. Two "
                            "pictures, no words. The back of a neck, with "
                            "three little holes and a button. A finger "
                            "pressing the button. 1, 2, 3."), "info")
            self.open_menu("The button on the back of %s neck" % (
                "his" if d["design"]["frame"] == "M" else "her"), [
                ("Press it and count: one, two, three",
                 lambda: self.unbox_step(3))])
            return
        self.say("One. Two. Three. You let go.", "you")
        self.say(self.f("For a moment, nothing. Then {she} uncurls, rolls "
                        "over, pushes up, and stands, in one smooth motion. "
                        "{She} comes to attention, naked as the day {she} "
                        "was made, which was Tuesday."), "info")
        self.say("Your Daffodil: Please wait.", "her")
        self.say(self.f("Your Daffodil: You are {me_full}? I am Daffodil "
                        "serial number %s. My software is up to date." %
                        self.world["serial"]), "her")
        self.say(self.f("Your Daffodil: The primary setup procedure requires "
                        "approximately six hours. During this period I will "
                        "be unavailable for other activities. It is "
                        "recommended that during this period you make a few "
                        "basic decisions."), "her")
        d["state"] = "setup"
        self.paint_people()
        for m in self.area.mobs:
