def selftest():
    """Build every map and tune of a few weeks, without a window."""
    for seed in range(40):
        w = generate_world(seed)
        flags = set()
        city = make_city(w, flags)
        doors = [p for p, l in city.links.items() if l[0] == "bld"]
        assert len(doors) == len(SITES), doors
        seen, q = {city.start}, deque([city.start])
        while q:
            x, y = q.popleft()
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if city.inside(*n) and n not in seen and \
                        city.grid[n[1]][n[0]] in WALKABLE:
                    seen.add(n)
                    if city.grid[n[1]][n[0]] in CITY_GROUND:
                        q.append(n)
        for pos, l in city.links.items():
            assert pos in seen, ("unreachable", l, pos)
        for sid in SITES:
            a = make_interior(w, sid, flags)
            assert all(len(r) == a.w for r in a.grid), sid
            assert a.grid[a.start[1]][a.start[0]] in INSIDE_FLOOR, sid
            for role, (x, y) in a.spots.items():
                assert a.grid[y][x] in INSIDE_FLOOR, (sid, role)
                assert role in ROLES, role
            seen, q = {a.start}, deque([a.start])
            while q:
                x, y = q.popleft()
                for dx, dy in DIRS:
                    n = (x + dx, y + dy)
                    if a.inside(*n) and n not in seen and \
                            a.grid[n[1]][n[0]] in INSIDE_FLOOR:
                        seen.add(n)
                        q.append(n)
            for pos in list(a.spots.values()) + a.specials:
                assert pos in seen, (sid, "unreachable", pos)
            for pos in a.links:
                assert any((pos[0] + dx, pos[1] + dy) in seen
                           for dx, dy in DIRS), (sid, "link", pos)
        for role in ROLES:
            talk, greet = role_talk(w, role)
            fill(greet, w)
            for v in talk.values():
                for s in ([v] if isinstance(v, str) else
                          [x for x in v.values() if isinstance(x, str)]):
                    fill(s, w)
        for lid, info in LEADS.items():
            for level in range(1, info.levels + 1):
                a = make_dungeon(w, lid, level, flags)
                assert a.grid[a.start[1]][a.start[0]] == "stairs_up"
                seen, q = {a.start}, deque([a.start])
                while q:
                    x, y = q.popleft()
                    for dx, dy in DIRS:
                        n = (x + dx, y + dy)
                        if n not in seen and a.grid[n[1]][n[0]] in \
                                DUNGEON_FLOOR:
                            seen.add(n)
                            q.append(n)
                if a.down:
                    assert a.down in seen, (lid, level)
                for pos in list(a.terminals) + list(a.items) + [
                        (m.x, m.y) for m in a.mobs] + [
                        (x, y) for _, x, y in getattr(a, "pods", [])]:
                    assert pos in seen or any(
                        (pos[0] + dx, pos[1] + dy) in seen
                        for dx, dy in DIRS), (lid, level, pos)
                assert len(a.free_spots) >= 2, (lid, level)
                if (lid, level) == ("chopshop", 2):
                    assert len(a.pods) == len(w["stolen"]), a.pods
                    assert any(m.kind == "rusty" for m in a.mobs)
                if (lid, level) == ("dataplex", 1):
                    assert "badge" in a.items.values(), "red badge"
                if (lid, level) == ("dataplex", 2):
                    assert "safe" in a.terminals.values(), "safe"
                if (lid, level) == ("dataplex", 3):
                    assert "core" in a.terminals.values()
                    assert any(m.kind == "paragon" for m in a.mobs)
            for e, place in w["evidence"].items():
                a = make_dungeon(w, *place, flags)
                assert ("evidence:" + e) in a.terminals.values(), e
        for text in list(TOPICS.values()) + \
                [e["ask"] for e in w["errands"]] + \
                [e["thanks"] for e in w["errands"]] + \
                list(CLUES.values()) + [t for _, t in EVENTS.values()] + \
                [x for d in DLINES.values() for x in d.values()]:
            fill(text, w)
        for e in w["errands"]:
            assert e["giver"] in ROLES and e["thing"] in ITEMS, e
        for s in w["stolen"]:
            art_pixels(*daffodil_art(s))
    for n in range(60):
        rng = random.Random(n)
        r = Game.roll_hero(rng)
        for cls in CLASSES:
            p = Game.make_hero({"name": "Test Person", "sex": "MF"[n % 2],
                                "cls": cls, "rolled": r,
                                "swap": ("STR", "CHA") if n % 3 else None})
            for i in p["items"]:
                assert i in ITEMS, i
            for s in p["spells"]:
                assert s in SPELL_NAMES, s
        des = Game.random_design(rng)
        des["frame"] = "MF"[n % 2]
        for c in (None,) + CLOTHES:
            art_pixels(*daffodil_art({"design": des, "wearing": c}))
    for k in DLINES:
        assert "0" in DLINES[k], k
    for name, tune in MUSIC.items():
        steps = len(tune["melody"].replace("|", " ").split())
        assert steps == len(tune["chords"].split()) * tune["bar"], name
    tiles = all_tiles()
    clash = set(TERRAIN) & (set(PEOPLE) | set(ART))
    assert not clash, clash
    for name in list(TILE_NEEDED):
        assert name in tiles, name
    for t in (WALKABLE | set(OPAQUE["city"])) - {"dfloor"}:
        assert t in tiles, t
    for t in ROOM_TILES.values():
        assert t in tiles, t
    for g in GIFTS + CLOTHES:
        assert g in ITEMS, g
    for v in LIKES_OF.values():
        for g in (v if isinstance(v, tuple) else (v,)):
            assert g in GIFTS, g
    print("ok")


