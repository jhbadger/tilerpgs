                           else "likes it")
        d["wearing"] = c
        self.say("%s goes off to change, and comes back in the %s, and "
                 "twirls." % (d["name"], c), "her")
        if c == "lingerie":
            self.say("You forget what you were going to say. You forget "
                     "several things.", "info")
