def lm_chrysler(p):
    steel, body, win = "#dfe4e8", "#c8c4b8", "#3a4050"
    p.rect(8, 44, 39, 111, body)
    for x in range(10, 38, 3):
        p.rect(x, 46, x, 111, "#a09c90")
    for y in range(48, 111, 5):
        p.rect(10, y, 37, y, win)
    for k in range(5):
        r = 15 - 3 * k
        cy = 44 - 6 * k
        p.ellipse(23.5, cy, r, r * 0.9, steel, top=True)
        for a in range(5):
            ang = math.pi * (a + 0.5) / 5
            p.poly([(23.5 - r * 0.8 * math.cos(ang), cy - r * 0.7 *
                     math.sin(ang) + 1),
                    (23.5 - r * 0.6 * math.cos(ang) + 1, cy - r * 0.7 *
                     math.sin(ang) + 1),
                    (23.5 - r * 0.7 * math.cos(ang), cy - r * 0.85 *
                     math.sin(ang))], "#3a4050")
    p.rect(23, 0, 24, 18, steel)


