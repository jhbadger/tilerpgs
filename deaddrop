        elif t in ("crate", "safe"):
            self.open_loot(x, y)
        elif t == "gate":
            self.gate(x, y)
        elif t == "console":
            self.console(x, y)
        elif t == "case" and kind == "hq":
            self.say("A glass case of the Workshop's failures: an exploding "
                     "bowler hat, a parachute umbrella, a very small "
                     "submarine.", "info")
        elif t == "case":
            self.say("A rack of rifles, chained.", "info")
        elif t in ("cardtable", "roulette"):
            self.say("The tables: talk to the croupier to play.", "info")
        elif t == "telex":
            self.say("The teleprinter chatters: London, to every station: "
                     "HESPERUS. ALL PRIORITY.", "info")
        elif t == "rack":
            self.say("Racks of suits and dresses.", "info")
        elif t in ("phonebox",):
            self.say("A red telephone box. You could call London, but "
                     "London would only say: hurry.", "info")
        elif t in ("bus", "taxi", "scooter"):
            self.say({"bus": "A red double-decker, ticking over.",
                      "taxi": "A yellow cab. The driver is reading the "
                              "racing results.",
                      "scooter": "A scooter, its key still in it. "
                                 "Tempting."}[t], "info")
        elif t in ("kiosk", "cafe", "stall"):
            self.say({"kiosk": "A newspaper kiosk, plastered with posters.",
                      "cafe": "Café tables. Everyone is watching everyone "
                              "else.",
                      "stall": "A market stall. The man wants to sell you "
                               "something."}[t], "info")
        elif t in ("berlinwall", "sand_w", "watchtower"):
            self.say("The Wall, the death strip, the towers. Crossing "
                     "here would end in a burst of fire. Use Checkpoint "
                     "Charlie.", "bad")
        elif t == "kremlin_w":
            self.say("The red walls of the Kremlin. You aren't invited.",
                     "info")
        elif t == "palace_w":
            self.say("The walls of the Imperial Palace, behind its moat.",
                     "info")
        elif t in ("neon", "neon2", "billboard"):
            self.say("Neon, buzzing.", "info")
        elif t in ("statue", "monument", "obelisk", "fountain"):
            self.say({"statue": "A statue of someone important, and a "
                                "pigeon.",
                      "monument": "A monument to the workers.",
                      "obelisk": "An Egyptian obelisk, older than the city "
                                 "around it.",
                      "fountain": "A fountain, full of coins."}[t], "info")
        elif t == "water":
            self.say("The water is cold and deep.", "info")
            self.sound.play("bump")
        elif t.startswith("b_"):
            self.say("Private property.", "info")
            self.sound.play("bump")
        else:
            self.bump()

    def open_loot(self, x, y, forced=False):
        a = self.area
        if (x, y) not in a.loot:
            self.bump()
            return
        t = a.grid[y][x]
        if t == "safe" and not forced:
            q = self.check("Lockpicking", 4)
            self.turn += 3
            if not q:
                self.say("The dial won't give up its secret.", "info")
                self.end_turn()
                return
        a.loot.discard((x, y))
        a.grid[y][x] = "rubble"
        self.flags.add("loot:%s:%d:%d:%d" % (a.key[1], a.key[2], x, y))
        self.say("You open the %s." % ("safe" if t == "safe" else "crate"),
                 "info")
        r = random.random()
        if r < 0.3:
            self.step_reward("papers")
        elif r < 0.75:
            self.step_reward(random.choice(("cash", "ammo", "kit")))
        else:
            self.say("Machine parts, and nothing you can use.", "info")
        self.end_turn()

    def step_reward(self, thing):
        a = self.area
        a.items[tuple(self.pos)] = thing
        self.step_on(*self.pos)


    def gate(self, x, y):
        opts = [("Pick the lock (Lockpicking x EF 4: %d%%)" % min(
            99, success_chance(self.pc("Lockpicking"),
                               self.ease("Lockpicking", 4))),
            lambda: self.try_gate(x, y, "pick")),
            ("Force it (Strength x EF 2: %d%%)" % min(
                99, success_chance(self.pc("STR"), self.ease("STR", 2))),
             lambda: self.try_gate(x, y, "force"))]
        if self.has_gadget("Limpet Mine"):
            opts.append(("Blow it with a Limpet Mine (G)",
                         lambda: self.use_gadget("Limpet Mine")))
        opts.append(("Leave it", lambda: None))
        self.open_menu("A steel gate, locked. Beyond it, the heart of the "
                       "place.", opts)

    def try_gate(self, x, y, how):
        a = self.area
        if how == "pick":
            ok = self.check("Lockpicking", 4, hero=True)
        else:
            ok = self.char_check("STR", 2)
            if not ok:
                for m in a.mobs:
                    if m.hostile and abs(m.x - x) + abs(m.y - y) <= 12:
                        m.aware = True
                self.say("The clang echoes.", "bad")
        if ok:
            a.grid[y][x] = "dfloor"
            self.say("The gate swings open.", "good")
            self.sound.play("door")
        else:
            self.say("It holds.", "info")
        self.end_turn()

    # ── The fronts: the ways in ──

    def at_lead(self, lid, x, y):
        t = CITY_TEXT[lid]
        if "known:" + lid not in self.flags:
            self.say(t["closed"], "info")
            return
        if lid in self.returned or lid in self.strips:
            self.say("You have what was down there.", "info")
            self.open_menu("Go down anyway?", [
                ("Yes", lambda: self.descend(lid)), ("No", lambda: None)])
            return
        if "open:" + lid in self.flags:
            self.descend(lid)
            return
        if self.p["items"].get(t["key"]):
            self.say("You use %s." % t["key"], "good")
            self.flags.add("open:" + lid)
            self.descend(lid)
            return
        bonus = (2 if "code:" + lid in self.flags else 0) + \
            (1 if "bonus:" + lid in self.flags else 0)

        def chance(skill, ef):
            return min(99, success_chance(self.pc(skill),
                                          self.ease(skill, ef + bonus)))
        opts = [("Pick the lock (Lockpicking: %d%%)" % chance("Lockpicking",
                                                             4),
                 lambda: self.try_lead(lid, "Lockpicking", 4 + bonus)),
                ("Talk your way in (Charisma: %d%%)" % chance("Charisma", 3),
                 lambda: self.try_lead(lid, "Charisma", 3 + bonus))]
        if self.p["disguised"] == self.clock()[0]:
            opts.append(("Walk in as someone else (Disguise: %d%%)" %
                         chance("Disguise", 6),
                         lambda: self.try_lead(lid, "Disguise", 6 + bonus)))
        if self.phase() == "night":
            opts.append(("Slip in in the dark (Stealth: %d%%)" %
                         chance("Stealth", 5),
                         lambda: self.try_lead(lid, "Stealth", 5 + bonus)))
        opts.append(("Leave it", lambda: None))
        self.open_menu(t["entry"], opts)

    def try_lead(self, lid, skill, ef):
        q = self.check(skill, ef, hero=True)
        self.turn += 10
        if q:
            self.flags.add("open:" + lid)
            self.say("You're in.", "good")
            self.descend(lid)
            return
        self.say("No luck, and ten minutes gone.", "info")
        if skill in ("Charisma", "Disguise"):
            self.flags.add("alert:" + lid)
            self.say("Someone has had a good look at your face. ORCUS will "
                     "be looking for you now.", "bad")
        self.end_turn()

    def checkpoint(self, x, y):
        """Checkpoint Charlie, between West Berlin and East."""
        east = self.pos[0] > x
        side = "West" if east else "East"
        opts = []
        if self.p["items"].get("forged papers"):
            opts.append(("Show your forged papers",
                         lambda: self.cross(x, y, "papers")))
        opts += [("Bluff it out in another name (Charisma, EF 3)",
                  lambda: self.cross(x, y, "Charisma")),
                 ("Go through in disguise (Disguise, EF 5)",
                  lambda: self.cross(x, y, "Disguise"))]
        opts.append(("Turn back", lambda: None))
        self.open_menu("Checkpoint Charlie: a hut, sandbags, and the "
                       "barrier into the %s. 'Papers.'" % side, opts)

    def cross(self, x, y, how):
        if how == "papers":
            q = self.check("Charisma", 8)
        elif how == "Disguise" and self.p["disguised"] != self.clock()[0]:
            q = self.check("Disguise", 3)
        else:
            q = self.check(how, 3 if how == "Charisma" else 5, hero=True)
        self.pass_time(20, quiet=True)
        if not q:
            self.say("'Nein.' The guard waves you back, and writes "
                     "something down.", "bad")
            self.flags.add("alert:berlin")
            self.render()
            return
        east = self.pos[0] < x
        self.pos = [x + 3, y] if east else [x - 2, y]
        self.say("The barrier lifts. You walk into %s Berlin." % (
            "East" if east else "West"), "good")
        self.sound.play("door")
        self.render()

    # ── Research ──

    def research_menu(self):
        a = self.area
        topics = sorted(t for t in self.topics if t in RESEARCH and
                        "research:" + t not in self.flags)
        if not topics:
            self.say("You don't know what you're looking for. Words in "
                     "CAPITALS that people mention can be looked up.",
                     "info")
            return
        ef = 6 if a.kind_of == "hq" else 4
        self.open_menu("Look up what? (Intelligence x EF %d: %d%%, about an "
                       "hour)" % (ef, min(99, success_chance(
                           self.pc("INT"), self.ease("INT", ef)))),
                       [(t.title(), lambda t=t: self.research(t, ef))
                        for t in topics] + [("Nothing", lambda: None)])

    def research(self, topic, ef):
        cid, text, effect = RESEARCH[topic]
        if not self.char_check("INT", ef):
            self.pass_time(30)
            self.say("Half an hour of carbon copies and nothing.", "info")
            self.render()
            return
        self.pass_time(60)
        self.tally("research")
        self.flags.add("research:" + topic)
        self.say("An hour later, you find it:", "info")
        self.say(fill(text, self.world, cid), "talk")
        self.hear(text)
        if cid and cid != "london" and cid not in self.world["cities"]:
            self.say("(An old file. ORCUS isn't working in %s this time.)" %
                     CITIES[cid]["name"], "info")
        elif effect and effect.endswith("_known"):
            self.learn(effect)
        elif effect:
            self.flags.add(effect)
            self.say("(Worth knowing when you meet them.)", "info")
        self.render()

    # ── Beds ──

    def bed_menu(self):
        a = self.area
        kind = getattr(a, "kind_of", "")
        cid = a.city
        if kind == "flat":
            self.open_menu("Your own bed.", [
                ("Sleep until morning", lambda: self.sleep(True)),
                ("Rest four hours", lambda: self.sleep(False)),
                ("Not now", lambda: None)])
        elif kind == "hotel" and "room:%s:%d" % (cid, self.clock()[0]) in \
                self.flags:
            self.open_menu("Your hotel room.", [
                ("Sleep until morning", lambda: self.sleep(True)),
                ("Rest four hours", lambda: self.sleep(False)),
                ("Not now", lambda: None)])
        elif kind == "hotel":
            self.say("These rooms are let. Ask the desk clerk for one.",
                     "info")
        elif kind in ("embassy", "hq"):
            self.say("A sickbay bed. Ask the doctor.", "info")
        else:
            self.say("Someone else's bed.", "info")

    def sleep(self, night, heal=1):
        p = self.p
        h = self.now().hour
        if night:
            hours = (24 + 7 - h) % 24 or 24
            if hours > 14:
                hours = 4
        else:
            hours = 4
        self.say("You sleep %d hour%s." % (hours, "" if hours == 1 else "s"),
                 "info")
        self.pass_time(hours * 60, quiet=True)
        if self.overlay:
            return
        p["held"] = 0
        if hours >= 6:
            if p["wounds"]:
                p["wounds"] = max(0, p["wounds"] - heal)
            self.say("You wake, %s. You are %s." % (
                self.date_text(), WOUND_SHORT[p["wounds"]]), "good")
            self.cable()
        else:
            self.say("You wake, %s." % self.date_text(), "good")
        self.daily_paper()
        self.render()

    def bed_spot(self, area):
        for y in range(area.h):
            for x in range(area.w):
                if area.grid[y][x] == "bed" and y + 1 < area.h and \
                        area.grid[y + 1][x] in INSIDE_FLOOR:
                    return x, y + 1
        return area.start

    def door_of(self, cid, sid):
        city = self.get_area(("city", cid))
        return door_step(city, ("bld", cid, sid)) or city.start

    # ── Clues ──

    def learn(self, cid):
        if cid in self.clues:
            return
        self.clues.append(cid)
        if cid.endswith("_known"):
            self.flags.add("known:" + cid[:-6])
        self.say("(Your journal has a new entry. J reads it.)", "quest")
        self.sound.play("gold")

    def hear(self, text):
        """Words in CAPITALS: things to ask about, and to look up."""
        words = re.findall(r"\b[A-Z][A-Z'\-]{2,}\b", text)
        self.heard = [re.sub(r"'S?$", "", w) for w in words
                      if w not in ("BYE", "STOP", "ALL", "PRIORITY")]
        for w in words:
            if w in RESEARCH:
                self.topics.add(w)

    # ── Talking ──

    def speaker(self, mob):
        return mob.name if mob.known or mob.role in (
            "admiral", "suspect", "fatale") else cap(mob.title)

    def npc_say(self, mob, text):
        text = fill(text, self.world, mob.city)
        self.say("%s: %s" % (self.speaker(mob), text), "talk")
        self.hear(text)

    def start_talk(self, mob):
        self.talk = {"mob": mob, "mode": "kw"}
        self.heard = []
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Ask about:")
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        if mob.role == "admiral":
            self.admiral_greet(mob)
            if self.overlay:
                self.end_talk()
                return
            self.talk_menu()
            return
        if mob.role == "suspect":
            self.flags.add("met:" + mob.suspect)
            self.say("You meet %s, %s. You notice %s." % (
                mob.name, mob.title, SUSPECTS[mob.suspect].tell), "info")
        elif mob.known:
            self.say("You meet %s, %s." % (mob.name, mob.title), "info")
        else:
            self.say("You meet %s." % mob.title, "info")
        e = mob.errand
        greet = mob.greet
        if e is not None and self.side.get(e["id"], {}).get("state") == \
                "active":
            greet = "Oh, it's you. Did you manage it?"
        self.npc_say(mob, "We're closed. Come back in the morning." if
                     self.closed(mob) else greet)
        if mob.role == "chief" and self.strips:
            for cid in list(self.strips):
                self.hand_in(cid)
        for e in self.world["errands"]:
            if e.get("to") == mob.role and e["city"] == mob.city:
                self.deliver(mob, e)
        if "talked" not in self.flags:
            self.flags.add("talked")
            self.say("(Choose what to ask about, or type a word such as "
                     "NAME, JOB or NEWS and press Return. BYE, or an empty "
                     "line, ends the conversation.)", "info")
        self.talk_menu()

    def closed(self, mob):
        if mob.shop in CLOSES and self.phase() == "night":
            return True
        return mob.shop == "casino" and self.clock()[1] in range(4, 18)

    def talk_menu(self):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        if t["mode"] == "buy":
            items = [("%d) %s%s" % (i, label, ", £%d" % price if price
                                    else ""),
                      lambda i=i: self.choose_words(str(i)))
                     for i, (label, price, _) in
                     enumerate(self.offers(mob), 1)]
            items.append(("Nothing, thanks", lambda: self.choose_words("")))
            self.open_menu("Buy what? (you have £%d)" % self.p["cash"],
                           items, lambda: self.choose_words(""))
            return
        words = ["NAME", "JOB", "NEWS"]
        if mob.shop:
            words.append("BUY")
        if mob.errand is not None and self.side.get(
                mob.errand["id"], {}).get("state") != "done":
            words.append("HELP")
        if mob.role == "admiral":
            words += ["ORCUS", "HESPERUS", "CHAIRMAN", "STRIPS"]
        elif mob.role == "chief":
            words += ["ORCUS", "FILES", "STRIPS"]
        elif mob.role == "fatale":
            words.append("DINNER")
        elif mob.role == "suspect":
            words += ["ORCUS", "GAME"]
        for w in getattr(self, "heard", []):
            if w not in words and w != "BYE":
                words.append(w)
        self.open_menu("Ask %s about:" % self.speaker(mob),
                       [(w, lambda w=w: self.choose_words(w))
                        for w in words + ["BYE"]],
                       lambda: self.choose_words("bye"))

    def choose_words(self, w):
        self.say("> " + (w or "nothing"), "you")
        self.converse(w.lower())
        self.talk_menu()

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if getattr(self, "p", None) and getattr(self, "area", None):
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if not self.talk:
            return
        self.menu = None
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())
        self.talk_menu()

    def converse(self, w):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        if t["mode"] == "buy":
            t["mode"] = "kw"
            if w.isdigit():
                self.buy(mob, int(w))
                return
            if not w:
                self.npc_say(mob, "Anything else?")
                return
        if not w or w.startswith("bye"):
            self.npc_say(mob, "Good luck." if mob.role in ("admiral",
                                                          "chief") else
                         random.choice(BYES))
            self.end_talk()
            return
        word = re.sub(r"'s?$", "", w.split()[0])
        if word.startswith("name"):
            mob.known = True
            self.npc_say(mob, "I'm %s." % mob.name if not mob.role else
                         "%s, %s." % (mob.name, mob.title))
            return
        if word[:4] in ERRAND_WORDS and mob.errand is not None:
            self.errand(mob)
            return
        if mob.shop and word[:3] in ("buy", "pur", "sho", "ser", "dra",
                                     "tic", "pla", "roo"):
            self.list_offers(mob)
            return
        if mob.role == "suspect":
            if word[:4] in ("orcu", "chai"):
                self.suspect_orcus(mob)
                return
            if word[:4] in ("game", "play", "card", "bacc", "poke", "chem"):
                self.high_stakes(mob)
                return
        if mob.role == "fatale" and word[:4] in ("dinn", "danc", "drin",
                                                 "kiss", "date"):
            self.seduce(mob)
            return
        if mob.role in ("admiral", "chief") and word[:4] in ("stri", "film",
                                                            "micr"):
            if self.strips:
                for cid in list(self.strips):
                    self.hand_in(cid)
                return
            self.npc_say(mob, "London has %d of the four strips. %s" % (
                len(self.returned), "Get to the base!" if "final" in
                self.flags else "Bring me the rest."))
            return
        reply = next((v for k, v in mob.talk.items()
                      if k[:4] == word[:4] or (len(k) < 4 and
                                               word.startswith(k))), None)
        if reply is None and word[:4] == "heal":
            reply = random.choice(HEALTH)
        if reply is None and mob.shop and len(word) >= 4 and \
                not self.closed(mob) and any(
                    word[:4] in label.lower()
                    for label, _, _ in self.offers(mob)):
            self.list_offers(mob)
            return
        if reply is None and word.upper() in RESEARCH and mob.role in (
                "guest", "traveller", "patron", "local", "barkeep",
                "informer") and "lc:%s:%s" % (id(mob), word) not in \
                self.flags:
            self.flags.add("lc:%s:%s" % (id(mob), word))
            if self.check("Local Customs", 5):
                lines = [r for r in CITY_TEXT.get(mob.city, {}).get(
                    "rumours", []) if word.upper()[:4] in r]
                if lines:
                    reply = "You say the right thing in the right way. " \
                        "They lean closer: '%s'" % random.choice(lines)
        if reply is None:
            reply = next((v for k, v in TOPICS.items()
                          if word.startswith(k)), None)
        if reply is None and word.upper() in RESEARCH:
            reply = "Couldn't tell you. Try the files at your embassy."
        if reply is None:
            reply = random.choice(("I don't know anything about that.",
                                   "Can't help you there.",
                                   "Hm? I don't follow."))
        self.reply(mob, reply)
        self.render_chrome()

    def reply(self, mob, r):
        if isinstance(r, str):
            self.npc_say(mob, r)
            return
        if "skill" in r:
            flag = r.get("flag")
            if flag and flag in self.flags:
                self.npc_say(mob, "I've done all I'll do for you.")
                return
            q, used = self.best_check(r["skill"])
            if q:
                self.npc_say(mob, r["ok"])
                if flag:
                    self.flags.add(flag)
                if r.get("give"):
                    self.p["items"][r["give"]] = 1
                    self.say("You get %s." % r["give"], "gold")
            else:
                self.npc_say(mob, r["fail"])
            return
        self.npc_say(mob, r["say"])
        if r.get("learn"):
            self.learn(r["learn"])
        if r.get("topic"):
            self.topics.add(r["topic"])

    # ── Hearts, cards and questions ──

    def seduce(self, mob):
        cid = mob.city
        day = self.clock()[0]
        p = self.p
        if "ally:" + cid in self.flags:
            self.npc_say(mob, "I've told you everything. Be careful down "
                         "there. Come back to me.")
            return
        if "dinner:%s:%d" % (cid, day) in self.flags:
            self.npc_say(mob, "Not again tonight. Tomorrow, perhaps.")
            return
        if p["cash"] < 15:
            self.npc_say(mob, "Dinner? On what, darling?")
            return
        self.flags.add("dinner:%s:%d" % (cid, day))
        p["cash"] -= 15
        ef = 5 + (1 if p["items"].get("formal wear") else 0) + \
            (1 if p["fame"] >= 5 else 0) - (1 if "alert:" + cid in
                                            self.flags else 0)
        self.say("You ask %s to dinner. Candlelight, a band, a dance; and "
                 "later the lights of %s from a balcony." % (
                     mob.name, CITIES[cid]["name"]), "info")
        self.pass_time(120, quiet=True)
        q = self.check("Seduction", ef, hero=True)
        mob.known = True
        if q and q <= 2:
            self.flags.add("ally:" + cid)
            self.tally("seductions")
            self.npc_say(mob, "I don't work for them. Not any more. Not "
                         "after tonight.")
            self.npc_say(mob, CITY_TEXT[cid]["clue"].replace(
                "ORCUS's", "Their"))
            self.learn(cid + "_known")
            key = CITY_TEXT[cid]["key"]
            p["items"][key] = 1
            self.say("%s presses %s into your hand." % (mob.name, key),
                     "gold")
        elif q:
            self.tally("seductions")
            self.npc_say(mob, "You want to know about ORCUS. I know you do. "
                         "All right: " + CITY_TEXT[cid]["clue"].replace(
                             "ORCUS's", "their"))
            self.learn(cid + "_known")
        else:
            self.flags.add("alert:" + cid)
            self.say("Over the brandy, %s excuses %s to make a telephone "
                     "call, and doesn't come back." % (
                         mob.name, "herself" if
                         self.world["people"][cid]["fatale"]["sex"] == "F"
                         else "himself"), "bad")
            self.say("ORCUS knows you're here now.", "bad")
        self.render_chrome()

    def high_stakes(self, mob):
        sid = mob.suspect
        s = SUSPECTS[sid]
        day = self.clock()[0]
        p = self.p
        if "cards:%s:%d" % (sid, day) in self.flags:
            self.npc_say(mob, "Once a night is enough, darling.")
            return
        if p["cash"] < 100:
            self.npc_say(mob, "A hundred pounds a hand. Come back when you "
                         "can afford me.")
            return
        self.flags.add("cards:%s:%d" % (sid, day))
        self.say("You sit down to %s with %s. A crowd gathers." % (
            s.game, mob.name), "info")
        self.pass_time(60, quiet=True)
        q = self.check("Gambling", 5)
        them = self.npc_roll(13, 5)
        self.say("[%s: %s]" % (mob.name, QUALITY_NAMES[them]), "roll")
        if q and (not them or q < them):
            p["cash"] += 100
            p["fame"] += 1
            self.tally("winnings", 100)
            self.say("You win the hand, and a hundred pounds.", "gold")
            if sid == self.world["chairman"]:
                self.npc_say(mob, "You play as though you expect to live "
                             "for ever. How charming. How brief.")
                self.flags.add("rattled:" + sid)
            else:
                self.flags.add("cleared:" + sid)
                self.say("Losing, %s says too much, and you learn the "
                         "real secret: %s" % (mob.name, s.secret), "info")
        elif q and q == them:
            self.say("A draw. The money goes back and forth and ends where "
                     "it started.", "info")
        else:
            p["cash"] -= 100
            self.tally("winnings", -100)
            self.say("%s rakes in the pot." % mob.name, "bad")
        self.render_chrome()

    def suspect_orcus(self, mob):
        sid = mob.suspect
        s = SUSPECTS[sid]
        chairman = sid == self.world["chairman"]
        if chairman and ("photo" in self.clues or "liar:" + sid in
                         self.flags):
            self.confront(mob)
            return
        if "photo" in self.clues and not chairman:
            self.npc_say(mob, "ORCUS? Is that one of those dreadful pop "
                         "groups?")
            self.say("Whoever the Chairman is, it isn't %s: no %s." % (
                mob.name, SUSPECTS[self.world["chairman"]].tell), "info")
            self.flags.add("cleared:" + sid)
            return
        self.npc_say(mob, random.choice((
            "ORCUS? I don't believe I know them. Are they in shipping?",
            "Should I have heard of it? I hear of so many things.",
            "I'm afraid you have me at a disadvantage.")))
        if "psych:" + sid not in self.flags:
            self.flags.add("psych:" + sid)
            if self.check("Sixth Sense", 5):
                if chairman:
                    self.flags.add("liar:" + sid)
                    self.say("A flicker behind the eyes, gone at once. %s "
                             "is lying." % mob.name, "mad")
                    self.learn("suspect")
                else:
                    self.flags.add("honest:" + sid)
                    self.say("As far as your Sixth Sense can tell, %s is "
                             "telling the truth. (Noted in your file.)" %
                             mob.name, "info")

    def confront(self, mob):
        """Accuse the Chairman of ORCUS, to their face."""
        self.npc_say(mob, "So London has sent someone clever. What a "
                     "nuisance. Very well.")
        self.say("%s draws a gold-plated pistol from under the table, and "
                 "the club empties in a stampede." % mob.name, "bad")
        self.end_talk()
        mob.kind = "chairman"
        mob.hostile = True
        mob.aware = True
        mob.boss = True
        mob.chairman = True
        mob.survival = ENEMIES["chairman"].survival
        mob.title = "the Chairman of ORCUS"
        self.flags.add("unmasked")
        self.learn("unmasked")
        self.render()

    def interrogate(self, mob):
        if mob.questioned:
            self.say("%s has told you all they know." % cap(mob.title),
                     "info")
            return
        self.open_menu("%s. What do you do?" % cap(mob.title), [
            ("Question them hard (Interrogation, EF 5)",
             lambda: self.question(mob, "Interrogation")),
            ("Offer them a way out (Charisma, EF 4)",
             lambda: self.question(mob, "Charisma")),
            ("Leave them", lambda: None)])

    def question(self, mob, how):
        mob.questioned = True
        q = self.check(how, 5 if how == "Interrogation" else 4)
        self.turn += 5
        if not q:
            self.say("They stare at the wall and say nothing at all.",
                     "info")
            self.end_turn()
            return
        self.tally("interrogations")
        a = self.area
        cid = getattr(a, "lead", None) or a.city
        if cid == "lair":
            if "codes" not in self.clues:
                self.say("'The abort? Three stages, at the console. If "
                         "you're interrupted, you start again.'", "talk")
            else:
                self.say("'The Chairman watches from the control room. "
                         "Past the gate.'", "talk")
        elif cid in CITY_TEXT and cid in self.world["cities"] and \
                "known:" + cid not in self.flags:
            self.say("'All right! %s'" % CITY_TEXT[cid]["clue"].replace(
                "ORCUS's", "Our"), "talk")
            self.learn(cid + "_known")
        elif cid in self.world["cities"] and "code:" + cid not in \
                self.flags and cid not in self.strips and \
                cid not in self.returned:
            self.flags.add("code:" + cid)
            self.say("'The door code is 7-4-1-9. The guards change at the "
                     "hour.' (Getting in will be easier.)", "talk")
        elif q <= 2 and "photo" not in self.clues:
            self.say("'The Chairman? I saw the Chairman once, from the "
                     "back of a room. All I remember is %s.'" %
                     SUSPECTS[self.world["chairman"]].tell, "talk")
        else:
            self.say("'I don't know anything else! I just carry things!'",
                     "talk")
        self.end_turn()

    # ── Shops ──

    def offers(self, mob):
        """(label, price, what happens) for what someone sells."""
        p = self.p
        kind = mob.shop
        cid = mob.city
        day = self.clock()[0]
        o = []

        def give(item, n=1):
            def f():
                p["items"][item] = p["items"].get(item, 0) + n
                self.say("You buy %s." % (item if n == 1 else
                                          "%d %s" % (n, item)), "gold")
            return f
        if kind == "station":
            if "float:%s:%d" % (cid, day) not in self.flags and \
                    "met_admiral" in self.flags:
                o.append(("Draw £60 from the station's float", 0,
                          lambda: self.draw_float(cid)))
            if not p["items"].get("forged papers"):
                o.append(("Forged papers in another name", 20,
                          give("forged papers")))
        elif kind == "workshop":
            if p["gadgets"].get("Smoke Pellets", 0) < 3:
                o.append(("A fresh tin of Smoke Pellets", 0, lambda: (
                    p["gadgets"].__setitem__("Smoke Pellets", 3),
                    self.say("Tinker hands you a fresh tin. 'Three. Count "
                             "them.'", "gold"))))
            if not p["items"].get("lockpicks"):
                o.append(("A set of lockpicks", 0, give("lockpicks")))
            if not p["items"].get("disguise kit"):
                o.append(("A disguise kit", 0, give("disguise kit")))
            o.append(("A first aid kit", 0, give("first aid kit")))
        elif kind == "doctor":
            o += [("Treat a wound", 5, self.treat),
                  ("A night in the sickbay", 10, lambda: self.sleep(True,
                                                                    heal=2))]
        elif kind == "armoury":
            for w in SHOP_WEAPONS:
                if w not in p["weapons"]:
                    wp = WEAPONS[w]
                    o.append(("%s (%s)" % (w, wp.desc), wp.price,
                              lambda w=w: self.got_gun(w)))
            for ammo, (n, price) in AMMO.items():
                o.append(("%d %s" % (n, ammo), price, give(ammo, n)))
            o += [("A first aid kit", 3, give("first aid kit")),
                  ("A flask of brandy", 2, give("brandy"))]
        elif kind == "hotel":
            o.append(("A room for the night", 8, lambda: self.hotel_room(
                cid)))
            if "car:%s:%d" % (cid, day) not in self.flags:
                o.append(("A fast car for the day", 12, lambda: (
                    self.flags.add("car:%s:%d" % (cid, day)),
                    self.say("A low, fast car with a full tank is waiting "
                             "at the kerb. If anyone follows you today, "
                             "you'll be driving.", "gold"))))
        elif kind == "flights":
            here = self.city
            dests = ["london"] + self.world["cities"]
            for d in dests:
                if d == here:
                    continue
                mins, _ = flight(here, d)
                o.append(("To %s (%dh %02dm, on the Service's account)" % (
                    CITIES[d]["name"], mins // 60, mins % 60), 0,
                    lambda d=d: self.fly_to(d)))
            if "final" in self.flags:
                mins, price = flight(here, self.world["lair"])
                o.append(("A charter to %s (%dh %02dm)" % (
                    LAIRS[self.world["lair"]].region, mins // 60,
                    mins % 60), 0, lambda: self.fly_to("lair")))
        elif kind == "casino":
            for stake in (10, 50, 200):
                o.append(("A game of %s, £%d a hand" % (GAMES[cid], stake),
                          0, lambda s=stake: self.gamble(mob, s)))
            o.append(("A drink at the bar", 2, self.taste))
        elif kind == "bar":
            o.append(("A drink", 1, self.taste))
            o.append(("Something to eat", 2, self.meal))
        elif kind == "informer":
            o.append(("A word in your ear", 5 if mob.role != "stasi" else
                      10, lambda: self.tip(mob)))
        elif kind == "tailor":
            if not p["items"].get("formal wear"):
                o.append(("A dinner jacket" if p["sex"] == "M" else
                          "An evening gown", 30, give("formal wear")))
            o.append(("A disguise kit", 15, give("disguise kit")))
            o.append(("A suit, pressed while you wait", 3, lambda: self.say(
                "You look like a million dollars. Pounds.", "info")))
        return o

    def list_offers(self, mob):
        if self.closed(mob):
            self.npc_say(mob, "We're closed.")
            return
        offers = self.offers(mob)
        if not offers:
            self.npc_say(mob, "There's nothing more I can do for you.")
            return
        self.npc_say(mob, "Here's what I have.")
        self.talk["mode"] = "buy"

    def buy(self, mob, n):
        p = self.p
        offers = self.offers(mob)
        if not 1 <= n <= len(offers):
            self.npc_say(mob, "Pardon?")
            return
        label, price, what = offers[n - 1]
        if price > p["cash"]:
            self.npc_say(mob, "You haven't the money. Your Head of Station "
                         "can draw on the float.")
            return
        p["cash"] -= price
        what()
        if price:
            self.sound.play("gold")
        self.render_chrome()

    def draw_float(self, cid):
        self.flags.add("float:%s:%d" % (cid, self.clock()[0]))
        self.p["cash"] += 60
        self.say("Sixty pounds, in an envelope. Sign here.", "gold")

    def got_gun(self, w):
        p = self.p
        p["weapons"].append(w)
        wp = WEAPONS[w]
        if wp.fire:
            p["loaded"][w] = 0
            p["items"][wp.ammo] = p["items"].get(wp.ammo, 0) + \
                AMMO[wp.ammo][0]
        p["weapon"] = w
        self.say("You buy the %s%s, and ready it." % (
            w, " and a box of %s" % wp.ammo if wp.fire else ""), "gold")
        if wp.fire:
            self.reload(free=True)

    def taste(self):
        q = self.check("Connoisseur", 5)
        key = "taste:%s:%d" % (self.city, self.clock()[0])
        if q:
            self.flags.add(key)
            self.say(random.choice((
                "You send back the first bottle; the second is perfect, "
                "and the barman looks at you with new respect.",
                "You name the year of the brandy to within one. Heads "
                "turn.",
                "You order something nobody else has heard of, and it is "
                "exactly right.")) + " (Charm comes easier today.)", "good")
        else:
            self.say("A drink. It's a drink.", "info")
        self.pass_time(15, quiet=True)

    def meal(self):
        self.pass_time(30, quiet=True)
        self.p["held"] = 0
        self.say("You eat, and feel more yourself.", "good")

    def hotel_room(self, cid):
        self.flags.add("room:%s:%d" % (cid, self.clock()[0]))
        self.say("Your key. The rooms are upstairs: walk into a bed to "
                 "sleep.", "info")

    def treat(self):
        p = self.p
        key = "treat:%d" % self.clock()[0]
        if key in self.flags or p["wounds"] <= 0:
            self.say("The doctor looks you over. 'Rest is what you need.'",
                     "info")
            return
        self.flags.add(key)
        p["wounds"] -= 1
        p["held"] = 0
        self.pass_time(30, quiet=True)
        self.say("Stitches and iodine. You are %s." %
                 WOUND_SHORT[p["wounds"]], "good")

    def tip(self, mob):
        cid = mob.city
        if cid in self.world["cities"] and "known:" + cid not in self.flags:
            self.npc_say(mob, random.choice(CITY_TEXT[cid]["rumours"]))
            if mob.role == "stasi":
                self.learn("berlin_known")
            return
        others = [c for c in self.world["cities"]
                  if "known:" + c not in self.flags]
        if others:
            c = random.choice(others)
            self.npc_say(mob, "A friend in %s says: %s" % (
                CITIES[c]["name"], random.choice(CITY_TEXT[c]["rumours"])))
            return
        ch = SUSPECTS[self.world["chairman"]]
        self.npc_say(mob, "They say the big man at the top of it all, or "
                     "the big woman, plays cards with the rich, and never "
                     "takes off %s." % ch.tell)

    def gamble(self, mob, stake):
        p = self.p
        if p["cash"] < stake:
            self.npc_say(mob, "I'm afraid the table requires £%d." % stake)
            return
        self.pass_time(30, quiet=True)
        q = self.check("Gambling", 5)
        house = self.npc_roll(12, 5)
        self.say("[The house: %s]" % QUALITY_NAMES[house], "roll")
        if q and (not house or q < house):
            win = stake * (2 if q == 1 else 1)
            p["cash"] += win
            self.tally("winnings", win)
            if stake >= 200:
                p["fame"] += 1
            self.npc_say(mob, "The bank pays. £%d." % win)
            self.sound.play("gold")
        elif q and q == house:
            self.npc_say(mob, "Égalité. Your stake is returned.")
        else:
            p["cash"] -= stake
            self.tally("winnings", -stake)
            self.npc_say(mob, "The bank wins.")

    # ── Flights ──

    def fly_to(self, dest):
        frm = self.city
        p = self.p
        mins, _ = flight(frm, dest if dest != "lair" else self.world["lair"])
        self.tally("flights")
        self.reset_view()
        self.cache = {k: v for k, v in self.cache.items() if k[0] == "city"}
        if dest == "lair":
            self.lair_from = frm if frm in CITIES else "london"
        self.say("You fly from %s. %d hours in the air, give or take." % (
            self.place_name(), max(1, round(mins / 60.0))), "info")
        self.pass_time(mins, quiet=True)
        if self.overlay:
            return
        p["held"] = 0
        if dest == "lair":
            self.city = "lair"
            lair = LAIRS[self.world["lair"]]
            self.surface = (("bld", self.lair_from, "terminal"), [0, 0])
            area = self.get_area(("dun", "lair", 1))
            self.say("%s: %s. A seaplane, a rubber boat, a long climb in "
                     "the dark, and you are in." % (lair.name, lair.where),
                     "quest")
            self.enter(area, area.start, "stairs")
            return
        self.city = dest
        area = self.get_area(("bld", dest, "terminal"))
        self.city_pos[dest] = list(self.door_of(dest, "terminal"))
        self.enter(area, area.start)
        self.say("%s, %s." % (CITIES[dest]["name"], self.date_text()),
                 "quest")
        if dest != "london":
            self.say(CITY_TEXT[dest]["arrive"], "info")
        if "visited:" + dest not in self.flags:
            self.flags.add("visited:" + dest)
            self.say(CITIES[dest]["intro"], "info")
            if dest in self.world["cities"]:
                self.say("Our station here is at %s." %
                         CITIES[dest]["sites"]["embassy"][0], "info")
        self.daily_paper()

    # ── The Admiral, the stations and the strips ──

    def admiral_greet(self, mob):
        p = self.p
        w = self.world
        self.say("You meet Admiral Sir Rupert Gaunt, head of the Service: "
                 "a grey man in a grey suit, with very cold eyes.", "info")
        if "met_admiral" not in self.flags:
            self.flags.add("met_admiral")
            self.npc_say(mob, "Sit down, %s. Four days ago ORCUS killed a "
                         "NATO courier in Brussels and took the arming "
                         "package for HESPERUS, our new orbital rocket. "
                         "They mean to fire it at midnight on Sunday the "
                         "10th, and blind both sides at once." %
                         p["name"].split()[-1])
            self.npc_say(mob, "ORCUS keeps its plans on microfilm, cut in "
                         "strips, one to each cell chief. Our stations "
                         "report cells active in %s. Get me the STRIPS." %
                         ", ".join(CITIES[c]["name"] for c in w["cities"]))
            self.npc_say(mob, "Mrs. Bream's Registry is down the passage; "
                         "Tinker is waiting in the Workshop, and there's a "
                         "plane at the air terminal whenever you want one. "
                         "Here: expenses.")
            p["cash"] += 200
            self.say("The Admiral gives you £200 in assorted currencies.",
                     "gold")
            self.learn("mission")
            self.topics.update(("ORCUS", "HESPERUS", "CHAIRMAN"))
            return
        if self.strips:
            for cid in list(self.strips):
                self.hand_in(cid)
            return
        self.npc_say(mob, "Get to the base, and stop that launch." if
                     "final" in self.flags else
                     "London has %d of the four strips. Keep going." %
                     len(self.returned))

    def hand_in(self, cid, quiet=False):
        """A strip of microfilm goes home: London reads it, and the agent
        is wiser for it."""
        if cid in self.strips:
            self.strips.remove(cid)
        if cid in self.returned:
            return
        self.returned.append(cid)
        self.flags.add("back:" + cid)
        n = len(self.returned)
        p = self.p
        if not quiet:
            self.say("The %s strip goes into the diplomatic bag." %
                     CITIES[cid]["name"], "quest")
            self.sound.play("level")
        self.learn(STRIP_CLUES[n - 1])
        if n == 4:
            self.flags.add("final")
            self.say("All four strips. London has the base, and the abort "
                     "sequence. Charter a flight from any air terminal.",
                     "quest")
        if not quiet:
            self.improve()
        p["hero"] += 1
        self.say("A Hero Point for the strip (%d). Rank: %s." % (
            p["hero"], self.rank()), "gold")
        for g in DELIVERIES:
            if g not in p["gadgets"]:
                p["gadgets"][g] = GADGETS[g][0] if GADGETS[g][0] else -1
                self.say("The Workshop sends you, by return of bag: %s (%s)."
                         % (g, GADGETS[g][1]), "gold")
                break

    def improve(self):
        """Experience: each skill used well since the last strip grows."""
        p = self.p
        if not p["checks"]:
            return
        self.say("You think over what you have done, and learn from it:",
                 "quest")
        for s in p["checks"]:
            if p["levels"].get(s, 0) < MAX_LEVEL:
                p["levels"][s] = p["levels"].get(s, 0) + 1
                self.say("  %s rises to Skill Level %d (Primary Chance %d)."
                         % (s, p["levels"][s], self.pc(s)), "good")
        p["checks"] = []

    # ── Errands ──

    def give_errand(self, mob):
        for e in self.world["errands"]:
            if e["giver"] == mob.role and e["city"] == mob.city:
                mob.errand = e

    def errand(self, mob):
        e = mob.errand
        st = self.side.get(e["id"])
        who = self.world["people"][e["city"]][e["to"]]
        if st is None:
            self.side[e["id"]] = {"state": "active"}
            self.npc_say(mob, "Would you take %s to %s, %s? I can't go "
                         "myself. There's £%d in it." % (
                             e["thing"], who["name"], who["title"],
                             e["pay"]))
            self.say("You take %s." % e["thing"], "info")
        elif st["state"] == "done":
            self.npc_say(mob, "Thank you again!")
        else:
            self.npc_say(mob, "Have you taken %s to %s yet?" % (
                e["thing"], who["short"]))

    def deliver(self, mob, e):
        st = self.side.get(e["id"])
        if not st or st["state"] != "active":
            return
        st["state"] = "done"
        self.tally("errands")
        self.npc_say(mob, "%s? For me? How kind. Here, for your trouble." %
                     cap(e["thing"]))
        self.p["cash"] += e["pay"]
        self.say("You get £%d." % e["pay"], "gold")

    # ── Journal, dossier and mission file ──

    def journal(self):
        if self.busy or self.talk:
            return
        if self.overlay == "journal":
            self.close_overlay()
            return
        w = self.world
        lines = ["JOURNAL, %s" % self.date_text().upper(), ""]
        left = max(0, DEADLINE - self.turn)
        lines.append("%d days, %d hours to the launch: midnight on Sunday "
                     "the 10th." % (left // DAY, left % DAY // 60))
        lines.append("")
        if "met_admiral" not in self.flags:
            lines.append("The Admiral is waiting for you in his office, at "
                         "headquarters in London.")
        for cid in self.clues:
            if cid in CLUES:
                lines.append("* " + fill(CLUES[cid], w))
        lines.append("")
        lines.append("The strips:")
        for c in w["cities"]:
            name = CITIES[c]["name"]
            if c in self.returned:
                lines.append("  + %s: with London" % name)
            elif c in self.strips:
                lines.append("  * %s: you have it" % name)
            elif "known:" + c in self.flags:
                lines.append("  - %s: held below %s" % (name, front_name(c)))
            else:
                lines.append("  - %s: somewhere in the city" % name)
        todo = sorted(t.title() for t in self.topics
                      if "research:" + t not in self.flags)
        if todo:
            lines += ["", "To look up: " + ", ".join(todo)]
        errs = []
        for e in w["errands"]:
            if self.side.get(e["id"], {}).get("state") == "active":
                errs.append("Take %s to %s, in %s" % (
                    e["thing"], w["people"][e["city"]][e["to"]]["name"],
                    CITIES[e["city"]]["name"]))
        if errs:
            lines += ["", "Favours:"] + ["  " + s for s in errs]
        wrapped = []
        for ln in lines:
            wrapped += wrap(ln, 64) or [""]
        self.overlay = "journal"
        self.overlay_text = "\n".join(wrapped)
        self.render()

    def show_sheet(self):
        if self.busy or self.talk:
            return
        if self.overlay == "sheet":
            self.close_overlay()
            return
        self.overlay = "sheet"
        self.overlay_text = "\n".join(self.sheet_lines("Any key closes."))
        self.render()

    def sheet_lines(self, foot):
        p = self.p
        c = p["chars"]
        lines = ["%s, %s" % (p["name"], p["bg"]),
                 "%s of the Service.   Fame %d" % (self.rank(), p["fame"]),
                 "",
                 "  ".join("%s %2d" % (k, c[k]) for k in CHARS),
                 "Speed %d   Hand-to-Hand Damage Class %s   Hero Points %d"
                 % (self.speed(), self.hth_dc(), p["hero"]),
                 "Wounds: %s%s" % (
                     WOUND_SHORT[p["wounds"]],
                     " (Ease Factor -%d on everything)" %
                     self.wound_penalty() if p["wounds"] else ""), "",
                 "SKILL          LVL  PC   SKILL          LVL  PC"]
        names = sorted(SKILLS)
        half = (len(names) + 1) // 2
        for i in range(half):
            row = []
            for s in (names[i], names[i + half] if i + half < len(names)
                      else None):
                if s:
                    row.append("%-14s %2d %3d%s" % (
                        s, p["levels"].get(s, 0), self.pc(s),
                        "*" if s in p["checks"] else " "))
            lines.append("  ".join(row))
        lines += ["", "* used well: rises when a strip goes home.",
                  "A skill at level 0 is untrained: Ease Factor -3."]
        gads = ["%s%s" % (g, "" if u < 0 else " (%d)" % u)
                for g, u in sorted(p["gadgets"].items())]
        if gads:
            lines += [""] + wrap("Gadgets: " + ", ".join(gads), 56)
        lines += ["", foot]
        return lines

    def casebook(self):
        """The mission file: what's to do, your dossier, and the
        international set."""
        if self.busy or self.talk:
            return
        if self.overlay == "casebook":
            self.close_overlay()
            return
        self.menu = None
        self.pages = [self.cb_todo(), "\n".join(self.sheet_lines(
            "(Turn the page: any key, or a tap.)"))]
        if "mission" in self.clues:
            self.pages.append(self.cb_suspects())
        self.pages[-1] = self.pages[-1].replace(
            "(Turn the page: any key, or a tap.)",
            "(Any key, or a tap, closes the file.)")
        self.page = 0
        self.overlay = "casebook"
        self.overlay_text = self.pages[0]
        self.render()

    def todo(self):
        w, p, f = self.world, self.p, self.flags
        out = [("met_admiral" in f, "See the Admiral at headquarters in "
                "London")]
        for c in w["cities"]:
            name = CITIES[c]["name"]
            if c in self.returned:
                out.append((True, "The %s strip, with London" % name))
            elif c in self.strips:
                out.append((False, "Get the %s strip to a Head of Station "
                            "or the Admiral" % name))
            elif "known:" + c in f:
                out.append((False, "Take the %s strip from below %s" % (
                    name, front_name(c))))
            else:
                out.append((False, "Find the ORCUS cell in %s (see our "
                            "station; ask about the NEWS)" % name))
        todo = sorted(t.title() for t in self.topics
                      if "research:" + t not in f)
        if todo:
            out.append((False, "Look up %s (embassy files, or the Registry "
                        "in London)" % ", ".join(todo[:5])))
        if "photo" in self.clues or "suspect" in self.clues:
            out.append(("unmasked" in f or "chairman_dead" in f,
                        "Find the international figure who is the "
                        "Chairman of ORCUS, and ask them about ORCUS"))
        if p["wounds"] >= 2:
            out.append((False, "See a doctor or rest (%s)" %
                        WOUND_SHORT[p["wounds"]]))
        if "final" in f:
            out.append(("won" in f, "Fly to %s and abort the launch at the "
                        "console before midnight on Sunday" %
                        LAIRS[w["lair"]].name))
        for e in w["errands"]:
            if self.side.get(e["id"], {}).get("state") == "active":
                out.append((False, "Take %s to %s, in %s" % (
                    e["thing"], w["people"][e["city"]][e["to"]]["name"],
                    CITIES[e["city"]]["name"])))
        return out

    def cb_todo(self):
        left = max(0, DEADLINE - self.turn)
        lines = ["MISSION FILE: HESPERUS   %s" % self.date_text(), "-" * 50,
                 "TO DO   (%d days, %d hours to the launch)" % (
                     left // DAY, left % DAY // 60), ""]
        for done, text in self.todo():
            parts = wrap(text, 44)
            lines += [("[x] " if done else "[ ] ") + parts[0]] + [
                "    " + x for x in parts[1:]]
        lines += ["", "(Turn the page: any key, or a tap.)"]
        return "\n".join(lines)

    def cb_suspects(self):
        w, f = self.world, self.flags
        lines = ["MISSION FILE: THE INTERNATIONAL SET", "-" * 50]
        lines += wrap("Six of the very rich, in town this week. The "
                      "Registry thinks the Chairman of ORCUS is one of "
                      "them. Where they are, and what you know:", 50) + [""]
        where = {sid: c for c, sid in w["suspects"].items()}
        for sid in w["london_suspects"]:
            where[sid] = "london"
        for sid, s in sorted(SUSPECTS.items(), key=lambda kv: kv[1].name):
            chair = sid == w["chairman"]
            if chair and "chairman_dead" in f:
                note = "DEAD. The Chairman of ORCUS."
            elif chair and "unmasked" in f:
                note = "UNMASKED: the Chairman of ORCUS"
            elif "liar:" + sid in f:
                note = "LIED to you about ORCUS"
            elif "cleared:" + sid in f:
                note = "cleared"
            elif "honest:" + sid in f:
                note = "seemed honest about ORCUS"
            else:
                note = "not yet questioned"
            seen = ("; wears %s" % s.tell) if "met:" + sid in f else ""
            lines += wrap("%s, %s, at %s%s: %s" % (
                s.name, s.title, CITIES[where[sid]]["sites"]["club"][0],
                seen, note), 50)
        lines += ["", "(Turn the page: any key, or a tap.)"]
        return "\n".join(lines)

    # ── The morning paper, and cables ──

    def daily_paper(self):
        day, hour = self.clock()
        key = "paper:%d" % day
        if hour < 7 or key in self.flags or self.turn >= DEADLINE or \
                "won" in self.flags:
            return
        self.flags.add(key)
        w = self.world
        news = None
        for c in w["cities"]:
            if (c in self.returned or c in self.strips) and \
                    "reported:" + c not in self.flags:
                self.flags.add("reported:" + c)
                news = CITY_TEXT[c]["headline"]
                break
        if news is None and len(self.fallen) > int(
                self.tallies.get("fallen_told", 0)):
            self.tallies["fallen_told"] = len(self.fallen)
            gone = self.fallen[-1]
            news = ("BRITISH BUSINESSMAN DIES IN %s" %
                    gone["city"].upper(),
                    "%s, an import-export representative, was found dead. "
                    "Police suspect nothing." % gone["name"])
        if news is None:
            news = HEADLINES[min(day, len(HEADLINES)) - 1]
        head, text = news
        self.say("The Evening Courier, %s: %s" % (
            self.now().strftime("%A"), fill(head, w)), "quest")
        self.say(fill(text, w), "info")

    def cable(self):
        """A night's sleep, and a cable from London under the door."""
        w = self.world
        rng = random.Random("%s:cable:%d" % (w["seed"], self.clock()[0]))
        if rng.random() < 0.35:
            return
        unknown = [c for c in w["cities"] if "known:" + c not in self.flags]
        if self.city in unknown:
            c = self.city
        elif unknown:
            c = rng.choice(unknown)
        else:
            return
        text = CITY_TEXT[c]["cable"]
        self.say("A cable has been slipped under your door:", "info")
        self.say(text, "talk")
        self.hear(text)

    # ── The end, in pages ──

    def end_pages(self, won):
        w, p, f = self.world, self.p, self.flags
        lair = LAIRS[w["lair"]]
        ch = SUSPECTS[w["chairman"]]
        pages = []
        if won:
            pages.append(
                "THE LAUNCH IS ABORTED.\n\nIn the control room of %s the "
                "countdown\nfreezes, and HESPERUS stays on its pad.\nThe "
                "lights go red; the self-destruct\nwhoops; you run.\n\nAt "
                "dawn a Royal Navy frigate picks you\nout of the sea.\n\n"
                "%s, %s.\n\n(Return, or a tap: the morning paper.)" % (
                    lair.name, p["name"], p["bg"].lower()))
            if "chairman_dead" in f:
                fate = "%s, %s, is reported lost at sea." % (ch.name,
                                                             ch.title)
            else:
                fate = ("%s, %s, has cancelled all engagements and has "
                        "not been seen since Sunday night." % (ch.name,
                                                                ch.title))
            paper = ["THE EVENING COURIER", "Monday, October 11th, 1965",
                     "-" * 50, "MYSTERY BLAST IN %s" % lair.region.upper(),
                     ""]
            for text in (
                    "A great explosion was seen at midnight in %s. The "
                    "Admiralty says it was a 'naval exercise'; the Soviet "
                    "embassy says nothing." % lair.region,
                    fate,
                    "Both sides stood their bombers down at one in the "
                    "morning. Gold fell in Zurich."):
                paper += wrap(text, 50) + [""]
            paper.append("(Turn the page: the report.)")
            pages.append("\n".join(paper))
            t = self.tallies
            honours = []
            for key, need, text in HONOURS:
                n = t.get(key, 0)
                if n >= need:
                    honours.append((n / float(need), text % n))
            if not self.fallen:
                honours.append((2.0, "Lost No One"))
            if "unmasked" in f or "chairman_dead" in f:
                honours.append((1.5, "Unmasked the Chairman"))
            if self.turn < DEADLINE - DAY:
                honours.append((1.2, "With a Day to Spare"))
            honours.sort(key=lambda h: -h[0])
            rep = ["REPORT: OPERATION HESPERUS", "-" * 50,
                   "Agent: %s, %s. Rank: %s." % (p["name"], p["bg"],
                                                 self.rank()), ""]
            rep += ["  * " + h[1] for h in honours[:6]] or [
                "  * Saved the World, Quietly"]
            rep += ["", "Strips recovered: 4 of 4.  Cities: %s." % ", ".join(
                CITIES[c]["name"] for c in w["cities"]), "",
                    "(Turn the page.)"]
            pages.append("\n".join(rep))
        else:
            pages.append(
                "MIDNIGHT, SUNDAY THE 10TH.\n\nFrom %s a pillar of fire "
                "climbs\ninto the sky, and HESPERUS goes up.\n\nBy morning "
                "neither side can see the other.\nBy noon, both believe "
                "the other did it.\n\nWhat happens next is not a story "
                "anyone\nwill be left to tell.\n\nStrips that reached "
                "London: %d of 4.\n\n(Turn the page.)" % (
                    lair.name, len(self.returned)))
        if self.fallen:
            mem = ["IN MEMORIAM", "-" * 50, ""]
            for x in self.fallen:
                mem += wrap("%s, %s. Died in %s, %s." % (
                    x["name"], x["bg"].lower(), x["city"], x["date"]), 50)
            mem += [""] + wrap("They are not on any memorial. The Admiral "
                               "knows their names.", 50)
            mem += ["", "(Turn the page.)"]
            pages.append("\n".join(mem))
        if won:
            rng = random.Random("%s:after" % w["seed"])
            after = ["AFTERWARDS", "-" * 50, ""]
            for c in w["cities"]:
                if "ally:" + c in f:
                    fat = w["people"][c]["fatale"]
                    after += wrap("%s, %s, sends a postcard from %s. It "
                                  "says only: 'Come back.'" % (
                                      fat["name"], fat["title"],
                                      CITIES[c]["name"]), 50)
            after += wrap("Miss Ashby puts a file marked HESPERUS in the "
                          "Registry, and a single red rose on your desk. "
                          "She denies both.", 50)
            after += wrap("Tinker wants every gadget back. He gets the "
                          "Skeleton Key, and a lecture about the rest.", 50)
            after += [""] + wrap(rng.choice(EPILOGUE_HOOKS), 50)
            after += ["", "Press N for a new mission, or Escape to stay "
                      "a while."]
            pages.append("\n".join(after))
        else:
            pages[-1] = pages[-1].replace("(Turn the page.)",
                                          "Press N for a new mission.")
        return pages

    # ── The base: the console ──

    def console(self, x, y):
        a = self.area
        if not getattr(a, "consoles", None):
            self.say("Dials and switches.", "info")
            return
        if "won" in self.flags:
            self.say("The console is dark. HESPERUS is going nowhere.",
                     "info")
            return
        codes = "final" in self.flags
        ef = 6 if codes else 1
        opts = [("Begin the abort sequence (Electronics or Cryptography, EF "
                 "%d; three stages)" % ef, lambda: self.begin_abort(ef))]
        if self.has_gadget("Limpet Mine"):
            opts.append(("Blow the console with a Limpet Mine",
                         lambda: self.use_gadget("Limpet Mine")))
        opts.append(("Leave it", lambda: None))
        self.open_menu("The launch console. %s" % (
            "You have the abort sequence from the strips." if codes else
            "Without the codes, you'll be guessing."), opts)

    def begin_abort(self, ef):
        self.say("You start the abort sequence. Somewhere a klaxon begins "
                 "to sound.", "quest")
        self.abort = {"stage": 0, "hit": False, "ef": ef}
        self.busy = True
        self.walking = None
        self.root.after(400, self.abort_step)

    def abort_step(self):
        r = self.abort
        if r is None:
            self.busy = False
            return
        self.busy = False
        self.end_turn()
        if self.abort is None or self.overlay or self.p["wounds"] >= 4:
            self.busy = False
            self.abort = None
            return
        if r["hit"]:
            r["hit"] = False
            if not self.char_check("WIL", 5, label="Willpower, keeping at "
                                   "it"):
                self.say("Your hands leave the keys. The sequence resets. "
                         "(Try again.)", "bad")
                self.abort = None
                return
        q, used = self.best_check(("Electronics", "Cryptography"), r["ef"],
                                  hero=True)
        if q:
            r["stage"] += 1
            self.say(("Stage one: the fuel valves close.",
                      "Stage two: the guidance unit disarms.",
                      "Stage three: the countdown stops.")[r["stage"] - 1],
                     "quest")
            self.sound.play("spell")
        else:
            self.say("ERROR, says the console. You try again.", "bad")
        if r["stage"] < 3:
            self.busy = True
            self.root.after(500, self.abort_step)
            return
        self.abort = None
        self.win()

    def blow_console(self):
        self.say("The mine takes the console apart in a sheet of blue "
                 "flame. Every light in the base dies, and the countdown "
                 "with them.", "quest")
        self.win()

    def win(self):
        self.flags.add("won")
        a = self.area
        for m in a.mobs:
            if m.hostile and "human" in ENEMIES[m.kind].traits and \
                    not getattr(m, "chairman", False):
                m.flee = 99
        self.sound.play("quest")
        self.save()
        self.show_won()

    # ── A chase ──

    def start_chase(self):
        car = "car:%s:%d" % (self.city, self.clock()[0]) in self.flags
        self.chase = {"lead": 2, "round": 0, "car": car}
        self.say("A chase! %s" % ("You run for your car." if car else
                                  "You run for it."), "bad")
        self.chase_round()

    def chase_round(self):
        c = self.chase
        if c is None:
            return
        skill = "Driving" if c["car"] else "Evasion"
        opts = [("Flat out (%s, EF 3: gain more ground)" % skill,
                 lambda: self.chase_bid(3)),
                ("Fast (%s, EF 5)" % skill, lambda: self.chase_bid(5)),
                ("Careful (%s, EF 7: hold your lead)" % skill,
                 lambda: self.chase_bid(7))]
        if self.p["gadgets"].get("Smoke Pellets", 0) > 0:
            opts.append(("Smoke Pellets behind you",
                         lambda: self.chase_bid("smoke")))
        opts.append(("Stop and fight them here", lambda: self.chase_end(
            False)))
        self.open_menu("They are %d length%s behind you. %s" % (
            c["lead"], "" if c["lead"] == 1 else "s",
            "(In your car.)" if c["car"] else "(On foot.)"), opts)
        self.menu["locked"] = True
        self.menu["cancel"] = self.chase_round

    def chase_bid(self, ef):
        c = self.chase
        if c is None:
            return
        c["round"] += 1
        self.pass_time(2, quiet=True)
        lines = CITY_TEXT[self.city]["chase"]
        self.say(lines[(c["round"] - 1) % len(lines)], "info")
        if ef == "smoke":
            self.spend_gadget("Smoke Pellets")
            c["lead"] += 2
            self.say("A wall of smoke behind you; they plough into it "
                     "blind.", "good")
        else:
            q = self.check("Driving" if c["car"] else "Evasion", ef)
            them = self.npc_roll(11, 5)
            gain = (5 - q if q else 0) - (5 - them if them else 0)
            if ef == 3 and q:
                gain += 1
            if ef == 7:
                gain = max(0, min(gain, 1))
            c["lead"] += max(-2, min(3, gain))
            if not q and ef == 3:
                if not self.char_check("DEX", 5):
                    self.say("You clip a corner too fast!", "bad")
                    self.hurt(1, "The crash")
                    c["lead"] -= 1
                    if self.overlay or self.p["wounds"] >= 4:
                        self.chase = None
                        return
            self.say("They are %d length%s behind." % (
                max(0, c["lead"]), "" if c["lead"] == 1 else "s"), "info")
        if c["lead"] >= 5 or (c["round"] >= 6 and c["lead"] >= 3):
            self.chase_end(True)
        elif c["lead"] <= 0 or c["round"] >= 6:
            self.chase_end(False)
        else:
            self.chase_round()

    def chase_end(self, escaped):
        self.chase = None
        self.menu = None
        if escaped:
            self.tally("chases")
            self.p["fame"] += 1
            self.say("You lose them. For now.", "good")
            self.render()
            return
        self.say("They've caught you! Doors open; guns come out.", "bad")
        a = self.area
        x, y = self.pos
        spots = [(x + dx, y + dy) for dx in range(-2, 3)
                 for dy in range(-2, 3)
                 if a.inside(x + dx, y + dy) and
                 a.grid[y + dy][x + dx] in CITY_GROUND and
                 not a.mob_at(x + dx, y + dy) and (dx, dy) != (0, 0)]
        random.shuffle(spots)
        for kind in ("gunman", "gunman" if self.clock()[0] < 5 else
                     "assassin"):
            if spots:
                m = make_monster(kind, *spots.pop())
                m.aware = True
                a.mobs.append(m)
        self.render()

    # ── Menus ──

    def open_menu(self, title, items, cancel=None):
        self.menu = {"title": title, "items": items, "sel": 0,
                     "cancel": cancel}
        self.render()

    def menu_move(self, d):
        m = self.menu
        m["sel"] = (m["sel"] + d) % len(m["items"])
        self.render()

    def menu_pick(self, i=None):
        if i in ("up", "down"):
            m = self.menu
            page = m.get("page", 1)
            m["sel"] = max(0, min(len(m["items"]) - 2, m["sel"] + (
                page if i == "down" else -page)))
            self.render()
            return
        m, self.menu = self.menu, None
        self.render()
        m["items"][m["sel"] if i is None else i][1]()

    def menu_cancel(self):
        m, self.menu = self.menu, None
        self.render()
        if m["cancel"]:
            m["cancel"]()

    def draw_menu(self):
        c, m = self.canvas, self.menu
        W, H = c.winfo_width(), c.winfo_height()
        size = 16 if ANDROID else 14
        f, bold = F("Helvetica", size), F("Helvetica", size, "bold")
        rh = f.metrics("linespace") + S(16 if ANDROID else 10)
        labels = [label for label, _ in m["items"]]
        title = m["title"]
        bw = min(W - 20, max([f.measure(t) for t in labels] +
                             [bold.measure(title)]) + 40)
        if bold.measure(title) > bw - 40:
            title = "\n".join(wrap(title, max(20, len(title) * (bw - 40) //
                                              bold.measure(title))))
        th = (title.count("\n") + 1) * rh
        fit = max(1, (H - 2 * rh - th) // rh)
        n_items = len(labels)
        if n_items <= fit:
            shown = list(enumerate(labels))
        else:
            # Too long for the screen: a scrolling window, with arrows to
            # tap, and the last item (Bye, Nothing, Quit) always in view.
            page = max(1, fit - 3)
            m["page"] = page
            first = max(0, min(m["sel"] - page // 2, n_items - 1 - page))
            shown = [("up", "\u25b2 more" if first else "")] + \
                [(i, labels[i]) for i in range(first, first + page)] + \
                [("down", "\u25bc more" if first + page < n_items - 1
                  else ""), (n_items - 1, labels[-1])]
        bh = len(shown) * rh + th + 16
        x0, y0 = (W - bw) // 2, max(8, (H - bh) // 2)
        c.create_rectangle(x0, y0, x0 + bw, y0 + bh, fill=PANEL,
                           outline=ACCENT, width=2, tags="overlay")
        c.create_text(x0 + 20, y0 + 8 + th // 2, text=title, anchor="w",
                      fill=ACCENT, font=bold, tags="overlay")
        self.menu_rows = []
        for n, (i, label) in enumerate(shown):
            ry = y0 + 8 + th + n * rh
            if i == m["sel"]:
                c.create_rectangle(x0 + 6, ry, x0 + bw - 6, ry + rh,
                                   fill="#2c3320", outline="",
                                   tags="overlay")
            if isinstance(i, str):
                if label:
                    c.create_text(x0 + bw // 2, ry + rh // 2, text=label,
                                  fill=ACCENT, font=f, tags="overlay")
                    self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))
                continue
            c.create_text(x0 + 20, ry + rh // 2, text=label, anchor="w",
                          fill=INK, font=f, tags="overlay")
            self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))


    def action_menu(self):
        if self.busy or self.talk or self.chase or getattr(self, "trap",
                                                           None):
            return
        if self.overlay not in ("won", "doom"):
            self.overlay = None
        items = [("Help", self.show_help),
                 ("Mission file: to do, dossier, suspects", self.casebook),
                 ("Journal", self.journal),
                 ("Dossier", self.show_sheet), ("Map", self.toggle_map),
                 ("Search here", self.search), ("Reload", self.reload),
                 ("Hero Points %s" % ("off" if self.hero_auto else "on"),
                  self.toggle_hero),
                 ("Zoom in", lambda: self.zoom(1)),
                 ("Zoom out", lambda: self.zoom(-1)),
                 ("Bigger text", lambda: self.text_size(1)),
                 ("Smaller text", lambda: self.text_size(-1)),
                 ("Sound effects %s" % ("on" if self.sound.muted else "off"),
                  self.toggle_mute),
                 ("Music %s" % ("on" if self.sound.music_off else "off"),
                  self.toggle_music),
                 ("New game", self.ask_new_game), ("Quit", self.quit)]
        if self.overlay in ("won", "doom"):
            items = [("New game", self.new_game), ("Quit", self.quit)]
            if self.overlay == "won":
                items.insert(1, ("Stay a while", self.close_won))
        self.open_menu("Dead Drop", items)

    def close_won(self):
        self.overlay = None
        self.render()

    def on_tap(self, ev):
        self.walking = None
        if self.menu:
            for x0, y0, x1, y1, i in self.menu_rows:
                if x0 <= ev.x <= x1 and y0 <= ev.y <= y1:
                    self.menu_pick(i)
                    return
            if not self.talk:
                self.menu_cancel()
            return
        if self.busy or self.talk:
            return
        if self.overlay:
            self.close_overlay()
            return
        cols, rows, ox, oy, ts = self.view
        tx = self.pos[0] - cols // 2 + (ev.x - ox) // ts
        ty = self.pos[1] - rows // 2 + (ev.y - oy) // ts
        dx, dy = tx - self.pos[0], ty - self.pos[1]
        step = ((1 if dx > 0 else -1, 0) if abs(dx) >= abs(dy)
                else (0, 1 if dy > 0 else -1))
        if self.aim:
            if (dx, dy) == (0, 0):
                self.aim = None
                self.say("Never mind.", "info")
            else:
                self.aimed(*step)
        elif (dx, dy) == (0, 0):
            self.wait()
        elif abs(dx) + abs(dy) == 1:
            self.move(dx, dy)
        else:
            self.walk_to(tx, ty)


    def passable(self, x, y, goal):
        a = self.area
        if not a.inside(x, y):
            return False
        if (x, y) == goal:
            return True
        t = a.grid[y][x]
        if a.mob_at(x, y) or (x, y) in a.links:
            return False
        return t in WALKABLE and t not in ("stairs_up", "stairs_down",
                                           "exit", "steam", "laser", "lava")

    def walk_to(self, tx, ty):
        start, goal = tuple(self.pos), (tx, ty)
        prev = {start: None}
        q = deque([start])
        while q and goal not in prev:
            x, y = q.popleft()
            if abs(x - start[0]) + abs(y - start[1]) > 50:
                continue
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if n not in prev and self.passable(n[0], n[1], goal):
                    prev[n] = (x, y)
                    q.append(n)
        if goal not in prev:
            self.say("You can't find a way there.", "info")
            return
        path = []
        while goal != start:
            path.append(goal)
            goal = prev[goal]
        self.walking = path[::-1]
        self.walk_area = self.area
        self.walk_seen = self.hostiles_in_view()
        self.walk_step()

    def hostiles_in_view(self):
        return {id(m) for m in self.area.mobs
                if m.hostile and (m.x, m.y) in self.visible}

    def walk_step(self):
        if (not self.walking or not self.ready()
                or self.area is not self.walk_area):
            self.walking = None
            return
        x, y = self.walking.pop(0)
        before = tuple(self.pos)
        self.move(x - before[0], y - before[1])
        if (tuple(self.pos) != (x, y) or self.hostiles_in_view() -
                self.walk_seen):
            self.walking = None
            return
        if self.walking:
            self.root.after(90, self.walk_step)


    def wait(self):
        if not self.ready():
            return
        p = self.p
        if p["held"]:
            p["held"] -= 1
        p["cover"] = True
        self.say("You wait, keeping low.", "info")
        self.end_turn()
        p["cover"] = False

    # ── Drawing ──

    def layout(self):
        if not getattr(self, "area", None):
            return
        c = self.canvas
        scale = self.auto_scale()
        if scale != self.scale:
            self.scale = scale
            self.scale_images()
        c.delete("all")
        ts = 16 * self.scale
        W, H = max(c.winfo_width(), ts * 5), max(c.winfo_height(), ts * 5)
        cols, rows = W // ts, H // ts
        cols -= 1 - cols % 2
        rows -= 1 - rows % 2
        ox, oy = (W - cols * ts) // 2, (H - rows * ts) // 2
        self.view = (cols, rows, ox, oy, ts)
        self.cells = []
        for j in range(rows):
            for i in range(cols):
                x, y = ox + i * ts, oy + j * ts
                self.cells.append((
                    c.create_image(x, y, anchor="nw", state="hidden"),
                    c.create_image(x, y, anchor="nw", state="hidden")))
        self.shown = [(None, None)] * len(self.cells)
        self.fx = c.create_image(0, 0, anchor="nw", state="hidden")
        self.missile = c.create_image(0, 0, anchor="nw", state="hidden")
        self.render()

    @staticmethod
    def line_clear(a, x0, y0, x1, y1):
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        x, y = x0, y0
        while (x, y) != (x1, y1):
            if (x, y) != (x0, y0) and a.grid[y][x] in a.opaque:
                return False
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x += sx
            if e2 <= dx:
                err += dx
                y += sy
        return True


    def light_radius(self):
        a = self.area
        if a.dark:
            return 6
        if a.kind != "city":
            return None
        ph = self.phase()
        return None if ph == "day" else 9 if ph in ("dawn", "dusk") else 5

    def compute_visible(self):
        a = self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        r = self.light_radius()
        r2 = r * r if r else None
        lit = getattr(a, "lit", set()) if r else set()
        vis = set()
        for y in range(max(0, py - rows // 2), min(a.h, py + rows // 2 + 1)):
            for x in range(max(0, px - cols // 2),
                           min(a.w, px + cols // 2 + 1)):
                if r2 and (x - px) ** 2 + (y - py) ** 2 > r2 and \
                        (x, y) not in lit:
                    continue
                if self.line_clear(a, px, py, x, y):
                    vis.add((x, y))
                    a.seen[y * a.w + x] = 1
        return vis

    def render(self):
        if not self.cells or not getattr(self, "area", None):
            return
        c, a = self.canvas, self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        self.visible = vis = self.compute_visible()
        dim = a.dark or self.light_radius() is not None
        mobs = {(m.x, m.y): m for m in a.mobs}
        x0, y0 = px - cols // 2, py - rows // 2
        me = "agent_f" if self.p.get("sex") == "F" else "agent"
        for j in range(rows):
            y = y0 + j
            for i in range(cols):
                x = x0 + i
                base = top = None
                if a.inside(x, y):
                    t = a.grid[y][x]
                    if (x, y) in vis:
                        base = self.framed(a.skin.get(t, t))
                        m = mobs.get((x, y))
                        if (x, y) in a.smoke:
                            top = "smoke"
                        elif m:
                            top = m.tile
                        else:
                            top = a.items.get((x, y))
                    elif dim and a.seen[y * a.w + x]:
                        base = "~" + a.skin.get(t, t)
                elif a.edge:
                    base = self.framed(a.edge)
                if x == px and y == py:
                    top = me
                top = self.framed(top)
                idx = j * cols + i
                old = self.shown[idx]
                if old == (base, top):
                    continue
                self.shown[idx] = (base, top)
                bid, tid = self.cells[idx]
                if base != old[0]:
                    if base is None:
                        c.itemconfig(bid, state="hidden")
                    elif base[0] == "~":
                        c.itemconfig(bid, image=self.dimg[base[1:]],
                                     state="normal")
                    else:
                        c.itemconfig(bid, image=self.img[base],
                                     state="normal")
                if top != old[1]:
                    if top is None:
                        c.itemconfig(tid, state="hidden")
                    else:
                        c.itemconfig(tid, image=self.img[top],
                                     state="normal")
        c.delete("overlay")
        if self.overlay == "map":
            self.draw_map()
        elif self.overlay == "help":
            self.draw_text_box(HELP)
        elif self.overlay in ("sheet", "journal", "casebook"):
            self.draw_text_box(self.overlay_text)
        elif self.overlay in ("won", "lost", "doom"):
            self.draw_text_box(self.overlay_text,
                               ACCENT if self.overlay == "won" else BAD)
        if self.menu:
