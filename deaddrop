def block_rect(i, j):
    x0, y0 = 4 + 8 * i, 4 + 8 * j
    return x0, y0, x0 + 6, y0 + 6


def site_rect(i, j, half=None):
    """The building in a block, inside its ring of pavement."""
    x0, y0, x1, y1 = block_rect(i, j)
    x0, y0, x1, y1 = x0 + 1, y0 + 1, x1 - 1, y1 - 1
    if half == "L":
        x1 = x0 + 1
    elif half == "R":
        x0 = x1 - 1
    return x0, y0, x1, y1


def rect_cells(r):
    x0, y0, x1, y1 = r
    return [(x, y) for y in range(y0, y1 + 1) for x in range(x0, x1 + 1)]


