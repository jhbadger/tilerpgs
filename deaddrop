def blank(w, h, tile):
    return [[tile] * w for _ in range(h)]


def make_dungeon(world, lid, level, flags):
    """One level of a cell's hideout, or of the base: rooms and passages,
    its guards and its things, the same each time it is made (but for
    what's been done)."""
    lair = lid == "lair"
    if lair:
        info = LAIRS[world["lair"]]
        levels, theme, hazard, monsters, tier = LAIR_LEVELS, info.theme, \
            info.hazard, info.monsters, 3
        name = info.name
        loot = "crate"
    else:
        info = LEADS[lid]
        levels, theme, hazard, monsters, tier = info.levels, info.theme, \
            info.hazard, info.monsters, info.tier
        name = info.name
        loot = info.loot
    rng = random.Random("%s:%s:%d" % (world["seed"], lid, level))
    W, H = 44, 30
    last = level == levels
    for attempt in range(400):
        g = blank(W, H, "dwall")
        rooms = []
        want = rng.randint(7, 9)
        for _ in range(400):
            if len(rooms) >= want:
                break
            w, h = rng.randint(4, 9), rng.randint(3, 6)
            if last and len(rooms) == want - 1:
                w, h = max(w, 7), max(h, 5)
            x, y = rng.randint(1, W - w - 1), rng.randint(1, H - h - 1)
            if any(x <= r[2] + 2 and r[0] <= x + w + 1 and
                   y <= r[3] + 2 and r[1] <= y + h + 1 for r in rooms):
                continue
            rooms.append((x, y, x + w - 1, y + h - 1))
        if len(rooms) < 5:
            continue
        rooms.sort(key=lambda r: r[0] + r[2] + rng.random())
        end = rooms[-1]
        if last and lair and (end[2] - end[0] < 6 or end[3] - end[1] < 4):
            continue
        centers = [((r[0] + r[2]) // 2, (r[1] + r[3]) // 2) for r in rooms]

        def carve(a, b):
            (ax, ay), (bx, by) = a, b
            if rng.random() < 0.5:
                pts = [(x, ay) for x in range(min(ax, bx), max(ax, bx) + 1)]
                pts += [(bx, y) for y in range(min(ay, by), max(ay, by) + 1)]
            else:
                pts = [(ax, y) for y in range(min(ay, by), max(ay, by) + 1)]
                pts += [(x, by) for x in range(min(ax, bx), max(ax, bx) + 1)]
            for x, y in pts:
                g[y][x] = "dfloor"
        for r in rooms:
            for y in range(r[1], r[3] + 1):
                for x in range(r[0], r[2] + 1):
                    g[y][x] = "dfloor"
        for a, b in zip(centers, centers[1:]):
            carve(a, b)
        for _ in range(2):                  # a loop or two, avoiding the end
            i, j = sorted(rng.sample(range(len(rooms) - 1), 2))
            carve(centers[i], centers[j])
        ring = [(x, y) for x in range(end[0] - 1, end[2] + 2)
                for y in range(end[1] - 1, end[3] + 2)
                if not (end[0] <= x <= end[2] and end[1] <= y <= end[3])]
        openings = [(x, y) for x, y in ring if g[y][x] != "dwall"]
        if last and len(openings) != 1:
            continue
        break
    wall, floor = THEMES[theme]
    area = Area("dungeon", ("dun", lid, level), g, "%s, level %d" % (
        fill(name, world), level), dark=True)
    area.skin = {"dwall": wall, "dfloor": floor}
    area.lead = lid
    area.city = None
    sx, sy = centers[0]
    g[sy][sx] = "stairs_up"
    area.start = (sx, sy)
    ex, ey = centers[-1]
    floor_spots = [(x, y) for y in range(H) for x in range(W)
                   if g[y][x] == "dfloor"]
    end_cells = {(x, y) for x in range(end[0], end[2] + 1)
                 for y in range(end[1], end[3] + 1)}

    def free(n, far=6, within=None):
        spots = [p for p in (within or floor_spots)
                 if g[p[1]][p[0]] == "dfloor" and p not in area.items
                 and abs(p[0] - sx) + abs(p[1] - sy) >= far
                 and not area.mob_at(*p)]
        return rng.sample(spots, min(n, len(spots)))

    area.end_cells = end_cells
    if not last:
        g[ey][ex] = "stairs_down"
        area.down = (ex, ey)
    else:
        ox, oy = openings[0]
        g[oy][ox] = "gate"
        area.gate = (ox, oy)
        if lair:
            # the control room: the missile in its silo, the consoles,
            # the dais before them
            x0, y0, x1, y1 = end
            for x, y in end_cells:
                g[y][x] = "control"
            crow = y1 if oy == y0 - 1 else y0
            mcol = x0 if ox > x1 else x1 - 1
            mrows = range(y0, y0 + 4) if crow == y0 else range(y1 - 3, y1 + 1)
            missile = set()
            for i in range(2):
                for j, y in enumerate(mrows):
                    g[y][mcol + i] = landmark_tile("missile", i, j)
                    missile.add((mcol + i, y))
            area.consoles = set()
            for x in range(x0, x1 + 1):
                if any(abs(x - mx_) <= 1 for mx_, _ in missile) or \
                        abs(x - ox) + abs(crow - oy) <= 1:
                    continue
                g[crow][x] = "console"
                area.consoles.add((x, crow))
            step = 1 if crow == y0 else -1
            area.circle = {(x, crow + step) for x, _ in area.consoles}
            spots = [(x, y) for (x, y) in sorted(end_cells)
                     if g[y][x] == "control" and (x, y) != (ox, oy) and
                     abs(x - ox) + abs(y - oy) > 1]
            rng.shuffle(spots)
            if "won" not in flags:
                if "chairman_dead" not in flags:
                    x, y = spots.pop()
                    ch = make_monster("chairman", x, y, boss=True)
                    ch.name = SUSPECTS[world["chairman"]].name
                    ch.tile = SUSPECTS[world["chairman"]].tile
                    ch.chairman = True
                    area.mobs.append(ch)
                for kind in ("bodyguard", "tech", "tech", "guard"):
                    if spots:
                        x, y = spots.pop()
                        area.mobs.append(make_monster(
                            kind, x, y, boss=kind == "bodyguard", rng=rng))
        elif "strip:" + lid not in flags:
            boss = make_monster(info.boss, ex, ey, boss=True, rng=rng)
            boss.strip = lid
            area.mobs.append(boss)
    inner = [(x, y) for r in rooms[1:-1] for x in range(r[0] + 1, r[2])
             for y in range(r[1] + 1, r[3])]
    if hazard:
        for x, y in free(rng.randint(4, 8), 3, inner):
            g[y][x] = hazard
    for n in range(rng.randint(2, 4)):          # crates and safes
        if not inner:
            break
        x, y = rng.choice(inner)
        if g[y][x] != "dfloor" or (x, y) in end_cells:
            continue
        if "loot:%s:%d:%d:%d" % (lid, level, x, y) in flags:
            g[y][x] = "rubble"
        else:
            g[y][x] = loot
            area.loot.add((x, y))
    lore = LAIR_LORE if lair else CITY_TEXT[lid]["lore"]
    if level - 1 < len(lore):
        for x, y in free(1, 5):
            area.items[(x, y)] = "note"
            area.note = fill(lore[level - 1], world, None if lair else lid)
    for x, y in free(rng.randint(1, 2), 5):
        area.items[(x, y)] = "papers"
    for x, y in free(rng.randint(1, 2), 4):     # found by searching
        area.hidden[(x, y)] = rng.choice(("cash", "ammo", "kit", "cash"))
    for x, y in free(rng.randint(1, 3), 5):
        area.traps.add((x, y))
    n = 2 + level + tier // 2
    for x, y in free(n, 8):
        if (x, y) in end_cells and last:
            continue
        kinds = monsters
        kind = kinds[min(len(kinds) - 1, rng.randrange(1 + level))] \
            if rng.random() < 0.7 else rng.choice(kinds)
        if kind == "shark":
            g[y][x] = "pool"
            for dx, dy in DIRS:
                if g[y + dy][x + dx] == "dfloor":
                    g[y + dy][x + dx] = "pool"
        area.mobs.append(make_monster(kind, x, y, rng=rng))
    return area

