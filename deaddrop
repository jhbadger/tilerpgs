class Area:
    """A map: a city, a building, or a level below."""

    def __init__(self, kind, key, grid, name, edge=None, dark=False):
        self.kind, self.key, self.grid, self.name = kind, key, grid, name
        self.h, self.w = len(grid), len(grid[0])
        self.edge = edge
        self.dark = dark
        self.mobs = []
        self.items = {}         # (x, y) -> thing lying there
        self.links = {}         # (x, y) -> where it goes
        self.labels = {}        # (x, y) -> what it is
        self.hidden = {}        # (x, y) -> found by searching
        self.loot = set()       # containers not yet opened
        self.traps = set()
        self.smoke = {}         # (x, y) -> turns the smoke lasts
        self.landmark = {}      # (x, y) -> (name, description)
        self.decor = {}
        self.skin = {}
        self.seen = bytearray(self.w * self.h)
        self.opaque = OPAQUE[kind]
        self.start = (0, 0)
        self.down = None
        self.site = None
        self.city = None

    def inside(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h

    def mob_at(self, x, y):
        for m in self.mobs:
            if m.x == x and m.y == y:
                return m
        return None


class Mob:
    def __init__(self, tile, name, x, y):
        self.tile, self.name, self.x, self.y = tile, name, x, y
        self.kind = None
        self.hostile = False
