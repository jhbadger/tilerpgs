def roll(expr, rng=random):
    """Dice such as '1d6+1d4', '2d6+3', '-1d4', '1d3' or '0'."""
    total = 0
    for sign, term in re.findall(r"([+-]?)(\d+d\d+|\d+)",
                                 str(expr).replace(" ", "")):
        if "d" in term:
            n, s = (int(v) for v in term.split("d"))
            v = sum(rng.randint(1, s) for _ in range(n))
        else:
            v = int(term)
        total += -v if sign == "-" else v
    return total


def success_chance(pc, ef):
    """Primary Chance times the Ease Factor (never below 1/2 or above 10)."""
    ef = max(0.5, min(10, ef))
    return max(1, int(pc * ef))


def quality(sc, r):
    """The Quality Rating of a D100 roll r against Success Chance sc: 1
    (Excellent), 2 (Very Good), 3 (Good), 4 (Acceptable), or 0 for a
    failure.  A 100 always fails, and so does anything over 99."""
    if r >= 100 or r > min(sc, 99):
        return 0
    top = -(-min(sc, 300) // 10) * 10           # the table's row
    if r <= top // 10:
        return 1
    if r <= top // 5:
        return 2
    if r <= top // 2:
        return 3
    return 4


