def cap(s):
    return s[:1].upper() + s[1:]


def wrap(text, width):
    out, line = [], ""
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            out.append(line)
            line = "  " + word if text.startswith("  ") else word
        else:
            line = (line + " " + word) if line else word
    if line:
        out.append(line)
    return out


def compass(dx, dy):
    ns = "north" if dy < 0 else "south" if dy > 0 else ""
    ew = "west" if dx < 0 else "east" if dx > 0 else ""
    if abs(dy) > 2 * abs(dx):
        ew = ""
    elif abs(dx) > 2 * abs(dy):
        ns = ""
    return "-".join(s for s in (ns, ew) if s) or "here"


def where(frm, to):
    return "to the " + compass(to[0] - frm[0], to[1] - frm[1])


