def make_people(rng, cid, attracted):
    people = {}
    roles = CITY_ROLES["london" if cid == "london" else "world"]
    if cid == "berlin":
        roles = roles + ["waiter", "stasi"]
    for role in roles:
        tile, sex, honorific, title = ROLES[role]
        sex = sex or rng.choice("MF")
        if cid == "london" and role in FIXED_NAMES:
            first, last = FIXED_NAMES[role]
            full = "%s %s" % (first, last)
        else:
            first, last, full = person_name(rng, cid, sex)
        if tile is None:
            tile = rng.choice([t for t in TOWNSFOLK_TILES
                               if (t in WOMEN_TILES) == (sex == "F")])
        elif sex == "F" and tile not in WOMEN_TILES:
            tile = {"chief": "chief_f", "doctor": "nurse",
                    "clerk": "woman3", "barkeep": "woman",
                    "tailor": "woman2"}.get(tile, "woman2")
        if role == "doctor" and cid == "london":
            honorific = "Dr."
        if role == "armourer" and cid != "london":
            honorific = ""
        short = ("%s %s" % (honorific.split()[0], last)) if honorific else \
            first
        if role == "admiral":
            short = "the Admiral"
        people[role] = {"first": first, "last": last, "sex": sex,
                        "tile": tile, "name": ("%s %s" % (honorific, full))
                        if honorific else full, "short": short,
                        "title": title.format(city=CITIES[cid]["name"])}
    if cid in FATALES:
        f, m, ftile, mtile = FATALES[cid]
        first, last, title = f if attracted == "F" else m
        if cid == "hongkong":
            full = "%s %s" % (last, first)
        else:
            full = "%s %s" % (first, last)
        people["fatale"] = {"first": first, "last": last, "sex": attracted,
                            "tile": ftile if attracted == "F" else mtile,
                            "name": full, "short": first, "title": title}
    return people


def make_person(world, cid, role, x, y):
    if role.startswith("suspect"):
        sid = world["suspects"].get(cid) if role == "suspect" else \
            world["london_suspects"][1]
        if cid == "london" and role == "suspect":
            sid = world["london_suspects"][0]
        s = SUSPECTS[sid]
        m = Mob(s.tile, s.name, x, y)
        m.role = "suspect"
        m.suspect = sid
        m.title = s.title
        m.city = cid
        m.talk, m.greet = suspect_talk(world, sid)
        return m
    who = world["people"][cid][role]
    m = Mob(who["tile"], who["name"], x, y)
    m.role = role
    m.city = cid
    m.title = who["title"]
    m.shop = SHOPS.get(role)
    m.known = cid == "london" and role in FIXED_NAMES
    m.talk, m.greet = role_talk(world, cid, role)
    return m


def fill(text, world, cid=None):
    """Fill in {names} from the mission: people of the city cid (and
    London's), the city's name, the Chairman and so on."""
    names = {}
    for c in ("london", cid):
        if c and c in world["people"]:
            for r, v in world["people"][c].items():
                names[r] = v["short"]
                names[r + "_full"] = v["name"]
    if cid in CITIES:
        names["city"] = CITIES[cid]["name"]
        names["front"] = front_name(cid)
    ch = SUSPECTS[world["chairman"]]
    lair = LAIRS[world["lair"]]
    names.update(chairman=ch.name, tell=ch.tell, lair=lair.name,
                 region=lair.region, where=lair.where)
    return text.format(**names)


def front_name(cid):
    if cid == "istanbul":
        return "Haldun's carpet shop in the Grand Bazaar"
    s = CITIES[cid]["sites"].get("front")
    return s[0] if s else ""


