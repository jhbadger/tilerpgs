def poly_fill(g, pts, c):
    xs = [p[0] for p in pts]
    ys = [p[1] for p in pts]
    for y in range(max(0, int(min(ys))), min(len(g), int(max(ys)) + 1)):
        for x in range(max(0, int(min(xs))), min(len(g[0]), int(max(xs)) + 1)):
            if inside_poly(x + 0.5, y + 0.5, pts):
                g[y][x] = c


