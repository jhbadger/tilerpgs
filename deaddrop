def lm_brooklyn(p):
    granite, cable = "#a89a80", "#d8d8d0"
    for tx in (10, 82):
        p.rect(tx, 2, tx + 15, 50, granite)
        p.rect(tx, 2, tx + 15, 4, "#c4b89c")
        for ax in (tx + 2, tx + 9):
            p.pointed(ax, 14, ax + 4, 40, "#4a4440")
    for xa, xb in ((0, 10), (25, 82), (97, 111)):
        for x in range(xa, xb + 1):
            t = (x - xa) / float(max(1, xb - xa))
            if xa == 0:
                y = 48 - 44 * t * t
            elif xb == 111:
                y = 4 + 44 * t * t
            else:
                y = 4 + 40 * (1 - (2 * t - 1) ** 2)
            p.px(x, y, cable)
            p.px(x, y + 1, cable)
            if x % 4 == 0:
                p.line(x, y, x, 50, "#b8b8b0")
    p.rect(0, 48, 111, 63, "#5a5a60")
    p.rect(0, 48, 111, 50, "#8a8478")
    p.rect(0, 62, 111, 63, "#8a8478")
    for x in range(0, 112, 8):
        p.rect(x + 2, 55, x + 4, 55, "#d8d8c8")


