def draw_terrain(name, frame=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random(name + str(frame))
    # ── the streets ──
    if name == "grass":
        return grass(rng)
    if name == "road":
        return asphalt(rng)
    if name == "cobble":
        g = stone_blocks(rng, "#6a6660", "#45423e", 4, 3)
        return g
    if name == "pave":
        return pave(rng)
    if name == "square":
        g = pave(rng, "#a8a090", "#8a8274")
        for i in range(16):
            g[i][i] = g[i][15 - i] = "#988f80"
        return g
