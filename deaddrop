def wound_level(q, dc):
    """The wound a hit of Quality q does with Damage Class dc."""
    if not q:
        return None
    i = DAMAGE_CLASSES.index(dc) if dc in DAMAGE_CLASSES else 0
    return WOUND_CHART[q][max(0, min(11, i))]


def shift_class(dc, n):
    i = DAMAGE_CLASSES.index(dc) + n
    return DAMAGE_CLASSES[max(0, min(11, i))]


def speed_of(per, dex):
    """The Speed Chart: Perception plus Dexterity."""
    t = per + dex
    return 0 if t <= 7 else 1 if t <= 15 else 2 if t <= 23 else 3


def hth_class(str_):
    """The Damage Class Chart: a character's own fists, by Strength."""
    return "A" if str_ <= 8 else "B" if str_ <= 13 else "C"


