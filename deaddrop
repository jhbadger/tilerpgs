def roll_chars(bg, rng=random):
    """Characteristics, 5 to 15: 5 plus 2D5, plus the background's bent."""
    b = BACKGROUNDS[bg]["chars"]
    return {c: max(5, min(15, 5 + roll("2d5", rng) + b.get(c, 0)))
            for c in CHARS}


