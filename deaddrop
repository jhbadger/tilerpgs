def lm_eiffel(p):
    iron, dark = "#7a5640", "#4a3424"
    cx = 40
    for y in range(4, 128):
        if y < 40:
            w = 2 + (y - 4) * 0.08
        elif y < 80:
            w = 5 + (y - 40) * 0.26
        else:
            w = 15.4 + (y - 80) * 0.52
        for x in range(int(cx - w), int(cx + w) + 1):
            edge = abs(x - (cx - w)) < 1.6 or abs(x - (cx + w)) < 1.6
            if edge or (x + y) % 4 == 0 or (x - y) % 4 == 0:
                p.px(x, y, dark if edge else iron)
    # the arch between the legs
    for y in range(100, 128):
        for x in range(10, 71):
            if ((x - cx) / 26.0) ** 2 + ((y - 128) / 25.0) ** 2 < 1:
                if not (abs(((x - cx) / 26.0) ** 2 + ((y - 128) / 25.0) ** 2
                            - 1) < 0.08):
                    p.g[y][x] = p.g[y][x] if p.g[y][x] not in (iron, dark) \
                        else draw_terrain("grass")[y % 16][x % 16]
                else:
                    p.px(x, y, dark)
    for y, w in ((40, 7), (80, 17)):
        p.rect(cx - w, y - 1, cx + w, y + 2, dark)
        p.rect(cx - w + 1, y, cx + w - 1, y, "#c8a040")
    p.rect(cx - 1, 0, cx, 4, dark)
    p.px(cx, 0, "#e04040")


