def reachable(a, start, ground):
    seen, q = {start}, deque([start])
    while q:
        x, y = q.popleft()
        for dx, dy in DIRS:
            n = (x + dx, y + dy)
            if n not in seen and a.inside(*n) and a.grid[n[1]][n[0]] in \
                    ground:
                seen.add(n)
                q.append(n)
    return seen


def selftest():
    """Build every map and tune of a few missions, without a window."""
    tiles = all_tiles()
    for seed in range(8):
        w = generate_world(seed, "MF"[seed % 2])
        flags = set()
        for cid in ["london"] + w["cities"]:
            city = make_city(w, cid, flags)
            for name in {t for row in city.grid for t in row}:
                assert name in tiles, (cid, name)
            sites = CITIES[cid]["sites"]
            doors = [pos for pos, l in city.links.items()
                     if l[0] in ("bld", "lead")]
            assert len(doors) >= len(sites), (cid, doors)
            walk = WALKABLE - {"door", "checkpoint", "hatch"} | {"pier"}
            seen = reachable(city, city.start, walk)
            if cid == "berlin":         # the far side of the checkpoint
                seen |= reachable(city, (CHECKPOINT[0] + 3, CHECKPOINT[1]),
                                  walk)
            if cid == "hongkong":       # the far side of the ferry
                seen |= reachable(city, FERRY[(27, 20)], walk)
            for pos, link in city.links.items():
                assert any((pos[0] + dx, pos[1] + dy) in seen
                           for dx, dy in DIRS), (cid, pos, link)
            for sid, (name, kind, _, _) in sites.items():
                if kind == "front":
                    continue
                a = make_interior(w, cid, sid)
                assert a.grid[a.start[1]][a.start[0]] in INSIDE_FLOOR, sid
                if kind == "club":
                    sus = [m for m in a.mobs if m.role == "suspect"]
                    assert len(sus) == (2 if cid == "london" else 1), cid
                    assert cid == "london" or any(
                        m.role == "fatale" for m in a.mobs), cid
                for m in a.mobs:
                    fill(m.greet, w, cid)
                    for v in m.talk.values():
                        if isinstance(v, str):
                            fill(v, w, cid)
            if cid != "london":
                t = CITY_TEXT[cid]
                for k in ("clue", "key", "entry", "closed", "headline",
                          "chase", "trap", "cable", "jobs", "arrive",
                          "rumours", "lore"):
                    assert k in t, (cid, k)
                for line in t["lore"]:
                    fill(line, w, cid)
        for lid in list(w["cities"]) + ["lair"]:
            levels = LAIR_LEVELS if lid == "lair" else LEADS[lid].levels
            for level in range(1, levels + 1):
                a = make_dungeon(w, lid, level, flags)
                assert a.grid[a.start[1]][a.start[0]] == "stairs_up"
                seen = reachable(a, a.start, DUNGEON_FLOOR | {"gate"})
                if a.down:
                    assert a.down in seen, (lid, level)
                if level == levels:
                    assert any((m.x, m.y) in seen for m in a.mobs
                               if m.boss), (lid, level)
                    if lid == "lair":
                        assert a.circle and all(
                            c in seen for c in a.circle), (lid, level)
                for name in {t for row in a.grid for t in row}:
                    assert name in tiles or name in ("dwall", "dfloor"), \
                        name
    for a in ("london", "paris", "tokyo"):
        for b in ("rome", "newyork", "hongkong"):
            mins, price = flight(a, b)
            assert 60 <= mins <= 30 * 60 and price > 0, (a, b)
    for name, tune in MUSIC.items():
        steps = len(tune["melody"].replace("|", " ").split())
        assert steps == len(tune["chords"].split()) * tune["bar"], name
        for ch in tune["chords"].split():
            for tok in ("R3", "T3", "F3", "S3"):
                chord_note(ch, tok)
        for tok in tune["melody"].replace("|", " ").split():
            if tok not in ".-":
                note_number(tok)
    for cid, spec in CITIES.items():
        assert spec["tune"] in MUSIC, cid
    for name in TILE_NEEDED:
        assert name in tiles, name
    print("ok")


