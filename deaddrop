def make_monster(kind, x, y, boss=False, rng=random):
    e = ENEMIES[kind]
    mob = Mob(e.tile, e.name, x, y)
    mob.kind = kind
    mob.hostile = True
    mob.survival = e.survival
    if boss:
        mob.boss = True
    return mob


