def lm_tokyotower(p):
    red, white, dark = "#e2532c", "#f0ece4", "#8a3018"
    cx = 24
    for y in range(6, 128):
        if y < 40:
            w = 1.5 + (y - 6) * 0.06
        elif y < 74:
            w = 3.6 + (y - 40) * 0.17
        else:
            w = 9.4 + (y - 74) * 0.27
        band = white if (y // 12) % 2 else red
        for x in range(int(cx - w), int(cx + w) + 1):
            edge = abs(x - (cx - w)) < 1.4 or abs(x - (cx + w)) < 1.4
            if edge or (x + y) % 4 == 0 or (x - y) % 4 == 0:
                p.px(x, y, dark if edge and band == red else band)
    for y in range(108, 128):
        for x in range(8, 41):
            if ((x - cx) / 12.0) ** 2 + ((y - 128) / 18.0) ** 2 < 1:
                p.g[y][x] = draw_terrain("pave")[y % 16][x % 16]
    p.rect(cx - 6, 36, cx + 6, 41, "#d8d8d0")
    p.rect(cx - 5, 37, cx + 5, 39, "#4a5a6a")
    p.rect(cx - 12, 70, cx + 12, 77, "#d8d8d0")
    p.rect(cx - 11, 71, cx + 11, 74, "#4a5a6a")
    p.rect(cx, 0, cx, 6, red)
    p.px(cx, 0, "#ff3030")


