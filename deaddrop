def generate_world(seed, attracted="F"):
    """The mission: which cities, who is who, where the base is."""
    rng = random.Random("%s:world" % seed)
    cities = rng.sample(WORLD_CITIES, 4)
    sus = sorted(SUSPECTS)
    rng.shuffle(sus)
    world = {"seed": seed, "cities": cities, "attracted": attracted,
             "suspects": dict(zip(cities, sus)),
             "london_suspects": sus[4:6],
             "chairman": rng.choice(sus),
             "lair": rng.choice(sorted(LAIRS))}
    world["people"] = {c: make_people(rng, c, attracted)
                       for c in ["london"] + cities}
    world["errands"] = make_errands(rng, world)
    return world


def flight(frm, to):
    """(minutes, pounds) to fly between two places: a 1960s jet at 700
    km/h, plus the coach to the airport and the queues."""
    a = LAIRS[to].coords if to in LAIRS else CITIES[to]["coords"]
    b = LAIRS[frm].coords if frm in LAIRS else CITIES[frm]["coords"]
    la1, lo1, la2, lo2 = (math.radians(v) for v in a + b)
    d = 6371 * 2 * math.asin(math.sqrt(
        math.sin((la2 - la1) / 2) ** 2 +
        math.cos(la1) * math.cos(la2) * math.sin((lo2 - lo1) / 2) ** 2))
    minutes = int(round((d / 700.0 * 60 + 100) / 15.0)) * 15
    return minutes, 20 + int(d // 60)


