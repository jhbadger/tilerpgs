    # ── Game setup ──

    def default_agent(self):
        bg = random.choice(list(BACKGROUNDS))
        sex = random.choice("MF")
        return ("Agent", sex, "F" if sex == "M" else "M", bg, roll_chars(bg))

    def setup_world(self, seed, attracted):
        self.world = generate_world(seed, attracted)
        self.cache = {}

    def new_game(self, who=None):
        if who is None:
            if not getattr(self, "headless", False):
                def chosen(w):
                    if w is None:
                        if getattr(self, "area", None):
                            return
                        w = self.default_agent()
                    self.new_game(w)
                self.ask_agent(chosen)
                return
            who = self.default_agent()
        name, sex, attracted, bg, chars = who
        self.setup_world(random.randrange(1 << 31), attracted)
        self.p = self.make_agent(name, sex, attracted, bg, chars)
        self.flags = set()
        self.clues = []
        self.topics = set()
        self.strips = []                # cities whose strips you carry
        self.returned = []              # cities whose strips London has
        self.side = {}
        self.turn = 0
        self.lost_count = 0
        self.fallen = []
        self.tallies = {}
        self.city = "london"
        self.city_pos = {}
        self.seen = {}
        self.surface = None
        self.lair_from = None
        self.reset_view()
        self.log.config(state="normal")
        self.log.delete("1.0", "end")
        self.log.config(state="disabled")
        area = self.get_area(("bld", "london", "hq"))
        self.city_pos["london"] = list(self.door_of("london", "hq"))
        self.area, self.pos = area, list(area.start)
        self.say("London. Friday, the 1st of October, 1965.", "quest")
        self.say("%s, late of %s, is called in on a Friday morning. The "
                 "brass plate says Consolidated Marine Insurance; the lift "
                 "goes down further than it should." % (
                     name, BACKGROUNDS[bg]["late"]))
        self.say("Miss Ashby looks up from her typewriter: 'He's waiting. "
                 "Go straight through.' The Admiral's office is up the "
                 "passage to the north.", "talk")
        self.say("Arrow keys or WASD move; walk into people to talk. "
                 "Press ? for help.", "info")
        self.layout()
        self.save()

    def reset_view(self):
        self.overlay = None
        self.overlay_text = None
        self.end_talk()
        self.busy = False
        self.aim = None
        self.menu = None
        self.walking = None
        self.abort = None
        self.chase = None

    def restore(self, g):
        p = g["player"]
        for k in ("name", "bg", "chars", "levels", "wounds", "hero"):
            if k not in p:
                raise ValueError("bad agent")
        if p["weapon"] not in WEAPONS:
            raise ValueError("bad weapon")
        self.setup_world(int(g["seed"]), p.get("attracted", "F"))
        self.p = p
        self.flags = set(g.get("flags", []))
        self.clues = list(g.get("clues", []))
        self.topics = set(g.get("topics", []))
        self.strips = list(g.get("strips", []))
        self.returned = list(g.get("returned", []))
        self.side = {str(k): dict(v) for k, v in g.get("side", {}).items()}
        self.turn = int(g.get("turn", 0))
        self.lost_count = int(g.get("lost", 0))
        self.fallen = list(g.get("fallen", []))
        self.tallies = dict(g.get("tallies", {}))
        self.city = g.get("city", "london")
        if self.city not in CITIES and self.city != "lair":
            raise ValueError("bad city")
        self.city_pos = {k: list(v) for k, v in g.get("city_pos",
                                                      {}).items()}
        self.seen = dict(g.get("seen", {}))
        self.lair_from = g.get("lair_from")
        self.reset_view()
        self.surface = g.get("surface")
        if self.surface:
            self.surface = (tuple(self.surface[0]), self.surface[1])
        key = tuple(g["key"])
        self.area = self.get_area(key)
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        if self.area.grid[self.pos[1]][self.pos[0]] not in WALKABLE:
            self.pos = list(self.area.start)
        self.say("%s, %s." % (self.place_name(), self.date_text()), "quest")
        self.say("Welcome back, %s. Press ? for help." % self.p["name"],
                 "info")
        self.layout()
        if "won" in self.flags:
            self.show_won()
        elif self.turn >= DEADLINE:
            self.doom()

    def place_name(self):
        return LAIRS[self.world["lair"]].name if self.city == "lair" else \
            CITIES[self.city]["name"]

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "zoom": self.zoom_d, "text": self.text_k,
                "hero_auto": self.hero_auto}
        if getattr(self, "p", None) and getattr(self, "area", None):
            for k, a in self.cache.items():
                if k[0] == "city":
                    self.seen[k[1]] = pack_bits(a.seen)
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "clues": self.clues,
                "topics": sorted(self.topics), "strips": self.strips,
                "returned": self.returned, "side": self.side,
                "turn": self.turn, "lost": self.lost_count,
                "fallen": self.fallen, "tallies": self.tallies,
                "city": self.city, "city_pos": self.city_pos,
                "seen": self.seen, "lair_from": self.lair_from,
                "key": list(self.area.key), "pos": self.pos,
                "surface": [list(self.surface[0]), self.surface[1]]
                if self.surface else None}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.root.destroy()

    # ── Areas ──

    def get_area(self, key):
        if key in self.cache:
            return self.cache[key]
        w = self.world
        if key[0] == "city":
            cid = key[1]
            if cid not in CITIES or (cid != "london" and
                                     cid not in w["cities"]):
                raise ValueError("bad city")
            area = make_city(w, cid, self.flags)
            if cid in self.seen:
                try:
                    area.seen = unpack_bits(self.seen[cid], area.w * area.h)
                except (ValueError, zlib.error):
                    pass
            self.populate_city(area)
            lit = {"lamp", "neon", "neon2", "billboard", "lantern",
                   "watchtower"}
            area.lit = {(x + dx, y + dy) for y in range(area.h)
                        for x in range(area.w) if area.grid[y][x] in lit
                        for dx in range(-2, 3) for dy in range(-2, 3)
                        if abs(dx) + abs(dy) <= 3}
        elif key[0] == "bld":
            cid, sid = key[1], key[2]
            if cid not in CITIES or sid not in CITIES[cid]["sites"]:
                raise ValueError("bad site")
            area = make_interior(w, cid, sid)
            for m in area.mobs:
                self.give_errand(m)
        elif key[0] == "dun":
            lid, level = key[1], int(key[2])
            levels = LAIR_LEVELS if lid == "lair" else (
                LEADS[lid].levels if lid in LEADS else 0)
            if not 1 <= level <= levels:
                raise ValueError("bad level")
            area = make_dungeon(w, lid, level, self.flags)
            key = area.key
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        return area

    def populate_city(self, area):
        """Townsfolk and policemen."""
        cid = area.city
        rng = random.Random("%s:folk:%s" % (self.world["seed"], cid))
        ground = [(x, y) for y in range(area.h) for x in range(area.w)
                  if area.grid[y][x] in ("pave", "road", "cobble", "square")
                  and 3 < x < 60 and 3 < y < 44]
        doorsteps = {(x + dx, y + dy) for x, y in area.links
                     for dx, dy in DIRS}
        ground = [s for s in ground if s not in doorsteps]
        area.folk = []
        for i in range(20):
            if not ground:
                break
            x, y = rng.choice(ground)
            if area.mob_at(x, y):
                continue
            m = make_folk(self.world, cid, rng, i, x, y)
            area.folk.append(m)
            area.mobs.append(m)

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        if area.kind == "city":
            self.night_and_day()
        self.sound.play(sound)
        self.layout()
        self.save()

    def city_area(self):
        return self.get_area(("city", self.city))

    def go_outside(self):
        """Out of a building, onto its doorstep."""
        cid = self.city
        if self.area.kind == "inside" and self.area.city:
            cid = self.area.city
        city = self.get_area(("city", cid))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.enter(city, self.city_pos.get(cid) or city.start)
        self.say("You step out into %s." % district(cid, *self.pos), "info")
        self.after_outside()

    def after_outside(self):
        """Whoever is waiting for you outside."""
        cid = self.city
        day = self.clock()[0]
        if cid in self.strips and "chased:" + cid not in self.flags:
            self.flags.add("chased:" + cid)
            self.say("A car pulls away from the kerb as you come out. ORCUS "
                     "knows what you're carrying.", "bad")
            self.start_chase()
        elif "alert:" + cid in self.flags and \
                "chased:%s:%d" % (cid, day) not in self.flags and \
                cid != "london":
            self.flags.add("chased:%s:%d" % (cid, day))
            self.say("Two men in dark glasses get into a car as you come "
                     "out. You're being followed.", "bad")
            self.start_chase()

    def enter_link(self, link, x, y):
        kind = link[0]
        if kind == "bld":
            self.city_pos[self.city] = list(self.pos)
            area = self.get_area(link)
            self.say("You go into %s." % area.name, "info")
            self.enter(area, area.start)
            if area.kind_of == "club" and self.clock()[1] in range(4, 18):
                self.say("It's quiet at this hour; the tables open in the "
                         "evening.", "info")
            return
        if kind == "checkpoint":
            self.checkpoint(x, y)
            return
        if kind == "ferry":
            self.pos = list(link[1])
            self.pass_time(10, quiet=True)
            self.say("You ride the Star Ferry across the harbour, ten "
                     "minutes and ten cents.", "info")
            self.sound.play("door")
            self.render()
            return
        self.at_lead(link[1], x, y)

    def descend(self, lid):
        if self.area.kind == "city":
            self.city_pos[self.city] = list(self.pos)
        self.surface = (self.area.key, list(self.pos))
        area = self.get_area(("dun", lid, 1))
        self.say("You go down into %s." % area.name.split(",")[0], "info")
        self.enter(area, area.start, "stairs")

    def change_level(self, delta):
        _, lid, level = self.area.key
        if level + delta == 0:
            if lid == "lair":
                self.open_menu("The charter plane is waiting at the "
                               "landing stage. Fly back to %s?" %
                               CITIES[self.lair_from or "london"]["name"], [
                                   ("Yes, fly back", lambda: self.fly_to(
                                       self.lair_from or "london")),
                                   ("No, stay", lambda: None)])
                return
            key, pos = self.surface
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dun"}
            area = self.get_area(tuple(key))
            self.say("You climb back up, into the air.", "info")
            self.enter(area, pos, "stairs")
            if area.kind == "city":
                self.after_outside()
            return
        area = self.get_area(("dun", lid, level + delta))
        self.say("You climb %s to level %d." % (
            "down" if delta > 0 else "up", level + delta), "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        n = int(self.log.index("end").split(".")[0])
        if n > 600:
            self.log.delete("1.0", "%d.0" % (n - 500))
        self.log.config(state="disabled")
        self.log.see("end")

    @staticmethod
    def the(mob):
        return mob.name if mob.boss or mob.role else "the " + mob.name


    # ── The rules ──

    @staticmethod
    def pc_of(p, name):
        """A Primary Chance, from the skill formulas."""
        c = p["chars"]
        if name in CHARS:
            return c[name]
        lv = p["levels"].get(name, 0)
        if name == "Seduction":
            return (c["WIL"] + p["levels"].get("Charisma", 0)) // 2 + lv
        f = SKILLS[name]
        base = c[f[0]] if len(f) == 1 else (c[f[0]] + c[f[1]]) // 2
        return base + lv

    def pc(self, name):
        return self.pc_of(self.p, name)

    def speed(self):
        c = self.p["chars"]
        return speed_of(c["PER"], c["DEX"])

    def wound_penalty(self):
        return min(3, self.p["wounds"])

    def ease(self, name, ef):
        """The Ease Factor a task really has, after wounds, training and
        tools."""
        p = self.p
        ef -= self.wound_penalty()
        if name in SKILLS and p["levels"].get(name, 0) == 0:
            ef -= 3
        if name == "Lockpicking":
            if p["items"].get("lockpicks"):
                ef += 1
            if self.has_gadget("Skeleton Key"):
                ef += 2
        if name in ("Charisma", "Seduction", "Gambling") and \
                "taste:%s:%d" % (self.city, self.clock()[0]) in self.flags:
            ef += 1
        return ef

    def check(self, name, ef=5, quiet=False, hero=False, label=None):
        """Roll D100 against Primary Chance times Ease Factor; return the
        Quality (0 for a failure).  A Quality 1 earns a Hero Point, and a
        Hero Point can save a roll that matters (hero=True)."""
        p = self.p
        pc = self.pc(name)
        e = max(0.5, min(10, self.ease(name, ef)))
        sc = success_chance(pc, e)
        r = random.randint(1, 100)
        q = quality(sc, r)
        if not quiet:
            self.say("[%s %d x EF %s = %d: %d, %s]" % (
                label or name, pc, ("%g" % e), sc, r, QUALITY_NAMES[q]),
                "roll")
        if q == 1 and name not in COMBAT_SKILLS:
            p["hero"] += 1
            self.say("Excellent! A Hero Point (%d)." % p["hero"], "gold")
        if q and name in SKILLS and name not in p["checks"]:
            p["checks"].append(name)
        if not q and hero:
            q = self.hero_save()
        return q

    def hero_save(self):
        """Spend a Hero Point to turn a failure into a bare success."""
        p = self.p
        if p["hero"] > 0 and self.hero_auto:
            p["hero"] -= 1
            self.tally("hero")
            self.say("You spend a Hero Point: somehow, it works. (%d left)" %
                     p["hero"], "gold")
            return 4
        return 0

    def best_check(self, names, ef=5, hero=False):
        best = max(names, key=lambda s: self.pc(s) * max(
            0.5, self.ease(s, ef)))
        return self.check(best, ef, hero=hero), best

    def char_check(self, ch, ef=5, label=None, hero=False):
        return self.check(ch, ef, label=label or CHAR_NAMES[ch], hero=hero)

    @staticmethod
    def npc_roll(pc, ef=5):
        return quality(success_chance(pc, ef), random.randint(1, 100))

    def has_gadget(self, g):
        return self.p["gadgets"].get(g, 0) != 0

    def rank(self):
        n = len(self.returned)
        return [r for need, r in RANKS if n >= need][-1]

    # ── Time ──

    def now(self):
        return START + datetime.timedelta(minutes=self.turn)

    def clock(self):
        t = self.now()
        return self.turn // DAY + 1, t.hour

    def date_text(self):
        t = self.now()
        return "%s %d %s 1965, %d:%02d %s" % (
            t.strftime("%a"), t.day, t.strftime("%b"),
            (t.hour - 1) % 12 + 1, t.minute, "am" if t.hour < 12 else "pm")

    def phase(self):
        h = self.now().hour
        return ("night" if h >= 21 or h < 5 else "dawn" if h < 7 else
                "dusk" if h >= 19 else "day")

    def pass_time(self, minutes, quiet=False):
        """Time going by in a lump: a flight, research, sleep."""
        before = self.phase()
        self.turn += minutes
        if not quiet and self.phase() != before:
            self.say("It is %s now: %s." % (self.phase(), self.date_text()),
                     "info")
        self.night_and_day()
        if self.turn >= DEADLINE and "won" not in self.flags:
            self.doom()

    def night_and_day(self):
        """At night most people go home; they come out in the morning."""
        city = self.cache.get(("city", self.city))
        if not city or not hasattr(city, "folk"):
            return
        night = self.phase() == "night"
        here = getattr(self, "area", None)
        folk = [m for m in city.folk if not night or m.night_owl]
        city.mobs = [m for m in city.mobs if m not in city.folk or m in folk]
        for m in folk:
            if m not in city.mobs and not city.mob_at(m.x, m.y):
                city.mobs.append(m)
        if not night and "alert:" + self.city not in self.flags:
            px, py = self.pos if here is city else (-99, -99)
            city.mobs = [m for m in city.mobs if not m.hostile or m.boss
                         or abs(m.x - px) + abs(m.y - py) <= 6]

    # ── Turns ──

    def on_key(self, ev):
        if self.talk or self.busy or ev.state & 0x0C:
            return
        k = ev.keysym
        self.walking = None
        if self.menu:
            k = k[3:] if k.startswith("KP_") else k
            if k in ("Up", "w", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "space", "KP_Enter"):
                self.menu_pick()
            elif k.isdigit() and 1 <= int(k) <= len(self.menu["items"]):
                self.menu_pick(int(k) - 1)
            elif not self.menu.get("locked"):
                self.menu_cancel()
            return
        if self.overlay:
            if self.overlay in ("won", "doom") and k in ("n", "N"):
                self.new_game()
            elif self.overlay == "lost":
                self.successor()
            elif self.overlay in ("won", "doom") and k == "Escape":
                self.action_menu()
            elif self.overlay not in ("won", "doom") or k in (
                    "Return", "space", "KP_Enter"):
                self.close_overlay()
            return
        if self.aim:
            if k in MOVE_KEYS:
                self.aimed(*MOVE_KEYS[k])
            else:
                self.aim = None
                self.say("Never mind.", "info")
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("e", "E"):
            self.search()
        elif k in ("f", "F"):
            self.ready_fire()
        elif k in ("r", "R"):
            self.reload()
        elif k in ("g", "G", "c", "C"):
            self.gadget_menu()
        elif k in ("u", "U"):
            self.use_menu()
        elif k in ("space", "period", "KP_5"):
            self.wait()
        elif k in ("p", "P"):
            self.casebook()
        elif k in ("i", "I"):
            self.show_sheet()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def next_page(self):
        """Turn the page of the casebook or the end; False at the last."""
        pages = getattr(self, "pages", None)
        if self.overlay in ("casebook", "won", "doom") and pages and \
                self.page < len(pages) - 1:
            self.page += 1
            self.overlay_text = pages[self.page]
            self.render()
            return True
        return False

    def close_overlay(self):
        if self.next_page():
            return
        if self.overlay == "lost":
            self.successor()
            return
        if self.overlay in ("won", "doom"):
            self.action_menu()
            return
        self.overlay = None
        self.render()

    def ready(self):
        return bool(getattr(self, "area", None)) and not (
            self.busy or self.talk or self.overlay or self.menu)


    def move(self, dx, dy):
        if not self.ready():
            return
        p, a = self.p, self.area
        p["cover"] = False
        if p["held"]:
            p["held"] -= 1
            self.say("You fight to get free!" if p.get("held_by")
                     else "You struggle to your feet.", "bad")
            self.end_turn()
            return
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if a.kind == "inside":
                self.go_outside()
            elif a.kind == "city":
                self.say("The road out of %s. Your business is in the city; "
                         "to go further, take a plane." %
                         CITIES[self.city]["name"], "info")
                self.sound.play("bump")
            else:
                self.bump()
            return
        mob = a.mob_at(x, y)
        if mob:
            if mob.hostile:
                self.attack(mob)
                self.end_turn()
            elif mob.captive:
                self.interrogate(mob)
            else:
                self.start_talk(mob)
            return
        t = a.grid[y][x]
        if t in ("counter", "bar"):
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return
        link = a.links.get((x, y))
        if link and t in WALKABLE:
            self.enter_link(link, x, y)
            return
        if (x, y) in a.landmark and t not in WALKABLE:
            label, desc = a.landmark[(x, y)]
            self.say(desc, "info")
            self.sound.play("bump")
            return
        if t not in WALKABLE:
            self.touch(t, x, y)
            return
        self.pos = [x, y]
        if t == "exit":
            self.go_outside()
            return
        if t == "stairs_down":
            self.change_level(1)
            return
        if t == "stairs_up":
            self.change_level(-1)
            return
        self.step_on(x, y)
        slow = a.kind == "dungeon" and self.underfoot(x, y)
        self.end_turn()
        if slow and not self.busy and not self.overlay:
            self.end_turn()

    def bump(self):
        self.say("Blocked.", "info")
        self.sound.play("bump")


    def underfoot(self, x, y):
        """Traps and hazards below; True if wading (slow)."""
        a, p = self.area, self.p
        if (x, y) in a.traps:
            a.traps.discard((x, y))
            a.items[(x, y)] = "trap"
            self.say("A tripwire! A charge goes off under your feet.", "bad")
            self.flash(x, y)
            self.enemy_hit(random.choice((3, 4, 4)), "D", "The blast")
        t = a.grid[y][x]
        if t == "steam":
            self.say("Scalding steam!", "bad")
            self.enemy_hit(4, "C", "The steam")
        elif t == "lava":
            self.say("The rock here glows. It burns!", "bad")
            self.enemy_hit(3, "E", "The heat")
        elif t == "laser":
            if self.check("Evasion", 4, quiet=True):
                self.say("You twist between the beams.", "good")
            else:
                self.say("A beam catches you, and an alarm whoops!", "bad")
                self.enemy_hit(4, "D", "The laser")
                for m in a.mobs:
                    if m.hostile and abs(m.x - x) + abs(m.y - y) <= 14:
                        m.aware = True
        elif t == "pool":
            if self.has_gadget("Rebreather"):
                return False
            self.say("You wade through black water.", "info")
            return True
        return False

    @staticmethod
    def floor_spots(a):
        if not hasattr(a, "floor_cache"):
            a.floor_cache = [(x, y) for y in range(a.h) for x in range(a.w)
                             if a.grid[y][x] == "dfloor"]
        return a.floor_cache


    def end_turn(self):
        p, a = self.p, self.area
        before = self.phase()
        self.turn += 1
        now = self.phase()
        if now != before:
            if a.kind == "city":
                self.say({"dawn": "Dawn comes up grey over %s.",
                          "day": "The sun is up over %s.",
                          "dusk": "The lights come on across %s.",
                          "night": "Night in %s. ORCUS likes the dark."}[now]
                         % CITIES[self.city]["name"], "info")
            self.night_and_day()
        for pos in list(a.smoke):
            a.smoke[pos] -= 1
            if a.smoke[pos] <= 0:
                del a.smoke[pos]
        if self.turn >= DEADLINE and "won" not in self.flags:
            self.doom()
            return
        if a.kind == "dungeon":
            px, py = self.pos
            for tx, ty in list(a.traps):
                if abs(tx - px) + abs(ty - py) <= 2 and \
                        random.random() < self.pc("Sixth Sense") / 50.0:
                    a.traps.discard((tx, ty))
                    a.items[(tx, ty)] = "trap"
                    self.say("Your Sixth Sense stops you: a tripwire.",
                             "info")
            if a.key[1] == "lair" and self.turn % 30 == 0:
                left = DEADLINE - self.turn
                self.say("A loudspeaker: 'Launch minus %d hours, %d "
                         "minutes.'" % (left // 60, left % 60), "bad")
        self.render()
        for mob in list(a.mobs):
            if self.overlay or self.p["wounds"] >= 4:
                return
            if mob not in a.mobs or self.area is not a:
                continue
            if mob.hostile:
                self.monster_act(mob)
            elif not mob.captive:
                self.wander(mob)
        self.attacked = False
        if a.kind == "city":
            self.spawn_city()
        self.listen()
        self.daily_paper()
        self.render()

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        traits = ENEMIES[mob.kind].traits if mob.kind else ""
        if "bound" in traits:
            return t == "pool"
        if t in WATER:
            return "swim" in traits
        if a.kind == "city":
            return t in CITY_GROUND
        if a.kind == "inside":
            return t in INSIDE_FLOOR
        if t == "pool" and "swim" in traits:
            return True
        return t in DUNGEON_FLOOR and t not in ("stairs_up", "stairs_down")

    def monster_act(self, mob):
        e = ENEMIES[mob.kind]
        if mob.asleep:
            mob.asleep -= 1
            if not mob.asleep:
                self.say("%s wakes up, groggy." % cap(self.the(mob)), "bad")
                mob.aware = True
            return
        if mob.stun:
            mob.stun -= 1
            return
        if "slow" in e.traits and self.turn % 2:
            return
        diff = self.speed() - e.speed
        if diff > 0 and mob.aware and random.random() < 0.15 * diff:
            return                  # you're quicker than they are
        steps = 2 if "fast" in e.traits else 1
        for _ in range(steps):
            if mob not in self.area.mobs or self.p["wounds"] >= 4:
                return
            if self.monster_step(mob, e):
                return

    def in_smoke(self, x, y):
        return (x, y) in self.area.smoke

    def monster_step(self, mob, e):
        """One move; True if it attacked (and so is done)."""
        a = self.area
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if self.in_smoke(px, py) or self.in_smoke(mob.x, mob.y):
            mob.aware = False
            self.drift(mob)
            return False
        if not mob.aware:
            sc = min(95, success_chance(self.pc("Stealth"),
                                        4 + (1 if self.phase() == "night"
                                             else 0)))
            if dist <= 1 or ((mob.x, mob.y) in self.visible and dist <= 8 and
                             random.randint(1, 100) > sc):
                mob.aware = True
            else:
                self.drift(mob)
                return False
        if "coward" in e.traits:
            mob.flee = 3
        if mob.flee > 0:
            mob.flee = max(0, mob.flee - 1)
            for sx, sy in sorted(DIRS, key=lambda d: -abs(px - mob.x - d[0])
                                 - abs(py - mob.y - d[1])):
                if self.can_go(mob, mob.x + sx, mob.y + sy):
                    mob.x += sx
                    mob.y += sy
                    break
            return False
        if dist == 1:
            self.monster_attack(mob)
            return True
        if "bound" in e.traits:
            return False
        if (e.fire and "ranged" in e.traits and (dx == 0 or dy == 0) and
                dist <= 7 and self.line_clear(a, mob.x, mob.y, px, py) and
                not any(self.in_smoke(*c) for c in self.line_path(
                    (mob.x, mob.y), (px, py))) and random.random() < 0.45):
            self.monster_ranged(mob, dist)
            return True
        if "surrender" in e.traits and mob.wounds >= 2 and not mob.boss \
                and random.random() < 0.25:
            mob.flee = 6
            self.say("%s turns to run!" % cap(self.the(mob)), "info")
            return False
        order = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                       abs(py - mob.y - d[1]) + random.random() * 0.5) \
            if dist <= 14 else [random.choice(DIRS)]
        for sx, sy in order[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break
        return False

    def drift(self, mob):
        if random.random() < 0.3:
            sx, sy = random.choice(DIRS)
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy


    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        a = self.area
        if (a.inside(x, y) and a.grid[y][x] in mob.roam
                and not a.mob_at(x, y) and [x, y] != self.pos
                and not any((x + ex, y + ey) in a.links for ex, ey in DIRS)
                and (mob.home is None or abs(x - mob.home[0]) +
                     abs(y - mob.home[1]) <= 6)):
            mob.x, mob.y = x, y

    def listen(self):
        """Sixth Sense: the feeling of being watched, before you see who."""
        px, py = self.pos
        for m in self.area.mobs:
            if (m.hostile and not m.heard and (m.x, m.y) not in self.visible
                    and abs(m.x - px) + abs(m.y - py) <= 9):
                m.heard = True
                ef = 3 if "stealthy" in ENEMIES[m.kind].traits else 5
                if self.check("Sixth Sense", ef, quiet=True):
                    self.say("Your Sixth Sense prickles: someone %s." %
                             where((px, py), (m.x, m.y)), "bad")

    def spawn_city(self):
        """At night, and when ORCUS is looking for you, it sends its men."""
        a = self.area
        cid = self.city
        if cid == "london":
            return
        px, py = self.pos
        a.mobs = [m for m in a.mobs if not m.hostile or m.boss or
                  abs(m.x - px) + abs(m.y - py) <= 26]
        alert = "alert:" + cid in self.flags
        rate = 0.03 * (1 + self.p["fame"] / 10.0) * (2 if alert else 1)
        if self.p["disguised"] == self.clock()[0]:
            rate /= 3
        if (self.phase() != "night" and not alert) or random.random() > rate:
            return
        if sum(m.hostile for m in a.mobs) >= 2 + self.clock()[0] // 3:
            return
        kinds = ["hood", "gunman"]
        if self.clock()[0] >= 4:
            kinds += ["gunman", "assassin"]
        if cid == "tokyo":
            kinds += ["karateka"]
        for _ in range(20):
            x = px + random.randint(-12, 12)
            y = py + random.randint(-12, 12)
            if (not a.inside(x, y) or a.grid[y][x] not in CITY_GROUND
                    or (x, y) in self.visible or a.mob_at(x, y)
                    or abs(x - px) + abs(y - py) < 8):
                continue
            a.mobs.append(make_monster(random.choice(kinds), x, y))
            return

    # ── Fighting ──

    def weapon(self):
        return WEAPONS[self.p["weapon"]]

    def hth_dc(self):
        return shift_class(hth_class(self.p["chars"]["STR"]),
                           self.weapon().adj if not self.weapon().fire
                           else 0)

    def attack(self, mob):
        """Walk into a foe: shoot at point-blank range, or hit them."""
        p = self.p
        w = self.weapon()
        if not mob.aware and not mob.boss and self.has_gadget("Wire Watch"):
            self.takedown(mob)
            return
        if w.fire:
            if p["loaded"].get(p["weapon"], 0) > 0:
                self.shoot(mob, 1)
                return
            self.say("Click. Empty.", "bad")
            if self.reload(free=True):
                return
        self.attacked = True
        ef = 5 + (2 if not mob.aware else 0) + (2 if mob.stun or mob.asleep
                                                else 0)
        q = self.check("Hand-to-Hand", ef)
        if not q:
            self.say("You swing at %s and miss." % self.the(mob), "info")
            self.sound.play("miss")
            mob.aware = True
            return
        dc = self.hth_dc() if not w.fire else hth_class(p["chars"]["STR"])
        self.harm(mob, wound_level(q, dc), "hand", "You hit %s" %
                  self.the(mob))

    def harm(self, mob, wl, how, text):
        """A wound (or a stun) to a foe, and what it does to them."""
        e = ENEMIES[mob.kind]
        mob.aware = True
        self.flash(mob.x, mob.y)
        if wl == 0:
            if how == "hand":
                q = self.npc_roll(e.hth, 8)
                if not q:
                    mob.stun = roll("1d6")
                    self.say(text + ": they go down, dazed.", "good")
                else:
                    self.say(text + ", but they shake it off.", "info")
            else:
                q = self.npc_roll(e.wil, 8)
                if not q:
                    mob.stun = 1
                    self.say(text + ": they duck, pinned down.", "good")
                else:
                    self.say(text + ", a graze.", "info")
            self.sound.play("hit")
            return
        if mob.boss and mob.survival > 0 and mob.wounds + wl >= 4:
            mob.survival -= 1
            wl = max(1, wl - 1)
            self.say("%s twists aside at the last instant!" %
                     cap(self.the(mob)), "bad")
        mob.wounds += wl
        self.say("%s: %s." % (text, WOUND_NAMES[min(5, wl)]), "good")
        if mob.wounds >= 5:
            self.down(mob, dead=True)
            return
        if mob.wounds >= 4:
            self.down(mob, dead=False)
            return
        self.sound.play("hit")
        if not self.npc_roll(e.wil, PAIN_EF[min(3, mob.wounds)]):
            mob.stun = roll("1d3")
            self.say("%s falls, clutching the wound." % cap(self.the(mob)),
                     "good")
            if "surrender" in e.traits and not mob.boss and \
                    random.random() < 0.5:
                self.surrender(mob)

    def surrender(self, mob):
        mob.hostile = False
        mob.captive = True
        mob.tile = "downed"
        mob.title = "a captured " + ENEMIES[mob.kind].name.replace(
            "ORCUS ", "")
        self.tally("downs")
        self.say("%s puts up their hands. (Walk into them to ask "
                 "questions.)" % cap(self.the(mob)), "good")

    def tally(self, key, n=1):
        t = self.tallies
        t[key] = t.get(key, 0) + n

    def down(self, mob, dead):
        """A foe out of the fight: killed, or unconscious."""
        a = self.area
        e = ENEMIES[mob.kind]
        self.tally("downs")
        self.sound.play("kill")
        if mob.strip:
            a.items[(mob.x, mob.y)] = "film"
            self.say("Something falls from %s: a canister of microfilm." %
                     self.the(mob), "gold")
            self.flags.add("boss:" + mob.strip)
        if getattr(mob, "chairman", False):
            self.flags.add("chairman_dead")
            self.learn("unmasked")
            self.say("The Chairman of ORCUS is finished.", "quest")
        if dead or "human" not in e.traits or mob.boss:
            if mob in a.mobs:
                a.mobs.remove(mob)
            self.say("%s %s." % (cap(self.the(mob)),
                                 "is dead" if dead and "human" in e.traits
                                 else "is down, and out of it" if
                                 "human" in e.traits else "is finished"),
                     "good")
            if "human" in e.traits and (mob.x, mob.y) not in a.items:
                a.items[(mob.x, mob.y)] = "body"
            return
        mob.hostile = False
        mob.captive = True
        mob.tile = "downed"
        mob.title = "an unconscious " + e.name.replace("ORCUS ", "")
        self.say("%s goes down, out cold." % cap(self.the(mob)), "good")

    def monster_attack(self, mob):
        e = ENEMIES[mob.kind]
        name = cap(self.the(mob))
        ef = 5 - (2 if self.p["cover"] else 0)
        q = self.npc_roll(e.hth, ef)
        if not q:
            self.say("%s goes for you with %s, and misses." % (name,
                                                              e.weapon),
                     "info")
            self.sound.play("miss")
            return
        self.enemy_hit(q, e.hdc, "%s, with %s" % (name, e.weapon),
                       hand=True)
        if "grab" in e.traits and self.p["wounds"] < 4:
            self.p["held"] = 1
            self.p["held_by"] = True
            self.say("%s gets a grip on you!" % name, "bad")

    def monster_ranged(self, mob, dist):
        e = ENEMIES[mob.kind]
        name = cap(self.the(mob))
        ef = 5 - (2 if self.p["cover"] else 0) - (1 if dist > 4 else 0) + \
            (1 if dist <= 2 else 0)
        gas = "gas" in e.traits
        self.sound.play("spell" if gas else "shot")
        self.fly(self.line_path((mob.x, mob.y), tuple(self.pos)),
                 "gas" if gas else "bullet")
        q = self.npc_roll(e.fire, ef)
        if not q:
            self.say("%s fires %s at you, and misses." % (name, e.weapon),
                     "info")
            return
        if gas:
            self.say("%s sprays you with %s!" % (name, e.weapon), "bad")
            if not self.char_check("WIL", 6, label="Willpower, holding your "
                                   "breath"):
                self.p["held"] = 2
                self.p["held_by"] = False
                self.say("You choke and stagger, helpless.", "bad")
            if q <= 2:
                self.enemy_hit(q, e.dc, name)
            return
        self.enemy_hit(q, e.dc, "%s, with %s" % (name, e.weapon))

    def enemy_hit(self, q, dc, text, hand=False):
        """A hit on you, of Quality q; Hero Points turn the worst aside."""
        p = self.p
        wl = wound_level(q, dc)
        while (self.hero_auto and p["hero"] > 0 and q and
               p["wounds"] + max(0, wl) >= 4):
            p["hero"] -= 1
            self.tally("hero")
            q = q + 1 if q < 4 else 0
            wl = wound_level(q, dc) if q else None
            self.say("A Hero Point (%d left): %s" % (
                p["hero"], "it only grazes you." if q else
                "somehow it misses you entirely!"), "gold")
        if wl is None:
            return
        self.hurt(wl, text, hand)

    def hurt(self, wl, text, hand=False):
        p = self.p
        self.flash(*self.pos)
        self.sound.play("hurt")
        if self.abort is not None:
            self.abort["hit"] = True
        if wl == 0:
            self.say("%s: you're stunned!" % text, "bad")
            if not self.char_check("STR" if hand else "WIL", 8):
                p["held"] = roll("1d3") if hand else 1
                p["held_by"] = False
                self.say("You're down, seeing stars." if hand else
                         "You're pinned down by the fire.", "bad")
            return
        p["wounds"] = min(5, p["wounds"] + wl)
        self.say("%s: a %s! You are %s." % (
            text, WOUND_NAMES[min(5, wl)].lower(),
            WOUND_SHORT[p["wounds"]]), "bad")
        if p["wounds"] >= 5:
            self.agent_lost("dead")
            return
        if p["wounds"] >= 4:
            self.collapse()
            return
        if not self.char_check("WIL", PAIN_EF[min(3, p["wounds"])],
                               label="Pain Resistance"):
            p["held"] = 1
            p["held_by"] = False
            self.say("You go down, clutching the wound.", "bad")

    # ── Capture, and worse ──

    def collapse(self):
        """Incapacitated: ORCUS has you, or a passer-by finds you."""
        p = self.p
        self.abort = None
        self.walking = None
        self.chase = None
        self.say("The world goes dark...", "bad")
        self.sound.play("death")
        if self.area.kind == "dungeon":
            self.deathtrap()
            return
        self.wake_in_sickbay()

    def wake_in_sickbay(self):
        p = self.p
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        cid = self.city if self.city in CITIES else "london"
        self.city = cid
        self.pass_time(6 * 60, quiet=True)
        if "won" in self.flags or self.turn >= DEADLINE:
            return
        p["wounds"] = 3
        p["held"] = 0
        sid = "hq" if cid == "london" else "embassy"
        area = self.get_area(("bld", cid, sid))
        self.city_pos[cid] = list(self.door_of(cid, sid))
        self.area, self.pos = area, list(self.bed_spot(area))
        self.say("You wake in a sickbay bed, %s. Someone found you in the "
                 "street and knew who to call." % self.date_text(), "quest")
        self.layout()
        self.save()

    def deathtrap(self):
        """ORCUS never just shoots you.  A villain's speech, a slow death,
        and three chances to get out of it."""
        lid = self.area.key[1]
        p = self.p
        p["wounds"] = 4
        p["held"] = 0
        if lid == "lair":
            boss = SUSPECTS[self.world["chairman"]].name if \
                "chairman_dead" not in self.flags else "the Chairman's man"
            text = ("You wake strapped beneath the exhaust of the rocket. "
                    "%s smiles: 'You'll have the best seat in the house "
                    "at midnight.'" % boss)
        else:
            boss = ENEMIES[LEADS[lid].boss].name
            text = CITY_TEXT[lid]["trap"]
        self.say(text, "bad")
        self.say("'Do sit still,' says %s. 'It's so much tidier.'" % boss,
                 "talk")
        self.trap = {"lid": lid, "tries": 3}
        self.trap_menu()

    def trap_menu(self):
        p = self.p
        t = self.trap
        opts = []
        for g in ("Wire Watch", "Smoke Pellets", "Limpet Mine",
                  "Radio Lighter"):
            if self.has_gadget(g):
                opts.append(("Use the %s" % g, lambda g=g: self.trap_try(
                    "gadget", g)))
        opts += [("Work your hands free (Evasion, EF 3)",
                  lambda: self.trap_try("Evasion", 3)),
                 ("Pick the lock with a hidden pin (Lockpicking, EF 3)",
                  lambda: self.trap_try("Lockpicking", 3)),
                 ("Talk the guard round (Charisma, EF 3)",
                  lambda: self.trap_try("Charisma", 3))]
        if p["hero"] > 0:
            opts.append(("Spend a Hero Point: there's always a way (%d)" %
                         p["hero"], lambda: self.trap_try("hero", 0)))
        self.open_menu("The trap. %d chance%s left." % (
            t["tries"], "" if t["tries"] == 1 else "s"), opts)
        self.menu["locked"] = True
        self.menu["cancel"] = self.trap_menu

    def trap_try(self, how, arg):
        p = self.p
        ok = False
        if how == "gadget":
            uses = p["gadgets"].get(arg, 0)
            if uses > 0:
                p["gadgets"][arg] = uses - 1
            self.tally("gadgets")
            if arg == "Radio Lighter":
                self.say("You click the lighter three times. Twenty minutes "
                         "later the station's people come through the wall "
                         "with a cutting torch.", "gold")
                self.tally("escapes")
                self.trap = None
                self.extract()
                return
            self.say({"Wire Watch": "You pull the wire from the winder "
                                    "and saw through the straps.",
                      "Smoke Pellets": "You crack a pellet with your heel; "
                                       "in the smoke you slip your bonds.",
                      "Limpet Mine": "You set the mine against the bolts "
                                     "and roll away."}[arg], "gold")
            ok = True
        elif how == "hero":
            p["hero"] -= 1
            self.tally("hero")
            self.say("A Hero Point. The guard bends too close; a loose "
                     "screw; a sharp edge. You're free.", "gold")
            ok = True
        else:
            ok = bool(self.check(how, arg))
        if ok:
            self.tally("escapes")
            self.trap = None
            p["wounds"] = 3
            self.say("You're out, and very much alive. Heavily wounded, "
                     "but alive.", "quest")
            a = self.area
            self.pos = list(a.start)
            for m in a.mobs:
                m.aware = False
            self.sound.play("level")
            self.render()
            return
        self.trap["tries"] -= 1
        if self.trap["tries"] <= 0:
            self.trap = None
            self.say("It isn't enough. Not this time.", "bad")
            self.agent_lost("dead")
            return
        self.say("No good. It's getting closer.", "bad")
        self.trap_menu()

    def extract(self):
        """The station comes for you: out of wherever you are, to the
        embassy."""
        cid = self.city if self.city in CITIES else (self.lair_from or
                                                     "london")
        self.city = cid
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.pass_time(60, quiet=True)
        sid = "hq" if cid == "london" else "embassy"
        area = self.get_area(("bld", cid, sid))
        self.city_pos[cid] = list(self.door_of(cid, sid))
        self.p["held"] = 0
        self.area, self.pos = area, list(self.bed_spot(area))
        self.say("An hour later you are at %s, with a cup of tea." %
                 area.name, "quest")
        self.layout()
        self.save()

    def agent_lost(self, why):
        """Killed: the mission passes to another agent."""
        p = self.p
        self.busy = False
        self.abort = None
        self.chase = None
        self.menu = None
        self.end_talk()
        self.walking = None
        self.lost_count += 1
        d = self.now().day
        self.fallen.append({"name": p["name"], "bg": p["bg"],
                            "city": self.place_name(),
                            "date": "%s the %d%s" % (
                                self.now().strftime("%A"), d,
                                "th" if 10 <= d % 100 <= 20 else
                                {1: "st", 2: "nd", 3: "rd"}.get(d % 10,
                                                                "th"))})
        self.sound.play("death")
        days = max(0, (DEADLINE - self.turn) // DAY)
        self.overlay = "lost"
        self.overlay_text = (
            "%s IS DEAD.\n\nIn %s, on %s. The newspapers will\ncall it an "
            "accident. The Admiral will know better.\n\nBut the mission is "
            "not over. Another agent\ntakes up the file.\n%d days remain "
            "before midnight on Sunday.\n\nPress any key to brief the next "
            "agent." % (p["name"].upper(), self.place_name(),
                        self.fallen[-1]["date"], days))
        self.save()
        self.render()

    def successor(self):
        self.overlay = None
        if getattr(self, "headless", False):
            self.successor_go(None)
            return
        self.ask_agent(self.successor_go, "The next agent")

    def successor_go(self, who):
        if who is None:
            who = self.default_agent()
        name, sex, attracted, bg, chars = who
        self.p = self.make_agent(name, sex, self.p.get("attracted", "F"),
                                 bg, chars)
        if self.strips:
            self.say("Your predecessor's strips of microfilm were found, "
                     "and are in London now.", "quest")
            for cid in list(self.strips):
                self.hand_in(cid, quiet=True)
        self.cache = {}
        self.surface = None
        self.reset_view()
        self.city = "london"
        self.pass_time((24 + 9 - self.now().hour) % 24 * 60 or DAY,
                       quiet=True)
        area = self.get_area(("bld", "london", "hq"))
        self.area, self.pos = area, list(area.start)
        self.city_pos["london"] = list(self.door_of("london", "hq"))
        self.say("%s, %s, is shown into the Admiral's outer office and "
                 "handed a file with a black border. %s." % (
                     self.p["name"], bg.lower(), self.date_text()), "quest")
        self.layout()
        self.save()

    def doom(self):
        if self.overlay == "doom":
            return
        self.flags.add("doom")
        self.busy = False
        self.menu = None
        self.chase = None
        self.end_talk()
        self.overlay = "doom"
        self.pages, self.page = self.end_pages(False), 0
        self.overlay_text = self.pages[0]
        self.sound.play("horror")
        self.render()

    def show_won(self):
        self.overlay = "won"
        self.pages = self.end_pages(True)
        self.page = 0
        self.overlay_text = self.pages[0]
        self.render()

    # ── Firearms ──

    def ready_fire(self):
        if not self.ready():
            return
        p = self.p
        w = self.weapon()
        if not w.fire:
            guns = [g for g in p["weapons"] if WEAPONS[g].fire]
            if not guns:
                self.say("You have no gun.", "info")
                return
            p["weapon"] = guns[-1]
            self.say("You draw your %s." % guns[-1], "info")
            w = self.weapon()
        if p["loaded"].get(p["weapon"], 0) <= 0:
            if not self.reload():
                self.say("You have no %s." % w.ammo, "bad")
            return
        self.aim = ("fire",)
        self.say("Fire which way? (arrow keys, or tap)", "info")

    def reload(self, free=False):
        p = self.p
        w = self.weapon()
        if not w.fire:
            return False
        have = p["items"].get(w.ammo, 0)
        need = w.cap - p["loaded"].get(p["weapon"], 0)
        if need <= 0 or have <= 0:
            if need <= 0 and not free:
                self.say("It's loaded.", "info")
            return False
        n = min(need, have)
        p["items"][w.ammo] = have - n
        p["loaded"][p["weapon"]] = p["loaded"].get(p["weapon"], 0) + n
        self.say("You reload the %s (%d)." % (p["weapon"],
                                              p["loaded"][p["weapon"]]),
                 "info")
        if not free:
            self.end_turn()
        return True

    def aimed(self, dx, dy):
        what = self.aim
        self.aim = None
        if what[0] == "fire":
            self.fire(dx, dy)
        elif what[0] == "dart":
            self.dart(dx, dy)

    def target_in_line(self, dx, dy, reach):
        a = self.area
        x, y = self.pos
        path = []
        for _ in range(reach):
            x, y = x + dx, y + dy
            if not a.inside(x, y) or a.grid[y][x] in a.opaque or (
                    a.grid[y][x] not in WALKABLE and a.grid[y][x] not in
                    WATER and a.grid[y][x] not in (
                        "counter", "table", "cardtable", "crate", "safe",
                        "bar", "desk", "console", "pool")):
                break
            path.append((x, y))
            if (x, y) in a.smoke:
                break
            mob = a.mob_at(x, y)
            if mob:
                return mob, path
        return None, path

    def fire(self, dx, dy):
        w = self.weapon()
        mob, path = self.target_in_line(dx, dy, w.range)
        shots = 2 if self.p["weapon"] == "Machine Pistol" else 1
        for _ in range(shots):
            if self.p["loaded"].get(self.p["weapon"], 0) <= 0:
                break
            if mob is None or mob not in self.area.mobs or not mob.hostile:
                self.p["loaded"][self.p["weapon"]] -= 1
                self.tally("shots")
                self.say("You fire, and hit nothing.", "info")
                self.sound.play("shot")
                self.noise()
                self.fly(path, "bullet")
                continue
            dist = abs(mob.x - self.pos[0]) + abs(mob.y - self.pos[1])
            self.fly(path, "bullet")
            self.shoot(mob, dist)
        self.end_turn()

    def shoot(self, mob, dist):
        p = self.p
        w = self.weapon()
        self.attacked = True
        self.tally("shots")
        p["loaded"][p["weapon"]] -= 1
        self.sound.play("miss" if w.silent else "shot")
        self.noise(w.silent)
        if not mob.hostile:
            self.say("You hold your fire: that's a person.", "info")
            p["loaded"][p["weapon"]] += 1
            return
        ef = 5 + (1 if dist <= 2 else 0) - (1 if dist >= 6 else 0) + \
            (2 if not mob.aware else 0) + (1 if mob.stun or mob.asleep
                                           else 0)
        pc = self.pc("Fire Combat")
        e = max(0.5, min(10, self.ease("Fire Combat", ef)))
        sc = success_chance(pc, e)
        r = random.randint(1, 100)
        if r >= w.jam:
            self.say("[Fire Combat %d x EF %g = %d: %d, a jam!] The %s "
                     "jams; you clear it." % (pc, e, sc, r, p["weapon"]),
                     "bad")
            return
        q = quality(sc, r)
        self.say("[Fire Combat %d x EF %g = %d: %d, %s]" % (
            pc, e, sc, r, QUALITY_NAMES[q]), "roll")
        if q and "Fire Combat" not in p["checks"]:
            p["checks"].append("Fire Combat")
        if not q:
            self.say("You fire at %s and miss." % self.the(mob), "info")
            mob.aware = True
            return
        self.harm(mob, wound_level(q, w.dc), "fire", "You shoot %s" %
                  self.the(mob))

    def noise(self, silent=False):
        """A shot wakes the place, and in daylight in the street brings the
        police."""
        a = self.area
        px, py = self.pos
        for m in a.mobs:
            if m.hostile and abs(m.x - px) + abs(m.y - py) <= (4 if silent
                                                              else 14):
                m.aware = True
        if silent or a.kind != "city" or self.phase() == "night" or \
                any(m.hostile for m in a.mobs if (m.x, m.y) in self.visible):
            return
        self.p["fame"] += 1
        if not self.check("Charisma", 5, quiet=True):
            fine = 25 if self.city == "moscow" else 10
            self.p["cash"] = max(0, self.p["cash"] - fine)
            self.say("Police whistles! You talk fast, show a diplomatic "
                     "passport, and pay £%d all the same." % fine, "bad")

    def fly(self, path, tile):
        """A shot or a spell crossing the squares between."""
        cols, rows, ox, oy, ts = self.view
        c = self.canvas
        for x, y in path[:12]:
            i = x - self.pos[0] + cols // 2
            j = y - self.pos[1] + rows // 2
            if 0 <= i < cols and 0 <= j < rows:
                c.coords(self.missile, ox + i * ts, oy + j * ts)
                c.itemconfig(self.missile, image=self.img[tile],
                             state="normal")
                c.tag_raise(self.missile)
                c.update_idletasks()
                time.sleep(0.025)
        c.itemconfig(self.missile, state="hidden")

    @staticmethod
    def line_path(a, b):
        (x0, y0), (x1, y1) = a, b
        n = max(abs(x1 - x0), abs(y1 - y0))
        return [(x0 + round((x1 - x0) * k / n), y0 + round((y1 - y0) * k / n))
                for k in range(1, n + 1)] if n else []


    # ── Gadgets ──

    def gadget_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        for g, uses in sorted(p["gadgets"].items()):
            if GADGETS[g][0] is None:
                continue
            if uses == 0:
                continue
            items.append(("%s (%d): %s" % (g, uses, GADGETS[g][1]),
                          lambda g=g: self.use_gadget(g)))
        passive = [g for g, u in p["gadgets"].items() if GADGETS[g][0] is None]
        if not items:
            self.say("You have no gadgets to use%s." % (
                " (%s work by themselves)" % ", ".join(sorted(passive))
                if passive else ""), "info")
            return
        self.open_menu("Which gadget?", items + [("Never mind",
                                                  lambda: None)])

    def spend_gadget(self, g):
        p = self.p
        if p["gadgets"].get(g, 0) > 0:
            p["gadgets"][g] -= 1
        self.tally("gadgets")

    def use_gadget(self, g):
        a = self.area
        x, y = self.pos
        if g == "Smoke Pellets":
            self.spend_gadget(g)
            for dx in range(-1, 2):
                for dy in range(-1, 2):
                    if a.inside(x + dx, y + dy):
                        a.smoke[(x + dx, y + dy)] = 3
            for m in a.mobs:
                if m.hostile and abs(m.x - x) + abs(m.y - y) <= 3:
                    m.aware = False
            self.say("You crush a pellet. White smoke boils up all around "
                     "you.", "good")
            self.sound.play("potion")
            self.end_turn()
        elif g == "Dart Pen":
            self.aim = ("dart",)
            self.say("Fire the dart which way?", "info")
        elif g == "Limpet Mine":
            targets = [(x + dx, y + dy) for dx, dy in DIRS
                       if a.inside(x + dx, y + dy) and
                       a.grid[y + dy][x + dx] in ("gate", "safe", "console")]
            if not targets:
                self.say("Nothing here worth blowing up.", "info")
                return
            tx, ty = targets[0]
            self.spend_gadget(g)
            q = self.check("Demolitions", 6, hero=True)
            self.sound.play("fire")
            self.flash(tx, ty)
            for m in a.mobs:
                if m.hostile and abs(m.x - x) + abs(m.y - y) <= 14:
                    m.aware = True
            if not q:
                self.say("The mine goes off with a flat bang and does "
                         "nothing but tell everyone you're here.", "bad")
            elif a.grid[ty][tx] == "console":
                self.blow_console()
                return
            elif a.grid[ty][tx] == "safe":
                self.open_loot(tx, ty, forced=True)
                return
            else:
                a.grid[ty][tx] = "rubble"
                self.say("The gate goes up in a cloud of dust.", "good")
            self.end_turn()
        elif g == "Radio Lighter":
            if a.kind != "dungeon":
                self.say("Better saved for a real emergency.", "info")
                return
            self.spend_gadget(g)
            self.say("You click the lighter three times and wait.", "info")
            self.extract()

    def dart(self, dx, dy):
        mob, path = self.target_in_line(dx, dy, 6)
        self.spend_gadget("Dart Pen")
        self.fly(path, "dart")
        if mob is None or not mob.hostile:
            self.say("The dart flies off into the dark.", "info")
            self.end_turn()
            return
        dist = abs(mob.x - self.pos[0]) + abs(mob.y - self.pos[1])
        q = self.check("Fire Combat", 5 + (1 if dist <= 2 else 0) +
                       (2 if not mob.aware else 0))
        if not q:
            self.say("The dart misses %s." % self.the(mob), "info")
        elif mob.boss:
            mob.stun = 2
            self.say("%s pulls the dart out and staggers." %
                     cap(self.the(mob)), "good")
        else:
            self.say("The dart takes %s in the neck; they fold up and "
                     "sleep." % self.the(mob), "good")
            mob.hostile = False
            mob.captive = True
            mob.tile = "downed"
            mob.title = "a sleeping " + ENEMIES[mob.kind].name.replace(
                "ORCUS ", "")
            self.tally("downs")
        self.end_turn()

    def takedown(self, mob):
        """The Wire Watch: a silent end to someone who never saw you."""
        q = self.check("Stealth", 5)
        if q:
            self.say("You loop the wire over %s's head from behind. A "
                     "moment later they're asleep, and quiet." %
                     self.the(mob), "good")
            self.tally("gadgets")
            self.down(mob, dead=False)
        else:
            self.say("%s turns just in time!" % cap(self.the(mob)), "bad")
            mob.aware = True

    # ── Things ──

    def use_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        for n in ("first aid kit", "brandy", "disguise kit"):
            if p["items"].get(n):
                items.append(("%s (%d): %s" % (cap(n), p["items"][n],
                                               ITEMS[n]),
                              lambda n=n: self.use(n)))
        for w in p["weapons"]:
            if w != p["weapon"]:
                wp = WEAPONS[w]
                items.append(("Ready %s (%s%s)" % (
                    w, "class %s" % wp.dc if wp.fire else
                    "class %s" % shift_class(hth_class(
                        p["chars"]["STR"]), wp.adj),
                    ", %d loaded" % p["loaded"].get(w, 0) if wp.fire
                    else ""), lambda w=w: self.ready_weapon(w)))
        items.append(("Hero Points: %s" % (
            "spend them when it matters (on)" if self.hero_auto else
            "keep them (off)"), self.toggle_hero))
        self.open_menu("Use what?", items + [("Never mind", lambda: None)])

    def toggle_hero(self):
        self.hero_auto = not self.hero_auto
        self.say("Hero Points will %s." % (
            "be spent when a roll that matters fails, or a bullet would "
            "put you down" if self.hero_auto else "be kept, whatever "
            "happens"), "info")
        self.save()

    def ready_weapon(self, w):
        self.p["weapon"] = w
        self.say("You ready your %s." % w.lower() if w == "Fists" else
                 "You ready the %s." % w, "info")
        self.render_chrome()

    def use(self, n):
        p = self.p
        if n == "first aid kit":
            if p["wounds"] <= 0:
                self.say("You aren't hurt.", "info")
                return
            p["items"][n] -= 1
            if self.check("First Aid", 5):
                p["wounds"] -= 1
                self.say("You dress the wound. You are %s." %
                         WOUND_SHORT[p["wounds"]], "good")
            else:
                self.say("You fumble the dressing; little good comes of "
                         "it.", "info")
        elif n == "brandy":
            p["items"][n] -= 1
            p["held"] = 0
            self.say("A long pull of brandy. Your head clears.", "good")
            self.sound.play("potion")
        elif n == "disguise kit":
            q = self.check("Disguise", 6)
            p["items"][n] -= 1
            if q:
                p["disguised"] = self.clock()[0]
                self.say("Spectacles, a moustache, a different walk. Nobody "
                         "who knows your face would know you today.",
                         "good")
            else:
                self.say("You look like yourself in a false moustache.",
                         "info")
        if p["items"].get(n) == 0:
            del p["items"][n]
        self.end_turn()

    # ── Searching, picking up, touching ──

    def search(self):
        if not self.ready():
            return
        a = self.area
        px, py = self.pos
        near = [(x, y) for (x, y) in a.hidden
                if abs(x - px) + abs(y - py) <= 3]
        traps = [(x, y) for (x, y) in a.traps
                 if abs(x - px) + abs(y - py) <= 3]
        self.say("You search carefully.", "info")
        if not self.char_check("PER", 5):
            self.say("You find nothing.", "info")
        else:
            for pos in near:
                a.items[pos] = a.hidden.pop(pos)
            for pos in traps:
                a.traps.discard(pos)
                a.items[pos] = "trap"
            if near or traps:
                self.say("You find something!" if near else
                         "You find a tripwire.", "gold")
            else:
                self.say("There's nothing here to find.", "info")
        if not any(m.hostile for m in a.mobs if (m.x, m.y) in self.visible):
            self.turn += 4
        self.end_turn()

    def step_on(self, x, y):
        """Things on the floor are picked up (or looked at)."""
        a, p = self.area, self.p
        thing = a.items.get((x, y))
        if not thing or thing in ("trap",):
            return
        if thing == "body":
            key = "body:%s:%d:%d" % (a.key, x, y)
            if key not in self.flags:
                self.flags.add(key)
                self.say("A body. Someone who worked for ORCUS, and doesn't "
                         "any more.", "info")
            return
        del a.items[(x, y)]
        if thing == "film":
            lid = a.lead
            self.strips.append(lid)
            self.flags.add("strip:" + lid)
            self.tally("strips")
            self.p["fame"] += 1
            self.say("You take the %s strip of microfilm: a few frames of "
                     "ORCUS's plan, cut from the reel. Get it to a Head of "
                     "Station, or to the Admiral." %
                     CITIES[lid]["name"], "quest")
            self.sound.play("quest")
        elif thing == "note":
            self.say(getattr(a, "note", "A scrap of paper, illegible."),
                     "talk")
            self.hear(getattr(a, "note", ""))
        elif thing == "papers":
            self.read_papers()
        elif thing == "cash":
            n = roll("2d10+5")
            p["cash"] += n
            self.say("You find £%d in a drawer." % n, "gold")
            self.sound.play("gold")
        elif thing == "ammo":
            w = self.weapon()
            kind = w.ammo if w.fire else random.choice(list(AMMO))
            n = AMMO[kind][0] // 2
            p["items"][kind] = p["items"].get(kind, 0) + n
            self.say("You find %d %s." % (n, kind), "gold")
            self.sound.play("gold")
        elif thing == "kit":
            p["items"]["first aid kit"] = p["items"].get("first aid kit",
                                                         0) + 1
            self.say("You find a first aid kit.", "gold")
            self.sound.play("gold")
        elif thing == "key":
            self.say("You find a key.", "gold")

    def read_papers(self):
        """ORCUS paperwork: sometimes the address of another cell."""
        w = self.world
        here = getattr(self.area, "lead", None)
        unknown = [c for c in w["cities"] if c != here and
                   "known:" + c not in self.flags]
        self.say("A sheaf of ORCUS papers: invoices, rotas, a menu.",
                 "info")
        if unknown and random.random() < 0.6:
            c = random.choice(unknown)
            self.say("And an address book. Under %s: %s." % (
                CITIES[c]["name"].upper(), front_name(c)), "gold")
            self.learn(c + "_known")
        if self.has_gadget("Signet Camera"):
            q = self.check("Photography", 6)
            if q:
                self.tally("research")
                self.p["xp"] += 1
                self.say("Click: the signet camera has it all, for the "
                         "Registry.", "good")

    def touch(self, t, x, y):
        """Walking into the furniture of the world."""
        a = self.area
        kind = getattr(a, "kind_of", None)
        if t == "files" and kind in ("hq", "embassy"):
            self.research_menu()
        elif t == "files":
