def make_interior(world, cid, sid):
    name, kind, _, _ = CITIES[cid]["sites"][sid]
    floor, rows, cast = ROOMS[kind]
    if kind == "club":
        floor = CLUB_FLOORS[cid]
        cast = dict(cast)
        if cid == "london":
            cast["2"] = "suspect2"
    g, spots = [], {}
    for y, row in enumerate(rows):
        line = []
        for x, ch in enumerate(row):
            if ch.isdigit():
                spots[cast[ch]] = (x, y)
                line.append(floor)
            elif ch == "R" and cid not in CASINOS:
                line.append("table")
            elif ch == "H" and not (cid == "berlin" and kind == "club"):
                line.append(floor)
            else:
                line.append(ROOM_TILES.get(ch, floor))
        g.append(line)
    if cid == "berlin" and kind == "club":
        g[1][7] = "hatch"           # the cellar under the Kabarett
    area = Area("inside", ("bld", cid, sid), g, name, edge=None)
    area.site = sid
    area.kind_of = kind
    area.city = cid
    for y, row in enumerate(g):
        for x, t in enumerate(row):
            if t == "exit":
                area.start = (x, y - 1)
            elif t == "hatch":
                area.links[(x, y)] = ("lead", cid)
    people = world["people"][cid]
    for role, (x, y) in spots.items():
        if role in people or role.startswith("suspect"):
            area.mobs.append(make_person(world, cid, role, x, y))
    return area


