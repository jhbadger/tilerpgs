    @staticmethod
    def make_agent(name, sex, attracted, bg, chars):
        b = BACKGROUNDS[bg]
        levels = {s: 0 for s in SKILLS}
        levels.update(b["levels"])
        levels["Driving"] = max(1, levels["Driving"])
        levels["Charisma"] = max(1, levels["Charisma"])
        w = b["weapon"]
        p = {"name": name, "sex": sex, "attracted": attracted, "bg": bg,
             "chars": dict(chars), "levels": levels, "checks": [],
             "wounds": 0, "hero": 3, "fame": 0, "xp": 0,
             "cash": b["cash"], "weapons": ["Fists", w], "weapon": w,
             "loaded": {w: WEAPONS[w].cap},
             "items": {WEAPONS[w].ammo: AMMO[WEAPONS[w].ammo][0],
                       "first aid kit": 1, "formal wear": 1},
             "gadgets": {g: GADGETS[g][0] if GADGETS[g][0] else -1
                         for g in START_GADGETS},
             "held": 0, "cover": False, "disguised": -1}
        return p

    def tapped(self, ev):
        """A tap on the map, unless it's the tail of one on a dialog that
        just closed (on Android it can land on the map behind), or there's
        no game yet."""
        if time.time() < getattr(self, "tap_guard", 0) or \
                not getattr(self, "area", None):
            return
        self.on_tap(ev)

    def open_dialog(self):
        """Whether a dialog can open now (only one at a time)."""
        dlg = getattr(self, "dialog", None)
        try:
            if dlg is not None and dlg.winfo_exists():
                dlg.lift()
                return False
        except tk.TclError:
            pass
        return True

    def close_dialog(self, dlg=None):
        dlg = dlg or getattr(self, "dialog", None)
        if dlg is not None:
            try:
                dlg.destroy()
            except tk.TclError:
                pass
        if dlg is getattr(self, "dialog", None):
            self.dialog = None
        # a tap on a dialog button can land on the map behind it
        self.tap_guard = time.time() + 0.6

    def grab(self, dlg):
        try:
            dlg.grab_set()
        except tk.TclError:
            pass


