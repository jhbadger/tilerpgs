# ── Landmarks ────────────────────────────────────────────────────────────────
#
# Each is painted once on a canvas several squares wide, standing on the
# ground it belongs on, and cut into squares named lm_<name>_<i>_<j>.  The
# squares are scenery (walk into one to look at it) except those listed as
# walkable: an arch, a bridge's deck, the space under a gate.


class Pic:
    """A canvas of w x h squares, for painting a landmark."""

    def __init__(self, w, h, ground):
        self.W, self.H = w * 16, h * 16
        base = draw_terrain(ground)
        self.g = [[base[y % 16][x % 16] for x in range(self.W)]
                  for y in range(self.H)]

    def px(self, x, y, c):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < self.W and 0 <= y < self.H:
            self.g[y][x] = c

    def rect(self, x0, y0, x1, y1, c):
        for y in range(max(0, int(y0)), min(self.H, int(y1) + 1)):
            row = self.g[y]
            for x in range(max(0, int(x0)), min(self.W, int(x1) + 1)):
                row[x] = c

    def poly(self, pts, c):
        poly_fill(self.g, pts, c)

    def ellipse(self, cx, cy, rx, ry, c, top=False):
        """Filled; the top half only if top."""
        for y in range(max(0, int(cy - ry)), min(self.H, int(cy + ry) + 1)):
            if top and y > cy:
                continue
            for x in range(max(0, int(cx - rx)), min(self.W, int(cx + rx) + 1)):
                if ((x + 0.5 - cx) / rx) ** 2 + ((y + 0.5 - cy) / ry) ** 2 \
                        <= 1:
                    self.g[y][x] = c

    def disc(self, cx, cy, r, c):
        self.ellipse(cx, cy, r, r, c)

    def line(self, x0, y0, x1, y1, c, w=1):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        for k in range(n + 1):
            t = k / n
            x, y = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
            for dx in range(w):
                for dy in range(w):
                    self.px(x + dx - w // 2, y + dy - w // 2, c)

    def arch(self, x0, y0, x1, y1, c):
        """A round-headed opening, from x0 to x1, its top at y0."""
        r = (x1 - x0 + 1) / 2.0
        self.rect(x0, y0 + r, x1, y1, c)
        self.ellipse(x0 + r - 0.5, y0 + r, r, r, c, top=True)

    def pointed(self, x0, y0, x1, y1, c):
        """A Gothic opening, pointed at the top."""
        w = x1 - x0 + 1
        self.rect(x0, y0 + w, x1, y1, c)
        self.poly([(x0, y0 + w + 0.5), (x1 + 1, y0 + w + 0.5),
                   ((x0 + x1 + 1) / 2.0, y0)], c)

    def onion(self, cx, base, r, c, stripe=None):
        """An onion dome on a drum, its widest part r."""
        for y in range(int(base - 2.4 * r), int(base) + 1):
            t = (base - y) / (2.4 * r)
            w = r * math.sin(math.pi * min(1, t * 1.25)) * (1 - t * 0.25) \
                if t < 0.8 else r * 0.25 * (1 - t) / 0.2
            for x in range(int(cx - w), int(cx + w) + 1):
                cc = c
                if stripe and int((x - cx) + (y * 0.6)) % 4 < 2:
                    cc = stripe
                self.px(x, y, cc)
        self.line(cx, base - 2.4 * r - 3, cx, base - 2.4 * r, "#d8b040")

    def tiles(self):
        return {(i, j): [row[i * 16:(i + 1) * 16]
                         for row in self.g[j * 16:(j + 1) * 16]]
                for i in range(self.W // 16) for j in range(self.H // 16)}


