# The Berlin Wall's crossing, and Hong Kong's ferry.
CHECKPOINT = (38, 27)
FERRY = {(27, 20): (27, 27), (27, 26): (27, 19)}


def district(cid, x, y):
    """The part of the city a square lies in."""
    for (x0, y0, x1, y1), name in CITIES[cid]["districts"]:
        if x0 <= x <= x1 and y0 <= y <= y1:
            return name
    return CITIES[cid]["name"]


def make_city(world, cid, flags):
    """A city, the same every time it is made but for what the mission
    adds."""
    spec = CITIES[cid]
    rng = random.Random("city-1965:" + cid)
    W, H = CITY_W, CITY_H
    looks = spec["looks"]
    east = spec.get("east_x")

    def look_at(x, y=0):
        """Buildings come in runs of a few squares, not one by one."""
        pick = random.Random("%s:%d:%d" % (cid, x // 3, y // 2))
        if east is not None and x >= east:
            return pick.choice(spec["east_looks"])
        return pick.choice(looks)
    g = [[look_at(x, y) for x in range(W)] for y in range(H)]
    street = spec["street"]
    for y in STREET_Y:
        for x in range(STREET_X[0], STREET_X[-1] + 1):
            g[y][x] = street
    for x in STREET_X:
        for y in range(STREET_Y[0], STREET_Y[-1] + 1):
            g[y][x] = street
    for x in range(W):                  # the roads out of town
        g[STREET_Y[2]][x] = street
    for y in range(H):
        g[y][STREET_X[3]] = street
    skip = set(spec.get("skip", ())) | set(spec["parks"]) | \
        set(spec["squares"])
    used = set()
    for i in range(7):
        for j in range(5):
            x0, y0, x1, y1 = block_rect(i, j)
            west_look, east_look = look_at(x0, y0), look_at(x1, y1 + 3)
            for y in range(y0, y1 + 1):
                for x in range(x0, x1 + 1):
                    ring = x in (x0, x1) or y in (y0, y1)
                    g[y][x] = spec["ground"] if ring or (i, j) in skip \
                        else west_look if x < x0 + 3 else east_look
    for (i, j) in spec["parks"]:
        x0, y0, x1, y1 = block_rect(i, j)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                edge = x in (x0, x1) or y in (y0, y1)
                mid = x == (x0 + x1) // 2 or y == (y0 + y1) // 2
                g[y][x] = "path" if mid else (
                    spec["tree"] if (not edge and rng.random() < 0.3) or
                    (edge and (x + y) % 3 == 0) else "grass")
    for (i, j) in spec["squares"]:
        x0, y0, x1, y1 = block_rect(i, j)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                g[y][x] = "square"
    for r, tile in spec.get("areas", ()):
        for x, y in rect_cells(r):
            g[y][x] = tile
    area = Area("city", ("city", cid), g, spec["name"],
                edge=looks[0])
    area.city = cid
    # water, bridges, islands and quays
    for r in spec["water"]:
        for x, y in rect_cells(r):
            g[y][x] = "water"
    for kind, v in spec["bridges"]:
        cells = v if kind == "cells" else (
            [(v, y) for y in range(H)] if kind == "x" else
            [(x, v) for x in range(W)])
        for x, y in cells:
            if g[y][x] == "water":
                g[y][x] = "bridge"
    for r, tile in spec.get("land", ()):
        for x, y in rect_cells(r):
            g[y][x] = tile
    ground = {"pave", "road", "cobble", "square", "grass", "path"}
    for y in range(H):
        for x in range(W):
            if g[y][x] in ground and any(
                    0 <= x + dx < W and 0 <= y + dy < H and
                    g[y + dy][x + dx] == "water" for dx, dy in DIRS):
                g[y][x] = "quay"
    for tile, cells in spec.get("lines", ()):
        for x, y in cells:
            g[y][x] = tile
    for tile, x, y in spec.get("fixed", ()):
        g[y][x] = tile
    # landmarks
    area.landmark = {}
    for name, lx, ly, label, desc in spec["landmarks"]:
        w, h = LANDMARKS[name][:2]
        for i in range(w):
            for j in range(h):
                if area.inside(lx + i, ly + j):
                    g[ly + j][lx + i] = landmark_tile(name, i, j)
                    area.landmark[(lx + i, ly + j)] = (label, desc)
                    used.add((lx + i, ly + j))
        area.labels[(lx + w // 2, ly + h - 1)] = label
    # buildings of note
    for sid, (name, kind, (bi, bj, half), look) in spec["sites"].items():
        x0, y0, x1, y1 = site_rect(bi, bj, half)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                g[y][x] = look
                used.add((x, y))
        door = ((x0 + x1 + 1) // 2, y1)
        g[door[1]][door[0]] = "door"
        area.links[door] = ("lead", cid) if kind == "front" else \
            ("bld", cid, sid)
        area.labels[door] = name
    if spec.get("front_landmark"):
        _, fx, fy = spec["front_landmark"]
        area.links[(fx, fy)] = ("lead", cid)
        area.labels[(fx, fy)] = "the Grand Bazaar"
    if cid == "berlin":
        area.links[CHECKPOINT] = ("checkpoint",)
        area.labels[CHECKPOINT] = "Checkpoint Charlie"
    if cid == "hongkong":
        for (x, y), dest in FERRY.items():
            area.links[(x, y)] = ("ferry", dest)
            area.labels[(x, y)] = "the Star Ferry pier"
    # lamps on the corners of the blocks, and the street furniture
    rings = []
    for i in range(7):
        for j in range(5):
            x0, y0, x1, y1 = block_rect(i, j)
            if g[y0][x0] == spec["ground"]:
                g[y0][x0] = "lamp"
            for x, y in rect_cells((x0, y0, x1, y1)):
                if (x in (x0, x1) or y in (y0, y1)) and \
                        g[y][x] == spec["ground"] and (x, y) not in used:
                    rings.append((x, y))
    doorsteps = {(x + dx, y + dy) for x, y in area.links for dx, dy in DIRS}
    rings = [c for c in rings if c not in doorsteps]
    rng.shuffle(rings)
    for tile, n in spec["decor"]:
        for _ in range(n):
            if rings:
                x, y = rings.pop()
                g[y][x] = tile
                area.decor[(x, y)] = tile
    area.start = door_step(area, ("bld", cid, "terminal")) or \
        (STREET_X[3], STREET_Y[2])
    return area


def door_step(area, link):
    for pos, l in area.links.items():
        if l == link:
            return pos[0], pos[1] + 1
    return None


