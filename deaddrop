def art_pixels(palette, rows):
    if len(rows) != 16 or any(len(r) != 16 for r in rows):
        raise ValueError("tile art must be 16 x 16")
    return [[None if ch == "." else palette[ch] for ch in r] for r in rows]


def shade(c, f):
    r, g, b = (int(c[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % tuple(max(0, min(255, int(v * f)))
                                    for v in (r, g, b))


def mix(a, b, t):
    ra, ga, ba = (int(a[i:i + 2], 16) for i in (1, 3, 5))
    rb, gb, bb = (int(b[i:i + 2], 16) for i in (1, 3, 5))
    return "#%02x%02x%02x" % (round(ra + (rb - ra) * t),
                              round(ga + (gb - ga) * t),
                              round(ba + (bb - ba) * t))


def grid_of(c):
    return [[c] * 16 for _ in range(16)]


def speckle(g, rng, colors, p):
    for y in range(16):
        for x in range(16):
            if rng.random() < p:
                g[y][x] = rng.choice(colors)


def rect(g, x0, y0, x1, y1, c):
    for y in range(max(0, y0), min(16, y1 + 1)):
        for x in range(max(0, x0), min(16, x1 + 1)):
            g[y][x] = c


def disc(g, cx, cy, r, c, rng=None, jitter=0.0):
    for y in range(16):
        for x in range(16):
            d = math.hypot(x - cx, y - cy)
            if d <= r + (rng.uniform(-jitter, jitter) if rng else 0):
                g[y][x] = c


def speckle_within(g, rng, inside, colours, p):
    for y in range(16):
        for x in range(16):
            if g[y][x] == inside and rng.random() < p:
                g[y][x] = rng.choice(colours)


def inside_poly(x, y, pts):
    n, inside = len(pts), False
    for i in range(n):
        x0, y0 = pts[i]
        x1, y1 = pts[(i + 1) % n]
        if (y0 > y) != (y1 > y) and x < x0 + (y - y0) * (x1 - x0) / (y1 - y0):
            inside = not inside
    return inside


GRASS = ("#4e6a32", "#58763a", "#46602c", "#7a8a3a", "#6a5a2a")


def grass(rng):
    g = grid_of(GRASS[0])
    speckle(g, rng, GRASS[1:3], 0.35)
    speckle(g, rng, GRASS[3:], 0.03)
    return g


def stone_blocks(rng, base, mortar, bw=6, bh=4):
    g = grid_of(mortar)
    for row in range(16 // bh):
        off = (row % 2) * (bw // 2)
        for x in range(-bw, 16, bw):
            c = shade(base, rng.uniform(0.88, 1.1))
            rect(g, x + off, row * bh, x + off + bw - 2, row * bh + bh - 2, c)
    return g


def planks(rng, base, seam, vertical=False, width=4):
    g = grid_of(base)
    for y in range(16):
        for x in range(16):
            a, b = (x, y) if vertical else (y, x)
            if a % width == width - 1:
                g[y][x] = seam
            elif rng.random() < 0.08:
                g[y][x] = shade(base, 0.9)
    for i in range(4):          # butt joints
        a = rng.randrange(16)
        b = i * width + rng.randrange(width - 1)
        if vertical:
            g[a][min(15, b)] = seam
        else:
            g[min(15, b)][a] = seam
    return g


def water(rng, phase, base="#1c3a4e"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.12)], 0.3)
    for y in range(2, 16, 4):
        x0 = (y * 5 + phase * 3) % 16
        for k in range(4):
            g[y][(x0 + k) % 16] = shade(base, 1.7)
    return g


def roof(rng, base):
    g = grid_of(base)
    dark = shade(base, 0.72)
    for y in range(16):
        if y % 4 == 3:
            for x in range(16):
                g[y][x] = dark
        else:
            for x in range((y // 4) * 2 % 4, 16, 4):
                g[y][x] = shade(base, 0.85)
    speckle(g, rng, [shade(base, 1.12)], 0.06)
    return g


def tree(rng, colours, ground=None):
    g = ground or grass(rng)
    rect(g, 7, 11, 8, 15, "#4a3020")
    light, mid, dark = colours
    disc(g, 7.5, 7, 6.6, dark, rng, 0.6)
    disc(g, 7.5, 6.5, 5.6, mid, rng, 0.6)
    disc(g, 6, 5, 2.6, light, rng, 0.5)
    speckle_within(g, rng, mid, [light, dark], 0.12)
    return g


def bookshelf(rng, colours=("#7a1e1e", "#1e3a6a", "#2e5a2e", "#6a5a1e",
                            "#3a2a4a", "#8a6a3a", "#1a1a1a")):
    g = grid_of("#4a3020")
    for shelf in (1, 6, 11):
        x = 1
        while x < 15:
            w = rng.choice((1, 1, 2))
            c = rng.choice(colours)
            top = shelf + rng.choice((0, 0, 1))
            rect(g, x, top, min(14, x + w - 1), shelf + 3, c)
            x += w
        rect(g, 0, shelf + 4, 15, shelf + 4, "#2e1c10")
    return g


def pave(rng, base="#8e8a80", line="#76726a"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.05), shade(base, 0.95)], 0.25)
    for i in range(16):
        g[7][i] = g[15][i] = line
        g[i][7] = g[i][15] = line
    return g


def asphalt(rng):
    g = grid_of("#3e3e42")
    speckle(g, rng, ["#46464a", "#36363a", "#4c4c50"], 0.35)
    return g


def facade_roof(rng, base, trim, chimneys=True):
    """A city rooftop, seen from above: slates, a parapet and chimneys."""
    g = roof(rng, base)
    rect(g, 0, 0, 15, 0, trim)
    rect(g, 0, 15, 15, 15, shade(trim, 0.7))
    if chimneys:
        x = rng.randrange(2, 12)
        rect(g, x, 3, x + 2, 5, "#7a4a3a")
        rect(g, x, 3, x + 2, 3, "#a86a5a")
    return g


