def icon_mix(a, b, t):
    t = min(max(t, 0.0), 1.0)
    return tuple(int(a[i] + (b[i] - a[i]) * t) for i in range(3))


def icon_art(x, y):
    """A gold globe on a midnight sky, and a strip of microfilm across
    it."""
    gold = (222, 180, 70)
    a = -0.32
    u = (x - 0.5) * math.cos(a) + (y - 0.76) * math.sin(a)
    v = -(x - 0.5) * math.sin(a) + (y - 0.76) * math.cos(a)
    if abs(v) < 0.085:
        if 0.055 < abs(v) < 0.075 and (u * 36) % 1 < 0.5:
            return (210, 206, 190)
        if abs(v) < 0.045 and (u * 7 + 0.3) % 1 < 0.86:
            return icon_mix((200, 140, 50), (150, 90, 30),
                            (abs(v) / 0.045) ** 2)
        return (22, 22, 26)
    cx, cy, r = 0.5, 0.42, 0.30
    d = math.hypot(x - cx, y - cy)
    if abs(d - r) < 0.014:
        return gold
    if d < r:
        h = math.sqrt(max(0.0, 1 - ((y - cy) / r) ** 2))
        for k in (0.0, 0.42, 0.78):
            if abs(abs(x - cx) - r * k * h) < 0.008:
                return gold
        for ly in (-0.55, 0.0, 0.55):
            if abs((y - cy) - r * ly) < 0.008:
                return gold
        return icon_mix((40, 56, 100), (22, 30, 60), d / r)
    sky = icon_mix((26, 34, 66), (6, 8, 20), math.hypot(x - 0.5, y - 0.4))
    if (int(x * 97) * 31 + int(y * 89) * 17) % 151 == 0:
        return (230, 230, 240)
    return sky


def icon_rr(x, y, x0, y0, x1, y1, r):
    """True inside the rounded rectangle (x0,y0)-(x1,y1) with corner radius r."""
    cx = min(max(x, x0 + r), x1 - r)
    cy = min(max(y, y0 + r), y1 - r)
    return math.hypot(x - cx, y - cy) <= r


def icon_sample(x, y):
    """RGB of the icon at (x, y) in the unit square, or None (transparent)."""
    if not icon_rr(x, y, 0.0, 0.0, 1.0, 1.0, 0.2):
        return None
    return icon_art(x, y)


def icon_render_png(size):
    n = 4 if size <= 256 else 2
    rows = []
    for py in range(size):
        row = bytearray([0])                     # PNG filter type 0
        for px in range(size):
            ra = ga = ba = aa = 0
            for sy in range(n):
                for sx in range(n):
                    c = icon_sample((px + (sx + 0.5) / n) / size,
                                    (py + (sy + 0.5) / n) / size)
                    if c:
                        ra += c[0]
                        ga += c[1]
                        ba += c[2]
                        aa += 1
            if aa:
                row += bytes((ra // aa, ga // aa, ba // aa,
                              255 * aa // (n * n)))
            else:
                row += b"\0\0\0\0"
        rows.append(bytes(row))

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
    return (b"\x89PNG\r\n\x1a\n" +
            chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 6, 0, 0, 0)) +
            chunk(b"IDAT", zlib.compress(b"".join(rows), 9)) +
            chunk(b"IEND", b""))


