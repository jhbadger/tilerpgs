def landmark_tile(name, i, j):
    return "lm_%s_%d_%d" % (name, i, j)


def all_tiles():
    """name -> pixel rows, for every tile and animation frame."""
    tiles = {}
    for name in TERRAIN:
        tiles[name] = draw_terrain(name)
        if name in ANIMATED_TERRAIN:
            tiles[name + "@1"] = draw_terrain(name, 1)
    for name, (w, h, ground, paint, walk) in LANDMARKS.items():
        pic = Pic(w, h, ground)
        paint(pic)
        for (i, j), px in pic.tiles().items():
            tiles[landmark_tile(name, i, j)] = px
    sprites = {}
    for name, (shape, pal) in PEOPLE.items():
        sprites[name] = art_pixels(pal, PERSON_SHAPES[shape])
    for name, (pal, rows) in ART.items():
        sprites[name] = art_pixels(pal, rows)
    still = {"hit", "bullet", "dart", "gas", "smoke", "downed"} | FLOOR_ITEMS
    for name, px in sprites.items():
        tiles[name] = px
        SPRITES.add(name)
        if name in still:
            continue
        tiles[name + "@1"] = px[1:] + [[None] * 16]     # a bob: up a pixel
    return tiles


def landmark_walkable():
    """The landmark squares that can be walked on."""
    out = set()
    for name, (w, h, ground, paint, walk) in LANDMARKS.items():
        for i, j in walk:
            out.add(landmark_tile(name, i, j))
    return out


