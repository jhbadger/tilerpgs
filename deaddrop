def lm_colosseum(p):
    stone, shade_, dark = "#d4ba8e", "#a88a5e", "#4a3a26"
    for x in range(96):
        top = 8 if x < 58 else int(8 + (x - 58) * 0.7 + 3 * math.sin(x))
        p.rect(x, top, x, 63, stone)
    p.rect(0, 8, 57, 9, shade_)
    for ty in (12, 30, 47):
        p.rect(0, ty - 2, 95, ty - 1, shade_)
        for x in range(1, 96, 8):
            p.arch(x + 1, ty, x + 5, ty + 13, dark)
    # the ruined side: the inner ring shows
    for x in range(62, 96):
        for y in range(10, 63):
            if p.g[y][x] != stone and p.g[y][x] != shade_ and \
                    p.g[y][x] != dark:
                continue
            top = int(8 + (x - 58) * 0.7 + 3 * math.sin(x))
            if y < top:
                p.px(x, y, "#b49a70" if (x + y) % 9 else dark)


