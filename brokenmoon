    def reset_view(self):
        self.overlay = None
        self.overlay_text = None
        self.end_talk()
        self.busy = False
        self.aim = None
        self.menu = None
        self.walking = None
        self.flights = []

    def restore(self, g):
        p = g["player"]
        for k in ("name", "cls", "stats", "hp", "maxhp", "level", "usage"):
            if k not in p:
                raise ValueError("bad hero")
        if p["cls"] not in CLASSES or p["melee"] not in WEAPONS:
            raise ValueError("bad hero")
        self.world = generate_world(int(g["seed"]))
        self.cache = {}
        self.p = p
        self.flags = set(g.get("flags", []))
        self.topics = set(g.get("topics", []))
        self.notes = list(g.get("notes", []))
        self.turn = int(g.get("turn", 0))
        self.tallies = dict(g.get("tallies", {}))
        self.city = g.get("city", "phila")
        if self.city not in CITIES:
            raise ValueError("bad city")
        self.city_pos = {k: list(v) for k, v in g.get("city_pos",
                                                      {}).items()}
        self.seen = dict(g.get("seen", {}))
        self.reset_view()
        self.surface = g.get("surface")
        if self.surface:
            self.surface = (tuple(self.surface[0]), self.surface[1])
        self.area = self.get_area(tuple(g["key"]))
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        if self.area.grid[self.pos[1]][self.pos[0]] not in WALKABLE:
            self.pos = list(self.area.start)
        self.say("%s, %s." % (CITIES[self.city]["name"], self.date_text()),
                 "quest")
        self.say("Welcome back, %s. Press ? for help." % self.p["name"],
                 "info")
        self.layout()
        if "won" in self.flags:
            self.show_won()
        elif self.turn >= DEADLINE:
            self.doom()

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "zoom": self.zoom_d, "text": self.text_k,
                "destiny_auto": self.destiny_auto}
        if getattr(self, "p", None) and getattr(self, "area", None) and \
                self.overlay != "lost":
            for k, a in self.cache.items():
                if k[0] == "city":
                    self.seen[k[1]] = pack_bits(a.seen)
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "topics": sorted(self.topics),
                "notes": self.notes, "turn": self.turn,
                "tallies": self.tallies, "city": self.city,
                "city_pos": self.city_pos, "seen": self.seen,
                "key": list(self.area.key), "pos": self.pos,
                "surface": [list(self.surface[0]), self.surface[1]]
                if self.surface else None}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.shell.close()

    # ── Areas ──

    def get_area(self, key):
        key = tuple(key)
        if key in self.cache:
            return self.cache[key]
        w = self.world
        if key[0] == "city":
            cid = key[1]
            if cid not in CITIES:
                raise ValueError("bad city")
            area = make_city(w, cid, self.flags)
            if cid == "washington" and "ward_open" in self.flags:
                x, y = CITIES[cid]["lair_door"]
                area.grid[y][x] = "ward_open"
            if cid in self.seen:
                try:
                    area.seen = unpack_bits(self.seen[cid], area.w * area.h)
                except (ValueError, zlib.error):
                    pass
            self.populate_city(area)
            lit = {"campfire", "ward"}
            area.lit = {(x + dx, y + dy) for y in range(area.h)
                        for x in range(area.w) if area.grid[y][x] in lit
                        for dx in range(-3, 4) for dy in range(-3, 4)
                        if abs(dx) + abs(dy) <= 4}
        elif key[0] == "bld":
            cid, sid = key[1], key[2]
            if cid not in CITIES or sid not in CITIES[cid]["sites"]:
                raise ValueError("bad site")
            area = make_interior(w, cid, sid, self.flags)
        elif key[0] == "dun":
            lid, level = key[1], int(key[2])
            if lid not in LAIRS or not 1 <= level <= LAIRS[lid].levels:
                raise ValueError("bad level")
            area = make_dungeon(w, lid, level, self.flags)
            key = area.key
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        return area

    def populate_city(self, area):
        """Survivors near the camps, and the king's creatures in the
        ruins."""
        cid = area.city
        spec = CITIES[cid]
        rng = random.Random("%s:folk:%s" % (self.world["seed"], cid))
        ground = [(x, y) for y in range(area.h) for x in range(area.w)
                  if area.grid[y][x] in ("pave", "road", "cracked", "square",
                                         "weeds", "path")
                  and 2 < x < 61 and 2 < y < 45]
        doorsteps = {(x + dx, y + dy) for x, y in area.links
                     for dx, dy in DIRS}
        ground = [s for s in ground if s not in doorsteps]
        doors = [pos for pos, l in area.links.items() if l[0] == "bld"]
        area.folk = []
        for i in range(spec["folk"]):
            near = [s for s in ground if doors and min(
                abs(s[0] - d[0]) + abs(s[1] - d[1]) for d in doors) <= 7]
            if not near:
                break
            x, y = rng.choice(near)
            if area.mob_at(x, y):
                continue
            m = make_folk(self.world, cid, rng, i, x, y)
            area.folk.append(m)
            area.mobs.append(m)
        ax, ay = ARRIVE
        far = [s for s in ground if abs(s[0] - ax) + abs(s[1] - ay) > 14]
        for _ in range(spec["hostiles"]):
            if not far:
                break
            x, y = rng.choice(far)
            if area.mob_at(x, y):
                continue
            m = make_monster(rng.choice(spec["danger"]), x, y, rng=rng)
            area.mobs.append(m)

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        self.sound.play(sound)
        self.layout()
        self.save()

    def go_outside(self):
        """Out of a building, onto its doorstep."""
        cid = self.area.city or self.city
        city = self.get_area(("city", cid))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.enter(city, self.city_pos.get(cid) or city.start)
        self.say("You step out into %s." % district(cid, *self.pos), "info")

    def enter_link(self, link, x, y):
        kind = link[0]
        if kind == "bld":
            self.city_pos[self.city] = list(self.pos)
            area = self.get_area(link)
            self.say("You go into %s." % area.name, "info")
            self.enter(area, area.start)
            self.on_entering(area)
            return
        if kind == "lair":
            self.at_lair(link[1], x, y)

    def on_entering(self, area):
        if area.kind_of == "pen" and any(m.hostile for m in area.mobs):
            self.say("Chains, straw, and the smell of despair. A "
                     "slave-driver turns, whip in hand.", "bad")
        elif area.kind_of == "pen" and any(m.role == "captive"
                                           for m in area.mobs):
            self.say("The captives look up. Walk into them to set them "
                     "free.", "info")
        elif area.kind_of == "rebels":
            self.say("A hidden cellar: blankets, crates of stolen food, "
                     "and very sharp knives.", "info")

    def at_lair(self, cid, x, y):
        lair = LAIRS[cid]
        if cid == "washington" and "ward_open" not in self.flags:
            n = len(self.p["stones"])
            if n < 3:
                self.say("The Moon Ward blazes up as you come near: a cage "
                         "of cold blue light across the Dome's steps. "
                         "(%s)" % ("You carry %d Moonstone%s; it wants "
                                   "three." % (n, "" if n == 1 else "s")
                                   if n else "It wants three Moonstones."),
                         "bad")
                self.sound.play("spell")
                if not self.test("WIS", label="Wisdom, to stay back")[0]:
                    self.say("You touch it anyway. It burns!", "bad")
                    self.take_damage(roll("1d6"), "The ward")
                self.render()
                return
            self.flags.add("ward_open")
            self.area.grid[y][x] = "ward_open"
            self.sound.play("quest")
            self.say("The three Moonstones blaze in your pack, and the "
                     "Moon Ward opens like a flower. The way into the "
                     "Shattered Dome is clear.", "quest")
        self.open_menu("Go into %s?" % lair.name, [
            ("Yes, go in", lambda: self.descend(cid)),
            ("Not yet", lambda: None)])

    def descend(self, lid):
        if self.area.kind == "city":
            self.city_pos[self.city] = list(self.pos)
        self.surface = (self.area.key, list(self.pos))
        area = self.get_area(("dun", lid, 1))
        self.say("You go into %s." % LAIRS[lid].name, "info")
        if lid == "newyork":
            self.say("You climb through the hole into the broken tower. "
                     "Drums thud overhead.", "info")
        self.enter(area, area.start, "stairs")
        if not self.light_radius() or self.light_radius() <= 2:
            self.say("It's dark in here. (Light a torch: U.)", "info")

    def change_level(self, delta):
        _, lid, level = self.area.key
        up = LAIRS[lid].theme == "tower"
        if level + delta == 0:
            key, pos = self.surface
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dun"}
            area = self.get_area(tuple(key))
            self.say("You climb back out into the air.", "info")
            self.enter(area, pos, "stairs")
            return
        area = self.get_area(("dun", lid, level + delta))
        self.say("You climb %s to %s." % (
            ("up" if delta > 0 else "down") if up else
            ("down" if delta > 0 else "up"),
            area.name.split(", ")[-1]), "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        self.shell.log_add(text, tag)

    @staticmethod
    def the(mob):
        return mob.name if mob.boss or mob.role else "the " + mob.name

    def tally(self, key, n=1):
        self.tallies[key] = self.tallies.get(key, 0) + n

    def hear(self, text):
        """Words in CAPITALS are worth asking about."""
        for w in re.findall(r"\b[A-Z][A-Z'-]+(?: [A-Z][A-Z'-]+)*\b", text):
            if len(w) >= 3 and w.lower() not in ("bye", "job", "news",
                                                 "name"):
                self.topics.add(w.lower())

    # ── The rules ──

    def stat(self, s):
        p = self.p
        v = p["stats"][s]
        for stat_, n, until in p["temp"]:
            if stat_ == s and self.turn < until:
                v -= n
        return max(1, v)

    def off_armor(self):
        """Armor heavier than your class may wear: Disadvantage."""
        p = self.p
        rp = ARMOR[p["armor"]][0] if p["armor"] else 0
        return rp > CLASSES[p["cls"]]["armor"]

    def test(self, s, adv=0, label=None, quiet=False, penalty=0,
             physical=False):
        """Roll a d20 under a stat (Advantage: two dice, keep the lower;
        Disadvantage: keep the higher).  A 1 always succeeds, a 20 always
        fails.  Returns (success, the roll)."""
        p = self.p
        v = self.stat(s)
        if p["heighten"] > 0:
            p["heighten"] -= 1
            adv += 1
        if p["hungry"]:
            adv -= 1
        if self.turn < p["until"].get("fathead", -1):
            adv -= 1
        if physical and self.off_armor():
            adv -= 1
        if s == "INT" and p["cls"] == "Raptor":
            adv += 1
        adv = max(-1, min(1, adv))
        dice = [random.randint(1, 20) for _ in range(2 if adv else 1)]
        r = min(dice) if adv > 0 else max(dice)
        ok = r != 20 and (r == 1 or r + penalty < v)
        if not quiet:
            how = " with Advantage" if adv > 0 else \
                " with Disadvantage" if adv < 0 else ""
            rolled = " and ".join(str(d) for d in dice)
            self.say("[%s %d%s: %s%s, %s]" % (
                label or STAT_NAMES[s], v, how, rolled,
                " +%d" % penalty if penalty else "",
                "success" if ok else "failure"), "roll")
        return ok, r

    def luck(self):
        return random.randint(1, 6) >= 4

    def day(self):
        return self.turn // DAY + 1

    def used_today(self, what):
        return self.p["used"].get(what) == self.day()

    def use_today(self, what):
        self.p["used"][what] = self.day()

    def level_up(self, why):
        p = self.p
        if p["level"] >= MAX_LEVEL:
            p["destiny"] += 1
            self.say("%s A Destiny Point (%d)." % (why, p["destiny"]),
                     "gold")
            return
        p["level"] += 1
        c = CLASSES[p["cls"]]
        gain = max(1, roll("1d%d" % c["hd"]))
        p["maxhp"] += gain
        p["hp"] += gain
        p["destiny"] += 1
        up = []
        for s in STATS:
            st = p["stats"]
            if random.randint(1, 20) > st[s] or (
                    s in c["twice"] and random.randint(1, 20) > st[s]):
                st[s] += 1
                up.append(s)
        self.sound.play("level")
        self.say("%s You are now level %d! (+%d hit points%s, and a "
                 "Destiny Point.)" % (why, p["level"], gain,
                                      ", +1 " + ", +1 ".join(up)
                                      if up else ""), "quest")

    def damage_die(self):
        """Your damage: your class's die, one smaller with no weapon."""
        p = self.p
        d = CLASSES[p["cls"]]["dmg"]
        if p["melee"] == "Fists" and p["cls"] != "Robot":
            return {8: 6, 6: 4, 4: 1}.get(d, d)
        return d

    def in_class(self, weapon):
        allowed = CLASSES[self.p["cls"]]["weapons"]
        return allowed == ALL_WEAPONS or weapon in allowed or \
            weapon == "Fists"

    def armor_rp(self):
        p = self.p
        rp = ARMOR[p["armor"]][0] if p["armor"] else 0
        if p["cls"] == "Robot":
            rp += 1
        if self.turn < p["until"].get("ward", -1):
            rp += 2
        return rp

    # ── Time ──

    def clock(self):
        t = self.turn + START_HOUR * 60
        return t // DAY + 1, (t % DAY) // 60

    def date_text(self):
        t = self.turn + START_HOUR * 60
        h, m = (t % DAY) // 60, t % 60
        return "day %d, %d:%02d %s" % (t // DAY + 1, (h - 1) % 12 + 1, m,
                                       "am" if h < 12 else "pm")

    def phase(self):
        h = self.clock()[1]
        return ("night" if h >= 21 or h < 5 else "dawn" if h < 7 else
                "dusk" if h >= 19 else "day")

    def days_left(self):
        return max(0, DEADLINE - self.turn)

    def pass_time(self, minutes, quiet=False):
        """Time going by in a lump: resting, sleeping, the road."""
        before = self.phase()
        for _ in range(minutes):
            day = self.clock()[0]
            self.turn += 1
            if self.clock()[0] != day:
                self.new_day()
            self.timers()
            if self.turn >= DEADLINE and "won" not in self.flags:
                self.doom()
                return
        if not quiet and self.phase() != before:
            self.say("It is %s now: %s." % (self.phase(), self.date_text()),
                     "info")

    def new_day(self):
        p = self.p
        day = self.clock()[0]
        left = (DEADLINE - self.turn) // DAY
        if p["cls"] != "Robot":
            if p["usage"].get("rations"):
                self.use_up("rations", "You eat a ration")
                p["hungry"] = False
            else:
                if not p["hungry"]:
                    self.say("You've nothing to eat. Hungry: Disadvantage on "
                             "everything until you do.", "bad")
                p["hungry"] = True
        self.say("Day %d. The Red Shard %s." % (
            day, "rises tonight!" if left <= 0 else
            "will rise in %d days" % (left + 1) if left else
            "will rise tomorrow night"), "quest" if left < 4 else "info")

    def timers(self):
        """What wears off, minute by minute."""
        p = self.p
        if p["poison"]:
            p["poison"] -= 1
            if p["poison"] % 20 == 0 and p["hp"] > 1:
                p["hp"] -= 1
        if p["torch"] and getattr(self, "area", None) and self.area.dark:
            p["torch_turns"] += 1
            if p["torch_turns"] >= 60:
                p["torch_turns"] = 0
                if not self.use_up("torches", "Your torch gutters"):
                    p["torch"] = False
                elif not p["usage"].get("torches"):
                    p["torch"] = False
                    self.say("Your last torch burns out.", "bad")

    def use_up(self, item, text=None):
        """Roll an item's usage die after using it; False if there was
        none.  A 1 or 2 steps it down a die, and off a d4 it's gone."""
        p = self.p
        die = p["usage"].get(item, 0)
        if not die:
            return False
        r = random.randint(1, die)
        if r <= 2:
            new = usage_down(die)
            p["usage"][item] = new
            if new:
                self.say("%s. (%s: d%d down to d%d.)" % (
                    text or "You use some %s" % item, item, die, new),
                    "info")
            else:
                self.say("%s. That was the last of your %s." % (
                    text or "You use some %s" % item, item), "bad")
                if item in ("energy cells",) and \
                        self.p["cls"] == "Raptor" and \
                        not self.p["until"].get("juice", 0) > self.turn:
                    self.p["until"]["juice"] = self.turn + 60
                    self.p["usage"][item] = 4
                    self.say("You coax one more charge out of the dead "
                             "cells. (d4)", "good")
        return True

    # ── Turns ──

    def on_key(self, ev):
        k = ev.keysym
        if self.talk and k == "Escape":
            self.end_talk()
            return
        if self.talk or self.busy or ev.state & 0x0C:
            return
        self.walking = None
        if self.menu:
            k = k[3:] if k.startswith("KP_") else k
            if k in ("Up", "w", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "space", "KP_Enter"):
                self.menu_pick()
            elif k.isdigit() and 1 <= int(k) <= len(self.menu["items"]):
                self.menu_pick(int(k) - 1)
            elif not self.menu.get("locked"):
                self.menu_cancel()
            return
        if self.overlay:
            if self.overlay in ("won", "doom", "lost") and k in ("n", "N"):
                self.new_game()
            elif self.overlay not in ("won", "doom", "lost") or k in (
                    "Return", "space", "KP_Enter", "Escape"):
                self.close_overlay()
            return
        if self.aim:
            if k in MOVE_KEYS:
                self.aimed(*MOVE_KEYS[k])
            else:
                self.aim = None
                self.say("Never mind.", "info")
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("e", "E"):
            self.search()
        elif k in ("f", "F"):
            self.ready_fire()
        elif k in ("c", "C"):
            self.cast_menu()
        elif k in ("u", "U"):
            self.use_menu()
        elif k in ("z", "Z"):
            self.rest()
        elif k in ("space", "period", "KP_5"):
            self.wait()
        elif k in ("i", "I"):
            self.show_sheet()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def next_page(self):
        pages = getattr(self, "pages", None)
        if self.overlay in ("won", "doom", "lost") and pages and \
                self.page < len(pages) - 1:
            self.page += 1
            self.overlay_text = pages[self.page]
            self.render()
            return True
        return False

    def close_overlay(self):
        if self.next_page():
            return
        if self.overlay == "lost":
            self.new_game()
            return
        if self.overlay in ("won", "doom"):
            self.action_menu()
            return
        self.overlay = None
        self.render()

    def ready(self):
        return bool(getattr(self, "area", None)) and not (
            self.busy or self.talk or self.overlay or self.menu)

    def move(self, dx, dy):
        if not self.ready():
            return
        p, a = self.p, self.area
        if p["held"]:
            ok, _ = self.test("STR", label="Strength, breaking free",
                              physical=True)
            if ok:
                p["held"] = 0
                self.say("You tear yourself free!", "good")
            else:
                p["held"] -= 1
                self.say("You struggle, and stay stuck.", "bad")
                self.end_turn()
                return
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if a.kind == "inside":
                self.go_outside()
            elif a.kind == "city":
                self.travel_menu()
            else:
                self.bump()
            return
        mob = a.mob_at(x, y)
        if mob:
            if mob.hostile:
                self.attack(mob)
                self.end_turn()
            else:
                self.start_talk(mob)
            return
        t = a.grid[y][x]
        if t == "counter":
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return
        link = a.links.get((x, y))
        if link and (t in WALKABLE or t == "ward"):
            self.enter_link(link, x, y)
            return
        if (x, y) in a.landmark and t not in WALKABLE:
            label, desc = a.landmark[(x, y)]
            self.say(desc, "info")
            self.sound.play("bump")
            return
        if t not in WALKABLE:
            self.touch(t, x, y)
            return
        if (x, y) in a.traps:
            ok, _ = self.test("INT", label="Intelligence, watching your "
                              "step")
            if ok:
                a.traps.discard((x, y))
                a.items[(x, y)] = "trap"
                self.say("You spot a tripwire just in time.", "good")
                self.end_turn()
                return
        self.pos = [x, y]
        if t == "exit":
            self.go_outside()
            return
        if t == "stairs_down":
            self.change_level(1)
            return
        if t == "stairs_up":
            self.change_level(-1)
            return
        self.step_on(x, y)
        slow = self.underfoot(x, y)
        self.end_turn()
        if slow and not self.busy and not self.overlay:
            self.end_turn()

    def bump(self):
        self.say("Blocked.", "info")
        self.sound.play("bump")

    def underfoot(self, x, y):
        """Traps and hazards; True if wading (slow)."""
        a, p = self.area, self.p
        if (x, y) in a.traps:
            a.traps.discard((x, y))
            a.items[(x, y)] = "trap"
            self.say("Click. A trap!", "bad")
            self.flash(x, y)
            ok, _ = self.test("DEX", label="Dexterity, jumping clear",
                              physical=True)
            if not ok:
                self.take_damage(roll(HD_DAMAGE[min(4, 1 + self.p[
                    "level"] // 2)]), "The trap", armor=False)
            return False
        t = a.grid[y][x]
        if t == "glyph":
            if not self.test("WIS", label="Wisdom, against the glyph",
                             quiet=True)[0]:
                self.say("The glyph flares: golden sparks bite you.", "bad")
                self.take_damage(roll("1d4"), "The glyph", armor=False)
        elif t == "ooze":
            if p["cls"] != "Robot" and not self.test(
                    "CON", label="Constitution, against the ooze",
                    adv=1 if p["cls"] == "Barbarian" else 0)[0]:
                p["poison"] = max(p["poison"], 60)
                self.say("The ooze burns your skin. Poisoned!", "bad")
        elif t in ("pool", "bog"):
            return True
        elif t == "rubble_low":
            return random.random() < 0.3
        return False

    def step_on(self, x, y):
        a, p = self.area, self.p
        item = a.items.pop((x, y), None)
        if item is None:
            return
        if item == "coins":
            n = roll("2d6") * (2 if a.kind == "dungeon" else 1)
            p["coins"] += n
            self.sound.play("gold")
            self.say("Coins! (+%d)" % n, "gold")
        elif item == "salve":
            p["count"]["salve"] = p["count"].get("salve", 0) + 1
            self.say("A pot of healing salve.", "good")
        elif item == "food":
            p["usage"]["rations"] = max(8, p["usage"].get("rations", 0))
            self.say("Dried meat and hard biscuit. (Rations d%d.)" %
                     p["usage"]["rations"], "good")
        elif item == "torch":
            p["usage"]["torches"] = max(6, p["usage"].get("torches", 0))
            self.say("A bundle of torches. (d%d)" % p["usage"]["torches"],
                     "good")
        elif item == "ammo":
            self.find_ammo()
        elif item == "gear":
            n = roll("1d6") * 3
            p["coins"] += n
            self.say("Old-world gears and copper: worth %d coins to any "
                     "trader. You pocket them." % n, "gold")
        elif item == "note":
            text = getattr(a, "note", "")
            self.say(text, "mad")
            self.hear(text)
            if text and text not in self.notes:
                self.notes.append(text)
        elif item == "moonstone":
            lid = a.lead
            p["stones"].append(lid)
            self.flags.add("stone:" + lid)
            self.sound.play("quest")
            self.say("A Moonstone! It's cold in your hand and bright as "
                     "a little moon. (%d of 3)" % len(p["stones"]), "quest")
            self.level_up("You've beaten a warlord.")
            if len(p["stones"]) == 3:
                self.say("Three stones. The Moon Ward in Washington will "
                         "open for you now.", "quest")
            self.save()
        elif item in ("trap", "bones"):
            a.items[(x, y)] = item

    def find_ammo(self):
        p = self.p
        w = p["ranged"]
        ammo = WEAPONS[w].ammo if w else None
        ammo = ammo or random.choice(("arrows", "stones", "darts",
                                      "energy cells"))
        p["usage"][ammo] = max(8, p["usage"].get(ammo, 0))
        self.say("You find %s. (d%d)" % (ammo, p["usage"][ammo]), "good")

    def touch(self, t, x, y):
        a = self.area
        if (x, y) in a.loot:
            self.open_loot(x, y)
            return
        what = {"water": "Black water, and things moving under it.",
                "rubble": "A heap of broken concrete and rebar.",
                "wreck": "A rusted car, long since stripped.",
                "wreck2": "A rusted car, full of birds' nests.",
                "bus": "A bus, sunk on its axles. Someone lives in it.",
                "tree": "A tree, growing out of the road.",
                "tree_dead": "A dead tree, white as bone.",
                "bush": "A thicket of brambles and wild roses.",
                "lamp": "A rusted lamp post. No one remembers it lit.",
                "sign": "A green sign, its words long since rusted away.",
                "hydrant": "A red iron stump. Water once came out of it.",
                "campfire": "A fire, crackling. It's warm.",
                "tent": "A patched tent. Someone's home.",
                "palisade": "A wall of sharpened stakes.",
                "garden": "Beans, squash and tomatoes, carefully tended.",
                "forge": "The forge roars.",
                "cauldron": "Something green, bubbling. It smells of mint.",
                "bars": "Iron bars.", "throne": "A throne of gold.",
                "gate": "A gate.", "ward": "The Moon Ward.",
                "console": "Old machines, still blinking."}.get(t)
        if t.startswith("b_"):
            what = "A ruin, its doors long gone or bricked up."
        if what:
            self.say(what, "info")
        self.sound.play("bump")

    def open_loot(self, x, y):
        a, p = self.area, self.p
        a.loot.discard((x, y))
        key = a.key
        if a.kind == "dungeon":
            self.flags.add("loot:%s:%d:%d:%d" % (key[1], key[2], x, y))
            a.grid[y][x] = "rubble_low"
        else:
            self.flags.add("loot:%s:%s:%d:%d" % (key[1], key[2], x, y))
            a.grid[y][x] = "floor"
        self.sound.play("gold")
        r = random.random()
        bonus = 1 if p["cls"] == "Scavenger" else 0
        n = roll("2d10") * max(1, p["level"]) + bonus * roll("2d6")
        p["coins"] += n
        found = ["%d coins" % n]
        if r < 0.3:
            p["count"]["salve"] = p["count"].get("salve", 0) + 1
            found.append("a pot of salve")
        elif r < 0.5:
            self.find_ammo()
        elif r < 0.62:
            p["usage"]["torches"] = max(6, p["usage"].get("torches", 0))
            found.append("torches")
        elif r < 0.72 + 0.1 * bonus:
            w = random.choice(("Axe", "Sword", "Spear", "Mace", "Bow",
                               "Laser Pistol", "Old Rifle", "Laser Rifle"))
            if w not in p["weapons"]:
                p["weapons"].append(w)
                found.append(WEAPONS[w].desc)
        elif r < 0.8:
            arm = random.choice(("scrap mail", "riot armor", "large shield"))
            if arm in SHIELDS:
                if not p["shield"]:
                    p["shield"], p["shield_hits"] = arm, SHIELDS[arm][0]
                    found.append("a " + arm)
            elif arm not in p["armors"]:
                p["armors"].append(arm)
                found.append(arm)
        self.say("You break it open: %s." % ", ".join(found), "gold")
        self.end_turn()

    def end_turn(self):
        p, a = self.p, self.area
        before = self.phase()
        day = self.clock()[0]
        self.turn += 1
        if self.clock()[0] != day:
            self.new_day()
        self.timers()
        now = self.phase()
        if now != before and a.kind == "city":
            self.say({"dawn": "Grey dawn over the ruins of %s.",
                      "day": "The sun is up over %s.",
                      "dusk": "The sun goes down red over %s.",
                      "night": "Night in %s. The Red Shard climbs."}[now]
                     % CITIES[self.city]["name"], "info")
        if self.turn >= DEADLINE and "won" not in self.flags:
            self.doom()
            return
        if p["poison"] and p["hp"] <= 0:
            self.out_of_action("The poison")
            return
        self.render()
        for mob in list(a.mobs):
            if self.overlay or p["hp"] <= 0 or self.area is not a:
                return
            if mob not in a.mobs:
                continue
            if mob.hostile:
                self.monster_act(mob)
            else:
                self.wander(mob)
        if a.kind == "city":
            self.spawn_city()
        self.render()

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        traits = ENEMIES[mob.kind].traits if mob.kind else ""
        if t in WATER:
            return "swim" in traits
        if a.kind == "city":
            return t in CITY_GROUND and (x, y) not in a.links
        if a.kind == "inside":
            return t in INSIDE_FLOOR
        if t == "pool":
            return True
        return t in DUNGEON_FLOOR or t == "glyph"

    def monster_act(self, mob):
        e = ENEMIES[mob.kind]
        if mob.asleep:
            px, py = self.pos
            if abs(mob.x - px) + abs(mob.y - py) <= 1 and random.random() < \
                    0.3:
                mob.asleep = 0
            else:
                mob.asleep -= 1
                return
            if not mob.asleep:
                self.say("%s wakes up." % cap(self.the(mob)), "bad")
                mob.aware = True
            return
        if mob.stun:
            mob.stun -= 1
            return
        if "slow" in e.traits and self.turn % 2:
            return
        steps = 2 if "fast" in e.traits else 1
        for _ in range(steps):
            if mob not in self.area.mobs or self.p["hp"] <= 0 or \
                    self.overlay:
                return
            if self.monster_step(mob, e):
                return

    def monster_step(self, mob, e):
        """One move; True if it attacked (and so is done)."""
        a = self.area
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if not mob.aware:
            sneaky = self.p["cls"] in SNEAKY
            if dist <= 1 or ((mob.x, mob.y) in self.visible and dist <= 8 and
                             random.random() < (0.35 if sneaky else 0.6)):
                mob.aware = True
                if mob.boss:
                    self.boss_cry(mob)
            else:
                self.drift(mob)
                return False
        if ("coward" in e.traits and mob.hp < mob.maxhp) or mob.flee:
            mob.flee = max(0, mob.flee - 1)
            for sx, sy in sorted(DIRS, key=lambda d: -abs(px - mob.x - d[0])
                                 - abs(py - mob.y - d[1])):
                if self.can_go(mob, mob.x + sx, mob.y + sy):
                    mob.x += sx
                    mob.y += sy
                    break
            return False
        if dist == 1:
            self.monster_attack(mob, ranged=False)
            return True
        if ("ranged" in e.traits and (dx == 0 or dy == 0) and dist <= 7 and
                self.line_clear(a, mob.x, mob.y, px, py) and
                random.random() < 0.5):
            self.fly(self.line_path((mob.x, mob.y), (px, py)),
                     {"slinger": "stone", "apearcher": "spear",
                      "trash": "junk", "gearwitch": "lightning",
                      "malgorath": "goldfire"}.get(mob.kind, "bolt"))
            self.monster_attack(mob, ranged=True)
            return True
        order = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                       abs(py - mob.y - d[1]) + random.random() * 0.5) \
            if dist <= 16 else [random.choice(DIRS)]
        for sx, sy in order[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break
        return False

    def boss_cry(self, mob):
        cry = {"apeking": "Gorrak beats his chest and roars: 'TINY THING! "
                          "GORRAK WILL WEAR YOUR SKULL AS A HAT!'",
               "gearwitch": "Iron Mabel's voice crackles from a dozen "
                            "speakers: 'Organic. How untidy. Hold still "
                            "while I improve you.'",
               "crabbaron": "The Crab Baron rises from the red pool, "
                            "clacking: 'Another snack walks into my "
                            "larder!'",
               "malgorath": "Malgorath rises from his throne, golden fire "
                            "in his hands: 'You have brought me my stones. "
                            "How thoughtful. Kneel.'"}.get(mob.kind)
        if cry:
            self.say(cry, "mad")
            self.sound.play("horror" if mob.kind == "malgorath" else "fire")

    def drift(self, mob):
        if random.random() < 0.3:
            sx, sy = random.choice(DIRS)
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy

    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        a = self.area
        if (a.inside(x, y) and a.grid[y][x] in mob.roam
                and not a.mob_at(x, y) and [x, y] != self.pos
                and not any((x + ex, y + ey) in a.links for ex, ey in DIRS)
                and (mob.home is None or abs(x - mob.home[0]) +
                     abs(y - mob.home[1]) <= 5)):
            mob.x, mob.y = x, y

    def spawn_city(self):
        """At night the ruins send out their hunters."""
        a = self.area
        cid = self.city
        px, py = self.pos
        a.mobs = [m for m in a.mobs if not m.hostile or m.boss or
                  abs(m.x - px) + abs(m.y - py) <= 26]
        rate = 0.04 if self.phase() == "night" else 0.008
        if cid == "phila":
            rate /= 3
        if random.random() > rate:
            return
        if sum(m.hostile for m in a.mobs) >= 3 + self.day() // 4:
            return
        kinds = CITIES[cid]["danger"]
        for _ in range(20):
            x = px + random.randint(-12, 12)
            y = py + random.randint(-12, 12)
            if (not a.inside(x, y) or a.grid[y][x] not in CITY_GROUND
                    or (x, y) in self.visible or a.mob_at(x, y)
                    or abs(x - px) + abs(y - py) < 8):
                continue
            a.mobs.append(make_monster(random.choice(kinds), x, y))
            return

    # ── Fighting ──

    def powerful(self, mob):
        return mob.hd >= self.p["level"] + 2

    def attack(self, mob, free=False, ranged=False):
        """Your blow (or shot) at a foe: a STR test, or DEX for a shot."""
        p = self.p
        wname = p["ranged"] if ranged else p["melee"]
        w = WEAPONS[wname]
        e = ENEMIES[mob.kind]
        unready = not mob.aware or mob.asleep or mob.stun
        adv = 0
        if unready and p["cls"] in SNEAKY | {"Raptor"}:
            adv += 1
        if mob.asleep or mob.stun:
            adv += 1
        if not self.in_class(wname):
            adv -= 1
        if self.powerful(mob):
            adv -= 1
        if ranged and abs(mob.x - self.pos[0]) + abs(mob.y - self.pos[1]) \
                <= 1:
            adv -= 1
        ok, r = self.test("DEX" if ranged else "STR", adv,
                          label="%s, %s" % ("Dexterity" if ranged
                                            else "Strength",
                                            "shooting" if ranged
                                            else "attacking"),
                          penalty=2 if w.twohand else 0, physical=True)
        mob.aware = True
        if not ok:
            if r == 20:
                p["held"] = 1
                self.say("You fumble and stumble: you'll lose a moment "
                         "getting your feet back.", "bad")
            else:
                self.say("You %s %s, and miss." % (
                    "shoot at" if ranged else "swing at", self.the(mob)),
                    "info")
            self.sound.play("miss")
            return
        if unready and p["cls"] == "Scavenger":
            dmg = roll("2d6") + p["level"]
            self.say("From the shadows!", "good")
        else:
            dmg = roll("1d%d" % self.damage_die()) if self.damage_die() > 1 \
                else 1
        if w.twohand:
            dmg += 2
        if r == 1:
            dmg *= 2
            self.say("A critical blow!", "good")
        self.harm(mob, dmg, "You hit %s" % self.the(mob), weapon=True)

    def harm(self, mob, dmg, text, weapon=True, magic=False):
        e = ENEMIES[mob.kind]
        mob.aware = True
        mob.asleep = 0
        if not magic:
            dmg = max(0, dmg - e.armor)
        if "resist" in e.traits and not magic:
            dmg //= 2
        self.flash(mob.x, mob.y)
        if dmg <= 0:
            self.say(text + ", but it glances off.", "info")
            self.sound.play("miss")
            return
        if "mook" in e.traits:
            mob.hp = 0
        else:
            mob.hp -= dmg
        if mob.hp <= 0:
            self.say("%s: %d damage." % (text, dmg), "good")
            self.down(mob)
            return
        self.sound.play("hit")
        self.say("%s: %d damage%s." % (
            text, dmg, ", and it's badly hurt" if mob.hp <= mob.maxhp // 3
            else ""), "good")

    def down(self, mob):
        a = self.area
        e = ENEMIES[mob.kind]
        self.tally("foes")
        self.sound.play("kill")
        if mob in a.mobs:
            a.mobs.remove(mob)
        if mob.kind == "malgorath":
            self.flags.add("won")
            self.say("Malgorath the Gilded screams, and the gold runs off "
                     "him like wax. Far above, the Red Shard flickers, and "
                     "fades to a dull ember.", "quest")
            self.sound.play("quest")
            self.save()
            self.shell.after(1200, self.show_won)
            return
        self.say("%s %s." % (cap(self.the(mob)),
                             "falls apart in a shower of sparks"
                             if "robot" in e.traits else
                             "crumbles to dust" if "undead" in e.traits
                             else "is dead"), "good")
        if mob.stone:
            a.items[(mob.x, mob.y)] = "moonstone"
            self.flags.add("boss:" + mob.stone)
            self.say("Something rolls from the warlord's grip, glowing: a "
                     "Moonstone!", "gold")
        elif "human" in e.traits and (mob.x, mob.y) not in a.items and \
                random.random() < 0.5:
            a.items[(mob.x, mob.y)] = "coins"
        if a.kind_of == "pen" and not any(m.hostile for m in a.mobs):
            self.flags.add("pen_won:" + a.city)
            self.say("The pen is yours. The captives stare at you, not "
                     "daring to hope. (Walk into them.)", "quest")

    def monster_attack(self, mob, ranged=False):
        """A foe's attack: you test STR (in melee) or DEX (a shot) to get
        out of the way."""
        p = self.p
        e = ENEMIES[mob.kind]
        name = cap(self.the(mob))
        adv = 0
        if self.powerful(mob):
            adv -= 1
        if p["cls"] == "Urchin" and mob.hd >= 3:
            adv += 1
        stat = "DEX" if ranged else "STR"
        ok, r = self.test(stat, adv, label="%s, %s" % (
            STAT_NAMES[stat], "dodging" if ranged else "blocking"),
            physical=True)
        if not ok and self.destiny_auto and p["destiny"] > 0 and \
                p["hp"] <= roll(HD_DAMAGE[min(10, mob.hd)]) + 1:
            p["destiny"] -= 1
            self.say("Destiny! You roll again. (%d left)" % p["destiny"],
                     "gold")
            ok, r = self.test(stat, adv, label="%s, again" %
                              STAT_NAMES[stat], physical=True)
        if ok:
            self.say("%s %s with %s; you %s." % (
                name, "shoots at you" if ranged else "comes at you",
                e.weapon, "duck" if ranged else "turn it aside"), "info")
            self.sound.play("miss")
            if r == 1 and not ranged:
                self.say("An opening! You strike back.", "good")
                self.attack(mob, free=True)
            return
        dmg = roll(HD_DAMAGE[min(10, mob.hd)])
        if r == 20:
            dmg *= 2
            self.say("A terrible blow!", "bad")
        if "shock" in e.traits and p["cls"] == "Robot":
            dmg *= 2
            self.say("Lightning! Your circuits scream.", "bad")
        self.take_damage(dmg, "%s, with %s" % (name, e.weapon),
                         armor=mob.kind != "malgorath")
        if p["hp"] <= 0:
            return
        if "venom" in e.traits and p["cls"] != "Robot":
            if not self.test("CON", 1 if p["cls"] == "Barbarian" else 0,
                             label="Constitution, against the venom")[0]:
                p["poison"] = max(p["poison"], 120)
                self.say("Venom burns in your veins. Poisoned!", "bad")
        if "grab" in e.traits and not p["held"]:
            p["held"] = 2
            self.say("%s grabs you and holds on!" % name, "bad")

    def take_damage(self, dmg, text, armor=True):
        p = self.p
        rp = self.armor_rp() if armor else 0
        dmg = max(0, dmg - rp)
        if dmg >= 4 and p["shield"] and armor:
            p["shield_hits"] -= 1
            self.say("%s: your %s takes the blow%s!" % (
                text, p["shield"], " and shatters" if p["shield_hits"] <= 0
                else ""), "info")
            if p["shield_hits"] <= 0:
                p["shield"] = None
            return
        if self.turn < p["until"].get("hide", -1):
            dmg = (dmg + 1) // 2
        if dmg <= 0:
            self.say("%s: your armor takes it." % text, "info")
            return
        self.flash(*self.pos)
        self.sound.play("hurt")
        p["hp"] -= dmg
        self.say("%s: %d damage!%s" % (text, dmg, " (%d left)" % p["hp"]
                                       if p["hp"] > 0 else ""), "bad")
        if p["cls"] == "Beastman" and 0 < p["hp"] <= p["maxhp"] // 2 and \
                not self.used_today("hide"):
            self.use_today("hide")
            p["until"]["hide"] = self.turn + p["level"] + 4
            self.say("Your hide thickens like bark. (Thick Hide: half "
                     "damage for a while.)", "good")
        if p["hp"] <= 0:
            self.out_of_action(text)

    def out_of_action(self, text):
        """At zero hit points: roll on the Out of Action table."""
        p = self.p
        p["hp"] = 0
        self.walking = None
        self.aim = None
        self.flights = []
        self.say("You go down...", "bad")
        self.sound.play("death")
        r = random.randint(1, 10)
        self.say("[Out of Action: %d. %s]" % (r, OOFA[r]), "roll")
        if r >= 6 and p["destiny"] > 0 and self.destiny_auto:
            p["destiny"] -= 1
            r = random.randint(1, 10)
            self.say("Destiny! You roll again: %d. %s" % (r, OOFA[r]),
                     "gold")
        if r == 10:
            self.hero_dead(text)
            return
        day = self.turn + DAY
        if r == 3:
            p["until"]["fathead"] = self.turn + 60
        elif r == 4:
            p["temp"] += [[s, 2, day] for s in ("STR", "DEX", "CON")]
        elif r == 5:
            p["temp"] += [[s, 2, day] for s in ("INT", "WIS")]
        elif r in (6, 7, 8, 9):
            s = {6: random.choice(("STR", "DEX")),
                 7: random.choice(("INT", "WIS")), 8: "CHA", 9: "DEX"}[r]
            p["stats"][s] = max(3, p["stats"][s] - 2)
        p["temp"] = [t for t in p["temp"] if t[2] > self.turn]
        p["hp"] = roll("1d4")
        p["held"] = 0
        p["poison"] = 0
        lost = p["coins"] // 2
        p["coins"] -= lost
        a = self.area
        if a.kind == "dungeon":
            pos = a.start
            where_ = "near the way in"
        elif a.kind == "city" and self.city == "phila":
            a = self.get_area(("bld", "phila", "healer"))
            pos = a.start
            where_ = "in the House of Mending"
        else:
            pos = a.start
            where_ = "where someone dragged you"
        for m in self.area.mobs:
            if m.hostile:
                m.aware = False
        self.pass_time(120, quiet=True)
        if self.overlay:
            return
        self.say("You come to %s, two hours later, with %d hit point%s%s." %
                 (where_, p["hp"], "" if p["hp"] == 1 else "s",
                  " and lighter by %d coin%s" % (lost, "" if lost == 1
                                                  else "s")
                  if lost else ""), "bad")
        self.enter(a, pos, "stairs")

    def hero_dead(self, text):
        p = self.p
        self.tally("deaths")
        self.overlay = "lost"
        stones = len(p["stones"])
        self.pages = ["\n".join([
            "THE END OF %s" % p["name"].upper(), "",
            "\n".join(wrap("%s, the %s, fell in %s on %s, cut down by %s." % (
                p["name"], p["cls"].lower(), self.area.name,
                self.date_text(), text.split(",")[0].lower()), 52)), "",
            "\n".join(wrap("%s Moonstone%s won, %d slave pen%s broken, %d "
                           "foes laid low. The Free Hold will sing about "
                           "you, a little." % (
                               stones or "No", "" if stones == 1 else "s",
                               sum(1 for f in self.flags
                                   if f.startswith("freed:")),
                               "" if sum(1 for f in self.flags
                                         if f.startswith("freed:")) == 1
                               else "s", self.tallies.get("foes", 0)),
                           52)),
            "", "Press any key to begin a new legend."])]
        self.page = 0
        self.overlay_text = self.pages[0]
        try:
            os.remove(SAVE_FILE)
        except OSError:
            pass
        self.render()

    # ── Firing ──

    def ready_fire(self):
        if not self.ready():
            return
        p = self.p
        w = p["ranged"]
        if not w:
            self.say("You've nothing to shoot with. (Wield a bow, sling, "
                     "blowgun or gun: U.)", "info")
            return
        ammo = WEAPONS[w].ammo
        if not p["usage"].get(ammo):
            self.say("You're out of %s." % ammo, "bad")
            return
        self.aim = ("fire",)
        self.say("Fire %s which way? (a direction; anything else to "
                 "cancel)" % WEAPONS[w].desc, "you")

    def aimed(self, dx, dy):
        what = self.aim
        self.aim = None
        if what[0] == "fire":
            self.fire(dx, dy)
        elif what[0] == "firebolt":
            self.firebolt(dx, dy)

    def target_in_line(self, dx, dy, reach):
        a = self.area
        x, y = self.pos
        path = []
        for _ in range(reach):
            x, y = x + dx, y + dy
            if not a.inside(x, y) or (a.grid[y][x] not in WALKABLE and
                                      a.grid[y][x] not in WATER and
                                      a.grid[y][x] != "pool"):
                break
            path.append((x, y))
            mob = a.mob_at(x, y)
            if mob and mob.hostile:
                return mob, path
        return None, path

    def fire(self, dx, dy):
        p = self.p
        w = p["ranged"]
        ammo = WEAPONS[w].ammo
        mob, path = self.target_in_line(dx, dy, 8)
        self.sound.play("shot" if ammo in ("energy cells", "rifle rounds")
                        else "throw")
        self.fly(path, MISSILE[ammo])
        if mob is None:
            self.say("You shoot, and hit nothing.", "info")
        else:
            self.attack(mob, ranged=True)
        self.use_up(ammo, "You reach for more %s" % ammo)
        self.end_turn()

    def fly(self, path, tile):
        """A missile crossing the squares between: drawn a square every
        25 ms, one after another, while the game goes on."""
        self.flights.append((list(path[:12]), tile))
        if len(self.flights) == 1:
            self.fly_step()

    def fly_step(self):
        while self.flights and not self.flights[0][0]:
            self.flights.pop(0)
        if not self.flights:
            self.screen.sprite("missile", 0, 0, None)
            return
        path, tile = self.flights[0]
        x, y = path.pop(0)
        cols, rows, ox, oy, ts = self.view
        i = x - self.pos[0] + cols // 2
        j = y - self.pos[1] + rows // 2
        if 0 <= i < cols and 0 <= j < rows:
            self.screen.sprite("missile", ox + i * ts, oy + j * ts, tile)
        self.shell.after(25, self.fly_step)

    @staticmethod
    def line_path(a, b):
        (x0, y0), (x1, y1) = a, b
        n = max(abs(x1 - x0), abs(y1 - y0))
        return [(x0 + round((x1 - x0) * k / n), y0 + round((y1 - y0) * k / n))
                for k in range(1, n + 1)] if n else []

    # ── Spells and miracles ──

    def cast_menu(self):
        if not self.ready():
            return
        p = self.p
        if p["cls"] == "Sorcerer":
            if self.turn < p["until"].get("burnt", -1):
                self.say("The magic is burnt out of you until tomorrow.",
                         "bad")
                return
            items = [("%s: %s" % (s, d), lambda s=s: self.cast(s))
                     for s, d in SPELLS.items()]
            self.open_menu("Cast a spell (an Intelligence test)",
                           items + [("Nothing", lambda: None)])
        elif p["cls"] == "Death Priest":
            left = self.miracles_left()
            if not left:
                self.say("The dead are silent. No more miracles today.",
                         "info")
                return
            items = [("%s: %s" % (s, d), lambda s=s: self.miracle(s))
                     for s, d in MIRACLES.items()]
            self.open_menu("Call a miracle (%d left today)" % left,
                           items + [("Nothing", lambda: None)])
        else:
            self.say("You've no magic. Your %s will have to do." %
                     WEAPONS[p["melee"]].desc.split()[-1], "info")

    def miracles_left(self):
        p = self.p
        n = 2 + (p["level"] - 1) // 2
        used = p["used"].get("miracles", [0, 0])
        if used[0] != self.day():
            used = [self.day(), 0]
        return max(0, n - used[1])

    def spend_miracle(self):
        used = self.p["used"].get("miracles", [0, 0])
        if used[0] != self.day():
            used = [self.day(), 0]
        used[1] += 1
        self.p["used"]["miracles"] = used

    def cast(self, spell):
        p = self.p
        ok, r = self.test("INT", label="Intelligence, casting %s" % spell)
        self.sound.play("spell")
        if not ok:
            if r == 20:
                p["until"]["burnt"] = self.turn + DAY
                self.say("The spell twists in your hands and burns the "
                         "magic out of you for a day!", "bad")
            else:
                self.say("The words come out wrong. Nothing happens.",
                         "info")
            self.end_turn()
            return
        if spell == "Firebolt":
            self.aim = ("firebolt",)
            self.say("Firebolt: which way?", "you")
            return
        if spell == "Sleep":
            n = 0
            for m in list(self.area.mobs):
                if m.hostile and (m.x, m.y) in self.visible and \
                        abs(m.x - self.pos[0]) + abs(m.y - self.pos[1]) <= 4 \
                        and m.hd < p["level"] + 3 and not m.boss and \
                        not {"undead", "robot"} & set(
                            ENEMIES[m.kind].traits.split()):
                    m.asleep = 20 + roll("1d6") * p["level"]
                    n += 1
            self.say("A grey mist rolls out. %s" % (
                "%d foe%s nod%s off." % (n, "" if n == 1 else "s",
                                         "s" if n == 1 else "")
                if n else "Nothing close by is sleepy enough."), "good")
        elif spell == "Ward":
            p["until"]["ward"] = self.turn + 60
            self.say("A shimmering ward wraps you. (Soaks 2 more for an "
                     "hour.)", "good")
        elif spell == "Mend":
            self.heal(roll("1d6") + p["level"], "Your wounds knit")
        self.end_turn()

    def firebolt(self, dx, dy):
        mob, path = self.target_in_line(dx, dy, 8)
        self.fly(path, "firebolt")
        self.sound.play("fire")
        if mob is None:
            self.say("The firebolt splashes against the wall.", "info")
        else:
            self.harm(mob, roll("2d6") + self.p["level"],
                      "Moonfire engulfs %s" % self.the(mob), magic=True)
        self.end_turn()

    def miracle(self, name):
        p = self.p
        self.spend_miracle()
        self.sound.play("chant")
        if name == "Heal":
            hd = CLASSES[p["cls"]]["hd"]
            self.heal(roll("2d%d" % hd), "The dead lend you their strength")
        elif name == "Heighten":
            p["heighten"] = 3
            self.say("The whispers sharpen your senses. (Advantage on your "
                     "next three tests.)", "good")
        elif name == "Banish":
            ok, _ = self.test("WIS", label="Wisdom, banishing")
            n = 0
            for m in list(self.area.mobs):
                if m.hostile and "undead" in ENEMIES[m.kind].traits and \
                        abs(m.x - self.pos[0]) + abs(m.y - self.pos[1]) <= 6:
                    n += 1
                    if ok and m.hd <= p["level"] + 2:
                        self.say("%s crumbles to dust!" % cap(self.the(m)),
                                 "good")
                        self.down(m)
                    else:
                        m.flee = 10
            if not n:
                self.say("There are no restless dead here to banish.",
                         "info")
            elif not ok:
                self.say("The dead shrink back from you.", "info")
        elif name == "Deathsight":
            p["until"]["deathsight"] = self.turn + 60
            self.say("Your eyes cloud over grey; the dark is no darker "
                     "than dusk. (An hour.)", "good")
        self.end_turn()

    def heal(self, n, text):
        p = self.p
        before = p["hp"]
        p["hp"] = min(p["maxhp"], p["hp"] + n)
        self.sound.play("potion")
        self.say("%s. (+%d: %d of %d)" % (text, p["hp"] - before, p["hp"],
                                         p["maxhp"]), "good")

    # ── Things ──

    def use_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        if p["count"].get("salve"):
            items.append(("Rub on healing salve (%d)" % p["count"]["salve"],
                          self.use_salve))
        if p["count"].get("antidote") and p["poison"]:
            items.append(("Drink antivenom (%d)" % p["count"]["antidote"],
                          self.use_antidote))
        if p["usage"].get("rations") and p["hungry"]:
            items.append(("Eat a ration", self.eat))
        if p["torch"]:
            items.append(("Put out your torch", self.torch_off))
        elif p["usage"].get("torches"):
            items.append(("Light a torch (d%d)" % p["usage"]["torches"],
                          self.torch_on))
        for w in p["weapons"]:
            if w not in (p["melee"], p["ranged"]):
                items.append(("Wield %s%s" % (
                    WEAPONS[w].desc, "" if self.in_class(w) else
                    " (not your class's: Disadvantage)"),
                    lambda w=w: self.wield(w)))
        if p["melee"] != "Fists" and p["cls"] not in ("Beastman", "Raptor"):
            pass
        for arm in p["armors"]:
            if arm != p["armor"]:
                heavy = ARMOR[arm][0] > CLASSES[p["cls"]]["armor"]
                items.append(("Wear %s%s" % (arm, " (too heavy for you: "
                                             "Disadvantage)" if heavy
                                             else ""),
                              lambda arm=arm: self.wear(arm)))
        if p["armor"]:
            items.append(("Take off %s" % p["armor"], lambda: self.wear(None)))
        items.append(("Nothing", lambda: None))
        self.open_menu("Use what?", items)

    def use_salve(self):
        p = self.p
        p["count"]["salve"] -= 1
        self.heal(roll("1d6") + 2, "The salve stings, then soothes")
        self.end_turn()

    def use_antidote(self):
        p = self.p
        p["count"]["antidote"] -= 1
        p["poison"] = 0
        self.say("The antivenom tastes of copper. The burning fades.",
                 "good")
        self.end_turn()

    def eat(self):
        p = self.p
        self.use_up("rations", "You eat")
        p["hungry"] = False
        self.say("That's better.", "good")
        self.end_turn()

    def torch_on(self):
        self.p["torch"] = True
        self.say("You light a torch.", "info")
        self.end_turn()

    def torch_off(self):
        self.p["torch"] = False
        self.say("You put out your torch.", "info")
        self.end_turn()

    def wield(self, w):
        p = self.p
        if WEAPONS[w].ranged:
            p["ranged"] = w
        else:
            p["melee"] = w
        self.say("You ready %s." % WEAPONS[w].desc, "info")
        self.end_turn()

    def wear(self, arm):
        p = self.p
        if p["cls"] == "Robot" and arm:
            self.say("It doesn't fit over your plating.", "info")
            return
        p["armor"] = arm
        self.say("You %s." % ("put on the " + arm if arm
                              else "take off your armor"), "info")
        self.pass_time(10, quiet=True)
        self.render()

    def search(self):
        if not self.ready():
            return
        a = self.area
        p = self.p
        ok, _ = self.test("WIS", 1 if p["cls"] == "Scavenger" else 0,
                          label="Wisdom, searching")
        self.pass_time(9, quiet=True)
        found = False
        px, py = self.pos
        if ok:
            for (x, y), what in list(a.hidden.items()):
                if abs(x - px) <= 2 and abs(y - py) <= 2:
                    del a.hidden[(x, y)]
                    a.items[(x, y)] = what
                    found = True
            for x, y in list(a.traps):
                if abs(x - px) + abs(y - py) <= 4:
                    a.traps.discard((x, y))
                    a.items[(x, y)] = "trap"
                    self.say("A trap, %s." % where((px, py), (x, y)), "good")
                    found = True
        self.say("You find something!" if found else
                 "You search carefully, and find nothing.",
                 "good" if found else "info")
        self.end_turn()

    def rest(self):
        if not self.ready():
            return
        a = self.area
        p = self.p
        if any(m.hostile and ((m.x, m.y) in self.visible or
                              abs(m.x - self.pos[0]) + abs(m.y - self.pos[1])
                              <= 6) for m in a.mobs):
            self.say("Not with foes about.", "bad")
            return
        self.say("You sit with your back to a wall and rest an hour.",
                 "info")
        self.pass_time(60, quiet=True)
        if self.overlay:
            return
        if not self.used_today("rest"):
            self.use_today("rest")
            self.heal(roll("1d%d" % CLASSES[p["cls"]]["hd"]),
                      "The rest does you good")
        else:
            self.say("You've rested once today already; it doesn't help "
                     "much more.", "info")
        if p["cls"] == "Death Priest" and not self.used_today("recharge") \
                and self.miracles_left() == 0:
            self.use_today("recharge")
            if self.luck():
                used = p["used"].get("miracles", [self.day(), 0])
                used[1] = max(0, used[1] - 1)
                p["used"]["miracles"] = used
                self.say("The dead stir again: one more miracle today.",
                         "good")
        if a.kind != "inside" and random.randint(1, 6) == 1:
            self.ambush("Something found you while you rested!")
        self.render()

    def ambush(self, text, n=1):
        a = self.area
        kinds = LAIRS[a.lead].monsters if a.kind == "dungeon" else \
            CITIES[self.city]["danger"] if a.kind == "city" else None
        if not kinds:
            return
        px, py = self.pos
        placed = 0
        for _ in range(60):
            if placed >= n:
                break
            x = px + random.randint(-4, 4)
            y = py + random.randint(-4, 4)
            if abs(x - px) + abs(y - py) < 2 or not a.inside(x, y) or \
                    a.mob_at(x, y):
                continue
            t = a.grid[y][x]
            if t not in CITY_GROUND and t not in DUNGEON_FLOOR:
                continue
            m = make_monster(random.choice(kinds[:3]), x, y)
            m.aware = True
            a.mobs.append(m)
            placed += 1
        if placed:
            self.say(text, "bad")

    # ── The road ──

    def travel_menu(self):
        here = self.city
        items = []
        for cid in CITY_ORDER:
            if cid == here:
                continue
            days = flight_days(here, cid)
            if self.p["lizard"]:
                days = days / 2.0
            items.append(("%s, %s (%s)" % (
                CITIES[cid]["name"], CITIES[cid]["short"],
                "%g day%s %s" % (days, "" if days == 1 else "s",
                                 "riding" if self.p["lizard"]
                                 else "on foot")),
                lambda cid=cid: self.travel_to(cid)))
        items.append(("Stay in %s" % CITIES[here]["name"], lambda: None))
        self.open_menu("The road out of %s. Where to?" % CITIES[here]["name"],
                       items)

    def travel_to(self, cid):
        p = self.p
        frm = self.city
        days = flight_days(frm, cid)
        minutes = int(days * DAY / (2 if p["lizard"] else 1))
        self.city_pos[frm] = list(self.pos)
        self.say("You set out for %s%s." % (
            CITIES[cid]["name"], " on your lizard" if p["lizard"] else ""),
            "info")
        self.pass_time(minutes, quiet=True)
        if self.overlay:
            return
        self.city = cid
        self.cache = {k: v for k, v in self.cache.items()
                      if k[0] == "city"}
        city = self.get_area(("city", cid))
        self.enter(city, ARRIVE, "door")
        self.say("%s, %s." % (CITIES[cid]["name"], self.date_text()),
                 "quest")
        if "been:" + cid not in self.flags:
            self.flags.add("been:" + cid)
            self.say(CITIES[cid]["intro"], "info")
            tip = {"newyork": "The Tinkers' Camp is in the south-west "
                              "blocks: free folk.",
                   "boston": "The Bell-ringers' hall is in the north: free "
                             "folk.",
                   "baltimore": "The fishers' camp is in the middle of "
                                "town: free folk.",
                   "washington": "Rebels hide in a cellar in the south-west "
                                 "blocks. Find them."}.get(cid)
            if tip:
                self.say(tip, "talk")
        if cid != "phila" and random.random() < min(0.8, 0.3 * days):
            self.ambush("Ambush! %s followed you in off the road." %
                        cap(ENEMIES[CITIES[cid]["danger"][0]].name + "s"),
                        n=random.randint(1, 2))

    # ── Talking ──

    def start_talk(self, mob):
        if mob.role == "captive":
            self.free_captives(mob)
            return
        self.talk = {"mob": mob}
        self.shell.show_entry(focus=not ANDROID)
        self.say("%s (%s): %s" % (mob.name, mob.title, mob.greet), "talk")
        self.hear(mob.greet)
        if mob.role == "elder":
            self.elder_turns(mob)
        self.talk_menu()

    def talk_menu(self):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        items = [("Name", lambda: self.converse("name")),
                 ("Job", lambda: self.converse("job")),
                 ("News", lambda: self.converse("news"))]
        if mob.shop:
            items.append(("Trade", lambda: self.converse("trade")))
        if mob.role == "healer":
            items.append(("Heal me", lambda: self.converse("heal")))
        if mob.role == "innkeep":
            items.append(("A bed for the night", lambda: self.converse(
                "sleep")))
        known = [k for k in mob.talk if k not in ("job", "news")]
        for k in sorted(self.topics):
            if k in known:
                items.append((k.upper(), lambda k=k: self.converse(k)))
        items.append(("Bye", self.end_talk))
        self.open_menu("%s (type a word, or choose)" % mob.name, items,
                       cancel=self.end_talk)

    def converse(self, word):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        w = word.strip().lower()
        self.say("> %s" % (w or "bye"), "you")
        if w in ("", "bye", "farewell"):
            self.end_talk()
            return
        if w == "name":
            self.npc_say(mob, "I'm %s." % mob.name)
        elif w.startswith(("trad", "buy", "shop")) and mob.shop:
            self.shop_menu(mob)
            return
        elif w.startswith("heal") and mob.role == "healer":
            self.healer(mob)
            return
        elif w.startswith(("slee", "bed", "room")) and \
                mob.role == "innkeep":
            self.sleep_inn(mob)
            return
        else:
            text = None
            for k, v in mob.talk.items():
                if w == k or (len(w) >= 4 and k.startswith(w[:4])) or \
                        (len(w) >= 4 and w.startswith(k[:4])):
                    text = v
                    break
            if text is None:
                text = random.choice(("Never heard of it.",
                                      "Can't help you there.",
                                      "Ask someone else.",
                                      "Hm? No idea."))
            self.npc_say(mob, text)
        self.talk_menu()

    def npc_say(self, mob, text):
        self.say("%s: %s" % (mob.name, text), "talk")
        self.hear(text)

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.shell.hide_entry()
        if getattr(self, "p", None) and getattr(self, "area", None):
            self.render()

    def on_entry(self, ev=None):
        text = self.shell.take_entry().strip()
        if not self.talk:
            return
        self.menu = None
        self.converse(text)

    def elder_turns(self, mob):
        """What the Elder has to say about how you're doing."""
        p = self.p
        n = len(p["stones"])
        freed = sum(1 for f in self.flags if f.startswith("freed:"))
        if "met_elder" not in self.flags:
            self.flags.add("met_elder")
            self.npc_say(mob, "You're the one who broke the chain on the "
                              "Baltimore road, and walked here with it "
                              "still on. Good. I need someone stubborn. "
                              "Ask me about the SORCERER.")
            self.npc_say(mob, "And take this: the Hold's gift to the "
                              "free.")
            p["coins"] += 20
            p["count"]["salve"] = p["count"].get("salve", 0) + 1
            self.say("(+20 coins and a pot of salve.)", "gold")
            return
        if freed >= 2 and "pens_reward" not in self.flags:
            self.flags.add("pens_reward")
            self.npc_say(mob, "The people you freed are here, every one. "
                              "They rang the bell till the rope broke. "
                              "The Hold owes you.")
            self.level_up("The Hold honors you.")
        if n == 3 and "told_three" not in self.flags:
            self.flags.add("told_three")
            self.npc_say(mob, "Three stones. I never thought to see it. "
                              "Go to Washington. Walk into the Moon Ward "
                              "with them, and end him.")
        elif n:
            self.npc_say(mob, "%d stone%s. %d to go. The Shard won't wait." %
                         (n, "" if n == 1 else "s", 3 - n))

    def free_captives(self, mob):
        a = self.area
        if any(m.hostile for m in a.mobs):
            self.say("%s: 'Behind you!'" % mob.name, "talk")
            return
        captives = [m for m in a.mobs if m.role == "captive"]
        for m in captives:
            a.mobs.remove(m)
        cid = a.city
        self.flags.add("freed:" + cid)
        self.tally("freed", len(captives))
        self.sound.play("quest")
        self.say("You break the chains. %d people stumble out into the "
                 "light. They're heading for the Free Hold, they tell you, "
                 "and the bell." % len(captives), "quest")
        n = roll("2d6") + 5
        self.p["coins"] += n
        self.say("One presses a purse into your hand: everything they'd "
                 "hidden from the slavers. (+%d coins)" % n, "gold")
        freed = sum(1 for f in self.flags if f.startswith("freed:"))
        if freed >= 2 and "pens_reward" not in self.flags:
            self.say("(The Elder will want to hear about this.)", "info")
        self.save()
        self.render()

    # ── Shops ──

    def price(self, base, mob):
        haggled = self.talk and self.talk.get("haggled")
        return max(1, int(base * (0.75 if haggled else 1.0) *
                          (1.25 if self.p["cls"] == "Robot" else 1)))

    def shop_menu(self, mob):
        p = self.p
        items = []
        for kind, what in SHOP_STOCK[mob.shop]:
            if kind == "weapon":
                cost = WEAPONS[what].cost
                if what in p["weapons"]:
                    continue
                label = "%s (%s)" % (what, "fine" if self.in_class(what)
                                     else "not your class's")
            elif kind == "armor":
                cost = ARMOR[what][1]
                if what in p["armors"]:
                    continue
                label = "%s, soaks %d" % (what, ARMOR[what][0])
            elif kind == "shield":
                cost = SHIELDS[what][1]
                if p["shield"]:
                    continue
                label = "%s, stops %d big blow%s" % (
                    what, SHIELDS[what][0], "" if SHIELDS[what][0] == 1
                    else "s")
            elif kind == "usage":
                cost = USAGE_ITEMS[what][1]
                label = "%s (d%d to d12)" % (USAGE_ITEMS[what][0],
                                             p["usage"].get(what, 0))
            elif kind == "count":
                cost = COUNT_COST[what]
                label = COUNTED[what]
            else:
                cost = LIZARD_COST
                if p["lizard"]:
                    continue
                label = "a riding lizard (halves every road)"
            cost = self.price(cost, mob)
            items.append(("%s: %d coins" % (label, cost),
                          lambda k=kind, w=what, c=cost: self.buy(mob, k, w,
                                                                  c)))
        if not self.talk.get("haggled") and not self.talk.get("haggle_try"):
            items.append(("Haggle (Charisma)", lambda: self.haggle(mob)))
        items.append(("Nothing more", self.talk_menu))
        self.open_menu("%s's goods (you have %d coins)" % (mob.name,
                                                          p["coins"]),
                       items, cancel=self.talk_menu)

    def haggle(self, mob):
        p = self.p
        self.talk["haggle_try"] = True
        if p["cls"] == "Urchin" and not self.used_today("bossy"):
            self.use_today("bossy")
            ok = True
            self.say("You put your hands on your hips and boss %s about "
                     "until they give in." % mob.name, "you")
        else:
            ok, _ = self.test("CHA", -1 if p["cls"] == "Robot" else 0,
                              label="Charisma, haggling")
        if ok:
            self.talk["haggled"] = True
            self.npc_say(mob, "Fine, fine. A quarter off. Robber.")
        else:
            self.npc_say(mob, "Ha! The price is the price.")
        self.shop_menu(mob)

    def buy(self, mob, kind, what, cost):
        p = self.p
        if p["coins"] < cost:
            self.npc_say(mob, "Come back with more coins.")
            self.shop_menu(mob)
            return
        p["coins"] -= cost
        self.sound.play("gold")
        if kind == "weapon":
            p["weapons"].append(what)
            if WEAPONS[what].ranged and not p["ranged"]:
                p["ranged"] = what
            self.say("You buy %s. (Wield it with U.)" % WEAPONS[what].desc,
                     "gold")
            if WEAPONS[what].ammo and not p["usage"].get(
                    WEAPONS[what].ammo):
                p["usage"][WEAPONS[what].ammo] = 6
                self.say("(%s throws in some %s.)" % (
                    mob.name, WEAPONS[what].ammo), "gold")
        elif kind == "armor":
            p["armors"].append(what)
            self.say("You buy %s. (Wear it with U.)" % what, "gold")
        elif kind == "shield":
            p["shield"], p["shield_hits"] = what, SHIELDS[what][0]
            self.say("You buy a %s and sling it on your arm." % what, "gold")
        elif kind == "usage":
            p["usage"][what] = 12
            self.say("You buy %s. (d12)" % USAGE_ITEMS[what][0], "gold")
        elif kind == "count":
            p["count"][what] = p["count"].get(what, 0) + 1
            self.say("You buy %s." % COUNTED[what], "gold")
        else:
            p["lizard"] = True
            self.npc_say(mob, "She's called Biscuit. Don't let her eat "
                              "your boots. Every road's half as long now.")
        self.shop_menu(mob)

    def healer(self, mob):
        p = self.p
        lost = p["maxhp"] - p["hp"]
        cracked = [t for t in p["temp"] if t[2] > self.turn]
        if not lost and not p["poison"] and not cracked:
            self.npc_say(mob, "You're as well as you'll ever be. Shoo.")
            self.talk_menu()
            return
        cost = min(p["coins"], 2 + lost // 2)
        p["coins"] -= cost
        p["hp"] = p["maxhp"]
        p["poison"] = 0
        p["temp"] = []
        p["until"]["fathead"] = -1
        self.pass_time(60, quiet=True)
        self.sound.play("potion")
        self.npc_say(mob, "There. Splinted, salved and sewn. %s" % (
            "That's %d coins." % cost if cost else "Pay me when you can."))
        self.talk_menu()

    def sleep_inn(self, mob):
        p = self.p
        if p["coins"] < 3:
            self.npc_say(mob, "Three coins a bed. Come back richer.")
            self.talk_menu()
            return
        p["coins"] -= 3
        self.end_talk()
        self.say("You sleep in a real bed, under a real roof.", "info")
        self.pass_time(8 * 60, quiet=True)
        if self.overlay:
            return
        hd = CLASSES[p["cls"]]["hd"]
        self.heal(roll("1d%d" % hd) + roll("1d%d" % hd),
                  "You wake rested")
        p["until"]["fathead"] = -1
        self.say("It's %s." % self.date_text(), "info")
        self.save()

