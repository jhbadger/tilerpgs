# The usage die: rolled after use, a 1 or 2 steps it down; off a d4, gone.
USAGE_STEPS = (20, 12, 10, 8, 6, 4)


def usage_down(die):
    i = USAGE_STEPS.index(die)
    return USAGE_STEPS[i + 1] if i + 1 < len(USAGE_STEPS) else 0


