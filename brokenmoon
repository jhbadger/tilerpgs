class Game:
    def __init__(self, shell):
        """The game, in the window shell (a TkShell or a KivyShell) gives
        it."""
        self.shell = shell
        self.sound = Sound()
        saved = load_saved()
        self.sound.muted = bool(saved.get("muted"))
        self.sound.music_off = bool(saved.get("music_off"))
        self.destiny_auto = saved.get("destiny_auto", True) is not False
        zoom = saved.get("zoom")
        self.zoom_d = zoom if zoom in range(-2, 3) else 0
        text = saved.get("text")
        self.text_k = text if text in TEXT_SIZES else 1.0
        self.scale = 3 if shell.screen_height() >= 1000 else 2
        self.tall = None
        self.fit_job = None
        self.screen = shell.build(self, (
            ("wait", "Wait", self.wait),
            ("rest", "Rest", self.rest),
            ("search", "Search", self.search),
            ("fire", "Fire", self.ready_fire),
            ("cast", "Cast", self.cast_menu),
            ("use", "Use", self.use_menu),
            ("hero", "Hero", self.show_sheet),
            ("journal", "Journal", self.journal),
            ("map", "Map", self.toggle_map),
            ("menu", "Menu", self.action_menu)), self.scale >= 3)
        self.load_images()
        self.shown = []
        self.frame = 0
        self.view = (0, 0)
        self.fx_token = 0
        self.overlay = None
        self.overlay_text = None
        self.talk = None
        self.busy = False
        self.aim = None
        self.menu = None
        self.menu_rows = []
        self.walking = None
        self.visible = set()
        self.cache = {}
        self.flights = []
        try:
            self.restore(saved["game"])
        except (KeyError, TypeError, ValueError, IndexError, zlib.error,
                AttributeError):
            self.shell.after(50, self.new_game)
        self.music_tick()
        self.animate()
        self.pad = Gamepad()
        self.pad_dir = None
        self.pad_axes = {}
        self.pad_poll()

    # ── Gamepad ──

    def pad_poll(self):
        while True:
            try:
                kind, number, value = self.pad.events.get_nowait()
            except queue.Empty:
                break
            name = PAD_BUTTONS.get(number) if kind & 1 else None
            if name in ("left", "right", "up", "down"):
                self.pad_hold({"left": (-1, 0), "right": (1, 0),
                               "up": (0, -1), "down": (0, 1)}[name]
                              if value else None)
            elif name and value:
                self.pad_button(name)
            elif kind & 2 and number in PAD_STICK + PAD_HAT:
                self.pad_axes[number] = value
                held = None
                for ax, ay in (PAD_HAT, PAD_STICK):
                    vx, vy = self.pad_axes.get(ax, 0), self.pad_axes.get(ay, 0)
                    if max(abs(vx), abs(vy)) > PAD_DEADZONE:
                        held = ((1 if vx > 0 else -1, 0) if abs(vx) >= abs(vy)
                                else (0, 1 if vy > 0 else -1))
                        break
                if held != self.pad_dir:
                    self.pad_hold(held)
        self.shell.after(30, self.pad_poll)

    def pad_hold(self, d):
        self.pad_dir = d
        if d:
            self.pad_direction(d)
            self.shell.after(350, self.pad_repeat, d)

    def pad_repeat(self, d):
        if self.pad_dir == d:
            self.pad_direction(d)
            self.shell.after(160, self.pad_repeat, d)

    def pad_direction(self, d):
        self.walking = None
        if self.menu:
            self.menu_move(-1 if d in ((0, -1), (-1, 0)) else 1)
        elif self.busy or self.talk:
            pass
        elif self.overlay:
            self.close_overlay()
        elif self.aim:
            self.aimed(*d)
        else:
            self.move(*d)

    def pad_button(self, name):
        self.walking = None
        if self.busy:
            return
        if self.menu:
            if name == "a":
                self.menu_pick()
            elif name == "b":
                self.menu_cancel()
            return
        if self.talk:
            return
        if self.overlay:
            if name == "start":
                self.action_menu()
            else:
                self.close_overlay()
            return
        if self.aim:
            if name == "b":
                self.aim = None
                self.say("Never mind.", "info")
            return
        {"a": self.wait, "x": self.ready_fire, "y": self.cast_menu,
         "lb": self.use_menu, "rb": self.journal, "view": self.toggle_map,
         "start": self.action_menu}.get(name, lambda: None)()

    def animate(self):
        """Flip every animated square to its other frame."""
        self.frame ^= 1
        if self.shown and not self.overlay:
            scr = self.screen
            for idx, (base, top) in enumerate(self.shown):
                nb, nt = self.framed(base), self.framed(top)
                if (nb, nt) == (base, top):
                    continue
                self.shown[idx] = (nb, nt)
                if nb != base:
                    scr.cell(idx, 0, nb)
                if nt != top:
                    scr.cell(idx, 1, nt)
        self.shell.after(500, self.animate)

    def framed(self, name):
        if not name or name[0] == "~":
            return name
        root = name[:-2] if name.endswith("@1") else name
        return root + "@1" if self.frame and root in self.animated else root

    def music_tick(self):
        self.sound.tick()
        self.shell.after(100, self.music_tick)

    def load_images(self):
        """The tiles, darkened copies of the terrain for squares remembered
        but not seen, and an average colour of each for the map."""
        tiles = all_tiles()
        self.avg = {}
        for name, px in tiles.items():
            if name.split("@")[0] in SPRITES:
                continue
            tot = [0, 0, 0]
            for r in px:
                for c in r:
                    for i in range(3):
                        tot[i] += int(c[1 + 2 * i:3 + 2 * i], 16)
            self.avg[name] = "#%02x%02x%02x" % tuple(v // 256 for v in tot)
        self.animated = {n for n in tiles if n + "@1" in tiles}
        self.screen.load_tiles(tiles)
        self.screen.set_scale(self.scale)

    # ── The hero ──

    @staticmethod
    def roll_stats(cls, rng=random):
        return {s: roll("2d6+5", rng) for s in STATS}

    @staticmethod
    def make_hero(name, sex, cls, stats):
        c = CLASSES[cls]
        hp = roll("1d%d" % c["hd"]) + 4
        weapons = [w for w in (c["melee"], c["ranged"]) if w]
        p = {"name": name, "sex": sex, "cls": cls, "stats": dict(stats),
             "level": 1, "hp": hp, "maxhp": hp, "destiny": 1,
             "coins": c["coins"] + roll("1d10"), "melee": c["melee"],
             "ranged": c["ranged"], "weapons": weapons,
             "armor": c["wear"], "armors": [c["wear"]] if c["wear"] else [],
             "shield": None, "shield_hits": 0,
             "usage": {k: v for k, v in c["items"].items()},
             "count": {"salve": 1}, "stones": [], "lizard": False,
             "torch": False, "torch_turns": 0, "temp": [], "until": {},
             "used": {}, "hungry": False, "held": 0, "poison": 0,
             "heighten": 0}
        return p

    def hero_tile(self, p=None):
        p = p or self.p
        t = CLASSES[p["cls"]]["tile"]
        return t + "_f" if p["sex"] == "F" and t + "_f" in PEOPLE else t

    def tapped(self, ev):
        """A tap on the map, unless it's the tail of one on a dialog that
        just closed (on Android it can land on the map behind), or there's
        no game yet."""
        if time.time() < self.shell.tap_guard or \
                not getattr(self, "area", None):
            return
        self.on_tap(ev)

    def ask_hero(self, done, title="A new hero"):
        """Making a hero: a name, a class, and stats rolled until you like
        them, in the shell's dialog."""
        rng = random.Random()

        def sheet(cls, sex, att, st):
            c = CLASSES[cls]
            lines = ["  ".join("%s %2d" % (s, st[s]) for s in STATS[:3]),
                     "  ".join("%s %2d" % (s, st[s]) for s in STATS[3:]), "",
                     "Hit die d%d (+4 to start)   Damage d%d" % (c["hd"],
                                                                c["dmg"]),
                     "Weapons: %s" % ", ".join(
                         w for w in (c["melee"], c["ranged"]) if w),
                     "Armor: %s" % (c["wear"] or "none"), "",
                     "\n".join(wrap(c["special"], 44))]
            return c["desc"], "\n".join(lines)

        def chosen(who):
            if who is not None:
                n, sex, att, cls, st = who
                who = (" ".join(n.split())[:28] or "Nameless", sex, cls, st)
            done(who)
        self.shell.ask_hero(title, {
            "heading": "Your legend", "sex": rng.choice("MF"),
            "attracted": None, "background": "Barbarian",
            "backgrounds": list(CLASSES),
            "suggest": lambda sex: hero_name(rng, sex),
            "roll": self.roll_stats, "sheet": sheet}, chosen)

    # ── Game setup ──

    def default_hero(self):
        cls = random.choice(list(CLASSES))
        sex = random.choice("MF")
        return (hero_name(random, sex), sex, cls, self.roll_stats(cls))

    def new_game(self, who=None):
        if who is None:
            if not getattr(self, "headless", False):
                def chosen(w):
                    if w is None:
                        if getattr(self, "area", None) and \
                                self.overlay != "lost":
                            return
                        w = self.default_hero()
                    self.new_game(w)
                self.ask_hero(chosen)
                return
            who = self.default_hero()
        name, sex, cls, stats = who
        self.world = generate_world(random.randrange(1 << 31))
        self.cache = {}
        self.p = self.make_hero(name, sex, cls, stats)
        self.flags = set()
        self.topics = set()
        self.notes = []
        self.turn = 0
        self.tallies = {}
        self.city = "phila"
        self.city_pos = {}
        self.seen = {}
        self.surface = None
        self.reset_view()
        self.shell.log_clear()
        area = self.get_area(("bld", "phila", "hall"))
        self.city_pos["phila"] = list(door_step(
            self.get_area(("city", "phila")), ("bld", "phila", "hall")))
        self.area, self.pos = area, list(area.start)
        self.flags.add("been:phila")
        self.say("The Free Hold of Philadelphia. The first day.", "quest")
        self.say("You came in off the road last night, %s, with the chain "
                 "marks still on your wrists. This morning the Elder sent "
                 "for you." % name)
        self.say("Elder Hesper Vane waits in the Meeting Hall, at the far "
                 "end by the rug. Walk into people to talk to them.",
                 "talk")
        self.say("Press ? for help.", "info")
