class Area:
    """A map: a city, a building, or a level of a lair."""

    def __init__(self, kind, key, grid, name, edge=None, dark=False):
        self.kind, self.key, self.grid, self.name = kind, key, grid, name
        self.h, self.w = len(grid), len(grid[0])
        self.edge = edge
        self.dark = dark
        self.mobs = []
        self.items = {}         # (x, y) -> thing lying there
        self.links = {}         # (x, y) -> where it goes
        self.labels = {}        # (x, y) -> what it is
        self.hidden = {}        # (x, y) -> found by searching
        self.loot = set()       # containers not yet opened
        self.traps = set()
        self.landmark = {}      # (x, y) -> (name, description)
        self.decor = {}
        self.skin = {}
        self.seen = bytearray(self.w * self.h)
        self.opaque = OPAQUE[kind]
        self.start = (0, 0)
        self.down = None
        self.site = None
        self.city = None
        self.kind_of = None

    def inside(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h

    def mob_at(self, x, y):
        for m in self.mobs:
            if m.x == x and m.y == y:
                return m
        return None


class Mob:
    def __init__(self, tile, name, x, y):
        self.tile, self.name, self.x, self.y = tile, name, x, y
        self.kind = None
        self.hostile = False
        self.hd = 0
        self.hp = self.maxhp = 1
        self.stun = 0
        self.boss = False
        self.flee = 0
        self.aware = False
        self.asleep = 0
        self.held = 0           # stuck in a web or a pincer
        self.title = name
        self.role = None
        self.city = None
        self.talk, self.greet = {}, ""
        self.shop = None
        self.roam = None
        self.home = None
        self.stone = None       # the Moonstone a warlord holds


def make_monster(kind, x, y, boss=False, rng=random):
    e = ENEMIES[kind]
    mob = Mob(e.tile, e.name, x, y)
    mob.kind = kind
    mob.hostile = True
    mob.hd = e.hd
    if "mook" in e.traits:
        mob.hp = 1
    elif boss:
        mob.hp = e.hd * 8
    else:
        mob.hp = max(e.hd * 2, roll("%dd8" % e.hd, rng))
    mob.maxhp = mob.hp
    mob.boss = boss
    return mob


def blank(w, h, tile):
    return [[tile] * w for _ in range(h)]


def make_dungeon(world, lid, level, flags):
    """One level of a warlord's lair, or of the king's: rooms and
    passages, the same each time it is made (but for what's been done)."""
    info = LAIRS[lid]
    rng = random.Random("%s:%s:%d" % (world["seed"], lid, level))
    W, H = 44, 30
    last = level == info.levels
    for attempt in range(400):
        g = blank(W, H, "dwall")
        rooms = []
        want = rng.randint(7, 9)
        for _ in range(400):
            if len(rooms) >= want:
                break
            w, h = rng.randint(4, 9), rng.randint(3, 6)
            if last and len(rooms) == want - 1:
                w, h = max(w, 8), max(h, 6)
            x, y = rng.randint(1, W - w - 1), rng.randint(1, H - h - 1)
            if any(x <= r[2] + 2 and r[0] <= x + w + 1 and
                   y <= r[3] + 2 and r[1] <= y + h + 1 for r in rooms):
                continue
            rooms.append((x, y, x + w - 1, y + h - 1))
        if len(rooms) < 5:
            continue
        rooms.sort(key=lambda r: r[0] + r[2] + rng.random())
        end = rooms[-1]
        centers = [((r[0] + r[2]) // 2, (r[1] + r[3]) // 2) for r in rooms]

        def carve(a, b):
            (ax, ay), (bx, by) = a, b
            if rng.random() < 0.5:
                pts = [(x, ay) for x in range(min(ax, bx), max(ax, bx) + 1)]
                pts += [(bx, y) for y in range(min(ay, by), max(ay, by) + 1)]
            else:
                pts = [(ax, y) for y in range(min(ay, by), max(ay, by) + 1)]
                pts += [(x, by) for x in range(min(ax, bx), max(ax, bx) + 1)]
            for x, y in pts:
                g[y][x] = "dfloor"
        for r in rooms:
            for y in range(r[1], r[3] + 1):
                for x in range(r[0], r[2] + 1):
                    g[y][x] = "dfloor"
        for a, b in zip(centers, centers[1:]):
            carve(a, b)
        for _ in range(2):                  # a loop or two, avoiding the end
            i, j = sorted(rng.sample(range(len(rooms) - 1), 2))
            carve(centers[i], centers[j])
        ring = [(x, y) for x in range(end[0] - 1, end[2] + 2)
                for y in range(end[1] - 1, end[3] + 2)
                if not (end[0] <= x <= end[2] and end[1] <= y <= end[3])]
        openings = [(x, y) for x, y in ring if g[y][x] != "dwall"]
        if last and len(openings) != 1:
            continue
        break
    wall, floor = THEMES[info.theme]
    floor_word = "floor" if info.theme == "tower" else "level"
    area = Area("dungeon", ("dun", lid, level), g, "%s, %s %d" % (
        info.name, floor_word, level), dark=True)
    area.skin = {"dwall": wall, "dfloor": floor}
    area.lead = lid
    sx, sy = centers[0]
    g[sy][sx] = "stairs_up"
    area.start = (sx, sy)
    ex, ey = centers[-1]
    floor_spots = [(x, y) for y in range(H) for x in range(W)
                   if g[y][x] == "dfloor"]
    end_cells = {(x, y) for x in range(end[0], end[2] + 1)
                 for y in range(end[1], end[3] + 1)}

    def free(n, far=6, within=None):
        spots = [p for p in (within or floor_spots)
                 if g[p[1]][p[0]] == "dfloor" and p not in area.items
                 and abs(p[0] - sx) + abs(p[1] - sy) >= far
                 and not area.mob_at(*p)]
        return rng.sample(spots, min(n, len(spots)))

    area.end_cells = end_cells
    if not last:
        g[ey][ex] = "stairs_down"
        area.down = (ex, ey)
    else:
        ox, oy = openings[0]
        g[oy][ox] = "gate"
        area.gate = (ox, oy)
        if lid == "washington":
            x0, y0, x1, y1 = end
            for x, y in end_cells:
                if (x + y) % 3 == 0 and (x, y) != (ex, ey):
                    g[y][x] = "glyph"
            g[ey][ex] = "throne"
            if "won" not in flags:
                bx, by = ex, ey + 1 if g[ey + 1][ex] != "dwall" else ey - 1
                boss = make_monster("malgorath", bx, by, boss=True)
                area.mobs.append(boss)
                for kind in ("skull", "skull", "gunner"):
                    spots = [p for p in sorted(end_cells)
                             if g[p[1]][p[0]] in ("dfloor", "glyph")
                             and not area.mob_at(*p) and p != (ox, oy)]
                    if spots:
                        x, y = rng.choice(spots)
                        area.mobs.append(make_monster(kind, x, y, rng=rng))
        elif "stone:" + lid not in flags:
            if info.boss == "crabbaron":
                for dx in (-1, 0, 1):
                    for dy in (-1, 0, 1):
                        if (ex + dx, ey + dy) in end_cells and (dx or dy):
                            g[ey + dy][ex + dx] = "pool"
            boss = make_monster(info.boss, ex, ey, boss=True)
            boss.stone = lid
            area.mobs.append(boss)
    inner = [(x, y) for r in rooms[1:-1] for x in range(r[0] + 1, r[2])
             for y in range(r[1] + 1, r[3])]
    for x, y in free(rng.randint(4, 8), 3, inner):
        g[y][x] = info.hazard
    for n in range(rng.randint(2, 4)):          # crates and scrap
        if not inner:
            break
        x, y = rng.choice(inner)
        if g[y][x] != "dfloor" or (x, y) in end_cells:
            continue
        if "loot:%s:%d:%d:%d" % (lid, level, x, y) in flags:
            g[y][x] = "rubble_low"
        else:
            g[y][x] = info.loot
            area.loot.add((x, y))
    if level - 1 < len(info.lore):
        for x, y in free(1, 5):
            area.items[(x, y)] = "note"
            area.note = info.lore[level - 1]
    for x, y in free(rng.randint(1, 2), 5):
        area.items[(x, y)] = rng.choice(("coins", "food", "torch", "ammo"))
    for x, y in free(rng.randint(1, 3), 4):     # found by searching
        area.hidden[(x, y)] = rng.choice(("coins", "salve", "ammo",
                                          "coins", "gear"))
    for x, y in free(rng.randint(1, 3), 5):
        area.traps.add((x, y))
    n = 3 + level * 2
    if lid == "washington":
        n += 2
    for x, y in free(n, 8):
        if (x, y) in end_cells and last:
            continue
        kinds = info.monsters
        kind = kinds[min(len(kinds) - 1, rng.randrange(1 + level))] \
            if rng.random() < 0.7 else rng.choice(kinds)
        if kind in ("croc", "crab") and rng.random() < 0.6:
            g[y][x] = "pool"
            for dx, dy in DIRS:
                if g[y + dy][x + dx] == "dfloor":
                    g[y + dy][x + dx] = "pool"
        m = make_monster(kind, x, y, rng=rng)
        m.asleep = rng.choice((0, 0, 0, 40))
        area.mobs.append(m)
    return area

