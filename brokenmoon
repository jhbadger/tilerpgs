                 font=tkf(F("Helvetica", 13))).pack(side="left")
        name = tk.Entry(row, bg=LOG_BG, fg=INK, insertbackground=INK,
                        font=tkf(F(*MONO)), width=22, highlightthickness=0)
        sex = tk.StringVar(value=form["sex"])
        att = tk.StringVar(value=form.get("attracted") or "")

        def suggest():
            name.delete(0, "end")
            name.insert(0, form["suggest"](sex.get()))
        suggest()
        name.pack(side="left", padx=8)
        row2 = tk.Frame(dlg, bg=PANEL)
        row2.pack(fill="x", pady=(0, 8))
        rows = [("You are:", sex, (("a man", "M"), ("a woman", "F")))]
        if form.get("attracted"):
            rows.append(("  Drawn to:", att, (("women", "F"),
                                              ("men", "M"))))
        for text, var, vals in rows:
            tk.Label(row2, text=text, bg=PANEL, fg=INK,
                     font=tkf(F("Helvetica", 12))).pack(side="left")
            for label, v in vals:
                tk.Radiobutton(row2, text=label, variable=var, value=v,
                               bg=PANEL, fg=INK, selectcolor=LOG_BG,
                               activebackground=PANEL,
                               font=tkf(F("Helvetica", 12)),
                               command=suggest if var is sex else None
                               ).pack(side="left")
        bgv = tk.StringVar(value=form["background"])
        cols = tk.Frame(dlg, bg=PANEL)
        cols.pack(fill="x")
        left = tk.Frame(cols, bg=PANEL)
        left.pack(side="left", anchor="n")
        right = tk.Frame(cols, bg=PANEL)
        right.pack(side="left", anchor="n", padx=(16, 0))
        for c in form["backgrounds"]:
            tk.Radiobutton(left, text=c, variable=bgv, value=c, bg=PANEL,
                           fg=INK, selectcolor=LOG_BG, activebackground=PANEL,
                           font=tkf(F("Helvetica", 13, "bold")), anchor="w",
                           command=lambda: reroll()).pack(fill="x")
        desc = tk.Label(right, bg=PANEL, fg=INK_DIM, wraplength=S(340),
                        justify="left", font=tkf(F("Helvetica", 12)))
        desc.pack(fill="x", anchor="w")
        sheet = tk.Label(right, bg=PANEL, fg=INK, justify="left",
                         font=tkf(F(*MONO)))
        sheet.pack(fill="x", anchor="w", pady=(8, 0))
        state = {"chars": form["roll"](bgv.get())}

        def show():
            d, s = form["sheet"](bgv.get(), sex.get(), att.get(),
                                 state["chars"])
            desc.config(text=d)
            sheet.config(text=s)

        def reroll():
            state["chars"] = form["roll"](bgv.get())
            show()

        def begin(_=None):
            who = (name.get(), sex.get(), att.get(), bgv.get(),
                   dict(state["chars"]))
            self.close_dialog(dlg)
            done(who)

        def cancel(_=None):
            self.close_dialog(dlg)
            done(None)
        show()
        bar = tk.Frame(dlg, bg=PANEL)
        bar.pack(fill="x", pady=(12, 0))
        tk.Button(bar, text="Begin", command=begin, width=9,
                  highlightbackground=PANEL).pack(side="right")
        tk.Button(bar, text="Cancel", command=cancel, width=9,
                  highlightbackground=PANEL).pack(side="right", padx=6)
        tk.Button(bar, text="Roll again", command=reroll, width=10,
                  highlightbackground=PANEL).pack(side="left")
        dlg.bind("<Return>", begin)
        dlg.bind("<Escape>", cancel)
        dlg.protocol("WM_DELETE_WINDOW", cancel)
        name.focus_set()
        name.select_range(0, "end")
        self.fit_dialog(dlg)
        dlg.geometry("+%d+%d" % (
            root.winfo_rootx() + max(0, (root.winfo_width() -
                                         dlg.winfo_reqwidth()) // 2),
            root.winfo_rooty() + max(0, min(60, (root.winfo_height() -
                                                 dlg.winfo_reqheight()) // 2))))
        self.grab(dlg)

    def dialog_shrunk(self):
        """Whether a dialog has the fonts shrunk to fit: leave them be."""
        return self.small_dialog is not None

    def fit_dialog(self, dlg):
        """Shrink a dialog that's too big for the window until it fits;
        everything goes back to its usual size when it closes."""
        root = self.root
        root.update_idletasks()
        self.game.fit()
        W, H = root.winfo_width(), root.winfo_height()
        if W < 100:
            return
        shrunk = False
        for _ in range(5):
            dlg.update_idletasks()
            k = min(1.0, (W - 8) / max(1, dlg.winfo_reqwidth()),
                    (H - 8) / max(1, dlg.winfo_reqheight()))
            if k >= 1.0:
                break
            shrunk = True
            set_fonts(UI[0] * k * 0.97)
            todo = [dlg]
            while todo:
                w = todo.pop()
                todo += w.winfo_children()
                try:
                    wl = int(w.cget("wraplength"))
                except (tk.TclError, ValueError):
                    continue
                if wl:
                    w.configure(wraplength=max(60, int(wl * k)))
        if shrunk:
            self.small_dialog = dlg

            def closed(e):
                if e.widget is dlg:
                    self.small_dialog = None
                    self.root.after_idle(self.game.fit, True)
            dlg.bind("<Destroy>", closed, add="+")

    # The rest.

    def set_icon(self):
        set_window_icon(self.root)

    def run(self):
        self.root.mainloop()

    def close(self):
        self.root.destroy()


# ── The display layer, in Kivy ──────────────────────────────────────────────
# The same shell and screen again, for Kivy: run with --kivy (or
# BROKENMOON_UI=kivy) where Kivy is installed; a Python without Tk (the
# Android app --build-android makes) uses Kivy by itself.  Kivy is only
# looked for when asked, and by names put together at run time, as for the
# mixer: Pydroid picks how to run a script from what it imports, and the
# game itself must still start with Tk.  Kivy counts in real pixels from
# the bottom left; these classes turn that into the map's pixels from its
# top left.

KV = {}             # Kivy's parts, once loaded


def load_kivy(width=980, height=720):
    """Kivy's classes, by name; the first call opens the window."""
    if KV:
        return KV
    os.environ.setdefault("KIVY_NO_ARGS", "1")      # --kivy is ours
    os.environ.setdefault("KIVY_NO_CONSOLELOG", "1")
    import importlib
    k = "ki" + "vy"

    def part(module, *names):
        mod = importlib.import_module(k + module)
        for n in names:
            KV[n] = getattr(mod, n)
    config = importlib.import_module(k + ".config").Config
    config.set("kivy", "exit_on_escape", "0")       # Escape and Back: ours
    config.set("kivy", "log_level", "warning")
    # A touch can come twice, from the touch screen and again as a mouse:
    # on a phone there's no mouse to want, and elsewhere the mouse gives
    # way while the touch screen is in use.
    if ANDROID:
        config.remove_option("input", "mouse")
    else:
        config.set("input", "mouse",
                   "mouse,disable_multitouch,disable_on_activity")
    config.set("graphics", "width", str(width))
    config.set("graphics", "height", str(height))
    part(".core.window", "Window")
    part(".app", "App")
    part(".clock", "Clock")
    part(".graphics", "Color", "Rectangle", "Line", "InstructionGroup")
    part(".graphics.texture", "Texture")
    part(".core.text.markup", "MarkupLabel")
    part(".uix.widget", "Widget")
    part(".uix.stencilview", "StencilView")
    part(".uix.boxlayout", "BoxLayout")
    part(".uix.gridlayout", "GridLayout")
    part(".uix.label", "Label")
    part(".uix.button", "Button")
    part(".uix.togglebutton", "ToggleButton")
    part(".uix.textinput", "TextInput")
    part(".uix.scrollview", "ScrollView")
    part(".uix.modalview", "ModalView")
    return KV


def kivy_rgba(colour, alpha=1.0):
    """A Tk colour ("#rrggbb", "black" or "white") as Kivy's (r, g, b, a)."""
    colour = {"black": "#000000", "white": "#ffffff"}.get(colour, colour)
    return (int(colour[1:3], 16) / 255, int(colour[3:5], 16) / 255,
            int(colour[5:7], 16) / 255, alpha)


def kivy_markup(text, mono_px=None):
    """Print for a Kivy label that reads markup: [, ] and & kept as they
    are, and the symbols Kivy's Roboto fonts lack (the menus' arrows) set
    in DejaVu Sans, which Kivy also brings, smaller in monospaced print of
    mono_px pixels so that the columns still line up."""
    if mono_px:
        start = "[font=DejaVuSans][size=%d]" % max(6, round(mono_px * 0.72))
        end = "[/size][/font]"
    else:
        start, end = "[font=DejaVuSans]", "[/font]"
    out, run = [], []
    for ch in text:
        if ord(ch) > 0xff and not 0x2010 <= ord(ch) <= 0x2027:
            run.append(ch)
            continue
        if run:
            out.append(start + "".join(run) + end)
            run = []
        out.append({"&": "&amp;", "[": "&bl;", "]": "&br;"}.get(ch, ch))
    if run:
        out.append(start + "".join(run) + end)
    return "".join(out)


class KivyFonts:
    """F()'s fonts in Kivy's terms: Roboto for print, Roboto Mono where the
    columns must line up, at a size in real pixels."""
    pt = 4 / 3          # as Tk counts pixels to a point on a desktop: on
                        # a phone too, so print keeps to the layout's size

    @classmethod
    def px(cls, size):
        return max(6, round(size * UI[0] * cls.pt))

    @staticmethod
    def mono(font):
        return font[0] in ("Menlo", "Courier")

    @classmethod
    def markup(cls, text, font):
        return kivy_markup(text, cls.px(font[1]) if cls.mono(font) else None)

    @classmethod
    def options(cls, font):
        family, size, style = font
        return {"font_name": "RobotoMono-Regular" if cls.mono(font)
                else "Roboto", "font_size": cls.px(size),
                "bold": "bold" in style, "italic": "italic" in style}


class KivyScreen:
    """The map in Kivy: a widget whose canvas holds, from the bottom, the
    tiles, the overlay and the two sprites."""
    ANCHOR_X = {"w": 0, "e": 1}
    ANCHOR_Y = {"n": 0, "s": 1}

    def __init__(self):
        kv = load_kivy()
        self.kv = kv
        screen = self
        self.game = None

        class MapArea(kv["StencilView"]):     # (drawing kept inside it)
            def on_touch_down(self, touch):
                if getattr(touch, "is_mouse_scrolling", False) or \
                        not self.collide_point(*touch.pos) or \
                        screen.game is None:
                    return super().on_touch_down(touch)
                x, y = int(touch.x - self.x), int(self.top - touch.y)
                if not screen.echo(x, y):
                    screen.game.tapped(Tap(x, y))
                return True
        self.widget = MapArea()
        with self.widget.canvas.before:
            kv["Color"](0, 0, 0, 1)
            bg = kv["Rectangle"]()
        self.widget.bind(pos=lambda w, v: setattr(bg, "pos", v),
                         size=lambda w, v: setattr(bg, "size", v))
        self.groups = {}
        for layer in ("grid", "overlay", "sprites"):
            g = self.groups[layer] = kv["InstructionGroup"]()
            self.widget.canvas.add(g)
        self.cells = []
        self.sprites = {}
        self.ts = 16
        self.last_tap = (0, -999, -999)
        self.labels = {}            # (text, font, ...) -> texture

    def echo(self, x, y):
        """Whether a tap at x, y is the last one over again: the same
        place within a third of a second, as when one touch reaches Kivy
        twice.  Answered for real, it could undo the first (opening a menu,
        then closing it)."""
        t, lx, ly = self.last_tap
        now = time.time()
        self.last_tap = (now, x, y)
        half = max(8, self.ts // 2)
        return now - t < 0.3 and abs(x - lx) < half and abs(y - ly) < half

    def kx(self, x):
        return self.widget.x + x

    def ky(self, y, h=0):
        """Kivy's y for the bottom of something h high whose top is at y."""
        return self.widget.y + self.widget.height - y - h

    def size(self):
        return int(self.widget.width), int(self.widget.height)

    def listen(self, game):
        """The map resized or moved: lay the tiles out afresh."""
        self.game = game
        trigger = self.kv["Clock"].create_trigger(lambda dt: game.layout())
        self.widget.bind(size=lambda *a: trigger(), pos=lambda *a: trigger())

    # The tiles.

    def texture(self, w, h, pixels):
        """A texture of RGBA pixels, top row first, drawn sharp."""
        tex = self.kv["Texture"].create(size=(w, h), colorfmt="rgba")
        tex.mag_filter = tex.min_filter = "nearest"
        stride = w * 4
        flipped = b"".join(pixels[i:i + stride]
                           for i in range((h - 1) * stride, -1, -stride))
        tex.blit_buffer(flipped, colorfmt="rgba", bufferfmt="ubyte")
        return tex

    def load_tiles(self, tiles):
        """Textures of all_tiles()'s pixel rows, and darkened copies of the
        terrain."""
        self.img, self.dimg = {}, {}
        for name, px in tiles.items():
            sprite = name.split("@")[0] in SPRITES
            flat, dark = bytearray(), bytearray()
            for row in px:
                for c in row:
                    if not c:
                        flat += b"\0\0\0\0"
                        continue
                    flat += bytes((int(c[1:3], 16), int(c[3:5], 16),
                                   int(c[5:7], 16), 255))
                    if not sprite:
                        d = shade(c, 0.36)
                        dark += bytes((int(d[1:3], 16), int(d[3:5], 16),
                                       int(d[5:7], 16), 255))
            self.img[name] = self.texture(16, 16, bytes(flat))
            if not sprite:
                self.dimg[name] = self.texture(16, 16, bytes(dark))

    def set_scale(self, s):
        """(The textures are drawn at whatever size the squares are.)"""

    def grid(self, cols, rows, ox, oy, ts):
        kv = self.kv
        for g in self.groups.values():
            g.clear()
        self.ts = ts
        grid = self.groups["grid"]
        grid.add(kv["Color"](1, 1, 1, 1))
        self.cells = []
        for j in range(rows):
            for i in range(cols):
                pos = (self.kx(ox + i * ts), self.ky(oy + j * ts, ts))
                cell = (kv["Rectangle"](pos=pos, size=(0, 0)),
                        kv["Rectangle"](pos=pos, size=(0, 0)))
                grid.add(cell[0])
                grid.add(cell[1])
                self.cells.append(cell)
        sprites = self.groups["sprites"]
        sprites.add(kv["Color"](1, 1, 1, 1))
        for which in ("fx", "missile"):
            r = self.sprites[which] = kv["Rectangle"](size=(0, 0))
            sprites.add(r)

    def cell(self, idx, layer, name):
        r = self.cells[idx][layer]
        if name is None:
            r.size = (0, 0)
            return
        r.texture = (self.dimg[name[1:]] if name[0] == "~"
                     else self.img[name])
        r.size = (self.ts, self.ts)

    def sprite(self, which, x, y, name):
        r = self.sprites.get(which)
        if r is None:
            return
        if name is None:
            r.size = (0, 0)
            return
        r.texture = self.img[name]
        r.pos = (self.kx(x), self.ky(y, self.ts))
        r.size = (self.ts, self.ts)

    # Print.

    def label(self, text, font, fill=None, justify="left"):
        """A texture of print, kept for next time."""
        key = (text, font, fill, justify, UI[0])
        tex = self.labels.get(key)
        if tex is None:
            if len(self.labels) > 2000:
                self.labels.clear()
            lab = self.kv["MarkupLabel"](
                text=KivyFonts.markup(text, font),
                color=kivy_rgba(fill or INK), halign=justify,
                **KivyFonts.options(font))
            lab.refresh()
            tex = self.labels[key] = lab.texture
        return tex

    def measure(self, font, s):
        return self.label(s, font).width if s else 0

    def linespace(self, font):
        return self.label("Ag", font).height

    def text_size(self, text, font):
        tex = self.label(text, font)
        return tex.width, tex.height

    # The overlay.

    def clear_overlay(self):
        self.groups["overlay"].clear()

    def add(self, colour, shape):
        g = self.groups["overlay"]
        g.add(self.kv["Color"](*kivy_rgba(colour)))
        g.add(shape)

    def rect(self, x0, y0, x1, y1, fill="", outline="", width=1):
        kv = self.kv
        x0, x1 = min(x0, x1), max(x0, x1)
        y0, y1 = min(y0, y1), max(y0, y1)
        pos, size = (self.kx(x0), self.ky(y1)), (x1 - x0, y1 - y0)
        if fill:
            self.add(fill, kv["Rectangle"](pos=pos, size=size))
        if outline:
            self.add(outline, kv["Line"](rectangle=pos + size,
                                         width=max(1, width * 0.75)))

    def text(self, x, y, text, font, fill, anchor="center", justify="left"):
        if not text:
            return
        tex = self.label(text, font, fill, justify)
        ax = 0.5 if anchor in ("center", "n", "s") else \
            self.ANCHOR_X[anchor[-1]]
        ay = 0.5 if anchor in ("center", "w", "e") else \
            self.ANCHOR_Y[anchor[0]]
        left, top = x - tex.width * ax, y - tex.height * ay
        g = self.groups["overlay"]
        g.add(self.kv["Color"](1, 1, 1, 1))
        g.add(self.kv["Rectangle"](texture=tex, size=tex.size,
                                   pos=(self.kx(left),
                                        self.ky(top, tex.height))))

    def map_image(self, rows, z, x, y):
        w, h = len(rows[0]), len(rows)
        px = bytearray()
        for row in rows:
            for c in row:
                px += bytes((int(c[1:3], 16), int(c[3:5], 16),
                             int(c[5:7], 16), 255))
        tex = self.texture(w, h, bytes(px))
        g = self.groups["overlay"]
        g.add(self.kv["Color"](1, 1, 1, 1))
        g.add(self.kv["Rectangle"](texture=tex, size=(w * z, h * z),
                                   pos=(self.kx(x), self.ky(y, h * z))))


KIVY_KEYS = {273: "Up", 274: "Down", 276: "Left", 275: "Right",
             13: "Return", 271: "KP_Enter", 27: "Escape", 32: "space",
             9: "Tab", 8: "BackSpace", 269: "KP_Subtract", 270: "KP_Add",
             282: "F1"}
KIVY_KEYS.update({256 + n: "KP_%d" % n for n in range(10)})
KIVY_CHARS = {"+": "plus", "-": "minus", "=": "equal", "?": "question",
              "/": "slash", ".": "period", "_": "underscore"}


class KivyShell:
    """The window round the map, in Kivy: the same bars, panel, log, entry
    and buttons as the Tk one, and Kivy's clock and keys."""

    def __init__(self):
        self.kv = load_kivy()
        self.fonts = []             # (widget, font): resized together
        self.raw = {}               # label -> its text, before markup
        self.log_lines = []
        self.entry_shown = False
        self.dialog = None
        self.tap_guard = 0
        self.app = None

    def screen_height(self):
        return self.kv["Window"].height

    def window_size(self):
        return tuple(int(v) for v in self.kv["Window"].size)

    def set_ui_scale(self, u):
        UI[0] = u
        for w, font in self.fonts:
            w.font_size = KivyFonts.px(font[1])
            if w in self.raw:
                w.text = KivyFonts.markup(self.raw[w], font)
        self.screen.labels.clear()
        self.show_log()

    # Building.

    def painted(self, widget, colour):
        """A widget with a background."""
        kv = self.kv
        with widget.canvas.before:
            kv["Color"](*kivy_rgba(colour))
            r = kv["Rectangle"](pos=widget.pos, size=widget.size)
        widget.bind(pos=lambda w, v: setattr(r, "pos", v),
                    size=lambda w, v: setattr(r, "size", v))
        return widget

    def label(self, font, colour, wrap=False, **kw):
        lab = self.kv["Label"](markup=True, color=kivy_rgba(colour),
                               halign="left", valign="top",
                               **dict(KivyFonts.options(font), **kw))
        self.fonts.append((lab, font))
        if wrap:
            lab.size_hint_y = None
            lab.height = 0
            lab.bind(texture_size=lambda w, v: setattr(w, "height", v[1]))
        else:
            lab.size_hint = (None, None)
            lab.bind(texture_size=lambda w, v: setattr(w, "size", v))
        return lab

    def button(self, text, command, font=None, cls="Button", **kw):
        font = font or F("Helvetica", 13)
        b = self.kv[cls](text=text, font_size=KivyFonts.px(font[1]),
                         bold="bold" in font[2], **kw)
        self.fonts.append((b, font))
        if command:
            b.bind(on_release=lambda w: command())
        return b

    def build(self, game, buttons, big):
        kv = self.kv
        self.game = game
        if not ANDROID:
            kv["Window"].system_size = (1180, 860) if big else (980, 720)
        kv["Window"].clearcolor = kivy_rgba(PANEL)
        self.root = self.painted(kv["BoxLayout"](orientation="vertical"),
                                 PANEL)
        top = self.top = kv["BoxLayout"](size_hint_y=None, height=S(30),
                                         padding=(S(10), S(6)),
                                         spacing=S(20))
        top.add_widget(self.label(F("Georgia", 16, "bold"), ACCENT,
                                  text="Broken Moon"))
        self.status = self.label(F("Helvetica", 12), INK_DIM)
        top.add_widget(self.status)
        top.add_widget(kv["Widget"]())
        self.turns = self.label(F("Helvetica", 12), INK_DIM)
        top.add_widget(self.turns)
        self.root.add_widget(top)

        self.body = kv["BoxLayout"]()
        self.left = kv["BoxLayout"](orientation="vertical")
        self.screen = KivyScreen()
        self.left.add_widget(self.screen.widget)
        self.log_view = self.painted(kv["ScrollView"](
            size_hint_y=None, height=S(100), do_scroll_x=False,
            bar_width=S(4)), LOG_BG)
        self.log = self.label(F(*MONO), INK, wrap=True,
                              padding=(S(8), S(4)))
        self.log.bind(width=lambda w, v: setattr(w, "text_size", (v, None)))
        self.log_view.add_widget(self.log)
        self.left.add_widget(self.log_view)
        self.talkbar = self.painted(kv["BoxLayout"](
            size_hint_y=None, height=S(34), padding=(S(8), S(4)),
            spacing=S(6)), PANEL)
        self.prompt = self.label(F(*MONO), ACCENT, text="Ask about:")
        self.talkbar.add_widget(self.prompt)
        self.entry = kv["TextInput"](
            multiline=False, write_tab=False, text_validate_unfocus=False,
            background_color=kivy_rgba(LOG_BG),
            foreground_color=kivy_rgba(INK), cursor_color=kivy_rgba(INK),
            **{k: v for k, v in KivyFonts.options(F(*MONO)).items()
               if k in ("font_name", "font_size")})
        self.fonts.append((self.entry, F(*MONO)))
        self.entry.bind(on_text_validate=lambda *a: game.on_entry())
        self.talkbar.add_widget(self.entry)
        if ANDROID:                 # the keyboard mustn't hide what's typed
            kv["Window"].softinput_mode = "below_target"
        self.body.add_widget(self.left)

