# ── Ruin ──
# Every landmark is painted whole and then ruined: notches bitten out of its
# silhouette (the ground shows through), rubble at its foot, cracks, stains,
# and vines climbing from the bottom.


def ruin(p, ground, seed, bites=3, depth=0.25, vines=0.5, crack=6):
    rng = random.Random("ruin:" + seed)
    base = draw_terrain(ground)
    W, H = p.W, p.H

    def bare(x, y):
        return p.g[y][x] == base[y % 16][x % 16]
    top = []
    for x in range(W):
        t = next((y for y in range(H) if not bare(x, y)), None)
        top.append(t)
    cols = [x for x in range(W) if top[x] is not None]
    if not cols:
        return
    span = max(top[x] for x in cols)
    colours = {}
    for x in cols:
        for y in range(top[x], H):
            if not bare(x, y):
                colours[p.g[y][x]] = colours.get(p.g[y][x], 0) + 1
    debris = sorted(colours, key=lambda c: -colours[c])[:4] or ["#7a746a"]
    # bites out of the top
    for _ in range(bites):
        cx = rng.choice(cols)
        w = rng.randint(4, max(5, W // 4))
        d = max(3, int((H - min(top[x] for x in cols)) * depth *
                       rng.uniform(0.4, 1.0)))
        for x in range(max(0, cx - w // 2), min(W, cx + w // 2 + 1)):
            if top[x] is None:
                continue
            edge = 1 - abs(x - cx) / (w / 2 + 1)
            cut = int(d * edge + rng.randint(-2, 2))
            for y in range(top[x], min(H - 6, top[x] + cut)):
                p.g[y][x] = base[y % 16][x % 16]
    # rubble at the foot
    foot = [x for x in cols if not bare(x, H - 1)] or cols
    for _ in range(W // 3):
        x = rng.choice(foot) + rng.randint(-4, 4)
        y = H - 1 - rng.randint(0, 5)
        if 0 <= x < W:
            r = rng.choice((1, 1, 2))
            p.rect(x, y, x + r, y + r - 1, shade(rng.choice(debris),
                                                rng.uniform(0.6, 0.9)))
    # cracks and stains
    solid = [(x, y) for x in cols for y in range(top[x] or 0, H)
             if not bare(x, y)]
    if not solid:
        return
    for _ in range(crack):
        x, y = rng.choice(solid)
        for _ in range(rng.randint(5, 14)):
            if 0 <= x < W and 0 <= y < H and not bare(x, y):
                p.g[y][x] = shade(p.g[y][x], 0.45)
            x += rng.choice((-1, 0, 1))
            y += rng.choice((0, 1, 1))
    for x, y in rng.sample(solid, len(solid) // 18):
        p.g[y][x] = shade(p.g[y][x], 0.8)
    # vines
    low = [(x, y) for x, y in solid if y > H - 20]
    for _ in range(int(W * vines / 3)):
        if not low:
            break
        x, y = rng.choice(low)
        for _ in range(rng.randint(6, int(10 + span * 0.3))):
            if 0 <= x < W and 0 <= y < H and not bare(x, y):
                p.g[y][x] = rng.choice(("#3e7a32", "#2a5a22", "#4e8a3a"))
            x += rng.choice((-1, 0, 0, 1))
            y -= 1
            if y < 0:
                break


def glyphs(p, x, y, text, c, scale=1):
    """Letters in a tiny 3 x 5 font."""
    font = {"D": "110101101101110", "O": "111101101101111",
            "M": "101111111101101", "I": "111010010010111",
            "N": "110101101101101", "S": "111100111001111",
            "U": "101101101101111", "G": "111100101101111",
            "A": "111101111101101", "R": "110101110101101",
            "B": "110101110101110", "E": "111100110100111",
            "L": "100100100100111", "T": "111010010010010",
            "Z": "111001010100111", " ": "000000000000000"}
    for ch in text:
        bits = font.get(ch, font[" "])
        for k, b in enumerate(bits):
            if b == "1":
                px, py = x + (k % 3) * scale, y + (k // 3) * scale
                p.rect(px, py, px + scale - 1, py + scale - 1, c)
