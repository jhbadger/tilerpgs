def person(shape, hat, coat, hair="#3a2a1a", brim=None, tie=None,
           shirt="#e8e4d8", pants="#2a2a30", shoes="#141414", skin=SKIN):
    return (shape, {"h": hat, "b": brim or hat, "y": hair, "k": skin,
                    "e": EYE, "c": coat, "w": shirt, "t": tie or coat,
                    "p": pants, "s": shoes})


def bare(shape, hair, coat, **kw):
    """Someone without a hat: the hat is their hair."""
    return person(shape, hair, coat, hair=hair, **kw)


