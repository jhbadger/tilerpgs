def lm_fort(p):
    wall, top = "#a8584a", "#c87a5a"
    pts = []
    for k in range(10):
        a = -math.pi / 2 + k * math.pi / 5
        r = 38 if k % 2 == 0 else 22
        pts.append((48 + r * math.cos(a), 42 + r * math.sin(a) * 0.95))
    p.poly(pts, wall)
    inner = [(48 + (x - 48) * 0.78, 42 + (y - 42) * 0.78) for x, y in pts]
    p.poly(inner, top)
    inner2 = [(48 + (x - 48) * 0.62, 42 + (y - 42) * 0.62) for x, y in pts]
    p.poly(inner2, "#5a7a3a")
    for x, y in ((40, 38), (54, 36), (46, 48)):
