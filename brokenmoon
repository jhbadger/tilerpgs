def reachable(a, start, ground):
    seen, q = {start}, deque([start])
    while q:
        x, y = q.popleft()
        for dx, dy in DIRS:
            n = (x + dx, y + dy)
            if n not in seen and a.inside(*n) and a.grid[n[1]][n[0]] in \
                    ground:
                seen.add(n)
                q.append(n)
    return seen


class Headless:
    """Enough of a shell to play the game without a window, for the
    self-test."""
    tap_guard = 0

    def __init__(self):
        self.log = []

    def __getattr__(self, name):
        return lambda *a, **k: None

    def log_add(self, text, tag=None):
        self.log.append(text)

    def after(self, ms, fn, *args):
        return None


class HeadlessScreen:
    def __getattr__(self, name):
        return lambda *a, **k: None

    def size(self):
        return 640, 480

    def linespace(self, font):
        return 16

    def measure(self, font, s):
        return 8 * len(s)

    def text_size(self, text, font):
        lines = text.split("\n")
        return max(len(s) for s in lines) * 8, 16 * len(lines)


def selftest():
    """Build every city, room, level and tune of a few games, and play a
    few hundred turns of each, without a window."""
    tiles = all_tiles()
    for name in TILE_NEEDED:
        assert name in tiles, name
    for seed in range(6):
        w = generate_world(seed)
        flags = set()
        for cid in CITY_ORDER:
            city = make_city(w, cid, flags)
            for name in {t for row in city.grid for t in row}:
                assert name in tiles, (cid, name)
            walk = CITY_GROUND | {"door", "hole", "ward", "steps"}
            seen = reachable(city, city.start, walk)
            for pos, link in city.links.items():
                assert any((pos[0] + dx, pos[1] + dy) in seen
                           for dx, dy in DIRS), (cid, pos, link)
            assert (0, STREET_Y[2]) in seen, cid           # the road out
            for sid in CITIES[cid]["sites"]:
                a = make_interior(w, cid, sid, flags)
                assert a.grid[a.start[1]][a.start[0]] in INSIDE_FLOOR, sid
                for name in {t for row in a.grid for t in row}:
                    assert name in tiles, (cid, sid, name)
            for lm in CITIES[cid]["landmarks"]:
                assert lm[0] in LANDMARKS, lm
        for lid, info in LAIRS.items():
            for level in range(1, info.levels + 1):
                a = make_dungeon(w, lid, level, flags)
                assert a.grid[a.start[1]][a.start[0]] == "stairs_up"
                seen = reachable(a, a.start, DUNGEON_FLOOR | {"gate",
                                                             "stairs_down"})
                if a.down:
                    assert a.down in seen, (lid, level)
                if level == info.levels:
                    assert any((m.x, m.y) in seen or any(
                        (m.x + dx, m.y + dy) in seen for dx, dy in DIRS)
                        for m in a.mobs if m.boss), (lid, level)
                for name in {a.skin.get(t, t) for row in a.grid
                             for t in row}:
                    assert name in tiles, (lid, name)
    for a, b in (("phila", "boston"), ("boston", "washington")):
        assert flight_days(a, b) > 0
    for name, tune in MUSIC.items():
        steps = len(tune["melody"].replace("|", " ").split())
        assert steps == len(tune["chords"].split()) * tune["bar"], name
        for ch in tune["chords"].split():
            for tok in ("R3", "T3", "F3", "S3"):
                chord_note(ch, tok)
        for tok in tune["melody"].replace("|", " ").split():
            if tok not in ".-":
                note_number(tok)
        for _, _, _, pattern in tune["voices"]:
            assert len(pattern.split()) == tune["bar"], name
        assert len(tune["drums"].split()) == tune["bar"], name
    for cid in CITIES:
        assert CITIES[cid]["tune"] in MUSIC, cid
    # play: every class, a few hundred random turns each
    global SAVE_FILE
    keep = SAVE_FILE
    SAVE_FILE = os.path.join(tempfile.gettempdir(), "brokenmoon-test.json")
    try:
        for n, cls in enumerate(CLASSES):
            random.seed(n)
            g = Game.__new__(Game)
            g.shell = Headless()
            g.screen = HeadlessScreen()
            g.sound = type("Quiet", (), {"__getattr__": lambda s, k:
                                         (lambda *a, **kw: None)})()
            g.sound.muted = g.sound.music_off = False
            g.headless = True
            g.destiny_auto = True
            g.zoom_d, g.text_k, g.scale, g.tall = 0, 1.0, 2, False
            g.fit_job = None
            g.shown, g.frame, g.view, g.fx_token = [], 0, (0, 0), 0
            g.overlay = g.overlay_text = g.talk = g.aim = g.menu = None
            g.busy, g.menu_rows, g.walking, g.flights = False, [], None, []
            g.visible, g.cache = set(), {}
            g.avg, g.animated = {}, set()
            g.new_game((cls, "MF"[n % 2], cls, Game.roll_stats(cls)))
            g.view = (21, 15, 0, 0, 32)
            g.shown = [(None, None)] * (21 * 15)
            for city in CITY_ORDER[1:] + ["phila"]:
                if g.overlay:
                    break
                g.travel_to(city)
                for _ in range(120):
                    if g.overlay in ("lost", "doom"):
                        break
                    if g.overlay or g.menu:
                        g.overlay = g.menu = None
                    g.talk = None
                    g.move(*random.choice(DIRS))
                if g.overlay in ("lost", "doom"):
                    break
                if city != "phila" and not g.overlay:
                    g.descend(city)
                    for _ in range(150):
                        if g.overlay in ("lost", "doom"):
                            break
                        g.overlay = g.menu = None
                        if random.random() < 0.1:
                            g.ready_fire()
                            if g.aim:
                                g.aimed(*random.choice(DIRS))
                        else:
                            g.move(*random.choice(DIRS))
                    g.overlay = g.menu = None
                    if g.area.kind == "dungeon":
                        key, pos = g.surface
                        g.enter(g.get_area(tuple(key)), pos)
            g.journal()
            g.show_sheet()
            g.render_chrome()
            g.save()
    finally:
        try:
            os.remove(SAVE_FILE)
        except OSError:
            pass
        SAVE_FILE = keep
    print("ok")


