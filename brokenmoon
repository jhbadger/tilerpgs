def flight_days(frm, to):
    """Days on foot from one city to another, by the roads."""
    dist = {frm: 0}
    q = [frm]
    while q:
        c = q.pop(0)
        for (a, b), d in ROADS.items():
            for x, y in ((a, b), (b, a)):
                if x == c and (y not in dist or dist[c] + d < dist[y]):
                    dist[y] = dist[c] + d
                    q.append(y)
    return dist.get(to)


