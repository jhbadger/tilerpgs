def build_android(dest):
    """A folder for Buildozer to make an Android app of: the game as
    main.py, its icon, a buildozer.spec (written only if there isn't one,
    so that your changes to it stay), and build.sh and the tar it uses,
    for building in Docker (see ANDROID_BUILD and ANDROID_TAR)."""
    os.makedirs(dest, exist_ok=True)
    for name, text in (("tar", ANDROID_TAR), ("build.sh", ANDROID_BUILD)):
        path = os.path.join(dest, name)
        with open(path, "w") as fh:
            fh.write(text)
        os.chmod(path, 0o755)
    shutil.copy(os.path.abspath(__file__), os.path.join(dest, "main.py"))
    with open(os.path.join(dest, "icon.png"), "wb") as fh:
        fh.write(icon_render_png(512))
    spec = os.path.join(dest, "buildozer.spec")
    if not os.path.exists(spec):
        with open(spec, "w") as fh:
            fh.write(ANDROID_SPEC)
    return dest


def icon_args(args):
    """Handle --build-app [DIR], --build-android [DIR] and --icon-png SIZE
    [OUT]; True if handled."""
    if args[:1] == ["--build-android"]:
        print(build_android(args[1] if len(args) > 1 else os.path.join(
            os.path.dirname(os.path.abspath(__file__)), "brokenmoon-android")))
        return True
    if args[:1] == ["--build-app"]:
        print(icon_build_app(args[1] if len(args) > 1 else
                             os.path.dirname(os.path.abspath(__file__))))
        return True
    if args[:1] == ["--icon-png"] and len(args) >= 2:
        with open(args[2] if len(args) > 2 else ICON_NAME + ".png", "wb") as fh:
            fh.write(icon_render_png(int(args[1])))
        return True
    return False


