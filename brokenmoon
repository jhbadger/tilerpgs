    # ── Menus ──

    def open_menu(self, title, items, cancel=None):
        self.menu = {"title": title, "items": items, "sel": 0,
                     "cancel": cancel}
        self.render()

    def menu_move(self, d):
        m = self.menu
        m["sel"] = (m["sel"] + d) % len(m["items"])
        self.render()

    def menu_pick(self, i=None):
        if i in ("up", "down"):
            m = self.menu
            page = m.get("page", 1)
            m["sel"] = max(0, min(len(m["items"]) - 2, m["sel"] + (
                page if i == "down" else -page)))
            self.render()
            return
        m, self.menu = self.menu, None
        self.render()
        m["items"][m["sel"] if i is None else i][1]()

    def menu_cancel(self):
        m, self.menu = self.menu, None
        self.render()
        if m["cancel"]:
            m["cancel"]()

    def draw_menu(self):
        scr, m = self.screen, self.menu
        W, H = scr.size()
        size = 16 if ANDROID else 14
        f, bold = F("Helvetica", size), F("Helvetica", size, "bold")
        rh = scr.linespace(f) + S(16 if ANDROID else 10)
        labels = [label for label, _ in m["items"]]
        title = m["title"]
        tw = scr.measure(bold, title)
        bw = min(W - 20, max([scr.measure(f, t) for t in labels] +
                             [tw]) + 40)
        if tw > bw - 40:
            title = "\n".join(wrap(title, max(20, len(title) * (bw - 40) //
                                              tw)))
        th = (title.count("\n") + 1) * rh
        fit = max(1, (H - 2 * rh - th) // rh)
        n_items = len(labels)
        if n_items <= fit:
            shown = list(enumerate(labels))
        else:
            page = max(1, fit - 3)
            m["page"] = page
            first = max(0, min(m["sel"] - page // 2, n_items - 1 - page))
            shown = [("up", "▲ more" if first else "")] + \
                [(i, labels[i]) for i in range(first, first + page)] + \
                [("down", "▼ more" if first + page < n_items - 1
                  else ""), (n_items - 1, labels[-1])]
        bh = len(shown) * rh + th + 16
        x0, y0 = (W - bw) // 2, max(8, (H - bh) // 2)
        scr.rect(x0, y0, x0 + bw, y0 + bh, fill=PANEL, outline=ACCENT,
                 width=2)
        scr.text(x0 + 20, y0 + 8 + th // 2, title, bold, ACCENT, anchor="w")
        self.menu_rows = []
        for n, (i, label) in enumerate(shown):
            ry = y0 + 8 + th + n * rh
            if i == m["sel"]:
                scr.rect(x0 + 6, ry, x0 + bw - 6, ry + rh, fill="#3a2a18")
            if isinstance(i, str):
                if label:
                    scr.text(x0 + bw // 2, ry + rh // 2, label, f, ACCENT)
                    self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))
                continue
            scr.text(x0 + 20, ry + rh // 2, label, f, INK, anchor="w")
            self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))

    def action_menu(self):
        if self.busy or self.talk:
            return
        if self.overlay not in ("won", "doom", "lost"):
            self.overlay = None
        items = [("Help", self.show_help), ("Journal", self.journal),
                 ("Your hero", self.show_sheet), ("Map", self.toggle_map),
                 ("Search here", self.search), ("Rest an hour", self.rest),
                 ("Destiny Points: %s" % ("used when needed"
                                          if self.destiny_auto
                                          else "kept"), self.toggle_destiny),
                 ("Zoom in", lambda: self.zoom(1)),
                 ("Zoom out", lambda: self.zoom(-1)),
                 ("Bigger text", lambda: self.text_size(1)),
                 ("Smaller text", lambda: self.text_size(-1)),
                 ("Sound effects %s" % ("on" if self.sound.muted else "off"),
                  self.toggle_mute),
                 ("Music %s" % ("on" if self.sound.music_off else "off"),
                  self.toggle_music),
                 ("New game", self.ask_new_game), ("Quit", self.quit)]
        if self.overlay in ("won", "doom", "lost"):
            items = [("New game", self.new_game), ("Quit", self.quit)]
            if self.overlay == "won":
                items.insert(1, ("Stay a while", self.close_won))
        self.open_menu("Broken Moon", items)

    def toggle_destiny(self):
        self.destiny_auto = not self.destiny_auto
        self.say("Destiny Points will be %s." % (
            "spent when you'd fall" if self.destiny_auto
            else "kept, whatever happens"), "info")
        self.save()

    def close_won(self):
        self.overlay = None
        self.render()

    def on_tap(self, ev):
        self.walking = None
        if self.menu:
            for x0, y0, x1, y1, i in self.menu_rows:
                if x0 <= ev.x <= x1 and y0 <= ev.y <= y1:
                    self.menu_pick(i)
                    return
            if not self.talk:
                self.menu_cancel()
            return
        if self.busy or self.talk:
            return
        if self.overlay:
            self.close_overlay()
            return
        cols, rows, ox, oy, ts = self.view
        tx = self.pos[0] - cols // 2 + (ev.x - ox) // ts
        ty = self.pos[1] - rows // 2 + (ev.y - oy) // ts
        dx, dy = tx - self.pos[0], ty - self.pos[1]
        step = ((1 if dx > 0 else -1, 0) if abs(dx) >= abs(dy)
                else (0, 1 if dy > 0 else -1))
        if self.aim:
            if (dx, dy) == (0, 0):
                self.aim = None
                self.say("Never mind.", "info")
            else:
                self.aimed(*step)
        elif (dx, dy) == (0, 0):
            self.wait()
        elif abs(dx) + abs(dy) == 1:
            self.move(dx, dy)
        else:
            self.walk_to(tx, ty)

    def passable(self, x, y, goal):
        a = self.area
        if not a.inside(x, y):
            return False
        if (x, y) == goal:
            return True
        t = a.grid[y][x]
        if a.mob_at(x, y) or (x, y) in a.links:
            return False
        return t in WALKABLE and t not in ("stairs_up", "stairs_down",
                                           "exit", "glyph")

    def walk_to(self, tx, ty):
        start, goal = tuple(self.pos), (tx, ty)
        prev = {start: None}
        q = deque([start])
        while q and goal not in prev:
            x, y = q.popleft()
            if abs(x - start[0]) + abs(y - start[1]) > 50:
                continue
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if n not in prev and self.passable(n[0], n[1], goal):
                    prev[n] = (x, y)
                    q.append(n)
        if goal not in prev:
            self.say("You can't find a way there.", "info")
            return
        path = []
        while goal != start:
            path.append(goal)
            goal = prev[goal]
        self.walking = path[::-1]
        self.walk_area = self.area
        self.walk_seen = self.hostiles_in_view()
        self.walk_step()

    def hostiles_in_view(self):
        return {id(m) for m in self.area.mobs
                if m.hostile and (m.x, m.y) in self.visible}

    def walk_step(self):
        if (not self.walking or not self.ready()
                or self.area is not self.walk_area):
            self.walking = None
            return
        x, y = self.walking.pop(0)
        before = tuple(self.pos)
        self.move(x - before[0], y - before[1])
        if (tuple(self.pos) != (x, y) or self.hostiles_in_view() -
                self.walk_seen):
            self.walking = None
            return
        if self.walking:
            self.shell.after(90, self.walk_step)

    def wait(self):
        if not self.ready():
            return
        p = self.p
        if p["held"]:
            p["held"] -= 1
        self.say("You wait.", "info")
        self.end_turn()

    # ── Drawing ──

    def layout(self):
        if not getattr(self, "area", None):
            return
        scr = self.screen
        scale = self.auto_scale()
        if scale != self.scale:
            self.scale = scale
            scr.set_scale(scale)
        ts = 16 * self.scale
        W, H = scr.size()
        W, H = max(W, ts * 5), max(H, ts * 5)
        cols, rows = W // ts, H // ts
        cols -= 1 - cols % 2
        rows -= 1 - rows % 2
        ox, oy = (W - cols * ts) // 2, (H - rows * ts) // 2
        self.view = (cols, rows, ox, oy, ts)
        scr.grid(cols, rows, ox, oy, ts)
        self.shown = [(None, None)] * (cols * rows)
        self.render()

    @staticmethod
    def line_clear(a, x0, y0, x1, y1):
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        x, y = x0, y0
        while (x, y) != (x1, y1):
            if (x, y) != (x0, y0) and a.grid[y][x] in a.opaque:
                return False
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x += sx
            if e2 <= dx:
                err += dx
                y += sy
        return True

    def light_radius(self):
        a, p = self.area, self.p
        if a.dark:
            if p["torch"]:
                return 6
            if p["cls"] in DARKSIGHT or \
                    self.turn < p["until"].get("deathsight", -1):
                return 4
            return 1
        if a.kind != "city":
            return None
        ph = self.phase()
        return None if ph == "day" else 9 if ph in ("dawn", "dusk") else 5

    def compute_visible(self):
        a = self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        r = self.light_radius()
        r2 = r * r if r else None
        lit = getattr(a, "lit", set()) if r else set()
        vis = set()
        for y in range(max(0, py - rows // 2), min(a.h, py + rows // 2 + 1)):
            for x in range(max(0, px - cols // 2),
                           min(a.w, px + cols // 2 + 1)):
                if r2 and (x - px) ** 2 + (y - py) ** 2 > r2 and \
                        (x, y) not in lit:
                    continue
                if self.line_clear(a, px, py, x, y):
                    vis.add((x, y))
                    a.seen[y * a.w + x] = 1
        return vis

    def render(self):
        if not self.shown or not getattr(self, "area", None) or \
                not getattr(self, "p", None):
            return
        scr, a = self.screen, self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        self.visible = vis = self.compute_visible()
        dim = a.dark or self.light_radius() is not None
        mobs = {(m.x, m.y): m for m in a.mobs}
        x0, y0 = px - cols // 2, py - rows // 2
        me = self.hero_tile()
        for j in range(rows):
            y = y0 + j
            for i in range(cols):
                x = x0 + i
                base = top = None
                if a.inside(x, y):
                    t = a.grid[y][x]
                    if (x, y) in vis:
                        base = self.framed(a.skin.get(t, t))
                        m = mobs.get((x, y))
                        if m:
                            top = "zzz" if m.asleep and (
                                self.frame and m.hostile) else m.tile
                        else:
                            top = a.items.get((x, y))
                    elif dim and a.seen[y * a.w + x]:
                        base = "~" + a.skin.get(t, t)
                elif a.edge:
                    base = self.framed(a.edge)
                if x == px and y == py:
                    top = "web" if self.p["held"] and self.frame else me
                top = self.framed(top)
                idx = j * cols + i
                old = self.shown[idx]
                if old == (base, top):
                    continue
                self.shown[idx] = (base, top)
                if base != old[0]:
                    scr.cell(idx, 0, base)
                if top != old[1]:
                    scr.cell(idx, 1, top)
        scr.clear_overlay()
        if self.overlay == "map":
            self.draw_map()
        elif self.overlay == "help":
            self.draw_text_box(HELP)
        elif self.overlay in ("sheet", "journal"):
            self.draw_text_box(self.overlay_text)
        elif self.overlay in ("won", "doom", "lost"):
            self.draw_text_box(self.overlay_text,
                               ACCENT if self.overlay == "won" else BAD)
        if self.menu:
            self.draw_menu()
        self.render_chrome()

    def flash(self, x, y, tile="hit"):
        cols, rows, ox, oy, ts = self.view
        i = x - self.pos[0] + cols // 2
        j = y - self.pos[1] + rows // 2
        if not (0 <= i < cols and 0 <= j < rows):
            return
        self.fx_token += 1
        token = self.fx_token
        self.screen.sprite("fx", ox + i * ts, oy + j * ts, tile)

        def hide():
            if token == self.fx_token:
                self.screen.sprite("fx", 0, 0, None)
        self.shell.after(160, hide)

    def draw_text_box(self, text, color=INK):
        scr = self.screen
        W, H = scr.size()
        w, h = scr.text_size(text, F(*MONO))
        x0, y0 = (W - w) / 2, (H - h) / 2
        scr.rect(x0 - 20, y0 - 16, x0 + w + 20, y0 + h + 16, fill=PANEL,
                 outline=ACCENT, width=2)
        scr.text(W / 2, H / 2, text, F(*MONO), color)

    def draw_map(self):
        scr = self.screen
        W, H = scr.size()
        a = self.area if self.area.kind == "dungeon" else \
            self.get_area(("city", self.city))
        rows = []
        for y in range(a.h):
            row = []
            for x in range(a.w):
                if not a.seen[y * a.w + x]:
                    row.append("#000000")
                else:
                    t = a.grid[y][x]
                    row.append("#e05040" if t in ("door", "hole", "ward",
                                                  "ward_open",
                                                  "stairs_down",
                                                  "stairs_up") else
                               "#f0a040" if t == "campfire" else
                               self.avg.get(a.skin.get(t, t), "#808080"))
            rows.append(row)
        z = max(1, min((W - 20) // a.w, (H - 50) // a.h))
        scr.rect(0, 0, W, H, fill="#000000")
        mx, my = (W - a.w * z) // 2, (H - a.h * z) // 2 + 10
        scr.map_image(rows, z, mx, my)
        small = F("Helvetica", 9 if z < 9 else 11)
        for (x, y), name in a.labels.items():
            if a.seen[y * a.w + x]:
                scr.text(mx + (x + 0.5) * z, my + y * z - 2,
                         name.replace("the ", "", 1), small, "#ffffff",
                         anchor="s")
        if self.area is a:
            px, py = self.pos
        else:
            px, py = self.city_pos.get(self.city) or a.start
        scr.rect(mx + px * z - 2, my + py * z - 2, mx + (px + 1) * z + 2,
                 my + (py + 1) * z + 2, outline="#ffff00", width=2)
        title = a.name if a.kind == "dungeon" else "%s, %s" % (
            CITIES[self.city]["name"], CITIES[self.city]["short"])
        scr.text(W / 2, my - 14, "%s   (red: ways in; any key closes)" %
                 title, F(*MONO), ACCENT)

    def render_chrome(self):
        p = self.p
        a = self.area
        if a.kind == "city":
            here = "%s: %s" % (CITIES[self.city]["name"],
                               district(self.city, *self.pos))
            near = [a.labels[(self.pos[0] + dx, self.pos[1] + dy)]
                    for dx, dy in DIRS + ((0, 0),)
                    if (self.pos[0] + dx, self.pos[1] + dy) in a.labels]
            if near:
                here += ", by " + near[0]
        elif a.kind == "inside":
            here = "%s, %s" % (a.name, CITIES[a.city]["name"])
        else:
            here = a.name
        self.shell.set_status(cap(here))
        left = self.days_left()
        self.shell.set_clock("%s   (%s to the Red Shard)" % (
            cap(self.date_text()), "%dd %dh" % (left // DAY, left % DAY // 60)
            if left >= DAY else "%dh %dm" % (left // 60, left % 60)))
        lines = [p["name"], "Level %d %s" % (p["level"], p["cls"]), "",
                 "HP      %d/%d" % (p["hp"], p["maxhp"]),
                 "Destiny %d" % p["destiny"],
                 "Coins   %d" % p["coins"], "",
                 "STR %2d  DEX %2d  CON %2d" % tuple(self.stat(s)
                                                    for s in STATS[:3]),
                 "INT %2d  WIS %2d  CHA %2d" % tuple(self.stat(s)
                                                    for s in STATS[3:]),
                 "", "Holding", "  " + p["melee"]]
        if p["ranged"]:
            ammo = WEAPONS[p["ranged"]].ammo
            lines.append("  %s (%s)" % (
                p["ranged"], "d%d" % p["usage"][ammo]
                if p["usage"].get(ammo) else "empty"))
        lines.append("  %s%s" % (p["armor"] or "no armor",
                                 ", " + p["shield"] if p["shield"] else ""))
        sup = [(k, v) for k, v in sorted(p["usage"].items())
               if v and k not in ("arrows", "stones", "darts",
                                  "energy cells", "rifle rounds")]
        if sup or p["count"].get("salve"):
            lines += ["Supplies"] + ["  %s d%d" % (k, v) for k, v in sup]
            if p["count"].get("salve"):
                lines.append("  salve x%d" % p["count"]["salve"])
        lines += ["", "Moonstones %d/3" % len(p["stones"])]
        self.show_panel(lines)
        cond = []
        if p["hp"] <= p["maxhp"] // 4:
            cond.append("BADLY HURT")
        if p["hungry"]:
            cond.append("HUNGRY")
        if p["poison"]:
            cond.append("POISONED")
        if p["held"]:
            cond.append("HELD FAST")
        if self.turn < p["until"].get("fathead", -1):
            cond.append("FAT HEAD")
        if self.turn < p["until"].get("ward", -1):
            cond.append("WARDED")
        if self.turn < p["until"].get("hide", -1):
            cond.append("THICK HIDE")
        if p["torch"]:
            cond.append("TORCH LIT")
        if self.turn < p["until"].get("burnt", -1):
            cond.append("MAGIC BURNT OUT")
        if self.days_left() < DAY:
            cond.append("THE RED SHARD RISES")
        self.shell.set_condition("\n".join(cond))
        if a.kind == "city":
            tune = CITIES[self.city]["tune"]
        elif a.kind == "inside":
            tune = "inside"
        else:
            tune = "lair" if a.lead == "washington" else "dungeon"
        self.sound.tune = tune

    # ── Commands ──

    def toggle_map(self):
        if self.busy or self.talk:
            return
        self.overlay = None if self.overlay == "map" else "map"
        self.render()

    def show_help(self):
        if self.busy or self.talk:
            return
        self.overlay = None if self.overlay == "help" else "help"
        self.render()

    def zoom(self, d):
        z = max(-2, min(2, self.zoom_d + d))
        if z != self.zoom_d:
            self.zoom_d = z
            self.layout()

    def auto_scale(self):
        """Tiles big enough that the shorter side of the map shows about
        thirteen, plus however far the player has zoomed."""
        short = min(self.screen.size())
        return max(1, min(MAX_ZOOM, round(short / (16 * 13)) + self.zoom_d))

    def on_resize(self):
        if self.fit_job is not None:
            self.shell.cancel(self.fit_job)
        self.fit_job = self.shell.after(80, self.fit)

    def fit(self, force=False):
        """Scale the fonts, the side panel and the buttons to the window:
        a wide window has the panel at the side and one row of buttons, a
        tall one (a phone held upright) the panel underneath and two."""
        self.fit_job = None
        if self.shell.dialog_shrunk() and not force:
            return
        W, H = self.shell.window_size()
        if W < 100 or H < 100:
            return
        tall = H > W * 1.15
        u = min(W / 620, H / 1000) if tall else min(W / 1000, H / 740)
        u = max(0.6, min(4.0, u)) * self.text_k
        if not force and abs(u - UI[0]) < 0.02 and \
                tall == getattr(self, "tall", None):
            return
        self.tall = tall
        self.shell.set_ui_scale(u)
        self.shell.arrange(tall, W)
        if hasattr(self, "panel_lines"):
            self.show_panel(self.panel_lines)
        self.layout()

    def show_panel(self, lines):
        """The side panel: one column beside the map, or two underneath it
        on a phone held upright, split at the blank line nearest halfway."""
        self.panel_lines = lines
        if not self.tall or len(lines) < 8:
            self.shell.set_panel(lines)
            return
        mid = len(lines) // 2
        cuts = [i for i, line in enumerate(lines) if not line.strip()]
        cut = min(cuts, key=lambda i: abs(i - mid)) if cuts else mid
        if abs(cut - mid) > len(lines) // 4:
            cut = mid
        first, second = lines[:cut], lines[cut:]
        while second and not second[0].strip():
            second = second[1:]
        self.shell.set_panel(first, second)

    def text_size(self, d):
        i = TEXT_SIZES.index(self.text_k) + d
        if 0 <= i < len(TEXT_SIZES):
            self.text_k = TEXT_SIZES[i]
            self.fit(True)
            self.say("(Text size %d%%.)" % round(self.text_k * 100), "info")

    def toggle_mute(self):
        self.sound.muted = not self.sound.muted
        self.render_chrome()

    def toggle_music(self):
        self.sound.music_off = not self.sound.music_off
        self.sound.tick()
        self.render_chrome()

    def ask_new_game(self):
        if self.busy:
            return
        if self.overlay in ("won", "doom", "lost"):
            self.new_game()
            return
        self.open_menu("Abandon this legend and start a new one?", [
            ("Yes, start again", self.new_game),
            ("No, keep playing", lambda: None)])



def cap(s):
    return s[:1].upper() + s[1:]


def wrap(text, width):
    out, line = [], ""
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            out.append(line)
            line = "  " + word if text.startswith("  ") else word
        else:
            line = (line + " " + word) if line else word
    if line:
        out.append(line)
    return out


def compass(dx, dy):
    ns = "north" if dy < 0 else "south" if dy > 0 else ""
    ew = "west" if dx < 0 else "east" if dx > 0 else ""
    if abs(dy) > 2 * abs(dx):
        ew = ""
    elif abs(dx) > 2 * abs(dy):
        ns = ""
    return "-".join(s for s in (ns, ew) if s) or "here"


def where(frm, to):
    return "to the " + compass(to[0] - frm[0], to[1] - frm[1])


