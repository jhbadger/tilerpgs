def make_person(world, cid, role, x, y):
    rng = random.Random("%s:%s:%s:%d:%d" % (world["seed"], cid, role, x, y))
    if role == "captive":
        sex = rng.choice("MF")
        m = Mob("captive" if sex == "M" else "captive_f",
                rng.choice(FIRST[sex]), x, y)
        m.role = "captive"
        m.title = "a chained " + ("man" if sex == "M" else "woman")
        m.greet = rng.choice(("Please... the key's on the guard.",
                              "Are you here to buy us?",
                              "Water. Please."))
        m.city = cid
        return m
    tile, name, title, greet = FIXED.get((cid, role)) or FIXED.get(
        ("phila", role)) or ("survivor", rng.choice(FIRST["M"]),
                             "a survivor", "Hello.")
    m = Mob(tile, name, x, y)
    m.role = role
    m.city = cid
    m.title = title
    m.greet = greet
    m.talk = dict(ROLE_TALK.get(role, {}))
    m.talk.update(CITY_TALK.get(cid, {}).get(role, {}))
    if role in ("trader", "smith", "stablehand"):
        m.shop = role if cid == "phila" or role != "trader" else "camp"
    return m


def make_folk(world, cid, rng, i, x, y):
    sex = rng.choice("MF")
    tile = rng.choice([t for t in TOWNSFOLK_TILES
                       if (t in WOMEN_TILES) == (sex == "F")])
    m = Mob(tile, rng.choice(FIRST[sex]), x, y)
    m.city = cid
    m.role = "folk"
    m.title = rng.choice(("a survivor", "a forager", "a scrapper",
                          "a gardener", "a lookout", "a water-carrier"))
    # Each has a say of his or her own, from a random of their own (so
    # as not to move anyone else), and a piece of news no neighbour has.
    own = random.Random("%s:folk:%s:%d" % (world["seed"], cid, i))
    news = list(TOWNS_TALK[cid])
    random.Random("%s:news:%s" % (world["seed"], cid)).shuffle(news)
    m.greet = own.choice(FOLK_GREETS + CITY_GREETS.get(cid, []))
    m.talk = {"news": news[i % len(news)],
              "job": own.choice(FOLK_JOBS.get(m.title,
                                              FOLK_JOBS["a survivor"]))}
    for topic, views in FOLK_VIEWS.items():
        m.talk[topic] = own.choice(views)
    m.roam = CITY_GROUND - {"bridge"}
    m.home = (x, y)
    return m


