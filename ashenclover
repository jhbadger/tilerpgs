def grass(rng):
    g = grid_of(GRASS[0])
    speckle(g, rng, GRASS[1:3], 0.35)
    speckle(g, rng, GRASS[3:], 0.03)
    return g


def stone_blocks(rng, base, mortar, bw=6, bh=4):
    g = grid_of(mortar)
    for row in range(16 // bh):
        off = (row % 2) * (bw // 2)
        for x in range(-bw, 16, bw):
            c = shade(base, rng.uniform(0.88, 1.1))
            rect(g, x + off, row * bh, x + off + bw - 2, row * bh + bh - 2, c)
    return g


def planks(rng, base, seam, vertical=False, width=4):
    g = grid_of(base)
    for y in range(16):
        for x in range(16):
            a, b = (x, y) if vertical else (y, x)
            if a % width == width - 1:
                g[y][x] = seam
            elif rng.random() < 0.08:
                g[y][x] = shade(base, 0.9)
    for i in range(4):          # butt joints
        a = rng.randrange(16)
        b = i * width + rng.randrange(width - 1)
        if vertical:
            g[a][min(15, b)] = seam
        else:
            g[min(15, b)][a] = seam
    return g


def water(rng, phase, base="#1c3a4e"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.12)], 0.3)
    for y in range(2, 16, 4):
        x0 = (y * 5 + phase * 3) % 16
        for k in range(4):
            g[y][(x0 + k) % 16] = shade(base, 1.7)
    return g


def roof(rng, base):
    g = grid_of(base)
    dark = shade(base, 0.72)
    for y in range(16):
        if y % 4 == 3:
            for x in range(16):
                g[y][x] = dark
        else:
            for x in range((y // 4) * 2 % 4, 16, 4):
                g[y][x] = shade(base, 0.85)
    speckle(g, rng, [shade(base, 1.12)], 0.06)
    return g


def tree(rng, colours, ground=None):
    g = ground or grass(rng)
    rect(g, 7, 11, 8, 15, "#4a3020")
    light, mid, dark = colours
    disc(g, 7.5, 7, 6.6, dark, rng, 0.6)
    disc(g, 7.5, 6.5, 5.6, mid, rng, 0.6)
    disc(g, 6, 5, 2.6, light, rng, 0.5)
    speckle_within(g, rng, mid, [light, dark], 0.12)
    return g


def bookshelf(rng, colours=("#7a1e1e", "#1e3a6a", "#2e5a2e", "#6a5a1e",
                            "#3a2a4a", "#8a6a3a", "#1a1a1a")):
    g = grid_of("#4a3020")
    for shelf in (1, 6, 11):
        x = 1
        while x < 15:
            w = rng.choice((1, 1, 2))
            c = rng.choice(colours)
            top = shelf + rng.choice((0, 0, 1))
            rect(g, x, top, min(14, x + w - 1), shelf + 3, c)
            x += w
        rect(g, 0, shelf + 4, 15, shelf + 4, "#2e1c10")
    return g


def pave(rng, base="#8e8a80", line="#76726a"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.05), shade(base, 0.95)], 0.25)
    for i in range(16):
        g[7][i] = g[15][i] = line
        g[i][7] = g[i][15] = line
    return g


def asphalt(rng):
    g = grid_of("#3e3e42")
    speckle(g, rng, ["#46464a", "#36363a", "#4c4c50"], 0.35)
    return g


def facade_roof(rng, base, trim, chimneys=True):
    """A city rooftop, seen from above: slates, a parapet and chimneys."""
    g = roof(rng, base)
    rect(g, 0, 0, 15, 0, trim)
    rect(g, 0, 15, 15, 15, shade(trim, 0.7))
    if chimneys:
        x = rng.randrange(2, 12)
        rect(g, x, 3, x + 2, 5, "#7a4a3a")
        rect(g, x, 3, x + 2, 3, "#a86a5a")
    return g



def poly_fill(g, pts, c):
    xs = [p[0] for p in pts]
    ys = [p[1] for p in pts]
    for y in range(max(0, int(min(ys))), min(len(g), int(max(ys)) + 1)):
        for x in range(max(0, int(min(xs))), min(len(g[0]), int(max(xs)) + 1)):
            if inside_poly(x + 0.5, y + 0.5, pts):
                g[y][x] = c




def cracks(g, rng, colour, n=3, length=7):
    """Random cracks: short wandering lines."""
    for _ in range(n):
        x, y = rng.randrange(16), rng.randrange(16)
        for _ in range(length):
            g[y][x] = colour
            x = min(15, max(0, x + rng.choice((-1, 0, 1))))
            y = min(15, max(0, y + rng.choice((-1, 0, 1, 1))))


def weeds_in(g, rng, p=0.08):
    for y in range(16):
        for x in range(16):
            if rng.random() < p:
                g[y][x] = rng.choice(GRASS[:3])
                if y > 0 and rng.random() < 0.5:
                    g[y - 1][x] = GRASS[1]


def rubble_pile(g, rng, base="#7a746a"):
    for _ in range(9):
        cx, cy = rng.uniform(2, 13), rng.uniform(4, 13)
        disc(g, cx, cy, rng.uniform(1.5, 3.2),
             shade(base, rng.uniform(0.7, 1.2)))
    for _ in range(4):
        x = rng.randrange(1, 13)
        y = rng.randrange(2, 13)
        rect(g, x, y, x + rng.randrange(2, 4), y, "#5a3a2a")   # rebar


def ruin_roof(rng, base, holes=3):
    """A ruined building seen from above: broken slabs, holes into dark
    rooms, weeds on top."""
    g = grid_of(base)
    speckle(g, rng, [shade(base, 0.9), shade(base, 1.08)], 0.3)
    for y in (5, 10):
        rect(g, 0, y, 15, y, shade(base, 0.75))
    for _ in range(holes):
        cx, cy = rng.uniform(4, 11), rng.uniform(4, 11)
        r = rng.uniform(1.8, 3.0)
        disc(g, cx, cy, r + 0.9, shade(base, 0.62))      # the broken rim
        disc(g, cx, cy, r, "#2a2420")                    # the room below
        rect(g, int(cx) - 1, int(cy + r * 0.4), int(cx) + 1,
             int(cy + r * 0.4), "#4a3e34")               # a fallen joist
    cracks(g, rng, shade(base, 0.6), 2, 6)
    weeds_in(g, rng, 0.05)
    rect(g, 0, 0, 15, 0, shade(base, 1.2))
    return g


def wreck(rng, g, body):
    """A rusted car, its glass long gone."""
    rect(g, 1, 4, 14, 11, body)
    rect(g, 4, 2, 11, 4, shade(body, 0.9))
    rect(g, 5, 3, 7, 4, "#1a1a1a")
    rect(g, 8, 3, 10, 4, "#1a1a1a")
    speckle_within(g, rng, body, ["#7a3a1a", "#5a2a14", "#9a5a2a"], 0.35)
    rect(g, 2, 11, 4, 12, "#141414")
    rect(g, 11, 11, 13, 12, "#141414")
    return g


def draw_terrain(name, frame=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random(name + str(frame))
    # ── the ruined streets ──
    if name == "grass":
        return grass(rng)
    if name == "weeds":
        g = grass(rng)
        for x in range(0, 16, 2):
            h = rng.randrange(3, 8)
            y0 = rng.randrange(8, 16)
            rect(g, x, y0 - h, x, y0, rng.choice(("#6a8a3a", "#8a9a4a",
                                                  "#4e6a32")))
        return g
    if name == "road":
        g = asphalt(rng)
        cracks(g, rng, "#26262a", 3, 8)
        weeds_in(g, rng, 0.04)
        return g
    if name == "cracked":
        g = asphalt(rng)
        disc(g, rng.uniform(4, 11), rng.uniform(4, 11), 3.2, "#2a2622", rng,
             0.7)
        cracks(g, rng, "#26262a", 5, 9)
        weeds_in(g, rng, 0.09)
        return g
    if name == "pave":
        g = pave(rng, "#8a8478", "#6e695f")
        cracks(g, rng, "#5a564e", 3, 6)
        weeds_in(g, rng, 0.06)
        return g
    if name == "square":
        g = pave(rng, "#a09888", "#82796c")
        for i in range(16):
            g[i][i] = g[i][15 - i] = "#90877a"
        cracks(g, rng, "#6a6458", 3, 7)
        weeds_in(g, rng, 0.04)
        return g
    if name == "steps":
        g = grid_of("#b8b0a0")
        for y in range(0, 16, 4):
            rect(g, 0, y + 3, 15, y + 3, "#8a8274")
        cracks(g, rng, "#7a7264", 2, 6)
        weeds_in(g, rng, 0.04)
        return g
    if name == "path":
        g = grid_of("#8a7a58")
        speckle(g, rng, ["#9a8a68", "#7a6a48", "#a89870"], 0.4)
        return g
    if name == "dirt":
        g = grid_of("#6a5236")
        speckle(g, rng, ["#7a6040", "#5a4430", "#86704c"], 0.4)
        return g
    if name == "sand":
        g = grid_of("#c8b488")
        speckle(g, rng, ["#d8c498", "#b8a478", "#e0d0a8"], 0.4)
        return g
    if name == "ash":
        g = grid_of("#7a7670")
        speckle(g, rng, ["#8a8680", "#6a6662", "#5e5a56"], 0.45)
        return g
    if name == "bog":
        g = grid_of("#3a4a2a")
        speckle(g, rng, ["#4a5a32", "#2e3e22", "#5a6a3a"], 0.4)
        for _ in range(4):
            disc(g, rng.uniform(2, 13), rng.uniform(2, 13), 1.6,
                 "#2a3a3a" if frame == 0 else "#324242")
        return g
    if name == "debris":
        g = asphalt(rng)
        for _ in range(7):
            x, y = rng.randrange(1, 14), rng.randrange(1, 14)
            rect(g, x, y, x + rng.randrange(1, 3), y + rng.randrange(0, 2),
                 rng.choice(("#7a746a", "#8a5a3a", "#5a5a5a")))
        weeds_in(g, rng, 0.05)
        return g
    if name == "rubble":
        g = asphalt(rng)
        rubble_pile(g, rng)
        weeds_in(g, rng, 0.04)
        return g
    if name in ("tree", "tree_dead", "bush"):
        if name == "tree_dead":
            g = grass(rng)
            rect(g, 7, 4, 8, 15, "#4a3a2a")
            for x0, y0, x1, y1 in ((8, 6, 13, 2), (7, 8, 2, 4), (8, 4, 10, 0),
                                   (7, 5, 4, 1)):
                poly_fill(g, [(x0, y0), (x1, y1), (x1 + 1, y1),
                              (x0 + 1, y0 + 1)], "#4a3a2a")
            return g
        if name == "bush":
            g = grass(rng)
            disc(g, 7.5, 9, 6, "#2e5a2a", rng, 0.8)
            speckle_within(g, rng, "#2e5a2a", ["#3a6a32", "#244a20",
                                               "#c84a6a"], 0.18)
            return g
        return tree(rng, ("#6a9a4a", "#3e7a32", "#2a5a22"),
                    ground=asphalt(rng) if rng.random() < 0.3 else None)
    if name == "water":
        return water(rng, frame, "#1e3a44")
    if name == "bridge":
        g = stone_blocks(rng, "#8a8478", "#6a645a", 8, 4)
        rect(g, 0, 0, 15, 1, "#4a4640")
        rect(g, 0, 14, 15, 15, "#4a4640")
        cracks(g, rng, "#4a463e", 2, 6)
        return g
    if name == "quay":
        g = stone_blocks(rng, "#9a9284", "#7a7264", 8, 8)
        weeds_in(g, rng, 0.05)
        return g
    if name == "pier":
        g = planks(rng, "#6a5236", "#3a2a18", vertical=True)
        for _ in range(3):
            x = rng.randrange(1, 15)
            rect(g, x, rng.randrange(0, 8), x, 15, "#1e3a44")
        return g
    if name in ("wreck", "wreck2", "bus"):
        g = asphalt(rng)
        if name == "bus":
            rect(g, 0, 1, 15, 14, "#a07a2a")
            for x in range(1, 15, 3):
                rect(g, x, 3, x + 1, 6, "#1a1a1a")
            speckle_within(g, rng, "#a07a2a", ["#7a3a1a", "#5a2a14"], 0.4)
            weeds_in(g, rng, 0.06)
            return g
        return wreck(rng, g, "#6a3a2a" if name == "wreck" else "#4a5a6a")
    if name == "lamp":
        g = pave(rng, "#8a8478", "#6e695f")
        rect(g, 7, 2, 8, 15, "#4a3a32")
        rect(g, 8, 2, 12, 3, "#4a3a32")
        rect(g, 11, 4, 12, 5, "#2a2a2a")
        weeds_in(g, rng, 0.05)
        return g
    if name == "sign":
        g = pave(rng, "#8a8478", "#6e695f")
        rect(g, 7, 6, 8, 15, "#5a5a5a")
        rect(g, 1, 1, 14, 6, "#2a6a3a")
        rect(g, 2, 3, 12, 4, "#d8d8d0")
        speckle_within(g, rng, "#2a6a3a", ["#7a3a1a"], 0.25)
        return g
    if name == "hydrant":
        g = pave(rng, "#8a8478", "#6e695f")
        rect(g, 5, 4, 10, 14, "#a02a20")
        rect(g, 4, 7, 11, 8, "#a02a20")
        rect(g, 6, 2, 9, 4, "#801a14")
        return g
    if name == "campfire":
        g = grid_of("#5a4a36")
        speckle(g, rng, ["#6a5640", "#4a3a28"], 0.4)
        for a in range(8):
            x = 7.5 + 5 * math.cos(a * math.pi / 4)
            y = 8 + 5 * math.sin(a * math.pi / 4)
            disc(g, x, y, 1.3, "#7a7470")
        rect(g, 4, 10, 11, 11, "#4a2e18")
        rect(g, 6, 8, 9, 12, "#4a2e18")
        flame = ("#f0d040", "#f07020") if frame == 0 else ("#f07020",
                                                          "#f0d040")
        poly_fill(g, [(5, 11), (10, 11), (8, 2 + frame)], flame[1])
        poly_fill(g, [(6, 11), (9, 11), (7.5, 5)], flame[0])
        return g
    if name == "tent":
        g = grid_of("#6a5236")
        poly_fill(g, [(0, 15), (16, 15), (8, 1)], "#8a7a5a")
        poly_fill(g, [(8, 1), (16, 15), (8, 15)], "#6a5a42")
        poly_fill(g, [(6, 15), (10, 15), (8, 8)], "#2a2016")
        return g
    if name == "palisade":
        g = grid_of("#6a5236")
        for x in range(0, 16, 4):
            rect(g, x, 0, x + 2, 15, "#7a5a32")
            rect(g, x, 0, x, 15, "#5a4224")
            poly_fill(g, [(x, 2), (x + 3, 2), (x + 1.5, -1)], "#8a6a3a")
        rect(g, 0, 6, 15, 7, "#4a3218")
        return g
    if name == "garden":
        g = grid_of("#5a4430")
        for y in range(1, 16, 4):
            rect(g, 0, y, 15, y + 1, "#4a3420")
            for x in range(1, 16, 3):
                rect(g, x, y - 1, x + 1, y, "#4e8a3a")
                g[y - 1][x] = "#c8402a" if (x + y) % 2 else "#e0c040"
        return g
    # ── buildings, from above: the ruins and the camps ──
    if name.startswith("b_"):
        base = {"b_brick": "#8a4a36", "b_concrete": "#8a8a84",
                "b_glass": "#3a4a52", "b_stone": "#a8a090",
                "b_vines": "#6a6a5a", "b_white": "#c8c4b8",
                "b_hut": "#7a6040", "b_gold": "#9a8030",
                "b_shack": "#6a6058"}.get(name, "#8a8a84")
        if name == "b_hut":
            g = roof(rng, base)
            speckle(g, rng, ["#8a7050", "#6a5030"], 0.2)
            rect(g, 0, 0, 15, 0, "#5a4428")
            return g
        if name == "b_shack":
            g = grid_of(base)
            for y in range(0, 16, 4):
                rect(g, 0, y, 15, y, "#4a4038")
                for x in range(rng.randrange(2), 16, 5):
                    rect(g, x, y + 1, x + 3, y + 3,
                         rng.choice(("#7a5a3a", "#5a6a7a", "#8a3a2a",
                                     "#6a6058")))
            return g
        g = ruin_roof(rng, base, holes=1 if name in ("b_gold",
                                                    "b_white") else 2)
        if name == "b_glass":
            for x in range(1, 16, 4):
                rect(g, x, 1, x + 1, 14, "#2a3a42")
            speckle_within(g, rng, "#2a3a42", ["#6a8a9a", "#9ab8c8"], 0.1)
        if name == "b_vines":
            speckle(g, rng, ["#3e7a32", "#2a5a22", "#4e6a32"], 0.45)
        if name == "b_gold":
            speckle(g, rng, ["#c8a040", "#e0c060"], 0.15)
        return g
    if name == "door":
        g = stone_blocks(rng, "#6a5a4a", "#4a3e32", 4, 3)
        rect(g, 4, 2, 11, 15, "#1a120c")
        rect(g, 5, 3, 10, 15, "#4a3220")
        rect(g, 7, 3, 8, 15, "#3a2414")
        cracks(g, rng, "#3a2e22", 2, 5)
        return g
    if name == "hole":
        g = asphalt(rng)
        rubble_pile(g, rng)
        disc(g, 7.5, 8.5, 5.2, "#0a0806", rng, 0.6)
        rect(g, 5, 7, 10, 7, "#3a3028")
        rect(g, 6, 10, 9, 10, "#3a3028")
        return g
    if name in ("ward", "ward_open"):
        g = grid_of("#b8b0a0")
        for y in range(0, 16, 4):
            rect(g, 0, y + 3, 15, y + 3, "#8a8274")
        if name == "ward":
            c = ("#a8d0f0", "#5a8ac8") if frame == 0 else ("#5a8ac8",
                                                          "#a8d0f0")
            for x in range(0, 16, 3):
                rect(g, x, 0, x, 15, c[0])
            for y in range(1, 16, 3):
                rect(g, 0, y, 15, y, c[1])
        else:
            disc(g, 7.5, 8, 4, "#1a1a2a")
        return g
    # ── indoors ──
    if name in ("floor", "plank"):
        return planks(rng, "#7a5a3a" if name == "plank" else "#8a8478",
                      "#4a3420" if name == "plank" else "#6a665e",
                      width=4 if name == "plank" else 8)
    if name == "tile":
        g = stone_blocks(rng, "#b8b4a8", "#8a867c", 4, 4)
        cracks(g, rng, "#6a6658", 2, 5)
        return g
    if name == "marble":
        g = stone_blocks(rng, "#d8d4c8", "#b8b4a8", 8, 8)
        speckle(g, rng, ["#c8c0b0"], 0.1)
        return g
    if name == "rug":
        g = grid_of("#7a2a2a")
        rect(g, 1, 1, 14, 14, "#9a3a2a")
        rect(g, 3, 3, 12, 12, "#c8a040")
        rect(g, 4, 4, 11, 11, "#7a2a2a")
        speckle(g, rng, ["#6a2424"], 0.1)
        return g
    if name in ("wall", "wall_brick"):
        if name == "wall_brick":
            g = stone_blocks(rng, "#8a4a36", "#5a3024", 6, 3)
        else:
            g = grid_of("#a8a090")
            speckle(g, rng, ["#b8b0a0", "#98907e"], 0.3)
            rect(g, 0, 12, 15, 15, "#7a7468")
        cracks(g, rng, "#4a3e32", 2, 6)
        return g
    if name == "counter":
        g = planks(rng, "#6a4a2a", "#3a2a18")
        rect(g, 0, 0, 15, 2, "#8a6a40")
        return g
    if name == "table":
        g = planks(rng, "#8a8478", "#6a665e", width=8)
        rect(g, 2, 3, 13, 11, "#7a5a3a")
        rect(g, 2, 3, 13, 3, "#9a7a4a")
        rect(g, 3, 12, 3, 14, "#4a3420")
        rect(g, 12, 12, 12, 14, "#4a3420")
        return g
    if name == "bed":
        g = planks(rng, "#8a8478", "#6a665e", width=8)
        rect(g, 1, 2, 14, 14, "#a89a6a")
        speckle_within(g, rng, "#a89a6a", ["#b8aa7a", "#8a7a4a"], 0.4)
        rect(g, 2, 2, 13, 5, "#c8c0a0")
        return g
    if name == "shelf":
        return bookshelf(rng, ("#7a3a1a", "#3a4a6a", "#4a6a3a", "#8a7a5a",
                               "#5a5a5a", "#9a6a3a"))
    if name == "forge":
        g = stone_blocks(rng, "#5a5450", "#3a3632", 4, 4)
        rect(g, 2, 4, 13, 13, "#2a2622")
        rect(g, 4, 7, 11, 11, "#f07020" if frame == 0 else "#f0a020")
        speckle_within(g, rng, "#f07020" if frame == 0 else "#f0a020",
                       ["#f0d040", "#c84010"], 0.3)
        return g
    if name == "anvil":
        g = planks(rng, "#8a8478", "#6a665e", width=8)
        rect(g, 3, 5, 12, 7, "#3a3a40")
        rect(g, 6, 8, 9, 12, "#3a3a40")
        rect(g, 4, 13, 11, 14, "#2a2a30")
        return g
    if name == "barrel":
        g = planks(rng, "#8a8478", "#6a665e", width=8)
        disc(g, 7.5, 8, 6, "#7a5a32")
        disc(g, 7.5, 8, 4.5, "#5a4024")
        rect(g, 1, 7, 14, 8, "#3a3a3a")
        return g
    if name == "bars":
        g = planks(rng, "#5a5450", "#3a3632", width=8)
        for x in range(1, 16, 3):
            rect(g, x, 0, x, 15, "#2a2a2e")
        rect(g, 0, 2, 15, 2, "#2a2a2e")
        rect(g, 0, 13, 15, 13, "#2a2a2e")
        return g
    if name == "cauldron":
        g = planks(rng, "#8a8478", "#6a665e", width=8)
        disc(g, 7.5, 9, 6, "#2a2a2e")
        disc(g, 7.5, 8, 4.5, "#5a9a5a" if frame == 0 else "#6aaa6a")
        return g
    if name == "plant":
        g = planks(rng, "#8a8478", "#6a665e", width=8)
        rect(g, 5, 10, 10, 14, "#8a4a2a")
        disc(g, 7.5, 6, 4.5, "#3e7a32", rng, 0.6)
        return g
    if name == "throne":
        g = stone_blocks(rng, "#5a5054", "#3e363a", 8, 8)
        rect(g, 3, 1, 12, 14, "#2a2a30")
        rect(g, 5, 3, 10, 9, "#8a1a2a")
        rect(g, 3, 10, 12, 11, "#4a4a52")
        return g
    if name == "crate":
        g = grid_of("#3a3630")
        rect(g, 2, 2, 13, 13, "#7a5a32")
        rect(g, 2, 2, 13, 2, "#9a7a4a")
        poly_fill(g, [(2, 3), (4, 3), (13, 12), (11, 12)], "#5a4024")
        rect(g, 2, 7, 13, 8, "#5a4024")
        return g
    if name == "scrap":
        g = grid_of("#3a3630")
        rubble_pile(g, rng, "#6a6a70")
        speckle(g, rng, ["#9a5a2a", "#c8a040", "#5a8a9a"], 0.06)
        return g
    if name == "exit":
        g = grid_of("#1a1a1a")
