def smooth_noise(rng, w, h, cell):
    gw, gh = w // cell + 2, h // cell + 2
    pts = [[rng.random() for _ in range(gw)] for _ in range(gh)]
    out = []
    for y in range(h):
        gy = y / cell
        y0 = int(gy)
        ty = gy - y0
        ty = ty * ty * (3 - 2 * ty)
        row = []
        for x in range(w):
            gx = x / cell
            x0 = int(gx)
            tx = gx - x0
            tx = tx * tx * (3 - 2 * tx)
            a = pts[y0][x0] + (pts[y0][x0 + 1] - pts[y0][x0]) * tx
            b = pts[y0 + 1][x0] + (pts[y0 + 1][x0 + 1] - pts[y0 + 1][x0]) * tx
            row.append(a + (b - a) * ty)
        out.append(row)
    return out


def fractal(rng, w, h):
    layers = [(smooth_noise(rng, w, h, c), wt)
              for c, wt in ((16, 0.5), (8, 0.3), (4, 0.2))]
    return [[sum(l[y][x] * wt for l, wt in layers) for x in range(w)]
            for y in range(h)]


def nearest_town(x, y):
    return min(WORLD_SITES, key=lambda c: abs(WORLD_SITES[c][0] - x) +
               abs(WORLD_SITES[c][1] - y))


def make_wasteland(world, flags=()):
    """The wasteland between the towns: the same each time it is made in
    one game."""
    import heapq
    W, H = WORLD_W, WORLD_H
    rng = random.Random("%s:wasteland" % world["seed"])
    elev, moist = fractal(rng, W, H), fractal(rng, W, H)
    cx, cy = WORLD_SITES["crown"]

    def level(field, frac):
        """The value that frac of the map lies above."""
        vals = sorted(v for row in field for v in row)
        return vals[int(len(vals) * (1 - frac))]
    peak, hill = level(elev, 0.05), level(elev, 0.16)
    wood, dry = level(moist, 0.16), level(moist, 0.88)
    g = []
    for y in range(H):
        row = []
        for x in range(W):
            e, m = elev[y][x], moist[y][x]
            t = "mountain" if e > peak else "hills" if e > hill else \
                "deadwood" if m > wood else "ash" if m < dry else "waste"
            d = math.hypot(x - cx, y - cy)
            if 9 <= d <= 11.2:
                t = "mountain"                  # Crownspire's mountains
            elif d < 9 and d > 1.5 and (e > hill or m > dry):
                t = "pink"                      # the Pink Cloud
            elif d < 9 and t == "mountain":
                t = "hills"
            if y >= 53 + 2.5 * math.sin(x / 7.0) + 3 * (e - 0.5) or \
                    (x > 70 and y > 42 + (78 - x) * 0.4):
                t = "water"                     # the sea
            row.append(t)
        g.append(row)
    for y in range(0, H):                       # the river, to the sea
        x = int(round(45 + 5 * math.sin(y / 8.0) + 2 * math.sin(y / 3.1)))
        if g[y][x] != "water" and math.hypot(x - cx, y - cy) > 11.5:
            g[y][x] = "water"
    sites = set(WORLD_SITES.values())

    def far_from_sites(x, y, n):
        return all(abs(x - sx) + abs(y - sy) > n for sx, sy in sites)
    for _ in range(9):                          # craters that still glow
        x, y = rng.randrange(3, W - 3), rng.randrange(3, H - 9)
        if not far_from_sites(x, y, 7) or g[y][x] == "water":
            continue
        r = rng.choice((1, 1.5, 2.2))
        for yy in range(int(y - r), int(y + r) + 1):
            for xx in range(int(x - r), int(x + r) + 1):
                if math.hypot(xx - x, yy - y) <= r and \
                        g[yy][xx] not in ("water", "mountain"):
                    g[yy][xx] = "glow"
    for y in range(H):                          # farmhouses, long fallen
        for x in range(W):
            if g[y][x] in ("waste", "ash") and rng.random() < 0.02:
                g[y][x] = "ruin"
            elif g[y][x] == "waste" and rng.random() < 0.5:
                g[y][x] = "waste2"

    # the old roads, where they're cheapest to have run
    def cost(x, y):
        t = g[y][x]
        return {"water": 7, "mountain": 9, "deadwood": 3, "glow": 6,
                "pink": 2, "hills": 2, "road": 0.5,
                "bridge": 0.5}.get(t, 1.2) + 0.3 * elev[y][x]
    for a, b in ROADS:
        start, goal = WORLD_SITES[a], WORLD_SITES[b]
        dist, prev, q = {start: 0}, {}, [(0, start)]
        while q:
            d, p = heapq.heappop(q)
            if p == goal:
                break
            if d > dist.get(p, 1e9):
                continue
            for dx, dy in DIRS:
                n = (p[0] + dx, p[1] + dy)
                if not (0 <= n[0] < W and 0 <= n[1] < H):
                    continue
                if n in sites and n != goal:
                    continue
                nd = d + cost(*n)
                if nd < dist.get(n, 1e9):
                    dist[n], prev[n] = nd, p
                    heapq.heappush(q, (nd, n))
        p = prev.get(goal)
        while p and p != start:
            x, y = p
            g[y][x] = "bridge" if g[y][x] in ("water", "bridge") else \
                "cracked" if rng.random() < 0.25 else "road"
            p = prev.get(p)
    area = Area("world", ("world",), g, "the wasteland", edge="ash")
    area.sites = {}
    for cid, (x, y) in WORLD_SITES.items():
        g[y][x] = "site_" + cid
        area.links[(x, y)] = ("town", cid)
        area.labels[(x, y)] = CITIES[cid]["name"]
        area.sites[(x, y)] = cid
    sx, sy = WORLD_SITES["vale"]
    area.start = next((sx + dx, sy + dy) for dx, dy in DIRS
                      if g[sy + dy][sx + dx] in WORLD_GROUND)

    # two holes in the hills, and things to dig through: placed where
    # they can be walked to, and where they won't block the way
    reach = reachable(area, area.start, WORLD_GROUND)
    frng = random.Random("%s:finds" % world["seed"])

    def open_ground(x, y):
        return (x, y) in reach and g[y][x] in ("waste", "waste2", "ash",
                                               "hills") and \
            0 < x < W - 1 and 0 < y < H - 1 and \
            sum(g[y + dy][x + dx] in WORLD_GROUND for dx, dy in DIRS) >= 3
    area.lairs = {}

    def blocks(x, y, tile):
        """Put tile at (x, y), unless that cuts off any of the wasteland
        (then put back what was there, and say so)."""
        nonlocal reach
        was, g[y][x] = g[y][x], tile
        after = reachable(area, area.start, WORLD_GROUND)
        if len(after) != len(reach) - 1:
            g[y][x] = was
            return True
        reach = after
        return False
    for lid, tile in (("sealed", "site_sealed"), ("mine", "site_mine")):
        spots = [(x, y) for y in range(H) for x in range(W)
                 if open_ground(x, y) and g[y][x] == "hills"
                 and far_from_sites(x, y, 10)
                 and all(abs(x - lx) + abs(y - ly) > 20
                         for lx, ly in area.lairs.values())]
        if not spots:
            spots = [(x, y) for y in range(H) for x in range(W)
                     if open_ground(x, y) and far_from_sites(x, y, 8)]
        frng.shuffle(spots)
        for x, y in spots:
            if blocks(x, y, tile):
                continue
            break
        area.links[(x, y)] = ("lair", lid)
        area.labels[(x, y)] = LAIRS[lid].name
        area.lairs[lid] = (x, y)
        sites.add((x, y))
    finds = []
    spots = [(x, y) for y in range(H) for x in range(W)
             if open_ground(x, y) and far_from_sites(x, y, 4)]
    frng.shuffle(spots)
    for x, y in spots:
        if len(finds) >= 26:
            break
        if (x, y) not in reach or \
                any(abs(x - fx) + abs(y - fy) < 6 for fx, fy in finds) or \
                blocks(x, y, frng.choice(("shack", "shack", "skywreck",
                                          "wagonwreck"))):
            continue
        finds.append((x, y))
        if "loot:world:%d:%d" % (x, y) not in flags:
            area.loot.add((x, y))
    return area


