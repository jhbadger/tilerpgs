# ── Fitting the screen ──
#
# The whole window is scaled to the screen: Game.fit() works out how big
# everything should be from the window's size (a phone held upright gets a
# taller layout), and the shell resizes every font at once.  F() names a
# font; each display layer (Tk or Kivy, below) makes its own of it.

FONTS = {}          # Tk: (family, size, style) -> tkfont.Font
STD_FONTS = {}      # Tk's own fonts (buttons, dialogs): name -> pixels
UI = [1.0]          # how much bigger than the design everything is
PT = [1.0]          # pixels to a point, at the design size
TEXT_SIZES = (0.8, 0.9, 1.0, 1.15, 1.3, 1.5, 1.75)


def S(n):
    """A length in pixels, scaled to the screen."""
    return max(1, round(n * UI[0]))


def font_px(size):
    return -max(6, round(size * UI[0] * PT[0]))


def F(family, size, style=""):
    """A font that grows and shrinks with the window: (family, size,
    style), which the display layer turns into one of its own."""
    return (family, size, style or "")


def tkf(font):
    """F()'s font as a Tk font."""
    f = FONTS.get(font)
    if f is None:
        family, size, style = font
        f = FONTS[font] = tkfont.Font(
            family=family, size=font_px(size),
            weight="bold" if "bold" in style else "normal",
            slant="italic" if "italic" in style else "roman")
    return f


def init_fonts(root):
    PT[0] = 1.0 if ANDROID else float(root.tk.call("tk", "scaling"))
    for name in tkfont.names(root):
        if name.startswith("Tk"):
            size = int(tkfont.nametofont(name).cget("size"))
            STD_FONTS[name] = 13 if ANDROID else (
                -size if size < 0 else size * PT[0])


def set_fonts(u):
    UI[0] = u
    for (family, size, style), f in FONTS.items():
        f.configure(size=font_px(size))
    for name, px in STD_FONTS.items():
        tkfont.nametofont(name).configure(size=-max(6, round(px * u)))

MOVE_KEYS = {"Up": (0, -1), "w": (0, -1), "KP_Up": (0, -1), "KP_8": (0, -1),
             "Down": (0, 1), "s": (0, 1), "KP_Down": (0, 1), "KP_2": (0, 1),
             "Left": (-1, 0), "a": (-1, 0), "KP_Left": (-1, 0),
             "KP_4": (-1, 0), "Right": (1, 0), "d": (1, 0),
             "KP_Right": (1, 0), "KP_6": (1, 0)}



# ── The display layer ───────────────────────────────────────────────────────
# The game draws through two objects: a shell (the window round the map:
# the bars, the side panel, the log, the "Ask about:" entry, the
# buttons, the agent dialog, the clock and the keys) and a screen (the map:
# a grid of tiles, two sprites, and an overlay of menus, the map of the
# city and pages of text).  Here they are in Tk; further on, in Kivy.
# Screens count pixels from the top left of the map.

Key = namedtuple("Key", "keysym state")
Key.__doc__ = """A key press, as Tk gives it: a keysym ("Up", "KP_8", "a",
"question") and the state of the modifiers (0x04 Control, 0x08 Alt)."""
Tap = namedtuple("Tap", "x y")
Tap.__doc__ = """A tap or click on the map, in pixels from its top left."""


class TkScreen:
    """The map in Tk: a canvas of tile images, two to a square (the ground
    and what stands on it), a flash and a missile over them, and over all
    of those the overlay."""

    def __init__(self, canvas):
        self.c = canvas
        self.cells = []
        self.fx = self.missile = None

    def size(self):
        return self.c.winfo_width(), self.c.winfo_height()

    def load_tiles(self, tiles):
        """16px images of all_tiles()'s pixel rows ("#rrggbb", or None for
        nothing in a sprite), and darkened copies of the terrain for
        squares remembered but not seen."""
        self.base, self.dark = {}, {}
        for name, px in tiles.items():
            img = tk.PhotoImage(width=16, height=16)
            if name.split("@")[0] in SPRITES:
                for y, row in enumerate(px):
                    x = 0
                    while x < 16:
                        c = row[x]
                        x1 = x
                        while x1 < 16 and row[x1] == c:
                            x1 += 1
                        if c:
                            img.put(c, to=(x, y, x1, y + 1))
                        x = x1
            else:
                img.put(" ".join("{" + " ".join(r) + "}" for r in px))
                dark = tk.PhotoImage(width=16, height=16)
                dark.put(" ".join("{" + " ".join(shade(c, 0.36) for c in r)
                                  + "}" for r in px))
                self.dark[name] = dark
            self.base[name] = img

    def set_scale(self, s):
        self.img = {n: i.zoom(s) for n, i in self.base.items()}
        self.dimg = {n: i.zoom(s) for n, i in self.dark.items()}

    def grid(self, cols, rows, ox, oy, ts):
        """Clear everything, and lay out cols x rows empty squares of ts
        pixels from ox, oy."""
        c = self.c
        c.delete("all")
        self.cells = []
        for j in range(rows):
            for i in range(cols):
                x, y = ox + i * ts, oy + j * ts
                self.cells.append((
                    c.create_image(x, y, anchor="nw", state="hidden"),
                    c.create_image(x, y, anchor="nw", state="hidden")))
        self.fx = c.create_image(0, 0, anchor="nw", state="hidden")
        self.missile = c.create_image(0, 0, anchor="nw", state="hidden")

    def cell(self, idx, layer, name):
        """Show a tile in a square (layer 0 the ground, 1 what's on it):
        None for nothing, "~name" for the darkened, remembered one."""
        item = self.cells[idx][layer]
        if name is None:
            self.c.itemconfig(item, state="hidden")
        elif name[0] == "~":
            self.c.itemconfig(item, image=self.dimg[name[1:]],
                              state="normal")
        else:
            self.c.itemconfig(item, image=self.img[name], state="normal")

    def sprite(self, which, x, y, name):
        """Show the "fx" or "missile" sprite at x, y (None hides it)."""
        item = self.fx if which == "fx" else self.missile
        if name is None:
            self.c.itemconfig(item, state="hidden")
            return
        self.c.coords(item, x, y)
        self.c.itemconfig(item, image=self.img[name], state="normal")
        self.c.tag_raise(item)

    # The overlay.

    def clear_overlay(self):
        self.c.delete("overlay")

    def rect(self, x0, y0, x1, y1, fill="", outline="", width=1):
        self.c.create_rectangle(x0, y0, x1, y1, fill=fill, outline=outline,
                                width=width, tags="overlay")

    def text(self, x, y, text, font, fill, anchor="center", justify="left"):
        self.c.create_text(x, y, text=text, fill=fill, font=tkf(font),
                           anchor=anchor, justify=justify, tags="overlay")

    def measure(self, font, s):
        return tkf(font).measure(s)

    def linespace(self, font):
        return tkf(font).metrics("linespace")

    def text_size(self, text, font):
        lines = text.split("\n")
        return (max(self.measure(font, s) for s in lines),
                len(lines) * self.linespace(font))

    def map_image(self, rows, z, x, y):
        """A picture of rows of "#rrggbb" colours, each pixel z square."""
        img = tk.PhotoImage(width=len(rows[0]), height=len(rows))
        img.put(" ".join("{" + " ".join(r) + "}" for r in rows))
        self.map_img = img.zoom(z)
        self.c.create_image(x, y, image=self.map_img, anchor="nw",
                            tags="overlay")


class TkShell:
    """The window round the map, in Tk."""

    def __init__(self, root):
        self.root = root
        self.dialog = None
        self.small_dialog = None
        self.tap_guard = 0          # until when a tap on the map is ignored
        init_fonts(root)

    def screen_height(self):
        return self.root.winfo_screenheight()

    def window_size(self):
        return self.root.winfo_width(), self.root.winfo_height()

    def build(self, game, buttons, big):
        """The window's parts, with the buttons ((key, label, command), ...)
        and the game listening to them; returns the screen."""
        self.game = game
        root = self.root
        root.title("Ashen Clover")
        root.configure(bg=PANEL)
        if not ANDROID:
            root.minsize(760, 580)
            root.geometry("1200x880" if big else "1000x740")

        top = tk.Frame(root, bg=PANEL)
        top.pack(fill="x")
        tk.Label(top, text="Ashen Clover", bg=PANEL, fg=ACCENT,
                 font=tkf(F("Georgia", 16, "bold"))).pack(
                     side="left", padx=10, pady=6)
        self.status = tk.Label(top, bg=PANEL, fg=INK_DIM,
                               font=tkf(F("Helvetica", 12)))
        self.status.pack(side="left", padx=10)
        self.turns = tk.Label(top, bg=PANEL, fg=INK_DIM,
                              font=tkf(F("Helvetica", 12)))
        self.turns.pack(side="right", padx=10)

        bar = self.bar = tk.Frame(root, bg=PANEL)
        bar.pack(side="bottom", fill="x")
        self.btn = {}
        for key, label, cmd in buttons:
            b = tk.Button(bar, text=label, command=cmd, width=7,
                          highlightbackground=PANEL, takefocus=0)
            self.btn[key] = b       # placed by arrange(), in one row or more

        body = tk.Frame(root, bg=PANEL)
        body.pack(fill="both", expand=True)
        side = self.sidebar = tk.Frame(body, bg=PANEL, width=250)
        side.pack(side="right", fill="y")
        side.pack_propagate(False)
        self.panelrow = tk.Frame(side, bg=PANEL)
        self.panelrow.pack(fill="x")
        mono = tkf(F(*MONO))
        self.panel = tk.Label(self.panelrow, bg=PANEL, fg=INK, font=mono,
                              justify="left", anchor="nw")
        self.panel.pack(side="left", fill="x", expand=True, anchor="n",
                        padx=10, pady=(8, 0))
        self.panel2 = tk.Label(self.panelrow, bg=PANEL, fg=INK, font=mono,
                               justify="left", anchor="nw")
        self.condition = tk.Label(side, bg=PANEL, fg=BAD, justify="left",
                                  anchor="nw",
                                  font=tkf(F("Menlo", 12, "bold")))
        self.condition.pack(fill="x", padx=10)

        left = self.leftside = tk.Frame(body, bg=PANEL)
        left.pack(side="left", fill="both", expand=True)
        self.log = tk.Text(left, height=8, bg=LOG_BG, fg=INK, font=mono,
                           wrap="word", bd=0, highlightthickness=0,
                           padx=8, pady=4, state="disabled", takefocus=0)
        self.log.pack(side="bottom", fill="x")
        for tag, color in LOG_TAGS.items():
            self.log.tag_configure(tag, foreground=color)
        self.log.tag_configure("quest", font=tkf(F("Menlo", 12, "bold")))
        self.talkbar = tk.Frame(left, bg=PANEL)
        self.prompt = tk.Label(self.talkbar, text="Ask about:", bg=PANEL,
                               fg=ACCENT, font=mono)
        self.prompt.pack(side="left", padx=(8, 4), pady=4)
        self.entry = tk.Entry(self.talkbar, bg=LOG_BG, fg=INK, font=mono,
                              insertbackground=INK, highlightthickness=0,
                              bd=1)
        self.entry.pack(side="left", fill="x", expand=True, padx=(0, 8),
                        pady=4)
        self.entry.bind("<Return>", lambda e: game.on_entry() or "break")
        self.entry.bind("<Escape>", lambda e: game.end_talk())
        self.canvas = tk.Canvas(left, bg="black", highlightthickness=0)
        self.canvas.pack(fill="both", expand=True)

        self.canvas.bind("<Configure>", lambda e: game.layout())
        root.bind("<Configure>", lambda e: e.widget is root and
                  game.on_resize(), add="+")
        self.canvas.bind("<ButtonPress-1>", game.tapped)
        root.bind("<KeyPress>", game.on_key)
        for k in ("Control-q", "Command-q"):
            root.bind("<%s>" % k, lambda e: game.quit())
        root.protocol("WM_DELETE_WINDOW", game.quit)
        return TkScreen(self.canvas)

    def set_ui_scale(self, u):
        set_fonts(u)

    def arrange(self, tall, W):
        """Wide: the panel at the side, the buttons in a row; tall (a phone
        held upright): the panel underneath, the buttons in rows."""
        n = len(self.btn)
        self.root.update_idletasks()
        each = max(b.winfo_reqwidth() for b in self.btn.values()) + S(4)
        rows = 2 if tall else 1
        while rows < n and -(-n // rows) * each > W:
            rows += 1
        per = -(-n // rows)
        for i, b in enumerate(self.btn.values()):
            b.grid(row=i // per, column=i % per, sticky="ew", padx=S(2),
                   pady=S(4))
        for col in range(n):
            self.bar.columnconfigure(col, weight=int(col < per),
                                     uniform="b" if col < per else "")
        sb = self.sidebar
        sb.pack_forget()
        if tall:
            sb.pack_propagate(True)
            sb.pack(side="bottom", fill="x", before=self.leftside)
            wrapl = (W - S(50)) // 2
        else:
            sb.configure(width=S(250))
            sb.pack_propagate(False)
            sb.pack(side="right", fill="y", before=self.leftside)
            wrapl = S(230)
        for w in (self.panel, self.panel2, self.condition):
            if int(w.cget("wraplength")):
                w.configure(wraplength=wrapl if w is not self.condition or
                            not tall else W - S(24))

    # What the window shows round the map.

    def set_status(self, text):
        self.status.config(text=text)

    def set_clock(self, text):
        self.turns.config(text=text)

    def set_condition(self, text):
        self.condition.config(text=text)

    def set_panel(self, first, second=None):
        """The side panel, in one column, or two (a phone held upright)."""
        self.panel.config(text="\n".join(first))
        if second is None:
            self.panel2.pack_forget()
            return
        self.panel2.config(text="\n".join(second))
        if not self.panel2.winfo_manager():
            self.panel2.pack(side="left", fill="x", expand=True, anchor="n",
                             padx=(S(10), S(10)), pady=(S(8), 0))

    def log_add(self, text, tag=None):
        log = self.log
        log.config(state="normal")
        log.insert("end", text + "\n", tag or ())
        n = int(log.index("end").split(".")[0])
        if n > 500:
            log.delete("1.0", "%d.0" % (n - 400))
        log.config(state="disabled")
        log.see("end")

    def log_clear(self):
        self.log.config(state="normal")
        self.log.delete("1.0", "end")
        self.log.config(state="disabled")

    # The "Your interest:" entry.

    def show_entry(self, focus):
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Ask about:")
        self.entry.delete(0, "end")
        if focus:
            self.entry.focus_set()

    def set_prompt(self, text):
        self.prompt.config(text=text)

    def hide_entry(self):
        self.talkbar.pack_forget()
        self.canvas.focus_set()

    def take_entry(self):
        text = self.entry.get()
        self.entry.delete(0, "end")
        return text

    # Time.

    def after(self, ms, fn, *args):
        return self.root.after(ms, fn, *args)

    def after_idle(self, fn, *args):
        return self.root.after_idle(fn, *args)

    def cancel(self, job):
        self.root.after_cancel(job)

    # The agent dialog.

    def open_dialog(self):
        """Whether a dialog can open now (only one at a time)."""
        dlg = self.dialog
        try:
            if dlg is not None and dlg.winfo_exists():
                dlg.lift()
                return False
        except tk.TclError:
            pass
        return True

    def close_dialog(self, dlg=None):
        dlg = dlg or self.dialog
        if dlg is not None:
            try:
                dlg.destroy()
            except tk.TclError:
                pass
        if dlg is self.dialog:
            self.dialog = None
        # a tap on a dialog button can land on the map behind it
        self.tap_guard = time.time() + 0.6

    def grab(self, dlg):
        try:
            dlg.grab_set()
        except tk.TclError:
            pass

    def ask_hero(self, title, form, done):
        """Making an agent: a name, a sex, who they're drawn to, a
        background and characteristics, rolled until you like them.  The
        form (see Game.ask_hero) says what to offer and fills in the
        sheet; the dialog carries on from its own buttons, calling
        done((name, sex, attracted, background, chars)), or done(None) if
        cancelled: on Android (Pydroid) wait_window doesn't wait."""
        root = self.root
        if not self.open_dialog():
            return
        dlg = self.dialog = tk.Toplevel(root, bg=PANEL, padx=18, pady=14)
        dlg.title(title)
        dlg.transient(root)
        dlg.resizable(False, False)
        tk.Label(dlg, text=form.get("heading", "Your dossier"),
                 bg=PANEL, fg=ACCENT,
                 font=tkf(F("Georgia", 16, "bold"))).pack(anchor="w")
        row = tk.Frame(dlg, bg=PANEL)
        row.pack(fill="x", pady=(10, 4))
        tk.Label(row, text="Name:", bg=PANEL, fg=INK,
                 font=tkf(F("Helvetica", 13))).pack(side="left")
        name = tk.Entry(row, bg=LOG_BG, fg=INK, insertbackground=INK,
                        font=tkf(F(*MONO)), width=22, highlightthickness=0)
        sex = tk.StringVar(value=form["sex"])
        att = tk.StringVar(value=form.get("attracted") or "")

        def suggest():
            name.delete(0, "end")
            name.insert(0, form["suggest"](sex.get()))
        suggest()
        name.pack(side="left", padx=8)
        row2 = tk.Frame(dlg, bg=PANEL)
        row2.pack(fill="x", pady=(0, 8))
        rows = [("You are:", sex, (("a stallion", "M"), ("a mare", "F")))]
        if form.get("attracted"):
            rows.append(("  Drawn to:", att, (("women", "F"),
                                              ("men", "M"))))
        for text, var, vals in rows:
            tk.Label(row2, text=text, bg=PANEL, fg=INK,
                     font=tkf(F("Helvetica", 12))).pack(side="left")
            for label, v in vals:
                tk.Radiobutton(row2, text=label, variable=var, value=v,
                               bg=PANEL, fg=INK, selectcolor=LOG_BG,
                               activebackground=PANEL,
                               font=tkf(F("Helvetica", 12)),
                               command=suggest if var is sex else None
                               ).pack(side="left")
        bgv = tk.StringVar(value=form["background"])
        cols = tk.Frame(dlg, bg=PANEL)
        cols.pack(fill="x")
        left = tk.Frame(cols, bg=PANEL)
        left.pack(side="left", anchor="n")
        right = tk.Frame(cols, bg=PANEL)
        right.pack(side="left", anchor="n", padx=(16, 0))
        for c in form["backgrounds"]:
            tk.Radiobutton(left, text=c, variable=bgv, value=c, bg=PANEL,
                           fg=INK, selectcolor=LOG_BG, activebackground=PANEL,
                           font=tkf(F("Helvetica", 13, "bold")), anchor="w",
                           command=lambda: reroll()).pack(fill="x")
        desc = tk.Label(right, bg=PANEL, fg=INK_DIM, wraplength=S(340),
                        justify="left", font=tkf(F("Helvetica", 12)))
        desc.pack(fill="x", anchor="w")
        sheet = tk.Label(right, bg=PANEL, fg=INK, justify="left",
                         font=tkf(F(*MONO)))
        sheet.pack(fill="x", anchor="w", pady=(8, 0))
        state = {"chars": form["roll"](bgv.get())}

        def show():
            d, s = form["sheet"](bgv.get(), sex.get(), att.get(),
                                 state["chars"])
            desc.config(text=d)
            sheet.config(text=s)

        def reroll():
            state["chars"] = form["roll"](bgv.get())
            show()

        def begin(_=None):
            who = (name.get(), sex.get(), att.get(), bgv.get(),
                   dict(state["chars"]))
            self.close_dialog(dlg)
            done(who)

        def cancel(_=None):
            self.close_dialog(dlg)
            done(None)
        show()
        bar = tk.Frame(dlg, bg=PANEL)
        bar.pack(fill="x", pady=(12, 0))
        tk.Button(bar, text="Begin", command=begin, width=9,
                  highlightbackground=PANEL).pack(side="right")
        tk.Button(bar, text="Cancel", command=cancel, width=9,
                  highlightbackground=PANEL).pack(side="right", padx=6)
        tk.Button(bar, text="Roll again", command=reroll, width=10,
                  highlightbackground=PANEL).pack(side="left")
        dlg.bind("<Return>", begin)
        dlg.bind("<Escape>", cancel)
        dlg.protocol("WM_DELETE_WINDOW", cancel)
        name.focus_set()
        name.select_range(0, "end")
        self.fit_dialog(dlg)
        dlg.geometry("+%d+%d" % (
            root.winfo_rootx() + max(0, (root.winfo_width() -
                                         dlg.winfo_reqwidth()) // 2),
            root.winfo_rooty() + max(0, min(60, (root.winfo_height() -
                                                 dlg.winfo_reqheight()) // 2))))
        self.grab(dlg)

    def dialog_shrunk(self):
        """Whether a dialog has the fonts shrunk to fit: leave them be."""
        return self.small_dialog is not None

    def fit_dialog(self, dlg):
        """Shrink a dialog that's too big for the window until it fits;
        everything goes back to its usual size when it closes."""
        root = self.root
        root.update_idletasks()
        self.game.fit()
        W, H = root.winfo_width(), root.winfo_height()
        if W < 100:
            return
        shrunk = False
        for _ in range(5):
            dlg.update_idletasks()
            k = min(1.0, (W - 8) / max(1, dlg.winfo_reqwidth()),
                    (H - 8) / max(1, dlg.winfo_reqheight()))
            if k >= 1.0:
                break
            shrunk = True
            set_fonts(UI[0] * k * 0.97)
            todo = [dlg]
            while todo:
                w = todo.pop()
                todo += w.winfo_children()
                try:
                    wl = int(w.cget("wraplength"))
                except (tk.TclError, ValueError):
                    continue
                if wl:
                    w.configure(wraplength=max(60, int(wl * k)))
        if shrunk:
            self.small_dialog = dlg

            def closed(e):
                if e.widget is dlg:
                    self.small_dialog = None
                    self.root.after_idle(self.game.fit, True)
            dlg.bind("<Destroy>", closed, add="+")

    # The rest.

    def set_icon(self):
        set_window_icon(self.root)

    def run(self):
        self.root.mainloop()

    def close(self):
        self.root.destroy()


# ── The display layer, in Kivy ──────────────────────────────────────────────
# The same shell and screen again, for Kivy: run with --kivy (or
# ASHENCLOVER_UI=kivy) where Kivy is installed; a Python without Tk (the
# Android app --build-android makes) uses Kivy by itself.  Kivy is only
# looked for when asked, and by names put together at run time, as for the
# mixer: Pydroid picks how to run a script from what it imports, and the
# game itself must still start with Tk.  Kivy counts in real pixels from
# the bottom left; these classes turn that into the map's pixels from its
# top left.

KV = {}             # Kivy's parts, once loaded


def load_kivy(width=980, height=720):
    """Kivy's classes, by name; the first call opens the window."""
    if KV:
        return KV
    os.environ.setdefault("KIVY_NO_ARGS", "1")      # --kivy is ours
    os.environ.setdefault("KIVY_NO_CONSOLELOG", "1")
    import importlib
    k = "ki" + "vy"

    def part(module, *names):
        mod = importlib.import_module(k + module)
        for n in names:
            KV[n] = getattr(mod, n)
    config = importlib.import_module(k + ".config").Config
    config.set("kivy", "exit_on_escape", "0")       # Escape and Back: ours
    config.set("kivy", "log_level", "warning")
    # A touch can come twice, from the touch screen and again as a mouse:
    # on a phone there's no mouse to want, and elsewhere the mouse gives
    # way while the touch screen is in use.
    if ANDROID:
        config.remove_option("input", "mouse")
    else:
        config.set("input", "mouse",
                   "mouse,disable_multitouch,disable_on_activity")
    config.set("graphics", "width", str(width))
    config.set("graphics", "height", str(height))
    part(".core.window", "Window")
    part(".app", "App")
    part(".clock", "Clock")
    part(".graphics", "Color", "Rectangle", "Line", "InstructionGroup")
    part(".graphics.texture", "Texture")
    part(".core.text.markup", "MarkupLabel")
    part(".uix.widget", "Widget")
    part(".uix.stencilview", "StencilView")
    part(".uix.boxlayout", "BoxLayout")
    part(".uix.gridlayout", "GridLayout")
    part(".uix.label", "Label")
    part(".uix.button", "Button")
    part(".uix.togglebutton", "ToggleButton")
    part(".uix.textinput", "TextInput")
    part(".uix.scrollview", "ScrollView")
    part(".uix.modalview", "ModalView")
    return KV


def kivy_rgba(colour, alpha=1.0):
    """A Tk colour ("#rrggbb", "black" or "white") as Kivy's (r, g, b, a)."""
    colour = {"black": "#000000", "white": "#ffffff"}.get(colour, colour)
    return (int(colour[1:3], 16) / 255, int(colour[3:5], 16) / 255,
            int(colour[5:7], 16) / 255, alpha)


def kivy_markup(text, mono_px=None):
    """Print for a Kivy label that reads markup: [, ] and & kept as they
    are, and the symbols Kivy's Roboto fonts lack (the menus' arrows) set
    in DejaVu Sans, which Kivy also brings, smaller in monospaced print of
    mono_px pixels so that the columns still line up."""
    if mono_px:
        start = "[font=DejaVuSans][size=%d]" % max(6, round(mono_px * 0.72))
        end = "[/size][/font]"
    else:
        start, end = "[font=DejaVuSans]", "[/font]"
    out, run = [], []
    for ch in text:
        if ord(ch) > 0xff and not 0x2010 <= ord(ch) <= 0x2027:
            run.append(ch)
            continue
        if run:
            out.append(start + "".join(run) + end)
            run = []
        out.append({"&": "&amp;", "[": "&bl;", "]": "&br;"}.get(ch, ch))
    if run:
        out.append(start + "".join(run) + end)
    return "".join(out)


class KivyFonts:
    """F()'s fonts in Kivy's terms: Roboto for print, Roboto Mono where the
    columns must line up, at a size in real pixels."""
    pt = 4 / 3          # as Tk counts pixels to a point on a desktop: on
                        # a phone too, so print keeps to the layout's size

    @classmethod
    def px(cls, size):
        return max(6, round(size * UI[0] * cls.pt))

    @staticmethod
    def mono(font):
        return font[0] in ("Menlo", "Courier")

    @classmethod
    def markup(cls, text, font):
        return kivy_markup(text, cls.px(font[1]) if cls.mono(font) else None)

    @classmethod
    def options(cls, font):
        family, size, style = font
        return {"font_name": "RobotoMono-Regular" if cls.mono(font)
                else "Roboto", "font_size": cls.px(size),
                "bold": "bold" in style, "italic": "italic" in style}


class KivyScreen:
    """The map in Kivy: a widget whose canvas holds, from the bottom, the
    tiles, the overlay and the two sprites."""
    ANCHOR_X = {"w": 0, "e": 1}
    ANCHOR_Y = {"n": 0, "s": 1}

    def __init__(self):
        kv = load_kivy()
        self.kv = kv
        screen = self
        self.game = None

        class MapArea(kv["StencilView"]):     # (drawing kept inside it)
            def on_touch_down(self, touch):
                if getattr(touch, "is_mouse_scrolling", False) or \
                        not self.collide_point(*touch.pos) or \
                        screen.game is None:
                    return super().on_touch_down(touch)
                x, y = int(touch.x - self.x), int(self.top - touch.y)
                if not screen.echo(x, y):
                    screen.game.tapped(Tap(x, y))
                return True
        self.widget = MapArea()
        with self.widget.canvas.before:
            kv["Color"](0, 0, 0, 1)
            bg = kv["Rectangle"]()
        self.widget.bind(pos=lambda w, v: setattr(bg, "pos", v),
                         size=lambda w, v: setattr(bg, "size", v))
        self.groups = {}
        for layer in ("grid", "overlay", "sprites"):
            g = self.groups[layer] = kv["InstructionGroup"]()
            self.widget.canvas.add(g)
        self.cells = []
        self.sprites = {}
        self.ts = 16
        self.last_tap = (0, -999, -999)
        self.labels = {}            # (text, font, ...) -> texture

    def echo(self, x, y):
        """Whether a tap at x, y is the last one over again: the same
        place within a third of a second, as when one touch reaches Kivy
        twice.  Answered for real, it could undo the first (opening a menu,
        then closing it)."""
        t, lx, ly = self.last_tap
        now = time.time()
        self.last_tap = (now, x, y)
        half = max(8, self.ts // 2)
        return now - t < 0.3 and abs(x - lx) < half and abs(y - ly) < half

    def kx(self, x):
        return self.widget.x + x

    def ky(self, y, h=0):
        """Kivy's y for the bottom of something h high whose top is at y."""
        return self.widget.y + self.widget.height - y - h

    def size(self):
        return int(self.widget.width), int(self.widget.height)

    def listen(self, game):
        """The map resized or moved: lay the tiles out afresh."""
        self.game = game
        trigger = self.kv["Clock"].create_trigger(lambda dt: game.layout())
        self.widget.bind(size=lambda *a: trigger(), pos=lambda *a: trigger())

    # The tiles.

    def texture(self, w, h, pixels):
        """A texture of RGBA pixels, top row first, drawn sharp."""
        tex = self.kv["Texture"].create(size=(w, h), colorfmt="rgba")
        tex.mag_filter = tex.min_filter = "nearest"
        stride = w * 4
        flipped = b"".join(pixels[i:i + stride]
                           for i in range((h - 1) * stride, -1, -stride))
        tex.blit_buffer(flipped, colorfmt="rgba", bufferfmt="ubyte")
        return tex

    def load_rgba(self, rgba):
        """Textures of tile_rgba()'s tiles, and of the darkened terrain."""
        self.img, self.dimg = {}, {}
        for name, (flat, dark) in rgba.items():
            self.img[name] = self.texture(16, 16, flat)
            if dark is not None:
                self.dimg[name] = self.texture(16, 16, dark)

    def set_scale(self, s):
        """(The textures are drawn at whatever size the squares are.)"""

    def grid(self, cols, rows, ox, oy, ts):
        kv = self.kv
        for g in self.groups.values():
            g.clear()
        self.ts = ts
        grid = self.groups["grid"]
        grid.add(kv["Color"](1, 1, 1, 1))
        self.cells = []
        for j in range(rows):
            for i in range(cols):
                pos = (self.kx(ox + i * ts), self.ky(oy + j * ts, ts))
                cell = (kv["Rectangle"](pos=pos, size=(0, 0)),
                        kv["Rectangle"](pos=pos, size=(0, 0)))
                grid.add(cell[0])
                grid.add(cell[1])
                self.cells.append(cell)
        sprites = self.groups["sprites"]
        sprites.add(kv["Color"](1, 1, 1, 1))
        for which in ("fx", "missile"):
            r = self.sprites[which] = kv["Rectangle"](size=(0, 0))
            sprites.add(r)

    def cell(self, idx, layer, name):
        r = self.cells[idx][layer]
        if name is None:
            r.size = (0, 0)
            return
        r.texture = (self.dimg[name[1:]] if name[0] == "~"
                     else self.img[name])
        r.size = (self.ts, self.ts)

    def sprite(self, which, x, y, name):
        r = self.sprites.get(which)
        if r is None:
            return
        if name is None:
            r.size = (0, 0)
            return
        r.texture = self.img[name]
        r.pos = (self.kx(x), self.ky(y, self.ts))
        r.size = (self.ts, self.ts)

    # Print.

    def label(self, text, font, fill=None, justify="left"):
        """A texture of print, kept for next time."""
        key = (text, font, fill, justify, UI[0])
        tex = self.labels.get(key)
        if tex is None:
            if len(self.labels) > 2000:
                self.labels.clear()
            lab = self.kv["MarkupLabel"](
                text=KivyFonts.markup(text, font),
                color=kivy_rgba(fill or INK), halign=justify,
                **KivyFonts.options(font))
            lab.refresh()
            tex = self.labels[key] = lab.texture
        return tex

    def measure(self, font, s):
        return self.label(s, font).width if s else 0

    def linespace(self, font):
        return self.label("Ag", font).height

    def text_size(self, text, font):
        tex = self.label(text, font)
        return tex.width, tex.height

    # The overlay.

    def clear_overlay(self):
        self.groups["overlay"].clear()

    def add(self, colour, shape):
        g = self.groups["overlay"]
        g.add(self.kv["Color"](*kivy_rgba(colour)))
        g.add(shape)

    def rect(self, x0, y0, x1, y1, fill="", outline="", width=1):
        kv = self.kv
        x0, x1 = min(x0, x1), max(x0, x1)
        y0, y1 = min(y0, y1), max(y0, y1)
        pos, size = (self.kx(x0), self.ky(y1)), (x1 - x0, y1 - y0)
        if fill:
            self.add(fill, kv["Rectangle"](pos=pos, size=size))
        if outline:
            self.add(outline, kv["Line"](rectangle=pos + size,
                                         width=max(1, width * 0.75)))

    def text(self, x, y, text, font, fill, anchor="center", justify="left"):
        if not text:
            return
        tex = self.label(text, font, fill, justify)
        ax = 0.5 if anchor in ("center", "n", "s") else \
            self.ANCHOR_X[anchor[-1]]
        ay = 0.5 if anchor in ("center", "w", "e") else \
            self.ANCHOR_Y[anchor[0]]
        left, top = x - tex.width * ax, y - tex.height * ay
        g = self.groups["overlay"]
        g.add(self.kv["Color"](1, 1, 1, 1))
        g.add(self.kv["Rectangle"](texture=tex, size=tex.size,
                                   pos=(self.kx(left),
                                        self.ky(top, tex.height))))

    def map_image(self, rows, z, x, y):
        w, h = len(rows[0]), len(rows)
        px = bytearray()
        for row in rows:
            for c in row:
                px += bytes((int(c[1:3], 16), int(c[3:5], 16),
                             int(c[5:7], 16), 255))
        tex = self.texture(w, h, bytes(px))
        g = self.groups["overlay"]
        g.add(self.kv["Color"](1, 1, 1, 1))
        g.add(self.kv["Rectangle"](texture=tex, size=(w * z, h * z),
                                   pos=(self.kx(x), self.ky(y, h * z))))


KIVY_KEYS = {273: "Up", 274: "Down", 276: "Left", 275: "Right",
             13: "Return", 271: "KP_Enter", 27: "Escape", 32: "space",
             9: "Tab", 8: "BackSpace", 269: "KP_Subtract", 270: "KP_Add",
             282: "F1"}
KIVY_KEYS.update({256 + n: "KP_%d" % n for n in range(10)})
KIVY_CHARS = {"+": "plus", "-": "minus", "=": "equal", "?": "question",
              "/": "slash", ".": "period", "_": "underscore"}


class KivyShell:
    """The window round the map, in Kivy: the same bars, panel, log, entry
    and buttons as the Tk one, and Kivy's clock and keys."""

    def __init__(self):
        self.kv = load_kivy()
        self.fonts = []             # (widget, font): resized together
        self.raw = {}               # label -> its text, before markup
        self.log_lines = []
        self.entry_shown = False
        self.dialog = None
        self.tap_guard = 0
        self.app = None

    def screen_height(self):
        return self.kv["Window"].height

    def window_size(self):
        return tuple(int(v) for v in self.kv["Window"].size)

    def set_ui_scale(self, u):
        UI[0] = u
        for w, font in self.fonts:
            w.font_size = KivyFonts.px(font[1])
            if w in self.raw:
                w.text = KivyFonts.markup(self.raw[w], font)
        self.screen.labels.clear()
        self.show_log()

    # Building.

    def painted(self, widget, colour):
        """A widget with a background."""
        kv = self.kv
        with widget.canvas.before:
            kv["Color"](*kivy_rgba(colour))
            r = kv["Rectangle"](pos=widget.pos, size=widget.size)
        widget.bind(pos=lambda w, v: setattr(r, "pos", v),
                    size=lambda w, v: setattr(r, "size", v))
        return widget

    def label(self, font, colour, wrap=False, **kw):
        lab = self.kv["Label"](markup=True, color=kivy_rgba(colour),
                               halign="left", valign="top",
                               **dict(KivyFonts.options(font), **kw))
        self.fonts.append((lab, font))
        if wrap:
            lab.size_hint_y = None
            lab.height = 0
            lab.bind(texture_size=lambda w, v: setattr(w, "height", v[1]))
        else:
            lab.size_hint = (None, None)
            lab.bind(texture_size=lambda w, v: setattr(w, "size", v))
        return lab

    def button(self, text, command, font=None, cls="Button", **kw):
        font = font or F("Helvetica", 13)
        b = self.kv[cls](text=text, font_size=KivyFonts.px(font[1]),
                         bold="bold" in font[2], **kw)
        self.fonts.append((b, font))
        if command:
            b.bind(on_release=lambda w: command())
        return b

    def build(self, game, buttons, big):
        kv = self.kv
        self.game = game
        if not ANDROID:
            kv["Window"].system_size = (1180, 860) if big else (980, 720)
        kv["Window"].clearcolor = kivy_rgba(PANEL)
        self.root = self.painted(kv["BoxLayout"](orientation="vertical"),
                                 PANEL)
        top = self.top = kv["BoxLayout"](size_hint_y=None, height=S(30),
                                         padding=(S(10), S(6)),
                                         spacing=S(20))
        top.add_widget(self.label(F("Georgia", 16, "bold"), ACCENT,
                                  text="Ashen Clover"))
        self.status = self.label(F("Helvetica", 12), INK_DIM)
        top.add_widget(self.status)
        top.add_widget(kv["Widget"]())
        self.turns = self.label(F("Helvetica", 12), INK_DIM)
        top.add_widget(self.turns)
        self.root.add_widget(top)

        self.body = kv["BoxLayout"]()
        self.left = kv["BoxLayout"](orientation="vertical")
        self.screen = KivyScreen()
        self.left.add_widget(self.screen.widget)
        self.log_view = self.painted(kv["ScrollView"](
            size_hint_y=None, height=S(100), do_scroll_x=False,
            bar_width=S(4)), LOG_BG)
        self.log = self.label(F(*MONO), INK, wrap=True,
                              padding=(S(8), S(4)))
        self.log.bind(width=lambda w, v: setattr(w, "text_size", (v, None)))
        self.log_view.add_widget(self.log)
        self.left.add_widget(self.log_view)
        self.talkbar = self.painted(kv["BoxLayout"](
            size_hint_y=None, height=S(34), padding=(S(8), S(4)),
            spacing=S(6)), PANEL)
        self.prompt = self.label(F(*MONO), ACCENT, text="Ask about:")
        self.talkbar.add_widget(self.prompt)
        self.entry = kv["TextInput"](
            multiline=False, write_tab=False, text_validate_unfocus=False,
            background_color=kivy_rgba(LOG_BG),
            foreground_color=kivy_rgba(INK), cursor_color=kivy_rgba(INK),
            **{k: v for k, v in KivyFonts.options(F(*MONO)).items()
               if k in ("font_name", "font_size")})
        self.fonts.append((self.entry, F(*MONO)))
        self.entry.bind(on_text_validate=lambda *a: game.on_entry())
        self.talkbar.add_widget(self.entry)
        if ANDROID:                 # the keyboard mustn't hide what's typed
            kv["Window"].softinput_mode = "below_target"
        self.body.add_widget(self.left)

        self.side = kv["BoxLayout"](orientation="vertical",
                                    size_hint_x=None, width=S(250),
                                    padding=(S(10), S(8)), spacing=S(4))
        self.panelrow = kv["BoxLayout"](size_hint_y=None, height=0,
                                        spacing=S(10))
        self.panel = self.label(F(*MONO), INK, wrap=True)
        self.panel2 = self.label(F(*MONO), INK, wrap=True)
        for p in (self.panel, self.panel2):
            p.bind(texture_size=lambda w, v: self.fit_panel())
        self.panelrow.add_widget(self.panel)
        self.condition = self.label(F("Menlo", 12, "bold"), BAD, wrap=True)
        self.side.add_widget(self.panelrow)
        self.side.add_widget(self.condition)
        self.spacer = kv["Widget"]()        # (wide: the rest of the height)
        self.side.add_widget(self.spacer)
        self.body.add_widget(self.side)
        self.root.add_widget(self.body)

        self.bar = kv["GridLayout"](size_hint_y=None, height=S(40),
                                    padding=S(2), spacing=S(4))
        self.btn = {}
        for key, label, cmd in buttons:
            self.btn[key] = b = self.button(label, cmd)
            self.bar.add_widget(b)
        self.root.add_widget(self.bar)
        self.listen(game)
        self.screen.listen(game)
        return self.screen

    def fit_panel(self):
        self.panelrow.height = max(self.panel.height, self.panel2.height
                                   if self.panel2.parent else 0)

    def arrange(self, tall, W):
        """Wide: the panel at the side, the buttons in a row; tall (a phone
        held upright): the panel underneath, the buttons in rows."""
        lh = self.screen.linespace(F(*MONO))
        self.top.height = self.screen.linespace(
            F("Georgia", 16, "bold")) + S(12)
        self.talkbar.height = lh + S(14)
        self.log_view.height = lh * (5 if tall else 7) + S(8)
        each = max(self.screen.measure(F("Helvetica", 13), b.text)
                   for b in self.btn.values()) + S(28)
        n = len(self.btn)
        rows = 2 if tall else 1
        while rows < n and -(-n // rows) * each > W:
            rows += 1
        self.bar.cols = -(-n // rows)
        self.bar.height = rows * (lh + S(22)) + S(4)
        self.body.remove_widget(self.side)
        if tall:
            self.body.orientation = "vertical"
            self.side.size_hint = (1, None)
            self.spacer.size_hint_y = None
            self.spacer.height = 0
            self.side.bind(minimum_height=self.side.setter("height"))
            self.side.height = self.side.minimum_height
            wrap_ = (W - S(50)) // 2
        else:
            self.body.orientation = "horizontal"
            self.side.unbind(minimum_height=self.side.setter("height"))
            self.side.size_hint = (None, 1)
            self.side.width = S(250)
            self.spacer.size_hint_y = 1
            wrap_ = S(230)
        self.body.add_widget(self.side)
        for p in (self.panel, self.panel2):
            p.text_size = (wrap_, None)
        self.condition.text_size = (W - S(24) if tall else S(230), None)

    # What the window shows round the map.

    def set_label(self, label, text):
        if self.raw.get(label) != text:
            self.raw[label] = text
            label.text = KivyFonts.markup(text, dict(self.fonts)[label])

    def set_status(self, text):
        self.set_label(self.status, text)

    def set_clock(self, text):
        self.set_label(self.turns, text)

    def set_condition(self, text):
        self.set_label(self.condition, text)

    def set_panel(self, first, second=None):
        self.set_label(self.panel, "\n".join(first))
        if second is None:
            if self.panel2.parent:
                self.panelrow.remove_widget(self.panel2)
        else:
            self.set_label(self.panel2, "\n".join(second))
            if not self.panel2.parent:
                self.panelrow.add_widget(self.panel2)
        self.fit_panel()

    def log_add(self, text, tag=None):
        self.log_lines = self.log_lines[-150:] + [(text, tag)]
        self.show_log()

    def show_log(self):
        px = KivyFonts.px(MONO[1])
        lines = []
        for text, tag in self.log_lines:
            line = "[color=%s]%s[/color]" % (LOG_TAGS.get(tag, INK),
                                              kivy_markup(text, px))
            lines.append("[b]%s[/b]" % line if tag == "quest" else line)
        self.log.text = "\n".join(lines)
        self.kv["Clock"].schedule_once(
            lambda dt: setattr(self.log_view, "scroll_y", 0), 0)

    def log_clear(self):
        self.log_lines = []
        self.log.text = ""

    # The "Your interest:" entry.

    def show_entry(self, focus):
        self.prompt.text = "Ask about:"
        self.entry.text = ""
        if not self.entry_shown:
            self.left.add_widget(self.talkbar)      # under the log
            self.entry_shown = True
        if focus:
            self.entry.focus = True

    def set_prompt(self, text):
        self.prompt.text = text

    def hide_entry(self):
        if self.entry_shown:
            self.entry.focus = False
            self.left.remove_widget(self.talkbar)
            self.entry_shown = False

    def take_entry(self):
        text, self.entry.text = self.entry.text, ""
        return text

    # Time.

    def after(self, ms, fn, *args):
        return self.kv["Clock"].schedule_once(lambda dt: fn(*args),
                                              ms / 1000)

    def after_idle(self, fn, *args):
        return self.kv["Clock"].schedule_once(lambda dt: fn(*args), 0)

    def cancel(self, job):
        job.cancel()

    # The agent dialog.

    def ask_hero(self, title, form, done):
        """Making an agent, as the Tk dialog: a name, a sex, who they're
        drawn to, a background and characteristics, then done((name, sex,
        attracted, background, chars)), or done(None) if cancelled."""
        if self.dialog is not None:
            return
        self.game.fit()             # (it may open before the first fit)
        kv = self.kv
        W, H = self.window_size()
        width = min(W - S(16), S(640))
        view = kv["ModalView"](size_hint=(None, None), auto_dismiss=False,
                               width=width, background_color=(0, 0, 0, .6))
        scroll = self.painted(kv["ScrollView"](do_scroll_x=False), PANEL)
        box = kv["BoxLayout"](orientation="vertical", size_hint_y=None,
                              padding=(S(18), S(14)), spacing=S(6))
        box.bind(minimum_height=box.setter("height"))
        inner = width - 2 * S(18)

        def wrapped(text, font, colour, indent=0):
            lab = self.label(font, colour, wrap=True,
                             text=KivyFonts.markup(text, font),
                             padding=(indent, 0))
            lab.text_size = (inner, None)
            return lab
        box.add_widget(wrapped(form.get("heading", "Your dossier"),
                               F("Georgia", 16, "bold"),
                               ACCENT))
        bh = self.screen.linespace(F("Helvetica", 13, "bold")) + S(14)
        row = kv["BoxLayout"](size_hint_y=None, spacing=S(8),
                              height=self.screen.linespace(F(*MONO)) + S(16))
        row.add_widget(self.label(F("Helvetica", 13), INK, text="Name:"))
        name = kv["TextInput"](
            multiline=False, write_tab=False,
            background_color=kivy_rgba(LOG_BG),
            foreground_color=kivy_rgba(INK), cursor_color=kivy_rgba(INK),
            **{k: v for k, v in KivyFonts.options(F(*MONO)).items()
               if k in ("font_name", "font_size")})
        row.add_widget(name)
        box.add_widget(row)

        def choice(group, options, chosen, font, cols, changed=None):
            """A row (or grid) of buttons, one of them down."""
            grid = kv["GridLayout"](cols=cols, size_hint_y=None,
                                    spacing=S(4))
            grid.bind(minimum_height=grid.setter("height"))
            picks = {}
            for label, v in options:
                b = picks[v] = self.button(
                    label, None, font, "ToggleButton",
                    group="ashenclover-" + group, allow_no_selection=False,
                    state="down" if v == chosen else "normal",
                    size_hint_y=None, height=bh)
                if changed:
                    b.bind(state=lambda w, s: s == "down" and changed())
                grid.add_widget(b)
            box.add_widget(grid)
            return lambda: next((v for v, b in picks.items()
                                 if b.state == "down"), chosen)

        def suggest():
            name.text = form["suggest"](sex())
        small = F("Helvetica", 12)
        box.add_widget(wrapped("You are:", small, INK))
        sex = choice("sex", (("a stallion", "M"), ("a mare", "F")),
                     form["sex"], small, 2, lambda: suggest())
        if form.get("attracted"):
            box.add_widget(wrapped("Drawn to:", small, INK))
