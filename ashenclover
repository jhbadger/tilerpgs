def pony_statue(p, shape, x0, y0, scale, body, shadow, mirror=False):
    """A pony from PONY_SHAPES, cast in bronze (or stone) at scale."""
    rows = PONY_SHAPES[shape]
    for j, row in enumerate(rows):
        for i, ch in enumerate(row):
            if ch == ".":
                continue
            c = shadow if ch in "dhnxe" else body
            if ch in "wk":
                c = shade(body, 1.15)
            ii = 15 - i if mirror else i
            p.rect(x0 + ii * scale, y0 + j * scale,
                   x0 + ii * scale + scale - 1, y0 + j * scale + scale - 1, c)


