def home_dir():
    """Where the save and the music cache go: your home folder, or, if
    that can't be written to (as may be so in the Android app built with
    --build-android), the app's own private folder."""
    home = os.path.expanduser("~")
    if home != "~" and os.access(home, os.W_OK):
        return home
    for d in (os.environ.get("ANDROID_PRIVATE"), os.getcwd(),
              tempfile.gettempdir()):
        if d and os.access(d, os.W_OK):
            return d
    return home


