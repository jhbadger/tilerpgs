        text = saved.get("text")
        self.text_k = text if text in TEXT_SIZES else 1.0
        self.scale = 3 if shell.screen_height() >= 1000 else 2
        self.tall = None
        self.fit_job = None
        self.screen = shell.build(self, (
            ("wait", "Wait", self.wait),
