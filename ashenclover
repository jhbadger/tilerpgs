ANDROID_TAR = r'''#!/home/user/.venv/bin/python3
"""tar, for the kivy/buildozer image on a Mac.  Its GNU tar unpacks with
the openat2 system call, which neither Rosetta nor QEMU can run, so every
unpacking fails ("Cannot mkdir: Function not implemented").  This unpacks
with Python's tarfile instead, refusing paths that leave the folder as GNU
tar does, and hands anything else to the real tar.  Written by
ashenclover --build-android, and mounted over the image's tar."""
import os
import sys
import tarfile

REAL = "/usr/bin/tar"


def real():
    os.execv(REAL, [REAL] + sys.argv[1:])


def main(args):
    if not args:
        real()
    first = args[0].lstrip("-")
    if args[0].startswith("--") or not first.isalpha() or "x" not in first:
        real()                      # not unpacking: the real tar can
    archive, dest, strip = None, ".", 0
    rest = args[1:]
    if "f" in first:
        if not rest:
            real()
        archive, rest = rest[0], rest[1:]
    while rest:
        a = rest.pop(0)
        if a == "-C" and rest:
            dest = rest.pop(0)
        elif a.startswith("--strip-components="):
            strip = int(a.split("=", 1)[1])
        elif a.startswith("--") and a in (
                "--no-same-owner", "--no-same-permissions", "--overwrite"):
            pass
        else:
            real()                  # members or options we don't know
    if archive is None or archive == "-":
        real()
    with tarfile.open(archive) as tf:
        members = []
        for m in tf.getmembers():
            if strip:
                parts = m.name.split("/")[strip:]
                if not parts or not parts[0]:
                    continue
                m.name = "/".join(parts)
            members.append(m)
        tf.extractall(dest, members=members, filter="tar")


main(sys.argv[1:])
'''


ANDROID_BUILD = r'''#!/bin/sh
# Build the Android app with Buildozer in Docker (kivy/buildozer), from
# this folder wherever it's run from: ./build.sh, or ./build.sh with
# Buildozer's own arguments (default: -v android debug).  The APK lands in
# bin/.  Written by ashenclover --build-android.
#
#   buildozer-home      Docker volume: Android's SDK and NDK.
#   buildozer-platform  Docker volume: python-for-android and all it has
#                       compiled (Python, SDL2, Kivy...), at
#                       .buildozer/android/platform.  Both are shared by
#                       every project built with this script, so the second
#                       needn't download or compile them again; build one
#                       at a time, all for the same arch (arm64-v8a).  They
#                       live on Colima's Linux disk, since the NDK has names
#                       a Mac's disk can't tell apart (xt_RATEEST.h and
#                       xt_rateest.h).  The rest of .buildozer stays here.
#   tar                 this folder's tar, over the image's own, which can't
#                       unpack under Intel emulation on a Mac.
#   .android            this folder's, as the container's ~/.android (at
#                       /root too, since under Colima the build runs as
#                       root and Java looks there): the
#                       debug key the APK is signed with.  Without it each
#                       build made a new key, and a phone refuses an update
#                       signed with a different key ("App not installed").
#                       Keep it: lose it and the app must be uninstalled
#                       (and its saved game with it) before the next.
#
# It holds nothing of any one app: copy it, with tar, next to another
# project's buildozer.spec to build that the same way.
#
# Before each build the pip venv python-for-android makes is cleared:
# it makes it afresh over the old one, mixing two versions of pip.
set -e
cd "$(dirname "$0")"
[ $# -gt 0 ] || set -- -v android debug
exec docker run --rm --platform linux/amd64 \
    -v buildozer-home:/home/user/.buildozer \
    -v "$PWD":/home/user/hostcwd \
    -v buildozer-platform:/home/user/hostcwd/.buildozer/android/platform \
    -v "$PWD/tar":/usr/local/bin/tar:ro \
    -v "$PWD/.android":/home/user/.android \
    -v "$PWD/.android":/root/.android \
    --entrypoint /bin/bash kivy/buildozer -c \
    'rm -rf /home/user/hostcwd/.buildozer/android/platform/build-*/build/venv
     exec /usr/local/bin/entrypoint.sh "$@"' build "$@"
'''


def build_android(dest):
    """A folder for Buildozer to make an Android app of: the game as
    main.py, its icon, a buildozer.spec (written only if there isn't one,
    so that your changes to it stay), and build.sh and the tar it uses,
    for building in Docker (see ANDROID_BUILD and ANDROID_TAR)."""
    os.makedirs(dest, exist_ok=True)
    for name, text in (("tar", ANDROID_TAR), ("build.sh", ANDROID_BUILD)):
        path = os.path.join(dest, name)
        with open(path, "w") as fh:
            fh.write(text)
        os.chmod(path, 0o755)
    shutil.copy(os.path.abspath(__file__), os.path.join(dest, "main.py"))
    with open(os.path.join(dest, "icon.png"), "wb") as fh:
        fh.write(icon_render_png(512))
    spec = os.path.join(dest, "buildozer.spec")
    if not os.path.exists(spec):
        with open(spec, "w") as fh:
            fh.write(ANDROID_SPEC)
    return dest


def icon_args(args):
    """Handle --build-app [DIR], --build-android [DIR] and --icon-png SIZE
    [OUT]; True if handled."""
    if args[:1] == ["--build-android"]:
        print(build_android(args[1] if len(args) > 1 else os.path.join(
