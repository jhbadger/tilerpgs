# ── Dice ─────────────────────────────────────────────────────────────────────


def roll(expr, rng=random):
    """Roll dice written as '2d6+3', '1d8', 'd20' or a plain number."""
    expr = str(expr).replace(" ", "")
    total = 0
    for sign, part in re.findall(r"([+-]?)([^+-]+)", expr):
        k = -1 if sign == "-" else 1
        if "d" in part:
            n, d = part.split("d")
            total += k * sum(rng.randint(1, int(d)) for _ in range(int(n or 1)))
        else:
            total += k * int(part)
    return total


# Damage an enemy deals, by its Hit Dice.
