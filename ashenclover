def main():
    if icon_args(sys.argv[1:]):
        return
    if "--selftest" in sys.argv:
        selftest()
        return
    if "--kivy" in sys.argv or os.environ.get("ASHENCLOVER_UI") == "kivy" \
            or tk is None:
        shell = KivyShell()
        shell.set_icon()
        shell.run(lambda: Game(shell))      # (after "Loading..." is up)
        return
    shell = TkShell(tk.Tk())
    Game(shell)
    shell.set_icon()
    shell.run()


if __name__ == "__main__":
    main()
