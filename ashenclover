                    g.talk = None
                    g.move(*random.choice(DIRS))
                if g.overlay in ("lost", "doom"):
                    break
                if city != "vale" and not g.overlay:
                    g.descend(city)
                    for _ in range(150):
                        if g.overlay in ("lost", "doom"):
