    # Keys, and the window.

    def listen(self, game):
        win = self.kv["Window"]

        def key_down(window, key, scancode, codepoint, modifiers):
            ctrl = "ctrl" in modifiers or "meta" in modifiers
            if key == ord("q") and ctrl:
                game.quit()
                return True
            d = self.dialog
            if d is not None:
                if key == 27:
                    d["cancel"]()
                elif key in (13, 271) and not d["name"].focus:
                    d["begin"]()
                return key == 27
            if self.entry.focus:
                if key == 27:
                    game.end_talk()
                    return True
                if key in (273, 274) and game.talk:
                    game.on_key(Key(KIVY_KEYS[key], 0))     # choosing
                    return True
                return False            # typing a word to say
            name = KIVY_KEYS.get(key)
            if name is None and codepoint:
                name = KIVY_CHARS.get(codepoint, codepoint)
                if "shift" in modifiers and codepoint.isalpha():
                    name = codepoint.upper()
            if name is None:
                return False
            if name == "Escape" and game.talk:
                game.end_talk()         # (the Back button, on a phone)
                return True
            game.on_key(Key(name, (0x04 if ctrl else 0) |
                            (0x08 if "alt" in modifiers else 0)))
            return True
        win.bind(on_key_down=key_down)
        win.bind(on_resize=lambda *a: game.on_resize())
        win.bind(on_request_close=lambda *a, **k: game.quit() or True)

    def set_icon(self):
        path = os.path.join(tempfile.gettempdir(), "ashenclover-icon.png")
        try:
            with open(path, "wb") as f:
                f.write(base64.b64decode(ICON_PNG))
            self.kv["Window"].set_icon(path)
        except OSError:
            pass

    def run(self, make_game):
        """Open the window saying the game is on its way, and only then
        make it (make_game(): the slow part, with every tile to draw and
        every tune to write), and put it in the window in place of that.
        A phone takes a while over it, and a blank window looks stuck."""
        kv, shell = self.kv, self
        Clock, Window = kv["Clock"], kv["Window"]
        Window.clearcolor = kivy_rgba(PANEL)
        loading = kv["BoxLayout"](orientation="vertical")
        size = min(Window.width, Window.height)
        loading.add_widget(kv["Widget"]())
        loading.add_widget(kv["Label"](
            text="Ashen Clover", bold=True, color=kivy_rgba(ACCENT),
            font_size=max(18, size // 11), size_hint_y=None,
            height=max(30, size // 7)))
        loading.add_widget(kv["Label"](
            text="Loading...", color=kivy_rgba(INK_DIM),
            font_size=max(12, size // 22), size_hint_y=None,
            height=max(20, size // 10)))
        loading.add_widget(kv["Widget"]())

        class AshenClover(kv["App"]):
            title = "Ashen Clover"
            game = None

            def build(app):
                return loading

            def on_start(app):
                """The game, once "Loading..." has been drawn (twice, as
                the first frame on a phone can come before the window's
                shown)."""
                Window.bind(on_flip=app.drawn)

            def drawn(app, *args):
                app.flips = getattr(app, "flips", 0) + 1
                if app.flips == 2:
                    Window.unbind(on_flip=app.drawn)
                    Clock.schedule_once(app.begin, 0)

            def begin(app, dt):
                game = make_game()
                Window.remove_widget(loading)
                Window.add_widget(shell.root)
                app.root = shell.root
                app.game = game
                # Fit the window now it's up: a phone's comes up at its
                # size without ever being resized.
                Clock.schedule_once(lambda dt: game.fit(True), 0)

            def on_pause(app):
                """Switched away from: Android may close the app without
                another word, so the game is saved now."""
                if app.game:
                    app.game.save()
                    app.game.sound.stop_music()
                return True

            def on_resume(app):
                if app.game:
                    app.game.sound.tick()
        self.app = AshenClover()
        self.app.run()

    def close(self):
        if self.app is not None:
            self.app.stop()
        else:
            self.kv["Window"].close()





