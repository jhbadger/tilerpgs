android.presplash_color = #1a1612
# 64-bit ARM only: nearly every phone, and what the Play Store asks for.
# (Building for two at once breaks python-for-android's pip: it makes the
# same venv again for the second, over the first's upgraded pip.)
android.archs = arm64-v8a
android.allow_backup = True
# say yes to Google's SDK licence, which would otherwise be asked for,
# and wait for an answer that a Docker build can't give
android.accept_sdk_license = True

[buildozer]
log_level = 2
# in Docker under Colima the project looks root's, so Buildozer runs as
# root there; don't stop to ask about it (it's harmless in a container)
warn_on_root = 0
