def district(cid, x, y):
    """The part of the city a square lies in."""
    for (x0, y0, x1, y1), name in CITIES[cid]["districts"]:
        if x0 <= x <= x1 and y0 <= y <= y1:
            return name
    return CITIES[cid]["name"]


def make_city(world, cid, flags):
    """A ruined city, the same every time it is made."""
    spec = CITIES[cid]
    rng = random.Random("ruin-city:" + cid)
    W, H = CITY_W, CITY_H
    looks = spec["looks"]

    def look_at(x, y=0):
        """Buildings come in runs of a few squares, not one by one."""
        pick = random.Random("%s:%d:%d" % (cid, x // 3, y // 2))
        return pick.choice(looks)
    g = [[look_at(x, y) for x in range(W)] for y in range(H)]
    for y in STREET_Y:
        for x in range(STREET_X[0], STREET_X[-1] + 1):
            g[y][x] = "road"
    for x in STREET_X:
        for y in range(STREET_Y[0], STREET_Y[-1] + 1):
            g[y][x] = "road"
    for x in range(W):                  # the roads out of town
        g[STREET_Y[2]][x] = "road"
    for y in range(H):
        g[y][STREET_X[3]] = "road"
    skip = set(spec["parks"]) | set(spec["squares"]) | set(spec["gardens"])
    for i in range(7):
        for j in range(5):
            x0, y0, x1, y1 = block_rect(i, j)
            west_look, east_look = look_at(x0, y0), look_at(x1, y1 + 3)
            fallen = (i, j) not in skip and rng.random() < 0.18
            for y in range(y0, y1 + 1):
                for x in range(x0, x1 + 1):
                    ring = x in (x0, x1) or y in (y0, y1)
                    if ring or (i, j) in skip:
                        g[y][x] = "pave"
                    elif fallen:
                        g[y][x] = rng.choice(("rubble", "weeds", "weeds",
                                              "debris", "tree"))
                    else:
                        g[y][x] = west_look if x < x0 + 3 else east_look
    for (i, j) in spec["parks"]:
        x0, y0, x1, y1 = block_rect(i, j)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                mid = x == (x0 + x1) // 2 or y == (y0 + y1) // 2
                g[y][x] = "path" if mid else rng.choice(
                    ("tree", "tree", "weeds", "grass", "bush"))
    for (i, j) in spec["squares"]:
        for x, y in rect_cells(block_rect(i, j)):
            g[y][x] = "square"
    for (i, j) in spec["gardens"]:
        for x, y in rect_cells(block_rect(i, j)):
            g[y][x] = "garden" if (x + y) % 5 else "path"
    # the years: cracks, weeds, trees in the roads
    for y in range(H):
        for x in range(W):
            t = g[y][x]
            r = rng.random()
            if t == "road":
                g[y][x] = "cracked" if r < 0.25 else "weeds" if r < 0.3 \
                    else "tree" if r < 0.31 and x not in (
                        STREET_X[3], 0, W - 1) and y != STREET_Y[2] \
                    else "road"
            elif t == "pave":
                g[y][x] = "weeds" if r < 0.12 else "pave"
    area = Area("city", ("city", cid), g, spec["name"], edge="weeds")
    area.city = cid
    for r in spec["water"]:
        for x, y in rect_cells(r):
            g[y][x] = "water"
    for kind, v in spec["bridges"]:
        cells = v if kind == "cells" else (
            [(v, y) for y in range(H)] if kind == "x" else
            [(x, v) for x in range(W)])
        for x, y in cells:
            if g[y][x] == "water":
                g[y][x] = "bridge"
    for y in range(H):
        for x in range(W):
            if g[y][x] in ("pave", "road", "cracked", "weeds", "grass",
                           "path", "square") and any(
                    0 <= x + dx < W and 0 <= y + dy < H and
                    g[y + dy][x + dx] == "water" for dx, dy in DIRS):
                g[y][x] = "quay"
    used = set()
    area.landmark = {}
    for name, lx, ly, label, desc in spec["landmarks"]:
        w, h = LANDMARKS[name][:2]
        for i in range(w):
            for j in range(h):
                if area.inside(lx + i, ly + j):
                    g[ly + j][lx + i] = landmark_tile(name, i, j)
                    area.landmark[(lx + i, ly + j)] = (label, desc)
                    used.add((lx + i, ly + j))
        area.labels[(lx + w // 2, ly + h - 1)] = label
    for tile, x, y in spec.get("fixed", ()):
        g[y][x] = tile
        used.add((x, y))
    if spec.get("stable_door"):
        x, y = spec["stable_door"]
        area.links[(x, y)] = ("stable",)
        area.labels[(x, y)] = "Stable Two"
    if spec.get("lair_door"):
        x, y = spec["lair_door"]
        area.links[(x, y)] = ("lair", cid)
        area.labels[(x, y)] = LAIRS[cid].name
    for sid, (name, kind, (bi, bj, half), look) in spec["sites"].items():
        x0, y0, x1, y1 = site_rect(bi, bj, half)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                g[y][x] = look
                used.add((x, y))
        door = ((x0 + x1 + 1) // 2, y1)
        g[door[1]][door[0]] = "door"
        area.links[door] = ("bld", cid, sid)
        area.labels[door] = name
        used.add((door[0], door[1] + 1))
        g[door[1] + 1][door[0]] = "pave"
    rings = []
    for i in range(7):
        for j in range(5):
            for x, y in rect_cells(block_rect(i, j)):
                x0, y0, x1, y1 = block_rect(i, j)
                if (x in (x0, x1) or y in (y0, y1)) and \
                        g[y][x] in ("pave", "weeds") and (x, y) not in used:
                    rings.append((x, y))
    for y in STREET_Y:
        for x in range(W):
            if g[y][x] in ("road", "cracked") and x != STREET_X[3] and \
                    y != STREET_Y[2] and (x, y) not in used:
                rings.append((x, y))
    doorsteps = {(x + dx, y + dy) for x, y in area.links for dx, dy in DIRS}
    rings = [c for c in rings if c not in doorsteps]
    rng.shuffle(rings)
    for tile, n in spec["decor"]:
        for _ in range(n):
            if rings:
                x, y = rings.pop()
                g[y][x] = tile
                area.decor[(x, y)] = tile
    x, y = ARRIVE
    for k in range(4):                  # the road in is always clear
        g[y][x + k] = "road"
    area.start = ARRIVE
    return area


def door_step(area, link):
    for pos, l in area.links.items():
        if l == link:
            return pos[0], pos[1] + 1
    return None


