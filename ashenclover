def make_interior(world, cid, sid, flags):
    name, kind, _, _ = CITIES[cid]["sites"][sid]
    floor, rows, cast = ROOMS[kind]
    g, spots = [], []
    for y, row in enumerate(rows):
        line = []
        for x, ch in enumerate(row):
            if ch.isdigit():
                spots.append((cast[ch], x, y))
                line.append(floor if ch != "1" or kind != "pen" else floor)
            else:
                line.append(ROOM_TILES.get(ch, floor))
        g.append(line)
    area = Area("inside", ("bld", cid, sid), g, name)
    area.site = sid
    area.kind_of = kind
    area.city = cid
    for y, row in enumerate(g):
        for x, t in enumerate(row):
            if t == "exit":
                area.start = (x, y - 1)
            elif t == "crate" and "loot:%s:%s:%d:%d" % (cid, sid, x, y) \
                    not in flags:
                area.loot.add((x, y))
    freed = "freed:" + cid in flags
    for role, x, y in spots:
        if kind == "pen":
            if role.startswith("slaver"):
                if "pen_won:" + cid in flags:
                    continue
                m = make_monster("slaver", x, y)
                m.aware = False
                area.mobs.append(m)
                continue
            if freed:
                continue
        area.mobs.append(make_person(world, cid, role, x, y))
    return area


