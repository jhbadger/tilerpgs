    for name in TERRAIN:
        tiles[name] = draw_terrain(name)
        if name in ANIMATED_TERRAIN:
            tiles[name + "@1"] = draw_terrain(name, 1)
    for name, (w, h, ground, paint, walk, rs) in LANDMARKS.items():
        pic = Pic(w, h, ground)
        paint(pic)
        ruin(pic, ground, name, **rs)
        for (i, j), px in pic.tiles().items():
            tiles[landmark_tile(name, i, j)] = px
    sprites = {}
    for name, (shape, pal) in PEOPLE.items():
        sprites[name] = art_pixels(pal, PONY_SHAPES[shape])
    for name, (pal, rows) in ART.items():
        sprites[name] = art_pixels(pal, rows)
    still = {"hit", "zzz", "web", "junkbot", "sentry"} | FLOOR_ITEMS | \
        MISSILES
    for name, px in sprites.items():
        tiles[name] = px
        SPRITES.add(name)
        if name in still:
            continue
        tiles[name + "@1"] = px[1:] + [[None] * 16]     # a bob: up a pixel
    return tiles


# Drawing every tile and turning it into RGBA, pixel by pixel in Python, is
# most of the time a slow tablet takes to start, so the RGBA is kept in a
# file between runs, named by a checksum of this script: editing the art
# makes it again.

TILE_CACHE_FORMAT = 1


def tile_rgba():
    """name -> (RGBA bytes, darkened RGBA bytes or None for a sprite), and
    name -> average colour of each terrain tile; from the cache if it's
    there.  Like all_tiles(), it fills in SPRITES."""
    path = None
    try:
        with open(os.path.abspath(globals()["__file__"]), "rb") as fh:
            sig = zlib.crc32(fh.read())
        path = os.path.join(MUSIC_CACHE, "tiles-%d-%08x.bin" % (
            TILE_CACHE_FORMAT, sig))
        with open(path, "rb") as fh:
            rgba, avg = unpack_tiles(fh.read())
    except (KeyError, OSError, ValueError, TypeError, IndexError,
            zlib.error):
        rgba, avg = make_tile_rgba(all_tiles())
        if path:
            save_tiles(path, rgba, avg)
        return rgba, avg
    for name, (_, dark) in rgba.items():
        if dark is None:
            SPRITES.add(name.split("@")[0])
    return rgba, avg


def make_tile_rgba(tiles):
    rgba, avg = {}, {}
    clear = b"\0\0\0\0"
    for name, px in tiles.items():
        sprite = name.split("@")[0] in SPRITES
        flat, dark = bytearray(), bytearray()
        for row in px:
            for c in row:
                if not c:
                    flat += clear
                    dark += clear
                    continue
                flat += bytes.fromhex(c[1:]) + b"\xff"
                if not sprite:
                    dark += bytes.fromhex(shade(c, 0.36)[1:]) + b"\xff"
        rgba[name] = (bytes(flat), None if sprite else bytes(dark))
        if not sprite:
            avg[name] = "#%02x%02x%02x" % tuple(
                sum(flat[i::4]) // 256 for i in range(3))
    return rgba, avg


def save_tiles(path, rgba, avg):
    head = json.dumps([[n, d is not None, avg.get(n)]
                       for n, (_, d) in rgba.items()]).encode()
    body = b"".join(f + (d or b"") for f, d in rgba.values())
    try:
        os.makedirs(os.path.dirname(path), exist_ok=True)
        for old in os.listdir(os.path.dirname(path)):
            if old.startswith("tiles-") and old.endswith(".bin"):
                os.remove(os.path.join(os.path.dirname(path), old))
        tmp = path + ".tmp"
        with open(tmp, "wb") as fh:
            fh.write(zlib.compress(len(head).to_bytes(4, "big") + head +
                                   body, 1))
        os.replace(tmp, path)
    except OSError:
        pass


def unpack_tiles(data):
    data = zlib.decompress(data)
    n = int.from_bytes(data[:4], "big")
    pos, rgba, avg = 4 + n, {}, {}
    for name, has_dark, colour in json.loads(data[4:pos]):
        size = 1024 * (2 if has_dark else 1)
        chunk = data[pos:pos + size]
        if len(chunk) != size:
            raise ValueError("short tile cache")
        pos += size
        rgba[name] = (chunk[:1024], chunk[1024:] if has_dark else None)
        if colour:
            avg[name] = colour
    if pos != len(data):
        raise ValueError("long tile cache")
    return rgba, avg


def landmark_walkable():
    """The landmark squares that can be walked on."""
    out = set()
    for name, (w, h, ground, paint, walk, rs) in LANDMARKS.items():
        for i, j in walk:
            out.add(landmark_tile(name, i, j))
    return out


