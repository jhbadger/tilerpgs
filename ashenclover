    def restore(self, g):
        p = g["player"]
        for k in ("name", "cls", "stats", "hp", "maxhp", "level", "usage"):
            if k not in p:
                raise ValueError("bad hero")
        if p["cls"] not in CLASSES or p["melee"] not in WEAPONS:
            raise ValueError("bad hero")
        self.world = generate_world(int(g["seed"]))
        self.cache = {}
        self.p = p
        self.flags = set(g.get("flags", []))
        self.topics = set(g.get("topics", []))
        self.notes = list(g.get("notes", []))
        self.turn = int(g.get("turn", 0))
        self.tallies = dict(g.get("tallies", {}))
        self.city = g.get("city", "vale")
        if self.city not in CITIES:
            raise ValueError("bad city")
        self.city_pos = {k: list(v) for k, v in g.get("city_pos",
                                                      {}).items()}
        self.seen = dict(g.get("seen", {}))
        self.reset_view()
        self.surface = g.get("surface")
        if self.surface:
            self.surface = (tuple(self.surface[0]), self.surface[1])
        self.area = self.get_area(tuple(g["key"]))
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        if self.area.grid[self.pos[1]][self.pos[0]] not in WALKABLE:
            self.pos = list(self.area.start)
        self.say("%s, %s." % (CITIES[self.city]["name"], self.date_text()),
                 "quest")
        self.say("Welcome back, %s. Press ? for help." % self.p["name"],
                 "info")
        self.layout()
        if "won" in self.flags:
            self.show_won()
        elif self.turn >= DEADLINE:
            self.doom()

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "zoom": self.zoom_d, "text": self.text_k,
                "destiny_auto": self.destiny_auto}
        if getattr(self, "p", None) and getattr(self, "area", None) and \
                self.overlay != "lost":
            for k, a in self.cache.items():
                if k[0] in ("city", "world"):
                    self.seen[k[-1]] = pack_bits(a.seen)
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "topics": sorted(self.topics),
                "notes": self.notes, "turn": self.turn,
                "tallies": self.tallies, "city": self.city,
                "city_pos": self.city_pos, "seen": self.seen,
                "key": list(self.area.key), "pos": self.pos,
                "surface": [list(self.surface[0]), self.surface[1]]
                if self.surface else None}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.shell.close()

    # ── Areas ──

    def get_area(self, key):
        key = tuple(key)
        if key in self.cache:
            return self.cache[key]
        w = self.world
        if key[0] == "city":
            cid = key[1]
            if cid not in CITIES:
                raise ValueError("bad city")
            area = make_city(w, cid, self.flags)
            if cid == "colt" and "ward_open" in self.flags:
                x, y = CITIES[cid]["lair_door"]
                area.grid[y][x] = "ward_open"
            if cid in self.seen:
                try:
                    area.seen = unpack_bits(self.seen[cid], area.w * area.h)
                except (ValueError, zlib.error):
                    pass
            self.populate_city(area)
            lit = {"campfire", "ward"}
            area.lit = {(x + dx, y + dy) for y in range(area.h)
                        for x in range(area.w) if area.grid[y][x] in lit
                        for dx in range(-3, 4) for dy in range(-3, 4)
                        if abs(dx) + abs(dy) <= 4}
        elif key[0] == "stable":
            area = make_stable(w)
        elif key[0] == "world":
            area = make_wasteland(w, self.flags)
            if "world" in self.seen:
                try:
                    area.seen = unpack_bits(self.seen["world"],
                                            area.w * area.h)
                except (ValueError, zlib.error):
                    pass
        elif key[0] == "bld":
            cid, sid = key[1], key[2]
            if cid not in CITIES or sid not in CITIES[cid]["sites"]:
                raise ValueError("bad site")
            area = make_interior(w, cid, sid, self.flags)
        elif key[0] == "dun":
            lid, level = key[1], int(key[2])
            if lid not in LAIRS or not 1 <= level <= LAIRS[lid].levels:
                raise ValueError("bad level")
            area = make_dungeon(w, lid, level, self.flags)
            key = area.key
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        return area

    def populate_city(self, area):
        """Survivors near the camps, and the king's creatures in the
        ruins."""
        cid = area.city
        spec = CITIES[cid]
        rng = random.Random("%s:folk:%s" % (self.world["seed"], cid))
        ground = [(x, y) for y in range(area.h) for x in range(area.w)
                  if area.grid[y][x] in ("pave", "road", "cracked", "square",
                                         "weeds", "path")
                  and 2 < x < 61 and 2 < y < 45]
        doorsteps = {(x + dx, y + dy) for x, y in area.links
                     for dx, dy in DIRS}
        ground = [s for s in ground if s not in doorsteps]
        doors = [pos for pos, l in area.links.items() if l[0] == "bld"]
        area.folk = []
        for i in range(spec["folk"]):
            near = [s for s in ground if doors and min(
                abs(s[0] - d[0]) + abs(s[1] - d[1]) for d in doors) <= 7]
            if not near:
                break
            x, y = rng.choice(near)
            if area.mob_at(x, y):
                continue
            m = make_folk(self.world, cid, rng, i, x, y)
            area.folk.append(m)
            area.mobs.append(m)
        ax, ay = ARRIVE
        far = [s for s in ground if abs(s[0] - ax) + abs(s[1] - ay) > 14]
        for _ in range(spec["hostiles"]):
            if not far:
                break
            x, y = rng.choice(far)
            if area.mob_at(x, y):
                continue
            m = make_monster(rng.choice(spec["danger"]), x, y, rng=rng)
            area.mobs.append(m)

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        self.sound.play(sound)
        self.layout()
        self.save()

    def go_outside(self):
        """Out of a building, onto its doorstep."""
        if self.area.key == ("stable",):
            self.out_of_stable()
            return
        cid = self.area.city or self.city
        city = self.get_area(("city", cid))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.enter(city, self.city_pos.get(cid) or city.start)
        self.say("You step out into %s." % district(cid, *self.pos), "info")

    def enter_link(self, link, x, y):
        kind = link[0]
        if kind == "bld":
            self.city_pos[self.city] = list(self.pos)
            area = self.get_area(link)
            self.say("You go into %s." % area.name, "info")
            self.enter(area, area.start)
            self.on_entering(area)
            return
        if kind == "lair":
            self.at_lair(link[1], x, y)
        elif kind == "stable":
            self.city_pos[self.city] = list(self.pos)
            area = self.get_area(("stable",))
            self.say("The cog rolls aside for you, grinding, and you go "
                     "back into Stable Two.", "info")
            self.enter(area, STABLE_DOOR, "stairs")
        elif kind == "town":
            self.enter_town(link[1], x - self.pos[0], y - self.pos[1])

    def out_of_stable(self):
        """Through the great door, into Clover Vale's ruins."""
        city = self.get_area(("city", "vale"))
        self.city = "vale"
        self.enter(city, self.city_pos.get("vale") or city.start, "stairs")
        if "been:vale" not in self.flags:
            self.flags.add("been:vale")
            self.say("The great cog rolls aside with a scream of old steel, "
                     "and you step out under the sky for the first time. It "
                     "isn't blue. It's a lid of grey cloud, from one edge of "
                     "the world to the other.", "quest")
            self.say(CITIES["vale"]["intro"], "info")
            self.say("Find the Mayor of New Clover: the Town Hall is in the "
                     "middle of town, north of the old Lantern Hall. Walk "
                     "off the edge of the town into the wasteland, when "
                     "you're ready.", "talk")
        else:
            self.say("You climb out of Stable Two into Clover Vale.", "info")

    def leave_town(self, dx, dy):
        """Off the edge of a town: out into the wasteland on hoof, or,
        with Calamity's sky-wagon, anywhere you've been."""
        if not self.p["lizard"]:
            self.to_wasteland(dx, dy)
            return
        here = self.city
        items = [("Walk out into the wasteland",
                  lambda: self.to_wasteland(dx, dy))]
        for cid in CITY_ORDER:
            if cid != here and "been:" + cid in self.flags:
                hours = flight_days(here, cid) * 12
                items.append(("Fly to %s with Calamity (%d hours)" % (
                    CITIES[cid]["name"], hours),
                    lambda cid=cid: self.travel_to(cid)))
        items.append(("Stay in %s" % CITIES[here]["name"], lambda: None))
        self.open_menu("Leaving %s" % CITIES[here]["name"], items)

    def to_wasteland(self, dx, dy):
        cid = self.city
        self.city_pos[cid] = list(self.pos)
        self.cache = {k: v for k, v in self.cache.items()
                      if k[0] in ("city", "world", "stable")}
        w = self.get_area(("world",))
        sx, sy = WORLD_SITES[cid]
        spots = [(sx + dx, sy + dy)] + [(sx + ex, sy + ey)
                                        for ex, ey in DIRS]
        pos = next((p for p in spots if w.inside(*p) and
                    w.grid[p[1]][p[0]] in WORLD_GROUND and
                    not w.mob_at(*p)), (sx, sy))
        self.enter(w, pos, "door")
        self.say("You leave %s for the wasteland. (Towns are red on the "
                 "map: M.)" % CITIES[cid]["name"], "info")

    def enter_town(self, cid, dx, dy):
        """Into a town from the wasteland, by the side you came from."""
        self.city = cid
        self.cache = {k: v for k, v in self.cache.items()
                      if k[0] in ("city", "world", "stable")}
        city = self.get_area(("city", cid))
        target = (CITY_W - 2 if dx < 0 else 1 if dx > 0 else STREET_X[3],
                  CITY_H - 2 if dy < 0 else 1 if dy > 0 else STREET_Y[2])
        reach = getattr(city, "reach", None)
        if reach is None:
            reach = city.reach = [p for p in reachable(
                city, ARRIVE, CITY_GROUND) if p not in city.links]
        pos = min(reach, key=lambda p: abs(p[0] - target[0]) +
                  abs(p[1] - target[1]) + (0 if p[0] in (0, CITY_W - 1) or
                                           p[1] in (0, CITY_H - 1) else 3))
        self.enter(city, pos, "door")
        self.arrive(cid)

    def arrive(self, cid):
        self.say("%s, %s." % (CITIES[cid]["name"], self.date_text()),
                 "quest")
        if "been:" + cid not in self.flags:
            self.flags.add("been:" + cid)
            self.say(CITIES[cid]["intro"], "info")
            tip = {"metro": "The Tower Market is in the south-west "
                            "blocks: free ponies, and Homage.",
                   "crown": "The Steel Rangers' bunker is in the north. "
                            "They talk to civilians. Sometimes.",
                   "port": "The fishers' camp is in the middle of town: "
                           "free ponies.",
                   "colt": "Rebels hide in a cellar in the south-west "
                           "blocks. Find them."}.get(cid)
            if tip:
                self.say(tip, "talk")

    def on_entering(self, area):
        if area.kind_of == "pen" and any(m.hostile for m in area.mobs):
            self.say("Chains, straw, and the smell of despair. A "
                     "slaver turns, whip in her teeth.", "bad")
        elif area.kind_of == "pen" and any(m.role == "captive"
                                           for m in area.mobs):
            self.say("The captives look up. Walk into them to set them "
                     "free.", "info")
        elif area.kind_of == "rebels":
            self.say("A hidden cellar: blankets, crates of stolen hay, "
                     "and very sharp knives.", "info")

    def at_lair(self, cid, x, y):
        lair = LAIRS[cid]
        if cid == "colt" and "ward_open" not in self.flags:
            n = len(self.p["stones"])
            if n < 3:
                self.say("The Ministry seal hums up as you come near: a "
                         "wall of cold blue light across the Cathedral's "
                         "steps. A voice from nowhere says ACCESS DENIED. "
                         "(%s)" % ("You carry %d passkey%s; it wants "
                                   "three." % (n, "" if n == 1 else "s")
                                   if n else "It wants three passkeys."),
                         "bad")
                self.sound.play("spell")
                if not self.test("WIS", label="Wisdom, to stay back")[0]:
                    self.say("You touch it anyway. It burns!", "bad")
                    self.take_damage(roll("1d6"), "The seal")
                self.render()
                return
            self.flags.add("ward_open")
            self.area.grid[y][x] = "ward_open"
            self.sound.play("quest")
            self.say("The three passkeys chirp in your saddlebags. ACCESS "
                     "GRANTED, says the voice, and the blue wall folds "
                     "away. The way into the Cathedral is clear.", "quest")
        self.open_menu("Go into %s?" % lair.name, [
            ("Yes, go in", lambda: self.descend(cid)),
            ("Not yet", lambda: None)])

    def descend(self, lid):
        if self.area.kind == "city":
            self.city_pos[self.city] = list(self.pos)
        self.surface = (self.area.key, list(self.pos))
        area = self.get_area(("dun", lid, 1))
        self.say("You go into %s." % LAIRS[lid].name, "info")
        if lid == "metro":
            self.say("You climb through the hole into the broken tower. "
                     "Something howls overhead.", "info")
        elif lid == "crown":
            self.say("The air below is sweet as candy floss. Keep out of "
                     "the pink.", "info")
        elif lid == "sealed":
            self.say("The cog door was forced long ago. Inside, the lights "
                     "still flicker, your PipBuck clicks, and something in "
                     "a blue jumpsuit shuffles out of sight.", "info")
        elif lid == "mine":
            self.say("The mine smells of smoke and blood. Somewhere below, "
                     "raiders are laughing.", "info")
        self.enter(area, area.start, "stairs")
        if not self.light_radius() or self.light_radius() <= 2:
            self.say("It's dark in here. (Light your lantern: U.)", "info")

    def change_level(self, delta):
        _, lid, level = self.area.key
        up = LAIRS[lid].theme == "tower"
        if level + delta == 0:
            key, pos = self.surface
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dun"}
            area = self.get_area(tuple(key))
            self.say("You climb back out into the air.", "info")
            self.enter(area, pos, "stairs")
            return
        area = self.get_area(("dun", lid, level + delta))
        self.say("You climb %s to %s." % (
            ("up" if delta > 0 else "down") if up else
            ("down" if delta > 0 else "up"),
            area.name.split(", ")[-1]), "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        self.shell.log_add(text, tag)

    @staticmethod
    def the(mob):
        return mob.name if mob.boss or mob.role else "the " + mob.name

    def tally(self, key, n=1):
        self.tallies[key] = self.tallies.get(key, 0) + n

    def hear(self, text):
        """Words in CAPITALS are worth asking about."""
        for w in re.findall(r"\b[A-Z][A-Z'-]+(?: [A-Z][A-Z'-]+)*\b", text):
            if len(w) >= 3 and w.lower() not in ("bye", "job", "news",
                                                 "name"):
                self.topics.add(w.lower())

    # ── The rules ──

    def stat(self, s):
        p = self.p
        v = p["stats"][s]
        for stat_, n, until in p["temp"]:
            if stat_ == s and self.turn < until:
                v -= n
        return max(1, v)

    def off_armor(self):
        """Armor heavier than your class may wear: Disadvantage."""
        p = self.p
        rp = ARMOR[p["armor"]][0] if p["armor"] else 0
        return rp > CLASSES[p["cls"]]["armor"]

    def test(self, s, adv=0, label=None, quiet=False, penalty=0,
             physical=False):
        """Roll a d20 under a stat (Advantage: two dice, keep the lower;
        Disadvantage: keep the higher).  A 1 always succeeds, a 20 always
        fails.  Returns (success, the roll)."""
        p = self.p
        v = self.stat(s)
        if p["heighten"] > 0:
            p["heighten"] -= 1
            adv += 1
        if p["hungry"]:
            adv -= 1
        if self.turn < p["until"].get("fathead", -1):
            adv -= 1
        if physical and self.off_armor():
            adv -= 1
        if s == "INT" and p["cls"] == "Pegasus":
            adv += 1
        adv = max(-1, min(1, adv))
        dice = [random.randint(1, 20) for _ in range(2 if adv else 1)]
        r = min(dice) if adv > 0 else max(dice)
        ok = r != 20 and (r == 1 or r + penalty < v)
        if not quiet:
            how = " with Advantage" if adv > 0 else \
                " with Disadvantage" if adv < 0 else ""
            rolled = " and ".join(str(d) for d in dice)
            self.say("[%s %d%s: %s%s, %s]" % (
                label or STAT_NAMES[s], v, how, rolled,
                " +%d" % penalty if penalty else "",
                "success" if ok else "failure"), "roll")
        return ok, r

    def luck(self):
        return random.randint(1, 6) >= 4

    def day(self):
        return self.turn // DAY + 1

    def used_today(self, what):
        return self.p["used"].get(what) == self.day()

    def use_today(self, what):
        self.p["used"][what] = self.day()

    def level_up(self, why):
        p = self.p
        if p["level"] >= MAX_LEVEL:
            p["destiny"] += 1
            self.say("%s A Destiny Point (%d)." % (why, p["destiny"]),
                     "gold")
            return
        p["level"] += 1
        c = CLASSES[p["cls"]]
        gain = max(1, roll("1d%d" % c["hd"]))
        p["maxhp"] += gain
        p["hp"] += gain
        p["destiny"] += 1
        up = []
        for s in STATS:
            st = p["stats"]
            if random.randint(1, 20) > st[s] or (
                    s in c["twice"] and random.randint(1, 20) > st[s]):
                st[s] += 1
                up.append(s)
        self.sound.play("level")
        self.say("%s You are now level %d! (+%d hit points%s, and a "
                 "Destiny Point.)" % (why, p["level"], gain,
                                      ", +1 " + ", +1 ".join(up)
                                      if up else ""), "quest")

    def damage_die(self):
        """Your damage: your class's die, one smaller with no weapon."""
        p = self.p
        d = CLASSES[p["cls"]]["dmg"]
        if p["melee"] == "Hooves" and p["cls"] not in ("Steel Ranger",
                                                       "Brawler"):
            return {8: 6, 6: 4, 4: 1}.get(d, d)
        return d

    def in_class(self, weapon):
        allowed = CLASSES[self.p["cls"]]["weapons"]
        return allowed == ALL_WEAPONS or weapon in allowed or \
            weapon == "Hooves"

    def armor_rp(self):
        p = self.p
        rp = ARMOR[p["armor"]][0] if p["armor"] else 0
        if p["cls"] == "Steel Ranger":
            rp += 1
        if self.turn < p["until"].get("ward", -1):
            rp += 2
        return rp

    # ── Time ──

    def clock(self):
        t = self.turn + START_HOUR * 60
        return t // DAY + 1, (t % DAY) // 60

    def date_text(self):
        t = self.turn + START_HOUR * 60
        h, m = (t % DAY) // 60, t % 60
        return "day %d, %d:%02d %s" % (t // DAY + 1, (h - 1) % 12 + 1, m,
                                       "am" if h < 12 else "pm")

    def phase(self):
        h = self.clock()[1]
        return ("night" if h >= 21 or h < 5 else "dawn" if h < 7 else
                "dusk" if h >= 19 else "day")

    def days_left(self):
        return max(0, DEADLINE - self.turn)

    def pass_time(self, minutes, quiet=False):
        """Time going by in a lump: resting, sleeping, the road."""
        before = self.phase()
        for _ in range(minutes):
            day = self.clock()[0]
            self.turn += 1
            if self.clock()[0] != day:
                self.new_day()
            self.timers()
            if self.turn >= DEADLINE and "won" not in self.flags:
                self.doom()
                return
        if not quiet and self.phase() != before:
            self.say("It is %s now: %s." % (self.phase(), self.date_text()),
                     "info")

    def new_day(self):
        p = self.p
        day = self.clock()[0]
        left = (DEADLINE - self.turn) // DAY
        if p["cls"] != "Steel Ranger":
            if p["usage"].get("rations"):
                self.use_up("rations", "You eat a ration")
                p["hungry"] = False
            else:
                if not p["hungry"]:
                    self.say("You've nothing to eat. Hungry: Disadvantage on "
                             "everything until you do.", "bad")
                p["hungry"] = True
        self.say("Day %d. The Goddess %s." % (
            day, "wakes tonight!" if left <= 1 else
            "will wake tomorrow night" if left == 2 else
            "will wake in %d days" % left), "quest" if left < 5 else "info")

    def timers(self):
        """What wears off, minute by minute."""
        p = self.p
        if p["poison"]:
            p["poison"] -= 1
            if p["poison"] % 20 == 0 and p["hp"] > 1:
                p["hp"] -= 1
        elif self.turn % MEND_EVERY == 0 and 0 < p["hp"] < self.top_hp() \
                and not p["hungry"]:
            p["hp"] += 1                # wounds close, slowly, if fed
        if p["torch"] and getattr(self, "area", None) and self.area.dark:
            p["torch_turns"] += 1
            if p["torch_turns"] >= 60:
                p["torch_turns"] = 0
                if not self.use_up("lamp oil", "Your lantern sputters, "
                                   "and you top it up"):
                    p["torch"] = False
                elif not p["usage"].get("lamp oil"):
                    p["torch"] = False
                    self.say("Your lantern gutters out: no more oil.",
                             "bad")

    def use_up(self, item, text=None):
        """Roll an item's usage die after using it; False if there was
        none.  A 1 or 2 steps it down a die, and off a d4 it's gone."""
        p = self.p
        die = p["usage"].get(item, 0)
        if not die:
            return False
        r = random.randint(1, die)
        if r <= 2:
            new = usage_down(die)
            p["usage"][item] = new
            if new:
                self.say("%s. (%s: d%d down to d%d.)" % (
                    text or "You use some %s" % item, item, die, new),
                    "info")
            else:
                self.say("%s. That was the last of your %s." % (
                    text or "You use some %s" % item, item), "bad")
                if item in ("spark cells",) and \
                        self.p["cls"] == "Pegasus" and \
                        not self.p["until"].get("juice", 0) > self.turn:
                    self.p["until"]["juice"] = self.turn + 60
                    self.p["usage"][item] = 4
                    self.say("You coax one more charge out of the dead "
                             "cells. (d4)", "good")
        return True

    # ── Turns ──

    def on_key(self, ev):
        if self.talk and self.menu and not self.busy and \
                not ev.state & 0x0C:
            # Talking: the arrow keys choose a word, Return says it.
            # (Return in the box where you type is on_entry's.)
            k = ev.keysym
            if k in ("Up", "KP_Up", "Down", "KP_Down"):
                self.menu_move(-1 if k.endswith("Up") else 1)
                return
            if k in ("Return", "KP_Enter"):
                self.menu_pick()
                return
        k = ev.keysym
        if self.talk and k == "Escape":
            self.end_talk()
            return
        if self.talk or self.busy or ev.state & 0x0C:
            return
        self.walking = None
        if self.menu:
            k = k[3:] if k.startswith("KP_") else k
            if k in ("Up", "w", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "space", "KP_Enter"):
                self.menu_pick()
            elif k.isdigit() and 1 <= int(k) <= len(self.menu["items"]):
                self.menu_pick(int(k) - 1)
            elif not self.menu.get("locked"):
                self.menu_cancel()
            return
        if self.overlay:
            if self.overlay in ("won", "doom", "lost") and k in ("n", "N"):
                self.new_game()
            elif self.overlay not in ("won", "doom", "lost") or k in (
                    "Return", "space", "KP_Enter", "Escape"):
                self.close_overlay()
            return
        if self.aim:
            if k in MOVE_KEYS:
                self.aimed(*MOVE_KEYS[k])
            else:
                self.aim = None
                self.say("Never mind.", "info")
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("e", "E"):
            self.search()
        elif k in ("f", "F"):
            self.ready_fire()
        elif k in ("c", "C"):
            self.cast_menu()
        elif k in ("u", "U"):
            self.use_menu()
        elif k in ("z", "Z"):
            self.rest()
        elif k in ("space", "period", "KP_5"):
            self.wait()
        elif k in ("i", "I"):
            self.show_sheet()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def next_page(self):
        pages = getattr(self, "pages", None)
        if self.overlay in ("won", "doom", "lost") and pages and \
                self.page < len(pages) - 1:
            self.page += 1
            self.overlay_text = pages[self.page]
            self.render()
            return True
        return False

    def close_overlay(self):
        if self.next_page():
            return
        if self.overlay == "lost":
            self.new_game()
            return
        if self.overlay in ("won", "doom"):
            self.action_menu()
            return
        self.overlay = None
        self.render()

    def ready(self):
        return bool(getattr(self, "area", None)) and not (
            self.busy or self.talk or self.overlay or self.menu)

    def move(self, dx, dy):
        if not self.ready():
            return
        p, a = self.p, self.area
        if p["held"]:
            ok, _ = self.test("STR", label="Strength, breaking free",
                              physical=True)
            if ok:
                p["held"] = 0
                self.say("You tear yourself free!", "good")
            else:
                p["held"] -= 1
                self.say("You struggle, and stay stuck.", "bad")
                self.end_turn()
                return
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if a.kind == "inside":
                self.go_outside()
            elif a.kind == "city":
                self.leave_town(dx, dy)
            elif a.kind == "world":
                self.say("The wasteland goes on and on that way, and "
                         "there's nothing in it for you.", "info")
                self.sound.play("bump")
            else:
                self.bump()
            return
        mob = a.mob_at(x, y)
        if mob:
            if mob.hostile:
                self.attack(mob)
                self.end_turn()
            else:
                self.start_talk(mob)
            return
        t = a.grid[y][x]
        if t == "counter":
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return
        link = a.links.get((x, y))
        if link and (t in WALKABLE or t == "ward"):
            self.enter_link(link, x, y)
            return
        if (x, y) in a.landmark and t not in WALKABLE:
            label, desc = a.landmark[(x, y)]
            self.say(desc, "info")
            self.sound.play("bump")
            return
        if t == "gate":                     # the lair's last door: it yields
            a.grid[y][x] = "dfloor"
            self.say("You heave the gate open. It grinds aside.", "info")
            self.sound.play("bump")
            self.end_turn()
            return
        if t not in WALKABLE:
            self.touch(t, x, y)
            return
        if (x, y) in a.traps:
            ok, _ = self.test("INT", label="Intelligence, watching your "
                              "step")
            if ok:
                a.traps.discard((x, y))
                a.items[(x, y)] = "trap"
                self.say("You spot a tripwire just in time.", "good")
                self.end_turn()
                return
        self.pos = [x, y]
        if t == "exit":
            self.go_outside()
            return
        if t == "stairs_down":
            self.change_level(1)
            return
        if t == "stairs_up":
            self.change_level(-1)
            return
        self.step_on(x, y)
        slow = self.underfoot(x, y)
        if a.kind == "world" and not self.overlay:
            self.pass_time(WORLD_STEP - 1, quiet=True)  # a square is a walk
            if self.overlay:
                return
        self.end_turn()
        if slow and not self.busy and not self.overlay:
            self.end_turn()

    def bump(self):
        self.say("Blocked.", "info")
        self.sound.play("bump")

    def underfoot(self, x, y):
        """Traps and hazards; True if wading (slow)."""
        a, p = self.area, self.p
        if (x, y) in a.traps:
            a.traps.discard((x, y))
            a.items[(x, y)] = "trap"
            self.say("Click. A trap!", "bad")
            self.flash(x, y)
            ok, _ = self.test("DEX", label="Dexterity, jumping clear",
                              physical=True)
            if not ok:
                self.take_damage(roll(HD_DAMAGE[min(4, 1 + self.p[
                    "level"] // 2)]), "The trap", armor=False)
            return False
        t = a.grid[y][x]
        if t == "glyph":
            if not self.test("WIS", label="Wisdom, against the glyph",
                             quiet=True)[0]:
                self.say("The glyph flares: pink sparks bite you.", "bad")
                self.take_damage(roll("1d4"), "The glyph", armor=False)
        elif t == "glow":
            if p["cls"] == "Steel Ranger":
                self.say("Your armor's counter ticks. Inside it, you're "
                         "fine.", "info")
            elif self.test("CON", label="Constitution, against the glow",
                           adv=1 if p["cls"] == "Brawler" else 0)[0]:
                self.say("Your PipBuck clicks. You hurry through.", "info")
                self.irradiate(1)
            else:
                self.say("Your PipBuck's clicking turns to a roar. Your "
                         "teeth ache. Radiation!", "bad")
                self.irradiate(roll("1d4") + 1)
        elif t in ("ooze", "pink"):
            if p["cls"] != "Steel Ranger" and not self.test(
                    "CON", label="Constitution, against the pink cloud",
                    adv=1 if p["cls"] == "Brawler" else 0)[0]:
                p["poison"] = max(p["poison"], 60)
                self.say("You breathe the pink. It's sweet, and it burns. "
                         "Poisoned!", "bad")
        elif t in ("pool", "bog"):
            return True
        elif t == "rubble_low":
            return random.random() < 0.3
        return False

    def step_on(self, x, y):
        a, p = self.area, self.p
        item = a.items.pop((x, y), None)
        if item is None:
            return
        if item == "coins":
            n = roll("2d6") * (2 if a.kind == "dungeon" else 1)
            p["coins"] += n
            self.sound.play("gold")
            self.say("Caps! (+%d)" % n, "gold")
        elif item == "salve":
            p["count"]["salve"] = p["count"].get("salve", 0) + 1
            self.say("A healing potion.", "good")
        elif item == "food":
            p["usage"]["rations"] = max(8, p["usage"].get("rations", 0))
            self.say("Tinned oats and a crumbly old snack cake, still "
                     "good. (Rations d%d.)" %
                     p["usage"]["rations"], "good")
        elif item == "torch":
            p["usage"]["lamp oil"] = max(6, p["usage"].get("lamp oil", 0))
            self.say("A flask of lamp oil. (d%d)" % p["usage"]["lamp oil"],
                     "good")
        elif item == "ammo":
            self.find_ammo()
        elif item == "gear":
            n = roll("1d6") * 3
            p["coins"] += n
            self.say("Old-world circuit boards and copper wire: worth %d "
                     "caps to any trader. You pocket them." % n, "gold")
        elif item == "note":
            text = getattr(a, "note", "")
            self.say(text, "mad")
            self.hear(text)
            if text and text not in self.notes:
                self.notes.append(text)
        elif item == "moonstone":
            lid = a.lead
            p["stones"].append(lid)
            self.flags.add("stone:" + lid)
            self.sound.play("quest")
            self.say("A Ministry passkey! A card of brass and enamel, "
                     "still warm from its keeper. (%d of 3)" %
                     len(p["stones"]), "quest")
            self.level_up("You've beaten one of Red Eye's lieutenants.")
            if len(p["stones"]) == 3:
                self.say("Three passkeys. The seal on the Cathedral in "
                         "Coltchester will open for you now.", "quest")
            self.save()
        elif item in ("trap", "bones"):
            a.items[(x, y)] = item

    def find_ammo(self):
        p = self.p
        w = p["ranged"]
        ammo = WEAPONS[w].ammo if w else None
        ammo = ammo or random.choice(("bullets", "stones", "darts",
                                      "spark cells"))
        p["usage"][ammo] = max(8, p["usage"].get(ammo, 0))
        self.say("You find %s. (d%d)" % (ammo, p["usage"][ammo]), "good")

    def touch(self, t, x, y):
        a = self.area
        if (x, y) in a.loot:
            self.open_loot(x, y)
            return
        what = {"water": "Black water, and things moving under it.",
                "rubble": "A heap of broken stone and rebar.",
                "wreck": "A rusted wagon, long since stripped.",
                "wreck2": "A burned-out cart, full of birds' nests.",
                "bus": "A sky-carriage, crashed on its side. Somepony "
                       "lives in it.",
                "tree": "A tree, growing out of the road.",
                "tree_dead": "A dead tree, grey as ash.",
                "bush": "A thicket of brambles and wild roses.",
                "lamp": "A rusted street lamp. Nopony remembers it lit.",
                "sign": "A sign, its words long since rusted away.",
                "hydrant": "A red iron stump. Water once came out of it.",
                "campfire": "A fire, crackling. It's warm.",
                "tent": "A patched tent. Somepony's home.",
                "palisade": "A wall of sharpened stakes.",
                "garden": "Carrots, squash and tomatoes, carefully tended.",
                "forge": "The forge roars.",
                "cauldron": "Something green, bubbling. It smells of mint.",
                "bars": "Iron bars.", "throne": "A throne of black iron.",
                "gate": "A gate.", "ward": "The Ministry seal.",
                "console": "Old machines, still blinking."}.get(t)
        if t.startswith("b_"):
            what = "A ruin, its doors long gone or bricked up."
        if a.kind == "world":
            what = WORLD_LOOK.get(t, what)
        if what:
            self.say(what, "info")
        self.sound.play("bump")

    def open_loot(self, x, y):
        a, p = self.area, self.p
        a.loot.discard((x, y))
        key = a.key
        if a.kind == "world":
            self.flags.add("loot:world:%d:%d" % (x, y))
            self.say(FIND_TEXT.get(a.grid[y][x], "You dig through it."),
                     "info")
            self.pass_time(19, quiet=True)
        elif a.kind == "dungeon":
            self.flags.add("loot:%s:%d:%d:%d" % (key[1], key[2], x, y))
            a.grid[y][x] = "rubble_low"
        else:
            self.flags.add("loot:%s:%s:%d:%d" % (key[1], key[2], x, y))
            a.grid[y][x] = "floor"
        self.sound.play("gold")
        r = random.random()
        bonus = 1 if p["cls"] == "Stable Dweller" else 0
        n = roll("2d10") * max(1, p["level"]) + bonus * roll("2d6")
        p["coins"] += n
        found = ["%d caps" % n]
        if r < 0.3:
            p["count"]["salve"] = p["count"].get("salve", 0) + 1
            found.append("a healing potion")
        elif r < 0.5:
            self.find_ammo()
        elif r < 0.62:
            p["usage"]["lamp oil"] = max(6, p["usage"].get("lamp oil", 0))
            found.append("lamp oil")
        elif r < 0.72 + 0.1 * bonus:
            w = random.choice(("Fire Axe", "Machete", "Spear", "Lead Pipe",
                               "Pistol", "Spark Pistol", "Hunting Rifle",
                               "Spark Rifle"))
            if w not in p["weapons"]:
                p["weapons"].append(w)
                found.append(WEAPONS[w].desc)
        elif r < 0.8:
            arm = random.choice(("scrap barding", "combat barding",
                                 "riot shield"))
            if arm in SHIELDS:
                if not p["shield"]:
                    p["shield"], p["shield_hits"] = arm, SHIELDS[arm][0]
                    found.append("a " + arm)
            elif arm not in p["armors"]:
                p["armors"].append(arm)
                found.append(arm)
        if a.kind == "world" and random.random() < 0.3:
            p["count"]["radpurge"] = p["count"].get("radpurge", 0) + 1
            found.append("a dose of Rad-Purge")
        self.say("%s: %s." % ("You find" if a.kind == "world" else
                              "You break it open", ", ".join(found)),
                 "gold")
        self.end_turn()

    def end_turn(self):
        p, a = self.p, self.area
        before = self.phase()
        day = self.clock()[0]
        self.turn += 1
        if self.clock()[0] != day:
            self.new_day()
        self.timers()
        now = self.phase()
        if now != before and a.kind in ("city", "world"):
            self.say({"dawn": "Grey dawn over %s.",
                      "day": "The cloud brightens to day over %s.",
                      "dusk": "The cloud goes red with sunset over %s.",
                      "night": "Night in %s. Far off, the Goddess "
                               "sings."}[now]
                     % ("the wasteland" if a.kind == "world" else
                        CITIES[self.city]["name"]), "info")
        if self.turn >= DEADLINE and "won" not in self.flags:
            self.doom()
            return
        if p["poison"] and p["hp"] <= 0:
            self.out_of_action("The poison")
            return
        self.render()
        for mob in list(a.mobs):
            if self.overlay or p["hp"] <= 0 or self.area is not a:
                return
            if mob not in a.mobs:
                continue
            if mob.hostile:
                self.monster_act(mob)
            elif mob.role == "toll":
                self.toll_step(mob)
            else:
                self.wander(mob)
        if a.kind == "city":
            self.spawn_city()
        elif a.kind == "world":
            self.spawn_world()
        self.render()

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        traits = ENEMIES[mob.kind].traits if mob.kind else ""
        if t in WATER:
            return "swim" in traits
        if a.kind == "city":
            return t in CITY_GROUND and (x, y) not in a.links
        if a.kind == "world":
            return t in WORLD_GROUND and (x, y) not in a.links
        if a.kind == "inside":
            return t in INSIDE_FLOOR
        if t == "pool":
            return True
        return t in DUNGEON_FLOOR or t == "glyph"

    def monster_act(self, mob):
        e = ENEMIES[mob.kind]
        if mob.asleep:
            px, py = self.pos
            if abs(mob.x - px) + abs(mob.y - py) <= 1 and random.random() < \
                    0.3:
                mob.asleep = 0
            else:
                mob.asleep -= 1
                return
            if not mob.asleep:
                self.say("%s wakes up." % cap(self.the(mob)), "bad")
                mob.aware = True
            return
        if mob.stun:
            mob.stun -= 1
            return
        if "slow" in e.traits and self.turn % 2:
            return
        steps = 2 if "fast" in e.traits else 1
        for _ in range(steps):
            if mob not in self.area.mobs or self.p["hp"] <= 0 or \
                    self.overlay:
                return
            if self.monster_step(mob, e):
                return

    def monster_step(self, mob, e):
        """One move; True if it attacked (and so is done)."""
        a = self.area
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if not mob.aware:
            sneaky = self.p["cls"] in SNEAKY
            if dist <= 1 or ((mob.x, mob.y) in self.visible and dist <= 8 and
                             random.random() < (0.35 if sneaky else 0.6)):
                mob.aware = True
                if mob.boss:
                    self.boss_cry(mob)
            else:
                self.drift(mob)
                return False
        if ("coward" in e.traits and mob.hp < mob.maxhp) or mob.flee:
            mob.flee = max(0, mob.flee - 1)
            for sx, sy in sorted(DIRS, key=lambda d: -abs(px - mob.x - d[0])
                                 - abs(py - mob.y - d[1])):
                if self.can_go(mob, mob.x + sx, mob.y + sy):
                    mob.x += sx
                    mob.y += sy
                    break
            return False
        if dist == 1:
            self.monster_attack(mob, ranged=False)
            return True
        if ("ranged" in e.traits and (dx == 0 or dy == 0) and dist <= 7 and
                self.line_clear(a, mob.x, mob.y, px, py) and
                random.random() < 0.5):
            self.fly(self.line_path((mob.x, mob.y), (px, py)),
                     {"raidergun": "slug", "digger": "stone",
                      "junkbot": "junk", "magister": "lightning",
                      "goddess": "goldfire"}.get(mob.kind, "bolt"))
            self.monster_attack(mob, ranged=True)
            return True
        order = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                       abs(py - mob.y - d[1]) + random.random() * 0.5) \
            if dist <= 16 else [random.choice(DIRS)]
        for sx, sy in order[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break
        return False

    def boss_cry(self, mob):
        cry = {"grimjaw": "Grimjaw rears up on his heap of gems and "
                          "howls: 'LITTLE PONY! GRIMJAW WILL WEAR YOUR "
                          "HOOVES ON A NECKLACE!'",
               "magister": "The Hollow Magister's voice crackles from a "
                           "dozen old speakers: 'A living subject. How "
                           "untidy. Hold still while I take notes.'",
               "sawtooth": "Sawtooth swings her chain and laughs: 'Another "
                           "little pony for the pens! Red Eye pays double "
                           "for the ones with spirit!'",
               "goddess": "The Goddess unfolds her wings, and a thousand "
                          "voices speak at once, gently: 'Little one. You "
                          "have come so far, and you are so alone. Join "
                          "us.'"}.get(mob.kind)
        if cry:
            self.say(cry, "mad")
            self.sound.play("horror" if mob.kind == "goddess" else "fire")

    def drift(self, mob):
        if random.random() < 0.3:
            sx, sy = random.choice(DIRS)
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy

    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        a = self.area
        if (a.inside(x, y) and a.grid[y][x] in mob.roam
                and not a.mob_at(x, y) and [x, y] != self.pos
                and not any((x + ex, y + ey) in a.links for ex, ey in DIRS)
                and (mob.home is None or abs(x - mob.home[0]) +
                     abs(y - mob.home[1]) <= 5)):
            mob.x, mob.y = x, y

    def spawn_city(self):
        """At night the ruins send out their hunters."""
        a = self.area
        cid = self.city
        px, py = self.pos
        a.mobs = [m for m in a.mobs if not m.hostile or m.boss or
                  abs(m.x - px) + abs(m.y - py) <= 26]
        rate = 0.04 if self.phase() == "night" else 0.008
        if cid == "vale":
            rate /= 3
        if random.random() > rate:
            return
        if sum(m.hostile for m in a.mobs) >= 3 + self.day() // 4:
            return
        kinds = CITIES[cid]["danger"]
        for _ in range(20):
            x = px + random.randint(-12, 12)
            y = py + random.randint(-12, 12)
            if (not a.inside(x, y) or a.grid[y][x] not in CITY_GROUND
                    or (x, y) in self.visible or a.mob_at(x, y)
                    or abs(x - px) + abs(y - py) < 8):
                continue
            a.mobs.append(make_monster(random.choice(kinds), x, y))
            return

    def spawn_world(self):
        """The wasteland's hunters, thicker at night and off the roads,
        and of the kinds that roam near the nearest town."""
        a = self.area
        px, py = self.pos
        a.mobs = [m for m in a.mobs if abs(m.x - px) + abs(m.y - py) <= 20]
        rate = 0.11 if self.phase() == "night" else 0.05
        if a.grid[py][px] in ("road", "cracked", "bridge"):
            rate /= 2
        if not any(m.role in STRANGERS for m in a.mobs) and \
                random.random() < (0.015 if self.phase() == "night"
                                   else 0.035):
            self.meet_stranger()
            return
        if random.random() > rate or \
                sum(m.hostile for m in a.mobs) >= 3 + self.day() // 5:
            return
        for _ in range(12):
            ang = random.random() * 2 * math.pi
            r = random.uniform(5, 9)
            x, y = px + round(r * math.cos(ang)), py + round(r * math.sin(ang))
            if not a.inside(x, y) or a.mob_at(x, y) or \
                    a.grid[y][x] not in WORLD_GROUND or (x, y) in a.links:
                continue
            kinds = REGION_DANGER[nearest_town(x, y)]
            if a.grid[y][x] == "pink":
                kinds = ["ghoul", "ghost"]
            a.mobs.append(make_monster(random.choice(kinds), x, y))
            return

    def meet_stranger(self):
        """Not everyone out here wants to eat you: a caravan, a pony who
        needs help, or raiders who'd settle for your caps."""
        a = self.area
        px, py = self.pos
        kind = random.choice(("caravan", "wounded", "toll"))
        for _ in range(12):
            ang = random.random() * 2 * math.pi
            r = random.uniform(3, 6)
            x, y = px + round(r * math.cos(ang)), py + round(r * math.sin(ang))
            if not a.inside(x, y) or a.mob_at(x, y) or \
                    a.grid[y][x] not in WORLD_GROUND or (x, y) in a.links:
                continue
            m = make_stranger(kind, x, y)
            a.mobs.append(m)
            self.say({"caravan": "A trader's cart creaks along %s, guards "
                                 "and all." % where((px, py), (x, y)),
                      "wounded": "Someone's lying in the dirt %s, "
                                 "groaning." % where((px, py), (x, y)),
                      "toll": "A raider steps out %s, grinning. Not "
                              "attacking. Yet." % where((px, py), (x, y))
                      }[kind], "info")
            return

    def toll_step(self, mob):
        """The toll raider comes to you."""
        px, py = self.pos
        if abs(mob.x - px) + abs(mob.y - py) <= 1:
            if not (self.talk or self.menu or self.overlay or self.busy):
                self.start_talk(mob)
            return
        dx = (px > mob.x) - (px < mob.x)
        dy = (py > mob.y) - (py < mob.y)
        for sx, sy in ((dx, 0), (0, dy)) if random.random() < 0.5 else \
                ((0, dy), (dx, 0)):
            if (sx or sy) and self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x, mob.y = mob.x + sx, mob.y + sy
                return

    def stranger(self, mob):
        p = self.p
        self.say("%s (%s): %s" % (mob.name, mob.title, mob.greet), "talk")
        self.hear(mob.greet)
        if mob.role == "wounded":
            items = []
            if p["count"].get("salve"):
                items.append(("Give them a healing potion (%d)" %
                              p["count"]["salve"],
                              lambda: self.help_wounded(mob, True)))
            items.append(("Patch them up (Intelligence)",
                          lambda: self.help_wounded(mob, False)))
            items.append(("Walk on", lambda: self.say(
                "You walk on. The groaning follows you a long way.",
                "info")))
            self.open_menu("%s is hurt" % mob.name, items)
        else:
            items = []
            if p["coins"] >= TOLL:
                items.append(("Pay %d caps" % TOLL,
                              lambda: self.pay_toll(mob)))
            items.append(("Talk your way past (Charisma)",
                          lambda: self.talk_past(mob)))
            items.append(("Fight", lambda: self.toll_fight(mob)))
            self.open_menu("%s wants %d caps" % (mob.name, TOLL), items,
                           cancel=lambda: self.toll_fight(mob))

    def help_wounded(self, mob, potion):
        p, a = self.p, self.area
        if potion:
            p["count"]["salve"] -= 1
            self.say("You tip the potion between their teeth. The bleeding "
                     "stops.", "good")
        else:
            self.pass_time(20, quiet=True)
            ok, _ = self.test("INT", 1 if p["cls"] in (
                "Stable Dweller", "Unicorn Mage") else 0,
                label="Intelligence, binding wounds")
            if not ok:
                self.say("You do what you can. It isn't enough: they "
                         "thank you, and close their eyes, and don't "
                         "open them again.", "bad")
                if mob in a.mobs:
                    a.mobs.remove(mob)
                self.render()
                return
            self.say("You splint the leg and bind the cuts. They'll live.",
                     "good")
        mob.role, mob.title = "helped", "a grateful pony"
        mob.greet = "Thank you. I can make it to town from here."
        mob.talk = {"job": "I was a scavenger. I think I'll be something "
                           "else now.",
                    "news": "Raiders. They're always raiders."}
        n = roll("2d6") + 3
        p["coins"] += n
        told = next((lid for lid in ("sealed", "mine")
                     if "told:" + lid not in self.flags and
                     "boss:" + lid not in self.flags), None)
        if told:
            self.flags.add("told:" + told)
            lx, ly = a.lairs[told]
            for yy in range(ly - 2, ly + 3):
                for xx in range(lx - 2, lx + 3):
                    if a.inside(xx, yy):
                        a.seen[yy * a.w + xx] = 1
            self.npc_say(mob, "Here, it's all I've got: %d caps. And "
                              "listen: %s, %s of here. %s" % (
                                  n, LAIRS[told].name,
                                  compass(lx - self.pos[0],
                                          ly - self.pos[1]),
                                  TOLD[told]))
            self.say("(It's on your map now: M.)", "info")
        else:
            self.npc_say(mob, "Here, it's all I've got: %d caps." % n)
        self.tally("helped")
        self.render()

    def pay_toll(self, mob):
        self.p["coins"] -= TOLL
        self.sound.play("gold")
        self.npc_say(mob, "Pleasure doing business. Mind how you go.")
        if mob in self.area.mobs:
            self.area.mobs.remove(mob)
        self.render()

    def talk_past(self, mob):
        p = self.p
        mob.asked = True
        ok, _ = self.test("CHA", 1 if p["cls"] == "Scamp" else
                          -1 if p["cls"] == "Steel Ranger" else 0,
                          label="Charisma, talking your way past")
        if ok:
            self.npc_say(mob, random.choice((
                "...Fine. You're not worth the bother.",
                "Huh. You've got guts. Go on, before I change my mind.",
                "Red Eye's ponies are hunting you? Then you're none of "
                "mine. Go.")))
            if mob in self.area.mobs:
                self.area.mobs.remove(mob)
            self.render()
        else:
            self.npc_say(mob, "Nice try.")
            self.toll_fight(mob)

    def toll_fight(self, mob):
        a = self.area
        if mob not in a.mobs:
            return
        self.say("%s whistles, and another raider rises out of the dirt "
                 "with a gun." % mob.name, "bad")
        a.mobs.remove(mob)
        foe = make_monster("raider", mob.x, mob.y)
        foe.name = mob.name
        foe.aware = True
        a.mobs.append(foe)
        px, py = self.pos
        for dx, dy in ((2, 0), (-2, 0), (0, 2), (0, -2), (2, 2), (-2, -2)):
            x, y = mob.x + dx, mob.y + dy
            if a.inside(x, y) and not a.mob_at(x, y) and [x, y] != \
                    self.pos and a.grid[y][x] in WORLD_GROUND:
                gun = make_monster("raidergun", x, y)
                gun.aware = True
                a.mobs.append(gun)
                break
        self.render()

    # ── Fighting ──

    def powerful(self, mob):
        return mob.hd >= self.p["level"] + 2

    def attack(self, mob, free=False, ranged=False):
        """Your blow (or shot) at a foe: a STR test, or DEX for a shot."""
        p = self.p
        wname = p["ranged"] if ranged else p["melee"]
        w = WEAPONS[wname]
        e = ENEMIES[mob.kind]
        unready = not mob.aware or mob.asleep or mob.stun
        adv = 0
        if unready and p["cls"] in SNEAKY | {"Pegasus"}:
            adv += 1
        if mob.asleep or mob.stun:
            adv += 1
        if not self.in_class(wname):
            adv -= 1
        if self.powerful(mob):
            adv -= 1
        if ranged and abs(mob.x - self.pos[0]) + abs(mob.y - self.pos[1]) \
                <= 1:
            adv -= 1
        ok, r = self.test("DEX" if ranged else "STR", adv,
                          label="%s, %s" % ("Dexterity" if ranged
                                            else "Strength",
                                            "shooting" if ranged
                                            else "attacking"),
                          penalty=2 if w.twohand else 0, physical=True)
        mob.aware = True
        if not ok:
            if r == 20:
                p["held"] = 1
                self.say("You fumble and stumble: you'll lose a moment "
                         "getting your feet back.", "bad")
            else:
                self.say("You %s %s, and miss." % (
                    "shoot at" if ranged else "swing at", self.the(mob)),
                    "info")
            self.sound.play("miss")
            return
        if unready and p["cls"] == "Stable Dweller":
            dmg = roll("2d6") + p["level"]
            self.say("Your PipBuck's targeting spell lines it up. From the "
                     "shadows!", "good")
        else:
            dmg = roll("1d%d" % self.damage_die()) if self.damage_die() > 1 \
                else 1
        if w.twohand:
            dmg += 2
        if r == 1:
            dmg *= 2
            self.say("A critical blow!", "good")
        self.harm(mob, dmg, "You hit %s" % self.the(mob), weapon=True)

    def harm(self, mob, dmg, text, weapon=True, magic=False):
        e = ENEMIES[mob.kind]
        mob.aware = True
        mob.asleep = 0
        if not magic:
            dmg = max(0, dmg - e.armor)
        if "resist" in e.traits and not magic:
            dmg //= 2
        self.flash(mob.x, mob.y)
        if dmg <= 0:
            self.say(text + ", but it glances off.", "info")
            self.sound.play("miss")
            return
        if "mook" in e.traits:
            mob.hp = 0
        else:
            mob.hp -= dmg
        if mob.hp <= 0:
            self.say("%s: %d damage." % (text, dmg), "good")
            self.down(mob)
            return
        self.sound.play("hit")
        self.say("%s: %d damage%s." % (
            text, dmg, ", and it's badly hurt" if mob.hp <= mob.maxhp // 3
            else ""), "good")

    def down(self, mob):
        a = self.area
        e = ENEMIES[mob.kind]
        self.tally("foes")
        self.sound.play("kill")
        if mob in a.mobs:
            a.mobs.remove(mob)
        if mob.kind == "goddess":
            self.flags.add("won")
            self.say("The Goddess cries out in a thousand voices, and then "
                     "in one, and then in none. All over Coltchester the "
                     "singing stops. Somewhere a slave laughs, and can't "
                     "stop.", "quest")
            self.sound.play("quest")
            self.save()
            self.shell.after(1200, self.show_won)
            return
        self.say("%s %s." % (cap(self.the(mob)),
                             "falls apart in a shower of sparks"
                             if "robot" in e.traits else
                             "crumbles to dust" if "undead" in e.traits
                             else "is dead"), "good")
        if mob.stone in SIDE_LAIRS:
            self.flags.add("boss:" + mob.stone)
            self.side_prize(mob.stone)
        elif mob.stone:
            a.items[(mob.x, mob.y)] = "moonstone"
            self.flags.add("boss:" + mob.stone)
            self.say("Something clatters from the lieutenant's chain: a "
                     "Ministry passkey!", "gold")
        elif "human" in e.traits and (mob.x, mob.y) not in a.items and \
                random.random() < 0.5:
            a.items[(mob.x, mob.y)] = "coins"
        if a.kind_of == "pen" and not any(m.hostile for m in a.mobs):
            self.flags.add("pen_won:" + a.city)
            self.say("The pen is yours. The captives stare at you, not "
                     "daring to hope. (Walk into them.)", "quest")

    def side_prize(self, lid):
        p = self.p
        n = 40 + roll("2d20")
        p["coins"] += n
        p["count"]["salve"] = p["count"].get("salve", 0) + 2
        found = ["%d caps" % n, "two healing potions"]
        if lid == "sealed":
            p["count"]["radpurge"] = p["count"].get("radpurge", 0) + 2
            found.append("two doses of Rad-Purge")
        else:
            w = next((w for w in ("Hunting Rifle", "Spark Rifle",
                                  "Sledgehammer") if w not in p["weapons"]),
                     None)
            if w:
                p["weapons"].append(w)
                found.append(WEAPONS[w].desc)
        self.sound.play("gold")
        self.say("You crack open %s: %s." % (SIDE_LAIRS[lid],
                                             ", ".join(found)), "gold")
        self.level_up("You've cleared %s." % LAIRS[lid].name)
        self.save()

    def monster_attack(self, mob, ranged=False):
        """A foe's attack: you test STR (in melee) or DEX (a shot) to get
        out of the way."""
        p = self.p
        e = ENEMIES[mob.kind]
        name = cap(self.the(mob))
        adv = 0
        if self.powerful(mob):
            adv -= 1
        if p["cls"] == "Scamp" and mob.hd >= 3:
            adv += 1
        stat = "DEX" if ranged else "STR"
        ok, r = self.test(stat, adv, label="%s, %s" % (
            STAT_NAMES[stat], "dodging" if ranged else "blocking"),
            physical=True)
        if not ok and self.destiny_auto and p["destiny"] > 0 and \
                p["hp"] <= roll(HD_DAMAGE[min(10, mob.hd)]) + 1:
            p["destiny"] -= 1
            self.say("Destiny! You roll again. (%d left)" % p["destiny"],
                     "gold")
            ok, r = self.test(stat, adv, label="%s, again" %
                              STAT_NAMES[stat], physical=True)
        if ok:
            self.say("%s %s with %s; you %s." % (
                name, "shoots at you" if ranged else "comes at you",
                e.weapon, "duck" if ranged else "turn it aside"), "info")
            self.sound.play("miss")
            if r == 1 and not ranged:
                self.say("An opening! You strike back.", "good")
                self.attack(mob, free=True)
            return
        dmg = roll(HD_DAMAGE[min(10, mob.hd)])
        if r == 20:
            dmg *= 2
            self.say("A terrible blow!", "bad")
        if "shock" in e.traits and p["cls"] == "Steel Ranger":
            dmg *= 2
            self.say("Lightning! Your armor's circuits scream.", "bad")
        self.take_damage(dmg, "%s, with %s" % (name, e.weapon),
                         armor=mob.kind != "goddess")
        if p["hp"] <= 0:
            return
        if "venom" in e.traits and p["cls"] != "Steel Ranger":
            if not self.test("CON", 1 if p["cls"] == "Brawler" else 0,
                             label="Constitution, against the venom")[0]:
                p["poison"] = max(p["poison"], 120)
                self.say("Venom burns in your veins. Poisoned!", "bad")
        if "grab" in e.traits and not p["held"]:
            p["held"] = 2
            self.say("%s grabs you and holds on!" % name, "bad")

    def take_damage(self, dmg, text, armor=True):
        p = self.p
        rp = self.armor_rp() if armor else 0
        dmg = max(0, dmg - rp)
        if dmg >= 4 and p["shield"] and armor:
            p["shield_hits"] -= 1
            self.say("%s: your %s takes the blow%s!" % (
                text, p["shield"], " and shatters" if p["shield_hits"] <= 0
                else ""), "info")
            if p["shield_hits"] <= 0:
                p["shield"] = None
            return
        if self.turn < p["until"].get("hide", -1):
            dmg = (dmg + 1) // 2
        if dmg <= 0:
            self.say("%s: your armor takes it." % text, "info")
            return
        self.flash(*self.pos)
        self.sound.play("hurt")
        p["hp"] -= dmg
        self.say("%s: %d damage!%s" % (text, dmg, " (%d left)" % p["hp"]
                                       if p["hp"] > 0 else ""), "bad")
        if p["cls"] == "Griffon" and 0 < p["hp"] <= p["maxhp"] // 2 and \
                not self.used_today("hide"):
            self.use_today("hide")
            p["until"]["hide"] = self.turn + p["level"] + 4
            self.say("You set your beak and ignore it. (Hard as Nails: "
                     "half damage for a while.)", "good")
        if p["hp"] <= 0:
            self.out_of_action(text)

    def out_of_action(self, text):
        """At zero hit points: roll on the Out of Action table."""
        p = self.p
        p["hp"] = 0
        self.walking = None
        self.aim = None
        self.flights = []
        self.say("You go down...", "bad")
        self.sound.play("death")
        r = random.randint(1, 10)
        self.say("[Out of Action: %d. %s]" % (r, OOFA[r]), "roll")
        if r >= 6 and p["destiny"] > 0 and self.destiny_auto:
            p["destiny"] -= 1
            r = random.randint(1, 10)
            self.say("Destiny! You roll again: %d. %s" % (r, OOFA[r]),
                     "gold")
        if r == 10:
            self.hero_dead(text)
            return
        day = self.turn + DAY
        if r == 3:
            p["until"]["fathead"] = self.turn + 60
        elif r == 4:
            p["temp"] += [[s, 2, day] for s in ("STR", "DEX", "CON")]
        elif r == 5:
            p["temp"] += [[s, 2, day] for s in ("INT", "WIS")]
        elif r in (6, 7, 8, 9):
            s = {6: random.choice(("STR", "DEX")),
                 7: random.choice(("INT", "WIS")), 8: "CHA", 9: "DEX"}[r]
            p["stats"][s] = max(3, p["stats"][s] - 2)
        p["temp"] = [t for t in p["temp"] if t[2] > self.turn]
        p["hp"] = roll("1d4")
        p["held"] = 0
        p["poison"] = 0
        lost = p["coins"] // 2
        p["coins"] -= lost
        a = self.area
        if a.kind == "dungeon":
            pos = a.start
            where_ = "near the way in"
        elif a.kind == "city" and self.city == "vale":
            a = self.get_area(("bld", "vale", "healer"))
            pos = a.start
            where_ = "in Velvet Remedy's clinic"
        else:
            pos = a.start
            where_ = "where somepony dragged you"
        for m in self.area.mobs:
            if m.hostile:
                m.aware = False
        self.pass_time(120, quiet=True)
        if self.overlay:
            return
        self.say("You come to %s, two hours later, with %d hit point%s%s." %
                 (where_, p["hp"], "" if p["hp"] == 1 else "s",
                  " and lighter by %d cap%s" % (lost, "" if lost == 1
                                                  else "s")
                  if lost else ""), "bad")
        self.enter(a, pos, "stairs")

    def hero_dead(self, text):
        p = self.p
        self.tally("deaths")
        self.overlay = "lost"
        stones = len(p["stones"])
        self.pages = ["\n".join([
            "THE END OF %s" % p["name"].upper(), "",
            "\n".join(wrap("%s, the %s, fell in %s on %s, cut down by %s." % (
                p["name"], p["cls"].lower(), self.area.name,
                self.date_text(), text.split(",")[0].lower()), 52)), "",
            "\n".join(wrap("%s passkey%s won, %d slave pen%s broken, %d "
                           "foes laid low. New Clover will sing about "
                           "you, a little." % (
                               stones or "No", "" if stones == 1 else "s",
                               sum(1 for f in self.flags
                                   if f.startswith("freed:")),
                               "" if sum(1 for f in self.flags
                                         if f.startswith("freed:")) == 1
                               else "s", self.tallies.get("foes", 0)),
                           52)),
            "", "Press any key to set out again."])]
        self.page = 0
        self.overlay_text = self.pages[0]
        try:
            os.remove(SAVE_FILE)
        except OSError:
            pass
        self.render()

    # ── Firing ──

    def ready_fire(self):
        if not self.ready():
            return
        p = self.p
        w = p["ranged"]
        if not w:
            self.say("You've nothing to shoot with. (Wield a pistol, "
                     "rifle, slingshot or dart gun: U.)", "info")
            return
        ammo = WEAPONS[w].ammo
        if not p["usage"].get(ammo):
            self.say("You're out of %s." % ammo, "bad")
            return
        self.aim = ("fire",)
        self.say("Fire %s which way? (a direction; anything else to "
                 "cancel)" % WEAPONS[w].desc, "you")

    def aimed(self, dx, dy):
        what = self.aim
        self.aim = None
        if what[0] == "fire":
            self.fire(dx, dy)
        elif what[0] == "firebolt":
            self.firebolt(dx, dy)

    def target_in_line(self, dx, dy, reach):
        a = self.area
        x, y = self.pos
        path = []
        for _ in range(reach):
            x, y = x + dx, y + dy
            if not a.inside(x, y) or (a.grid[y][x] not in WALKABLE and
                                      a.grid[y][x] not in WATER and
                                      a.grid[y][x] != "pool"):
                break
            path.append((x, y))
            mob = a.mob_at(x, y)
            if mob and mob.hostile:
                return mob, path
        return None, path

    def fire(self, dx, dy):
        p = self.p
        w = p["ranged"]
        ammo = WEAPONS[w].ammo
        mob, path = self.target_in_line(dx, dy, 8)
        self.sound.play("shot" if ammo in GUN_AMMO else "throw")
        self.fly(path, MISSILE[ammo])
        if mob is None:
            self.say("You shoot, and hit nothing.", "info")
        else:
            self.attack(mob, ranged=True)
        self.use_up(ammo, "You reach for more %s" % ammo)
        self.end_turn()

    def fly(self, path, tile):
        """A missile crossing the squares between: drawn a square every
        25 ms, one after another, while the game goes on."""
        self.flights.append((list(path[:12]), tile))
        if len(self.flights) == 1:
            self.fly_step()

    def fly_step(self):
        while self.flights and not self.flights[0][0]:
            self.flights.pop(0)
        if not self.flights:
            self.screen.sprite("missile", 0, 0, None)
            return
        path, tile = self.flights[0]
        x, y = path.pop(0)
        cols, rows, ox, oy, ts = self.view
        i = x - self.pos[0] + cols // 2
        j = y - self.pos[1] + rows // 2
        if 0 <= i < cols and 0 <= j < rows:
            self.screen.sprite("missile", ox + i * ts, oy + j * ts, tile)
        self.shell.after(25, self.fly_step)

    @staticmethod
    def line_path(a, b):
        (x0, y0), (x1, y1) = a, b
        n = max(abs(x1 - x0), abs(y1 - y0))
        return [(x0 + round((x1 - x0) * k / n), y0 + round((y1 - y0) * k / n))
                for k in range(1, n + 1)] if n else []

    # ── Spells and miracles ──

    def cast_menu(self):
        if not self.ready():
            return
        p = self.p
        if p["cls"] == "Unicorn Mage":
            if self.turn < p["until"].get("burnt", -1):
                self.say("The magic is burnt out of you until tomorrow.",
                         "bad")
                return
            items = [("%s: %s" % (s, d), lambda s=s: self.cast(s))
                     for s, d in SPELLS.items()]
            self.open_menu("Cast a spell (an Intelligence test)",
                           items + [("Nothing", lambda: None)])
        elif p["cls"] == "Zebra Shaman":
            left = self.miracles_left()
            if not left:
                self.say("Your herbs are spent. No more brews today.",
                         "info")
                return
            items = [("%s: %s" % (s, d), lambda s=s: self.miracle(s))
                     for s, d in MIRACLES.items()]
            self.open_menu("Brew a potion (%d left today)" % left,
                           items + [("Nothing", lambda: None)])
        else:
            self.say("You've no magic. Your %s will have to do." %
                     WEAPONS[p["melee"]].desc.split()[-1], "info")

    def miracles_left(self):
        p = self.p
        n = 2 + (p["level"] - 1) // 2
        used = p["used"].get("miracles", [0, 0])
        if used[0] != self.day():
            used = [self.day(), 0]
        return max(0, n - used[1])

    def spend_miracle(self):
        used = self.p["used"].get("miracles", [0, 0])
        if used[0] != self.day():
            used = [self.day(), 0]
        used[1] += 1
        self.p["used"]["miracles"] = used

    def cast(self, spell):
        p = self.p
        ok, r = self.test("INT", label="Intelligence, casting %s" % spell)
        self.sound.play("spell")
        if not ok:
            if r == 20:
                p["until"]["burnt"] = self.turn + DAY
                self.say("The spell twists in your hands and burns the "
                         "magic out of you for a day!", "bad")
            else:
                self.say("The words come out wrong. Nothing happens.",
                         "info")
            self.end_turn()
            return
        if spell == "Arcane Bolt":
            self.aim = ("firebolt",)
            self.say("Arcane Bolt: which way?", "you")
            return
        if spell == "Sleep":
            n = 0
            for m in list(self.area.mobs):
                if m.hostile and (m.x, m.y) in self.visible and \
                        abs(m.x - self.pos[0]) + abs(m.y - self.pos[1]) <= 4 \
                        and m.hd < p["level"] + 3 and not m.boss and \
                        not {"undead", "robot"} & set(
                            ENEMIES[m.kind].traits.split()):
                    m.asleep = 20 + roll("1d6") * p["level"]
                    n += 1
            self.say("A grey mist rolls out. %s" % (
                "%d foe%s nod%s off." % (n, "" if n == 1 else "s",
                                         "s" if n == 1 else "")
                if n else "Nothing close by is sleepy enough."), "good")
        elif spell == "Shield":
            p["until"]["ward"] = self.turn + 60
            self.say("A shimmering bubble of magic wraps you. (Soaks 2 "
                     "more for an hour.)", "good")
        elif spell == "Mend":
            self.heal(roll("1d6") + p["level"], "Your wounds knit")
        self.end_turn()

    def firebolt(self, dx, dy):
        mob, path = self.target_in_line(dx, dy, 8)
        self.fly(path, "firebolt")
        self.sound.play("fire")
        if mob is None:
            self.say("The bolt of magic splashes against the wall.",
                     "info")
        else:
            self.harm(mob, roll("2d6") + self.p["level"],
                      "Arcane fire engulfs %s" % self.the(mob), magic=True)
        self.end_turn()

    def miracle(self, name):
        p = self.p
        self.spend_miracle()
        self.sound.play("chant")
        if name == "Heal":
            hd = CLASSES[p["cls"]]["hd"]
            self.heal(roll("2d%d" % hd), "The brew burns going down, and "
                      "mends you")
        elif name == "Heighten":
            p["heighten"] = 3
            self.say("The brew sharpens your senses. (Advantage on your "
                     "next three tests.)", "good")
        elif name == "Banish":
            self.say("You fling the spirit-ward and chant: 'Restless "
                     "dead, be gone; this ground is not yours to walk "
                     "upon!'", "you")
            ok, _ = self.test("WIS", label="Wisdom, banishing")
            n = 0
            for m in list(self.area.mobs):
                if m.hostile and "undead" in ENEMIES[m.kind].traits and \
                        abs(m.x - self.pos[0]) + abs(m.y - self.pos[1]) <= 6:
                    n += 1
                    if ok and m.hd <= p["level"] + 2:
                        self.say("%s crumbles to dust!" % cap(self.the(m)),
                                 "good")
                        self.down(m)
                    else:
                        m.flee = 10
            if not n:
                self.say("There are no restless dead here to banish.",
                         "info")
            elif not ok:
                self.say("The dead shrink back from you.", "info")
        elif name == "Night-Eye":
            p["until"]["deathsight"] = self.turn + 60
            self.say("Your pupils go wide as a cat's; the dark is no "
                     "darker than dusk. (An hour.)", "good")
        self.end_turn()

    def heal(self, n, text):
        p = self.p
        before = p["hp"]
        p["hp"] = max(p["hp"], min(self.top_hp(), p["hp"] + n))
        self.sound.play("potion")
        self.say("%s. (+%d: %d of %d%s)" % (
            text, p["hp"] - before, p["hp"], self.top_hp(),
            ", for the rads" if p.get("rads") else ""), "good")

    def top_hp(self):
        """The most hit points you can heal to: radiation eats into it."""
        p = self.p
        return max(1, p["maxhp"] - p.get("rads", 0))

    def irradiate(self, n):
        p = self.p
        p["rads"] = min(p["maxhp"] - 1, p.get("rads", 0) + n)
        if p["hp"] > self.top_hp():
            p["hp"] = self.top_hp()
        self.say("(Rads %d: you can't heal past %d HP until they're "
                 "purged.)" % (p["rads"], self.top_hp()), "bad")

    # ── Things ──

    def use_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        if p["count"].get("salve"):
            items.append(("Drink a healing potion (%d)" % p["count"]["salve"],
                          self.use_salve))
        if p["count"].get("radpurge") and p.get("rads"):
            items.append(("Drink Rad-Purge (%d)" % p["count"]["radpurge"],
                          self.use_radpurge))
        if p["count"].get("antidote") and p["poison"]:
            items.append(("Drink antivenom (%d)" % p["count"]["antidote"],
                          self.use_antidote))
        if p["usage"].get("rations") and p["hungry"]:
            items.append(("Eat a ration", self.eat))
        if p["torch"]:
            items.append(("Put out your lantern", self.torch_off))
        elif p["usage"].get("lamp oil"):
            items.append(("Light your lantern (oil d%d)" %
                          p["usage"]["lamp oil"],
                          self.torch_on))
        for w in p["weapons"]:
            if w not in (p["melee"], p["ranged"]):
                items.append(("Wield %s%s" % (
                    WEAPONS[w].desc, "" if self.in_class(w) else
                    " (not your class's: Disadvantage)"),
                    lambda w=w: self.wield(w)))
        for arm in p["armors"]:
            if arm != p["armor"]:
                heavy = ARMOR[arm][0] > CLASSES[p["cls"]]["armor"]
                items.append(("Wear %s%s" % (arm, " (too heavy for you: "
                                             "Disadvantage)" if heavy
                                             else ""),
                              lambda arm=arm: self.wear(arm)))
        if p["armor"]:
            items.append(("Take off %s" % p["armor"], lambda: self.wear(None)))
        items.append(("Nothing", lambda: None))
        self.open_menu("Use what?", items)

    def use_salve(self):
        p = self.p
        p["count"]["salve"] -= 1
        self.heal(roll("1d6") + 2, "The potion tastes of cherries, and "
                  "the hurt fades")
        self.end_turn()

    def use_radpurge(self):
        p = self.p
        p["count"]["radpurge"] -= 1
        p["rads"] = max(0, p.get("rads", 0) - roll("2d6") - 2)
        self.say("The Rad-Purge tastes of chalk and orange peel. You feel "
                 "sick, and then better. (Rads %d)" % p["rads"], "good")
        self.end_turn()

    def use_antidote(self):
        p = self.p
        p["count"]["antidote"] -= 1
        p["poison"] = 0
        self.say("The antivenom tastes of copper. The burning fades.",
                 "good")
        self.end_turn()

    def eat(self):
        p = self.p
        self.use_up("rations", "You eat")
        p["hungry"] = False
        self.say("That's better.", "good")
        self.end_turn()

    def torch_on(self):
        self.p["torch"] = True
        self.say("You light your lantern.", "info")
        self.end_turn()

    def torch_off(self):
        self.p["torch"] = False
        self.say("You put out your lantern.", "info")
        self.end_turn()

    def wield(self, w):
        p = self.p
        if WEAPONS[w].ranged:
            p["ranged"] = w
        else:
            p["melee"] = w
        self.say("You ready %s." % WEAPONS[w].desc, "info")
        self.end_turn()

    def wear(self, arm):
        p = self.p
        if p["cls"] == "Steel Ranger" and arm:
            self.say("It doesn't fit over your power armor.", "info")
            return
        p["armor"] = arm
        self.say("You %s." % ("put on the " + arm if arm
                              else "take off your armor"), "info")
        self.pass_time(10, quiet=True)
        self.render()

    def search(self):
        if not self.ready():
            return
        a = self.area
        p = self.p
        ok, _ = self.test("WIS", 1 if p["cls"] == "Stable Dweller" else 0,
                          label="Wisdom, searching")
        self.pass_time(9, quiet=True)
        found = False
        px, py = self.pos
        if ok:
            for (x, y), what in list(a.hidden.items()):
                if abs(x - px) <= 2 and abs(y - py) <= 2:
                    del a.hidden[(x, y)]
                    a.items[(x, y)] = what
                    found = True
            for x, y in list(a.traps):
                if abs(x - px) + abs(y - py) <= 4:
                    a.traps.discard((x, y))
                    a.items[(x, y)] = "trap"
                    self.say("A trap, %s." % where((px, py), (x, y)), "good")
                    found = True
        self.say("You find something!" if found else
                 "You search carefully, and find nothing.",
                 "good" if found else "info")
        self.end_turn()

    def rest(self):
        if not self.ready():
            return
        a = self.area
        p = self.p
        if any(m.hostile and ((m.x, m.y) in self.visible or
                              abs(m.x - self.pos[0]) + abs(m.y - self.pos[1])
                              <= 6) for m in a.mobs):
            self.say("Not with foes about.", "bad")
            return
        self.say("You sit with your back to a wall and rest an hour.",
                 "info")
        self.pass_time(60, quiet=True)
        if self.overlay:
            return
        if not self.used_today("rest"):
            self.use_today("rest")
            self.heal(roll("1d%d" % CLASSES[p["cls"]]["hd"]),
                      "The rest does you good")
        else:
            self.say("You've rested once today already; it doesn't help "
                     "much more.", "info")
        if p["cls"] == "Zebra Shaman" and not self.used_today("recharge") \
                and self.miracles_left() == 0:
            self.use_today("recharge")
            if self.luck():
                used = p["used"].get("miracles", [self.day(), 0])
                used[1] = max(0, used[1] - 1)
                p["used"]["miracles"] = used
                self.say("You find the makings of one more brew today.",
                         "good")
        if a.kind != "inside" and random.randint(1, 6) == 1:
            self.ambush("Something found you while you rested!")
        self.render()

    def ambush(self, text, n=1):
        a = self.area
        kinds = LAIRS[a.lead].monsters if a.kind == "dungeon" else \
            CITIES[self.city]["danger"] if a.kind == "city" else \
            REGION_DANGER[nearest_town(*self.pos)] if a.kind == "world" \
            else None
        if not kinds:
            return
        px, py = self.pos
        placed = 0
        for _ in range(60):
            if placed >= n:
                break
            x = px + random.randint(-4, 4)
            y = py + random.randint(-4, 4)
            if abs(x - px) + abs(y - py) < 2 or not a.inside(x, y) or \
                    a.mob_at(x, y):
                continue
            t = a.grid[y][x]
            if t not in CITY_GROUND and t not in DUNGEON_FLOOR and \
                    (t not in WORLD_GROUND or (x, y) in a.links):
                continue
            m = make_monster(random.choice(kinds[:3]), x, y)
            m.aware = True
            a.mobs.append(m)
            placed += 1
        if placed:
            self.say(text, "bad")

    # ── The road ──

    def travel_menu(self):
        """Flights, for a hero with the sky-wagon (see leave_town)."""
        here = self.city
        items = []
        for cid in CITY_ORDER:
            if cid == here:
                continue
            days = flight_days(here, cid)
            if self.p["lizard"]:
                days = days / 2.0
            items.append(("%s, %s (%s)" % (
                CITIES[cid]["name"], CITIES[cid]["short"],
                "%g day%s %s" % (days, "" if days == 1 else "s",
                                 "by sky-wagon" if self.p["lizard"]
                                 else "on hoof")),
                lambda cid=cid: self.travel_to(cid)))
        items.append(("Stay in %s" % CITIES[here]["name"], lambda: None))
        self.open_menu("The road out of %s. Where to?" % CITIES[here]["name"],
                       items)

    def travel_to(self, cid):
        p = self.p
        frm = self.city
        days = flight_days(frm, cid)
        minutes = int(days * DAY / (2 if p["lizard"] else 1))
        if self.area.kind == "city":
            self.city_pos[frm] = list(self.pos)
        self.say("You set out for %s%s." % (
            CITIES[cid]["name"], " in Calamity's sky-wagon" if p["lizard"]
            else ""),
            "info")
        self.pass_time(minutes, quiet=True)
        if self.overlay:
            return
        self.city = cid
        self.cache = {k: v for k, v in self.cache.items()
                      if k[0] in ("city", "world", "stable")}
        city = self.get_area(("city", cid))
        self.enter(city, ARRIVE, "door")
        self.arrive(cid)
        if cid != "vale" and random.random() < min(0.8, 0.3 * days):
            self.ambush("Ambush! %s followed you in off the road." %
                        cap(ENEMIES[CITIES[cid]["danger"][0]].name + "s"),
                        n=random.randint(1, 2))

    # ── Talking ──

    def start_talk(self, mob):
        if mob.role == "captive":
            self.free_captives(mob)
            return
        if mob.role in ("wounded", "toll"):
            self.stranger(mob)
            return
        self.talk = {"mob": mob}
        self.shell.show_entry(focus=not ANDROID)
        self.say("%s (%s): %s" % (mob.name, mob.title, mob.greet), "talk")
        self.hear(mob.greet)
        if mob.role == "elder":
            self.elder_turns(mob)
        elif mob.role == "overmare":
            self.overmare_turns(mob)
        self.talk_menu()

    def talk_menu(self):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        items = [("Name", lambda: self.converse("name")),
                 ("Job", lambda: self.converse("job")),
                 ("News", lambda: self.converse("news"))]
        if mob.shop:
            items.append(("Trade", lambda: self.converse("trade")))
        if mob.role == "healer":
            items.append(("Heal me", lambda: self.converse("heal")))
        if mob.role == "innkeep":
            items.append(("A bed for the night", lambda: self.converse(
                "sleep")))
        known = [k for k in mob.talk if k not in ("job", "news")]
        for k in sorted(self.topics):
            if k in known:
                items.append((k.upper(), lambda k=k: self.converse(k)))
        items.append(("Bye", self.end_talk))
        self.open_menu("%s (type a word, or choose)" % mob.name, items,
                       cancel=self.end_talk)

    def converse(self, word):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        w = word.strip().lower()
        self.say("> %s" % (w or "bye"), "you")
        if w in ("", "bye", "farewell"):
            self.end_talk()
            return
        if w == "name":
            self.npc_say(mob, "I'm %s." % mob.name)
        elif w.startswith(("trad", "buy", "shop")) and mob.shop:
            self.shop_menu(mob)
            return
        elif w.startswith("heal") and mob.role == "healer":
            self.healer(mob)
            return
        elif w.startswith(("slee", "bed", "room")) and \
                mob.role == "innkeep":
            self.sleep_inn(mob)
            return
        else:
            text = None
            for k, v in mob.talk.items():
                if w == k or (len(w) >= 4 and k.startswith(w[:4])) or \
                        (len(w) >= 4 and w.startswith(k[:4])):
                    text = v
                    break
            if text is None:
                text = random.choice(("Never heard of it.",
                                      "Can't help you there.",
                                      "Ask someone else.",
                                      "Hm? No idea."))
            self.npc_say(mob, text)
        self.talk_menu()

    def npc_say(self, mob, text):
        self.say("%s: %s" % (mob.name, text), "talk")
        self.hear(text)

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.shell.hide_entry()
        if getattr(self, "p", None) and getattr(self, "area", None):
            self.render()

    def on_entry(self, ev=None):
        text = self.shell.take_entry().strip()
        if not self.talk:
            return
        if not text and self.menu:
            self.menu_pick()            # the word the arrow keys chose
            return
        self.menu = None
        self.converse(text)

    def elder_turns(self, mob):
        """What the Elder has to say about how you're doing."""
        p = self.p
        n = len(p["stones"])
        freed = sum(1 for f in self.flags if f.startswith("freed:"))
        if "met_elder" not in self.flags:
            self.flags.add("met_elder")
            self.npc_say(mob, "So you're the one. Out of STABLE TWO, or off "
                              "the road, it doesn't matter now: you're the "
                              "first pony in a long while to walk in here "
                              "with a spine. I need somepony stubborn. Ask "
                              "me about RED EYE.")
            self.npc_say(mob, "And take this: New Clover's gift to the "
                              "free.")
            p["coins"] += 20
            p["count"]["salve"] = p["count"].get("salve", 0) + 1
            self.say("(+20 caps and a healing potion.)", "gold")
            return
        if freed >= 2 and "pens_reward" not in self.flags:
            self.flags.add("pens_reward")
            self.npc_say(mob, "The ponies you freed are here, every one. "
                              "They rang the Lantern Hall's old bell till "
                              "the rope broke. New Clover owes you.")
            self.level_up("New Clover honors you.")
        if n == 3 and "told_three" not in self.flags:
            self.flags.add("told_three")
            self.npc_say(mob, "Three passkeys. I never thought to see it. "
                              "Go to Coltchester. Walk into the seal with "
                              "them, and end her.")
        elif n:
            self.npc_say(mob, "%d passkey%s. %d to go. The Goddess won't "
                              "wait." % (n, "" if n == 1 else "s", 3 - n))

    def overmare_turns(self, mob):
        """The Overmare sends you out, and is glad to see you back."""
        p = self.p
        if "met_overmare" not in self.flags:
            self.flags.add("met_overmare")
            self.npc_say(mob, "The radios have been picking up a SINGING "
                              "from outside, and it's calling our ponies "
                              "to the door in their sleep. Somepony has to "
                              "go OUTSIDE and stop it. I've chosen you.")
            self.npc_say(mob, "Take these. The Stable's caps, from the vault, "
                              "and a potion from Doctor Feverfew. The great "
                              "DOOR is at the west end of the atrium.")
            p["coins"] += 30
            p["count"]["salve"] = p["count"].get("salve", 0) + 1
            self.say("(+30 caps and a healing potion.)", "gold")
            return
        n = len(p["stones"])
        if "won" in self.flags:
            self.npc_say(mob, "The singing's stopped. The sleepwalkers "
                              "woke up this morning asking for breakfast. "
                              "You did it.")
        elif "been:metro" in self.flags or n:
            self.npc_say(mob, "You came back! What's it like out there? "
                              "No, don't tell me. The song's louder every "
                              "night; get back out there.")

    def free_captives(self, mob):
        a = self.area
        if any(m.hostile for m in a.mobs):
            self.say("%s: 'Behind you!'" % mob.name, "talk")
            return
        captives = [m for m in a.mobs if m.role == "captive"]
        for m in captives:
            a.mobs.remove(m)
        cid = a.city
        self.flags.add("freed:" + cid)
        self.tally("freed", len(captives))
        self.sound.play("quest")
        self.say("You break the chains. %d ponies stumble out into the "
                 "light. They're heading for New Clover, they tell you, and "
                 "the Lantern Hall." % len(captives), "quest")
        n = roll("2d6") + 5
        self.p["coins"] += n
        self.say("One presses a pouch into your hoof: every cap they'd "
                 "hidden from the slavers. (+%d caps)" % n, "gold")
        freed = sum(1 for f in self.flags if f.startswith("freed:"))
        if freed >= 2 and "pens_reward" not in self.flags:
            self.say("(The Mayor will want to hear about this.)", "info")
        self.save()
        self.render()

    # ── Shops ──

    def price(self, base, mob):
        haggled = self.talk and self.talk.get("haggled")
        return max(1, int(base * (0.75 if haggled else 1.0) *
                          (1.25 if self.p["cls"] == "Steel Ranger"
                           else 1)))

    def shop_menu(self, mob):
        p = self.p
        items = []
        for kind, what in SHOP_STOCK[mob.shop]:
            if kind == "weapon":
                cost = WEAPONS[what].cost
                if what in p["weapons"]:
                    continue
                label = "%s (%s)" % (what, "fine" if self.in_class(what)
                                     else "not your class's")
            elif kind == "armor":
                cost = ARMOR[what][1]
                if what in p["armors"]:
                    continue
                label = "%s, soaks %d" % (what, ARMOR[what][0])
            elif kind == "shield":
                cost = SHIELDS[what][1]
                if p["shield"]:
                    continue
                label = "%s, stops %d big blow%s" % (
                    what, SHIELDS[what][0], "" if SHIELDS[what][0] == 1
                    else "s")
            elif kind == "usage":
                cost = USAGE_ITEMS[what][1]
                label = "%s (d%d to d12)" % (USAGE_ITEMS[what][0],
                                             p["usage"].get(what, 0))
            elif kind == "count":
                cost = COUNT_COST[what]
                label = COUNTED[what]
            else:
                cost = LIZARD_COST
                if p["lizard"]:
                    continue
                label = "Calamity's sky-wagon (halves every road)"
            cost = self.price(cost, mob)
            items.append(("%s: %d caps" % (label, cost),
                          lambda k=kind, w=what, c=cost: self.buy(mob, k, w,
                                                                  c)))
        if not self.talk.get("haggled") and not self.talk.get("haggle_try"):
            items.append(("Haggle (Charisma)", lambda: self.haggle(mob)))
        items.append(("Nothing more", self.talk_menu))
        self.open_menu("%s's goods (you have %d caps)" % (mob.name,
                                                          p["coins"]),
                       items, cancel=self.talk_menu)

    def haggle(self, mob):
        p = self.p
        self.talk["haggle_try"] = True
        if p["cls"] == "Scamp" and not self.used_today("bossy"):
            self.use_today("bossy")
            ok = True
            self.say("You stamp a hoof and boss %s about until they give "
                     "in." % mob.name, "you")
        else:
            ok, _ = self.test("CHA", -1 if p["cls"] == "Steel Ranger" else 0,
                              label="Charisma, haggling")
        if ok:
            self.talk["haggled"] = True
            self.npc_say(mob, "Fine, fine. A quarter off. Robber.")
        else:
            self.npc_say(mob, "Ha! The price is the price.")
        self.shop_menu(mob)

    def buy(self, mob, kind, what, cost):
        p = self.p
        if p["coins"] < cost:
            self.npc_say(mob, "Come back with more caps.")
            self.shop_menu(mob)
            return
        p["coins"] -= cost
        self.sound.play("gold")
        if kind == "weapon":
            p["weapons"].append(what)
            if WEAPONS[what].ranged and not p["ranged"]:
                p["ranged"] = what
            self.say("You buy %s. (Wield it with U.)" % WEAPONS[what].desc,
                     "gold")
            if WEAPONS[what].ammo and not p["usage"].get(
                    WEAPONS[what].ammo):
                p["usage"][WEAPONS[what].ammo] = 6
                self.say("(%s throws in some %s.)" % (
                    mob.name, WEAPONS[what].ammo), "gold")
        elif kind == "armor":
            p["armors"].append(what)
            self.say("You buy %s. (Wear it with U.)" % what, "gold")
        elif kind == "shield":
            p["shield"], p["shield_hits"] = what, SHIELDS[what][0]
            self.say("You buy a %s and sling it on your arm." % what, "gold")
        elif kind == "usage":
            p["usage"][what] = 12
            self.say("You buy %s. (d12)" % USAGE_ITEMS[what][0], "gold")
        elif kind == "count":
            p["count"][what] = p["count"].get(what, 0) + 1
            self.say("You buy %s." % COUNTED[what], "gold")
        else:
            p["lizard"] = True
            self.npc_say(mob, "Pleasure doin' business. The Sky Bandit's "
                              "at yer service: every road's half as long "
                              "now.")
        self.shop_menu(mob)

    def healer(self, mob):
        p = self.p
        lost = p["maxhp"] - p["hp"]
        rads = p.get("rads", 0)
        cracked = [t for t in p["temp"] if t[2] > self.turn]
        if not lost and not p["poison"] and not cracked and not rads:
            self.npc_say(mob, "You're as well as you'll ever be. Shoo.")
            self.talk_menu()
            return
        cost = min(p["coins"], 2 + lost // 2 + rads)
        p["coins"] -= cost
        p["rads"] = 0
        p["hp"] = p["maxhp"]
        p["poison"] = 0
        p["temp"] = []
        p["until"]["fathead"] = -1
        self.pass_time(60, quiet=True)
        self.sound.play("potion")
        self.npc_say(mob, "There. Splinted, salved, sewn%s. %s" % (
            " and purged" if rads else "",
            "That's %d caps." % cost if cost else "Pay me when you can."))
        self.talk_menu()

    def sleep_inn(self, mob):
        p = self.p
        if p["coins"] < 3:
            self.npc_say(mob, "Three caps a bed. Come back richer.")
            self.talk_menu()
            return
        p["coins"] -= 3
        self.end_talk()
        self.say("You sleep in a real bed, under a real roof.", "info")
        self.pass_time(8 * 60, quiet=True)
        if self.overlay:
            return
        hd = CLASSES[p["cls"]]["hd"]
        self.heal(roll("1d%d" % hd) + roll("1d%d" % hd),
                  "You wake rested")
        p["until"]["fathead"] = -1
        self.say("It's %s." % self.date_text(), "info")
        self.save()

    # ── Journal, hero, the end ──

    def journal(self):
        if self.busy or self.talk:
            return
        if self.overlay == "journal":
            self.close_overlay()
            return
        p = self.p
