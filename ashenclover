# ── Landmarks ────────────────────────────────────────────────────────────────
#
# Each is painted once on a canvas several squares wide, standing on the
# ground it belongs on, ruined, and cut into squares named lm_<name>_<i>_<j>.
# The squares are scenery (walk into one to look at it) except those listed
# as walkable.

class Pic:
    """A canvas of w x h squares, for painting a landmark."""

    def __init__(self, w, h, ground):
        self.W, self.H = w * 16, h * 16
        base = draw_terrain(ground)
        self.g = [[base[y % 16][x % 16] for x in range(self.W)]
                  for y in range(self.H)]

    def px(self, x, y, c):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < self.W and 0 <= y < self.H:
            self.g[y][x] = c

    def rect(self, x0, y0, x1, y1, c):
        for y in range(max(0, int(y0)), min(self.H, int(y1) + 1)):
            row = self.g[y]
            for x in range(max(0, int(x0)), min(self.W, int(x1) + 1)):
                row[x] = c

    def poly(self, pts, c):
        poly_fill(self.g, pts, c)

    def ellipse(self, cx, cy, rx, ry, c, top=False):
        """Filled; the top half only if top."""
        for y in range(max(0, int(cy - ry)), min(self.H, int(cy + ry) + 1)):
            if top and y > cy:
                continue
            for x in range(max(0, int(cx - rx)), min(self.W, int(cx + rx) + 1)):
                if ((x + 0.5 - cx) / rx) ** 2 + ((y + 0.5 - cy) / ry) ** 2 \
                        <= 1:
                    self.g[y][x] = c

    def disc(self, cx, cy, r, c):
        self.ellipse(cx, cy, r, r, c)

    def line(self, x0, y0, x1, y1, c, w=1):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        for k in range(n + 1):
            t = k / n
            x, y = x0 + (x1 - x0) * t, y0 + (y1 - y0) * t
            for dx in range(w):
                for dy in range(w):
                    self.px(x + dx - w // 2, y + dy - w // 2, c)

    def arch(self, x0, y0, x1, y1, c):
        """A round-headed opening, from x0 to x1, its top at y0."""
        r = (x1 - x0 + 1) / 2.0
        self.rect(x0, y0 + r, x1, y1, c)
        self.ellipse(x0 + r - 0.5, y0 + r, r, r, c, top=True)

    def pointed(self, x0, y0, x1, y1, c):
        """A Gothic opening, pointed at the top."""
        w = x1 - x0 + 1
        self.rect(x0, y0 + w, x1, y1, c)
        self.poly([(x0, y0 + w + 0.5), (x1 + 1, y0 + w + 0.5),
                   ((x0 + x1 + 1) / 2.0, y0)], c)

    def onion(self, cx, base, r, c, stripe=None):
        """An onion dome on a drum, its widest part r."""
        for y in range(int(base - 2.4 * r), int(base) + 1):
            t = (base - y) / (2.4 * r)
            w = r * math.sin(math.pi * min(1, t * 1.25)) * (1 - t * 0.25) \
                if t < 0.8 else r * 0.25 * (1 - t) / 0.2
            for x in range(int(cx - w), int(cx + w) + 1):
                cc = c
                if stripe and int((x - cx) + (y * 0.6)) % 4 < 2:
                    cc = stripe
                self.px(x, y, cc)
        self.line(cx, base - 2.4 * r - 3, cx, base - 2.4 * r, "#d8b040")

    def tiles(self):
        return {(i, j): [row[i * 16:(i + 1) * 16]
                         for row in self.g[j * 16:(j + 1) * 16]]
                for i in range(self.W // 16) for j in range(self.H // 16)}



def lm_empire(p):
    lime, dark, win = "#c0b8a8", "#8a8478", "#4a5060"
    for x0, x1, y0 in ((2, 45, 92), (6, 41, 50), (10, 37, 30), (15, 32, 18)):
        p.rect(x0, y0, x1, 111, lime)
        p.rect(x0, y0, x1, y0, "#e0d8c8")
        for x in range(x0 + 2, x1 - 1, 3):
            p.rect(x, y0 + 2, x, 111, dark)
            for y in range(y0 + 3, 111, 4):
                p.px(x + 1, y, win)
    p.rect(20, 6, 27, 18, lime)
    p.rect(21, 8, 26, 8, dark)
    p.rect(23, 0, 24, 6, "#9a9aa0")
    p.px(23, 0, "#ff3030")


def lm_chrysler(p):
    steel, body, win = "#dfe4e8", "#c8c4b8", "#3a4050"
    p.rect(8, 44, 39, 111, body)
    for x in range(10, 38, 3):
        p.rect(x, 46, x, 111, "#a09c90")
    for y in range(48, 111, 5):
        p.rect(10, y, 37, y, win)
    for k in range(5):
        r = 15 - 3 * k
        cy = 44 - 6 * k
        p.ellipse(23.5, cy, r, r * 0.9, steel, top=True)
        for a in range(5):
            ang = math.pi * (a + 0.5) / 5
            p.poly([(23.5 - r * 0.8 * math.cos(ang), cy - r * 0.7 *
                     math.sin(ang) + 1),
                    (23.5 - r * 0.6 * math.cos(ang) + 1, cy - r * 0.7 *
                     math.sin(ang) + 1),
                    (23.5 - r * 0.7 * math.cos(ang), cy - r * 0.85 *
                     math.sin(ang))], "#3a4050")
    p.rect(23, 0, 24, 18, steel)


def lm_brooklyn(p):
    granite, cable = "#a89a80", "#d8d8d0"
    for tx in (10, 82):
        p.rect(tx, 2, tx + 15, 50, granite)
        p.rect(tx, 2, tx + 15, 4, "#c4b89c")
        for ax in (tx + 2, tx + 9):
            p.pointed(ax, 14, ax + 4, 40, "#4a4440")
    for xa, xb in ((0, 10), (25, 82), (97, 111)):
        for x in range(xa, xb + 1):
            t = (x - xa) / float(max(1, xb - xa))
            if xa == 0:
                y = 48 - 44 * t * t
            elif xb == 111:
                y = 4 + 44 * t * t
            else:
                y = 4 + 40 * (1 - (2 * t - 1) ** 2)
            p.px(x, y, cable)
            p.px(x, y + 1, cable)
            if x % 4 == 0:
