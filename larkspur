    def ask_maid(self, done, title="The new maid"):
        """Maid creation: a name, and everything else rolled on the tables;
        None if cancelled."""
        root = self.root
        if not self.open_dialog():
            return
        dlg = self.dialog = tk.Toplevel(root, bg=PANEL, padx=18, pady=14)
        dlg.title(title)
        dlg.transient(root)
        dlg.resizable(False, False)
        rng = random.Random()
        state = {"rolled": roll_maid(rng)}
        state["rolled"]["devil"] = rng.random() < 0.5
        tk.Label(dlg, text="Who's the new maid?", bg=PANEL, fg=ACCENT,
                 font=F("Helvetica", 16, "bold")).pack(anchor="w")
        row = tk.Frame(dlg, bg=PANEL)
        row.pack(fill="x", pady=(10, 4))
        tk.Label(row, text="Name:", bg=PANEL, fg=INK,
                 font=F("Helvetica", 13)).pack(side="left")
        name = tk.Entry(row, bg=LOG_BG, fg=INK, insertbackground=INK,
                        font=F(*MONO), width=20, highlightthickness=0)
        name.insert(0, rng.choice(MAID_FIRST))
        name.pack(side="left", padx=8)
        sheet = tk.Label(dlg, bg=PANEL, fg=INK, justify="left", font=F(*MONO),
                         wraplength=S(560))
        sheet.pack(fill="x", anchor="w", pady=(8, 0))

        def current():
            return {"name": " ".join(name.get().split())[:24] or "Maid",
                    "rolled": state["rolled"]}

        def show():
            p = self.make_maid(current())
            lines = ["Maid Types: %s / %s" % tuple(p["types"]),
                     "  ".join("%s %d" % (a, p["attrs"][a])
                               for a in ATTRS[:3]),
                     "  ".join("%s %d" % (a, p["attrs"][a])
                               for a in ATTRS[3:]),
                     "Spirit %d   Favor %d" % (p["attrs"]["Will"] * 10,
                                               p["favor"]), "",
                     "Uniform %s, eyes %s, hair %s" % (
                         p["uniform"].lower(), p["eyes"].lower(),
                         p["hair"].lower()), ""]
            for q, text in p["quals"]:
                lines += wrap("%s: %s" % (q, text.replace("%s",
                                                          "another maid")),
                              70)
            lines += [""] + wrap("Roots: %s. %s" % ROOTS[p["roots"]], 70)
            lines += wrap("Stress Explosion: %s. %s" % EXPLOSIONS[
                p["boom"]][:2], 70)
            for pid in p["powers"]:
                lines += wrap("Maid Power: %s. %s" % POWER_NAMES[pid], 70)
            lines.append("Maid Weapon: %s" % p["weapon"])
            sheet.config(text="\n".join(lines))

        def reroll():
            state["rolled"] = roll_maid(rng)
            state["rolled"]["devil"] = rng.random() < 0.5
            show()

        def requal():
            q = []
            for _ in range(2):
                q.append(list(roll_quality(rng, [x[0] for x in q])))
            state["rolled"]["quals"] = q
            show()

        def rename():
            name.delete(0, "end")
            name.insert(0, rng.choice(MAID_FIRST))

        def begin(_=None):
            who = current()
            self.close_dialog(dlg)
            done(who)

        def cancel(_=None):
            self.close_dialog(dlg)
            done(None)
        show()
        bar = tk.Frame(dlg, bg=PANEL)
        bar.pack(fill="x", pady=(12, 0))
        tk.Button(bar, text="Start work", command=begin, width=10,
                  highlightbackground=PANEL).pack(side="right")
        tk.Button(bar, text="Cancel", command=cancel, width=8,
                  highlightbackground=PANEL).pack(side="right", padx=6)
        tk.Button(bar, text="Roll again", command=reroll, width=10,
                  highlightbackground=PANEL).pack(side="left")
        tk.Button(bar, text="New Qualities", command=requal, width=12,
                  highlightbackground=PANEL).pack(side="left", padx=6)
        tk.Button(bar, text="Another name", command=rename, width=12,
                  highlightbackground=PANEL).pack(side="left")
        dlg.bind("<Return>", begin)
        dlg.bind("<Escape>", cancel)
        dlg.protocol("WM_DELETE_WINDOW", cancel)
        name.focus_set()
        name.select_range(0, "end")
        self.fit_dialog(dlg)
        dlg.geometry("+%d+%d" % (
            root.winfo_rootx() + max(0, (root.winfo_width() -
                                         dlg.winfo_reqwidth()) // 2),
            root.winfo_rooty() + max(0, min(40, (root.winfo_height() - dlg.winfo_reqheight()) // 2))))
        self.grab(dlg)

    @staticmethod
