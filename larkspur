def roll_quality(rng=random, taken=()):
    """A Special Quality: (name, text), rolled on the tables."""
    while True:
        q = QUALITIES[d66(rng)]
        if q is None:
            continue
        if isinstance(q, str):
            q = SUB_QUALITIES[q][rng.randint(0, 5)]
            if q is None:
                continue
        if q[0] not in taken:
            return q


