def phantom_tells(world, rng):
    """What each night leaves behind: (text, who it fits) for the
    culprit, in the order they'll be found."""
    ph = world["phantom"]
    w = world
    looks = {r: w["looks"][r] for r in SUSPECTS}
    hair = looks[ph]["hair"].lower()
    common = [("a long %s hair, caught on the latch" % hair,
               [r for r in SUSPECTS if looks[r]["hair"].lower() == hair])]
    if ph in MAIDS:
        m = w["maids"][ph]
        tells = [("a thread of %s cloth, snagged on a nail: the colour of "
                  "a maid's uniform" % m["uniform"].lower(),
                  [r for r in MAIDS if w["maids"][r]["uniform"] ==
                   m["uniform"]]),
                 ("a lingering smell of %s" % m["scent"],
                  [r for r in MAIDS if w["maids"][r]["scent"] ==
                   m["scent"]]),
                 ("a sweet wrapper: %s" % m["snack"],
                  [r for r in MAIDS if w["maids"][r]["snack"] ==
                   m["snack"]]),
                 ("small footprints, in a maid's shoes", list(MAIDS))]
    elif ph == "cousin":
        tells = [("a whiff of expensive cologne", ["cousin"]),
                 ("a gold cufflink, engraved %s" % w["people"]["cousin"][
                     "first"][0], ["cousin"]),
                 ("riding-boot prints on the carpet", ["cousin"]),
                 ("a London estate agent's card, with a pencilled "
                  "valuation of the house", ["cousin"])]
    elif ph == "tutor":
        tells = [("chalk dust on the sill", ["tutor"]),
                 ("a page in tiny, neat handwriting: 'CHAPTER SEVEN. The "
                  "Phantom strikes again...'", ["tutor"]),
                 ("an inky fingerprint", ["tutor"]),
                 ("a chewed pencil stub", ["tutor"])]
    else:
        tells = [("a faint smell of silver polish", ["butler"]),
                 ("white cotton fibres, from a butler's gloves",
                  ["butler"]),
                 ("everything put back very neatly. Even the thief "
                  "tidied up", ["butler"]),
                 ("the winding key of the hall clock", ["butler"])]
    rng.shuffle(tells)
    return tells + common


