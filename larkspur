def make_people(rng):
    people = {}
    used = set()
    for role, (tile, sex, honorific, title) in ROLES.items():
        sex = sex or rng.choice("MF")
        name = None
        while not name or name in used or name.split()[-1] in {
                n.split()[-1] for n in used if " " in n}:
            if role in MAIDS:
                name = rng.choice(MAID_FIRST)
            else:
                name = person_name(rng, sex)
        used.add(name)
        first = name.split()[0]
        last = name.split()[-1]
        full = ("%s %s" % (honorific, name)) if honorific else name
        short = ("%s %s" % (honorific, last)) if honorific else first
        people[role] = {"first": first, "sex": sex, "tile": tile,
                        "name": full, "short": short, "title": title,
                        "hon": honorific}
    return people


def make_person(world, role, x, y):
    who = world["people"][role]
    m = Mob(who["tile"], who["name"], x, y)
    m.role = role
    m.title = fill(who["title"], world)
    m.shop = SHOPS.get(role)
    m.talk, m.greet = role_talk(world, role)
    return m


def pronouns(sex, key):
    m = sex == "M"
    return {"he": "he" if m else "she", "He": "He" if m else "She",
            "his": "his" if m else "her", "him": "him" if m else "her",
            "His": "His" if m else "Her"}[key]


def fill(text, world):
    p = world["people"]
    names = {r: v["short"] for r, v in p.items()}
    names.update({r + "_full": v["name"] for r, v in p.items()})
    names.update({r + "_first": v["first"] for r, v in p.items()})
    for r, v in p.items():
        for k in ("he", "He", "his", "him", "His"):
            names["%s_%s" % (r, k)] = pronouns(v["sex"], k)
        names[r + "_title"] = v["title"]
    ph = p[world["phantom"]]
    for k in ("he", "He", "his", "him", "His"):
        names["phantom_" + k] = pronouns(ph["sex"], k)
    m = world["master"]
    names.update(phantom=ph["short"], phantom_full=ph["name"],
                 master_age=m["age"], sir=world["sir"],
                 master_type=MASTER_TYPES[m["type"]][0].lower(),
                 flavour=world["flavour"], fav_type=m["favourite"])
    names["Flavour"] = cap(world["flavour"])
    names["wish"] = WISHES[world["wish"]][1].format(**names)
    for r in MAIDS:
        names[r + "_colour"] = world["maids"][r]["uniform"].lower()
    return text.format(**names)


