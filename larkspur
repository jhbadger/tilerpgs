class Area:
    """A map: the grounds and the house, a room, or a level below."""

    def __init__(self, kind, key, grid, name, edge=None, dark=False):
        self.kind, self.key, self.grid, self.name = kind, key, grid, name
        self.h, self.w = len(grid), len(grid[0])
        self.edge = edge
        self.dark = dark
        self.mobs = []
        self.items = {}         # (x, y) -> thing lying there
        self.bodies = {}        # (x, y) -> what's in a chest
        self.links = {}         # (x, y) -> ("bld", site) or ("lead", lead)
        self.labels = {}        # (x, y) -> what it is
        self.hidden = {}        # (x, y) -> found by searching
        self.loot = set()       # crates not yet opened
        self.traps = set()
        self.skin = {}
        self.seen = bytearray(self.w * self.h)
        self.opaque = OPAQUE[kind]
        self.start = (0, 0)
        self.down = None
        self.site = None
        self.lead = None
        self.seat = None
        self.lit = set()

    def inside(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h

    def mob_at(self, x, y):
        for m in self.mobs:
            if m.x == x and m.y == y:
                return m
        return None


class Mob:
    def __init__(self, tile, name, x, y):
        self.tile, self.name, self.x, self.y = tile, name, x, y
        self.kind = None
        self.hostile = False
        self.stress = 0
        self.boss = False
        self.flee = 0
        self.aware = False
        self.stuck = 0          # trapped, restrained
        self.title = name
        self.role = None
        self.talk, self.greet = {}, ""
        self.known = False
        self.shop = None
        self.roam = None
        self.home = None
        self.errand = None      # the errand this person gives
        self.ally = False       # someone who came with you
        self.visitor = False    # ...and isn't from round here
        self.way = None         # how you're taking this one on
        self.event = None       # the Random Event it belongs to
        self.night_owl = False


def make_monster(kind, x, y, boss=False, rng=random):
    m = MONSTERS[kind]
    mob = Mob(m.tile, m.name, x, y)
    mob.kind = kind
    mob.hostile = True
    mob.boss = boss or "boss" in m.traits
    if mob.boss and kind == "goose":
        mob.name = "the Goose King"
    return mob


def role_talk(world, role):
    if role in MAIDS:
        greet, talk = "Hello.", dict(MAID_TALK)
    else:
        greet, talk = ROLE_TALK.get(role, ("...", {}))
        talk = dict(talk)
    n = world["witness"].get(role)
    if n is not None:
        text, _ = world["tells"][n]
        talk["news"] = "I saw something, the other night, by the Phantom's " \
            "card. %s. Make of it what you like." % cap(text)
    return talk, greet


def blank(w, h, tile):
    return [[tile] * w for _ in range(h)]


def make_dungeon(world, lid, level, flags):
    """One level below or beyond: rooms and passages, its troublemakers and
    its things, the same each time it is made (but for what's been done)."""
    info = LEADS[lid]
    rng = random.Random("%s:%s:%d" % (world["seed"], lid, level))
    W, H = (36, 26) if lid != "maze" else (31, 25)
    last = level == info.levels
    if lid == "maze":
        g, rooms, centers = maze_grid(W, H, rng)
        end = rooms[-1]
        openings = None
    else:
        for attempt in range(80):
            g = blank(W, H, "dwall")
            rooms = []
            want = rng.randint(6, 8)
            for _ in range(400):
                if len(rooms) >= want:
                    break
                w, h = rng.randint(4, 8), rng.randint(3, 6)
                if last and info.boss and len(rooms) == want - 1:
                    w, h = 8, 5
                x, y = rng.randint(1, W - w - 1), rng.randint(1, H - h - 1)
                if any(x <= r[2] + 2 and r[0] <= x + w + 1 and
                       y <= r[3] + 2 and r[1] <= y + h + 1 for r in rooms):
                    continue
                rooms.append((x, y, x + w - 1, y + h - 1))
            if len(rooms) < 5:
                continue
            rooms.sort(key=lambda r: r[0] + r[2] + rng.random())
            centers = [((r[0] + r[2]) // 2, (r[1] + r[3]) // 2)
                       for r in rooms]

            def carve(a, b):
                (ax, ay), (bx, by) = a, b
                if rng.random() < 0.5:
                    pts = [(x, ay) for x in range(min(ax, bx),
                                                  max(ax, bx) + 1)]
                    pts += [(bx, y) for y in range(min(ay, by),
                                                   max(ay, by) + 1)]
                else:
                    pts = [(ax, y) for y in range(min(ay, by),
                                                  max(ay, by) + 1)]
                    pts += [(x, by) for x in range(min(ax, bx),
                                                   max(ax, bx) + 1)]
                for x, y in pts:
                    g[y][x] = "dfloor"
            for r in rooms:
                for y in range(r[1], r[3] + 1):
                    for x in range(r[0], r[2] + 1):
                        g[y][x] = "dfloor"
            for a, b in zip(centers, centers[1:]):
                carve(a, b)
            for _ in range(2):
                i, j = sorted(rng.sample(range(len(rooms) - 1), 2))
                carve(centers[i], centers[j])
            end = rooms[-1]
            ring = [(x, y) for x in range(end[0] - 1, end[2] + 2)
                    for y in range(end[1] - 1, end[3] + 2)
                    if not (end[0] <= x <= end[2] and end[1] <= y <= end[3])]
            openings = [(x, y) for x, y in ring if g[y][x] != "dwall"]
            if last and len(openings) != 1:
                continue
            break
    theme = THEMES[lid][level]
    name = LEVEL_NAMES[(lid, level)]
    area = Area("dungeon", ("dun", lid, level), g, "%s: %s" % (
        cap(info.name), name), dark=info.dark)
    area.skin = {"dwall": "dwall_" + theme, "dfloor": "dfloor_" + theme}
    area.lead = lid
    sx, sy = centers[0]
    g[sy][sx] = "stairs_up"
    area.start = (sx, sy)
    ex, ey = centers[-1]
    floor_spots = [(x, y) for y in range(H) for x in range(W)
                   if g[y][x] == "dfloor"]
    end_cells = {(x, y) for x in range(end[0], end[2] + 1)
                 for y in range(end[1], end[3] + 1)}

    def free(n, far=6, within=None):
        spots = [p for p in (within or floor_spots)
                 if g[p[1]][p[0]] == "dfloor" and p not in area.items
                 and abs(p[0] - sx) + abs(p[1] - sy) >= far
                 and not area.mob_at(*p) and p not in area.bodies]
        return rng.sample(spots, min(n, len(spots)))

    if not last:
        g[ey][ex] = "stairs_down"
        area.down = (ex, ey)
    if last and info.boss and "beat:%s" % lid not in flags:
        area.mobs.append(make_monster(info.boss, ex, ey, boss=True))
    inner = [(x, y) for r in rooms[1:-1] for x in range(r[0] + 1, r[2])
             for y in range(r[1] + 1, r[3])]
    if info.hazard:
        for x, y in free(rng.randint(3, 7), 3, inner):
            g[y][x] = info.hazard
    for n in range(rng.randint(2, 3)):          # trunks and crates
        x, y = rng.choice(inner or floor_spots)
        if g[y][x] != "dfloor" or (x, y) == (ex, ey) or (x, y) in end_cells:
            continue
        if "loot:%s:%d:%d:%d" % (lid, level, x, y) in flags:
            g[y][x] = "crate_open"
        else:
            g[y][x] = "crate"
            area.loot.add((x, y))
    lore = LORE.get((lid, level))
    if lore:
        for x, y in free(1, 5):
            area.items[(x, y)] = "clue"
            area.note = lore
    special = []
    if [lid, level] == world["stash"]:
        things = [t for t in STOLEN if "taken:" + t in flags and
                  "back:" + t not in flags]
        if "stash_clue" not in flags:
            things.append("monogram")
        if things:
            special.append(("chest", things))
    if (lid, level) == ("attic", 2) and "got:music box" not in flags:
        special.append(("chest", ["music box"]))
    if (lid, level) == ("attic", 1) and world["ribbon_maid"] and \
            "got:ribbon" not in flags:
        special.append(("chest", ["ribbon"]))
    if (lid, level) == ("maze", 1) and "has_map" in flags and \
            "got:old coins" not in flags:
        special.append(("chest", ["old coins"]))
    if (lid, level) == ("cellar", 2) and "ghost_locket" in flags and \
            "got:locket" not in flags:
        special.append(("chest", ["locket"]))
    for kind, things in special:
        far_spots = [p for p in floor_spots if p not in end_cells] \
            if lid != "maze" else list(end_cells)
        for x, y in free(1, 8, far_spots):
            area.items[(x, y)] = kind
            area.bodies[(x, y)] = {"who": None, "things": things}
    for x, y in free(rng.randint(1, 2), 4):     # found by searching
        area.hidden[(x, y)] = rng.choice(("coins", "coins", "photo"))
    n = 2 + level + (1 if lid == "maze" else 0)
    for x, y in free(n, 7):
        if (x, y) in end_cells and last:
            continue
        kinds = info.monsters
        kind = kinds[min(len(kinds) - 1, rng.randrange(1 + level))] \
            if rng.random() < 0.7 else rng.choice(kinds)
        area.mobs.append(make_monster(kind, x, y, rng=rng))
    return area


def maze_grid(W, H, rng):
    """A hedge maze: passages two squares apart, a clearing in the
    middle, the way in at the bottom."""
    g = blank(W, H, "dwall")
    cx, cy = W // 2, H // 2
    seen = set()
    start = (1, 1)
    stack = [start]
    seen.add(start)
    g[1][1] = "dfloor"
    while stack:
        x, y = stack[-1]
        nxt = [(x + dx, y + dy) for dx, dy in ((2, 0), (-2, 0), (0, 2),
                                               (0, -2))
               if 1 <= x + dx < W - 1 and 1 <= y + dy < H - 1 and
               (x + dx, y + dy) not in seen]
        if not nxt:
            stack.pop()
            continue
        nx, ny = rng.choice(nxt)
        g[(y + ny) // 2][(x + nx) // 2] = "dfloor"
        g[ny][nx] = "dfloor"
        seen.add((nx, ny))
        stack.append((nx, ny))
    for _ in range(W):                          # a few more ways round
        x, y = rng.randrange(2, W - 2), rng.randrange(2, H - 2)
        if (x + y) % 2 and g[y][x] == "dwall":
            g[y][x] = "dfloor"
    end = (cx - 2, cy - 2, cx + 2, cy + 2)
    for y in range(end[1], end[3] + 1):
        for x in range(end[0], end[2] + 1):
            g[y][x] = "dfloor"
    sx, sy = cx - (cx % 2 == 0), H - 2
    if g[sy][sx] != "dfloor":
        sx = next(x for x in range(1, W - 1) if g[sy][x] == "dfloor")
    first = (sx, sy, sx, sy)
    return g, [first, end], [(sx, sy), (cx, cy)]


