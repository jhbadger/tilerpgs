# Things on the floor: their tile, and what stepping on them gives.
FLOOR_ITEMS = {"card", "clue", "chest", "coins", "parcel", "egg", "saucer",
               "dustpile"}

def grass(rng, base="#5a9a4a"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.12), shade(base, 0.88), "#6aaa52"], 0.4)
    for _ in range(5):
        x, y = rng.randrange(16), rng.randrange(1, 16)
        g[y][x] = g[y - 1][x] = shade(base, 1.25)
    return g


def boarding(rng, base="#9a6a3a", seam="#6a4420", width=4):
    """Floorboards, running across."""
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.07), shade(base, 0.93)], 0.3)
    for y in range(0, 16, width):
        rect(g, 0, y, 15, y, seam)
        x = rng.randrange(16)
        rect(g, x, y + 1, x, y + width - 1, seam)
    return g


def bricks(rng, base="#8a4a3a", mortar="#4a2a20"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.1), shade(base, 0.88)], 0.3)
    for y in range(0, 16, 4):
        rect(g, 0, y, 15, y, mortar)
        off = 0 if y % 8 == 0 else 4
        for x in range(off, 16, 8):
            rect(g, x, y, x, y + 3, mortar)
    return g


def flags(rng, base="#8a8478", seam="#5a564e"):
    """Flagstones."""
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.08), shade(base, 0.92)], 0.35)
    for y in (0, 7):
        rect(g, 0, y, 15, y, seam)
    for x, y0, y1 in ((5, 0, 7), (11, 7, 15), (0, 0, 15)):
        rect(g, x, y0, x, y1, seam)
    return g


def papered(rng, base, stripe, dado="#5a3a2a"):
    """A papered wall, striped, with a wooden dado below."""
    g = grid_of(base)
    for x in range(0, 16, 4):
        rect(g, x, 0, x, 10, stripe)
    rect(g, 0, 11, 15, 15, dado)
    rect(g, 0, 11, 15, 11, shade(dado, 1.4))
    speckle(g, rng, [shade(base, 0.96)], 0.05)
    return g


def draw_terrain(name, frame=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random(name + str(frame))
    # ── the grounds ──
    if name == "lawn":
        return grass(rng)
    if name == "flowers":
        g = grass(rng)
        for _ in range(7):
            x, y = rng.randrange(1, 15), rng.randrange(1, 15)
            c = rng.choice(("#f05a8a", "#f0e040", "#ffffff", "#c060e0",
                            "#f08a2a"))
            g[y][x] = c
            g[y - 1][x] = g[y + 1][x] = g[y][x - 1] = g[y][x + 1] = \
                shade(c, 0.85)
