    def wait_until(self):
        if not self.ready():
            return
        nxt = sorted(t0 for _, t0, _, _ in self.CHORES.values()
                     if t0 > self.clock())
        items = [("Wait a quarter of an hour", lambda: self.wait_for(15)),
                 ("Wait an hour", lambda: self.wait_for(60))]
        if nxt:
            items.append(("Wait until %02d:%02d (the next chore)" % (
                nxt[0] // 60, nxt[0] % 60),
                lambda: self.wait_for(nxt[0] - self.clock())))
        items.append(("Never mind", lambda: None))
        self.open_menu("Wait", items)

    def wait_for(self, minutes):
        if any(m.hostile and abs(m.x - self.pos[0]) + abs(
                m.y - self.pos[1]) <= 5 for m in self.area.mobs):
            self.say("Not with that about.", "bad")
            return
        self.pass_time(minutes)
        if self.overlay:
            return
        self.refresh_people()
        self.say("It's %s." % self.date_text(), "info")
        self.render()

