def selftest():
    """Build every map and tune of a few households, without a window."""
    for seed in range(8):
        w = generate_world(seed)
        flags = set()
        city = make_city(w, flags)
        doors = [p for p, l in city.links.items() if l[0] == "bld"]
        assert len(doors) == len(SITES), doors
        seen, q = {city.start}, deque([city.start])
        while q:
            x, y = q.popleft()
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if city.inside(*n) and n not in seen and \
                        city.grid[n[1]][n[0]] in WALKABLE:
                    seen.add(n)
                    if city.grid[n[1]][n[0]] in CITY_GROUND:
                        q.append(n)
        for pos, l in city.links.items():
            assert pos in seen, ("unreachable", l, pos)
        for sid in SITES:
            a = make_interior(w, sid, flags)
            assert all(len(r) == a.w for r in a.grid), sid
            assert a.grid[a.start[1]][a.start[0]] in INSIDE_FLOOR, sid
            for m in a.mobs:
                assert a.grid[m.y][m.x] in INSIDE_FLOOR, (sid, m.role)
                fill(m.greet, w)
                for v in m.talk.values():
                    for s in ([v] if isinstance(v, str) else
                              [x for x in v.values()
                               if isinstance(x, str)]):
                        fill(s, w)
        for lid, info in LEADS.items():
            for level in range(1, info.levels + 1):
                for fl in (set(), {"has_map", "ghost_locket"} |
                           {"taken:" + t for t in STOLEN}):
                    a = make_dungeon(w, lid, level, fl)
                    assert a.grid[a.start[1]][a.start[0]] == "stairs_up"
                    seen, q = {a.start}, deque([a.start])
                    while q:
                        x, y = q.popleft()
                        for dx, dy in DIRS:
                            n = (x + dx, y + dy)
                            if n not in seen and a.grid[n[1]][n[0]] in (
                                    DUNGEON_FLOOR | {"gate", "crate"}):
                                seen.add(n)
                                q.append(n)
                    if a.down:
                        assert a.down in seen, (lid, level)
                    for pos in a.bodies:
                        assert pos in seen, (lid, level, "chest")
                    for m in a.mobs:
                        if m.boss:
                            assert (m.x, m.y) in seen, (lid, level, "boss")
        stash = make_dungeon(w, *w["stash"], {"taken:spoons"})
        assert any("spoons" in b["things"] for b in stash.bodies.values())
        for text in list(RUMOURS.values()) + list(TOPICS.values()) + \
                [e["ask"] for e in w["errands"]] + \
                [e["thanks"] for e in w["errands"]] + \
                list(CLUES.values()) + list(MOTIVES.values()) + \
                [t for _, t in WISHES.values()] + \
                [t for _, t in EVENTS.values()] + list(MAID_TALK.values()):
            fill(text, w)
        for role in ROLE_TALK:
            assert role in ROLES, role
        assert w["phantom"] in SUSPECTS
        for text, fits in w["tells"]:
            assert w["phantom"] in fits, text
    for n in range(300):
        r = roll_maid(random.Random(n))
        assert all(v >= 0 for v in r["attrs"].values())
        for pid in r["powers"]:
            assert pid in POWER_NAMES
        art_pixels(*maid_art(dict(r, devil=n % 2)))
        m = roll_master(random.Random(n))
        assert m["age"] >= 6
    for name, tune in MUSIC.items():
        steps = len(tune["melody"].replace("|", " ").split())
        assert steps == len(tune["chords"].split()) * tune["bar"], name
    tiles = all_tiles()
    clash = set(TERRAIN) & (set(PEOPLE) | set(ART))
    assert not clash, clash
    for name in list(TILE_NEEDED):
        assert name in tiles, name
    for t in (WALKABLE | set(OPAQUE["city"])) - {"dfloor"}:
        assert t in tiles, t
    for t in ROOM_TILES.values():
        assert t in tiles, t
    print("ok")


