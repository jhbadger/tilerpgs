    def rating(self):
        r = self.results
        if r["fired"]:
            return 1
        return min(5, 1 + (r["verdict"] >= 2) +
                   ("phantom_caught" in self.flags) + (r["cake"] >= 21) +
                   (r["present"] >= 12) + (r["top"] == "you"))

    def show_won(self):
        w = self.world
        p = self.p
        if not getattr(self, "results", None):
            self.results = self.party_results()
        r = self.results
        stars = self.rating()
        lines = ["HAPPY BIRTHDAY", ""]
        lines += wrap(fill("Five o'clock, in the ballroom. The whole "
                           "household, the Master in the middle, and "
                           "{master_age} candles.", w), 62) + [""]
        lines += r["lines"] + [""]
        if "phantom_caught" in self.flags:
            lines += wrap(fill("The Phantom of Larkspur, {phantom_full}, "
                               "serves the punch, and is very sorry.", w), 62)
        else:
            lines += wrap(fill("Nobody ever does find out who the Phantom "
                               "was. {phantom_full} looks very innocent "
