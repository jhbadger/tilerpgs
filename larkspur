    def vase_talk(self, mob):
        """The Head Maid, about the vase."""
        a = max(("Cunning", "Skill"), key=self.attr)
        self.say("You explain about the vase.", "info")
        if self.check(a, 8, "clearing your name" if a == "Cunning" else
