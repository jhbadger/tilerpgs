def generate_world(seed):
    """The household: who is who, where things are, who did it."""
    rng = random.Random("%s:world" % seed)
    world = {"seed": seed, "people": make_people(rng)}
    world["master"] = roll_master(rng)
    world["people"]["master"]["sex"] = rng.choice("MF")
    m = world["master"]
    world["sir"] = "sir" if world["people"]["master"]["sex"] == "M" else \
        "miss"
    world["people"]["master"]["name"] = "%s %s" % (
        "Master" if world["people"]["master"]["sex"] == "M" else "Miss",
        rng.choice(FIRST_M if world["people"]["master"]["sex"] == "M"
                   else FIRST_F))
    world["people"]["master"]["first"] = \
        world["people"]["master"]["name"].split()[1]
    world["people"]["master"]["short"] = "the Master"
    world["maids"] = {}
    used_colours, used_scents, used_snacks = set(), set(), set()
    for r in MAIDS:
        md = roll_maid(rng)
        while md["uniform"] in used_colours:
            md["uniform"] = roll_color(rng)
        used_colours.add(md["uniform"])
        md["scent"] = rng.choice([s for s in SCENTS if s not in used_scents])
        used_scents.add(md["scent"])
        md["snack"] = rng.choice([s for s in SNACKS if s not in used_snacks])
        used_snacks.add(md["snack"])
        md["devil"] = rng.random() < 0.5
        world["maids"][r] = md
        world["people"][r]["title"] = "a %s maid in %s" % (
            md["types"][0].lower(), md["uniform"].lower())
    world["looks"] = {r: {"hair": world["maids"][r]["hair"]}
                      for r in MAIDS}
    world["looks"].update(cousin={"hair": "Gold"}, tutor={"hair": "Gray"},
                          butler={"hair": "Silver"})
    world["phantom"] = rng.choice(SUSPECTS)
    world["tells"] = phantom_tells(world, rng)
    witnesses = [r for r in ("cook", "gardener", "butler", "tutor",
                             "maid1", "maid2", "maid3", "headmaid")
                 if r != world["phantom"]]
    world["witness"] = dict(zip(rng.sample(witnesses, 2), (4, 0)))
    world["stash"] = list(rng.choice(STASH_PLACES))
    world["wish"] = rng.choice(sorted(WISHES))
    world["flavour"] = rng.choice(sorted(FLAVOURS))
    events = list(AUTO_EVENTS)
    rng.shuffle(events)
    world["events"] = {d: (events[d - 1], rng.randint(9, 15))
                       for d in range(1, 6)}
    world["spare_events"] = events[5:]
    errands = [dict(e) for e in ERRANDS]
    pool = list(MAID_ERRANDS)
    rng.shuffle(pool)
    for r, e in zip(MAIDS, pool):
        e = dict(e)
        e["id"] = "maid:" + r
        e["giver"] = r
        e["pay"] = 0
        if e["kind"] == "chore":
            e["day"] = None
        errands.append(e)
    world["errands"] = errands
    world["ribbon_maid"] = next((e["giver"] for e in errands
                                 if e.get("thing") == "ribbon"), None)
    world["looks"]["master"] = {"hair": m["hair"]}
    return world


