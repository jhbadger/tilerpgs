    CAKES = ((5, "Completely inedible. Everyone is fired.", "-"),
             (10, "The cake doesn't taste very good.", "-2d6"),
             (20, "Yup. It's a cake.", "0"),
             (30, "The cake is tasty, and made with care.", "1d6"),
             (40, "The cake is delicious, and well made.", "2d6"),
             (50, "The cake is so good the Master is moved to tears.",
              "3d6"),
             (999, "The cake is just too good. The Master can't stop "
                   "crying.", "4d6"))
    PRESENT_TABLE = ((0, "comes off as some kind of prank", "-2d6"),
                     (3, "isn't to the Master's taste", "-1d6"),
                     (7, "gets a polite thank you", "0"),
                     (11, "pleases the Master", "1d6"),
                     (17, "makes the Master very happy", "2d6"),
                     (23, "overwhelms the Master with gratitude", "3d6"),
                     (29, "makes the Master throw their arms around you",
                      "4d6"),
                     (999, "leaves the Master frozen, then in tears of joy",
                      "5d6"))

    @staticmethod
    def table(rows, n):
        return next(r for r in rows if n <= r[0])

    def party_results(self):
        w = self.world
        p = self.p
        st = self.st
        res = {"lines": []}
        L = res["lines"]
        # the cake
        cake = st.get("cake")
        if cake:
            d, _ = self.die()
            total = (d + cake["bonus"]) * self.attr("Skill") if d else 0
            who = [p["name"]] + [w["people"][r]["name"]
                                 for r in cake["helpers"]]
            for r in cake["helpers"]:
                total += random.randint(1, 6) * w["maids"][r]["attrs"][
                    "Skill"]
        else:
            total = sum(random.randint(1, 6) * w["maids"][r]["attrs"][
                "Skill"] for r in MAIDS)
            who = [w["people"][r]["name"] for r in MAIDS]
        _, text, gain = self.table(self.CAKES, total)
        res["cake"] = total
        L += wrap("The cake, by %s: %d. %s" % (", ".join(who), total, text),
                  62)
        fired = gain == "-"
        res["fired"] = fired
        if gain not in ("-", "0"):
            n = roll(gain.lstrip("-"))
            if gain.startswith("-"):
                p["favor"] -= n
                for r in MAIDS:
                    st["rival"][r] -= roll(gain.lstrip("-"))
            else:
                p["favor"] += n
                for r in MAIDS:
                    st["rival"][r] += roll(gain)
        # the presents
        pr = p["present"]
        if pr:
            bonus = pr.get("bonus", 0) + (1 if pr.get("wrapped") else 0)
            wished = WISHES[w["wish"]][0] == pr["item"] or (
                w["wish"] == "music" and pr["item"] == "mended music box")
            if wished:
                bonus += 2
            if pr["item"] in ("letter", "baby dinosaur"):
                bonus += 2
            a = max(("Affection", "Skill"), key=self.attr)
            d, _ = self.die()
            mine = (d + bonus) * self.attr(a)
            _, text, gain = self.table(self.PRESENT_TABLE, mine)
            L += [""] + wrap("Your present, the %s%s: %d. It %s." % (
                pr["item"], " (just what the Master wished for!)" if wished
                else "", mine, text), 62)
        else:
            mine = 0
            gain = "-1d6"
            L += ["", "You have no present for the Master."]
        n = roll(gain.lstrip("-")) if gain != "0" else 0
        p["favor"] += -n if gain.startswith("-") else n
        best = mine
        top = "you"
        for r in MAIDS:
            md = w["maids"][r]
            t = (random.randint(1, 6) + 1) * max(md["attrs"]["Skill"],
                                                 md["attrs"]["Affection"])
            _, _, g = self.table(self.PRESENT_TABLE, t)
            if g not in ("0",):
                k = roll(g.lstrip("-"))
                st["rival"][r] += -k if g.startswith("-") else k
            if t > best:
                best, top = t, r
        if top == "you":
            p["favor"] += 10
            L += ["Yours is the best present of all. (+10 Favor)"]
        else:
            st["rival"][top] += 10
            L += ["The best present of all is %s's." % w["people"][top][
                "name"]]
        res["present"] = mine
        # the verdict
        v = st["verdict"]
        res["verdict"] = v
        L += [""] + wrap(fill("{dowager} rises. 'I have seen the house. "
                              "%s. My decision: %s'" % (
                                  cap("; ".join(st.get("verdict_notes", [])
                                                or ["I have seen enough"])),
                                  "Larkspur Hall stays as it is, with its "
                                  "household. You may all thank the Master."
                                  if v >= 2 else "Larkspur stays. On "
                                  "probation. I shall be back." if v >= 0
                                  else "Larkspur is to be sold."), w), 62)
        # the Favor race
        scores = dict(st["rival"])
        scores["you"] = p["favor"]
        res["scores"] = scores
        res["top"] = max(scores, key=scores.get)
        return res

