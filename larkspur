    def reset_view(self):
        self.overlay = None
        self.overlay_text = None
        self.end_talk()
        self.busy = False
        self.aim = None
        self.menu = None
        self.walking = None

    def restore(self, g):
        self.setup_world(int(g["seed"]))
        p = g["player"]
        for k in ("name", "attrs", "types", "quals", "powers", "items",
                  "dress", "favor", "stress"):
            if k not in p:
                raise ValueError("bad maid")
        self.p = p
        self.flags = set(g.get("flags", []))
        self.clues = list(g.get("clues", []))
        self.topics = set(g.get("topics", []))
        self.tells = list(g.get("tells", []))
        self.side = {str(k): dict(v) for k, v in g.get("side", {}).items()}
        self.st = dict(g["st"])
        if "stash_clue" in self.flags:
            self.monogram()
        self.turn = int(g.get("turn", 0))
        self.city = None
        self.reset_view()
        self.paint_people()
        city = self.get_area(("city",))
        city.seen = unpack_bits(g["seen"], CITY_W * CITY_H)
        self.city_pos = g.get("city_pos")
        self.surface = g.get("surface")
        if self.surface:
            self.surface = (tuple(self.surface[0]), self.surface[1])
        key = tuple(g["key"])
        self.area = self.get_area(key)
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        if not self.can_stand(*self.pos):
            self.pos = list(self.area.start)
        p["out"] = p["held"] = 0
        self.say("Larkspur Hall, %s." % self.date_text(), "quest")
        self.say("Back to work, %s. Press ? for help." % p["name"], "info")
        self.layout()
        if "won" in self.flags:
            self.show_won()
        elif "doom" in self.flags:
            self.doom(self.flags_doom())

    def flags_doom(self):
        return next((f[5:] for f in self.flags if f.startswith("doom:")),
                    "dismissed")

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "zoom": self.zoom_d, "text": self.text_k}
        if getattr(self, "p", None) and getattr(self, "area", None):
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "clues": self.clues,
                "topics": sorted(self.topics), "tells": self.tells,
                "side": self.side, "st": self.st,
                "turn": self.turn, "key": list(self.area.key),
                "pos": self.pos, "city_pos": self.city_pos,
                "surface": [list(self.surface[0]), self.surface[1]]
                if getattr(self, "surface", None) else None,
                "seen": pack_bits(self.get_area(("city",)).seen)}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.root.destroy()


    # ── Areas ──

    def get_area(self, key):
        if key in self.cache:
            return self.cache[key]
        w = self.world
        if key[0] == "city":
            area = make_city(w, self.flags)
            area.lit = {(x + dx, y + dy) for y in range(area.h)
                        for x in range(area.w)
                        if area.grid[y][x] in ("lamp", "lamppost")
                        for dx in range(-3, 4) for dy in range(-3, 4)
                        if abs(dx) + abs(dy) <= 4}
            area.folk = []
        elif key[0] == "bld":
            if key[1] not in SITES:
                raise ValueError("bad site")
            area = make_interior(w, key[1], self.flags)
        elif key[0] == "dun":
            lid, level = key[1], int(key[2])
            if lid not in LEADS or not 1 <= level <= LEADS[lid].levels:
                raise ValueError("bad level")
            area = make_dungeon(w, lid, level, self.flags)
            key = area.key
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        self.settle(area)
        return area

    # Where the Master is, hour by hour (minutes from midnight).
    MASTER_DAY = ((0, "bedroom"), (450, "dining"), (510, "study"),
                  (690, "dining"), (780, "library"), (900, "parlour"),
                  (990, "garden"), (1080, "library"), (1110, "dining"),
                  (1170, "parlour"), (1200, "bathroom"), (1260, "bedroom"))
    MAID_ROOMS = ("kitchen", "laundry", "dining", "parlour", "library",
                  "ballroom", "office", "quarters", "bathroom")

    def where(self, role):
        """Where someone is now: a site, "garden", or None (not about)."""
        t = self.now()
        mins = t.hour * 60 + t.minute
        day = self.day_no()
        if role == "master":
            if self.p.get("companion") == "master":
                return "with"
            if "cold:%d" % day in self.flags:
                return "bedroom"
            if self.turn >= DOWAGER and mins < 17 * 60:
                return "parlour"
            if self.turn >= PARTY - 30 and day == 6:
                return "ballroom"
            here = "bedroom"
            for m0, site in self.MASTER_DAY:
                if mins >= m0:
                    here = site
            return here
        if role in MAIDS:
            if self.p.get("companion") == role:
                return "with"
            if mins >= 22 * 60 or mins < 6 * 60:
                return "quarters"
            if day == 6 and self.turn >= PARTY - 30:
                return "ballroom"
            rng = random.Random("%s:%s:%d:%d" % (self.world["seed"], role,
                                                 day, mins // 60))
            return rng.choice(self.MAID_ROOMS)
        if role == "dowager":
            if DOWAGER <= self.turn < PARTY - 30:
                return "parlour"
            return "ballroom" if self.turn >= PARTY - 30 and day == 6 \
                else None
        if role == "grocer":
            return "lodge" if 10 * 60 <= mins < 16 * 60 else None
        if role in ("cousin", "tutor", "butler", "headmaid", "cook",
                    "gardener"):
            if day == 6 and self.turn >= PARTY - 30 and role != "gardener":
                return "ballroom"
            if role in self.st.get("gone", []):
                return None
            return {"cousin": "guestroom", "tutor": "schoolroom",
                    "butler": "pantry", "headmaid": "office",
                    "cook": "kitchen", "gardener": "greenhouse"}[role]
        return None

    def settle(self, area):
        """Who's in a room now, and what's lying about."""
        w = self.world
        if area.kind == "dungeon":
            return
        if area.kind == "city":
            self.populate_city(area)
            return
        sid = area.site
        self.settle_people(area)
        self.event_people(area)
        n = self.st["dust"].get(sid, 0)
        spots = [(x, y) for y in range(area.h) for x in range(area.w)
                 if area.grid[y][x] in INSIDE_FLOOR and
                 (x, y) != area.start]
        rng = random.Random("%s:dust:%s" % (w["seed"], sid))
        rng.shuffle(spots)
        for x, y in [s for s in spots if not area.mob_at(*s)][:n]:
            area.items[(x, y)] = "dustpile"

    def settle_people(self, area):
        """Who should be in a room at this hour."""
        w = self.world
        sid = area.site
        area.mobs = [m for m in area.mobs if not m.role or
                     self.where(m.role) == sid]
        here = {m.role for m in area.mobs}
        free = [(x, y) for y in range(area.h) for x in range(area.w)
                if area.grid[y][x] in INSIDE_FLOOR and (x, y) !=
                area.start and not area.mob_at(x, y) and
                abs(x - area.start[0]) + abs(y - area.start[1]) > 1]
        rng = random.Random("%s:%s:%d" % (w["seed"], sid, self.turn // 60))
        rng.shuffle(free)
        for role in ("master",) + MAIDS + ("dowager", "grocer", "cousin",
                                           "tutor", "butler", "headmaid",
                                           "cook"):
            if role in here or self.where(role) != sid:
                continue
            spot = area.seat if role == "master" and area.seat and \
                not area.mob_at(*area.seat) else None
            if spot is None:
                if role == "grocer":
                    spot = (3, 2)
                elif not free:
                    continue
                else:
                    spot = free.pop()
            if area.mob_at(*spot):
                continue
            area.mobs.append(make_person(w, role, *spot))
        for m in area.mobs:
            self.give_errand(m)

    def populate_city(self, area):
        """The grounds: the Master on the lawns in the afternoon, the
        gardener about, and whatever's got loose."""
        w = self.world
        area.mobs = [m for m in area.mobs if not m.role or m.ally]
        if self.where("master") == "garden" and not any(
                m.role == "master" for m in area.mobs):
            m = make_person(w, "master", 31, 30)
            m.roam = {"lawn", "path", "flowers"}
            m.home = (31, 30)
            area.mobs.append(m)
        n = self.st["dust"].get("hall", 0)
        spots = [(x, y) for y in range(area.h) for x in range(area.w)
                 if area.grid[y][x] in ("marble", "runner", "parquet")]
        rng = random.Random("%s:dust:hall" % w["seed"])
        rng.shuffle(spots)
        for k in [k for k, v in area.items.items() if v == "dustpile"]:
            del area.items[k]
        for x, y in spots[:n]:
            area.items[(x, y)] = "dustpile"
        self.event_people(area)

    def refresh_people(self):
        """People come and go as the clock goes round."""
        a = self.area
        if a.kind == "dungeon":
            return
        before = {m.role for m in a.mobs if m.role}
        if a.kind == "city":
            master = next((m for m in a.mobs if m.role == "master" and
                           not m.ally), None)
            if master and self.where("master") != "garden":
                a.mobs.remove(master)
            elif not master and self.where("master") == "garden":
                self.populate_city(a)
            return
        keep = [m for m in a.mobs if not m.role or m.ally or
                self.where(m.role) == a.site]
        gone = [m for m in a.mobs if m not in keep]
        a.mobs = keep
        for m in gone:
            if (m.x, m.y) in self.visible:
                self.say("%s goes out." % self.speaker(m), "info")
        self.settle_people(a)
        self.event_people(a)
        for m in a.mobs:
            if m.role and m.role not in before:
                self.say("%s comes in." % self.speaker(m), "info")

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        if area.kind == "city":
            self.night_and_day()
        self.sound.play(sound)
        self.layout()
        self.save()
        self.on_arrival()

    def go_outside(self):
        """Out of a room, into the corridor or the grounds."""
        city = self.get_area(("city",))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.populate_city(city)
        self.enter(city, self.city_pos or city.start)
        self.say("You step out into %s." % district(*self.pos), "info")

    def enter_link(self, link, x, y):
        kind, what = link
        if kind == "bld":
            self.city_pos = list(self.pos)
            self.cache.pop(("bld", what), None)
            area = self.get_area(("bld", what))
            self.flags.add("been:" + what)
            self.say("You go into %s." % area.name, "info")
            self.enter(area, area.start)
            return
        self.at_lead(what, x, y)

    def at_lead(self, lid, x, y):
        if lid == "cellar" and "cellar_ok" not in self.flags:
            self.flags.add("cellar_ok")
            self.say(fill("The cellar door is locked, but {butler} "
                          "keeps the key on a nail beside it, which rather "
                          "defeats the point.", self.world), "info")
        self.descend(lid)

    def descend(self, lid):
        if self.area.kind == "city":
            self.city_pos = list(self.pos)
        self.surface = (self.area.key, list(self.pos))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        area = self.get_area(("dun", lid, 1))
        self.say("You go into %s." % LEADS[lid].name, "info")
        self.enter(area, area.start, "stairs")

    def change_level(self, delta):
        _, lid, level = self.area.key
        if level + delta == 0:
            key, pos = self.surface
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dun"}
            area = self.get_area(tuple(key))
            self.say("You come back up, into the house.", "info")
            self.enter(area, pos, "stairs")
            return
        area = self.get_area(("dun", lid, level + delta))
        self.say("You go %s: %s." % ("down" if delta > 0 else "up",
                                     LEVEL_NAMES[(lid, level + delta)]),
                 "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        n = int(self.log.index("end").split(".")[0])
        if n > 600:
            self.log.delete("1.0", "%d.0" % (n - 500))
        self.log.config(state="disabled")
        self.log.see("end")

    @staticmethod
    def the(mob):
        return mob.name if mob.boss or mob.role or mob.name[0].isupper() \
            else "the " + mob.name

    # ── Numbers ──

    def has(self, power):
        return power in self.p["powers"]

    def quality(self, name):
        return any(q[0] == name for q in self.p["quals"])

    def spirit(self):
        return self.p["attrs"]["Will"] * 10

    def penalty(self):
        """What the state of your uniform takes off the die."""
        if self.has("absolute"):
            return 0
        return sum(n for k, n in UNIFORM if self.p["dress"][k] != "ok")

    def attr(self, a):
        p = self.p
        v = p["attrs"][a]
        if a == "Affection" and self.has("fake_cry"):
            v = max(v, p["attrs"]["Cunning"])
        return v

    def die(self, label="", extra=0):
        """A die, less the uniform, plus Favor spent on it: (die, why)."""
        p = self.p
        r = random.randint(1, 6)
        why = ["d6 %d" % r]
        pen = self.penalty()
        if pen:
            why.append("-%d uniform" % pen)
        if p["boost"]:
            why.append("+1 Favor")
            r += 1
            p["boost"] = 0
        if extra:
            why.append("%+d" % extra)
        return max(0, r - pen + extra), why

    def check(self, a, diff, label=None, extra=0, bonus=0, quiet=False):
        """A roll: a die times the Attribute, against the difficulty."""
        v = self.attr(a) + bonus
        if label and self.quality("Neat Freak") and any(
                w in label for w in ("clean", "laund", "sweep")):
            extra += 1
        if v <= 0:
            if not quiet:
                self.say("[%s%s 0: you can't]" % (label + ", " if label
                                                  else "", a), "roll")
            return False
        d, why = self.die(label, extra)
        total = d * v
        if a == "Skill" and self.has("hard_work"):
            total += 3
            why.append("+3 hard work")
        ok = total >= diff
        self.last_roll = total
        if not quiet:
            self.say("[%s%s %d x (%s) = %d vs %d: %s]" % (
                label + ", " if label else "", a, v, ", ".join(why), total,
                diff, "success" if ok else "failure"), "roll")
        return ok

    def gain_stress(self, n, why=None, quiet=False):
        p = self.p
        if self.has("persistence") and n > 0:
            n -= 1
        if n <= 0:
            return
        p["stress"] += n
        if why:
            self.say("%s (+%d Stress)" % (why, n), "mad")
        elif not quiet:
            self.say("(+%d Stress)" % n, "mad")
        if p["stress"] > self.spirit() and not p["exploding"]:
            if self.has("tenacity") and self.p["used"].get("tenacity") != \
                    self.day_no():
                p["used"]["tenacity"] = self.day_no()
                p["stress"] = self.spirit()
                self.say("It's all too much... but you grit your teeth, and "
                         "it isn't. (Tenacity)", "good")
                return
            self.root.after(1, self.explode)

    def lose_stress(self, n):
        p = self.p
        before = p["stress"]
        p["stress"] = max(0, p["stress"] - n)
        return before - p["stress"]

    def gain_favor(self, n, why=None):
        p = self.p
        if n <= 0:
            return
        if self.has("windows"):
            n += 2
        if self.world["master"]["favourite"] in p["types"]:
            n += 1
        p["favor"] += n
        self.say("%s(+%d Favor)" % (why + " " if why else "", n), "gold")
        self.sound.play("gold")

    def lose_favor(self, n, why=None):
        p = self.p
        if n <= 0:
            return
        p["favor"] -= n
        self.say("%s(-%d Favor)" % (why + " " if why else "", n), "bad")
        if p["favor"] < 0:
            self.root.after(1, self.below_zero)

    def below_zero(self):
        """Favor below nothing: lower an Attribute to stay, or go."""
        p = self.p
        if p["favor"] >= 0 or self.overlay:
            return
        ways = [a for a in ATTRS if p["attrs"][a] > 1]
        if not ways:
            self.doom("dismissed")
            return
        if getattr(self, "headless", False):
            self.lower(max(ways, key=lambda a: p["attrs"][a]))
            return
        self.say(fill("{headmaid}: 'The Master is not pleased with you. "
                      "Not at ALL. Unless you can make yourself useful...'",
                      self.world), "bad")
        self.open_menu("Your Favor is below zero. Give something up?",
                       [("Lower %s %d -> %d (+%d Favor)" % (
                           a, p["attrs"][a], p["attrs"][a] - 1,
                           10 * (p["attrs"][a] - 1)),
                         lambda a=a: self.lower(a)) for a in ways] +
                       [("Pack your bags", lambda: self.doom("dismissed"))],
                       lambda: self.doom("dismissed"))

    def lower(self, a):
        p = self.p
        p["attrs"][a] -= 1
        p["favor"] += 10 * p["attrs"][a]
        self.say("You throw yourself into the work, whatever it costs you. "
                 "(%s %d; Favor %d)" % (a, p["attrs"][a], p["favor"]),
                 "bad")
        if p["favor"] < 0:
            self.root.after(1, self.below_zero)
        self.render()

    # ── Stress Explosions ──

    QUIET_BOOMS = ("sleep", "seclusion", "prayer", "crying", "racing",
                   "running", "shopping", "binge")

    def explode(self):
        p = self.p
        if p["exploding"] or self.overlay or p["stress"] <= self.spirit():
            return
        name, text, kind = EXPLOSIONS[p["boom"]]
        if kind == "choice":
            name, text, kind = random.choice(EXPLOSIONS[:-1])
        self.sound.play("horror")
        self.say("STRESS EXPLOSION: %s! %s" % (name, text), "mad")
        self.walking = None
        self.end_talk()
        self.menu = None
        if p.get("companion"):
            self.dismiss()
        if kind in self.QUIET_BOOMS:
            self.quiet_boom(kind)
            return
        p["exploding"] = kind
        self.render()

    def quiet_boom(self, kind):
        """The Explosions that take you out of things until they're over."""
        p = self.p
        w = self.world
        mins = p["stress"]
        if kind == "seclusion":
            self.say("You run to the maids' quarters and lock yourself in.",
                     "mad")
            self.go_to_site("quarters")
        elif kind == "running":
            self.say("You run, and keep running, all the way down the drive "
                     "to the lodge, and sit on the wall, and sulk.", "mad")
            city = self.get_area(("city",))
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] == "city"}
            self.area, self.pos = city, [31, 39]
        elif kind == "racing":
            self.say("You take the ride-on mower round the lawns at "
                     "twice the speed limit, shrieking. Divots fly.", "mad")
            if self.where("master") == "garden" or random.random() < 0.3:
                self.lose_favor(roll("1d3"), "The Master saw.")
        elif kind == "shopping":
            n = min(p["coins"], roll("1d6") + 2)
            p["coins"] -= n
            self.say("You ring the village shop and order things. Lots of "
                     "things. A bread maker. Bunting. A small canoe. (-%d "
                     "pocket money)" % n, "mad")
        elif kind == "binge":
            food = [k for k in p["items"] if k in CAKE_BASE + tuple(
                FLAVOURS.values()) + MEALS + ("practice cake", "the cake")]
            if food:
                k = random.choice(food)
                self.take_item(k)
                self.say("You eat... everything. Including the %s." % k,
                         "mad")
            else:
                self.say(fill("You eat the whole of the pie {cook} left on "
                              "the windowsill to cool.", w), "mad")
                if "cook" in p["trust"]:
                    p["trust"].remove("cook")
        elif kind == "crying":
            self.say("You sit down where you are and cry your eyes out.",
                     "mad")
        elif kind == "prayer":
            self.say("You kneel, and pray, very earnestly, for it all to "
                     "stop.", "mad")
        else:
            self.say("You fall asleep where you stand.", "mad")
        p["exploding"] = kind
        self.pass_time(mins, quiet=True)
        if self.overlay:
            return
        p["stress"] = 0
        p["exploding"] = None
        self.say("...and then it's over, and you feel much better. It's %s." %
                 self.date_text(), "good")
        self.layout()

    def boom_turn(self):
        """A turn of an Explosion you're still walking about in."""
        p = self.p
        kind = p["exploding"]
        if not kind:
            return
        p["stress"] -= 1
        if p["stress"] <= 0:
            p["stress"] = 0
            p["exploding"] = None
            self.say("You pull yourself together. Deep breaths.", "good")
            return
        if self.turn % 4:
            return
        a = self.area
        near = [m for m in a.mobs if m.role and abs(m.x - self.pos[0]) +
                abs(m.y - self.pos[1]) <= 3]
        if kind in ("tantrum", "rampage"):
            if a.kind != "dungeon" and random.random() < 0.4:
                self.say(random.choice((
                    "You knock a vase off a table. It doesn't survive.",
                    "You hurl a cushion at nothing in particular.",
                    "You kick over a coal scuttle. Soot everywhere.")),
                    "mad")
                site = a.site or "hall"
                self.st["dust"][site] = self.st["dust"].get(site, 0) + 1
                if near or random.random() < 0.3:
                    self.lose_favor(1, "Someone saw.")
        elif kind == "teasing" and near:
            m = random.choice(near)
            if m.role in MAIDS:
                self.st["rstress"][m.role] += roll("1d6")
                self.say("You pull %s's apron strings, and won't stop." %
                         m.name, "mad")
                if m.role in p["trust"] and random.random() < 0.3:
                    p["trust"].remove(m.role)
                    self.say("%s doesn't like you much any more." % m.name,
                             "bad")
        elif kind == "mischief" and near:
            m = random.choice(near)
            self.say("You put salt in %s's tea when nobody's looking." %
                     self.speaker(m), "mad")
            if m.role == "master" or random.random() < 0.25:
                self.lose_favor(roll("1d3"), "You're found out.")
        elif kind == "complaining" and near:
            m = random.choice(near)
            self.say("You tell %s, at length, how hard done by you are." %
                     self.speaker(m), "mad")
        elif kind == "spoiled":
            if any(m.role == "master" for m in near):
                self.say("You stamp your foot and demand the Master give you "
                         "a pony.", "mad")
                self.lose_favor(roll("1d3"))

    def boom_blocks(self, what="that"):
        """Whether an Explosion stops you doing something."""
        kind = self.p["exploding"]
        if not kind:
            return False
        self.say("You can't do %s right now. You're too busy %s." % (
            what, {"tantrum": "having a tantrum", "rampage": "rampaging",
                   "teasing": "teasing everyone", "mischief":
                   "making mischief", "complaining": "complaining",
                   "spoiled": "being a spoiled child"}.get(kind, kind)),
            "mad")
        return True

    # ── Time ──

    def now(self):
        return START + datetime.timedelta(minutes=self.turn)

    def day_no(self):
        return (self.now() - START.replace(hour=0)).days


    def date_text(self):
        t = self.now()
        return "%s %02d:%02d (Day %d)" % (WEEKDAYS[self.day_no() % 7],
                                          t.hour, t.minute,
                                          self.day_no() + 1)

    def clock(self):
        t = self.now()
        return t.hour * 60 + t.minute

    def phase(self):
        h = self.now().hour
        return ("night" if h >= 22 or h < 6 else "dawn" if h < 7 else
                "dusk" if h >= 20 else "day")

    def pass_time(self, minutes, quiet=False):
        """Time going by in a lump: working, waiting, sulking."""
        before = self.phase()
        self.interrupt = False
        for _ in range(minutes // 10):
            self.turn += 10
            if self.turn % 30 < 10:
                self.hourly()
            if self.overlay or "won" in self.flags:
                return
            if self.interrupt:
                self.night_and_day()
                return
        self.turn += minutes % 10
        if not quiet and self.phase() != before:
            self.say("It's %s now: %s." % (self.phase(), self.date_text()),
                     "info")
        self.night_and_day()
        self.hourly()

    def hourly(self):
        """What the clock brings: wages and dust, chores, Random Events,
        the Phantom, the Dowager, the party."""
        if self.overlay or "won" in self.flags or "doom" in self.flags:
            return
        t = self.now()
        day = self.day_no()
        mins = t.hour * 60 + t.minute
        if mins >= 6 * 60 and "morning:%d" % day not in self.flags and \
                day >= 1:
            self.flags.add("morning:%d" % day)
            self.morning()
        if mins >= PHANTOM_HOUR * 60 and mins < 6 * 60 and \
                "night:%d" % day not in self.flags and 1 <= day <= 6:
            self.flags.add("night:%d" % day)
            self.phantom_night(day)
        if self.has("foreboding") and mins >= 0 and mins < 60 and \
                "fore:%d" % day not in self.flags and 1 <= day <= 6 and \
                "phantom_caught" not in self.flags:
            self.flags.add("fore:%d" % day)
            self.say("You have a feeling: something's going to happen "
                     "tonight, in %s, within the hour. (Foreboding)" %
                     SITES[NIGHTS[day - 1][0]][0], "mad")
        ev = self.world["events"].get(day)
        if ev and mins >= ev[1] * 60 and "event_day:%d" % day not in \
                self.flags:
            self.flags.add("event_day:%d" % day)
            self.random_event(ev[0])
        if ev and self.has("foreboding") and mins >= ev[1] * 60 - 60 and \
                "foreev:%d" % day not in self.flags:
            self.flags.add("foreev:%d" % day)
            self.say("You have a feeling something's about to happen. "
                     "(Foreboding)", "mad")
        self.rivals_work()
        self.event_tick()
        self.meals_cool()
        if day == 6:
            if self.turn >= DOWAGER and "dowager" not in self.flags:
                self.flags.add("dowager")
                self.say(fill("Two o'clock. A long black car comes up the "
                              "drive, and out of it steps {dowager}, "
                              "who looks at the house the way a cat looks at "
                              "a mouse. She goes to the parlour to wait for "
                              "her tea, at three.", self.world), "quest")
                self.sound.play("quest")
            if self.turn >= INSPECTION + 30 and self.st["verdict"] is None:
                self.inspection()
            if self.turn >= PARTY:
                self.party()
        if mins >= 22 * 60 and "evening:%d" % day not in self.flags:
            self.flags.add("evening:%d" % day)
            for r in MAIDS:
                if r != self.world["phantom"] or \
                        "phantom_caught" not in self.flags:
                    self.st["rival"][r] += roll("2d6")
        self.night_and_day()

    def morning(self):
        """A new day: wages, dust, and the Phantom's card."""
        w = self.world
        p = self.p
        day = self.day_no()
        pay = 10 if self.quality("Greedy") else 5
        p["coins"] += pay
        for sid in INDOOR_SITES:
            self.st["dust"][sid] = min(5, self.st["dust"].get(sid, 0) +
                                       random.randint(0, 1))
        self.st["dust"]["hall"] = min(12, self.st["dust"].get("hall", 0) +
                                      random.randint(2, 4))
        self.cache = {k: v for k, v in self.cache.items()
                      if k == self.area.key}
        if self.area.kind == "city":
            self.populate_city(self.area)
        self.say("%s. A new day at Larkspur. Your wages: %d. (%d day%s to "
                 "the birthday.)" % (WEEKDAYS[day % 7], pay, 6 - day,
                                     "" if day == 5 else "s"), "quest")
        if day <= 6 and "phantom_caught" not in self.flags:
            room, thing = NIGHTS[day - 1]
            if "foiled:%d" % day in self.flags:
                self.say("The Phantom didn't get what it came for last "
                         "night.", "good")
            else:
                self.say(fill("{headmaid} is in a state: in the night "
                              "the Phantom took %s, from %s, and left a "
                              "calling card." % (
                                  "every left stocking in the house" if
                                  thing == "stockings" else
                                  "the " + thing if not
                                  thing.startswith("the") else thing,
                                  SITES[room][0]), w), "bad")
            if day < 6:
                nxt = NIGHTS[day][0]
                self.say(fill("The card says: '%s'" % CARD_TEXT[day].format(
                    room=SITES[nxt][0].replace("the ", "").upper()), w),
                    "talk")
        if day == 6:
            self.say("SUNDAY. The Master's birthday. The Dowager at two, tea "
                     "at three, the party at five. Bake the cake!", "quest")

    def night_and_day(self):
        city = self.cache.get(("city",))
        if not city:
            return

    # ── Turns ──

    def on_key(self, ev):
        if self.talk or self.busy or ev.state & 0x0C:
            return
        k = ev.keysym
        self.walking = None
        if self.menu:
            k = k[3:] if k.startswith("KP_") else k
            if k in ("Up", "w", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "space", "KP_Enter"):
                self.menu_pick()
            elif k.isdigit() and 1 <= int(k) <= len(self.menu["items"]):
                self.menu_pick(int(k) - 1)
            else:
                self.menu_cancel()
            return
        if self.overlay:
            if self.overlay in ("won", "doom") and k in ("n", "N"):
                self.new_game()
            elif self.overlay not in ("won", "doom") or k in ("Escape",
                                                              "Return"):
                self.close_overlay()
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("e", "E"):
            self.search()
        elif k in ("c", "C"):
            self.chore_here()
        elif k in ("f", "F"):
            self.favor_menu()
        elif k in ("u", "U"):
            self.use_menu()
        elif k in ("space", "period", "KP_5"):
            self.wait()
        elif k in ("z", "Z"):
            self.wait_until()
        elif k in ("i", "I"):
            self.show_sheet()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("r", "R"):
            self.show_rota()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def close_overlay(self):
        if self.overlay in ("won", "doom"):
            self.action_menu()
            return
        self.overlay = None
        self.render()

    def ready(self):
        return bool(getattr(self, "area", None)) and not (
            self.busy or self.talk or self.overlay or self.menu)


    def can_stand(self, x, y):
        return self.area.grid[y][x] in WALKABLE

    def move(self, dx, dy):
        if not self.ready():
            return
        r = self.step(dx, dy)
        if r in ("moved", "turn"):
            slow = self.area.grid[self.pos[1]][self.pos[0]] in (
                "mud", "cobweb", "hay")
            self.end_turn(0.5 if self.area.kind == "city" and r == "moved"
                          else 1)
            if slow and not self.busy and not self.overlay:
                self.end_turn()

    TOUCHABLE = {"bed", "table", "counter", "desk", "shelf", "stove", "sink",
                 "tub", "bath", "wardrobe", "piano", "sofa", "fireplace",
                 "window", "display", "clock", "rota", "plant", "crate",
                 "nest", "telephone", "basket", "mangle", "bench", "pond",
                 "fountain", "statue", "wall", "pillar", "stone",
                 "wall_room", "hedge", "tree", "glasshouse", "henhouse",
                 "lodge", "chair", "crate_open"}
    LINK_TILES = {"door", "stairs_cellar", "stairs_attic", "maze_gate"}

    def step(self, dx, dy):
        """One square: "moved", "turn" (something took the turn), "done"
        (handled) or "blocked"."""
        a = self.area
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if a.kind == "inside":
                self.go_outside()
            else:
                self.bump()
            return "done"
        mob = a.mob_at(x, y)
        if mob:
            if mob.hostile:
                self.take_on(mob)
                self.end_turn()
            elif mob.ally and mob.role != "master":
                mob.x, mob.y, self.pos = self.pos[0], self.pos[1], [x, y]
                return "moved"
            else:
                self.start_talk(mob)
            return "done"
        t = a.grid[y][x]
        if t == "counter":
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return "done"
        link = a.links.get((x, y))
        if link and t in self.LINK_TILES:
            self.enter_link(link, x, y)
            return "done"
        if t in self.TOUCHABLE and not self.can_stand(x, y):
            self.touch(t, x, y)
            return "done"
        if not self.can_stand(x, y):
            self.bump()
            return "done"
        self.pos = [x, y]
        if t == "exit":
            self.go_outside()
            return "done"
        if t == "stairs_down":
            self.change_level(1)
            return "done"
        if t == "stairs_up":
            self.change_level(-1)
            return "done"
        if self.step_on(x, y):
            return "turn"
        return "moved"

    def bump(self):
        self.say("Blocked.", "info")
        self.sound.play("bump")

    @staticmethod
    def floor_spots(a):
        if not hasattr(a, "floor_cache"):
            a.floor_cache = [(x, y) for y in range(a.h) for x in range(a.w)
                             if a.grid[y][x] == "dfloor"]
        return a.floor_cache


    def end_turn(self, cost=1):
        """A turn: a minute, or half of one striding along a corridor."""
        a = self.area
        if "won" in self.flags or "doom" in self.flags:
            return
        before = self.phase()
        self.half = getattr(self, "half", 0) + cost
        ticked = self.half >= 1
        if ticked:
            self.half -= 1
            self.turn += 1
        now = self.phase()
        if now != before and a.kind == "city":
            self.say({"dawn": "The sun comes up over the park.",
                      "day": "The house is up and about.",
                      "dusk": "The lamps are lit along the terrace.",
                      "night": "Night. The house creaks, and settles."}[now],
                     "info")
        if ticked and self.turn % 30 == 0:
            self.hourly()
            if self.overlay:
                return
        if ticked and self.turn % 10 == 0:
            self.refresh_people()
        if ticked:
            self.boom_turn()
        if self.overlay:
            return
        self.render()
        for mob in list(a.mobs):
            if self.overlay or self.area is not a:
                return
            if mob not in a.mobs:
                continue
            if mob.ally:
                self.ally_act(mob)
            elif mob.hostile:
                self.monster_act(mob)
            else:
                self.wander(mob)
            if self.overlay or self.area is not a:
                return
        if a.kind == "city":
            self.spawn_city()
        self.render()

    # ── Troublemakers ──

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        if a.kind == "city":
            return t in CITY_GROUND
        if a.kind == "inside":
            return t in INSIDE_FLOOR
        return t in DUNGEON_FLOOR and t not in ("stairs_up", "stairs_down")

    def monster_act(self, mob):
        m = MONSTERS[mob.kind]
        if mob.stuck:
            mob.stuck -= 1
            return
        if "slow" in m.traits and self.turn % 2:
            return
        steps = 2 if "fast" in m.traits else 1
        for _ in range(steps):
            if mob not in self.area.mobs or not mob.hostile or self.overlay:
                return
            if self.monster_step(mob, m):
                return

    def monster_step(self, mob, m):
        """One move; True if it came at you (and so is done)."""
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if not mob.aware:
            if dist <= 1 or ((mob.x, mob.y) in self.visible and dist <= 6):
                mob.aware = True
            else:
                self.drift(mob)
                return False
        runs = "catch" in m.traits or mob.flee > 0
        if runs:
            if mob.flee > 0:
                mob.flee -= 1
            if dist <= 4 and random.random() < 0.7:
                for sx, sy in sorted(DIRS, key=lambda d: -abs(
                        px - mob.x - d[0]) - abs(py - mob.y - d[1]) +
                        random.random()):
                    if self.can_go(mob, mob.x + sx, mob.y + sy):
                        mob.x += sx
                        mob.y += sy
                        break
            else:
                self.drift(mob)
            return False
        if dist == 1:
            self.contest(mob, attacking=False)
            return True
        chase = dist <= 10
        if "erratic" in m.traits and random.random() < 0.4:
            chase = False
        if chase:
            order = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                           abs(py - mob.y - d[1]) + random.random() * 0.5)
        else:
            order = [random.choice(DIRS)]
        for sx, sy in order[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break
        return False

    def drift(self, mob):
        if random.random() < 0.3:
            sx, sy = random.choice(DIRS)
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy

    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        a = self.area
        if (a.inside(x, y) and a.grid[y][x] in mob.roam
                and not a.mob_at(x, y) and [x, y] != self.pos
                and not any((x + ex, y + ey) in a.links for ex, ey in DIRS)
                and (mob.home is None or abs(x - mob.home[0]) +
                     abs(y - mob.home[1]) <= 5)):
            mob.x, mob.y = x, y


    def spawn_city(self):
        pass

    # ── Contests ──

    def take_on(self, mob):
        """Walking into a troublemaker: choose how to take it on, the
        first time."""
        m = MONSTERS[mob.kind]
        if mob.way:
            self.contest(mob, attacking=True)
            return
        ways = [w for w in m.ways if self.attr(w) > 0] or list(m.ways)
        if len(ways) == 1 or getattr(self, "headless", False):
            mob.way = max(ways, key=self.attr)
            self.contest(mob, attacking=True)
            return
        verbs = {"Athletics": "Grab it, swat it, chase it",
                 "Affection": "Coax it, sweet-talk it",
                 "Skill": "Deal with it properly, like a maid",
                 "Cunning": "Trick it, trap it", "Will": "Stare it down",
                 "Luck": "Trust to luck"}
        items = [("%s (%s %d)" % (verbs[w], w, self.attr(w)),
                  lambda w=w: self.pick_way(mob, w)) for w in ways]
        if self.has("escape"):
            items.append(("Walk away (Escape)", lambda: self.escape(mob)))
        self.open_menu("%s: %s. How will you take it on?" % (
            cap(self.the(mob)), m.hint), items, lambda: None)

    def pick_way(self, mob, way):
        mob.way = way
        self.contest(mob, attacking=True)
        self.end_turn()

    def escape(self, mob):
        mob.aware = False
        mob.flee = 5
        self.say("You walk away, and it lets you. (Escape)", "good")

    def contest(self, mob, attacking=True):
        """One exchange: both roll, and the loser takes Stress."""
        p = self.p
        m = MONSTERS[mob.kind]
        if mob not in self.area.mobs:
            return
        way = mob.way or (attacking and m.ways[0]) or max(
            ("Athletics", "Will", "Cunning"), key=self.attr)
        if not attacking and self.has("karma"):
            way = "Luck"
        if not attacking and self.has("escape") and mob.way is None:
            self.escape(mob)
            return
        theirs = m.ways[0] if way not in m.ways and attacking else \
            (m.attack if not attacking else way)
        extra = 1 if "animal" in m.traits and (
            self.quality("Nekomimi") or self.quality("Fox")) else 0
        mine_a = self.attr(way) + (1 if attacking and way == "Athletics" and
                                   self.has("giant") else 0)
        d, why = self.die(extra=extra)
        mine = d * mine_a
        first = attacking and self.has("nowhere") and not getattr(
            mob, "met", False)
        mob.met = True
        their_a = m.level
        theirs_roll = 0 if first else random.randint(1, 6) * their_a
        self.say("[%s %d x (%s) = %d vs %s %s %d x d6 = %d]" % (
            way, mine_a, ", ".join(why), mine, self.the(mob), theirs,
            their_a, theirs_roll) if not first else
            "[%s %d x (%s) = %d; it doesn't get to roll: Weapon From "
            "Nowhere]" % (way, mine_a, ", ".join(why), mine), "roll")
        name = cap(self.the(mob))
        if mine > theirs_roll:
            n = mine // their_a if their_a else mine
            if way == "Cunning" and self.has("coercion"):
                n *= 2
            if self.has("mockery"):
                n += 2
            if not attacking and way == "Luck" and mine >= 10:
                n *= 2
            mob.stress += n
            mob.aware = True
            self.flash(mob.x, mob.y)
            self.sound.play("hit")
            text = random.choice(self.WIN_TEXT[way]) % self.the(mob)
            if way == "Athletics":
                text += " with your " + p["weapon"]
            self.say("%s. (%s takes %d Stress)" % (text, name, n), "good")
            if (way == "Cunning" and self.has("restraint") and
                    m.attack == "Athletics") or mob.stress > m.spirit:
                self.beaten(mob)
        elif theirs_roll > mine:
            n = theirs_roll // mine_a if mine_a else theirs_roll
            if theirs == "Athletics" and self.has("immune"):
                n = 0
            if self.has("evasion") and n > 3:
                n = min(n, roll("1d6"))
                self.say("(Super Evasion)", "info")
            self.sound.play("hurt")
            self.flash(*self.pos)
            self.say("%s gets the better of you." % name, "bad")
            if n:
                self.gain_stress(n, quiet=True)
                self.say("(+%d Stress)" % n, "mad")
            if theirs == "Athletics" and theirs_roll - mine >= 6:
                self.spoil_uniform(random.choice(("torn", "dirty")))
        else:
            self.say("You're evenly matched.", "info")

    WIN_TEXT = {
        "Athletics": ("You go at %s", "You swat at %s"),
        "Affection": ("You coax %s, ever so sweetly",),
        "Skill": ("You deal with %s briskly, like a professional",),
        "Cunning": ("You outfox %s",),
        "Will": ("You give %s a look that could curdle milk",),
        "Luck": ("By sheer luck, %s trips over its own feet",),
    }

    def spoil_uniform(self, how, piece=None):
        p = self.p
        ok = [k for k, _ in UNIFORM if p["dress"][k] == "ok"]
        if not ok:
            return
        piece = piece if piece in ok else random.choice(ok)
        p["dress"][piece] = how
        self.say("Your %s %s %s! (-%d to the die until you change it)" % (
            piece, "are" if piece.endswith("s") else "is", how,
            dict(UNIFORM)[piece]), "bad")

    def beaten(self, mob):
        a = self.area
        m = MONSTERS[mob.kind]
        if mob in a.mobs:
            a.mobs.remove(mob)
        self.flash(mob.x, mob.y, "puff")
        self.sound.play("kill")
        self.say(m.beaten, "good")
        k = mob.kind
        if k == "hen":
            self.st["hens"] += 1
            self.say("(You have %d hen%s under your arms. Take them back to "
                     "the henhouse.)" % (self.st["hens"], "s"
                                         if self.st["hens"] > 1 else ""),
                     "info")
        elif k == "penguin":
            self.flags.add("have_penguin")
            self.say(fill("(Take the penguin to the zookeeper at the "
                          "lodge.)", self.world), "info")
        elif mob.boss and a.lead:
            self.flags.add("beat:" + a.lead)
            if a.lead == "maze":
                self.say("The geese fall back, honking respectfully. The "
                         "maze is yours.", "quest")
        elif k == "doll":
            self.end_event("doll", "mission")
        elif k == "ninja":
            self.ninja_beaten()
        elif k == "agent":
            self.agent_beaten()

    # ── Chores ──
    #
    # id: what it is, its window (minutes from midnight), and where.

    CHORES = {
        "wake": ("wake the Master", 390, 450, "bedroom"),
        "breakfast": ("serve breakfast", 420, 510, "dining"),
        "laundry": ("do the laundry", 540, 690, "laundry"),
        "lunch": ("serve luncheon", 690, 780, "dining"),
        "cleaning": ("do the cleaning", 780, 900, None),
        "tea": ("serve afternoon tea", 900, 960, "parlour"),
        "walk": ("take the Master for a walk", 990, 1080, None),
        "dinner": ("serve dinner", 1110, 1170, "dining"),
        "bath": ("draw the Master's bath", 1200, 1260, "bathroom"),
        "bedtime": ("put the Master to bed", 1260, 1320, "bedroom"),
    }
    MEAL_CHORE = {"breakfast": "breakfast", "lunch": "lunch", "tea": "tea",
                  "dinner": "dinner"}

    def chore_key(self, cid):
        return "%s:%d" % (cid, self.day_no())

    def chore_open(self, cid):
        """Whether a chore can still be done now: in its window, and nobody
        has done it."""
        _, t0, t1, _ = self.CHORES[cid]
        return t0 <= self.clock() < t1 and \
            self.chore_key(cid) not in self.st["chores"]

    def did_chore(self, cid, text=None):
        self.st["chores"][self.chore_key(cid)] = "you"
        self.gain_favor(roll(FAVOR["chore"]), text or "The Master is "
                        "pleased.")
        self.st["mood"] += 1
        for e in self.world["errands"]:
            if e["kind"] == "chore" and e["thing"] == cid and \
                    self.side.get(e["id"], {}).get("state") == "active":
                self.flags.add("chore:" + e["id"])

    def rivals_work(self):
        """The other maids get to the chores you don't."""
        now = self.clock()
        if self.day_no() == 6 and self.turn >= DOWAGER:
            return
        for cid, (name, t0, t1, _) in self.CHORES.items():
            key = self.chore_key(cid)
            if key in self.st["chores"] or now < t0 + (t1 - t0) * 2 // 3:
                continue
            rng = random.Random("%s:%s" % (self.world["seed"], key))
            if now >= t1:
                self.st["chores"][key] = "nobody"
                continue
            if rng.random() < 0.2:
                continue
            maids = [m for m in MAIDS if not (
                m == self.world["phantom"] and "phantom_caught" in
                self.flags)]
            r = max(maids, key=lambda m: self.world["maids"][m]["attrs"][
                "Skill"] + rng.random() * 4)
            self.st["chores"][key] = r
            if cid == "cleaning":
                for sid in rng.sample(INDOOR_SITES, 6):
                    self.st["dust"][sid] = max(0, self.st["dust"][sid] - 2)
                self.st["dust"]["hall"] = max(0, self.st["dust"]["hall"] -
                                              4)
            gain = roll("1d6+1", rng)
            if self.world["master"]["favourite"] in \
                    self.world["maids"][r]["types"]:
                gain += 1
            self.st["rival"][r] += gain
            if self.area.kind == "inside" and self.area.site == \
                    self.CHORES[cid][3]:
                self.say("%s gets there first, and does it: %s." % (
                    self.world["people"][r]["name"], name), "info")

    def meals_cool(self):
        """A meal nobody's eaten by the end of its time goes cold."""
        for cid, meal in self.MEAL_CHORE.items():
            if self.p["items"].get(meal) and self.clock() >= \
                    self.CHORES[cid][2] + 30:
                self.take_item(meal, self.p["items"][meal])
                self.say("The %s has gone cold. You take it back to the "
                         "kitchen." % meal, "info")

    def chore_here(self):
        """C: whatever wants doing where you're standing."""
        if not self.ready():
            return
        if self.boom_blocks("chores"):
            return
        a = self.area
        x, y = self.pos
        near = [(x + dx, y + dy) for dx, dy in DIRS + ((0, 0),)
                if a.inside(x + dx, y + dy)]
        for nx, ny in near:
            m = a.mob_at(nx, ny)
            if m and m.role == "master":
                self.start_talk(m)
                return
        for nx, ny in near:
            t = a.grid[ny][nx]
            if t in ("stove", "tub", "mangle", "wardrobe", "bath", "nest",
                     "rota", "display", "telephone", "bed"):
                self.touch(t, nx, ny)
                return
        if any(a.items.get(p) == "dustpile" for p in near):
            p = next(p for p in near if a.items.get(p) == "dustpile")
            self.sweep(*p)
            self.end_turn()
            return
        self.say("Nothing wants doing just here. (Press R for the rota.)",
                 "info")

    def touch(self, t, x, y):
        a = self.area
        w = self.world
        if self.p["exploding"] and t not in ("bed",):
            if self.boom_blocks("that"):
                return
        if t == "stove" and self.active_event("fire"):
            self.take_fire()
        elif t == "stove":
            self.stove_menu()
        elif t in ("tub", "mangle", "basket") and a.site == "laundry":
            self.do_laundry()
        elif t == "wardrobe" and a.site == "laundry":
            self.change_uniform()
        elif t == "wardrobe":
            self.say("Somebody else's wardrobe. Fresh uniforms are in the "
                     "laundry.", "info")
        elif t == "bath":
            if self.chore_open("bath"):
                if self.check("Skill", 4, "drawing the bath"):
                    self.pass_time(10, quiet=True)
                    self.say("Hot, not too hot, and bubbles. Perfect.",
                             "good")
                    self.did_chore("bath")
                else:
                    self.say("Too cold. Then too hot. Then you flood the "
                             "floor.", "bad")
                    self.gain_stress(1, quiet=True)
                    self.spoil_uniform("dirty", "stockings")
                self.end_turn()
            else:
                self.say("A big claw-footed bath. The Master's bath is "
                         "drawn at eight.", "info")
        elif t == "nest":
            self.henhouse()
        elif t == "rota":
            self.show_rota()
        elif t == "display":
            if "taken:the Larkspur Star" in self.flags and \
                    "back:the Larkspur Star" not in self.flags:
                self.say("The display case is empty.", "bad")
            else:
                self.say("The Larkspur Star, on blue velvet under glass: a "
                         "sapphire as big as a quail's egg.", "info")
        elif t == "bed":
            self.bed_menu()
        elif t == "telephone":
            self.say("A telephone. It's for the Master's business, and "
                     "{headmaid} counts the calls.".format(
                         headmaid=w["people"]["headmaid"]["short"]),
                     "info")
        elif t == "crate":
            self.open_loot(x, y)
        elif t == "shelf" and a.site == "kitchen":
            self.say("The pantry shelves: flour, sugar, butter, jars of "
                     "this and that. Ask the cook for INGREDIENTS.", "info")
        elif t == "shelf" and a.site == "library":
            self.say("Books, floor to ceiling. A lot of them are detective "
                     "stories, and the Master's read them all.", "info")
        elif t == "piano":
            self.say("You pick out a tune on the piano. Not well.", "info")
        elif t == "plant" and a.site == "greenhouse":
            self.say(fill("Strawberries, lemons, tomatoes. {gardener} "
                          "would rather you ASKED.", w), "info")
        elif t in ("pond", "fountain"):
            self.say("Water, and the carp in it, looking hopeful.", "info")
        elif t == "fireplace":
            self.say("A good fire. You warm your hands.", "info")
            if self.p["items"].get("egg"):
                self.warm_egg()
        elif t == "window":
            self.say("You look out at the park." if self.phase() != "night"
                     else "Your own reflection, and the dark.", "info")
        elif t == "clock":
            self.say("The clock says %s." % self.date_text(), "info")
        else:
            self.bump()

    # ── The kitchen ──

    def stove_menu(self):
        p = self.p
        items = []
        for cid, meal in self.MEAL_CHORE.items():
            _, t0, t1, _ = self.CHORES[cid]
            if t0 - 30 <= self.clock() < t1 and not p["items"].get(meal):
                items.append(("Cook %s (Skill)" % meal,
                              lambda m=meal: self.cook(m)))
        have = all(p["items"].get(k) for k in CAKE_BASE[:4])
        if self.day_no() < 6:
            if self.day_no() in p["practised"]:
                pass
            elif have:
                items.append(("Bake a practice cake (Skill, hard)",
                              self.practice))
            else:
                items.append(("Bake a practice cake (need flour, sugar, "
                              "butter, eggs)", lambda: None))
        elif "baked" not in self.flags and self.turn < PARTY:
            items.append(("BAKE THE BIRTHDAY CAKE", self.bake_cake))
        if self.active_event("cold") and p["items"].get("honey") and \
                p["items"].get("lemons") and not p["items"].get("medicine"):
            items.append(("Make honey and lemon for the Master",
                          self.make_medicine))
        if not items:
            self.say("The stove's hot. Nothing to cook just now: meals are "
                     "on the rota (R).", "info")
            return
        items.append(("Never mind", lambda: None))
        self.open_menu("The kitchen stove", items)

    def cook(self, meal):
        bonus = 1 if self.has("menu") else 0
        extra = 1 if meal == "tea" and self.p["items"].get("earl grey") \
            else 0
        self.pass_time(15, quiet=True)
        if self.check("Skill", 6, "cooking " + meal, extra=extra,
                      bonus=bonus):
            self.give_item(meal)
            self.say("%s, done to a turn. Take it to the Master, while it's "
                     "hot." % cap(meal), "good")
        else:
            self.say("Burnt. Start again.", "bad")
            self.gain_stress(1, quiet=True)
            if random.random() < 0.3:
                self.spoil_uniform("dirty", "apron")
        self.end_turn()

    def practice(self):
        p = self.p
        for k in CAKE_BASE[:4]:
            self.take_item(k)
        p["practised"].append(self.day_no())
        self.pass_time(60, quiet=True)
        if self.check("Skill", 8, "a practice cake",
                      bonus=1 if self.has("menu") else 0):
            if p["cake"] < 2:
                p["cake"] += 1
            self.say("It rises! You've got the knack of it. (+1 to the "
                     "birthday cake, now +%d)" % p["cake"], "good")
            self.give_item("practice cake")
        else:
            self.say("It comes out flat as a doormat. Well, that's what "
                     "practice is for.", "bad")
            self.gain_stress(1, quiet=True)
        self.end_turn()

    def bake_cake(self):
        p = self.p
        missing = [k for k in CAKE_BASE if not p["items"].get(k)]
        flav = next((f for f, k in FLAVOURS.items() if p["items"].get(k)),
                    None)
        if missing:
            self.say("You still need: %s." % ", ".join(missing), "bad")
            return
        bonus = p["cake"]
        notes = []
        if p["items"].get("recipe book") or "back:recipe book" in self.flags:
            bonus += 1
            notes.append("the family recipe (+1)")
        if flav == self.world["flavour"]:
            bonus += 1
            notes.append("the Master's favourite, %s (+1)" % flav)
        elif flav is None:
            bonus -= 1
            notes.append("plain sponge (-1)")
        for k in CAKE_BASE:
            self.take_item(k)
        if flav:
            self.take_item(FLAVOURS[flav])
        helpers = [r for r in MAIDS if r in p["trust"]]
        self.flags.add("baked")
        self.st["cake"] = {"bonus": bonus, "flavour": flav,
                           "helpers": helpers}
        self.pass_time(90, quiet=True)
        self.say("You bake the birthday cake%s%s. %s" % (
            ", " + flav if flav else "",
            " with " + ", ".join(notes) if notes else "",
            ("%s help%s, of course." % (" and ".join(
                self.world["people"][r]["name"] for r in helpers),
                "s" if len(helpers) == 1 else "")) if helpers else
            "Nobody helps. The other maids are making their own."),
            "good")
        self.say("It goes to the ballroom, under a cloth, for five o'clock.",
                 "info")
        self.end_turn()

    def make_medicine(self):
        self.take_item("honey")
        self.take_item("lemons")
        self.give_item("medicine")
        self.say("Hot honey and lemon, in the Master's favourite mug.",
                 "good")

    # ── The laundry ──

    def do_laundry(self):
        if self.chore_key("laundry") in self.st["chores"] and \
                self.st["fresh"] >= 6:
            self.say("The laundry's done for today.", "info")
            return
        self.say("You wash, and mangle, and press, for an hour.", "info")
        self.pass_time(60, quiet=True)
        if self.check("Skill", 6, "the laundry",
                      bonus=1 if self.has("cleaning") else 0):
            self.st["fresh"] = min(9, self.st["fresh"] + 4)
            self.say("Everything clean and folded. (%d fresh uniform "
                     "pieces in the wardrobe)" % self.st["fresh"], "good")
            if self.chore_open("laundry"):
                self.did_chore("laundry", "Mrs. %s nods." % self.world[
                    "people"]["headmaid"]["name"].split()[-1])
        else:
            self.say("Something red got in with the whites.", "bad")
            self.gain_stress(1, quiet=True)
            self.st["fresh"] = min(9, self.st["fresh"] + 1)
        self.end_turn()

    def change_uniform(self):
        p = self.p
        bad = [k for k, _ in UNIFORM if p["dress"][k] != "ok"]
        if not bad:
            self.say("Your uniform's spotless.", "info")
            return
        if not self.st["fresh"]:
            self.say("The wardrobe's empty: nothing's clean. Do the "
                     "laundry.", "bad")
            return
        n = 0
        for k in bad:
            if self.st["fresh"]:
                self.st["fresh"] -= 1
                p["dress"][k] = "ok"
                n += 1
        self.say("You change into fresh %s. (%d left in the wardrobe)" % (
            ", ".join(bad[:n]), self.st["fresh"]), "good")
        self.end_turn()

    # ── The henhouse ──

    def henhouse(self):
        p = self.p
        if self.st["hens"]:
            n = self.st["hens"]
            self.st["hens"] = 0
            self.st["hens_home"] = self.st.get("hens_home", 0) + n
            self.say("You put %d hen%s back in the henhouse." % (
                n, "s" if n > 1 else ""), "good")
            if self.active_event("hens") and self.st["hens_home"] >= \
                    self.st.get("hens_out", 4):
                self.end_event("hens", "mission")
            return
        if "eggs:%d" % self.day_no() in self.flags:
            self.say("You've had today's eggs.", "info")
            return
        if self.active_event("hens"):
            self.say("The nest boxes are empty. The hens are all OUT.",
                     "bad")
            return
        self.flags.add("eggs:%d" % self.day_no())
        self.give_item("eggs")
        self.say("Warm brown eggs, from under indignant hens.", "good")
        if p["items"].get("eggs") and random.random() < 0.2:
            self.spoil_uniform("dirty", "stockings")

    # ── Sweeping ──

    def sweep(self, x, y):
        a = self.area
        if a.items.get((x, y)) != "dustpile":
            return
        del a.items[(x, y)]
        site = a.site or "hall"
        self.st["dust"][site] = max(0, self.st["dust"].get(site, 0) - 1)
        key = "swept:%d" % self.day_no()
        self.st[key] = self.st.get(key, 0) + (
            1 if self.CHORES["cleaning"][1] <= self.clock() <
            self.CHORES["cleaning"][2] else 0)
        self.say("You sweep up the dust.", "info")
        if self.st[key] >= 6 and self.chore_open("cleaning"):
            self.did_chore("cleaning", "The house gleams.")

    # ── Bed ──

    def bed_menu(self):
        a = self.area
        if a.site != "quarters":
            self.say("That's not your bed.", "info")
            return
        self.open_menu("Your bed in the maids' quarters", [
            ("Sit down for half an hour (shed Stress)",
             lambda: self.rest(30)),
            ("Sleep until six", self.sleep_night),
            ("Not now", lambda: None)])

    def rest(self, minutes):
        p = self.p
        self.say("You put your feet up.", "info")
        self.pass_time(minutes, quiet=True)
        if self.overlay or self.interrupt:
            self.render()
            return
        n = self.lose_stress(roll("1d6") + p["attrs"]["Will"])
        self.say("Much better. (-%d Stress)" % n, "good")
        self.render()

    def sleep_night(self):
        p = self.p
        t = self.clock()
        if 6 * 60 <= t < 21 * 60:
            self.say("Sleep? At this hour? Mrs. {0} would have a fit.".format(
                self.world["people"]["headmaid"]["short"]), "info")
            return
        until = (6 * 60 - t) % DAY
        self.say("You turn in.", "info")
        self.pass_time(until, quiet=True)
        if self.overlay:
            return
        p["stress"] = 0
        self.say("You wake refreshed. It's %s." % self.date_text(), "good")
        self.layout()

    def bed_spot(self, area):
        for y in range(area.h):
            for x in range(area.w):
                if area.grid[y][x] == "bed" and y + 1 < area.h and \
                        area.grid[y + 1][x] in INSIDE_FLOOR:
                    return x, y + 1
        return area.start


    # ── Serving the Master ──

    def serve(self, mob):
        """Walking up to the Master: whatever's due."""
        p = self.p
        site = self.area.site
        for cid, meal in self.MEAL_CHORE.items():
            if p["items"].get(meal) and self.CHORES[cid][3] == site:
                if not self.chore_open(cid):
                    self.npc_say(mob, "Oh, I've already had %s, thank you." %
                                 meal)
                    return True
                self.take_item(meal)
                self.say("You serve the Master %s." % meal, "info")
                if self.penalty() >= 2 and random.random() < 0.5:
                    self.npc_say(mob, "...Is that a stain on your apron?")
                self.did_chore(cid, "The Master eats every scrap.")
                if self.has("cooked"):
                    self.gain_favor(1, "Cooked with love.")
                    self.lose_stress(roll("1d6"))
                p["served"] += 1
                return True
        if site == "parlour" and self.turn >= DOWAGER and \
                p["items"].get("tea"):
            return False
        if site == "bedroom" and self.chore_open("wake"):
            if self.check("Affection", 4, "waking the Master"):
                self.npc_say(mob, "Mm... five more minutes... oh, it's you. "
                             "Good morning.")
                self.did_chore("wake")
            else:
                self.npc_say(mob, "Go AWAY. ...Sorry. Good morning.")
                self.st["chores"][self.chore_key("wake")] = "you"
            return True
        if site == "bedroom" and self.chore_open("bedtime"):
            a = max(("Affection", "Cunning"), key=self.attr)
            if self.check(a, 6, "a bedtime story"):
                self.npc_say(mob, "...and then what happened? ...And "
                             "then...? Mm. Goodnight.")
                self.did_chore("bedtime", "The Master falls asleep "
                               "smiling.")
            else:
                self.npc_say(mob, "I've heard that one. Goodnight.")
                self.st["chores"][self.chore_key("bedtime")] = "you"
            return True
        if self.active_event("cold") and site == "bedroom" and \
                p["items"].get("medicine"):
            self.take_item("medicine")
            if self.check("Affection", 6, "nursing the Master"):
                self.npc_say(mob, "That's lovely. I feel better already. "
                             "Will you sit with me a bit?")
                self.end_event("cold", "moment")
            else:
                self.npc_say(mob, "Thank you. *sniff*")
            return True
        return False

    # ── Things ──

    def give_item(self, n, k=1):
        p = self.p
        p["items"][n] = p["items"].get(n, 0) + k
        self.flags.add("got:" + n)

    def take_item(self, n, k=1):
        p = self.p
        p["items"][n] = p["items"].get(n, 0) - k
        if p["items"][n] <= 0:
            del p["items"][n]

    def use_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        if p["items"].get("practice cake"):
            items.append(("Eat a slice of practice cake",
                          self.eat_cake))
        if not p["present"]:
            for thing, need, attr in (
                    ("scarf", ("yarn",), "Skill"),
                    ("painting", ("paints",), "Skill"),
                    ("kite", ("kite kit",), "Skill")):
                if all(p["items"].get(k) for k in need):
                    items.append(("Make a %s (%s, two hours)" % (thing, attr),
                                  lambda t=thing, n=need, a=attr:
                                  self.craft(t, n, a)))
            if p["items"].get("photo", 0) >= 4:
                items.append(("Make a scrapbook of the photos (Affection)",
                              lambda: self.craft("scrapbook", ("photo",),
                                                 "Affection", 4)))
            for thing in PRESENTS:
                if p["items"].get(thing) and thing not in (
                        "music box", "egg"):
                    items.append(("Choose the %s as your present" % thing,
                                  lambda t=thing: self.choose_present(t)))
        elif p["items"].get("ribbon") and not p["present"].get("wrapped"):
            items.append(("Wrap your present (ribbon)", self.wrap_present))
        if p["items"].get("sewing kit") and any(
                v == "torn" for v in p["dress"].values()):
            items.append(("Mend your uniform (sewing kit, Skill)",
                          self.mend))
        if p["items"].get("bell") and self.area.kind == "inside":
            items.append(("Set the bell trap here", self.set_trap))
        if self.has("trap") and self.area.kind == "inside" and \
                self.st.get("trap") != self.area.site:
            items.append(("Lay a trap here (Trap)", self.set_trap))
        if p["items"].get("map"):
            items.append(("Read the map", lambda: self.say(
                "The hedge maze, drawn small, with an X at the very "
                "middle.", "info")))
        if p["items"].get("egg"):
            items.append(("Keep the egg warm", self.warm_egg))
        if self.has("teleport"):
            items.append(("Teleport somewhere in the house",
                          self.teleport_menu))
        if self.has("saw_it") and p["used"].get("saw_it") != self.day_no():
            items.append(("Saw It: you saw something...", self.saw_it))
        if self.has("dress") and p["used"].get("dress") != self.day_no():
            items.append(("4-D Dress: produce something", self.dress_menu))
        if self.has("adrenaline") and p["stress"]:
            items.append(("Crisis Adrenaline (1d6 Favor)", self.adrenaline))
        if p["items"].get("lantern") or p["items"].get("candle"):
            items.append(("Look at your light", lambda: self.say(
                "Your %s burns steadily." % ("lantern" if p["items"].get(
                    "lantern") else "candle"), "info")))
        if not items:
            self.say("You've nothing to use just now.", "info")
            return
        items.append(("Never mind", lambda: None))
        self.open_menu("Use what?", items)

    def eat_cake(self):
        self.take_item("practice cake")
        n = self.lose_stress(roll("1d6"))
        self.say("Not bad at all. (-%d Stress)" % n, "good")

    def craft(self, thing, need, attr, n=1):
        for k in need:
            self.take_item(k, n if k == "photo" else 1)
        self.say("You sit down to make the %s." % thing, "info")
        self.pass_time(60 if thing in ("kite", "scrapbook") else 120,
                       quiet=True)
        ok = self.check(attr, 6, "making the " + thing)
        good = ok and self.last_roll >= 12
        self.give_item(thing)
        self.p["present"] = {"item": thing, "bonus": 1 if good else 0 if ok
                             else -1}
        self.say("%s. It's your present for the Master." % (
            "It's beautiful" if good else "It'll do" if ok else
            "It's... homemade"), "good" if ok else "bad")
        self.render()

    def choose_present(self, thing):
        self.p["present"] = {"item": thing, "bonus": 1 if thing in (
            "mended music box", "letter") else 0}
        self.say("The %s will be your present for the Master." % thing,
                 "good")

    def wrap_present(self):
        self.take_item("ribbon")
        self.p["present"]["wrapped"] = True
        self.say("You wrap it in paper and tie the ribbon in a bow.", "good")

    def mend(self):
        if self.check("Skill", 6, "mending"):
            for k, v in self.p["dress"].items():
                if v == "torn":
                    self.p["dress"][k] = "ok"
            self.take_item("sewing kit")
            self.say("Neat little stitches. Good as new.", "good")
        self.pass_time(20, quiet=True)

    def set_trap(self):
        p = self.p
        if p["items"].get("bell") and not self.has("trap"):
            self.take_item("bell")
        self.st["trap"] = self.area.site
        self.say("You set a trap in %s: a bell on a thread across the "
                 "dark." % self.area.name, "good")

    def warm_egg(self):
        if "egg_warm" in self.flags:
            self.say("The egg is warm. Something inside it is moving.",
                     "info")
            return
        if self.area.site in ("kitchen", "library", "parlour") or \
                self.area.kind == "inside" and any(
                    self.area.grid[y][x] in ("stove", "fireplace")
                    for x, y in [(self.pos[0] + dx, self.pos[1] + dy)
                                 for dx, dy in DIRS]
                    if self.area.inside(x, y)):
            self.flags.add("egg_warm")
            self.st["egg_day"] = self.day_no()
            self.say("You tuck the egg in by the fire, wrapped in a tea "
                     "towel. It shivers.", "good")
        else:
            self.say("It needs somewhere properly warm: by a stove or a "
                     "fire.", "info")

    def teleport_menu(self):
        self.open_menu("Teleport where?", [
            (cap(SITES[s][0]), lambda s=s: self.go_to_site(s))
            for s in SITES])

    def go_to_site(self, sid):
        if self.p.get("companion"):
            self.dismiss()
        self.city_pos = list(self.door_of(sid))
        self.cache.pop(("bld", sid), None)
        area = self.get_area(("bld", sid))
        self.enter(area, area.start)
        self.say("You're in %s." % area.name, "info")

    def saw_it(self):
        self.p["used"]["saw_it"] = self.day_no()
        unseen = [i for i in range(len(self.world["tells"]))
                  if i not in self.tells]
        if not unseen or "phantom_caught" in self.flags:
            self.say("You saw... nothing much, today.", "info")
            return
        self.found_tell(random.choice(unseen), "You saw it, didn't you? "
                        "Yes. You definitely saw it")

    def dress_menu(self):
        def make(k):
            self.p["used"]["dress"] = self.day_no()
            self.give_item(k)
            self.say("You reach into your apron and pull out %s. Don't ask "
                     "how. (4-D Dress)" % an(k), "good")
        self.open_menu("Produce what?", [(cap(k), lambda k=k: make(k))
                                         for k in ("flour", "sugar",
                                                   "butter", "eggs",
                                                   "cream", "sewing kit",
                                                   "candle", "ribbon",
                                                   "bell")])

    def adrenaline(self):
        n = roll("1d6")
        self.lose_favor(n, "Crisis Adrenaline.")
        d = random.randint(1, 6) * self.attr("Athletics")
        self.say("You shake it off. (-%d Stress)" % self.lose_stress(d),
                 "good")

    # ── Favor ──

    def favor_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        if p["stress"] and p["favor"]:
            n = min(p["stress"], p["favor"])
            items.append(("Shed %d Stress (%d Favor)" % (n, n),
                          lambda: self.buy_calm(n)))
            if n > 5:
                items.append(("Shed 5 Stress (5 Favor)",
                              lambda: self.buy_calm(5)))
        if not p["boost"]:
            items.append(("Try harder: +1 to your next die (1d6 Favor)",
                          self.buy_boost))
        for a in ATTRS:
            cost = (p["attrs"][a] + 1) * 10
            if p["favor"] >= cost:
                items.append(("Raise %s to %d (%d Favor)" % (
                    a, p["attrs"][a] + 1, cost),
                    lambda a=a, c=cost: self.raise_attr(a, c)))
        if self.world["spare_events"] and self.day_no() < 6:
            items.append(("Make something happen: a Random Event (1d6 "
                          "Favor)", self.buy_event))
        if self.has("gaze") and self.near_master():
            items.append(("Passionate Gaze (1d6 Stress, 1d3 Favor)",
                          self.gaze))
        items.append(("Never mind", lambda: None))
        self.open_menu("Favor: %d" % p["favor"], items)

    def buy_calm(self, n):
        self.p["favor"] -= n
        self.lose_stress(n)
        self.say("You remember the Master's smile, and feel better. (-%d "
                 "Stress, -%d Favor)" % (n, n), "good")
        self.render()

    def buy_boost(self):
        n = roll("1d6")
        self.p["boost"] = 1
        self.lose_favor(n, "You'll try your very hardest.")

    def raise_attr(self, a, cost):
        self.p["favor"] -= cost
        self.p["attrs"][a] += 1
        self.say("Your %s rises to %d. (-%d Favor)" % (
            a, self.p["attrs"][a], cost), "good")
        self.render()

    def buy_event(self):
        n = roll("1d6")
        self.lose_favor(n, "You wish something would happen.")
        eid = self.world["spare_events"].pop(0)
        self.random_event(eid)

    def near_master(self):
        return any(m.role == "master" and abs(m.x - self.pos[0]) +
                   abs(m.y - self.pos[1]) <= 3 for m in self.area.mobs)

    def gaze(self):
        if self.p["used"].get("gaze") == self.turn // 60:
            self.say("You've gazed enough for one hour.", "info")
            return
        self.p["used"]["gaze"] = self.turn // 60
        self.gain_stress(roll("1d6"), quiet=True)
        self.gain_favor(roll("1d3"), "You catch the Master's eye, and hold "
                        "it. The Master blushes.")

    # ── Searching ──

    def search(self):
        if not self.ready():
            return
        a = self.area
        x, y = self.pos
        self.pass_time(10, quiet=True)
        spots = [(x + dx, y + dy) for dx, dy in DIRS + ((0, 0),)]
        found = [s for s in spots if s in a.hidden]
        clue = next((s for s in spots if a.items.get(s) == "clue"), None)
        if clue:
            self.examine(*clue)
        elif found and self.check("Cunning", 6, "searching"):
            for s in found:
                thing = a.hidden.pop(s)
                if thing == "coins":
                    n = roll("1d6")
                    self.p["coins"] += n
                    self.say("Coins, down the back of something. (+%d)" % n,
                             "gold")
                else:
                    self.give_item(thing)
                    self.say("You find %s." % an(thing), "gold")
        else:
            self.say("You look around carefully. Nothing.", "info")
        self.end_turn()

    def examine(self, x, y):
        """A clue where the Phantom struck, or a note below."""
        a = self.area
        n = getattr(a, "scene", None)
        if a.kind == "dungeon":
            self.say(fill(getattr(a, "note", "A scrap of paper."),
                          self.world), "talk")
            del a.items[(x, y)]
            return
        if n is None:
            del a.items[(x, y)]
            return
        if self.check("Cunning", 6, "looking for clues"):
            del a.items[(x, y)]
            self.flags.add("examined:%d" % n)
            self.found_tell(n, "Where the Phantom was, you find")
        else:
            self.say("There's something here, if only you could see it. "
                     "Search again.", "info")

    def found_tell(self, i, how):
        if i in self.tells or i >= len(self.world["tells"]):
            return
        self.tells.append(i)
        text, _ = self.world["tells"][i]
        self.say("%s %s. (A clue: J lists them.)" % (how, text), "quest")
        self.sound.play("gold")

    def step_on(self, x, y):
        a = self.area
        thing = a.items.get((x, y))
        if thing == "dustpile":
            self.sweep(x, y)
            return True
        if thing == "clue":
            self.examine(x, y)
            return True
        if thing == "chest":
            self.loot_chest(x, y)
            return True
        if thing == "coins":
            del a.items[(x, y)]
            n = roll("2d6")
            self.p["coins"] += n
            self.say("Coins! (+%d)" % n, "gold")
            return True
        if thing == "egg":
            del a.items[(x, y)]
            self.give_item("egg")
            self.say("You pick up the egg. It's enormous, and warm, and "
                     "something inside it taps back.", "good")
            return True
        if thing == "parcel":
            del a.items[(x, y)]
            self.parcel()
            return True
        return False

    def loot_chest(self, x, y):
        a = self.area
        body = a.bodies.pop((x, y), {"things": []})
        del a.items[(x, y)]
        things = body["things"]
        self.say("An old chest. Inside...", "info")
        for t in things:
            if t == "monogram":
                self.flags.add("stash_clue")
                self.monogram()
                self.found_tell(len(self.world["tells"]) - 1, "In the "
                                "Phantom's hiding place there's")
                continue
            self.give_item(t)
            self.say("...%s!" % ITEMS[t][0].split(":")[1].strip(), "gold")
            if t in STOLEN:
                self.flags.add("found:" + t)
            if t == "music box":
                self.learn("music")
        self.sound.play("gold")

    def monogram(self):
        """The clue in the Phantom's hiding place: an initial."""
        w = self.world
        initial = w["people"][w["phantom"]]["first"][0]
        fits = [r for r in SUSPECTS if w["people"][r]["first"][0] == initial]
        w["tells"].append(("a handkerchief embroidered with the letter %s" %
                           initial, fits))

    def open_loot(self, x, y):
        a = self.area
        if (x, y) not in a.loot:
            self.say("Empty.", "info")
            return
        a.loot.discard((x, y))
        a.grid[y][x] = "crate_open"
        self.flags.add("loot:%s:%d:%d:%d" % (a.key[1], a.key[2], x, y))
        r = random.random()
        if r < 0.35:
            n = roll("1d6")
            self.p["coins"] += n
            self.say("An old trunk: a few coins in a sock. (+%d)" % n,
                     "gold")
        elif r < 0.6:
            self.give_item("photo")
            self.say("An old trunk: photographs of Larkspur, long ago. You "
                     "keep one.", "gold")
        elif r < 0.8:
            self.give_item("candle")
            self.say("An old trunk: candles.", "gold")
        else:
            self.say("An old trunk: moth-eaten curtains. A moth flies out "
                     "and looks at you.", "info")

    # ── Clues ──

    def learn(self, cid, quiet=False):
        if cid in self.clues:
            return
        self.clues.append(cid)
        if not quiet:
            self.say("(Your journal has a new entry. J reads it.)", "quest")
            self.sound.play("gold")

    def hear(self, text):
        """Words in CAPITALS: things to ask about."""
        words = re.findall(r"\b[A-Z][A-Z']{2,}\b", text)
        self.heard = [re.sub(r"'S?$", "", w) for w in words
                      if w not in ("BYE", "HI", "ME", "YOU", "AWAY", "ALL",
                                   "THE", "AND") and
                      not re.fullmatch(r"[IVXLC]+", w)]

    # ── Talking ──

    def speaker(self, mob):
        if mob.role == "master":
            return "The Master"
        return cap(mob.name) if mob.known or mob.role in (
            "headmaid", "butler", "dowager", "grocer") or mob.kind or \
            mob.event else cap(mob.title)

    def npc_say(self, mob, text):
        text = fill(text, self.world)
        self.say("%s: %s" % (self.speaker(mob), text), "talk")
        self.hear(text)


    def start_talk(self, mob):
        p = self.p
        if mob.event and self.event_talk(mob):
            return
        if p["exploding"] in ("crying",):
            self.npc_say(mob, "There, there.")
            return
        if mob.role == "master" and not p["exploding"] and self.serve(mob):
            self.end_turn()
            return
        if mob.role == "dowager" and self.serve_dowager(mob):
            return
        if mob.role == "headmaid" and self.active_event("vase"):
            self.vase_talk(mob)
            return
        self.talk = {"mob": mob, "mode": "kw"}
        self.heard = []
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Ask about:")
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        self.say("You talk to %s." % (self.the(mob) if mob.kind else
                                      "the Master" if mob.role == "master"
                                      else mob.title), "info")
        if self.quality("Shy") and "met:%s" % mob.role not in self.flags:
            self.flags.add("met:%s" % mob.role)
            self.say("You're too shy to say anything at all, the first "
                     "time. You curtsey, and go pink.", "info")
        self.flags.add("met:%s" % mob.role)
        e = mob.errand
        greet = mob.greet
        if mob.role == "master":
            greet = random.choice(("Oh, hello.", "Yes?",
                                   "Is it time for something?"))
        if mob.role in MAIDS:
            greet = random.choice(("Hello, you.", "Busy?", "What?")) if \
                mob.role not in p["trust"] else random.choice((
                    "Oh, it's you! Hello!", "Hi! How's it going?"))
        if e is not None and self.side.get(e["id"], {}).get("state") == \
                "active":
            greet = "Did you... any luck?"
        self.npc_say(mob, greet)
        self.hand_back(mob)
        if e is not None and self.errand_ready(e):
            self.finish_errand(mob, e)
        if "talked" not in self.flags:
            self.flags.add("talked")
            self.say("(Choose what to ask about, or type a word such as "
                     "NAME, JOB or NEWS and press Return. BYE, or an empty "
                     "line, ends the conversation.)", "info")
        self.talk_menu()

    def hand_back(self, mob):
        """Give back what the Phantom took, to whoever it belongs to."""
        p = self.p
        owners = {"recipe book": ("cook",), "spoons": ("butler",),
                  "slippers": ("master", "butler"),
                  "portrait": ("butler", "master", "headmaid"),
                  "the Larkspur Star": ("master", "butler", "headmaid")}
        for t, who in owners.items():
            if p["items"].get(t) and mob.role in who and \
                    "back:" + t not in self.flags:
                if any(e["thing"] == t and e["giver"] == mob.role and
                       self.side.get(e["id"], {}).get("state") == "active"
                       for e in self.world["errands"]):
                    continue
                self.take_item(t)
                self.flags.add("back:" + t)
                self.say("You give back %s." % ("the " + t if not
                                                t.startswith("the") else t),
                         "good")
                self.npc_say(mob, "You found it! Oh, well done!")
                self.gain_favor(roll(FAVOR["mission"]), "Something lost is "
                                "found.")
                self.trusted(mob.role)

    def talk_menu(self):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        p = self.p
        if t["mode"] == "buy":
            items = [("%d) %s%s" % (i, label, ", %d" % price
                                    if price else ""),
                      lambda i=i: self.choose_words(str(i)))
                     for i, (label, price, _) in enumerate(self.offers(mob),
                                                           1)]
            items.append(("Nothing, thanks", lambda: self.choose_words("")))
            self.open_menu("Buy what? (you have %d)" % p["coins"], items,
                           lambda: self.choose_words(""))
            return
        if t["mode"] == "confront":
            self.confront_menu(mob)
            return
        words = ["NAME", "JOB", "NEWS"]
        if mob.shop:
            words.append("BUY")
        if mob.errand is not None and self.side.get(
                mob.errand["id"], {}).get("state") != "done":
            words.append("HELP")
        words.append("PHANTOM")
        if self.can_accuse(mob):
            words.append("ACCUSE")
        if mob.role == "master":
            words += ["WISH", "COME" if not mob.ally else "STAY"]
            if self.has("gaze"):
                words.append("GAZE")
        else:
            words += ["CAKE", "WISH"]
        if mob.role in ("butler", "cook", "gardener", "tutor") and \
                "photo:" + mob.role not in self.flags:
            words.append("MEMORY")
        if mob.role == "butler" and p["items"].get("music box"):
            words.append("MEND")
        if mob.role == "butler" and not p["items"].get("lantern"):
            words.append("LANTERN")
        if mob.role in MAIDS and self.has("friendship") and \
                mob.role not in p["trust"]:
            words.append("FRIEND")
        if self.has("tears"):
            words.append("PLEASE")
        for w in getattr(self, "heard", []):
            if w not in words and w != "BYE":
                words.append(w)
        self.open_menu("Ask %s about:" % self.speaker(mob),
                       [(w, lambda w=w: self.choose_words(w))
                        for w in words + ["BYE"]],
                       lambda: self.choose_words("bye"))

    def choose_words(self, w):
        self.say("> " + (w or "nothing"), "you")
        self.converse(w.lower())
        self.talk_menu()

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if getattr(self, "p", None) and getattr(self, "area", None):
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if not self.talk:
            return
        self.menu = None
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())
        self.talk_menu()


    def converse(self, w):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        p = self.p
        world = self.world
        if t["mode"] == "buy":
            t["mode"] = "kw"
            if w.isdigit():
                self.buy(mob, int(w))
                return
            if not w:
                self.npc_say(mob, "Anything else?")
                return
        if t["mode"] == "confront":
            return
        if not w or w.startswith("bye"):
            self.npc_say(mob, random.choice(BYES) if mob.role != "master"
                         else "See you later.")
            self.end_talk()
            return
        if p["exploding"] == "complaining":
            self.say("You complain about everything instead.", "mad")
            self.npc_say(mob, "...Right. Yes. I see.")
            return
        word = re.sub(r"'s?$", "", w.split()[0])
        if word.startswith("name"):
            mob.known = True
            if mob.role == "master":
                self.npc_say(mob, "You know who I am. I'm %s. I'm %s on "
                             "Sunday. Don't tell anyone." % (
                                 world["people"]["master"]["name"],
                                 world["master"]["age"]))
            else:
                self.npc_say(mob, "%s, %s." % (mob.name, mob.title)
                             if mob.role else "I'm %s." % mob.name)
            return
        if word[:4] in ("help", "erra", "favo", "task", "need") and \
                mob.errand is not None:
            self.errand(mob)
            return
        if mob.shop == "van" and word[:3] in ("buy", "pur", "sho", "sel"):
            self.list_offers(mob)
            return
        if word[:4] in ("phan", "thie", "stol", "card", "accu", "cul"):
            self.ask_phantom(mob, word[:4] == "accu")
            return
        if mob.role == "master":
            if self.master_words(mob, word):
                return
        if word[:4] in ("memo", "phot") and mob.role in ROLE_TALK and \
                "memo" in mob.talk:
            self.reply(mob, mob.talk["memo"])
            return
        if word[:4] == "mend" and mob.role == "butler":
            if p["items"].get("music box"):
                self.take_item("music box")
                self.give_item("mended music box")
                self.pass_time(30, quiet=True)
                self.npc_say(mob, "The Mistress's music box... A spring, "
                             "and a little oil. There. Listen.")
                self.say("It plays a lullaby, very sweetly. It's the best "
                         "present you could imagine.", "good")
                if p["present"] and p["present"]["item"] == "music box":
                    p["present"] = None
            else:
                self.npc_say(mob, "Mend what, miss?")
            return
        if word[:4] == "lant" and mob.role == "butler":
            if not p["items"].get("lantern"):
                self.give_item("lantern")
                self.npc_say(mob, "Here you are, miss. Keep it trimmed.")
            else:
                self.npc_say(mob, "You've got one, miss.")
            return
        if word[:4] in ("ingr", "flou", "suga", "butt") and \
                mob.role == "cook":
            key = "ingr:%d" % self.day_no()
            if key in self.flags:
                self.npc_say(mob, "I gave you some this morning! What did "
                             "you DO with it?")
                return
            self.flags.add(key)
            for k in ("flour", "sugar", "butter"):
                self.give_item(k)
            self.npc_say(mob, "Flour, sugar, butter. Don't waste them.")
            return
        if word[:4] in ("frie",) and self.has("friendship") and \
                mob.role in MAIDS:
            self.gain_stress(roll("1d6"), "You take some of her troubles "
                             "on yourself.")
            self.st["rstress"][mob.role] = 0
            self.trusted(mob.role)
            self.npc_say(mob, "You'd do that? For me? ...Friends, then.")
            return
        if word[:4] == "plea" and self.has("tears"):
            self.maidens_tears(mob)
            return
        if word[:4] == "lett" and mob.role == "grocer":
            self.errand_deliver(mob)
            return
        if word[:4] in ("come", "foll", "walk") and mob.role == "master":
            self.invite(mob)
            return
        reply = next((v for k, v in mob.talk.items()
                      if k[:4] == word[:4] or (len(k) < 4 and
                                               word.startswith(k))), None)
        if reply is None and word[:4] in ("heal", "how'", "how"):
            reply = random.choice(HEALTH)
        if reply is None and word[:4] in ("cake", "wish", "flav") and \
                mob.role in MAIDS:
            reply = MAID_TALK.get("cake") if word.startswith("cake") else \
                "I wish I knew. The Master never says what {master_he} " \
                "wants."
        if reply is None and not mob.kind:
            reply = next((v for k, v in TOPICS.items()
                          if word.startswith(k)), None)
        if reply is None:
            reply = random.choice(("I don't know anything about that.",
                                   "What?", "Couldn't say, I'm sure."))
        self.reply(mob, reply)
        if word[:4] == "news" and mob.role in world["witness"]:
            self.found_tell(world["witness"][mob.role], "%s saw" %
                            mob.name)
        if word[:4] == "flav" and "know:flavour" in self.flags:
            self.learn("flavour")
        if word[:4] == "wish" and "know:wish" in self.flags:
            self.learn("wish")
        if word[:4] == "cake":
            self.learn("cake", quiet=True)
        if word[:4] == "pres":
            self.learn("present", quiet=True)
        self.render_chrome()

    def master_words(self, mob, word):
        """What only the Master answers."""
        w = self.world
        if word[:4] in ("wish", "pres", "birt", "want"):
            key = "askwish:%d" % self.day_no()
            if "know:wish" in self.flags:
                self.npc_say(mob, "I told you. I'd like %s. But it's silly." %
                             fill(WISHES[w["wish"]][1], w))
                return True
            if key in self.flags:
                self.npc_say(mob, "I don't want anything. Honestly.")
                return True
            self.flags.add(key)
            if self.check("Affection", 8, "asking what the Master wishes "
                          "for"):
                self.npc_say(mob, "Promise you won't laugh? I'd like %s." %
                             fill(WISHES[w["wish"]][1], w))
                self.flags.add("know:wish")
                self.learn("wish")
            else:
                self.npc_say(mob, "Nothing. I don't want a fuss.")
            return True
        if word[:4] in ("flav", "cake", "favo"):
            if self.check("Affection", 6, "asking about cake"):
                self.npc_say(mob, "Cake? %s, of course. Is there any other "
                             "kind?" % cap(w["flavour"]))
                self.flags.add("know:flavour")
                self.learn("flavour")
            else:
                self.npc_say(mob, "Any cake's nice. I don't mind.")
            return True
        if word[:4] in ("stay", "wait") and mob.ally:
            self.dismiss()
            self.npc_say(mob, "All right. Thank you for the walk.")
            self.end_talk()
            return True
        if word[:4] == "gaze" and self.has("gaze"):
            self.end_talk()
            self.gaze()
            return True
        if word[:4] in ("pare", "moth", "fath", "lone"):
            self.npc_say(mob, "They're abroad. They write. Sometimes. It's "
                         "a big house when it's just you and the maids.")
            return True
        if word[:4] in ("dowa", "aunt"):
            self.npc_say(mob, "Great-Aunt %s is coming on my birthday to "
                         "see if Larkspur's fit to keep. I don't want to "
                         "live with her in Bath. I want to live HERE." %
                         w["people"]["dowager"]["short"].replace("Lady ",
                                                                 ""))
            return True
        if word[:4] == "phan":
            return False
        if word[:4] == "job":
            self.npc_say(mob, "I'm the Master. It isn't a job, it's a... I "
                         "don't know what it is.")
            return True
        return False

    def reply(self, mob, r):
        """Say a reply: words, or a dict that may roll, give things, teach
        clues and win trust."""
        if isinstance(r, str):
            self.npc_say(mob, r)
            return
        if "check" in r:
            flag = r.get("flag")
            if flag and flag in self.flags:
                self.npc_say(mob, r["ok"] if flag.startswith("know:") else
                             "I've already done what I can for you.")
                return
            tried = "tried:%s:%s:%d" % (mob.role, flag, self.day_no())
            if tried in self.flags:
                self.npc_say(mob, r["fail"])
                return
            a, diff = r["check"]
            if mob.role in self.p["trust"]:
                diff -= 2
            if flag and flag.startswith("gave:") and \
                    self.side.get("geese", {}).get("state") == "done":
                diff = 0
            if self.check(a, diff, "persuading"):
                self.npc_say(mob, r["ok"])
                if flag and not flag.startswith("gave:"):
                    self.flags.add(flag)
                elif flag:
                    self.flags.add(tried)
                if r.get("give"):
                    self.give_item(r["give"])
                    self.say("You get the %s." % r["give"], "gold")
                    self.sound.play("gold")
            else:
                self.flags.add(tried)
                self.npc_say(mob, r["fail"])
            return
        self.npc_say(mob, r["say"])
        if r.get("learn"):
            self.learn(r["learn"])

    def maidens_tears(self, mob):
        self.gain_stress(roll("2d6"), "Your eyes fill with tears.")
        self.end_talk()
        if mob.role == self.world["phantom"] and \
                "phantom_caught" not in self.flags:
            self.npc_say(mob, "Oh, don't cry! Don't! ...All right. It was "
                         "me.")
            self.confess(mob)
        elif mob.role == "master":
            self.npc_say(mob, "Don't cry! I'll tell you anything. I wish "
                         "for %s." % fill(WISHES[self.world["wish"]][1],
                                          self.world))
            self.flags.add("know:wish")
            self.learn("wish")
        elif mob.role in MAIDS:
            self.trusted(mob.role)
            self.npc_say(mob, "Oh, don't! Of course I'll help you. With "
                         "anything.")
        else:
            self.npc_say(mob, "There, there. What is it you want?")
            self.trusted(mob.role)

    def trusted(self, role):
        p = self.p
        if role and role not in p["trust"] and role in self.world["people"]:
            p["trust"].append(role)
            self.say("%s likes you now." % self.world["people"][role][
                "name"], "good")

    # ── The Phantom ──

    def fits(self, role):
        """How many of the clues you've found point at someone."""
        return sum(role in self.world["tells"][i][1] for i in self.tells)

    def can_accuse(self, mob):
        return mob.role in SUSPECTS and "phantom_caught" not in self.flags \
            and self.fits(mob.role) >= 2 and \
            "accused:%s" % mob.role not in self.flags

    def ask_phantom(self, mob, accuse=False):
        w = self.world
        if "phantom_caught" in self.flags:
            self.npc_say(mob, "The Phantom's been caught! %s, of all "
                         "people." % w["people"][w["phantom"]]["name"])
            return
        if accuse and self.can_accuse(mob):
            self.accuse(mob)
            return
        if accuse:
            self.npc_say(mob, "Accuse me? On what evidence?" if mob.role in
                         SUSPECTS else "Accuse ME? Don't be absurd.")
            return
        if self.has("lie") and mob.role in SUSPECTS:
            self.gain_stress(1, quiet=True)
            self.npc_say(mob, "The Phantom? I don't know anything about it.")
            if mob.role == w["phantom"]:
                self.say("You can always tell. That was a lie. (Lie "
                         "Detector)", "quest")
                self.flags.add("lie:" + mob.role)
            else:
                self.say("You can always tell. That was the truth. (Lie "
                         "Detector)", "info")
            return
        if mob.role == w["phantom"]:
            self.npc_say(mob, random.choice((
                "The Phantom? How should I know?",
                "Isn't it awful? Whoever could it be?",
                "I was asleep! All night! Every night!")))
            return
        self.reply(mob, mob.talk.get("phan") or TOPICS["phan"])
        if mob.role in w["witness"]:
            self.found_tell(w["witness"][mob.role], "%s saw" % mob.name)

    def accuse(self, mob):
        w = self.world
        if mob.role != w["phantom"]:
            self.flags.add("accused:%s" % mob.role)
            self.npc_say(mob, random.choice((
                "ME? How dare you! I've never been so insulted!",
                "The Phantom? Me? You've got it all wrong.",
                "I can't believe you'd think that of me.")))
            if mob.role in self.p["trust"]:
                self.p["trust"].remove(mob.role)
            self.gain_stress(roll("1d6"), "You were wrong.")
            self.lose_favor(roll("1d6"), "Word gets round.")
            return
        self.npc_say(mob, "...I don't know what you mean.")
        self.say("You lay it all out. %s goes pale. (A confrontation: wear "
                 "%s down.)" % (mob.name, fill("{phantom_him}", w)), "quest")
        self.talk["mode"] = "confront"
        self.st["conf"] = 0

    def confront_menu(self, mob):
        items = [("Lay out the evidence (Cunning)",
                  lambda: self.confront(mob, "Cunning")),
                 ("Appeal to %s better nature (Affection)" % fill(
                     "{phantom_his}", self.world),
                  lambda: self.confront(mob, "Affection")),
                 ("Stare %s down (Will)" % fill("{phantom_him}", self.world),
                  lambda: self.confront(mob, "Will"))]
        if self.has("retort") and "retort" not in self.st.get("conf_used",
                                                              []):
            items.append(("Ultimate Retort (2 Stress)",
                          lambda: self.confront(mob, "retort")))
        items.append(("Back off, for now", self.back_off))
        self.open_menu("Confronting %s (%d Stress of %d)" % (
            mob.name, self.st.get("conf", 0), self.phantom_spirit()),
            items, self.back_off)

    def back_off(self):
        self.flags.discard("accused:%s" % self.world["phantom"])
        self.say("You let it go, for now.", "info")
        self.end_talk()

    def phantom_attr(self, a):
        ph = self.world["phantom"]
        if ph in MAIDS:
            return max(1, self.world["maids"][ph]["attrs"][a])
        return 3

    def phantom_spirit(self):
        return max(4, 14 - 2 * self.fits(self.world["phantom"]))

    def confront(self, mob, way):
        if way == "retort":
            self.st.setdefault("conf_used", []).append("retort")
            self.gain_stress(2, quiet=True)
            self.say("You deliver the perfect retort. There's no answer to "
                     "it. (Ultimate Retort)", "good")
            self.st["conf"] = self.phantom_spirit() + 1
        else:
            v = self.attr(way)
            d, why = self.die()
            mine = d * v
            ta = self.phantom_attr(way)
            theirs = random.randint(1, 6) * ta
            self.say("[%s %d x (%s) = %d vs %s %d x d6 = %d]" % (
                way, v, ", ".join(why), mine, way, ta, theirs), "roll")
            if mine > theirs:
                n = mine // ta
                if self.has("mockery"):
                    n += 2
                self.st["conf"] += n
                self.npc_say(mob, random.choice((
                    "That... that proves nothing!", "I... you can't...",
                    "Stop LOOKING at me like that!")))
            elif theirs > mine:
                n = theirs // v if v else theirs
                self.npc_say(mob, random.choice((
                    "You're making a fool of yourself, you know.",
                    "Everyone's going to laugh at you.",
                    "Prove it. Go on.")))
                self.gain_stress(n, quiet=True)
                self.say("(+%d Stress)" % n, "mad")
            else:
                self.npc_say(mob, "...")
        if self.st["conf"] > self.phantom_spirit():
            self.confess(mob)
            self.end_talk()

    def confess(self, mob):
        w = self.world
        ph = w["phantom"]
        self.flags.add("phantom_caught")
        kind = "maid" if ph in MAIDS else ph
        self.npc_say(mob, "All right! ALL RIGHT. It was me. I'm the "
                     "Phantom.")
        self.npc_say(mob, MOTIVES[kind])
        self.say(fill("{phantom_full} was the Phantom of Larkspur!", w),
                 "quest")
        self.sound.play("quest")
        self.learn("unmasked")
        for t in STOLEN:
            if "taken:" + t in self.flags and "back:" + t not in self.flags \
                    and not self.p["items"].get(t):
                self.flags.add("back:" + t)
        self.gain_favor(roll(FAVOR["big_mission"]), "Everything the "
                        "Phantom took goes back where it belongs.")
        if ph in self.p["trust"]:
            self.p["trust"].remove(ph)
        if ph in MAIDS:
            n = roll("3d6")
            self.st["rival"][ph] -= n
            self.say("%s loses a great deal of Favor. (-%d)" % (
                w["people"][ph]["name"], n), "info")

    # ── Walks with the Master ──

    def invite(self, mob):
        p = self.p
        if mob.ally:
            self.npc_say(mob, "I'm right here.")
            return
        if not self.chore_open("walk"):
            self.npc_say(mob, "A walk? Not now. Half past four's walk "
                         "time.")
            return
        p["companion"] = "master"
        mob.ally = True
        self.npc_say(mob, random.choice(("A walk? Yes, please.",
                                         "All right. Where shall we go?")))
        self.say("The Master comes with you. Take the Master somewhere "
                 "nice in the grounds: the fountain, the pond, the "
                 "flowers.", "good")
        self.end_talk()

    def ally_act(self, mob):
        a = self.area
        px, py = self.pos
        if mob.role == "master" and a.kind == "city":
            self.walk_moment(mob)
        for sx, sy in sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                             abs(py - mob.y - d[1])):
            if abs(px - mob.x) + abs(py - mob.y) <= 1:
                break
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break

    def walk_moment(self, mob):
        """A nice spot, the two of you: a moment."""
        a = self.area
        if not self.chore_open("walk"):
            if self.clock() >= self.CHORES["walk"][2]:
                self.say("The Master yawns. 'I'd better go in.'", "info")
                self.dismiss()
            return
        nice = {"fountain", "pond", "flowers", "bench", "statue"}
        if not any(a.inside(self.pos[0] + dx, self.pos[1] + dy) and
                   a.grid[self.pos[1] + dy][self.pos[0] + dx] in nice
                   for dx in (-1, 0, 1) for dy in (-1, 0, 1)):
            return
        p = self.p
        self.st["chores"][self.chore_key("walk")] = "you"
        self.flash(mob.x, mob.y, "heart")
        ok = self.check("Affection", 6, "a moment with the Master")
        if not ok and self.has("world"):
            self.gain_stress(roll("1d6"), "(World for Two)")
            ok = self.check("Affection", 6, "a world for two")
        if ok:
            p["moments"] += 1
            self.st["mood"] += 2
            self.npc_say(mob, random.choice((
                "It's nice out here. I don't come out enough.",
                "My father and I used to sit here. I'd forgotten.",
                "Thank you. I mean it. This is nice.")))
            self.gain_favor(roll(FAVOR["moment"]), "A lovely moment.")
        else:
            self.npc_say(mob, "Hm. It's a bit cold. Let's go in.")
        self.dismiss()

    def place_companion(self):
        role = self.p.get("companion")
        a = self.area
        for m in list(a.mobs):
            if m.ally and m.role != role:
                m.ally = False
                if m.visitor:
                    a.mobs.remove(m)
        if not role:
            return
        for m in a.mobs:
            if m.role == role:
                m.ally = True
                return
        x, y = self.pos
        for dx, dy in DIRS:
            nx, ny = x + dx, y + dy
            if a.inside(nx, ny) and not a.mob_at(nx, ny) and \
                    a.grid[ny][nx] in (CITY_GROUND | INSIDE_FLOOR |
                                       {"dfloor"}) and \
                    (nx, ny) not in a.links:
                m = make_person(self.world, role, nx, ny)
                m.ally = m.visitor = True
                a.mobs.append(m)
                return

    def dismiss(self):
        role = self.p["companion"]
        self.p["companion"] = None
        for m in list(self.area.mobs):
            if m.role == role and m.ally:
                m.ally = False
                if m.visitor or self.where(role) != (
                        self.area.site if self.area.kind == "inside" else
                        "garden"):
                    self.area.mobs.remove(m)

    # ── The grocer ──

    def offers(self, mob):
        """(label, price, what happens) for what someone will sell you."""
        o = []

        def give(item):
            def f():
                self.give_item(item)
                self.say("You get %s." % ITEMS[item][0].split(":")[1].strip(),
                         "gold")
            return f
        if mob.shop == "van":
            for n, (desc, price) in ITEMS.items():
                if price is not None:
                    o.append((cap(desc.split(":")[0]), price, give(n)))
        return o

    def list_offers(self, mob):
        if self.closed(mob):
            self.npc_say(mob, "We're closed!")
            return
        offers = self.offers(mob)
        if not offers:
            self.npc_say(mob, "I've got nothing else you'd want.")
            return
        self.npc_say(mob, "Here's what we've got.")
        self.talk["mode"] = "buy"


    def closed(self, mob):
        return False

    def buy(self, mob, n):
        p = self.p
        offers = self.offers(mob)
        if not 1 <= n <= len(offers):
            self.npc_say(mob, "What's that?")
            return
        label, price, what = offers[n - 1]
        if price > p["coins"]:
            self.npc_say(mob, "That's %d. You've got %d." % (price,
                                                            p["coins"]))
            return
        p["coins"] -= price
        what()
        self.sound.play("gold")
        self.render_chrome()

    # ── Errands ──

    def give_errand(self, mob):
        for e in self.world["errands"]:
            if e["giver"] == mob.role:
                mob.errand = e


    def errand(self, mob):
        e = mob.errand
        st = self.side.get(e["id"])
        if st is None:
            self.side[e["id"]] = {"state": "active", "day": self.day_no()}
            if e["kind"] == "deliver":
                self.give_item("post")
            if e["kind"] == "calm":
                self.learn("geese")
            if self.errand_ready(e):
                self.finish_errand(mob, e)
                return
            self.npc_say(mob, e["ask"])
        elif st["state"] == "done":
            self.npc_say(mob, "You've done plenty. Thank you.")
        elif self.errand_ready(e):
            self.finish_errand(mob, e)
        else:
            self.npc_say(mob, e["ask"])

    def errand_ready(self, e):
        st = self.side.get(e["id"], {})
        if st.get("state") != "active":
            return False
        k = e["kind"]
        if k == "fetch":
            return bool(self.p["items"].get(e["thing"]))
        if k == "stolen":
            return bool(self.p["items"].get(e["thing"]))
        if k == "deliver":
            return st.get("delivered", False)
        if k == "chore":
            return "chore:" + e["id"] in self.flags
        if k == "calm":
            return "beat:maze" in self.flags
        return False

    def finish_errand(self, mob, e):
        self.side[e["id"]]["state"] = "done"
        if e["kind"] in ("fetch", "stolen"):
            self.take_item(e["thing"])
        if e["kind"] == "stolen":
            self.flags.add("back:" + e["thing"])
        self.npc_say(mob, e["thanks"])
        if e["pay"]:
            self.p["coins"] += e["pay"]
            self.say("You get %d pocket money." % e["pay"], "gold")
        self.trusted(e["giver"])
        if e["kind"] == "stolen":
            self.gain_favor(roll(FAVOR["mission"]), "Something lost is "
                            "found.")
        self.lose_stress(1)
        self.sound.play("gold")

    def errand_deliver(self, mob):
        if not self.p["items"].get("post"):
            self.npc_say(mob, "Letter? You haven't got one.")
            return
        for e in self.world["errands"]:
            st = self.side.get(e["id"], {})
            if e["kind"] == "deliver" and st.get("state") == "active" and \
                    not st.get("delivered"):
                st["delivered"] = True
                self.take_item("post")
                self.npc_say(mob, "I'll see it goes with the afternoon "
                             "post.")
                return
        self.npc_say(mob, "Hm?")

    # ── Random Events ──

    def active_event(self, eid):
        return eid in self.st["events"]

    def random_event(self, eid):
        w = self.world
        if eid in self.st["events"] or eid in self.st.get("done_events", []):
            return
        title, text = EVENTS[eid]
        self.st["events"].append(eid)
        self.st["event_day"][eid] = self.day_no()
        self.say("RANDOM EVENT: %s" % title, "quest")
        self.say(fill(text, w), "info")
        self.sound.play("quest")
        if eid == "hens":
            self.st["hens_loose"] = 4
            self.st["hens_out"] = 4
            self.st["hens_home"] = 0
        elif eid == "penguin":
            self.st["penguin_site"] = random.choice([s for s in INDOOR_SITES
                                                     if s != "quarters"])
        elif eid == "map":
            self.give_item("map")
            self.flags.add("has_map")
            self.say("You find it yourself, tucked in a book you're "
                     "dusting. The X is at the middle of the maze.", "good")
        elif eid == "egg":
            self.st["egg_spot"] = [36, 30]
        elif eid == "cold":
            self.flags.add("cold:%d" % self.day_no())
            self.say("The Master needs honey and lemon, from the stove, "
                     "and someone to sit with %s." % fill("{master_him}", w),
                     "info")
        elif eid == "fire":
            self.st["fire_until"] = self.turn + 60
        elif eid == "ninjas":
            self.st["ninjas"] = 3
        elif eid == "princess":
            self.st["agents"] = 0
        elif eid == "vase":
            self.say(fill("{headmaid} wants a word with you in her "
                          "office. About the VASE.", w), "bad")
        elif eid == "doll":
            self.st["doll"] = 1
        city = self.cache.get(("city",))
        if city is not None:
            self.event_people(city)
        if self.area.kind == "inside":
            self.event_people(self.area)

    def end_event(self, eid, kind=None):
        if eid not in self.st["events"]:
            return
        self.st["events"].remove(eid)
        self.st.setdefault("done_events", []).append(eid)
        if kind:
            self.gain_favor(roll(FAVOR[kind]), "%s: put right." %
                            EVENTS[eid][0].rstrip("!"))
        self.st["mood"] += 1

    def event_mob(self, area, tile, name, x, y, eid, kind=None):
        if kind:
            m = make_monster(kind, x, y)
        else:
            m = Mob(tile, name, x, y)
        m.event = eid
        if area.inside(x, y) and not area.mob_at(x, y) and \
                [x, y] != getattr(self, "pos", None):
            area.mobs.append(m)
        return m

    def event_people(self, area):
        """The people and things a Random Event brings."""
        st = self.st
        ev = st["events"]
        have = {(m.event, m.kind or m.tile) for m in area.mobs if m.event}
        count = {}
        for m in area.mobs:
            if m.event:
                count[m.kind or m.tile] = count.get(m.kind or m.tile, 0) + 1
        rng = random.Random("%s:%d" % (self.world["seed"], self.turn))
        if area.kind == "city":
            lawn = [(x, y) for y in range(28, 42) for x in range(3, 56)
                    if area.grid[y][x] in ("lawn", "path", "flowers")]
            hall = [(x, y) for y in range(3, 26) for x in range(5, 59)
                    if area.grid[y][x] in ("runner", "marble", "parquet")]
            if "hens" in ev:
                for _ in range(st.get("hens_loose", 0) - count.get("hen",
                                                                   0)):
                    self.event_mob(area, None, None, *rng.choice(lawn),
                                   "hens", "hen")
            if "ninjas" in ev:
                for _ in range(st.get("ninjas", 0) - count.get("ninja", 0)):
                    self.event_mob(area, None, None, *rng.choice(hall),
                                   "ninjas", "ninja")
            if "princess" in ev:
                for _ in range(st.get("agents", 0) - count.get("agent", 0)):
                    self.event_mob(area, None, None, *rng.choice(lawn),
                                   "princess", "agent")
            if "doll" in ev and st.get("doll") and not count.get("doll"):
                self.event_mob(area, None, None, 31, 28, "doll", "doll")
            if "ufo" in ev:
                area.items[(15, 30)] = "saucer"
                if ("ufo", "alien") not in have:
                    m = self.event_mob(area, "alien", "Zib", 16, 29, "ufo")
                    m.title = "a small green person from the stars"
            else:
                if area.items.get((15, 30)) == "saucer":
                    del area.items[(15, 30)]
            if "egg" in ev and "got:egg" not in self.flags and \
                    st.get("egg_spot"):
                area.items[tuple(st["egg_spot"])] = "egg"
            if "ghost" in ev and self.phase() == "night" and \
                    ("ghost", "ghost") not in have:
                m = self.event_mob(area, "ghost", "the Grey Lady", 31, 8,
                                   "ghost")
                m.title = "a lady in grey, a long time dead"
            if "ghost" in ev and self.phase() != "night":
                area.mobs = [m for m in area.mobs if m.event != "ghost"]
            return
        sid = area.site
        if "penguin" in ev and sid == st.get("penguin_site") and \
                "have_penguin" not in self.flags and not count.get(
                    "penguin"):
            spots = [(x, y) for y in range(area.h) for x in range(area.w)
                     if area.grid[y][x] in INSIDE_FLOOR and
                     not area.mob_at(x, y) and (x, y) != area.start]
            if spots:
                self.event_mob(area, None, None, *rng.choice(spots),
                               "penguin", "penguin")
        if sid == "lodge" and "penguin" in ev and \
                ("penguin", "zookeeper") not in have:
            m = self.event_mob(area, "zookeeper", "the zookeeper", 8, 4,
                               "penguin")
            m.title = "a zookeeper, flustered"
        if sid == "lodge" and "princess" in ev and \
                "hid_princess" not in self.flags and \
                ("princess", "princess") not in have:
            m = self.event_mob(area, "princess", "the Princess", 10, 2,
                               "princess")
            m.title = "a princess in a hurry"
        if sid == "ballroom" and "tv" in ev and ("tv", "director") not in \
                have:
            m = self.event_mob(area, "director", "the director", 7, 3, "tv")
            m.title = "a television director, with a megaphone"
        if sid == "kitchen" and "fire" in ev:
            self.say("FIRE! The stove's ablaze! Smoke everywhere!", "bad")

    def event_talk(self, mob):
        """Talking to someone a Random Event brought: True if handled."""
        p = self.p
        e = mob.event
        if e == "penguin":
            if "have_penguin" in self.flags:
                self.flags.discard("have_penguin")
                self.say("The zookeeper: 'Percival! You found him! Oh, you "
                         "marvel.'", "talk")
                self.end_event("penguin", "mission")
            else:
                self.say("The zookeeper: 'A penguin. About so high. Answers "
                         "to Percival. He's in the house somewhere, I just "
                         "know it.'", "talk")
            return True
        if e == "princess":
            if "hid_princess" in self.flags:
                return True
            self.say("The Princess: 'Please! They're after me. Hide me, I "
                     "beg you!'", "talk")
            self.open_menu("Hide the Princess?", [
                ("Hide her in the attic, and deal with her pursuers",
                 lambda: self.hide_princess(mob)),
                ("Not now", lambda: None)])
            return True
        if e == "ufo":
            if p["items"].get("batteries"):
                self.take_item("batteries")
                self.say("Zib: 'Power cells! Primitive but adequate. Many "
                         "thanks, Earth maid.' The saucer hums, lifts, and "
                         "is gone over the trees, trailing sparks.", "talk")
                self.area.mobs = [m for m in self.area.mobs
                                  if m.event != "ufo"]
                self.end_event("ufo", "mission")
                self.lose_stress(roll("1d6"))
            else:
                self.say("Zib: 'Greetings. My craft has expired. I require "
                         "power cells. You call them BATTERIES.'", "talk")
            return True
        if e == "ghost":
            if p["items"].get("locket"):
                self.take_item("locket")
                self.say("The Grey Lady takes the locket, and smiles, and "
                         "is gone. Behind her, a whisper: 'The music box is "
                         "in the tower. My grandchild's child should have "
                         "it.'", "talk")
                self.learn("music")
                self.area.mobs = [m for m in self.area.mobs
                                  if m.event != "ghost"]
                self.end_event("ghost", "mission")
            elif "ghost_locket" in self.flags:
                self.say("The Grey Lady: 'My locket. In the old tunnels. "
                         "Please.'", "talk")
            else:
                self.flags.add("ghost_locket")
                self.say("The Grey Lady, very softly: 'I lost my locket in "
                         "the old tunnels under the house, a hundred years "
                         "ago. Would you find it for me?'", "talk")
                self.gain_stress(1, quiet=True)
            return True
        if e == "tv":
            if "filmed" in self.flags:
                self.say("The director: 'That's a wrap, darling!'", "talk")
                return True
            self.flags.add("filmed")
            self.say("The director: 'Just do what you'd normally do, "
                     "darling, but more so. And... ACTION!'", "talk")
            if self.check("Skill", 8, "being a maid on television"):
                self.say("You glide about with a tea tray as if you'd been "
                         "born to it. 'Marvellous! Marvellous!'", "good")
                self.flags.add("on_tv")
                self.end_event("tv", "mission")
            else:
                self.say("You trip over a cable and take the director down "
                         "with you. It'll be on the blooper reel.", "bad")
                self.gain_stress(roll("1d6"), quiet=True)
                self.end_event("tv")
            return True
        return False

    def hide_princess(self, mob):
        self.flags.add("hid_princess")
        if mob in self.area.mobs:
            self.area.mobs.remove(mob)
        self.st["agents"] = 2
        self.say("You smuggle the Princess up to the attic. Moments later, "
                 "two men in dark suits and sunglasses come up the drive. "
                 "See them off.", "info")
        city = self.cache.get(("city",))
        if city is not None:
            self.event_people(city)

