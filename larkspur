    """A maid, rolled on the tables: Attributes, Types, colours, Qualities,
    Roots, Explosion and Power."""
    base = {a: roll("2d6", rng) // 3 for a in ATTRS}
    types = [TYPE_ORDER[rng.randint(0, 5)] for _ in range(2)]
    attrs = dict(base)
    for t in types:
        up, down, _ = MAID_TYPES[t]
        attrs[up] += 1
        attrs[down] = max(0, attrs[down] - 1)
    quals = []
    for _ in range(2):
        quals.append(roll_quality(rng, [q[0] for q in quals]))
    best = max(attrs.values())
    tops = [a for a in ATTRS if attrs[a] == best]
    powers = []
    for _ in range(2 if sum(attrs.values()) <= 9 else 1):
        table = POWERS[rng.choice(tops)]
        pid = table[rng.randint(0, 5)][0]
        while pid in powers:
            pid = table[rng.randint(0, 5)][0]
        powers.append(pid)
    return {"base": base, "types": types, "attrs": attrs,
            "uniform": roll_color(rng), "hair": roll_color(rng),
            "eyes": roll_color(rng), "quals": [list(q) for q in quals],
            "roots": rng.randrange(len(ROOTS)),
            "boom": rng.randrange(len(EXPLOSIONS)), "powers": powers,
            "weapon": rng.choice(WEAPONS), "age": 14 + roll("1d6", rng)}


