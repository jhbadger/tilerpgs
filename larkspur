def district(x, y):
    """The part of the grounds or the house a square lies in."""
    x0, y0, x1, y1 = HOUSE
    if x0 < x < x1 and y0 < y < y1:
        if GRAND_HALL[0] <= x <= GRAND_HALL[1]:
            return "the Grand Hall"
        side = "west" if x < GRAND_HALL[0] else "east"
        if y == CORRIDORS[0]:
            return "the %s %s" % (
                "portrait gallery, in the" if side == "east" else "north",
                "north corridor" if side == "east" else "corridor")
        return "the south corridor, %s side" % side
    if y <= y1 + 2:
        return "the terrace"
    if x >= 56:
        return "the hedges, by the maze"
    if y >= 38:
        return "the drive, by the lodge"
    if x <= 20:
        return "the lawns, by the pond"
    if x >= 44:
        return "the lawns, by the greenhouse"
    return "the fountain lawn"


def make_city(world, flags):
    """The grounds and the house: the same every game but for what's been
    done to them."""
    rng = random.Random("larkspur")
    W, H = CITY_W, CITY_H
    g = [["lawn"] * W for _ in range(H)]
    area = Area("city", ("city",), g, "Larkspur Hall", edge="tree")
    for x in range(W):
        g[0][x] = g[H - 1][x] = "tree"
    for y in range(H):
        g[y][0] = g[y][W - 1] = "tree"
    x0, y0, x1, y1 = HOUSE
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = "stone" if x in (x0, x1) or y in (y0, y1) else \
                "wall_room"
    for cy in CORRIDORS:
        for x in range(x0 + 1, x1):
            g[cy][x] = "parquet" if cy == CORRIDORS[0] and x > \
