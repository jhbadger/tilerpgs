def make_interior(world, sid, flags):
    name, kind, _ = SITES[sid]
    floor, rows, cast = ROOMS[kind]
    g, spots, seat = [], {}, None
    for y, row in enumerate(rows):
        line = []
        for x, ch in enumerate(row):
            if ch.isdigit():
                spots[cast[ch]] = (x, y)
                line.append(floor)
            elif ch == "m":
                seat = (x, y)
                line.append(floor)
            else:
                line.append(ROOM_TILES.get(ch, floor))
        g.append(line)
    area = Area("inside", ("bld", sid), g, name, edge=None)
    area.site = sid
    area.seat = seat
    for y, row in enumerate(rows):
        for x, ch in enumerate(row):
            if ch == "+":
                area.start = (x, y - 1)
    if sid == "study" and "taken:the Larkspur Star" in flags:
        for y, row in enumerate(g):
            for x, t in enumerate(row):
                if t == "display":
                    row[x] = "shelf"
    for role, (x, y) in spots.items():
        if role in world["people"]:
            area.mobs.append(make_person(world, role, x, y))
    return area


