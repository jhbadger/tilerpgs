    # ── Game setup ──

    def setup_world(self, seed):
        self.world = generate_world(seed)
        self.cache = {}

    def new_game(self, who=None):
        if who is None:
            if not getattr(self, "headless", False):
                def chosen(w):
                    if w is None:
                        if getattr(self, "area", None):
                            return
                        w = self.default_maid()
                    self.new_game(w)
                self.ask_maid(chosen)
                return
            who = self.default_maid()
        self.setup_world(random.randrange(1 << 31))
        self.p = self.make_maid(who)
        w = self.world
        for q in self.p["quals"]:
            if "%s" in q[1]:
                r = random.choice(MAIDS)
                self.p["rel"] = [q[0], r]
                q[1] = q[1] % w["people"][r]["name"]
        self.flags = set()
        self.clues = []
        self.topics = set()
        self.tells = []                 # which of the Phantom's tells found
        self.side = {}                  # errands: id -> state
        self.st = {"fresh": 4, "dust": {}, "rival": {r: roll("2d6")
                                                     for r in MAIDS},
                   "rstress": {r: 0 for r in MAIDS}, "events": [],
                   "event_day": {}, "mood": 0, "chores": {}, "verdict": None,
                   "hens": 0, "trap": None, "seen_by": {}}
        for sid in INDOOR_SITES:
            self.st["dust"][sid] = random.randint(1, 3)
        self.st["dust"]["hall"] = 4
        self.turn = 0
        self.city = None
        self.paint_people()
        self.reset_view()
        self.log.config(state="normal")
        self.log.delete("1.0", "end")
        self.log.config(state="disabled")
        self.city_pos = list(self.door_of("quarters"))
        area = self.get_area(("bld", "quarters"))
        self.area, self.pos = area, list(self.bed_spot(area))
        p = self.p
        self.say("Larkspur Hall. Monday, 06:00. Day 1 of 7.", "quest")
        self.say("You wake in the maids' quarters on your first morning at "
                 "Larkspur: %s, %s %s maid, in a %s uniform." % (
                     p["name"], an(p["types"][0].lower()),
                     ("and " + p["types"][1].lower()) if p["types"][1] !=
                     p["types"][0] else "through and through",
                     p["uniform"].lower()), "info")
        self.say(fill("{headmaid}, the Head Maid, is at the door. "
                      "'Up! The Master's birthday is on Sunday, "
                      "{dowager} is coming to inspect the house that very "
                      "day, and THIS came with the post.' She holds up a "
                      "calling card. 'Larkspur. Tonight: the KITCHEN. "
                      "Yours, the Phantom.' 'Wake the Master at half six. "
                      "And see me about the ROTA.'", w), "talk")
        self.say("Arrow keys or WASD move; walk into people to talk; C does "
                 "the chore where you're standing. Press ? for help.",
