    # ── The Phantom's nights ──

    def phantom_night(self, day):
        """One in the morning: the Phantom walks."""
        if "phantom_caught" in self.flags:
            return
        room, thing = NIGHTS[day - 1]
        here = self.area.site if self.area.kind == "inside" else None
        if here == room and self.p["exploding"] not in ("sleep",):
            self.caught_in_act(day)
            return
        if self.st.get("trap") == room:
            self.st["trap"] = None
            self.flags.add("foiled:%d" % day)
            self.say("In the night, somewhere in the house, a little bell "
                     "rings. Your trap!", "quest")
            unseen = [i for i in range(len(self.world["tells"]))
                      if i not in self.tells]
            if unseen:
                self.st.setdefault("scenes", {})[room] = unseen[0]
            return
        if thing == "stockings":
            self.st["fresh"] = 0
        else:
            self.flags.add("taken:" + thing)
        tells = len(self.world["tells"])
        self.st.setdefault("scenes", {})[room] = min(day - 1, tells - 1)
        self.cache.pop(("bld", room), None)

    def caught_in_act(self, day):
        """You're there when it comes."""
        w = self.world
        self.interrupt = True
        self.busy = False
        self.flags.add("foiled:%d" % day)
        self.say("One o'clock. The door opens, very softly, and in slips a "
                 "figure in a black cloak and a domino mask. It sees you, "
                 "and freezes.", "quest")
        self.sound.play("horror")
        if self.has("stalking"):
            self.say(fill("You were watching from the shadows, and it never "
                          "saw you. You see the face under the mask: "
                          "{phantom_full}!", w), "quest")
            self.unmask_phantom()
            return
        a = max(("Athletics", "Cunning"), key=self.attr)
        v = self.attr(a)
        d, why = self.die()
        ta = self.phantom_attr(a) + 2       # masked, cloaked and ready
        theirs = random.randint(1, 6) * ta
        self.say("[%s %d x (%s) = %d vs the Phantom's %s %d x d6 = %d]" % (
            a, v, ", ".join(why), d * v, a, ta, theirs), "roll")
        if d * v >= 2 * theirs:
            self.say("You grab the mask, and off it comes.", "good")
            self.unmask_phantom()
        elif d * v > theirs:
            self.say("You catch hold of the cloak! It tears, and the "
                     "Phantom is gone through the window, but you've got "
                     "a handful of it, and a good look...", "good")
            unseen = [i for i in range(len(w["tells"])) if i not in
                      self.tells]
            for i in unseen[:2]:
                self.found_tell(i, "You noticed")
        else:
            self.say("It's out of the window before you can blink, and "
                     "away. But it dropped what it came for, and you got a "
                     "good look...", "bad")
            unseen = [i for i in range(len(w["tells"])) if i not in
                      self.tells]
            for i in unseen[:2]:
                self.found_tell(i, "You noticed")

    def unmask_phantom(self):
        w = self.world
        ph = w["phantom"]
        mob = make_person(w, ph, *self.pos)
        self.confess(mob)

    def scene_clue(self, area):
        """Where the Phantom struck: a clue on the floor."""
        n = self.st.get("scenes", {}).get(area.site)
        if n is None or n in self.tells:
            return
        area.scene = n
        spots = [(x, y) for y in range(area.h) for x in range(area.w)
                 if area.grid[y][x] in INSIDE_FLOOR and
                 not area.mob_at(x, y) and (x, y) != area.start and
                 (x, y) not in area.items]
        if spots:
            area.items[random.Random(area.site).choice(spots)] = "clue"

    # ── Sunday ──

    def serve_dowager(self, mob):
        p = self.p
        if not p["items"].get("tea") or not \
                INSPECTION <= self.turn < INSPECTION + 30 or \
                "dtea" in self.st:
            return False
        self.take_item("tea")
        self.say("You pour the Dowager's tea, with the very best china.",
                 "info")
        ok = self.check("Skill", 8, "tea for the Dowager")
        self.st["dtea"] = ok
        self.npc_say(mob, "...Adequate. More than adequate." if ok else
                     "This tea is STEWED.")
        return True

    def inspection(self):
        """Half past three: the Dowager has seen the house."""
        w = self.world
        st = self.st
        p = self.p
        score, notes = 0, []
        dust = sum(v for k, v in st["dust"].items() if k != "hall") + \
            st["dust"].get("hall", 0) // 3
        if dust <= 12:
            score += 1
            notes.append("the house is spotless")
        elif dust >= 30:
            score -= 1
            notes.append("there's dust everywhere")
        if "dtea" in st:
            score += 1 if st["dtea"] else -1
            notes.append("your tea was %s" % ("perfect" if st["dtea"] else
                                              "stewed"))
        elif random.random() < 0.5:
            score += 1
            notes.append("the tea was very nice")
        if all(v == "ok" for v in p["dress"].values()):
            score += 1
            notes.append("the maids are turned out beautifully")
        else:
            score -= 1
            notes.append("one maid's uniform is a disgrace")
        if "phantom_caught" in self.flags:
            score += 1
            notes.append("the Phantom was caught")
        if "taken:the Larkspur Star" in self.flags and \
                "back:the Larkspur Star" not in self.flags:
            score -= 2
            notes.append("the Larkspur Star is GONE")
        loose = [e for e in st["events"] if e in ("hens", "penguin",
                                                  "ninjas", "doll",
                                                  "princess", "fire")]
        if loose:
            score -= min(2, len(loose))
            notes.append("there are %s about the place" % (
                "hens" if "hens" in loose else "goings-on"))
        if st["mood"] >= 8:
            score += 1
            notes.append("the Master looks happier than she's seen in years")
        if p["favor"] >= 25:
            score += 1
            notes.append("the Master speaks up for you")
        if "on_tv" in self.flags:
            score += 1
            notes.append("she saw Larkspur on television")
        st["verdict"] = score
        st["verdict_notes"] = notes
        self.say(fill("{dowager} puts down her cup, and goes round the "
                      "house with a white glove, and says nothing at all. "
                      "'I shall announce my decision at the party.'", w),
                 "quest")

    def party(self):
        """Five o'clock: the party, and the end of the week."""
        if "won" in self.flags:
            return
        if self.st["verdict"] is None:
            self.inspection()
        self.flags.add("won")
        if self.p.get("companion"):
            self.dismiss()
        self.end_talk()
        self.menu = None
        self.go_to_site("ballroom")
        self.results = self.party_results()
        self.save()
