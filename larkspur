                     "may deliver it.' A puff of smoke. It's a letter from "
                     "the Master's parents. It would make a wonderful "
                     "present.", "quest")
            self.end_event("ninjas", "mission")

    def parcel(self):
        self.say("A parcel, addressed to you. A small canoe.", "info")

    def event_tick(self):
