# Things on the floor: their tile, and what stepping on them gives.
FLOOR_ITEMS = {"corpse", "note", "evidence", "tooth", "gear", "ammo", "medkit",
               "coins", "trap"}

STEEL = ("#4a4e54", "#565a60", "#3e4248", "#2e3238")


def plate(rng, base="#4a4e54", seam="#34383e", rivet="#6a6e74", size=8):
    """Deck plating: square plates with seams and rivets."""
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.06), shade(base, 0.94)], 0.25)
    for y in range(16):
        for x in range(16):
            if x % size == 0 or y % size == 0:
                g[y][x] = seam
    for y in range(2, 16, size):
        for x in range(2, 16, size):
            g[y][x] = rivet
    return g


def grating(rng, base="#3a3e44", bar="#5a5e64", gap="#16181c"):
    g = grid_of(gap)
    for y in range(16):
        for x in range(16):
            if x % 3 == 0 or y % 4 == 0:
                g[y][x] = bar if rng.random() > 0.05 else base
    return g


def wallpanel(rng, base, trim, light=None):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.08), shade(base, 0.9)], 0.2)
    rect(g, 0, 0, 15, 1, trim)
    rect(g, 0, 14, 15, 15, shade(trim, 0.7))
    for x in (0, 8):
        rect(g, x, 2, x, 13, shade(base, 0.75))
    if light:
        rect(g, 3, 4, 5, 5, light)
        rect(g, 11, 4, 13, 5, light)
    return g


def ice(rng, base="#a8c8d8"):
    g = grid_of(base)
    speckle(g, rng, ["#c8e0ec", "#90b0c4", "#b8d4e2"], 0.4)
    for _ in range(3):
        x, y = rng.randrange(16), rng.randrange(16)
        for k in range(rng.randrange(3, 7)):
            if 0 <= x < 16 and 0 <= y < 16:
                g[y][x] = "#e8f4fa"
            x += rng.choice((-1, 0, 1))
            y += 1
    return g


def stars(rng, frame, base="#04040c"):
    g = grid_of(base)
    for _ in range(9):
        x, y = rng.randrange(16), rng.randrange(16)
        g[y][x] = rng.choice(("#f0f0ff", "#a0a0c0", "#f0e0c0"))
    if frame:
        for _ in range(3):
            g[rng.randrange(16)][rng.randrange(16)] = "#ffffff"
    return g


def draw_terrain(name, frame=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random(name + str(frame))
    # ── the Ring ──
    if name == "deck":
        return plate(rng)
    if name == "plaza":
        return plate(rng, "#52565c", "#3a3e44", "#72767c", 16)
    if name == "grate":
        return grating(rng)
    if name == "hazard":
        g = plate(rng)
        for y in range(16):
            for x in range(16):
                if y < 3 or y > 12:
                    g[y][x] = "#e0b020" if (x + y) // 3 % 2 else "#1a1a1a"
        return g
    if name == "dockfloor":
        g = plate(rng, "#3e4a52", "#2a343a", "#5a6a74")
        rect(g, 0, 7, 15, 8, "#c0a020")
        return g
    if name == "hull":
        g = grid_of("#2a2c30")
        speckle(g, rng, ["#34363a", "#222428"], 0.35)
        for y in range(0, 16, 4):
            rect(g, 0, y, 15, y, "#1a1c20")
        return g
    if name in ("module", "module2", "module3"):
        base = {"module": "#5a6068", "module2": "#6a5a50",
                "module3": "#4a5a5a"}[name]
        return wallpanel(rng, base, shade(base, 1.25))
    if name == "viewport":
        g = stars(rng, frame)
        disc(g, 13, 13, 7, "#8a5a3a")           # Megaera's limb
        for y in range(16):
            for x in range(16):
                if g[y][x] == "#8a5a3a" and (x + 2 * y) % 5 == 0:
                    g[y][x] = "#b07a4a"
        rect(g, 0, 0, 15, 0, "#6a6e74")
        rect(g, 0, 15, 15, 15, "#6a6e74")
        rect(g, 0, 0, 0, 15, "#6a6e74")
        rect(g, 15, 0, 15, 15, "#6a6e74")
        return g
    if name == "pipes":
        g = grid_of("#2a2c30")
        for x0, c in ((2, "#7a6a4a"), (7, "#5a6a7a"), (12, "#6a4a4a")):
            rect(g, x0, 0, x0 + 2, 15, c)
            rect(g, x0, 0, x0, 15, shade(c, 1.3))
            for y in range(rng.randrange(4), 16, 6):
                rect(g, x0 - 1, y, x0 + 3, y + 1, "#3a3a3a")
        if frame:
            g[rng.randrange(16)][rng.randrange(16)] = "#d0e0f0"
        return g
    if name == "crates":
        g = grid_of("#2a2c30")
        for x0, y0, c in ((0, 0, "#7a5a2a"), (8, 0, "#5a6a3a"),
                          (0, 8, "#5a5a6a"), (8, 8, "#7a4a2a")):
            rect(g, x0, y0, x0 + 7, y0 + 7, c)
            rect(g, x0, y0, x0 + 7, y0, shade(c, 1.3))
            rect(g, x0 + 1, y0 + 3, x0 + 6, y0 + 3, shade(c, 0.7))
        return g
    if name == "console":
        g = plate(rng)
        rect(g, 2, 2, 13, 13, "#2a2c30")
        rect(g, 3, 3, 12, 8, "#0a2a1a")
        for y in (4, 6):
            rect(g, 4, y, rng.randrange(6, 11), y, "#40e090")
        rect(g, 4, 10, 11, 11, "#4a4e54")
        if frame:
            rect(g, 11, 7, 11, 7, "#40e090")
        return g
    if name == "lamp":
        g = plate(rng)
        rect(g, 5, 5, 10, 10, "#3a3e44")
        rect(g, 6, 6, 9, 9, "#f0d890" if not frame else "#f8e8a8")
        return g
    if name == "foam":
        g = grid_of("#c8c0a0")
        for _ in range(9):
            disc(g, rng.uniform(0, 15), rng.uniform(0, 15),
                 rng.uniform(1.5, 3.5), rng.choice(("#d8d0b0", "#b0a888",
                                                    "#e0d8c0")))
        return g
    if name == "placard":
        g = plate(rng)
        rect(g, 1, 4, 14, 11, "#e0b020")
        rect(g, 2, 5, 13, 10, "#1a1a1a")
        for x in range(3, 13, 2):
            g[7][x] = g[8][x - 1] = "#e0b020"
        return g
    if name in ("hatch", "airlock", "lift", "downhatch", "bulkhead",
                "umbilical", "sluice"):
        g = plate(rng, "#3a3e44", "#2a2c30", "#5a5e64")
        if name == "downhatch":
            disc(g, 7.5, 7.5, 6, "#2a2c30")
            disc(g, 7.5, 7.5, 5, "#5a5e64")
            rect(g, 3, 7, 12, 8, "#e0b020")
            return g
        if name == "sluice":
            disc(g, 7.5, 7.5, 6, "#2a3a40")
            disc(g, 7.5, 7.5, 4.5, "#3a5a6a")
            rect(g, 7, 2, 8, 13, "#6a8a9a")
            rect(g, 2, 7, 13, 8, "#6a8a9a")
            return g
        door = {"hatch": "#6a7078", "airlock": "#c0a020", "lift": "#7a6a4a",
                "bulkhead": "#8a3a2a", "umbilical": "#4a6a8a"}[name]
        rect(g, 1, 1, 14, 15, "#2a2c30")
        rect(g, 2, 2, 6, 15, door)
        rect(g, 9, 2, 13, 15, door)
        rect(g, 7, 2, 8, 15, "#1a1a1a")
