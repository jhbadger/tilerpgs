def generate_world(seed):
    """The station: who is who, where things are, who has noticed."""
    rng = random.Random("%s:world" % seed)
    world = {"seed": seed, "people": make_people(rng)}
    world["mimic"] = rng.choice(MIMIC_ROLES)
    witnesses = [r for r in ("cook", "barkeep", "medic", "miner", "botanist",
                             "drinker", "mechanic", "widow", "chaplain")
                 if r != world["mimic"]]
    tells = rng.sample(TELLS, 3)
    world["tells"] = dict(zip(rng.sample(witnesses, 3), tells))
    stash, used = {}, set()
    for thing, places in STASHES.items():
        options = [p for p in places if p not in used] or places
        spot = rng.choice(options)
        used.add(spot)
        stash[thing] = list(spot)
    world["stash"] = stash
    world["crew"] = [person_name(rng, rng.choice("MF")) for _ in range(3)]
    world["errands"] = [dict(e) for e in ERRANDS]
    return world


