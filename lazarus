    def detonate(self):
        if self.area.kind == "dungeon" and self.area.lead == "dig":
            self.say("Not from down here. You'd be buried with it.", "bad")
            return
        self.flags.add("sealed")
        self.learn("sealed")
        self.say("You press the button. A second, two, and then the whole "
                 "station shudders, and a sound comes up through the deck "
                 "plates like the ice clearing its throat. Then silence. "
                 "The Reliquary is under four kilometres of ice again.",
                 "quest")
        self.sound.play("fire")
        self.cache = {k: v for k, v in self.cache.items()
                      if k[0] != "dun" or k[1] != "dig"}
        if "tooth_home" in self.flags:
            self.say("And the humming in the walls, that you'd stopped "
                     "hearing because it never stopped, stops.", "quest")
        self.end_turn()

    # ── Searching and touching ──

    def search(self):
        if not self.ready():
            return
        a = self.area
        px, py = self.pos
        near = [(x, y) for (x, y) in a.hidden
                if abs(x - px) + abs(y - py) <= 3]
        traps = [(x, y) for (x, y) in a.traps
                 if abs(x - px) + abs(y - py) <= 3]
        self.say("You search carefully.", "info")
        if not self.check("Intellect", label="searching", stress=False):
            self.say("You find nothing.", "info")
        else:
            for pos in near:
                a.items[pos] = a.hidden.pop(pos)
            for pos in traps:
                a.traps.discard(pos)
                a.items[pos] = "trap"
            if near:
                self.say("You find something.", "gold")
            elif traps:
                self.say("You find a live cable, sparking, right where "
                         "you'd have stepped.", "gold")
            else:
                self.say("There's nothing here to find.", "info")
        self.pass_time(4, quiet=True)
        self.end_turn()

    def step_on(self, x, y):
        """Things on the floor are picked up (or read); True if that took
        the turn."""
        a, p = self.area, self.p
        thing = a.items.get((x, y))
        if not thing or thing == "trap":
            return False
        if thing == "corpse":
            self.loot_body(x, y)
            return False
        del a.items[(x, y)]
        if thing == "evidence":
            body = a.bodies.pop((x, y), {"things": []})
            for t in body["things"]:
                self.give_item(t)
        elif thing == "note":
            self.say(getattr(a, "note", "A scrap of paper. Illegible."),
                     "talk")
            self.hear(getattr(a, "note", ""))
        elif thing == "coins":
            n = roll("1d10") * 20
            p["credits"] += n
            self.say("A Company scrip card with %d credits on it." % n,
                     "gold")
            self.sound.play("gold")
        elif thing == "ammo":
            guns = [w for w in p["guns"] if WEAPONS[w].ammo]
            ammo = WEAPONS[random.choice(guns)].ammo if guns and \
                random.random() < 0.7 else random.choice(list(AMMO))
            self.give_item(ammo)
            self.say("You find %s." % ammo, "gold")
            self.sound.play("gold")
        elif thing == "medkit":
            what = random.choice(("first aid kit", "first aid kit",
                                  "stimpak", "sedatives", "chemlights",
                                  "radiation pills"))
            self.give_item(what)
            self.say("You find %s." % ITEMS[what][0].split(":")[0], "gold")
            self.sound.play("gold")
        elif thing == "tooth":
            self.give_item("the tooth")
            self.learn("got_tooth")
        elif thing == "gear":
            if getattr(a, "charges", None) == (x, y):
                self.give_item("mining charges")
                self.flags.add("charges")
                self.learn("charges")
                self.say("Mining charges, and a detonator. Enough to bring "
                         "down a tunnel. Enough to bring down a Dig.",
                         "quest")
        return False

    def loot_body(self, x, y):
        a = self.area
        body = a.bodies.get((x, y))
        if not body:
            self.say("A body. Nobody you knew. You don't look too long.",
                     "info")
            return
        if "body:%s:%d:%d" % (a.key, x, y) not in self.flags:
            self.flags.add("body:%s:%d:%d" % (a.key, x, y))
            self.gain_stress(0 if not body["who"] else 1,
                             "%s. What's left of them." % cap(body["who"])
                             if body["who"] else None)
        if not body["things"]:
            if body["who"]:
                self.say("%s. There's nothing on them you'd want." %
                         cap(body["who"]), "info")
            return
        things = list(body["things"])
        body["things"] = []
        for t in things:
            self.give_item(t)
        self.say("On the body: %s." % ", ".join(
            fill(EVIDENCE[t], self.world) if t in EVIDENCE else t
            for t in things), "gold")
        self.sound.play("gold")
        if "survey" in things:
            self.say("The foreman's recorder. His voice, tinny: 'Survey "
                     "day forty. We told them it wasn't natural. The "
                     "Director's reply came back in four minutes: continue, "
                     "Directive 9. Recover sample. Personnel are "
                     "secondary.' Then a lot of breathing. Then humming.",
                     "talk")

    def touch(self, t, x, y):
        """Walking into the furniture of the world."""
        a = self.area
        site = a.site or ""
        if t == "terminal":
            self.terminal(site, x, y)
        elif t == "desk" and site == "ops":
            self.director_terminal()
        elif t == "safe":
            self.safe()
        elif t == "bed":
            self.bed_menu()
        elif t == "medpod":
            self.medpod()
        elif t == "cryopod":
            crew = [c for c in self.world["crew"] if c not in self.crew_lost
                    and c != self.p["name"]]
            self.say("A cryopod, frosted over. %s" % (
                "%s is under, still and grey-lipped and alive." % crew[0]
                if crew else "Empty now."), "info")
        elif t == "morgue":
            self.say("Eleven drawers, all pulled open, all empty. The steel "
                     "inside them is scratched. From the inside.", "info")
            if "morgue" not in self.flags:
                self.flags.add("morgue")
                self.gain_stress(1, quiet=True)
        elif t == "altar":
            self.pray()
        elif t == "crate" and (x, y) in a.loot:
            self.open_loot(x, y)
        elif t == "locker":
            self.locker(x, y)
        elif t == "scrubber":
            self.scrubber(x, y)
        elif t == "scrubber_ok":
            self.say("The scrubber bank, humming the ordinary hum of "
                     "machinery. The new filter's light is green.", "good")
        elif t == "vesper":
            self.vesper()
        elif t == "gate":
            self.gate(x, y)
        elif t == "console":
            self.ring_console()
        elif t == "placard":
            self.say("STATION DIRECTORY. North: Ops, Infirmary, Security, "
                     "Chapel, Dorms. Middle: Docking, Galley, Sump, "
                     "Commissary, Hydroponics. South: Engineering, Blasting "
                     "Store, Dig Head, Sector 7 (crossed out), Reclamation. "
                     "Someone has scratched 4190 into the plastic.", "info")
        elif t in ("viewport", "window"):
            self.say("Out there: the ice, white and flat to the edge of the "
                     "world, and Megaera filling half the sky, banded and "
                     "brown and huge.%s" % (
                         " A new star is moving against the others: the Due "
                         "Diligence." if self.turn >= DUE - 6 * 60 else ""),
                     "info")
        elif t == "pipes":
            self.say("Pipes. If you put your hand on them, they hum. If you "
                     "put your ear to them, they hum a tune.", "info")
        elif t == "foam":
            self.say("Quarantine foam, gone hard and yellow. Behind it is "
                     "Sector 7. Something behind it knocks, three times, "
                     "when you touch it.", "info")
        elif t == "taps":
            self.say("The beer taps. One of them still works.", "info")
        elif t == "stove":
            self.say("The galley stove, still warm.", "info")
        elif t == "tray":
            self.say("Hydroponic trays: lettuce, beans, and a lot of "
                     "something pale that might be mould.", "info")
        elif t == "rack":
            self.say("The armory rack, chained and padlocked. The deputy "
                     "has the key.", "info")
        elif t == "pew":
            self.say("A pew. Someone has scratched names into the back of "
                     "it. Some of them are crossed out.", "info")
        elif t == "shelf":
            self.say("Shelves. %s" % {
                "commissary": "Company-brand everything, at Company "
                              "prices.",
                "infirmary": "Bandages, saline, sedatives, everything "
                             "labelled in the doctor's tiny writing.",
                "engineering": "Spare parts for machines that aren't "
                               "running any more."}.get(site, "Stores."),
                "info")
        else:
            self.bump()

    def open_loot(self, x, y):
        a = self.area
        a.loot.discard((x, y))
        a.grid[y][x] = "crate_open"
        self.flags.add("loot:%s:%d:%d:%d" % (a.key[1], a.key[2], x, y))
        self.say("You prise the crate open.", "info")
        r = random.random()
        if r < 0.15:
            kind = random.choice(LEADS[a.lead].monsters)
            if "still" not in MONSTERS[kind].traits:
                self.say("Something was curled up in there.", "bad")
                spots = [(x + dx, y + dy) for dx, dy in DIRS
                         if a.inside(x + dx, y + dy) and
                         a.grid[y + dy][x + dx] in DUNGEON_FLOOR and
                         not a.mob_at(x + dx, y + dy) and
                         [x + dx, y + dy] != self.pos]
                if spots:
                    m = make_monster(kind, *spots[0])
                    m.aware = True
                    a.mobs.append(m)
        elif r < 0.85:
            a.items[tuple(self.pos)] = random.choice(("coins", "medkit",
                                                      "ammo", "ammo"))
            self.step_on(*self.pos)
        else:
            self.say("Ice core samples, labelled and frozen. Nothing "
                     "useful.", "info")
        self.end_turn()

    def locker(self, x, y):
        a = self.area
        key = "locker:%s:%d:%d" % (a.key, x, y)
        if key in self.flags:
            self.say("A locker, already emptied.", "info")
            return
        self.flags.add(key)
        rng = random.Random("%s:%s" % (self.world["seed"], key))
        found = rng.choice((("flashlight",), ("mre",), ("chemlights",),
                            ("cigarettes",), ("patch kit",),
                            ("first aid kit",), (), ("oxygen tank",),
                            ("whiskey",)))
        if a.site == "patience":
            found = ("patch kit", "mre", "first aid kit", "oxygen tank")
        if not found:
            self.say("A locker: a coat, a photo of someone's kids, a pair "
                     "of boots. You leave them.", "info")
            return
        for f in found:
            self.give_item(f)
        self.say("In the locker: %s." % ", ".join(found), "gold")
        self.sound.play("gold")

    def gate(self, x, y):
        p = self.p
        opts = []
        if p["items"].get("hand welder") or p["items"].get("laser cutter"):
            opts.append(("Cut through it (a few minutes)",
                         lambda: self.try_gate(x, y, "cut")))
        opts += [("Force it (Strength%s)" % (", [+] crowbar" if
                                             p["items"].get("crowbar")
                                             else ""),
                  lambda: self.try_gate(x, y, "force")),
                 ("Override the lock (Intellect, Computers or Hacking)",
                  lambda: self.try_gate(x, y, "hack")),
                 ("Leave it", lambda: None)]
        self.open_menu("A blast door, sealed. Beyond it: the deepest part "
                       "of this place.", opts)

    def try_gate(self, x, y, how):
        a, p = self.area, self.p
        if how == "cut":
            self.pass_time(10, quiet=True)
            ok = True
        elif how == "force":
            ok = self.check("Strength", ("Industrial Equipment",
                                         "Athletics"),
                            adv=1 if p["items"].get("crowbar") else 0,
                            label="forcing the door")
            if not ok:
                self.alert(14)
        else:
            ok = self.check("Intellect", ("Hacking", "Computers"),
                            adv=1 if p["items"].get("lockpick set") or
                            p["items"].get("portable terminal") else 0,
                            label="the lock")
        if ok:
            a.grid[y][x] = "dfloor"
            self.say("The door grinds open.", "good")
            self.sound.play("door")
        else:
            self.say("It holds.", "info")
        self.end_turn()

    def blasting_door(self):
        p = self.p
        opts = []
        if p["items"].get("blasting key"):
            opts.append(("Use the blasting key", lambda: self.open_blasting(
                "The key turns. The door unlocks with a heavy clunk.")))
        if p["items"].get("hand welder") or p["items"].get("laser cutter"):
            opts.append(("Cut the lock out", lambda: self.open_blasting(
                "Ten minutes of sparks and stink, and the lock falls out.",
                10)))
        opts += [("Crack the keypad (Intellect, Hacking)",
                  lambda: self.hack_blasting()),
                 ("Leave it", lambda: None)]
        self.open_menu("The Blasting Store: a heavy door, a keypad, a sign "
                       "with a skull on it. Locked.", opts)

    def open_blasting(self, text, minutes=0):
        if minutes:
            self.pass_time(minutes, quiet=True)
        self.flags.add("open:blasting")
        self.say(text, "good")
        self.enter_link(("bld", "blasting"), 0, 0)

    def hack_blasting(self):
        p = self.p
        if self.check("Intellect", ("Hacking",), adv=1 if (
                p["items"].get("portable terminal") or
                p["items"].get("lockpick set")) else 0,
                mod=-10 if not p["skills"].get("Hacking") else 0,
                label="the keypad"):
            self.open_blasting("The keypad blinks green.")
        else:
            self.say("The keypad blinks red, and locks you out for a while.",
                     "bad")
            self.pass_time(10, quiet=True)
            self.render()

    # ── Terminals and machines ──

    def terminal(self, site, x, y):
        a = self.area
        if site == "patience" and (x, y) == getattr(a, "helm", None):
            self.helm()
        elif site == "ops":
            self.array()
        elif site == "infirmary":
            self.doc_terminal()
        elif site == "security":
            self.say("Security log, last entry, Chief Marsh: 'Going in after "
                     "them. Seal it behind me. That's an order, deputy. Seal "
                     "it and don't open it for anything that sounds like "
                     "me.'", "talk")
        elif site == "engineering":
            self.say("ENVIRONMENTAL: CO2 scrubbers at %s. Reactor stable. "
                     "VESPER: QUARANTINE ORDER 9 IN EFFECT. ALL CLAMPS "
                     "ENGAGED." % ("100%" if "scrubbed" in self.flags else
                                   "19%" if "airbad" in self.flags else
                                   "31%"), "talk")
        elif site == "dighead":
            self.say("DIG STATUS: shaft depth 4,190 m. Lift: operational. "
                     "Personnel below: 0. Personnel below: 0. Personnel "
                     "below: 34. Personnel below: 0.", "talk")
            self.gain_stress(1, quiet=True) if "dig_term" not in \
                self.flags else None
            self.flags.add("dig_term")
        elif site == "dock":
            self.say("DOCKING: Port clamp: Patience, ENGAGED. Starboard "
                     "umbilical: Magdalene, ENGAGED, hull breached, no "
                     "atmosphere. Release requires Director override or "
                     "VESPER authority.", "talk")
            self.learn("clamps")
        else:
            self.say("A terminal, locked to someone else's login.", "info")

    def director_terminal(self):
        p = self.p
        if "evidence:directive" in self.flags:
            self.say("The Director's terminal. You've already got what's "
                     "on it.", "info")
            return
        if any(m.role == "director" for m in self.area.mobs) and \
                "director_broken" not in self.flags:
            self.say("The Director steps between you and his desk. 'That "
                     "is Company property.'", "talk")
            return
        if p["items"].get("director's card") or \
                "director_broken" in self.flags or self.check(
                "Intellect", ("Hacking", "Computers"),
                adv=1 if p["items"].get("portable terminal") else 0,
                mod=-10 if not p["skills"].get("Hacking") else 0,
                label="the Director's terminal"):
            self.say("DIRECTIVE 9 (HALVORSEN-KADE, EYES ONLY): 'Anomalous "
                     "structure at 4190 m is to be treated as Asset 9. "
                     "Recover sample by any means. Personnel considerations "
                     "are secondary. In the event of containment failure, "
                     "Asset Recovery will be dispatched; no personnel are "
                     "to be evacuated before recovery. Retain no "
                     "witnesses.'", "talk")
            self.got_evidence("directive")
            self.say("Under it, a note in the Director's hand: SAFE "
                     "0412.", "info")
            self.flags.add("safe_code")
        else:
            self.say("Access denied.", "bad")
        self.end_turn()

    def safe(self):
        p = self.p
        if "safe_open" in self.flags:
            self.say("The safe, open and empty.", "info")
            return
        if any(m.role == "director" for m in self.area.mobs) and \
                "director_broken" not in self.flags:
            self.say("'Step away from that safe.' The Director's hand is in "
                     "his desk drawer. There's something in it.", "talk")
            return
        opts = []
        if "safe_code" in self.flags:
            opts.append(("Enter 0412", lambda: self.open_safe(
                "Four, one, two. The bolts slide back.")))
        if p["items"].get("laser cutter") or p["items"].get("hand welder"):
            opts.append(("Cut it open (half an hour)",
                         lambda: self.open_safe("Half an hour of sparks, "
                                                "and the door falls in.",
                                                30)))
        opts += [("Crack it (Intellect, Hacking or Mechanical Repair)",
                  self.crack_safe), ("Leave it", lambda: None)]
        self.open_menu("The Director's safe. It's humming.", opts)

    def crack_safe(self):
        if self.check("Intellect", ("Hacking", "Mechanical Repair"),
                      mod=-10, label="cracking the safe"):
            self.open_safe("Click. Click. Click. It opens.")
        else:
            self.say("It doesn't open.", "info")
            self.end_turn()

    def open_safe(self, text, minutes=0):
        if minutes:
            self.pass_time(minutes, quiet=True)
        self.flags.add("safe_open")
        self.say(text + " Inside, in a foam-lined case, the Tooth: a curved "
                 "thing as long as your forearm, ivory and wet-looking, and "
                 "warm. It hums against your palm.", "quest")
        self.give_item("the tooth")
        self.learn("got_tooth")
        self.gain_stress(1, quiet=True)
        self.end_turn()

    def array(self):
        """The comms array: the long-range set, and the public relay."""
        if "broadcast" in self.flags:
            self.say("The array, still sending. The public relay at Kessler "
                     "Point has acknowledged, and so have six ships and a "
                     "news service.", "info")
            return
        n = len(self.evidence)
        if n < 2 or "directive" not in self.evidence:
            self.say("The comms array console. You could send anything to "
                     "the public relay at Kessler Point from here. Without "
                     "proof (Directive 9 and something more), nobody would "
                     "believe a word.", "info")
            return
        self.open_menu("Send everything to the public relay at Kessler "
                       "Point?", [
                           ("Broadcast it (Intellect, Computers)",
                            self.broadcast),
                           ("Not yet", lambda: None)])

    def broadcast(self, helped=False):
        if not helped and not self.check("Intellect", ("Computers",
                                                       "Hacking"),
                                         mod=20, label="the array"):
            self.say("The array won't take the packet. Try again.", "bad")
            self.end_turn()
            return
        self.flags.add("broadcast")
        self.learn("broadcast")
        self.say("The packet goes: Directive 9, %s. Out past Megaera to the "
                 "public relay, and from there to everyone. It can't be "
                 "called back. Halvorsen-Kade will know in an hour. So will "
                 "everyone else." % ", ".join(
                     fill(EVIDENCE[e], self.world)
                     for e in self.evidence if e != "directive"), "quest")
        self.sound.play("quest")
        self.end_turn()

    def doc_terminal(self):
        if "evidence:autopsy" in self.flags:
            self.say("Dr. %s's notes. You've got them." % fill(
                "{doctor_short}", self.world), "info")
            return
        if "doc_pass" in self.flags or self.check(
                "Intellect", ("Hacking", "Computers"),
                mod=-10 if not self.p["skills"].get("Hacking") else 0,
                label="the doctor's terminal"):
            self.say("AUTOPSY NOTES: 'Subjects are hollow. Organs absent, "
                     "not removed: absent. Tissue resonates at 41.9 Hz. "
                     "Subjects maintain ambient temperature and show no "
                     "metabolic activity. Subjects do not remain inert. "
                     "Exception: subject 4, cremated. Fire is the only "
                     "intervention observed to be final. The sample is the "
                     "source. It must go back.'", "talk")
            self.got_evidence("autopsy")
            self.learn("fire")
        else:
            self.say("PASSWORD?", "bad")
        self.end_turn()

    def ring_console(self):
        alive = [r for r in SAVEABLE if not self.gone(r)
                 and r not in ("pilot", "foreman") and r != self.world[
                     "mimic"]]
        people = len(alive) + (0 if "unmasked" in self.flags or
                               self.world["mimic"] in self.dead else 1)
        self.say("VESPER: 'LIFE SIGNS ON THE RING: %d. Plus tug crew: 1.' "
                 "The duty roster on the next screen lists %d names." % (
                     len(alive), people), "talk")
        if people > len(alive) and "count" not in self.flags:
            self.flags.add("count")
            self.say("You count again. VESPER is one short. Someone on the "
                     "Ring has no life signs.", "bad")
            self.gain_stress(1, quiet=True)
        self.end_turn()

    def scrubber(self, x, y):
        p = self.p
        if not p["items"].get("spare filter"):
            self.say("The CO2 scrubber bank. Its filter is grey and clogged "
                     "and a warning light is blinking: REPLACE. You'd need a "
                     "fresh cartridge.", "info")
            self.learn("scrubbers", quiet=True)
            return
        self.say("You crack the housing and haul the old filter out.",
                 "info")
        self.pass_time(15, quiet=True)
        if self.check("Intellect", ("Mechanical Repair", "Jury-Rigging",
                                    "Engineering", "Industrial Equipment"),
                      adv=1 if p["items"].get("assorted tools") or
                      p["items"].get("electronic tools") else 0,
                      label="fitting the filter"):
            self.take_item("spare filter")
            self.flags.add("scrubbed")
            self.learn("scrubbed")
            self.area.grid[y][x] = "scrubber_ok"
            self.say("The new filter seats with a thump, and the fans spin "
                     "up. The light goes green. Up on the Ring, people will "
                     "start breathing easier, and not know why.", "good")
            self.sound.play("level")
        else:
            self.say("It won't seat. You'll have to try again.", "bad")
        self.end_turn()

    def vesper(self):
        p = self.p
        if "vesper_open" in self.flags or "override" in self.flags:
            self.say("VESPER's core, ticking over. 'The clamps are yours,' "
                     "it says. 'I wish you hadn't asked.'", "info")
