def all_tiles():
    """name -> pixel rows, for every tile and animation frame."""
    tiles = {}
    for name in TERRAIN:
        tiles[name] = draw_terrain(name)
        if name in ANIMATED_TERRAIN:
            tiles[name + "@1"] = draw_terrain(name, 1)
    sprites = {}
    for name, (shape, pal) in PEOPLE.items():
        sprites[name] = art_pixels(pal, PERSON_SHAPES[shape])
    for name, (pal, rows) in ART.items():
        sprites[name] = art_pixels(pal, rows)
    still = {"hit", "bolt", "flame", "chorister", "cantor"} | FLOOR_ITEMS
    for name, px in sprites.items():
        tiles[name] = px
        SPRITES.add(name)
        if name in still:
            continue
        tiles[name + "@1"] = px[1:] + [[None] * 16]     # a bob: up a pixel
    return tiles

# ── The Ring ─────────────────────────────────────────────────────────────────
#
# Lazarus Deep's habitat: a flat ring of modules on the ice, laid out on
# corridors, with the hull and its viewports all round.  The Patience is
# clamped to the docking airlock on the west side; the Magdalene to the
# umbilical on the east.  A module fills a block (or half of one) and is
