def blank(w, h, tile):
    return [[tile] * w for _ in range(h)]


def make_dungeon(world, lid, level, flags):
    """One level below the Ring: rooms and passages, its monsters and its
    things, the same each time it is made (but for what's been done)."""
    info = LEADS[lid]
    rng = random.Random("%s:%s:%d" % (world["seed"], lid, level))
    W, H = 40, 28
    last = level == info.levels
    for attempt in range(80):
        g = blank(W, H, "dwall")
        rooms = []
        want = rng.randint(6, 8)
        for _ in range(400):
            if len(rooms) >= want:
                break
            w, h = rng.randint(4, 9), rng.randint(3, 6)
            if last and info.boss and len(rooms) == want - 1:
                w, h = 9, 6
            x, y = rng.randint(1, W - w - 1), rng.randint(1, H - h - 1)
            if any(x <= r[2] + 2 and r[0] <= x + w + 1 and
                   y <= r[3] + 2 and r[1] <= y + h + 1 for r in rooms):
                continue
            rooms.append((x, y, x + w - 1, y + h - 1))
        if len(rooms) < 5:
            continue
        rooms.sort(key=lambda r: r[0] + r[2] + rng.random())
        centers = [((r[0] + r[2]) // 2, (r[1] + r[3]) // 2) for r in rooms]

        def carve(a, b):
            (ax, ay), (bx, by) = a, b
            if rng.random() < 0.5:
                pts = [(x, ay) for x in range(min(ax, bx), max(ax, bx) + 1)]
                pts += [(bx, y) for y in range(min(ay, by), max(ay, by) + 1)]
            else:
                pts = [(ax, y) for y in range(min(ay, by), max(ay, by) + 1)]
                pts += [(x, by) for x in range(min(ax, bx), max(ax, bx) + 1)]
            for x, y in pts:
                g[y][x] = "dfloor"
        for r in rooms:
            for y in range(r[1], r[3] + 1):
                for x in range(r[0], r[2] + 1):
                    g[y][x] = "dfloor"
        for a, b in zip(centers, centers[1:]):
            carve(a, b)
        for _ in range(2):                  # a loop or two, avoiding the end
            i, j = sorted(rng.sample(range(len(rooms) - 1), 2))
            carve(centers[i], centers[j])
        end = rooms[-1]
        ring = [(x, y) for x in range(end[0] - 1, end[2] + 2)
                for y in range(end[1] - 1, end[3] + 2)
                if not (end[0] <= x <= end[2] and end[1] <= y <= end[3])]
        openings = [(x, y) for x, y in ring if g[y][x] != "dwall"]
        if last and len(openings) != 1:
            continue
        break
    wall, floor = THEMES[info.theme]
    name = LEVEL_NAMES.get((lid, level), "level %d" % level)
    area = Area("dungeon", ("dun", lid, level), g, "%s, %s" % (
        cap(info.name), name), dark=True)
    area.skin = {"dwall": wall, "dfloor": floor}
    area.lead = lid
    area.vacuum = info.vacuum
    area.cold = info.cold
    sx, sy = centers[0]
    g[sy][sx] = "stairs_up"
    area.start = (sx, sy)
    ex, ey = centers[-1]
    floor_spots = [(x, y) for y in range(H) for x in range(W)
                   if g[y][x] == "dfloor"]
    end_cells = {(x, y) for x in range(end[0], end[2] + 1)
                 for y in range(end[1], end[3] + 1)}

    def free(n, far=6, within=None):
        spots = [p for p in (within or floor_spots)
                 if g[p[1]][p[0]] == "dfloor" and p not in area.items
                 and abs(p[0] - sx) + abs(p[1] - sy) >= far
                 and not area.mob_at(*p) and p not in area.bodies]
        return rng.sample(spots, min(n, len(spots)))

    if not last:
        g[ey][ex] = "stairs_down"
        area.down = (ex, ey)
    else:
        g[openings[0][1]][openings[0][0]] = "gate"
    if lid == "dig" and last:           # the Reliquary
        for x, y in end_cells:
            g[y][x] = "throat"
        area.throat = end_cells
        if "sealed" not in flags and "cantor_dead" not in flags:
            area.mobs.append(make_monster("cantor", ex, ey, boss=True))
    inner = [(x, y) for r in rooms[1:-1] for x in range(r[0] + 1, r[2])
             for y in range(r[1] + 1, r[3])]
    if info.hazard:
        for x, y in free(rng.randint(4, 8), 3, inner):
            g[y][x] = info.hazard
    if lid == "under":
        for x, y in free(rng.randint(2, 4), 3, inner):
            g[y][x] = "rad" if level == 2 else "steam"
    if lid == "reclaim":
        for x, y in free(rng.randint(3, 6), 3, inner):
            g[y][x] = "sludge"
    if lid == "dig" and level >= 2:
        for x, y in free(rng.randint(2, 4), 4, inner):
            g[y][x] = "crevasse"
    for n in range(rng.randint(2, 4)):          # crates and lockers
        x, y = rng.choice(inner or floor_spots)
        if g[y][x] != "dfloor" or (x, y) == (ex, ey) or (x, y) in end_cells:
            continue
        if "loot:%s:%d:%d:%d" % (lid, level, x, y) in flags:
            g[y][x] = "crate_open"
        else:
            g[y][x] = "crate"
            area.loot.add((x, y))
    lore = LORE.get((lid, level))
    if lore:
        for x, y in free(1, 5):
            area.items[(x, y)] = "note"
            area.note = lore
    # what's down here for the story
    special = []
    if (lid, level) == ("dig", 1) and "evidence:survey" not in flags:
        special.append(("corpse", "the foreman", ["survey"]))
    if (lid, level) == ("magdalene", 2) and "evidence:manifest" not in flags:
        special.append(("evidence", None, ["manifest"]))
    if (lid, level) == ("under", 1):
        r = rooms[len(rooms) // 2]
        area.scrubber = (r[0], r[1])
        g[r[1]][r[0]] = "scrubber" if "scrubbed" not in flags else \
            "scrubber_ok"
    if (lid, level) == ("under", 2):
        area.vesper = (ex, ey)
        g[ey][ex] = "vesper"
    for thing, (slid, slevel) in world["stash"].items():
        if (slid, slevel) == (lid, level) and "got:" + thing not in flags:
            special.append(("corpse", rng.choice((
                "a security officer", "a miner", "a tech in a hazard suit",
                "someone in Company coveralls")), [thing]))
    for e in world["errands"]:
        if e.get("lead") == lid and e.get("level") == level and \
                e["kind"] == "fetch" and "got:" + e["thing"] not in flags:
            special.append(("corpse", "Tomas Iwu" if e["id"] == "tags"
                            else "Annika Brandt", [e["thing"]]))
    for kind, who, things in special:
        far_spots = [p for p in floor_spots if p not in end_cells]
        for x, y in free(1, 10, far_spots):
            if kind == "corpse":
                area.items[(x, y)] = "corpse"
                area.bodies[(x, y)] = {"who": who, "things": things}
            else:
                area.items[(x, y)] = "evidence"
                area.bodies[(x, y)] = {"who": None, "things": things}
    for x, y in free(rng.randint(1, 2), 4):     # found by searching
        area.hidden[(x, y)] = rng.choice(("coins", "medkit", "ammo",
                                          "coins"))
    for x, y in free(rng.randint(1, 3), 5):
        area.traps.add((x, y))
    n = 1 + level + info.tier // 2
    for x, y in free(n, 8):
        if (x, y) in end_cells and last:
            continue
        kinds = info.monsters
        kind = kinds[min(len(kinds) - 1, rng.randrange(1 + level))] \
            if rng.random() < 0.7 else rng.choice(kinds)
        area.mobs.append(make_monster(kind, x, y, rng=rng))
    return area


