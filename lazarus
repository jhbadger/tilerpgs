        self.log.see("end")

    @staticmethod
    def the(mob):
        return mob.name if mob.boss or mob.role or mob.name[0].isupper() \
            else "the " + mob.name

    # ── Numbers ──

    def skill_of(self, skills):
        """The best of these Skills you have: (name, bonus)."""
        p = self.p
        best, bonus = None, 0
        for s in skills:
            r = p["skills"].get(s, 0)
            if r and s != p.get("lost_skill") and SKILL_BONUS[r] > bonus:
                best, bonus = s, SKILL_BONUS[r]
        return best, bonus

    def air_bad(self):
        return ("airbad" in self.flags and "scrubbed" not in self.flags and
                self.area.kind != "dungeon" and self.p["class"] != "Android")

    def mods(self, what):
        """Advantage (+) and Disadvantage (-) that come with you, for a
        Stat or Save: (net, why)."""
        p = self.p
        on, conds = p["on"], p["conds"]
        n, why = 0, []

        def add(k, w):
            nonlocal n
            n += k
            why.append(w)
        if "adrenaline" in on:
            add(1, "adrenaline")
        if "stim" in on:
            add(1, "stimpak")
        if "overwhelmed" in on:
            add(-1, "overwhelmed")
        if "heart" in on:
            add(-1, "your heart")
        if "dis" in on:
            add(-1, "hurt")
        if "cryosick" in on:
            add(-1, "cryosick")
        if self.air_bad():
            add(-1, "bad air")
        if what == "Speed":
            if "ankle" in conds or "leg" in conds:
                add(-1, "your leg")
            if ARMOUR[p["armour"]].heavy and p["ap"]:
                add(-1, "a heavy suit")
            if "sedated" in on:
                add(-1, "sedated")
        if what == "Combat":
            if "arm" in conds:
                add(-1, "your arm")
            if "shaky" in conds:
                add(-1, "shaking hands")
            if "eyes" in conds:
                add(-1, "half blind")
        if what == "Strength" and "ribs" in conds:
            add(-1, "your ribs")
        if what == "Intellect" and "concussion" in conds:
            add(-1, "concussion")
        if what == "Body" and "burns" in conds:
            add(-1, "burns")
        return n, why

    def check(self, what, skills=(), mod=0, adv=0, label=None, quiet=False,
              stress=True):
        """A Stat Check or a Save: d100 under the Stat or Save, plus the
        best Skill.  90-99 always fails; doubles are critical.  A failure is
        a point of Stress, and a critical failure a Panic Check.  Returns
        whether it worked; self.crit says if it was critical."""
        p = self.p
        base = p["stats"][what] if what in STATS else p["saves"][what]
        sk, bonus = self.skill_of(skills)
        target = base + bonus + mod
        a, why = self.mods(what)
        a += adv
        r1 = d100()
        r = r1
        if a:
            r2 = d100()
            ok1 = r1 < target and r1 < 90
            ok2 = r2 < target and r2 < 90
            if ok1 != ok2:
                r = (r1 if ok1 else r2) if a > 0 else (r2 if ok1 else r1)
            else:
                lo, hi = min(r1, r2), max(r1, r2)
                r = lo if a > 0 else hi
        ok = r < target and r < 90
        crit = r % 11 == 0
        if r == 0:
            ok = True
        if r == 99:
            ok = False
        if crit and ok and "doomed" in p["conds"]:
            ok = False
        self.crit = crit and ok
        critfail = crit and not ok
        if not quiet:
            what_s = what + (" + %s %d" % (sk, bonus) if sk else "") + (
                " %+d" % mod if mod else "")
            if a:
                what_s += ", %s (%s)" % ("[+]" if a > 0 else "[-]",
                                          ", ".join(why + (["help"] if adv
                                                           else [])))
            self.say("[%s%s: d100 %02d vs %d: %s]" % (
                label + ", " if label else "", what_s, r, target,
                "CRITICAL!" if self.crit else "success" if ok else
                "CRITICAL FAILURE" if critfail else "failure"), "roll")
        if not ok and stress:
            self.gain_stress(1, quiet=True)
        if critfail and stress:
            self.root.after(1, self.panic_check)
        return ok

    def gain_stress(self, n, why=None, quiet=False):
        p = self.p
        if n <= 0:
            return
        p["stress"] += n
        if why:
            self.say("%s (+%d Stress)" % (why, n), "mad")
        elif not quiet:
            self.say("(+%d Stress)" % n, "mad")
        if p["stress"] > 20:
            over = p["stress"] - 20
            p["stress"] = 20
            s = min(SAVES, key=lambda k: p["saves"][k])
            p["saves"][s] = max(0, p["saves"][s] - over)
            self.say("Too much. Something in you gives: -%d %s." % (over, s),
                     "bad")

    def lose_stress(self, n):
        p = self.p
        before = p["stress"]
        p["stress"] = max(p["minstress"], p["stress"] - n)
        return before - p["stress"]

    def panic_check(self, why=None):
        """A d20 over your Stress, or something gives."""
        p = self.p
        if self.overlay or "won" in self.flags:
            return
        a = -1 if "spiraling" in p["conds"] else 0
        if p["class"] == "Teamster" and p["teamster_day"] != self.day_no():
            p["teamster_day"] = self.day_no()
            a += 1
            self.say("(You've seen worse. Probably. Advantage.)", "info")
        r = random.randint(1, 20)
        if a:
            r2 = random.randint(1, 20)
            r = max(r, r2) if a > 0 else min(r, r2)
        held = r > p["stress"]
        self.say("[Panic Check%s: d20 %d vs Stress %d: %s]" % (
            ", " + why if why else "", r, p["stress"],
            "you hold it together" if held else "PANIC"), "roll")
        if held:
            return
        self.sound.play("horror")
        self.panic(random.randint(1, 20))
        if p["class"] == "Marine" and self.companion_here():
            self.companion_flees("Your panic goes through %s like a "
                                 "current.")
        self.render()

    def panic(self, n):
        p = self.p
        title, text = PANIC[n]
        self.say("%s. %s" % (title, text), "mad")
        on, conds = p["on"], p["conds"]

        def cond(c):
            if c not in conds:
                conds.append(c)
        if n == 1:
            on["adrenaline"] = 20
            self.lose_stress(roll("1d5"))
        elif n == 2:
            self.gain_stress(1, quiet=True)
        elif n == 3:
            self.gain_stress(1, quiet=True)
            if self.companion_here():
                self.companion_flees("%s backs away from you.")
        elif n == 4:
            on["overwhelmed"] = 10
            p["minstress"] += 1
        elif n == 5:
            cond("coward")
        elif n == 6:
            cond("frightened")
        elif n == 7:
            cond("nightmares")
        elif n == 8:
            have = [s for s in p["skills"] if s != p.get("lost_skill")]
            if have:
                p["lost_skill"] = random.choice(have)
                cond("lost_skill")
                self.say("(You've lost %s.)" % p["lost_skill"], "bad")
        elif n == 9:
            cond("shaky")
        elif n == 10:
            cond("doomed")
        elif n == 11:
            cond("paranoid")
        elif n == 12:
            cond("haunted")
        elif n == 13:
            on["deathwish"] = DAY
        elif n == 14:
            p["minstress"] += 2
            self.vision()
        elif n == 15:
            self.lose_stress(roll("1d10"))
            p["out"] = roll("2d10")
            self.walking = None
            self.busy = True
            self.root.after(300, self.out_step)
        elif n == 16:
            on["rage"] = 60
            if self.companion_here():
                self.companion_flees("%s doesn't like what they see in your "
                                     "face.")
        elif n == 17:
            cond("spiraling")
        elif n == 18:
            p["minstress"] += 1
            self.panic(random.randint(1, 17))
            self.panic(random.randint(1, 17))
        elif n == 19:
            p["maxwounds"] = max(1, p["maxwounds"] - 1)
            on["heart"] = 180
            p["minstress"] += 1
        elif n == 20:
            self.retire()
        p["stress"] = max(p["stress"], p["minstress"])

    def vision(self):
        """Prophetic: something true, that you'd rather not know."""
        w = self.world
        if "unmasked" not in self.flags and w["mimic"] not in self.taken:
            self.say(fill("You see {mimic_full}, very clearly, standing in "
                          "the dark at the foot of a bunk. {mimic_He} opens "
                          "{mimic_his} mouth, and keeps opening it, and "
                          "there is nothing inside but the Psalm.", w), "mad")
            self.flags.add("vision")
        else:
            self.say("You see the Reliquary, four kilometres down, and "
                     "something in it turning over in its sleep. It knows "
                     "where you are.", "mad")

    def companion_flees(self, text):
        role = self.p.get("companion")
        if not role:
            return
        mob = next((m for m in self.area.mobs if m.role == role), None)
        if mob and not self.check("Fear", quiet=True, stress=False) and \
                random.random() < 0.5:
            self.say((text % mob.name) + " %s goes back alone." % mob.name,
                     "bad")
            self.dismiss()

    def companion_here(self):
        return bool(self.p.get("companion")) and any(
            m.ally for m in self.area.mobs)

    # ── Time ──

    def now(self):
        return START + datetime.timedelta(minutes=self.turn)

    def day_no(self):
        return (self.now() - START.replace(hour=0)).days


    def date_text(self):
        t = self.now()
        return "Day %d, %02d:%02d" % (self.day_no() + 1, t.hour, t.minute)

    def phase(self):
        h = self.now().hour
        return ("night" if h >= 22 or h < 6 else "dawn" if h < 7 else
                "dusk" if h >= 19 else "day")

    def pass_time(self, minutes, quiet=False):
        """Time going by in a lump: resting, waiting, working."""
        before = self.phase()
        self.interrupt = False
        for _ in range(minutes // 30):
            self.turn += 30
            self.hourly()
            if self.overlay:
                return
            if self.interrupt:
                self.night_and_day()
                return
        self.turn += minutes % 30
        if not quiet and self.phase() != before:
            self.say("It's %s now: %s." % (self.phase(), self.date_text()),
                     "info")
        self.night_and_day()
        self.hourly()

    def hourly(self):
        """What the clock brings: the nightly taking, the air, the Due
        Diligence."""
        if self.overlay or "won" in self.flags:
            return
        t = self.now()
        day = self.day_no()
        key = "take:%d" % day
        if t.hour >= NIGHT_TAKE and t.hour < 6 and key not in self.flags \
                and day >= 1:
            self.flags.add(key)
            self.night_take()
        if day >= 1 and t.hour >= 7 and "morning:%d" % day not in \
                self.flags:
            self.flags.add("morning:%d" % day)
            self.morning()
        if self.turn >= 2 * DAY - 2 * 60 and "airbad" not in self.flags:
            self.flags.add("airbad")
            if "scrubbed" not in self.flags:
                self.say("VESPER, everywhere at once: 'Atmospheric advisory. "
                         "Carbon dioxide at four per cent. Personnel should "
                         "minimise exertion.' The air tastes of metal. Your "
                         "head aches.", "bad")
                self.learn("scrubbers")
        if self.turn >= DUE - 120 and "due_soon" not in self.flags:
            self.flags.add("due_soon")
            self.say("On every screen on the Ring: a contact, closing. "
                     "Halvorsen-Kade vessel DUE DILIGENCE. Docking in two "
                     "hours.", "quest")
        if self.turn >= DUE:
            self.due_diligence()

    def night_take(self):
        """02:00: the Second Skin goes walking, and someone doesn't come
        back."""
        w = self.world
        mimic = w["mimic"]
        if "unmasked" in self.flags or mimic in self.taken or \
                mimic in self.dead:
            return
        aboard = mimic in self.aboard
        home = {r: s for s, (_, _, cast) in
                ((s, ROOMS[SITES[s][1]]) for s in SITES)
                for r in cast.values()}
        here = self.area.site if self.area.kind == "inside" else None
        pool = [r for r in SAVEABLE if r != mimic and not self.gone(r) and
                not w["people"][r]["young"] and r != self.p.get("companion")
                and r not in ("pilot",) and
                ((r in self.aboard) == aboard) and
                (aboard or home.get(r) not in SAFE_PLACES)]
        if not pool:
            return
        rng = random.Random("%s:night:%d" % (w["seed"], self.day_no()))
        victim = rng.choice(pool)
        watched = [r for r in pool if here and home.get(r) == here and
                   here not in SAFE_PLACES]
        if watched and rng.random() < 0.6:
            victim = rng.choice(watched)     # it comes where you are
        vsite = "patience" if aboard else home.get(victim)
        if here and here == vsite:
            self.caught_in_the_act(victim)
            return
        self.taken.append(victim)
        if victim in self.aboard:
            self.aboard.remove(victim)
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "bld"
                      or k == self.area.key}
        if self.area.kind == "inside":
            self.area.mobs = [m for m in self.area.mobs
                              if m.role != victim]
        self.flags.add("missing:" + victim)

    def caught_in_the_act(self, victim):
        """You're there when it happens."""
        w = self.world
        self.say(fill("You wake, or think you do. In the red night light "
                      "{mimic_full} is standing over %s, very close, mouth "
                      "to mouth, and the humming is coming out of "
                      "{mimic_him}. Then {mimic_he} turns and looks at you, "
                      "and smiles, and keeps smiling, wider than a mouth "
                      "goes." % w["people"][victim]["name"], w), "bad")
        self.sound.play("horror")
        mob = next((m for m in self.area.mobs if m.mimic), None)
        if mob is None:
            x, y = self.pos
            spot = next(((x + dx, y + dy) for dx, dy in DIRS
                         if self.area.inside(x + dx, y + dy) and
                         self.area.grid[y + dy][x + dx] in INSIDE_FLOOR and
                         not self.area.mob_at(x + dx, y + dy)), None)
            if spot is None:
                return
            mob = make_person(w, w["mimic"], *spot)
            self.area.mobs.append(mob)
        self.unmask(mob)
        self.p["out"] = 0
        self.busy = False
        self.interrupt = True

    def morning(self):
        """A new day: who's missing."""
        w = self.world
        day = self.day_no()
        gone = [r for r in self.taken if "told:" + r not in self.flags]
        for r in gone:
            self.flags.add("told:" + r)
            self.say(fill("Day %d. Nobody has seen %s since last night. %s "
                          "bunk is empty and cold." % (
                              day + 1, w["people"][r]["name"],
                              cap(fill("{%s_his}" % r, w))), w), "bad")
            self.gain_stress(1, quiet=True)
        if not gone:
            self.say("Day %d. The night shift lights come up to white. "
                     "Everyone is where they were. You count twice to be "
                     "sure." % (day + 1), "info")
        left = DUE - self.turn
        if left > 0:
            self.say("The Due Diligence docks in %d hours." % (left // 60),
                     "quest")

    def night_and_day(self):
        """At night the Ring dims to red and the hollowed walk it."""
        city = self.cache.get(("city",))
        if not city:
            return
        night = self.phase() == "night"
        here = getattr(self, "area", None)
        px, py = self.pos if here is city else (-99, -99)
        if night:
            for m in city.folk:
                if m not in city.mobs and not city.mob_at(m.x, m.y):
                    city.mobs.append(m)
        else:
            city.mobs = [m for m in city.mobs if m not in city.folk or
                         abs(m.x - px) + abs(m.y - py) <= 6]

    # ── Turns ──

    def on_key(self, ev):
        if self.talk or self.busy or ev.state & 0x0C:
            return
        k = ev.keysym
        self.walking = None
        if self.menu:
            k = k[3:] if k.startswith("KP_") else k
            if k in ("Up", "w", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "space", "KP_Enter"):
                self.menu_pick()
            elif k.isdigit() and 1 <= int(k) <= len(self.menu["items"]):
                self.menu_pick(int(k) - 1)
            else:
                self.menu_cancel()
            return
        if self.overlay:
            if self.overlay in ("won", "doom") and k in ("n", "N"):
                self.new_game()
            elif self.overlay not in ("won", "doom") or k in ("Escape",
                                                              "Return"):
                self.close_overlay()
            return
        if self.aim:
            if k in MOVE_KEYS:
                self.aimed(*MOVE_KEYS[k])
            else:
                self.aim = None
                self.say("Never mind.", "info")
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("e", "E"):
            self.search()
        elif k in ("f", "F"):
            self.ready_fire()
        elif k in ("r", "R"):
            self.reload()
        elif k in ("u", "U"):
            self.use_menu()
        elif k in ("space", "period", "KP_5"):
            self.wait()
        elif k in ("i", "I"):
            self.show_sheet()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def close_overlay(self):
        if self.overlay in ("won", "doom"):
            self.action_menu()
            return
        self.overlay = None
        self.render()

    def ready(self):
        return bool(getattr(self, "area", None)) and not (
            self.busy or self.talk or self.overlay or self.menu)


    def can_stand(self, x, y):
        return self.area.grid[y][x] in WALKABLE

    def move(self, dx, dy):
        if not self.ready():
            return
        p = self.p
        if p["held"]:
            if self.check("Strength", ("Athletics", "Hand-to-Hand Combat"),
                          label="breaking free"):
                p["held"] = 0
                self.say("You wrench yourself free!", "good")
            else:
                self.say("It's got you. You can't break its grip.", "bad")
            self.end_turn()
            return
        r = self.step(dx, dy)
        if r in ("moved", "turn"):
            slow = self.area.kind == "dungeon" and self.underfoot(*self.pos)
            if "leg" in p["conds"]:
                slow = True
            self.end_turn()
            if slow and not self.busy and not self.overlay:
                self.end_turn()

    TOUCHABLE = {"bed", "locker", "terminal", "table", "counter", "desk",
                 "medpod", "cryopod", "shelf", "crate", "pew", "altar",
                 "taps", "stove", "tray", "window", "safe", "morgue",
                 "rack", "vesper", "gate", "viewport", "console", "pipes",
                 "crates", "foam", "placard", "module", "module2", "module3",
                 "hull", "scrubber", "scrubber_ok", "wall", "pool"}

    def step(self, dx, dy):
        """One square: "moved", "turn" (something took the turn), "done"
        (handled) or "blocked"."""
        a = self.area
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if a.kind == "inside":
                self.go_outside()
            else:
                self.bump()
            return "done"
        mob = a.mob_at(x, y)
        if mob:
            if mob.hostile or mob.down:
                self.attack(mob)
                self.end_turn()
            elif mob.pet is not None:
                self.catch_pet(mob)
            elif mob.ally:
                mob.x, mob.y, self.pos = self.pos[0], self.pos[1], [x, y]
                return "moved"
            else:
                self.start_talk(mob)
            return "done"
        t = a.grid[y][x]
        if t == "counter":
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return "done"
        link = a.links.get((x, y))
        if link and t in ("hatch", "airlock", "lift", "downhatch",
                          "bulkhead", "umbilical", "sluice"):
            self.enter_link(link, x, y)
            return "done"
        if t in self.TOUCHABLE and not self.can_stand(x, y):
            self.touch(t, x, y)
            return "done"
        if not self.can_stand(x, y):
            self.bump()
            return "done"
        self.pos = [x, y]
        if t == "exit":
            self.go_outside()
            return "done"
        if t == "stairs_down":
            self.change_level(1)
            return "done"
        if t == "stairs_up":
            self.change_level(-1)
            return "done"
        if self.step_on(x, y):
            return "turn"
        return "moved"

    def bump(self):
        self.say("Blocked.", "info")
        self.sound.play("bump")


    def underfoot(self, x, y):
        """The hazards below; True if it's slow going."""
        a, p = self.area, self.p
        prot = ARMOUR[p["armour"]].protects if p["ap"] else ""
        if (x, y) in a.traps:
            a.traps.discard((x, y))
            a.items[(x, y)] = "trap"
            if self.check("Speed", ("Athletics",), label="a live cable"):
                self.say("A live cable, sparking in the dark. You jerk back "
                         "in time.", "good")
            else:
                self.flash(x, y)
                self.hurt(roll("1d10"), "Blunt Force", "A live cable! The "
                          "shock throws you down")
                self.alert(10)
        t = a.grid[y][x]
        if t == "slush":
            return True
        if t == "crevasse":
            if not self.check("Speed", ("Athletics", "Zero-G"),
                              label="the crevasse"):
                self.hurt(roll("2d10"), "Blunt Force", "The ice gives way. "
                          "You drop into the crevasse and hit the side")
                self.gain_stress(1, quiet=True)
            return True
        if t == "steam":
            if "rad" not in prot and not self.check("Body", quiet=True):
                self.hurt(roll("1d5"), "Fire", "A jet of steam")
            return False
        if t == "rad":
            if "rad" in prot or "radpills" in p["on"] or \
                    p["class"] == "Android":
                return False
            if not self.check("Body", quiet=True):
                self.hurt(roll("1d5"), "Fire", "Radiation, through your "
                          "skin like heat")
                p["on"]["sick"] = 30
            return False
        if t == "blood":
            if "blood:%s" % (a.key,) not in self.flags:
                self.flags.add("blood:%s" % (a.key,))
                self.gain_stress(1, "The floor is tacky with old blood, "
                                 "drag marks, handprints.")
            return False
        if t == "breach":
            if not self.check("Strength", ("Zero-G",), label="the breach"):
                self.hurt(roll("1d10"), "Blunt Force", "The breach drags at "
                          "you, slams you into the frame")
            return True
        if t in ("water", "sludge"):
            if t == "sludge" and "sick" not in p["on"] and \
                    not self.check("Body", quiet=True):
                p["on"]["sick"] = 30
                self.say("The sludge gets in your mouth. You retch.", "bad")
            return True
        return False

    @staticmethod
    def floor_spots(a):
        if not hasattr(a, "floor_cache"):
            a.floor_cache = [(x, y) for y in range(a.h) for x in range(a.w)
                             if a.grid[y][x] == "dfloor"]
        return a.floor_cache


    def alert(self, r):
        a = self.area
        px, py = self.pos
        for m in a.mobs:
            if m.hostile and abs(m.x - px) + abs(m.y - py) <= r:
                m.aware = True

    def end_turn(self):
        p, a = self.p, self.area
        if p["health"] is None:
            return
        before = self.phase()
        self.turn += 1
        now = self.phase()
        if now != before:
            if a.kind == "city":
                self.say({"dawn": "The Ring's lights come up from red to "
                                  "white. Day shift. Nobody's on it.",
                          "day": "VESPER announces the shift change, to "
                                 "nobody.",
                          "dusk": "The lights dim towards the night shift.",
                          "night": "Night shift. The corridor lights drop "
                                   "to red, and the humming in the walls "
                                   "gets louder."}[now], "info")
            self.night_and_day()
        if self.turn % 30 == 0:
            self.hourly()
            if self.overlay:
                return
        for k in list(p["on"]):
            p["on"][k] -= 1
            if p["on"][k] <= 0:
                del p["on"][k]
                self.wears_off(k)
        self.body_turn()
        if self.overlay or p["health"] is None:
            return
        self.render()
        self.first_sight()
        for mob in list(a.mobs):
            if self.overlay or p["health"] is None or self.p is not p:
                return
            if mob not in a.mobs or self.area is not a:
                continue
            if mob.ally:
                self.ally_act(mob)
            elif mob.down:
                self.mimic_rises(mob)
            elif mob.hostile:
                self.monster_act(mob)
            else:
                self.wander(mob)
            if self.overlay or self.area is not a:
                return
        if a.kind == "city":
            self.spawn_city()
        self.hum()
        self.render()

    def wears_off(self, k):
        text = {"adrenaline": "The adrenaline drains away. You're shaking.",
                "stim": "The stimpak wears off.",
                "overwhelmed": "You can think again. A bit.",
                "radpills": "The radiation pills wear off.",
                "chem": "Your chemlight gutters out.",
                "sedated": "The sedatives wear off.",
                "rage": "The rage burns out.",
                "cryosick": "The cryo fog clears from your head.",
                "heart": "Your heart settles into something like a "
                         "rhythm."}.get(k)
        if text:
            self.say(text, "info")

    def body_turn(self):
        """Air, cold, bleeding, burning, dying."""
        p, a = self.p, self.area
        prot = ARMOUR[p["armour"]].protects if p["ap"] else ""
        if a.vacuum and p["class"] != "Android":
            if p["punctured"]:
                p["decomp"] = p.get("decomp", roll("1d5") + 1) - 1
                if p["decomp"] > 0:
                    self.say("Your suit is punctured: air screams out of it. "
                             "(%d turns. Patch it, or get out!)" %
                             p["decomp"], "bad")
                else:
                    n = roll("1d10")
                    if self.check("Body", quiet=True, stress=False):
                        n //= 2
                    self.hurt(n, "Blunt Force", "Decompression", raw=True)
            elif p["air"] > 0:
                p["air"] -= 1
                if p["air"] in (30, 10):
                    self.say("Your suit chimes: %d minutes of air." %
                             p["air"], "bad")
            else:
                n = roll("1d10")
                if self.check("Body", quiet=True, stress=False):
                    n //= 2
                self.hurt(n, "Blunt Force", "You're out of air. Your lungs "
                          "burn", raw=True)
        if a.cold and "cold" not in prot and self.turn % 30 == 0 and \
                p["class"] != "Android":
            if not p["items"].get("mylar blanket") and \
                    not self.check("Body", quiet=True):
                self.hurt(1, "Blunt Force", "The cold gets into your bones",
                          raw=True)
        if p["bleed"]:
            self.hurt(p["bleed"], "Bleeding", "You're bleeding", raw=True)
            if self.p is p and p["bleed"] and self.turn % 10 == 0 and \
                    self.check("Body", quiet=True, stress=False):
                p["bleed"] -= 1
                self.say("The bleeding slows." if p["bleed"] else
                         "The bleeding stops.", "info")
        if p["burning"]:
            p["burning"] -= 1
            self.hurt(roll("1d10"), "Fire", "You're on fire", raw=True)
            if p["burning"] and self.check("Body", quiet=True):
                p["burning"] = 0
                self.say("You beat the flames out.", "good")
        if p["dying"]:
            p["dying"] -= 1
            if p["dying"] <= 0:
                self.say("You can't hold on any longer.", "bad")
                self.death_save()
            elif p["dying"] <= 3:
                self.say("You're dying. Treat it: a first aid kit, a "
                         "stimpak, a medpod. (%d turns)" % p["dying"], "bad")

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        if t in ("water", "pool") and mob.kind and \
                "swim" not in MONSTERS[mob.kind].traits and \
                random.random() < 0.5:
            return False
        if a.kind == "city":
            return t in CITY_GROUND
        if a.kind == "inside":
            return t in INSIDE_FLOOR
        return t in DUNGEON_FLOOR and t not in ("stairs_up", "stairs_down")

    def monster_act(self, mob):
        m = MONSTERS[mob.kind]
        if mob.burning:
            mob.burning -= 1
            self.wound(mob, roll("1d10"), "%s burns" % cap(self.the(mob)),
                       fire=True, quiet_miss=True)
            if mob not in self.area.mobs or mob.down:
                return
        if mob.stuck:
            mob.stuck -= 1
            if not mob.stuck:
                self.say("%s moves again." % cap(self.the(mob)), "bad")
            return
        if "still" in m.traits:
            px, py = self.pos
            if abs(mob.x - px) + abs(mob.y - py) == 1:
                self.monster_attack(mob)
            elif m.ranged and (mob.x, mob.y) in self.visible and \
                    random.random() < 0.5:
                self.monster_ranged(mob)
            return
        if "slow" in m.traits and self.turn % 2:
            return
        steps = 2 if "fast" in m.traits else 1
        for _ in range(steps):
            if mob not in self.area.mobs or not mob.hostile or \
                    self.p["out"] or self.overlay:
                return
            if self.monster_step(mob, m) or self.p["health"] is None:
                return

    def monster_step(self, mob, m):
        """One move; True if it attacked (and so is done)."""
        a = self.area
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if not mob.aware:
            sneak = self.check("Speed", ("Athletics",), quiet=True,
                               stress=False)
            if dist <= 1 or ((mob.x, mob.y) in self.visible and dist <= 7
                             and not sneak):
                mob.aware = True
            else:
                self.drift(mob)
                return False
        if mob.flee > 0:
            mob.flee -= 1
            for sx, sy in sorted(DIRS, key=lambda d: -abs(px - mob.x - d[0])
                                 - abs(py - mob.y - d[1])):
                if self.can_go(mob, mob.x + sx, mob.y + sy):
                    mob.x += sx
                    mob.y += sy
                    break
            return False
        if dist == 1:
            self.monster_attack(mob)
            return True
        if (m.ranged and (dx == 0 or dy == 0) and dist <= 8
                and self.line_clear(a, mob.x, mob.y, px, py)
                and random.random() < 0.5):
            self.monster_ranged(mob)
            return True
        chase = dist <= 14
        if "erratic" in m.traits and random.random() < 0.4:
            chase = False
        if chase:
            order = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                           abs(py - mob.y - d[1]) + random.random() * 0.5)
        else:
            order = [random.choice(DIRS)]
        for sx, sy in order[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break
        return False

    def drift(self, mob):
        if random.random() < 0.3:
            sx, sy = random.choice(DIRS)
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy

    def wander(self, mob):
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        a = self.area
        if (a.inside(x, y) and a.grid[y][x] in mob.roam
                and not a.mob_at(x, y) and [x, y] != self.pos
                and not any((x + ex, y + ey) in a.links for ex, ey in DIRS)
                and (mob.home is None or abs(x - mob.home[0]) +
                     abs(y - mob.home[1]) <= 5)):
            mob.x, mob.y = x, y


    def spawn_city(self):
        """The night shift: the hollowed walk the Ring, more of them as the
        nights go on."""
        a = self.area
        px, py = self.pos
        a.mobs = [m for m in a.mobs if not m.hostile or m.boss or
                  m.mimic or abs(m.x - px) + abs(m.y - py) <= 26]
        if self.phase() != "night":
            return
        if random.random() > 0.03:
            return
        if sum(m.hostile for m in a.mobs) >= 2 + self.day_no():
            return
        kinds = ["hollow"] * 3 + ["ratknot", "hound"]
        for _ in range(20):
            x = px + random.randint(-12, 12)
            y = py + random.randint(-12, 12)
            if (not a.inside(x, y) or a.grid[y][x] not in CITY_GROUND
                    or (x, y) in self.visible or a.mob_at(x, y)
                    or abs(x - px) + abs(y - py) < 8):
                continue
            m = make_monster(random.choice(kinds), x, y)
            if m.kind == "hollow":
                m.tile = random.choice(("hollow", "hollow1", "hollow2"))
            a.mobs.append(m)
            return

    def hum(self):
        """The Psalm, in the walls and in the hollowed."""
        p, a = self.p, self.area
        if p["class"] == "Android" or self.overlay:
            return
        if "tooth_home" in self.flags and "sealed" in self.flags:
            return
        near = [m for m in a.mobs if m.hostile and m.kind and
                "hum" in MONSTERS[m.kind].traits and
                (m.x, m.y) in self.visible and
                abs(m.x - self.pos[0]) + abs(m.y - self.pos[1]) <= 6]
        loud = any(m.kind == "cantor" for m in near) or \
            getattr(a, "throat", None) and tuple(self.pos) in a.throat
        every = 5 if loud else 15
        if "the tooth" in p["items"]:
            every = min(every, 60)
            near = near or ["tooth"]
        if near and self.turn % every == 0:
            self.flash(*self.pos, "song")
            if not self.check("Sanity", ("Xenoesotericism", "Mysticism",
                                         "Theology"), label="the Psalm",
                              stress=False):
                self.gain_stress(1, "The Psalm gets in behind your eyes.")
                if p["class"] == "Scientist" and self.companion_here():
                    self.companion_flees("%s sees your face and won't stay.")

    # ── Fighting ──

    def melee_weapon(self):
        p = self.p
        w = p["weapon"]
        if w in WEAPONS and "melee" in WEAPONS[w].special and \
                p["items"].get(w):
            return w
        for w in ("vibechete", "boarding axe", "crowbar", "assorted tools",
                  "scalpel"):
            if p["items"].get(w):
                return w
        return "fists"

    def attack(self, mob):
        """Up close: whatever's in your hands."""
        p = self.p
        if not mob.hostile and not mob.down:
            return
        if "coward" in p["conds"] and not self.check(
                "Fear", label="making yourself fight"):
            self.say("You can't. You can't make yourself go near it.", "mad")
            return
        w = self.melee_weapon()
        info = WEAPONS[w]
        if not self.check("Combat", ("Hand-to-Hand Combat",),
                          label="fighting with " + (
                              "your fists" if w == "fists" else "the " + w)):
            self.say("You swing at %s and miss." % self.the(mob), "info")
            self.sound.play("miss")
            return
        dmg = max(1, p["stats"]["Strength"] // 10) if info.dmg == "str" \
            else roll(info.dmg)
        if "rage" in p["on"]:
            dmg = max(dmg, roll(info.dmg) if info.dmg != "str" else dmg)
        self.hit_mob(mob, dmg, info, "You %s %s" % (
            random.choice(("hit", "strike", "catch")), self.the(mob)))

    def hit_mob(self, mob, dmg, info, text):
        m = MONSTERS.get(mob.kind)
        if self.crit:
            dmg *= 2
        fire = "fire" in info.special
        if m and m.ap and "aa" not in info.special and dmg < m.ap:
            self.say(text + ", and it glances off the armour.", "info")
            self.sound.play("miss")
            return
        if m and m.ap and "aa" not in info.special:
            dmg -= m.ap
        if "stun" in info.special and random.random() < 0.5:
            mob.stuck = max(mob.stuck, 1)
        if "tranq" in info.special and dmg and random.random() < 0.5 and \
                mob.kind not in ("drone", "cantor"):
            mob.stuck = max(mob.stuck, roll("1d10"))
            text += " (it slumps, tranquillized)"
        if "stick" in info.special:
            mob.stuck = max(mob.stuck, 3)
            text += " (foam glues it in place)"
        if fire and mob.kind not in ("drone",) and random.random() < 0.6:
            mob.burning = 3
            text += ", and it catches fire"
        self.wound(mob, dmg, text, fire=fire)

    def wound(self, mob, n, text, fire=False, quiet_miss=False):
        if n <= 0:
            if not quiet_miss:
                self.say(text + ", to no effect.", "bad")
                self.sound.play("miss")
            return
        if mob.down:
            if fire:
                self.say(text + ".", "good")
                self.kill(mob, fire=True)
            else:
                self.say(text + ". It twitches.", "info")
            return
        mob.health -= n
        mob.aware = True
        self.flash(mob.x, mob.y, "flame" if fire else "hit")
        self.say(text + ". (%d damage)" % n, "good")
        if mob.health <= 0:
            self.kill(mob, fire=fire or mob.burning > 0)
        else:
            self.sound.play("hit")

    def kill(self, mob, fire=False):
        a = self.area
        m = MONSTERS.get(mob.kind)
        if m and "rise" in m.traits and not fire:
            mob.down = 3
            mob.hostile = False
            mob.health = 0
            self.say("%s goes down in a heap. It's still humming." %
                     cap(self.the(mob)), "bad")
            self.sound.play("kill")
            return
        if mob in a.mobs:
            a.mobs.remove(mob)
        self.p["kills"] += 1
        self.sound.play("kill")
        if mob.kind == "cantor":
            self.flags.add("cantor_dead")
            self.say("The Cantor's song breaks, on a note that goes on in "
                     "your teeth for a long time after. The great throat "
                     "sags. It isn't dead. Things like this don't die. But "
                     "it's quiet.", "quest")
            self.gain_stress(2, quiet=True)
            return
        if mob.kind == "mimic":
            self.flags.add("skin_dead")
            self.learn("skin_dead")
            self.say("The Second Skin burns. It burns for a long time, and "
                     "it sings while it burns, and then it stops. What's "
                     "left is ash, and a smell like a struck match.",
                     "quest")
            return
        if mob.kind == "deserter":
            self.say("The miner falls, and doesn't get up. They were only "
                     "frightened.", "bad")
            self.gain_stress(2, quiet=True)
            return
        if mob.was:
            who = self.world["people"][mob.was]["name"]
            self.say("%s falls %s. Whatever %s was, %s isn't any more." % (
                who, "burning" if fire else "and stays down, for now",
                fill("{%s_he}" % mob.was, self.world), fill(
                    "{%s_he}" % mob.was, self.world)), "good")
            if mob.was not in self.dead:
                self.dead.append(mob.was)
            if mob.was in self.taken:
                self.taken.remove(mob.was)
            a.items[(mob.x, mob.y)] = "corpse"
            a.bodies[(mob.x, mob.y)] = {"who": who, "things": []}
            return
        self.say("%s goes down%s." % (cap(self.the(mob)), " in flames" if
                                       fire else ""), "good")
        if m and "hollow" in m.traits and random.random() < 0.35:
            a.items[(mob.x, mob.y)] = random.choice(("ammo", "coins",
                                                     "medkit"))

    def mimic_rises(self, mob):
        mob.down -= 1
        if mob.down <= 0:
            mob.down = 0
            mob.hostile = True
            mob.health = MONSTERS["mimic"].health // 2
            self.say("The Second Skin gets back up. Of course it does. "
                     "(Only fire keeps it down.)", "bad")
            self.gain_stress(1, quiet=True)
            self.learn("fire", quiet=True)

    def monster_attack(self, mob):
        p = self.p
        m = MONSTERS[mob.kind]
        name = cap(self.the(mob))
        if d100() >= m.combat:
            self.say("%s %s, and misses." % (name, "lunges" if
                                             "talker" not in m.traits
                                             else "swings"), "good")
            self.sound.play("miss")
            return
        before = p["health"], p["wounds"]
        self.hurt(roll(m.dmg), m.wound, "%s %s you" % (name, random.choice(
            ("claws", "tears at", "slams into", "grabs at")
            if "talker" not in m.traits else ("hits", "punches"))))
        if (p["health"] or 0) > 0 and "grab" in m.traits and \
                not p["held"]:
            p["held"] = 1
            self.say("It has hold of you. (Move to break free.)", "bad")
        if p["health"] is not None and "bleed" in m.traits and \
                (p["health"], p["wounds"]) != before and \
                random.random() < 0.3:
            p["bleed"] += 1
            self.say("You're bleeding.", "bad")

    def monster_ranged(self, mob):
        m = MONSTERS[mob.kind]
        combat, dmg, wound, what = m.ranged
        name = cap(self.the(mob))
        self.sound.play("shot" if wound == "Gunshot" else "spell")
        self.fly(self.line_path((mob.x, mob.y), tuple(self.pos)),
                 "bolt" if wound == "Gunshot" else "song")
        if d100() >= combat:
            self.say("%s %s you, and misses." % (name, what), "info")
            return
        if mob.kind == "cantor":
            if not self.check("Sanity", ("Xenoesotericism", "Mysticism"),
                              label="its song", stress=False):
                self.gain_stress(roll("1d5"), "The Cantor sings at you, "
                                 "and the song goes all the way through.")
            return
        self.hurt(roll(dmg), wound, "%s %s you" % (name, what))

    def hurt(self, n, wtype, text, raw=False, aa=False):
        """Damage: Damage Reduction, then armour, then Health; at zero, a
        Wound."""
        p = self.p
        if n <= 0 or p["health"] is None:
            return
        if not raw:
            arm = ARMOUR[p["armour"]]
            if p["ap"] and arm.dr:
                n -= arm.dr
            if p["ap"] and not aa and n < p["ap"]:
                self.say("%s, but your %s takes it." % (text, p["armour"]),
                         "info")
                self.sound.play("miss")
                return
            if p["ap"] and p["armour"] not in ("crew attire", "lab coat",
                                               "scrubs"):
                self.say("Your %s is wrecked!" % p["armour"], "bad")
                if arm.air and self.area.vacuum:
                    p["punctured"] = True
                n -= 0 if aa else p["ap"]
                p["ap"] = 0
                if n <= 0:
                    return
        p["health"] -= n
        self.say("%s! (%d damage)" % (text, n), "bad")
        self.flash(*self.pos)
        self.sound.play("hurt")
        while p["health"] is not None and p["health"] <= 0 and self.p is p:
            carry = p["health"]
            self.take_wound(wtype)
            if self.p is not p or p["health"] is None:
                return
            p["health"] = p["maxhp"] + carry

    def take_wound(self, wtype):
        """Health has run out: a Wound, rolled on the table."""
        p = self.p
        p["wounds"] += 1
        r = random.randint(0, 9)
        what, bleed, sev, cond, stress, minst, dis = WOUNDS[wtype][r]
        self.say("WOUND (%s, d10 %d): %s.%s" % (
            wtype, r, what, " Bleeding +%d." % bleed if bleed else ""), "bad")
        self.sound.play("death")
        p["bleed"] += bleed
        if cond and cond not in p["conds"]:
            p["conds"].append(cond)
        if stress:
            self.gain_stress(stress, quiet=True)
        p["minstress"] += minst
        if dis:
            p["on"]["dis"] = max(p["on"].get("dis", 0), dis)
        if r == 0 and wtype in ("Blunt Force", "Gunshot"):
            p["held"] = 0
            p["out"] = 1
        if wtype == "Fire" and sev == 3:
            p["burning"] = 3
        if sev == 5:
            self.die("torn apart")
            return
        if sev == 4:
            self.death_save()
            return
        if sev == 3 and not p["dying"]:
            p["dying"] = roll("1d10")
            self.say("That's lethal, if nobody does anything. You have %d "
                     "turns." % p["dying"], "bad")
        if p["wounds"] >= p["maxwounds"]:
            self.say("That's as much as a body can take.", "bad")
            self.death_save()
            return
        if p["out"]:
            self.walking = None
            self.busy = True
            self.root.after(300, self.out_step)

    def death_save(self):
        p = self.p
        r = random.randint(0, 9)
        self.say("[Death Save: d10 %d]" % r, "roll")
        if r == 0:
            loss = roll("1d5")
            p["maxhp"] = max(1, p["maxhp"] - loss)
            p["wounds"] = max(0, p["maxwounds"] - 1)
            p["dying"] = 0
            p["bleed"] = 0
            p["health"] = max(1, p["maxhp"] // 2)
            p["out"] = roll("2d10")
            self.say("Everything goes black... and comes back, slowly. "
                     "You're alive. You shouldn't be. (-%d maximum Health)" %
                     loss, "bad")
            self.walking = None
            self.busy = True
            self.root.after(300, self.out_step)
        elif r <= 2:
            p["dying"] = roll("1d5")
            p["wounds"] = max(0, p["maxwounds"] - 1)
            p["health"] = 1
            self.say("You're dying. You have %d turns unless something is "
                     "done." % p["dying"], "bad")
        else:
            self.die("dead" if r >= 5 else "comatose")

    def out_step(self):
        p = self.p
        if self.overlay:
            self.busy = False
            return
        if p["out"] <= 0:
            self.busy = False
            self.come_to()
            return
        self.busy = False
        self.end_turn()             # still out: nothing hits you now
        p["out"] -= 1
        if not self.overlay:
            self.busy = True
            self.root.after(250, self.out_step)
        else:
            self.busy = False


    def come_to(self):
        self.say("You come round. You don't know how long you were out.",
                 "good")
        self.render()

    def door_of(self, sid):
        """The square outside a module's hatch."""
        city = self.get_area(("city",))
        for (x, y), link in city.links.items():
            if link == ("bld", sid):
                for dx, dy in ((0, 1), (1, 0), (-1, 0), (0, -1)):
                    if city.inside(x + dx, y + dy) and \
                            city.grid[y + dy][x + dx] in CITY_GROUND:
                        return x + dx, y + dy
        return city.start

    # ── Death, and the next of the crew ──

    def retire(self):
        p = self.p
        self.say("%s walks back to the Patience, very calmly, climbs into a "
                 "cryopod and closes the lid, and does not answer when you "
                 "knock." % p["name"], "bad")
        self.die("retired")

    def die(self, how):
        """You're gone.  The next of the Patience's crew wakes up."""
        p = self.p
        a = self.area
        p["health"] = None
        p["dying"] = p["bleed"] = p["burning"] = p["out"] = 0
        self.crew_lost.append(p["name"])
        self.flags.add("crew_dead")
        self.busy = True                # nothing more until the next pod
        self.walking = None
        self.sound.play("death")
        if how != "retired":
            things = [k for k, v in p["items"].items() for _ in range(v)]
            pos = tuple(self.pos)
            a.items[pos] = "corpse"
            self.remains_add(a.key, pos, p["name"], things)
            self.say({"dead": "%s is dead.", "torn apart": "%s is dead, all "
                      "at once.", "comatose": "%s slips into a coma, and "
                      "doesn't come back."}[how] % p["name"], "bad")
        crew = [c for c in self.world["crew"] if c not in self.crew_lost]
        if not crew:
            self.busy = False
            self.doom("crew")
            return
        self.say("...", "info")
        self.root.after(600, lambda: self.next_crew(crew[0]))

    def remains_add(self, key, pos, who, things):
        """Your crew's bodies stay where they fell, with their kit."""
        r = {"key": list(key), "pos": list(pos), "who": who,
             "things": things}
        self.remains.append(r)
        self.area.bodies[tuple(pos)] = r

    def next_crew(self, name):
        sex = "F" if name.split()[0] in FIRST_F else "M"
        if not getattr(self, "headless", False):
            self.ask_crew(lambda w: self.next_crew_go(name, sex, w),
                          "The next pod opens")
            return
        self.next_crew_go(name, sex, None)

    def next_crew_go(self, name, sex, who):
        if who is None:
            who = self.default_crew(name, sex)
        who["name"] = name
        who["sex"] = sex
        lost = self.crew_lost
        self.p = self.make_crew(who)
        self.p["on"]["cryosick"] = 60
        self.busy = False
        self.cache = {k: v for k, v in self.cache.items() if k[0] == "city"}
        area = self.get_area(("bld", "patience"))
        self.city_pos = list(self.door_of("patience"))
        self.area, self.pos = area, list(self.bed_spot(area))
        self.say("A cryopod hisses open. %s, coming up out of the cold, "
                 "with cryo-fog in the head and no idea how long it's been. "
                 "The tug's computer tells you: %s. %s." % (
                     name, self.date_text(), "; ".join(
                         "%s is gone" % n for n in lost)), "quest")
        self.layout()
        self.save()

    # ── First sight ──

    def first_sight(self):
        """Seeing a horror for the first time: a Save, and maybe a Panic
        Check."""
        a, p = self.area, self.p
        for m in a.mobs:
            if not m.hostile or not m.kind or (m.x, m.y) not in self.visible:
                continue
            mon = MONSTERS[m.kind]
            if m.kind in a.scared:
                continue
            a.scared.add(m.kind)
            first = "seen:" + m.kind not in self.flags
            self.flags.add("seen:" + m.kind)
            fright = "frightened" in p["conds"] and "hollow" in mon.traits
            if not first and not m.boss and not fright:
                continue
            self.say("You see %s!" % (self.the(m) if m.boss or m.was else
                                      an(m.name)), "bad")
            if first:
                self.say(cap(mon.hint) + ".", "mad")
            if "deathwish" in p["on"] and not self.check("Sanity",
                                                         quiet=True):
                self.say("You want to go for it. You want to so badly.",
                         "mad")
            if not mon.save:
                continue
            if fright:
                if not self.check("Fear", adv=-1, label="frightened"):
                    self.gain_stress(roll("1d5"), "It's one of THEM.")
                continue
            if p["class"] == "Android" and mon.save == "Fear":
                continue
            if not self.check(mon.save, label="the sight of it",
                              stress=False):
                self.gain_stress(mon.stress, quiet=True)
                if first:
                    self.root.after(1, lambda: self.panic_check(
                        "a horror"))
                    return

    def fly(self, path, tile):
        """A zap or a blob of goop crossing the squares between."""
        cols, rows, ox, oy, ts = self.view
        c = self.canvas
        for x, y in path[:12]:
            i = x - self.pos[0] + cols // 2
            j = y - self.pos[1] + rows // 2
            if 0 <= i < cols and 0 <= j < rows:
                c.coords(self.missile, ox + i * ts, oy + j * ts)
                c.itemconfig(self.missile, image=self.img[tile],
                             state="normal")
                c.tag_raise(self.missile)
                c.update_idletasks()
                time.sleep(0.025)
        c.itemconfig(self.missile, state="hidden")

    @staticmethod
    def line_path(a, b):
        (x0, y0), (x1, y1) = a, b
        n = max(abs(x1 - x0), abs(y1 - y0))
        return [(x0 + round((x1 - x0) * k / n), y0 + round((y1 - y0) * k / n))
                for k in range(1, n + 1)] if n else []


    # ── Shooting ──

    def ready_fire(self):
        if not self.ready():
            return
        p = self.p
        w = p["weapon"]
        if w == "frag grenade" or (w not in WEAPONS or not WEAPONS[w].shots):
            if p["items"].get("frag grenade") and w == "frag grenade":
                self.aim = ("throw", "frag grenade")
                self.say("Throw the grenade which way?", "info")
                return
            self.say("You've nothing to shoot with in your hands. Walk into "
                     "something to fight it, or pick a gun (Use).", "info")
            return
        if p["guns"].get(w, 0) <= 0:
            self.say("Click. The %s is empty. (R reloads.)" % w, "bad")
            self.sound.play("bump")
            return
        if "slow" in WEAPONS[w].special and "cutter" in p["on"]:
            self.say("The cutter's still charging.", "info")
            return
        self.aim = ("fire", w)
        self.say("Fire the %s which way? (arrow keys, or tap)" % w, "info")

    def aimed(self, dx, dy):
        what = self.aim
        self.aim = None
        if what[0] == "fire":
            self.shoot(what[1], dx, dy)
        elif what[0] == "throw":
            self.throw_grenade(dx, dy)
        elif what[0] == "scan":
            self.scan_at(dx, dy)

    LOW = {"counter", "table", "desk", "crate", "crate_open", "pew", "bed",
           "tray", "medpod", "slush", "water", "sludge", "rad", "steam",
           "breach", "crevasse", "throat", "blood"}

    def target_in_line(self, dx, dy, reach):
        a = self.area
        x, y = self.pos
        path = []
        for _ in range(reach):
            x, y = x + dx, y + dy
            if not a.inside(x, y) or a.grid[y][x] in a.opaque or (
                    a.grid[y][x] not in WALKABLE and
                    a.grid[y][x] not in self.LOW):
                break
            path.append((x, y))
            mob = a.mob_at(x, y)
            if mob and not mob.ally:
                return mob, path
        return None, path

    def shoot(self, w, dx, dy, sure=False):
        p = self.p
        info = WEAPONS[w]
        mob, path = self.target_in_line(dx, dy, info.reach)
        if mob is not None and not mob.hostile and not mob.down and \
                not sure and not getattr(self, "headless", False):
            self.open_menu("%s is a person. Shoot anyway?" % mob.name, [
                ("Shoot", lambda: self.shoot(w, dx, dy, sure=True)),
                ("Don't", lambda: None)])
            return
        p["guns"][w] -= 1
        if "slow" in info.special:
            p["on"]["cutter"] = 2
        self.fly(path, "flame" if "fire" in info.special else "bolt")
        self.sound.play("fire" if "fire" in info.special else "shot")
        self.alert(14)
        if "flare" in info.special:
            p["on"]["flare"] = 20
        if mob is None:
            self.say("You fire the %s into the dark. Nothing." % w, "info")
            self.end_turn()
            return
        if not mob.hostile and not mob.down:
            self.shoot_person(mob)
        dist = abs(mob.x - self.pos[0]) + abs(mob.y - self.pos[1])
        adv = -1 if "close-" in info.special and dist <= CLOSE else 0
        skills = ("Firearms", "Military Training") if info.ammo not in (
            "fuel canister", "nail cartridge", "battery", "foam cartridge") \
            else ("Firearms", "Industrial Equipment", "Military Training")
        if not self.check("Combat", skills, adv=adv,
                          label="firing the " + w):
            self.say("You miss %s." % self.the(mob), "info")
            self.end_turn()
            return
        dmg = roll("1d10" if "far" in info.special and dist > CLOSE
                   else info.dmg)
        if "rage" in p["on"]:
            dmg = max(dmg, roll(info.dmg))
        self.hit_mob(mob, dmg, info, "The %s %s %s" % (
            w, "scorches" if "fire" in info.special else "hits",
            self.the(mob)))
        self.end_turn()

    def shoot_person(self, mob):
        """At someone who hasn't done anything.  Yet."""
        self.say("You open fire on %s." % mob.name, "bad")
        if mob.mimic:
            self.unmask(mob)
        else:
            self.turn_on(mob)
        return True

    def turn_on(self, mob):
        """A survivor you've attacked: they run, and everyone hears."""
        mob.hostile = True
        mob.kind = "deserter"
        mob.health = mob.maxhealth = MONSTERS["deserter"].health
        mob.was = None
        mob.flee = 6
        self.flags.add("murderer")
        self.gain_stress(2, "What are you DOING?")

    def throw_grenade(self, dx, dy):
        p = self.p
        mob, path = self.target_in_line(dx, dy, CLOSE + 2)
        p["items"]["frag grenade"] -= 1
        if not p["items"]["frag grenade"]:
            del p["items"]["frag grenade"]
            p["weapon"] = next((w for w in WEAPONS if p["items"].get(w) and
                                w != "frag grenade"), "fists")
        spot = (mob.x, mob.y) if mob else (path[-1] if path else
                                           tuple(self.pos))
        self.fly(path, "bolt")
        self.sound.play("fire")
        self.alert(20)
        self.say("You throw the grenade. BOOM.", "bad")
        info = WEAPONS["frag grenade"]
        for m in list(self.area.mobs):
            if abs(m.x - spot[0]) + abs(m.y - spot[1]) <= 1:
                self.hit_mob(m, roll(info.dmg), info,
                             "The blast catches %s" % self.the(m))
        if abs(self.pos[0] - spot[0]) + abs(self.pos[1] - spot[1]) <= 1:
            self.hurt(roll(info.dmg), "Fire", "You're too close to the "
                      "blast")
        self.end_turn()

    def reload(self):
        if not self.ready():
            return
        p = self.p
        w = p["weapon"]
        if w not in WEAPONS or not WEAPONS[w].shots:
            self.say("There's nothing to reload.", "info")
            return
        ammo = WEAPONS[w].ammo
        if p["guns"].get(w, 0) >= WEAPONS[w].shots:
            self.say("The %s is full." % w, "info")
            return
        if not p["items"].get(ammo):
            self.say("You've no %s left." % ammo, "bad")
            return
        p["items"][ammo] -= 1
        if not p["items"][ammo]:
            del p["items"][ammo]
        p["guns"][w] = WEAPONS[w].shots
        self.say("You reload the %s. (%d)" % (w, p["guns"][w]), "info")
        self.sound.play("bump")
        self.end_turn()

    # ── Things ──

    def give_item(self, n, k=1):
        p = self.p
        if n in EVIDENCE:
            self.got_evidence(n)
            return
        p["items"][n] = p["items"].get(n, 0) + k
        if n in WEAPONS and WEAPONS[n].shots and n not in p["guns"]:
            p["guns"][n] = WEAPONS[n].shots
        if n in WEAPONS and p["weapon"] == "fists" and n != "frag grenade":
            p["weapon"] = n
        self.flags.add("got:" + n)

    def take_item(self, n, k=1):
        p = self.p
        p["items"][n] = p["items"].get(n, 0) - k
        if p["items"][n] <= 0:
            del p["items"][n]
            if p["weapon"] == n:
                p["weapon"] = "fists"

    def got_evidence(self, key):
        if key in self.evidence:
            return
        self.evidence.append(key)
        self.flags.add("evidence:" + key)
        self.say("EVIDENCE: %s. (%d pieces now; the journal lists them.)" % (
            cap(fill(EVIDENCE[key], self.world)), len(self.evidence)),
            "quest")
        self.sound.play("quest")

    def use_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        on_throat = tuple(self.pos) in getattr(self.area, "throat", ())
        if on_throat and p["items"].get("the tooth"):
            items.append(("Put the Tooth back", self.return_tooth))
        if on_throat and p["items"].get("mining charges") and \
                "charges_set" not in self.flags:
            items.append(("Set the mining charges here (Explosives)",
                          self.set_charges))
        if "charges_set" in self.flags and "sealed" not in self.flags:
            items.append(("Detonate the charges", self.detonate))
        if p["bleed"] and not p["items"].get("first aid kit"):
            items.append(("Bind the wound with what you've got (Intellect, "
                          "Field Medicine)", self.bind_wound))
        for n in ("first aid kit", "stimpak", "automed", "sedatives",
                  "radiation pills", "medscanner", "bioscanner",
                  "infrared goggles", "patch kit", "oxygen tank",
                  "chemlights", "mre", "whiskey", "cigarettes",
                  "frag grenade"):
            if p["items"].get(n):
                label = ITEMS[n][0].split(":")[0]
                if n == "infrared goggles":
                    label = ("Take off" if p["goggles"] else "Put on") + \
                        " the infrared goggles"
                elif p["items"][n] > 1:
                    label += " (%d)" % p["items"][n]
                items.append((cap(label), lambda n=n: self.use(n)))
        for w in WEAPONS:
            if p["items"].get(w) and w != p["weapon"]:
                items.append(("Ready the %s" % w,
                              lambda w=w: self.wield(w)))
        for arm in ARMOUR:
            if p["items"].get(arm):
                items.append(("Change into the %s" % arm,
                              lambda arm=arm: self.wear(arm)))
        if not items:
            self.say("You've nothing to use. The Commissary sells things. "
                     "The dead carry things.", "info")
            return
        items.append(("Never mind", lambda: None))
        self.open_menu("Use what?", items)

    def bind_wound(self):
        p = self.p
        if self.check("Intellect", ("Field Medicine", "Surgery",
                                    "Military Training"),
                      adv=-1, label="binding the wound"):
            p["bleed"] = max(0, p["bleed"] - 2)
            self.say("You tear a sleeve into strips and pull them tight. %s" %
                     ("The bleeding stops." if not p["bleed"] else
                      "It slows."), "good")
        else:
            self.say("Your hands are slick and shaking. It won't hold.",
                     "bad")
        self.end_turn()

    def wield(self, w):
        self.p["weapon"] = w
        self.say("You ready the %s." % w, "info")
        self.render_chrome()

    def wear(self, arm):
        p = self.p
        old = p["armour"]
        self.take_item(arm)
        if p["ap"] or old in ("crew attire", "lab coat", "scrubs"):
            p["items"][old] = p["items"].get(old, 0) + 1
        p["armour"] = arm
        p["ap"] = ARMOUR[arm].ap
        p["air"] = ARMOUR[arm].air
        p["punctured"] = False
        self.say("You change into the %s. (AP %d)" % (arm, p["ap"]), "info")
        self.pass_time(10, quiet=True)
        self.render()

    def use(self, n):
        p = self.p
        if n == "first aid kit":
            if not p["bleed"] and not p["dying"] and \
                    p["health"] >= p["maxhp"]:
                self.say("You're not hurt. Not where a bandage helps.",
                         "info")
                return
            self.take_item(n)
            p["bleed"] = 0
            gain = min(p["maxhp"] - p["health"], roll("1d5"))
            p["health"] += gain
            text = "You tape gauze over the worst of it."
            if p["dying"]:
                if self.check("Intellect", ("Field Medicine", "Surgery",
                                            "Pathology"), adv=1,
                              label="saving your own life"):
                    p["dying"] = 0
                    text += " You've stopped yourself dying. For now."
                else:
                    text += " It isn't enough."
            self.say(text + " (+%d Health, bleeding stopped)" % gain, "good")
        elif n == "stimpak":
            self.take_item(n)
            p["stims"] = [t for t in p["stims"] if t > self.turn - DAY] + [
                self.turn]
            gain = min(p["maxhp"] - p["health"], roll("1d10"))
            p["health"] += gain
            self.lose_stress(1)
            p["on"]["stim"] = 10
            p["on"].pop("cryosick", None)
            p["dying"] = 0
            self.say("The stimpak hits like a train. (+%d Health, -1 "
                     "Stress)" % gain, "good")
            if len(p["stims"]) > 1 and random.randint(1, 10) < len(
                    p["stims"]):
                self.say("Your heart stutters. Too many.", "bad")
                self.death_save()
        elif n == "automed":
            self.take_item(n)
            p["on"]["automed"] = DAY
            self.say("You swallow the nanopills. They'll help, next time "
                     "you rest.", "good")
        elif n == "sedatives":
            self.take_item(n)
            self.lose_stress(roll("1d5"))
            p["on"]["sedated"] = 60
            self.say("The world goes soft at the edges.", "good")
        elif n == "radiation pills":
            self.take_item(n)
            p["on"]["radpills"] = 120
            self.hurt(roll("1d5"), "Blunt Force", "The pills burn going "
                      "down", raw=True)
        elif n == "medscanner":
            self.aim = ("scan",)
            self.say("Scan who? (a direction)", "info")
            return
        elif n == "bioscanner":
            self.bioscan()
            return
        elif n == "infrared goggles":
            p["goggles"] = not p["goggles"]
            self.say("You %s the goggles.%s" % (
                "put on" if p["goggles"] else "take off",
                " The world goes to heat: the warm glow orange, the dead "
                "and the hollow stay cold." if p["goggles"] else ""),
                "info")
            self.render()
            return
        elif n == "patch kit":
            if not p["punctured"] and p["ap"]:
                self.say("Your suit doesn't need patching.", "info")
                return
            self.take_item(n)
            p["punctured"] = False
            p.pop("decomp", None)
            if not p["ap"]:
                p["ap"] = 1
            self.say("You slap the patch over the tear and seal it. (AP "
                     "%d)" % p["ap"], "good")
        elif n == "oxygen tank":
            if not ARMOUR[p["armour"]].air or not p["ap"]:
                self.say("You'd need a sealed suit to plug it into.", "info")
                return
            self.take_item(n)
            p["air"] += 60
            self.say("You clip the tank on. (+60 minutes of air)", "good")
        elif n == "chemlights":
            self.take_item(n)
            p["on"]["chem"] = 60
            self.say("You crack a chemlight. A sick green glow.", "info")
        elif n == "mre":
            self.take_item(n)
            gain = min(p["maxhp"] - p["health"], 2)
            p["health"] += gain
            self.say("Reconstituted beef. Probably beef. (+%d Health)" %
                     gain, "good")
            self.pass_time(10, quiet=True)
        elif n == "whiskey":
            self.take_item(n)
            self.lose_stress(1)
            p["rest_adv"] = 1
            self.say("It burns all the way down. Good. (-1 Stress)", "good")
        elif n == "cigarettes":
            self.take_item(n)
            p["rest_adv"] = 1
            self.say("You smoke one, hands cupped, like it's a campfire.",
                     "info")
        elif n == "frag grenade":
            self.aim = ("throw", n)
            self.say("Throw the grenade which way?", "info")
            return
        self.end_turn()

    def scan_at(self, dx, dy):
        a = self.area
        x, y = self.pos[0] + dx, self.pos[1] + dy
        mob = a.mob_at(x, y) if a.inside(x, y) else None
        if not mob:
            self.say("The medscanner reads the empty air.", "info")
            return
        if mob.mimic or (mob.kind and "hollow" in MONSTERS[mob.kind].traits):
            self.say("The medscanner chirps, and chirps again, and shows "
                     "you a flat line. No heartbeat. Core temperature four "
                     "degrees. Whatever %s is, it isn't alive." % (
                         mob.name if not mob.kind else self.the(mob)), "bad")
            if mob.mimic:
                self.flags.add("scanned")
                self.gain_stress(2, quiet=True)
        else:
            self.say("Heartbeat, too fast. Temperature normal. %s is alive, "
                     "and frightened." % (mob.name if mob.role else
                                          cap(self.the(mob))), "good")
        self.end_turn()

    def bioscan(self):
        a = self.area
        living = [m for m in a.mobs if not m.mimic and not (
            m.kind and "cold" in MONSTERS[m.kind].traits) and
            m.kind not in ("drone",)]
        cold = [m for m in a.mobs if m.mimic or (
            m.kind and "cold" in MONSTERS[m.kind].traits)]
        self.say("The bioscanner counts %d life sign%s here.%s" % (
            len(living), "" if len(living) == 1 else "s",
            " It doesn't count everything that moves." if cold else ""),
            "info")
        if any(m.mimic for m in a.mobs) and "bio_mimic" not in self.flags:
            self.flags.add("bio_mimic")
            self.flags.add("scanned_bio")
            self.say("You count the people in the room with your eyes. One "
                     "more than the scanner.", "bad")
        self.end_turn()

    def you_tile(self):
        p = self.p
        cls = p["class"].lower()
        suit = p["ap"] and ARMOUR[p["armour"]].air
        t = "you_%s_%s" % (cls, "S" if suit else p["sex"])
        return ("warm_" + t) if p["goggles"] else t

    # ── The Reliquary ──

    def return_tooth(self):
        self.take_item("the tooth")
        self.flags.add("tooth_home")
        self.learn("tooth_home")
        self.say("You lay the Tooth in the ribbed wet floor of the throat, "
                 "where a socket is waiting for it. It slides in. The "
                 "Psalm stops, all at once, the way a held breath stops. "
                 "In the silence you can hear your own heart. Then, very "
                 "far down, something sighs.", "quest")
        self.sound.play("quest")
        self.lose_stress(2)
        self.end_turn()

    def set_charges(self):
        self.say("You pack the charges into the ribs of the throat, run "
                 "the wire, and arm the detonator.", "info")
        self.pass_time(20, quiet=True)
        if self.check("Intellect", ("Explosives", "Asteroid Mining",
                                    "Engineering"), label="setting the "
                      "charges"):
            self.take_item("mining charges")
            self.flags.add("charges_set")
            self.learn("charges_set")
            self.say("Set. Get out of the Dig, and blow them from above "
                     "(Use).", "good")
