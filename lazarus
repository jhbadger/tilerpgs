    def vesper_try(self, how):
        if how == "talk":
            ok = self.check("Intellect", ("Artificial Intelligence",
                                          "Sophontology", "Psychology"),
                            label="reasoning with VESPER")
            text = ("'...You're right. They want me to keep you here until "
                    "the Due Diligence can kill you. I don't think I want to "
                    "help with that.' Somewhere above, very faintly, the "
                    "clamps on the Patience unlock.")
        else:
            ok = self.check("Intellect", ("Hacking", "Engineering",
                                          "Artificial Intelligence"),
                            mod=-10, label="gutting VESPER")
            text = ("You pull the boards one by one. VESPER's voice slows, "
                    "and slurs, and says 'please' once, and stops. The "
                    "clamps are on manual now. So is everything else.")
            if ok:
                self.flags.add("vesper_dead")
        self.pass_time(15, quiet=True)
        if ok:
            self.flags.add("vesper_open")
            self.say(text, "good")
            self.learn("vesper_open")
            self.sound.play("level")
        else:
            self.say("VESPER: 'I'm sorry. I can't.'", "talk")
        self.render()

    def pray(self):
        key = "pray:%d" % self.day_no()
        if key in self.flags:
            self.say("You sit at the altar for a while.", "info")
            return
        self.flags.add(key)
        self.pass_time(20, quiet=True)
        if self.check("Sanity", ("Theology", "Mysticism"),
                      label="praying", stress=False):
            n = self.lose_stress(roll("1d5"))
            self.say("Nothing answers. That's all right. That's better than "
                     "the alternative. (-%d Stress)" % n, "good")
        else:
            self.say("You try to pray, and something hums along.", "mad")
        self.render()

    def medpod(self):
        p = self.p
        doc = any(m.role == "doctor" for m in self.area.mobs)
        if not doc:
            self.say("A medpod. Without the doctor, you don't know what "
                     "half the settings do.", "info")
            return
        if not p["wounds"] and p["health"] >= p["maxhp"]:
            self.say("Dr. %s: 'You don't need a pod. You need a drink.'" %
                     fill("{doctor_short}", self.world), "talk")
            return
        self.open_menu("The medpod: six hours, one Wound mended, and Health "
                       "back. Dr. %s wants %d credits." % (
                           fill("{doctor_short}", self.world),
                           0 if "doctor" in p["trust"] else 300), [
                               ("Get in", self.medpod_heal),
                               ("Not now", lambda: None)])

    def medpod_heal(self):
        p = self.p
        cost = 0 if "doctor" in p["trust"] else 300
        if p["credits"] < cost:
            self.say("You haven't the credits.", "bad")
            return
        p["credits"] -= cost
        self.say("The lid closes. Blue light, and the smell of antiseptic, "
                 "and nothing.", "info")
        self.pass_time(6 * 60, quiet=True)
        if self.overlay or self.interrupt:
            self.render()
            return
        p["wounds"] = max(0, p["wounds"] - 1)
        p["health"] = p["maxhp"]
        p["bleed"] = 0
        p["dying"] = 0
        for c in ("ankle", "concussion", "ribs", "bullet", "burns"):
            if c in p["conds"]:
                p["conds"].remove(c)
                break
        self.say("You come out of the pod, %s. One Wound fewer." %
                 self.date_text(), "good")
        self.render()

    # ── Helm ──

    def helm(self):
        """The Patience's helm: the way out."""
        free = "override" in self.flags or "vesper_open" in self.flags
        n = len(self.aboard)
        opts = []
        if free:
            opts.append(("Cast off (%d aboard)" % n, self.launch))
        elif self.p["skills"].get("Piloting"):
            opts.append(("Fire the main drive and RIP free (Intellect, "
                         "Piloting)", lambda: self.launch(rip=True)))
        opts.append(("Not yet", lambda: None))
        self.open_menu("The Patience's helm. Clamps: %s. In the hold: %s." % (
            "RELEASED" if free else "ENGAGED",
            ", ".join(self.world["people"][r]["first"] for r in self.aboard)
            or "nobody"), opts)

    # ── The ways down ──

    def at_lead(self, lid, x, y):
        p = self.p
        if lid == "dig" and "sealed" in self.flags:
            self.say("The lift shaft is full of ice and rubble from the "
                     "bottom up. The Dig is gone.", "info")
            return
        if lid == "magdalene":
            if p["class"] != "Android" and not (
                    p["ap"] and "vac" in ARMOUR[p["armour"]].protects and
                    p["air"] > 0 and not p["punctured"]):
                self.say("The umbilical's inner door won't open: VACUUM "
                         "BEYOND. You'd last fifteen seconds. You need a "
                         "sealed suit with air in it.", "bad")
                return
        if lid == "sector7" and "open:sector7" not in self.flags:
            opts = []
            if p["items"].get("hand welder") or p["items"].get(
                    "laser cutter"):
                opts.append(("Cut through the bulkhead (twenty minutes)",
                             self.cut_sector7))
            opts += [("Break the foam and force the door (Strength, "
                      "Industrial Equipment)", self.force_sector7),
                     ("Leave it sealed", lambda: None)]
            self.open_menu("The Sector 7 bulkhead: foamed, welded, and "
                           "stencilled DO NOT OPEN. Behind it, something "
                           "is singing in a lot of voices.", opts)
            return
        if lid == "dig":
            self.say("The lift cage clanks shut behind you, and the long "
                     "drop begins. The temperature falls with it.", "info")
        elif lid == "under":
            self.say("You climb down the hatch into the Underdeck: heat, "
                     "dark, and the reactor's deep tick.", "info")
        elif lid == "reclaim":
            self.say("You crank the sluice open. Black water, and the smell "
                     "of it, and something moving under the surface.",
                     "info")
        elif lid == "magdalene":
            self.say("You cycle the umbilical. The air goes out of it with "
                     "a sigh, and the Magdalene's hatch opens on cold and "
                     "dark and silence.", "info")
        self.descend(lid)

    def cut_sector7(self):
        self.say("Twenty minutes of sparks. The welds give, then the foam, "
                 "and the bulkhead swings in on darkness and a smell you "
                 "will never forget.", "bad")
        self.pass_time(20, quiet=True)
        self.open_sector7()

    def force_sector7(self):
        if self.check("Strength", ("Industrial Equipment", "Athletics"),
                      adv=1 if self.p["items"].get("crowbar") else 0,
                      mod=-20, label="forcing the bulkhead"):
            self.say("Foam cracks, a weld pops, and the bulkhead groans open "
                     "far enough to squeeze through.", "good")
            self.open_sector7()
        else:
            self.say("It doesn't move. (A welder or a cutter would.)",
                     "info")
            self.end_turn()

    def open_sector7(self):
        self.flags.add("open:sector7")
        city = self.get_area(("city",))
        city.grid[BULKHEAD[1]][BULKHEAD[0]] = "hatch"
        self.gain_stress(1, quiet=True)
        self.descend("sector7")

    # ── Resting ──

    def bed_menu(self):
        a = self.area
        if a.site not in BUNKS:
            self.say("Someone else's bunk.", "info")
            return
        self.open_menu("A bunk.%s" % (
            "" if a.site in SAFE_PLACES else " The door doesn't lock."), [
                ("Rest an hour (a Rest Save, to shed Stress)",
                 lambda: self.rest(60)),
                ("Sleep six hours (and heal, maybe)",
                 lambda: self.rest(6 * 60)),
                ("Not now", lambda: None)])

    def rest(self, minutes):
        p = self.p
        a = self.area
        adv = 1 if p["rest_adv"] else 0
        p["rest_adv"] = 0
        if "nightmares" in p["conds"]:
            adv -= 1
        if a.site not in SAFE_PLACES:
            adv -= 1
        worst = min(SAVES, key=lambda s: p["saves"][s])
        self.say("You lie down.%s" % (
            " You can hear the humming through the mattress." if
            a.site != "patience" else ""), "info")
        self.pass_time(minutes, quiet=True)
        if self.overlay or self.p is not p or p["health"] is None:
            return
        if self.interrupt:
            self.render()
            return
        target = p["saves"][worst]
        r = d100()
        if adv:
            r2 = d100()
            r = min(r, r2) if adv > 0 else max(r, r2)
        ok = r < target and r < 90
        self.say("[Rest Save, %s: d100 %02d vs %d: %s]" % (
            worst, r, target, "success" if ok else "failure"), "roll")
        if ok:
            n = self.lose_stress(r % 10)
            self.say("You rest. (-%d Stress)" % n, "good")
        else:
            self.gain_stress(1, "You lie awake listening to the walls.")
        if minutes >= 6 * 60:
            p["slept"] = self.turn
            if self.check("Body", adv=1 if "automed" in p["on"] else 0,
                          label="healing", stress=False):
                p["health"] = p["maxhp"]
                self.say("You wake up feeling almost human. (Health %d)" %
                         p["health"], "good")
            if "haunted" in p["conds"] and not self.check("Sanity",
                                                          quiet=True):
                self.gain_stress(roll("1d5"), "It came to you in your "
                                 "sleep, and sang, and you sang back.")
        self.say("It's %s." % self.date_text(), "info")
        self.render()

    def bed_spot(self, area):
        for y in range(area.h):
            for x in range(area.w):
                if area.grid[y][x] == "bed" and y + 1 < area.h and \
                        area.grid[y + 1][x] in INSIDE_FLOOR:
                    return x, y + 1
        return area.start


    # ── Clues ──

    def learn(self, cid, quiet=False):
        if cid in self.clues:
            return
        self.clues.append(cid)
        if not quiet:
            self.say("(Your journal has a new entry. J reads it.)", "quest")
            self.sound.play("gold")

    def hear(self, text):
        """Words in CAPITALS: things to ask about."""
        words = re.findall(r"\b[A-Z][A-Z']{2,}\b", text)
        self.heard = [re.sub(r"'S?$", "", w) for w in words
                      if w not in ("BYE", "HI", "CO2", "VESPER") and
                      not re.fullmatch(r"[IVXLC]+", w)]

    # ── Talking ──

    def speaker(self, mob):
        return cap(mob.name) if mob.known or mob.role in (
            "director", "doctor", "deputy", "chaplain") or mob.kind else \
            cap(mob.title)

    def npc_say(self, mob, text):
        text = fill(text, self.world)
        self.say("%s: %s" % (self.speaker(mob), text), "talk")
        self.hear(text)


    def start_talk(self, mob):
        p = self.p
        self.talk = {"mob": mob, "mode": "kw"}
        self.heard = []
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Ask about:")
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        self.say("You talk to %s." % (self.the(mob) if mob.kind else
                                      mob.title), "info")
        e = mob.errand
        greet = mob.greet
        if e is not None and self.side.get(e["id"], {}).get("state") == \
                "active":
            greet = "Did you... have you got it?"
        if mob.ally:
            greet = random.choice(("Where now?", "I'm with you.",
                                   "Stay in the light."))
        elif mob.role in self.aboard and self.area.site == "patience":
            greet = random.choice(("When do we go?", "Is it soon?",
                                   "Can you hear it? Even in here?"))
        elif mob.role in p["trust"]:
            greet = random.choice(("It's you. Good.", "You came back.",
                                   "I'm glad you're alive."))
        self.npc_say(mob, greet)
        if e is not None and self.errand_ready(e):
            self.finish_errand(mob, e)
        if "talked" not in self.flags:
            self.flags.add("talked")
            self.say("(Choose what to ask about, or type a word such as "
                     "NAME, JOB or NEWS and press Return. BYE, or an empty "
                     "line, ends the conversation.)", "info")
        self.talk_menu()

    def talk_menu(self):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        if t["mode"] == "buy":
            items = [("%d) %s%s" % (i, label, ", %d cr" % price
                                    if price else ""),
                      lambda i=i: self.choose_words(str(i)))
                     for i, (label, price, _) in enumerate(self.offers(mob),
                                                           1)]
            items.append(("Nothing, thanks", lambda: self.choose_words("")))
            self.open_menu("Buy what? (you have %d credits)" %
                           self.p["credits"], items,
                           lambda: self.choose_words(""))
            return
        words = ["NAME", "JOB", "NEWS"]
        if mob.shop:
            words.append("BUY")
        if mob.errand is not None and self.side.get(
                mob.errand["id"], {}).get("state") != "done":
            words.append("HELP")
        if mob.role and not (mob.role in self.aboard and
                             self.area.site == "patience"):
            words.append("PATIENCE")
        if mob.role in COMPANIONS and mob.role in self.p["trust"]:
            words.append("STAY" if mob.ally else "COME")
        if mob.role and self.suspicion() and "unmasked" not in self.flags:
            words.append("HOLLOW")
        for w in getattr(self, "heard", []):
            if w not in words and w != "BYE":
                words.append(w)
        self.open_menu("Ask %s about:" % self.speaker(mob),
                       [(w, lambda w=w: self.choose_words(w))
                        for w in words + ["BYE"]],
                       lambda: self.choose_words("bye"))

    def choose_words(self, w):
        self.say("> " + (w or "nothing"), "you")
        self.converse(w.lower())
        self.talk_menu()

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if getattr(self, "p", None) and getattr(self, "area", None):
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if not self.talk:
            return
        self.menu = None
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())
        self.talk_menu()


    def converse(self, w):
        t = self.talk
        mob = t["mob"]
        if t["mode"] == "buy":
            t["mode"] = "kw"
            if w.isdigit():
                self.buy(mob, int(w))
                return
            if not w:
                self.npc_say(mob, "Anything else?")
                return
        if not w or w.startswith("bye"):
            self.npc_say(mob, random.choice(BYES))
            self.end_talk()
            return
        word = re.sub(r"'s?$", "", w.split()[0])
        if word.startswith("name"):
            mob.known = True
            self.npc_say(mob, "%s, %s." % (mob.name, mob.title)
                         if mob.role else "I'm %s." % mob.name)
            return
        if word[:4] in ERRAND_WORDS and mob.errand is not None:
            self.errand(mob)
            return
        if mob.shop and word[:3] in ("buy", "pur", "sho", "sel", "tre",
                                     "arm", "dri"):
            self.list_offers(mob)
            return
        if word[:4] in ("pati", "evac", "leav", "ship", "tug", "boar",
                        "esca"):
            self.board(mob)
            return
        if word[:4] in ("come", "join", "foll") and mob.role:
            self.invite(mob)
            return
        if word[:4] in ("stay", "wait") and mob.ally:
            self.dismiss()
            self.npc_say(mob, "All right. I'll be here. Come back.")
            self.end_talk()
            return
        if word[:4] in ("holl", "skin", "mimi", "seco", "psal", "cold") and \
                self.suspicion() and mob.role and \
                "unmasked" not in self.flags:
            self.accuse(mob)
            return
        if mob.role == "director" and word[:4] in (
                "dire", "over", "clam", "evid", "trut", "proo", "asse",
                "tooth", "safe", "code", "9", "quar"):
            self.confront_director(mob, word)
            return
        if mob.role == "doctor" and word[:4] in ("insu",):
            self.collect_insulin(mob)
            return
        if mob.role == "comms" and word[:4] in ("broa", "send", "arra") and \
                "directive" in self.evidence and len(self.evidence) >= 2 \
                and "broadcast" not in self.flags:
            self.npc_say(mob, "That's it. That's everything. Give it here.")
            self.say("%s takes your evidence to the array console and "
                     "types for a long time." % mob.name, "info")
            self.broadcast(helped=True)
            return
        if mob.role == "cook" and word[:3] in ("eat", "foo", "rat"):
            if "ration:%d" % self.day_no() not in self.flags:
                self.flags.add("ration:%d" % self.day_no())
                self.give_item("mre")
                self.npc_say(mob, "Here. Take it. Eat it somewhere with a "
                             "door.")
            else:
                self.npc_say(mob, "One a day. That's the rule. I'm sorry.")
            return
        if mob.mimic and word[:4] in ("home", "fami", "wife", "husb", "kids",
                                      "chil", "befo", "past", "born"):
            self.npc_say(mob, random.choice((
                "Home? Home is... here. Home is where we all are. Together.",
                "I had a... yes. I had one of those.",
                "Why do you want to know about before? Before doesn't "
                "matter.")))
            self.flags.add("mimic_odd")
            return
        if word[:4] in ("home", "fami", "befo", "past"):
            self.npc_say(mob, random.choice((
                "Home? Ceres, a long time ago. I had a sister. I'll see her "
                "again, if I get off this ice.",
                "I've got two kids on Luna. They think I'm rich.",
                "Before? I don't think about before. It hurts.")))
            return
        reply = next((v for k, v in mob.talk.items()
                      if k[:4] == word[:4] or (len(k) < 4 and
                                               word.startswith(k))), None)
        if reply is None and word[:4] in ("heal", "how'", "how"):
            reply = random.choice(HEALTH)
        if reply is None and not mob.kind:
            reply = next((v for k, v in TOPICS.items()
                          if word.startswith(k)), None)
        if reply is None:
            reply = random.choice((
                "I don't know anything about that.",
                "What?",
                "I can't think about that right now.")) if not mob.kind \
                else "It doesn't answer. It hums."
        self.reply(mob, reply)
        if mob.role in self.world["tells"] and word[:4] in ("news", "mimi"):
            self.flags.add("heard_tell:" + mob.role)
        self.render_chrome()

    def reply(self, mob, r):
        """Say a reply: words, or a dict that may roll, give things, teach
        clues and win trust."""
        if isinstance(r, str):
            self.npc_say(mob, r)
            return
        if "check" in r:
            flag = r.get("flag")
            if flag and flag in self.flags:
                self.npc_say(mob, "I've done what I can for you.")
                return
            tried = "tried:%s:%s:%d" % (mob.role, flag, self.day_no())
            if tried in self.flags:
                self.npc_say(mob, r["fail"])
                return
            stat, skills = r["check"]
            adv = (1 if mob.role in self.p["trust"] else 0) - (
                1 if "paranoid" in self.p["conds"] else 0) - (
                1 if self.p["class"] == "Android" else 0)
            if self.check(stat, skills, mod=r.get("mod", 0), adv=adv,
                          label="persuading"):
                self.npc_say(mob, r["ok"])
                if flag:
                    self.flags.add(flag)
                if r.get("give"):
                    self.give_item(r["give"])
                    self.say("You get the %s." % r["give"], "gold")
                    self.sound.play("gold")
                if flag == "freed":
                    self.flags.add("prisoner_moved")
            else:
                self.flags.add(tried)
                self.npc_say(mob, r["fail"])
            return
        self.npc_say(mob, r["say"])
        if r.get("learn"):
            self.learn(r["learn"])

    def trusted(self, role):
        p = self.p
        if role and role not in p["trust"]:
            p["trust"].append(role)
            self.say("%s trusts you now." % self.world["people"][role][
                "name"], "good")

    def suspicion(self):
        """How much you've seen of the Second Skin's tells."""
        return sum(f in self.flags for f in ("scanned", "scanned_bio",
                                             "vision", "mimic_odd",
                                             "goggled")) + \
            sum(r in self.world["tells"] and "heard_tell:" + r in self.flags
                for r in self.world["tells"])

    def accuse(self, mob):
        if mob.mimic:
            if self.suspicion() >= 2:
                self.npc_say(mob, "...Oh. You're clever. You're much too "
                             "clever. We'd have liked you, I think.")
                self.end_talk()
                self.unmask(mob)
                return
            self.npc_say(mob, "Me? Hollow? Look at me. I'm just tired. "
                         "We're all so tired.")
            return
        self.npc_say(mob, random.choice((
            "What? No! Look at me! Scan me if you want! I'm ME!",
            "Get away from me. GET AWAY.",
            "You think I'm one of them? You think I wouldn't KNOW?")))
        if mob.role in self.p["trust"]:
            self.p["trust"].remove(mob.role)
        self.gain_stress(1, quiet=True)

    def unmask(self, mob):
        """The Second Skin, out of its skin."""
        w = self.world
        role = mob.role
        self.say(fill("{mimic_full}'s face splits down the middle like a "
                      "seed pod, and the skin slides off something tall and "
                      "white and wet that has been folded up inside it all "
                      "along. It's singing.", w), "bad")
        self.sound.play("horror")
        m = MONSTERS["mimic"]
        mob.kind = "mimic"
        mob.tile = "mimic"
        mob.hostile = True
        mob.aware = True
        mob.health = mob.maxhealth = m.health
        mob.title = m.name
        mob.name = "the Second Skin"
        mob.shop = None
        mob.errand = None
        mob.mimic = True
        self.flags.add("unmasked")
        self.learn("unmasked")
        if role in self.aboard:
            self.aboard.remove(role)
        if role in self.p["trust"]:
            self.p["trust"].remove(role)
        if self.p.get("companion") == role:
            self.p["companion"] = None
            mob.ally = False
        self.render()

    def board(self, mob):
        """Ask someone to go aboard the Patience and wait."""
        p = self.p
        role = mob.role
        if not role:
            return
        if role in self.aboard:
            self.npc_say(mob, "I'm already aboard. I'm not getting off.")
            return
        if mob.mimic:
            self.npc_say(mob, "Yes. Yes, please. Take me with you. Take me "
                         "away from here. I'll be no trouble at all.")
            self.go_aboard(mob)
            return
        if role == "director" and "director_broken" not in self.flags:
            self.npc_say(mob, "My place is with the station. And the "
                         "station's assets.")
            return
        if len(self.aboard) >= 8:
            self.npc_say(mob, "Your hold's full. You know it is.")
            return
        if role not in p["trust"]:
            tried = "boardtry:%s:%d" % (role, self.day_no())
            if tried in self.flags:
                self.npc_say(mob, "I said no. I don't know you.")
                return
            self.flags.add(tried)
            adv = (-1 if p["class"] == "Android" else 0) - (
                1 if "paranoid" in p["conds"] else 0)
            if not self.check("Intellect", ("Command", "Psychology"),
                              adv=adv, label="persuading"):
                self.npc_say(mob, random.choice((
                    "Get on a ship with a stranger? Here? Now? No.",
                    "I don't know you. I don't know WHAT you are.",
                    "How do I know you're not one of them?")))
                return
            self.trusted(role)
        self.npc_say(mob, random.choice((
            "...All right. All right. I'll go. Don't leave without me.",
            "God, yes. Yes. I'll get my things. I haven't got any things.",
            "I'll wait aboard. In the light. Don't be long.")))
        self.go_aboard(mob)

    def go_aboard(self, mob):
        role = mob.role
        self.aboard.append(role)
        if mob in self.area.mobs and self.area.site != "patience":
            self.area.mobs.remove(mob)
        if self.p.get("companion") == role:
            self.p["companion"] = None
        self.say("%s goes to the Patience to wait in the hold. (%d aboard)" %
                 (mob.name, len(self.aboard)), "good")
        self.cache.pop(("bld", "patience"), None)
        self.end_talk()

    def confront_director(self, mob, word):
        n = len(self.evidence)
        if "director_broken" in self.flags:
            self.npc_say(mob, "You've got the codes. Go. Take who you can. "
                         "I'll stay. Someone has to answer for this.")
            return
        if n == 0:
            self.npc_say(mob, "Directive? Override? You've been listening "
                         "to gossip. Get out of my office.")
            return
        if n == 1 and not self.check("Combat", ("Command",
                                                "Hand-to-Hand Combat"),
                                     label="leaning on him"):
            self.npc_say(mob, "One piece of paper. You think one piece of "
                         "paper frightens me? The Company frightens me.")
            return
        self.npc_say(mob, "...Where did you get that? ...It doesn't matter. "
                     "It doesn't matter now. They're going to kill all of "
                     "us anyway. The override is 7731. The safe is 0412. "
                     "The Tooth is in the safe. Do what you want with it. "
                     "I'm so tired.")
        self.flags.update(("director_broken", "override", "safe_code"))
        self.learn("override")
        self.learn("tooth", quiet=True)
        self.trusted("director")

    def collect_insulin(self, mob):
        if self.side.get("insulin", {}).get("state") != "active":
            self.npc_say(mob, "Insulin? It's locked up. It's for a patient.")
            return
        if self.p["items"].get("insulin"):
            self.npc_say(mob, "You've already got it.")
            return
        self.npc_say(mob, "For {drinker_first}? ...Fine. Tell him to eat "
                     "something first. And to stop drinking. He won't.")
        self.give_item("insulin")

    # ── People who come with you ──

    def ally_act(self, mob):
        a = self.area
        for dx, dy in DIRS:
            t = a.mob_at(mob.x + dx, mob.y + dy)
            if t and t.hostile and not t.down:
                if random.random() < 0.4:
                    self.wound(t, roll("1d10"), "%s hits %s" % (
                        mob.name.split()[0], self.the(t)))
                return
        px, py = self.pos
        for sx, sy in sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                             abs(py - mob.y - d[1])):
            if abs(px - mob.x) + abs(py - mob.y) <= 2:
                break
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break

    def place_companion(self):
        role = self.p.get("companion")
        a = self.area
        for m in list(a.mobs):
            if m.ally and m.role != role:
                m.ally = False
                if m.visitor:
                    a.mobs.remove(m)
        if not role:
            return
        for m in a.mobs:
            if m.role == role:
                m.ally = True
                return
        x, y = self.pos
        for dx, dy in DIRS:
            nx, ny = x + dx, y + dy
            if a.inside(nx, ny) and not a.mob_at(nx, ny) and \
                    a.grid[ny][nx] in (CITY_GROUND | INSIDE_FLOOR |
                                       {"dfloor"}) and \
                    (nx, ny) not in a.links:
                m = make_person(self.world, role, nx, ny)
                m.ally = m.visitor = True
                a.mobs.append(m)
                return

    def invite(self, mob):
        p = self.p
        role = mob.role
        if role not in p["trust"]:
            self.npc_say(mob, "Go out there? With you? I don't know you.")
            return
        if role not in COMPANIONS:
            self.npc_say(mob, "I can't. I'm needed here. Or I'm too "
                         "scared. One of those.")
            return
        if p["companion"] == role:
            self.npc_say(mob, "I'm right here.")
            return
        if role in self.aboard:
            self.aboard.remove(role)
        if p["companion"]:
            self.dismiss()
        p["companion"] = role
        mob.ally = True
        self.npc_say(mob, random.choice((
            "All right. Stay close.", "I'll come. Don't leave me behind.",
            "Better than waiting here to be next.")))
        self.say("%s comes with you. (Talk to them and say STAY to leave "
                 "them.)" % mob.name, "good")
        self.end_talk()

    def dismiss(self):
        role = self.p["companion"]
        self.p["companion"] = None
        for m in list(self.area.mobs):
            if m.role == role and m.ally:
                m.ally = False
                if m.visitor:
                    self.area.mobs.remove(m)

    # ── Shops ──

    def offers(self, mob):
        """(label, price, what happens) for what someone will sell you."""
        p = self.p
        kind = mob.shop
        o = []
        trusted = mob.role in p["trust"]

        def give(item, n=1):
            def f():
                self.give_item(item, n)
                self.say("You get %s." % ITEMS[item][0].split(":")[0],
                         "gold")
            return f

        def item(name, price=None):
            return (cap(ITEMS[name][0].split(":")[0]),
                    ITEMS[name][1] if price is None else price, give(name))
        if kind == "commissary":
            for n in ("flashlight", "chemlights", "first aid kit",
                      "patch kit", "oxygen tank", "crowbar",
                      "assorted tools", "electronic tools", "mre",
                      "mylar blanket", "radiation pills", "stimpak",
                      "hazard suit", "vaccsuit"):
                o.append(item(n))
            for gun in sorted(set(p["guns"])):
                if WEAPONS[gun].ammo:
                    o.append(item(WEAPONS[gun].ammo))
        elif kind == "sump":
            o += [item("whiskey"), item("cigarettes"), item("sedatives"),
                  item("revolver"), item("revolver rounds"),
                  ("A rumour", 20, self.rumour)]
        elif kind == "galley":
            o.append(item("mre"))
        elif kind == "infirmary":
            o.append(("Patching up: Health back, bleeding stopped",
                      0 if trusted else 100, self.patch_up))
            o.append(("Something for the nerves: a Condition treated",
                      0 if trusted else 300, self.treat_condition))
            o.append(item("sedatives", 0 if trusted else None))
            o.append(item("first aid kit", 0 if trusted else None))
        elif kind == "armory":
            if not trusted:
                return []
            for n in ("pulse rifle", "pulse rifle mag", "combat shotgun",
                      "shotgun shells", "battle dress", "revolver rounds",
                      "frag grenade", "flare gun", "flares"):
                if n in WEAPONS and p["items"].get(n):
                    continue
                if "armory:" + n in self.flags:
                    continue
                o.append((cap(ITEMS[n][0].split(":")[0]), 0,
                          self.issue(n)))
        return o

    def issue(self, n):
        def f():
            self.flags.add("armory:" + n)
            self.give_item(n)
            self.say("The deputy signs it out to you: %s." % n, "gold")
        return f

    def rumour(self):
        lid = random.choice(list(RUMOURS))
        self.say("The bartender leans in: '%s'" % RUMOURS[lid], "talk")
        tells = list(self.world["tells"].items())
        if random.random() < 0.5 and tells:
            role, tell = random.choice(tells)
            self.say("'And I'll tell you what %s said: %s'" % (
                self.world["people"][role]["first"],
                fill(tell, self.world)), "talk")
            self.flags.add("heard_tell:" + role)

    def list_offers(self, mob):
        if self.closed(mob):
            self.npc_say(mob, "We're closed!")
            return
        offers = self.offers(mob)
        if not offers:
            self.npc_say(mob, "I've got nothing else you'd want.")
            return
        self.npc_say(mob, "Here's what we've got.")
        self.talk["mode"] = "buy"


    def closed(self, mob):
        return False

    def buy(self, mob, n):
        p = self.p
        offers = self.offers(mob)
        if not 1 <= n <= len(offers):
            self.npc_say(mob, "What?")
            return
        label, price, what = offers[n - 1]
        if price >= 100 and "haggle:%s:%d" % (mob.role, self.day_no()) \
                not in self.flags and mob.shop in ("sump", "commissary"):
            self.flags.add("haggle:%s:%d" % (mob.role, self.day_no()))
            if self.check("Intellect", ("Rimwise",), label="haggling",
                          stress=False):
                price = price * 3 // 4
                self.npc_say(mob, "Fine. %d. Don't tell anyone." % price)
        if price > p["credits"]:
            self.npc_say(mob, "That's %d. You've got %d." % (price,
                                                            p["credits"]))
            return
        p["credits"] -= price
        what()
        self.sound.play("gold")
        self.render_chrome()

    def patch_up(self):
        p = self.p
        if p["health"] >= p["maxhp"] and not p["bleed"]:
            self.say("Dr. %s looks you over. 'You'll live. For now.'" %
                     fill("{doctor_short}", self.world), "talk")
            return
        p["health"] = p["maxhp"]
        p["bleed"] = 0
        p["dying"] = 0
        self.pass_time(20, quiet=True)
        self.say("Twenty minutes of antiseptic and staples. (Health %d)" %
                 p["health"], "good")

    def treat_condition(self):
        p = self.p
        psych = [c for c in p["conds"] if c in (
            "coward", "frightened", "nightmares", "shaky", "paranoid",
            "spiraling", "doomed", "lost_skill", "haunted")]
        body = [c for c in p["conds"] if c in ("bullet", "ankle", "arm",
                                               "ribs", "concussion")]
        if not psych and not body:
            self.say("'There's nothing wrong with you that leaving won't "
                     "fix.'", "talk")
            return
        c = (body or psych)[0]
        p["conds"].remove(c)
        if c == "lost_skill":
            p["lost_skill"] = None
        self.pass_time(2 * 60, quiet=True)
        self.say("Two hours on the Infirmary couch. %s" % {
            "bullet": "She digs the bullet out, and you scream, and then "
                      "it's out.",
            "ankle": "Strapped and splinted.", "arm": "Set and splinted.",
            "ribs": "Strapped tight. Breathing hurts less.",
            "concussion": "Bed rest, of a kind."}.get(
                c, "Pills, and talking, and pills."), "good")
        self.render()

    # ── Errands ──

    def give_errand(self, mob):
        for e in self.world["errands"]:
            if e["giver"] == mob.role:
                mob.errand = e


    def errand(self, mob):
        e = mob.errand
        st = self.side.get(e["id"])
        if st is None:
            self.side[e["id"]] = {"state": "active"}
            if self.errand_ready(e):
                self.finish_errand(mob, e)
                return
            self.npc_say(mob, e["ask"])
            if e["kind"] == "rescue":
                self.trusted(mob.role)
                self.invite(mob)
        elif st["state"] == "done":
            self.npc_say(mob, "Thank you. I mean it.")
        elif self.errand_ready(e):
            self.finish_errand(mob, e)
        else:
            self.npc_say(mob, e["ask"])

    def errand_ready(self, e):
        if self.side.get(e["id"], {}).get("state") != "active":
            return False
        k = e["kind"]
        if k in ("fetch", "deliver"):
            return bool(self.p["items"].get(e["thing"]))
        if k == "pet":
            return "pet:" + e["id"] in self.flags
        if k == "fix":
            return "scrubbed" in self.flags
        if k == "rescue":
            return "rescued:" + e["id"] in self.flags
        return False

    def finish_errand(self, mob, e):
        self.side[e["id"]]["state"] = "done"
        if e["kind"] in ("fetch", "deliver"):
            self.take_item(e["thing"])
        self.npc_say(mob, e["thanks"])
        if e["pay"]:
            self.p["credits"] += e["pay"]
            self.say("You get %d credits." % e["pay"], "gold")
        self.trusted(e["giver"])
        if e["id"] == "cat":
            self.trusted("widow")
        self.lose_stress(1)
        self.sound.play("gold")

    def catch_pet(self, mob):
        e = mob.pet
        if self.check("Speed", ("Zoology", "Athletics"), label="catching "
                      "the cat", stress=False):
            self.area.mobs.remove(mob)
            self.flags.add("pet:" + e["id"])
            self.say("You scoop up Mister Buttons, who is wet and furious "
                     "and alive. One white foot.", "good")
            self.sound.play("gold")
        else:
            self.say("The cat slips out from under your hands and hisses "
                     "at you from the dark.", "info")
            for _ in range(3):
                self.drift(mob)
        self.end_turn()

    def on_arrival(self):
        """Whatever happens as you come somewhere."""
        a = self.area
        p = self.p
        role = p.get("companion")
        if role == "pilot" and a.kind != "dungeon" and \
                self.side.get("pilot", {}).get("state") == "active":
            self.flags.add("rescued:pilot")
            self.side["pilot"]["state"] = "done"
            e = next(e for e in self.world["errands"] if e["id"] == "pilot")
            self.say(fill("The pilot blinks at the lights. '%s'" %
                          e["thanks"], self.world), "talk")
            self.trusted("pilot")
        key = "arrive:%s" % (a.key,)
        if key in self.flags:
            return
        self.flags.add(key)
        text = {
            ("dun", "dig", 1): "The shaft foot: a cavern of blue ice, four "
                               "kilometres down. Your breath freezes on your "
                               "face. Scratched into the ice by the lift, "
                               "over and over: 4190.",
            ("dun", "dig", 2): "The breach. The ice here is ribbed, like "
                               "the inside of a chest, and there are faces "
                               "in it.",
            ("dun", "dig", 3): "The Reliquary. The walls are wet and warm "
                               "and they move, very slowly, in and out. "
                               "You're inside something's throat. At the "
                               "bottom of it, something sings.",
            ("dun", "magdalene", 1): "The Magdalene's hold: no air, no "
                                     "gravity worth the name, no light but "
                                     "yours. Frost on everything. Frost on "
                                     "the crew.",
            ("dun", "sector7", 1): "Sector 7. The dorms where the Dig crew "
