    # ── Journal and sheet ──

    def journal(self):
        if self.busy or self.talk:
            return
        if self.overlay == "journal":
            self.close_overlay()
            return
        w = self.world
        p = self.p
        lines = ["JOURNAL, %s" % self.date_text().upper(), ""]
        left = DUE - self.turn
        lines.append("The Due Diligence docks in %d hours %d minutes "
                     "(Day 4, 20:00)." % (left // 60, left % 60)
                     if left > 0 else "The Due Diligence is here.")
        lines.append("")
        for cid in self.clues:
            lines.append("* " + fill(CLUES[cid], w))
        lines.append("")
        lines.append("Evidence: " + (", ".join(
            fill(EVIDENCE[e], w) for e in self.evidence) or "none yet"))
        if self.aboard:
            lines += ["", "Waiting in the Patience's hold: " + ", ".join(
                w["people"][r]["name"] for r in self.aboard) +
                " (%d of 8)" % len(self.aboard)]
        if p["trust"]:
            lines += ["", "People who trust you: " + ", ".join(
                w["people"][r]["name"] for r in p["trust"]) + (
                "; %s is with you." % w["people"][p["companion"]]["first"]
                if p["companion"] else "")]
        gone = [w["people"][r]["name"] for r in self.taken]
        if gone:
