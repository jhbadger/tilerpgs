    # ── The end ──

    def launch(self, rip=False):
        """Cast off, and go, and leave the rest of it behind."""
        p = self.p
        lost = []
        if rip:
            self.say("You fire the main drive with the clamps still on. The "
                     "Patience screams. Metal tears.", "bad")
            ok = self.check("Intellect", ("Piloting", "Hyperspace"),
                            label="ripping free")
            hold = list(self.aboard)
            random.shuffle(hold)
            n = 0 if self.crit else len(hold) // 3 if ok else \
                (len(hold) + 1) // 2
            lost = hold[:n]
            for r in lost:
                self.aboard.remove(r)
                self.dead.append(r)
            if lost:
                self.say("The hold breaches. %s %s gone." % (
                    ", ".join(self.world["people"][r]["first"]
                              for r in lost),
                    "is" if len(lost) == 1 else "are"), "bad")
        if p.get("companion") and p["companion"] not in self.aboard:
            self.aboard.append(p["companion"])
        self.flags.add("won")
        self.lost_in_launch = lost
        self.save()
        self.sound.play("quest")
        self.render()
        self.root.after(800, self.show_won)

    def rating(self):
        w = self.world
        saved = [r for r in self.aboard if r != w["mimic"]]
        living = [r for r in SAVEABLE if r not in self.dead and
                  r not in self.taken and r != w["mimic"] and
                  r != "foreman"]
        return (1 + (len(saved) * 2 >= len(living)) +
                ("tooth_home" in self.flags and "sealed" in self.flags) +
                ("broadcast" in self.flags) +
                ("skin_dead" in self.flags or (
                    "unmasked" in self.flags and w["mimic"] not in
                    self.aboard)))

    def show_won(self):
        w = self.world
        p = self.p
        stars = self.rating()
        saved = [r for r in self.aboard if r != w["mimic"]]
        lines = ["THE PATIENCE CASTS OFF", "",
                 "Lazarus Deep falls away behind you: a ring of lights on",
                 "the ice, getting smaller, and then just the ice.", ""]
        if saved:
            lines += wrap("In the hold: %s." % ", ".join(
                w["people"][r]["name"] for r in saved), 60)
        else:
            lines.append("The hold is empty. It's just you.")
        lines.append("")
        if w["mimic"] in self.aboard:
            lines += wrap(fill("Three days out, someone wakes in the hold "
                               "to find {mimic_full} standing over the "
                               "cryopods, humming. You took it with you. "
                               "Wherever you're going, it's going too.", w),
                          60)
        elif "skin_dead" in self.flags:
            lines.append("The Second Skin is ash on a deck you'll never")
            lines.append("walk again.")
        if w["mimic"] in self.aboard or "skin_dead" in self.flags:
            lines.append("")
        if "tooth_home" in self.flags and "sealed" in self.flags:
            lines += wrap("Four kilometres down, under the rubble, "
                          "something with its tooth back settles into "
                          "sleep. It will wake. Not for a long time.", 60)
        elif "sealed" in self.flags:
            lines += wrap("The Dig is buried. But the Reliquary is missing "
                          "a tooth, and it knows where the tooth went.", 60)
        elif p["items"].get("the tooth"):
            lines += wrap("The Tooth is in your locker. It hums. "
                          "Halvorsen-Kade would pay anything for it. So "
                          "would the thing it belongs to.", 60)
        else:
            lines += wrap("Under the ice, the Psalm goes on. Someone else "
                          "will come. Someone always comes.", 60)
        lines.append("")
        if "broadcast" in self.flags:
            lines += wrap("Directive 9 is on every newsfeed on the Rim. "
                          "Halvorsen-Kade has a lot of explaining to do, "
                          "and lawyers to do it.", 60)
        else:
            lines += wrap("Halvorsen-Kade will say there was an accident. "
                          "Nobody will say otherwise. Nobody who was there.",
                          60)
        lines += ["", "Rating: %s" % ("*" * stars + "." * (5 - stars)),
                  "Crew: %s survived; %d lost." % (
                      p["name"], len(self.crew_lost)), "",
                  "Press N for a new station."]
        self.overlay = "won"
        self.overlay_text = "\n".join(lines)
        self.render()

    def due_diligence(self):
        if "won" in self.flags or "doom" in self.flags:
            return
        self.doom("witness" if "broadcast" in self.flags else "due")

