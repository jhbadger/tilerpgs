                 "crew. You want me to open the clamps. I'm not allowed. "
                 "Quarantine Order 9. I don't think it's a good order. I'm "
                 "not allowed to think that either.'", "talk")
        opts = []
        if p["skills"].get("Artificial Intelligence") or \
                p["skills"].get("Hacking") or p["skills"].get("Computers"):
            opts.append(("Reason with it (Intellect, AI)",
