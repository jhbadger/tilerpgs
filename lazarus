def block_rect(i, j, half=None):
    x0, x1 = COR_X[i] + 1, COR_X[i + 1] - 1
    y0, y1 = COR_Y[j] + 1, COR_Y[j + 1] - 1
    if half == "L":
        x1 = x0 + 5
    elif half == "R":
        x0 += 7
    return x0, y0, x1, y1


def district(x, y):
    """The part of the Ring a square lies in."""
    if PLAZA[0] <= x <= PLAZA[2] and PLAZA[1] <= y <= PLAZA[3]:
        return "the Concourse"
    if x <= COR_X[0]:
        return "the west corridor, by the docking ring"
    if x >= COR_X[-1]:
        return "the east corridor, by the Magdalene's umbilical"
    if y <= COR_Y[0]:
        return "the north corridor"
    if y >= COR_Y[-1]:
        return "the south corridor, over the ice yard"
    if y >= COR_Y[2]:
        return "the south ring, by Sector 7" if 33 <= x <= 47 else \
            "the south ring"
    return "the north ring" if y < COR_Y[1] + 2 else "the middle ring"


def make_city(world, flags):
    """The Ring: the same every game but for what's been done to it."""
    rng = random.Random("lazarus")
    W, H = CITY_W, CITY_H
    g = [["hull"] * W for _ in range(H)]
    area = Area("city", ("city",), g, "the Ring", edge="hull")
    used = set()
    for y in COR_Y:                     # the corridors
        for x in range(COR_X[0], COR_X[-1] + 1):
            g[y][x] = "grate" if x % 7 == 3 else "deck"
    for x in COR_X:
        for y in range(COR_Y[0], COR_Y[-1] + 1):
            g[y][x] = "grate" if y % 7 == 3 else "deck"
    for j in range(3):                  # the blocks: module walls
        for i in range(4):
            x0, y0, x1, y1 = block_rect(i, j)
            for y in range(y0, y1 + 1):
                for x in range(x0, x1 + 1):
                    g[y][x] = "pipes" if rng.random() < 0.08 else "crates" \
                        if rng.random() < 0.08 else "module"
    x0, y0, x1, y1 = PLAZA              # the Concourse
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = "plaza"
            used.add((x, y))
    for x, y in ((36, 20), (44, 20), (36, 26), (44, 26)):
        g[y][x] = "console"
    area.labels[(40, 23)] = "the Concourse"
    g[23][40] = "placard"
    area.labels[(40, 23)] = "the station directory"
    for y in range(COR_Y[0], COR_Y[-1] + 1, 4):     # lights
        for x in COR_X:
            if g[y][x] == "deck" and (x, y) not in used:
                g[y][x] = "lamp"
    for sid, (name, kind, (i, j, half), look) in SITES.items():
        x0, y0, x1, y1 = block_rect(i, j, half)
        for y in range(y0, y1 + 1):
            for x in range(x0, x1 + 1):
                g[y][x] = look
                used.add((x, y))
        door = ((x0 + x1 + 1) // 2, y1)
        g[door[1]][door[0]] = "hatch"
        area.links[door] = ("bld", sid)
        area.labels[door] = name
    # the hull, with viewports looking out from the outer corridors
    for y in range(H):
        for x in range(W):
            if g[y][x] == "hull" and (x + y) % 6 == 0 and (
                    (x in (COR_X[0] - 1, COR_X[-1] + 1) and
                     COR_Y[0] <= y <= COR_Y[-1]) or
                    (y in (COR_Y[0] - 1, COR_Y[-1] + 1) and
                     COR_X[0] <= x <= COR_X[-1])):
                g[y][x] = "viewport"
    for y in range(20, 27):             # the docking ring, each side
