    # ── Game setup ──

    def setup_world(self, seed):
        self.world = generate_world(seed)
        self.cache = {}

    def new_game(self, who=None):
        if who is None:
            if not getattr(self, "headless", False):
                def chosen(w):
                    if w is None:
                        if getattr(self, "area", None):
                            return
                        w = self.default_crew()
                    self.new_game(w)
                self.ask_crew(chosen)
                return
            who = self.default_crew()
        self.setup_world(random.randrange(1 << 31))
        self.p = self.make_crew(who)
        self.flags = set()
        self.clues = []
        self.topics = set()
        self.evidence = []
        self.side = {}                  # errands: id -> state
        self.aboard = []                # roles waiting in the Patience
        self.taken = []                 # roles the Second Skin has taken
        self.dead = []                  # roles who died
        self.crew_lost = []             # your own crew, dead or done
        self.remains = []               # where they fell
        self.turn = 0
        self.city = None
        self.reset_view()
        self.log.config(state="normal")
        self.log.delete("1.0", "end")
        self.log.config(state="disabled")
        self.city_pos = list(self.door_of("patience"))
        area = self.get_area(("bld", "patience"))
        self.area, self.pos = area, list(self.bed_spot(area))
        p = self.p
        self.say("Lazarus Deep. Day 1, 08:00 station time.", "quest")
        self.say("The cryopod lid hisses open. Cold, and a taste like "
                 "pennies. %s, %s %s, the first of the Patience's four to "
                 "be woken." % (p["name"], an(p["class"].lower()),
                                "(%s)" % p["spec"].lower()))
        self.say("The tug's computer, in its flat polite voice: 'We have "
                 "arrived at Lazarus Deep. The station has engaged docking "
                 "clamps. The station is not responding to hails. The "
                 "station has... asked us to wait.'", "talk")
        self.say("Your other three crew are still under. Through the "
                 "airlock, the Ring. Somewhere below it, very faintly, "
                 "something is humming.", "info")
        self.say("Arrow keys or WASD move; walk into people to talk. Press "
                 "? for help.", "info")
        self.learn("case", quiet=True)
        self.layout()
        self.save()

    def reset_view(self):
        self.overlay = None
        self.overlay_text = None
        self.end_talk()
        self.busy = False
        self.aim = None
        self.menu = None
        self.walking = None

    def restore(self, g):
        self.setup_world(int(g["seed"]))
        p = g["player"]
        for k in ("name", "class", "spec", "stats", "saves", "skills",
                  "health", "items", "on", "guns", "weapon", "armour"):
            if k not in p:
                raise ValueError("bad crew")
        if p["class"] not in CLASSES or p["spec"] not in \
                CLASSES[p["class"]]["specs"]:
            raise ValueError("bad crew")
        self.p = p
        self.flags = set(g.get("flags", []))
        self.clues = list(g.get("clues", []))
        self.topics = set(g.get("topics", []))
        self.evidence = list(g.get("evidence", []))
        self.side = {str(k): dict(v) for k, v in g.get("side", {}).items()}
        self.aboard = list(g.get("aboard", []))
        self.taken = list(g.get("taken", []))
        self.dead = list(g.get("dead", []))
        self.crew_lost = list(g.get("crew_lost", []))
        self.remains = list(g.get("remains", []))
        self.turn = int(g.get("turn", 0))
        self.city = None
        self.reset_view()
        city = self.get_area(("city",))
        city.seen = unpack_bits(g["seen"], CITY_W * CITY_H)
        self.city_pos = g.get("city_pos")
        self.surface = g.get("surface")
        if self.surface:
            self.surface = (tuple(self.surface[0]), self.surface[1])
        key = tuple(g["key"])
        self.area = self.get_area(key)
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        if not self.can_stand(*self.pos):
            self.pos = list(self.area.start)
        p["out"] = p["held"] = 0
        self.say("Lazarus Deep, %s." % self.date_text(), "quest")
        self.say("Still here, %s. Press ? for help." % p["name"], "info")
        self.layout()
        if "won" in self.flags:
            self.show_won()
        elif "doom" in self.flags:
            self.doom(self.flags_doom())

    def flags_doom(self):
        return next((f[5:] for f in self.flags if f.startswith("doom:")),
                    "due")

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "zoom": self.zoom_d, "text": self.text_k}
        if getattr(self, "p", None) and getattr(self, "area", None):
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "clues": self.clues,
                "topics": sorted(self.topics), "evidence": self.evidence,
                "side": self.side, "aboard": self.aboard,
                "taken": self.taken, "dead": self.dead,
                "crew_lost": self.crew_lost, "remains": self.remains,
                "turn": self.turn, "key": list(self.area.key),
                "pos": self.pos, "city_pos": self.city_pos,
                "surface": [list(self.surface[0]), self.surface[1]]
                if getattr(self, "surface", None) else None,
                "seen": pack_bits(self.get_area(("city",)).seen)}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.root.destroy()


    # ── Areas ──

    def get_area(self, key):
        if key in self.cache:
            return self.cache[key]
        w = self.world
        if key[0] == "city":
            area = make_city(w, self.flags)
            self.populate_city(area)
            area.lit = {(x + dx, y + dy) for y in range(area.h)
                        for x in range(area.w) if area.grid[y][x] == "lamp"
                        for dx in range(-2, 3) for dy in range(-2, 3)
                        if abs(dx) + abs(dy) <= 3}
        elif key[0] == "bld":
            if key[1] not in SITES and key[1] not in BIG_SITES:
                raise ValueError("bad site")
            area = make_interior(w, key[1], self.flags)
            self.settle(area)
        elif key[0] == "dun":
            lid, level = key[1], int(key[2])
            if lid not in LEADS or not 1 <= level <= LEADS[lid].levels:
                raise ValueError("bad level")
            area = make_dungeon(w, lid, level, self.flags)
            key = area.key
            self.below(area)
        else:
            raise ValueError("bad area")
        for r in getattr(self, "remains", []):
            if tuple(r["key"]) == tuple(key):
                pos = tuple(r["pos"])
                area.items[pos] = "corpse"
                area.bodies[pos] = r
        self.cache[key] = area
        return area

    def gone(self, role):
        """Whether someone is no longer where they used to be."""
        return (role in self.aboard or role in self.taken or
                role in self.dead or (role == self.world["mimic"] and
                                      "unmasked" in self.flags) or
                (role == "prisoner" and "freed" in self.flags and
                 "prisoner_moved" in self.flags))

    def settle(self, area):
        """Who's in a module now: not the taken, the dead or the ones who
        went aboard; the Patience has whoever's waiting in its hold."""
        area.mobs = [m for m in area.mobs if not self.gone(m.role)]
        if area.site == "dock" and "pilot" in self.side and \
                self.side["pilot"].get("state") == "done" and \
                not self.gone("pilot"):
            x, y = 9, 2
            area.mobs.append(make_person(self.world, "pilot", x, y))
        if area.site == "dorms" and self.side.get("ring", {}).get(
                "state") == "done" and "freed" in self.flags and \
                not self.gone("prisoner"):
            area.mobs.append(make_person(self.world, "prisoner", 10, 4))
        if area.site == "patience":
            spots = [(x, y) for y in range(area.h) for x in range(area.w)
                     if area.grid[y][x] == "floor" and x >= 5 and
                     (x, y) != area.start]
            for role, (x, y) in zip(self.aboard, spots[::-1]):
                m = make_person(self.world, role, x, y)
                m.title = fill(self.world["people"][role]["title"],
                               self.world) + ", aboard"
                area.mobs.append(m)
        for m in area.mobs:
            self.give_errand(m)

    def below(self, area):
        """What's happened down here: who's been taken shows up hollowed."""
        rng = random.Random("%s:%s" % (area.key, len(self.taken)))
        for role in self.taken:
            if self.world["people"][role].get("young"):
                continue
            where = self.taken_to(role)
            if where != area.key[1:]:
                continue
            spots = [(x, y) for y in range(area.h) for x in range(area.w)
                     if area.grid[y][x] == "dfloor" and
                     not area.mob_at(x, y) and
                     abs(x - area.start[0]) + abs(y - area.start[1]) > 8]
            if spots:
                x, y = rng.choice(spots)
                area.mobs.append(self.hollowed_one(role, x, y))

        if area.key == ("dun", "reclaim", 1) and "pet:cat" not in \
                self.flags and self.side.get("cat", {}).get("state") != \
                "done":
            e = next(e for e in self.world["errands"] if e["id"] == "cat")
            spots = [(x, y) for y in range(area.h) for x in range(area.w)
                     if area.grid[y][x] == "dfloor" and
                     not area.mob_at(x, y) and
                     abs(x - area.start[0]) + abs(y - area.start[1]) > 12]
            x, y = rng.choice(spots)
            cat = Mob("pet", "Mister Buttons", x, y)
            cat.pet = e
            cat.title = "a grey cat with one white foot"
            area.mobs.append(cat)
        if area.key == ("dun", "reclaim", 2) and \
                self.side.get("pilot", {}).get("state") != "done" and \
                not self.gone("pilot") and self.p.get("companion") != "pilot":
            spots = [(x, y) for y in range(area.h) for x in range(area.w)
                     if area.grid[y][x] == "dfloor" and
                     not area.mob_at(x, y) and
                     abs(x - area.start[0]) + abs(y - area.start[1]) > 14]
            x, y = rng.choice(spots)
            m = make_person(self.world, "pilot", x, y)
            self.give_errand(m)
            area.mobs.append(m)

    def taken_to(self, role):
        """Where a taken person ends up: below, somewhere dark."""
        rng = random.Random("%s:taken:%s" % (self.world["seed"], role))
        return rng.choice((("sector7", 1), ("sector7", 2), ("dig", 1),
                           ("reclaim", 1), ("under", 1)))

    def hollowed_one(self, role, x, y):
        who = self.world["people"][role]
        m = make_monster("hollowed", x, y)
        m.tile = "hollow%d" % (len(role) % 3) if len(role) % 3 else "hollow"
        m.name = "%s, hollowed" % who["name"]
        m.was = role
        return m

    def populate_city(self, area):
        """The Ring's own: nobody walks it much now.  The hollowed do."""
        area.folk = []
        area.mobs = []
        rng = random.Random("%s:ring" % self.world["seed"])
        for i in range(2 + len(self.taken) // 2):
            spots = [(x, y) for y in range(area.h) for x in range(area.w)
                     if area.grid[y][x] in ("deck", "grate") and
                     abs(x - area.start[0]) + abs(y - area.start[1]) > 20]
            x, y = rng.choice(spots)
            m = make_monster("hollow", x, y)
            m.tile = rng.choice(("hollow", "hollow1", "hollow2"))
            area.folk.append(m)

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        if area.kind == "city":
            self.night_and_day()
        self.sound.play(sound)
        self.layout()
        self.save()
        self.on_arrival()

    def go_outside(self):
        """Out of a module, onto the Ring."""
        city = self.get_area(("city",))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.enter(city, self.city_pos or city.start)
        self.say("You step out into %s." % district(*self.pos), "info")

    def enter_link(self, link, x, y):
        kind, what = link
        if kind == "bld":
            self.city_pos = list(self.pos)
            self.cache.pop(("bld", what), None)
            if what == "blasting" and "open:blasting" not in self.flags:
                self.blasting_door()
                return
            area = self.get_area(("bld", what))
            self.flags.add("been:" + what)
            self.say("You go into %s." % area.name, "info")
            self.enter(area, area.start)
            return
        self.at_lead(what, x, y)

    def descend(self, lid):
        if self.area.kind == "city":
            self.city_pos = list(self.pos)
        self.surface = (self.area.key, list(self.pos))
        area = self.get_area(("dun", lid, 1))
        self.say("You go down into %s." % LEADS[lid].name, "info")
        self.enter(area, area.start, "stairs")

    def change_level(self, delta):
        _, lid, level = self.area.key
        if level + delta == 0:
            key, pos = self.surface
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dun"}
            area = self.get_area(tuple(key))
            self.say("You climb back up, into the light. What there is of "
                     "it.", "info")
            self.enter(area, pos, "stairs")
            return
        area = self.get_area(("dun", lid, level + delta))
        self.say("You go %s: %s." % ("down" if delta > 0 else "up",
                                     LEVEL_NAMES[(lid, level + delta)]),
                 "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

