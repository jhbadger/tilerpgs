        """Stats, Saves and Health, rolled."""
        return {"stats": {s: roll("2d10+25", rng) for s in STATS},
                "saves": {s: roll("2d10+10", rng) for s in SAVES},
                "health": roll("1d10+10", rng),
                "credits": roll("2d10", rng) * 10,
                "loadout": rng.randrange(5),
                "trinket": rng.choice(TRINKETS),
                "patch": rng.choice(PATCHES)}

    @staticmethod
    def make_crew(who):
        """A crew member from what the creation dialog chose."""
        cls, spec, r = who["class"], who["spec"], who["rolled"]
        c = CLASSES[cls]
        stats = dict(r["stats"])
        saves = dict(r["saves"])
        for s, n in c["stats"].items():
            stats[s] += n
        for s, n in c["saves"].items():
            saves[s] += n
        if cls in CLASS_TWEAK:
            s, n = CLASS_TWEAK[cls]
            stats[s] += n
        skills = {}
        for s in c["skills"] + c["specs"][spec]:
            skills[s] = SKILLS[s][0]
        armour, kit = LOADOUTS[cls][r["loadout"] % len(LOADOUTS[cls])]
        items = {}
        guns = {}
        for k in kit:
            items[k] = items.get(k, 0) + 1
            if k in WEAPONS and WEAPONS[k].shots:
                guns[k] = WEAPONS[k].shots
        if "chemlights" in items:
            items["chemlights"] = 3
        weapon = next((k for k in kit if k in WEAPONS and k != "frag grenade"),
                      "fists")
        p = {"name": who["name"], "sex": who["sex"], "class": cls,
             "spec": spec, "stats": stats, "saves": saves, "skills": skills,
             "maxhp": r["health"], "health": r["health"], "wounds": 0,
             "maxwounds": c["wounds"], "stress": 2, "minstress": 2,
             "credits": r["credits"], "items": items, "guns": guns,
             "weapon": weapon, "armour": armour,
             "ap": ARMOUR[armour].ap, "air": ARMOUR[armour].air,
             "punctured": False, "bleed": 0, "burning": 0, "conds": [],
             "lost_skill": None, "on": {}, "out": 0, "held": 0,
             "dying": 0, "stims": [], "slept": 0, "rest_adv": 0,
             "goggles": False, "trust": [], "companion": None,
             "teamster_day": -1, "trinket": r["trinket"],
             "patch": r["patch"], "kills": 0}
        return p

