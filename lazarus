def roll(expr, rng=random):
    """Dice such as '2d10+25', '1d10+1', '-1d5', '3d10' or '0'."""
    total = 0
    for sign, term in re.findall(r"([+-]?)(\d+d\d+|\d+)",
                                 str(expr).replace(" ", "")):
        if "d" in term:
            n, s = (int(v) for v in term.split("d"))
            v = sum(rng.randint(1, s) for _ in range(n))
        else:
            v = int(term)
        total += -v if sign == "-" else v
    return total


def d100(rng=random):
    """Percentile dice, 0 to 99: a tens die and a ones die."""
    return rng.randint(0, 9) * 10 + rng.randint(0, 9)


