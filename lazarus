def selftest():
    """Build every map and tune of a few stations, without a window."""
    for seed in range(6):
        w = generate_world(seed)
        flags = set()
        for city in (make_city(w, flags), make_city(w, {"open:sector7"})):
            doors = [p for p, l in city.links.items() if l[0] == "bld"]
            assert len(doors) == len(SITES) + 1, doors
            seen, q = {city.start}, deque([city.start])
            while q:
                x, y = q.popleft()
                for dx, dy in DIRS:
                    n = (x + dx, y + dy)
                    if city.inside(*n) and n not in seen and \
                            city.grid[n[1]][n[0]] in WALKABLE:
                        seen.add(n)
                        if city.grid[n[1]][n[0]] in CITY_GROUND:
                            q.append(n)
            for pos, l in city.links.items():
                assert pos in seen, ("unreachable", l, pos)
        for sid in list(SITES) + list(BIG_SITES):
            a = make_interior(w, sid, flags)
            assert all(len(r) == a.w for r in a.grid), sid
            assert a.grid[a.start[1]][a.start[0]] in INSIDE_FLOOR, sid
            for m in a.mobs:
                assert a.grid[m.y][m.x] in INSIDE_FLOOR, (sid, m.role)
                fill(m.greet, w)
                for v in m.talk.values():
                    for s in ([v] if isinstance(v, str) else
                              [x for x in v.values()
                               if isinstance(x, str)]):
                        fill(s, w)
        for lid, info in LEADS.items():
            for level in range(1, info.levels + 1):
                a = make_dungeon(w, lid, level, flags)
                assert a.grid[a.start[1]][a.start[0]] == "stairs_up"
                seen, q = {a.start}, deque([a.start])
                while q:
                    x, y = q.popleft()
                    for dx, dy in DIRS:
                        n = (x + dx, y + dy)
                        if n not in seen and a.grid[n[1]][n[0]] in (
                                DUNGEON_FLOOR | {"gate", "crate"}):
                            seen.add(n)
                            q.append(n)
                if a.down:
                    assert a.down in seen, (lid, level)
                for pos in a.bodies:
                    assert pos in seen, (lid, level, "body")
                if lid == "dig" and level == 3:
                    assert any(m.boss and (m.x, m.y) in seen
                               for m in a.mobs)
        for thing, (lid, level) in w["stash"].items():
            a = make_dungeon(w, lid, level, flags)
            assert any(thing in b["things"] for b in a.bodies.values()), \
                thing
        for text in list(RUMOURS.values()) + list(TOPICS.values()) + \
                list(w["tells"].values()) + [e["ask"] for e in ERRANDS] + \
                [e["thanks"] for e in ERRANDS]:
            fill(text, w)
        for cid, text in CLUES.items():
            fill(text, w)
        for role in ROLE_TALK:
            assert role in ROLES, role
    for cls, c in CLASSES.items():
        for spec in c["specs"]:
            for n in range(5):
                r = Game.roll_crew(random.Random(n))
                r["loadout"] = n
                p = Game.make_crew({"name": "Test", "sex": "F",
                                    "class": cls, "spec": spec,
                                    "rolled": r})
                for s in p["skills"]:
                    assert s in SKILLS, s
                for k in p["items"]:
                    assert k in ITEMS, k
                assert p["armour"] in ARMOUR
                assert p["weapon"] in WEAPONS, p["weapon"]
    for name, tune in MUSIC.items():
        steps = len(tune["melody"].replace("|", " ").split())
        assert steps == len(tune["chords"].split()) * tune["bar"], name
    tiles = all_tiles()
    clash = set(TERRAIN) & (set(PEOPLE) | set(ART))
    assert not clash, clash
    for name in list(TILE_NEEDED):
        assert name in tiles, name
    for t in (WALKABLE | set(OPAQUE["city"])) - {"dfloor"}:
        assert t in tiles, t
    print("ok")


