class Area:
    """A map: the Ring, a module, or a level below."""

    def __init__(self, kind, key, grid, name, edge=None, dark=False):
        self.kind, self.key, self.grid, self.name = kind, key, grid, name
        self.h, self.w = len(grid), len(grid[0])
        self.edge = edge
        self.dark = dark
        self.mobs = []
        self.items = {}         # (x, y) -> thing lying there
        self.bodies = {}        # (x, y) -> what's on a corpse
        self.links = {}         # (x, y) -> ("bld", site) or ("lead", lead)
        self.labels = {}        # (x, y) -> what it is
        self.hidden = {}        # (x, y) -> found by searching
        self.loot = set()       # crates not yet opened
        self.traps = set()
        self.signs = {}
        self.scared = set()     # kinds of monster already faced here
        self.knockouts = 0
        self.skin = {}
        self.seen = bytearray(self.w * self.h)
        self.opaque = OPAQUE[kind]
        self.start = (0, 0)
        self.down = None
        self.site = None
        self.lead = None
        self.vacuum = False
        self.cold = False

    def inside(self, x, y):
        return 0 <= x < self.w and 0 <= y < self.h

    def mob_at(self, x, y):
        for m in self.mobs:
            if m.x == x and m.y == y:
                return m
        return None


class Mob:
    def __init__(self, tile, name, x, y):
        self.tile, self.name, self.x, self.y = tile, name, x, y
        self.kind = None
        self.hostile = False
        self.health = self.maxhealth = 1
        self.boss = False
        self.flee = 0
        self.aware = False
        self.stuck = 0          # stunned, stuck, tranquillized
        self.burning = 0
        self.down = 0           # a Second Skin, getting back up
        self.title = name
        self.role = None
        self.talk, self.greet = {}, ""
        self.known = False
        self.shop = None
        self.mimic = False
        self.roam = None
        self.home = None
        self.errand = None      # the errand this person gives
        self.pet = None         # a lost cat: its errand
        self.ally = False       # someone who came with you
        self.visitor = False    # ...and isn't from round here
        self.was = None         # a hollowed one: who they were
        self.night_owl = False


def make_monster(kind, x, y, boss=False, rng=random):
    m = MONSTERS[kind]
    mob = Mob(m.tile, m.name, x, y)
    mob.kind = kind
    mob.hostile = True
    mob.health = mob.maxhealth = m.health
    mob.boss = boss or "boss" in m.traits
    return mob


def role_talk(world, role):
    greet, talk = ROLE_TALK.get(role, ("...", {}))
    talk = dict(talk)
    tell = world["tells"].get(role)
    if tell:
        talk["news"] = tell
        talk.setdefault("mimi", tell)
    return talk, greet


