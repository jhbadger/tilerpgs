        self.overlay_text = "\n".join(wrapped)
        self.render()

    # ── Menus ──

    def open_menu(self, title, items, cancel=None):
        self.menu = {"title": title, "items": items, "sel": 0,
                     "cancel": cancel}
        self.render()

    def menu_move(self, d):
        m = self.menu
        m["sel"] = (m["sel"] + d) % len(m["items"])
        self.render()

    def menu_pick(self, i=None):
        if i in ("up", "down"):
            m = self.menu
            page = m.get("page", 1)
            m["sel"] = max(0, min(len(m["items"]) - 2, m["sel"] + (
                page if i == "down" else -page)))
            self.render()
            return
        m, self.menu = self.menu, None
        self.render()
        m["items"][m["sel"] if i is None else i][1]()

    def menu_cancel(self):
        m, self.menu = self.menu, None
        self.render()
        if m["cancel"]:
            m["cancel"]()

    def draw_menu(self):
        c, m = self.canvas, self.menu
        W, H = c.winfo_width(), c.winfo_height()
        size = 16 if ANDROID else 14
        f, bold = F("Helvetica", size), F("Helvetica", size, "bold")
        rh = f.metrics("linespace") + S(16 if ANDROID else 10)
        labels = [label for label, _ in m["items"]]
        title = m["title"]
        bw = min(W - 20, max([f.measure(t) for t in labels] +
                             [bold.measure(title)]) + 40)
        if bold.measure(title) > bw - 40:
            title = "\n".join(wrap(title, max(20, len(title) * (bw - 40) //
                                              bold.measure(title))))
        th = (title.count("\n") + 1) * rh
        fit = max(1, (H - 2 * rh - th) // rh)
        n_items = len(labels)
        if n_items <= fit:
            shown = list(enumerate(labels))
        else:
            # Too long for the screen: a scrolling window, with arrows to
            # tap, and the last item (Bye, Nothing, Quit) always in view.
            page = max(1, fit - 3)
            m["page"] = page
            first = max(0, min(m["sel"] - page // 2, n_items - 1 - page))
            shown = [("up", "\u25b2 more" if first else "")] + \
                [(i, labels[i]) for i in range(first, first + page)] + \
                [("down", "\u25bc more" if first + page < n_items - 1
                  else ""), (n_items - 1, labels[-1])]
        bh = len(shown) * rh + th + 16
        x0, y0 = (W - bw) // 2, max(8, (H - bh) // 2)
        c.create_rectangle(x0, y0, x0 + bw, y0 + bh, fill=PANEL,
                           outline=ACCENT, width=2, tags="overlay")
        c.create_text(x0 + 20, y0 + 8 + th // 2, text=title, anchor="w",
                      fill=ACCENT, font=bold, tags="overlay")
        self.menu_rows = []
        for n, (i, label) in enumerate(shown):
            ry = y0 + 8 + th + n * rh
            if i == m["sel"]:
                c.create_rectangle(x0 + 6, ry, x0 + bw - 6, ry + rh,
                                   fill="#3a2a14", outline="",
                                   tags="overlay")
            if isinstance(i, str):
                if label:
                    c.create_text(x0 + bw // 2, ry + rh // 2, text=label,
                                  fill=ACCENT, font=f, tags="overlay")
                    self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))
                continue
            c.create_text(x0 + 20, ry + rh // 2, text=label, anchor="w",
                          fill=INK, font=f, tags="overlay")
            self.menu_rows.append((x0, ry, x0 + bw, ry + rh, i))


    def action_menu(self):
        if self.busy or self.talk:
            return
        if self.overlay not in ("won", "doom"):
            self.overlay = None
        items = [("Help", self.show_help), ("Journal", self.journal),
                 ("Your crew member", self.show_sheet),
                 ("Map", self.toggle_map), ("Search here", self.search),
                 ("Reload", self.reload), ("Use something", self.use_menu),
                 ("Zoom in", lambda: self.zoom(1)),
                 ("Zoom out", lambda: self.zoom(-1)),
                  ("Bigger text", lambda: self.text_size(1)),
                  ("Smaller text", lambda: self.text_size(-1)),
                 ("Sound effects %s" % ("on" if self.sound.muted else
                                        "off"), self.toggle_mute),
                 ("Music %s" % ("on" if self.sound.music_off else "off"),
                  self.toggle_music),
                 ("New game", self.ask_new_game), ("Quit", self.quit)]
        if self.overlay in ("won", "doom"):
            items = [("New game", self.new_game), ("Quit", self.quit)]
        self.open_menu("Lazarus Deep", items)

    def close_won(self):
        self.overlay = None
        self.render()


    # ── Taps and walking ──

    def on_tap(self, ev):
        self.walking = None
        if not self.cells:
            return
        if self.menu:
            for x0, y0, x1, y1, i in self.menu_rows:
                if x0 <= ev.x <= x1 and y0 <= ev.y <= y1:
                    self.menu_pick(i)
                    return
            if not self.talk:
                self.menu_cancel()
            return
        if self.busy or self.talk:
            return
        if self.overlay:
            self.close_overlay()
            return
        cols, rows, ox, oy, ts = self.view
        tx = self.pos[0] - cols // 2 + (ev.x - ox) // ts
        ty = self.pos[1] - rows // 2 + (ev.y - oy) // ts
        dx, dy = tx - self.pos[0], ty - self.pos[1]
        step = ((1 if dx > 0 else -1, 0) if abs(dx) >= abs(dy)
                else (0, 1 if dy > 0 else -1))
        if self.aim:
            if (dx, dy) == (0, 0):
                self.aim = None
                self.say("Never mind.", "info")
            else:
                self.aimed(*step)
        elif (dx, dy) == (0, 0):
            self.wait()
        elif abs(dx) + abs(dy) == 1:
            self.move(dx, dy)
        else:
            self.walk_to(tx, ty)


    def passable(self, x, y, goal):
        a = self.area
        if not a.inside(x, y):
            return False
        if (x, y) == goal:
            return True
        t = a.grid[y][x]
        m = a.mob_at(x, y)
        if (m and not m.ally) or (x, y) in a.links:
            return False
        return self.can_stand(x, y) and t not in (
            "stairs_up", "stairs_down", "exit", "crevasse", "rad", "steam",
            "breach", "sludge")

    def walk_to(self, tx, ty):
        start, goal = tuple(self.pos), (tx, ty)
        prev = {start: None}
        q = deque([start])
        while q and goal not in prev:
            x, y = q.popleft()
            if abs(x - start[0]) + abs(y - start[1]) > 50:
                continue
            for dx, dy in DIRS:
                n = (x + dx, y + dy)
                if n not in prev and self.passable(n[0], n[1], goal):
                    prev[n] = (x, y)
                    q.append(n)
        if goal not in prev:
            self.say("You can't find a way there.", "info")
            return
        path = []
        while goal != start:
            path.append(goal)
            goal = prev[goal]
        self.walking = path[::-1]
        self.walk_area = self.area
        self.walk_seen = self.hostiles_in_view()
        self.walk_step()


    def hostiles_in_view(self):
        return {id(m) for m in self.area.mobs
                if m.hostile and (m.x, m.y) in self.visible}

    def walk_step(self):
        if (not self.walking or not self.ready()
                or self.area is not self.walk_area):
            self.walking = None
            return
        before = tuple(self.pos)
        x, y = self.walking.pop(0)
        self.move(x - before[0], y - before[1])
        if tuple(self.pos) != (x, y):
            # a fast step may have gone further along the path
            while self.walking and tuple(self.pos) != (x, y):
                x, y = self.walking.pop(0)
            if tuple(self.pos) != (x, y):
                self.walking = None
                return
        if self.hostiles_in_view() - self.walk_seen:
            self.walking = None
            return
        if self.walking:
            self.root.after(90, self.walk_step)

    def wait(self):
        if not self.ready():
            return
        if self.p["held"]:
            self.p["held"] -= 1
        self.say("You wait.", "info")
        self.end_turn()


    # ── Drawing ──

    def layout(self):
        if not getattr(self, "area", None):
            return
        c = self.canvas
        scale = self.auto_scale()
        if scale != self.scale:
            self.scale = scale
            self.scale_images()
        c.delete("all")
        ts = 16 * self.scale
        W, H = max(c.winfo_width(), ts * 5), max(c.winfo_height(), ts * 5)
        cols, rows = W // ts, H // ts
        cols -= 1 - cols % 2
        rows -= 1 - rows % 2
        ox, oy = (W - cols * ts) // 2, (H - rows * ts) // 2
        self.view = (cols, rows, ox, oy, ts)
        self.cells = []
        for j in range(rows):
            for i in range(cols):
                x, y = ox + i * ts, oy + j * ts
                self.cells.append((
                    c.create_image(x, y, anchor="nw", state="hidden"),
                    c.create_image(x, y, anchor="nw", state="hidden")))
        self.shown = [(None, None)] * len(self.cells)
        self.fx = c.create_image(0, 0, anchor="nw", state="hidden")
        self.missile = c.create_image(0, 0, anchor="nw", state="hidden")
        self.place_companion()
        self.render()

    @staticmethod
    def line_clear(a, x0, y0, x1, y1):
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx + dy
        x, y = x0, y0
        while (x, y) != (x1, y1):
            if (x, y) != (x0, y0) and a.grid[y][x] in a.opaque:
                return False
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x += sx
            if e2 <= dx:
                err += dx
                y += sy
        return True


    def light_radius(self):
        a, p = self.area, self.p
        light = 2
        if p["items"].get("flashlight") or p["items"].get("headlamp"):
            light = 7
        elif "chem" in p["on"]:
            light = 4
        if "flare" in p["on"]:
            light = max(light, 10)
        if "eyes" in p["conds"]:
            light = max(1, light - 3)
        if a.dark:
            return light
        if a.kind != "city":
            return None
        ph = self.phase()
        if ph == "day":
            return None
        return max(light, 12 if ph in ("dawn", "dusk") else 5)

    def compute_visible(self):
        a = self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        r = self.light_radius()
        r2 = r * r if r else None
        lit = getattr(a, "lit", set()) if r else set()
        vis = set()
        for y in range(max(0, py - rows // 2), min(a.h, py + rows // 2 + 1)):
            for x in range(max(0, px - cols // 2),
                           min(a.w, px + cols // 2 + 1)):
                if r2 and (x - px) ** 2 + (y - py) ** 2 > r2 and \
                        (x, y) not in lit:
                    continue
                if self.line_clear(a, px, py, x, y):
                    vis.add((x, y))
                    a.seen[y * a.w + x] = 1
        return vis


    def mob_tile(self, m):
        """What a mob looks like: through infrared goggles, the living glow
        and the hollow don't."""
        if not self.p["goggles"]:
            return m.tile
        cold = m.mimic or (m.kind and "cold" in MONSTERS[m.kind].traits)
        if m.mimic and not m.kind and "goggled" not in self.flags:
            self.flags.add("goggled")
            self.say(fill("Through the goggles, everyone glows: warm, "
                          "orange, alive. Except {mimic_full}, who is the "
                          "same cold blue as the walls.", self.world), "bad")
            self.gain_stress(1, quiet=True)
        name = ("cold_" if cold else "warm_") + m.tile
        return name if name in self.img else m.tile

    def render(self):
        if not self.cells or not getattr(self, "area", None):
            return
        c, a = self.canvas, self.area
        cols, rows = self.view[0], self.view[1]
        px, py = self.pos
        self.visible = vis = self.compute_visible()
        dim = a.dark or self.light_radius() is not None
        mobs = {(m.x, m.y): m for m in a.mobs}
        you = self.you_tile()
        x0, y0 = px - cols // 2, py - rows // 2
        for j in range(rows):
            y = y0 + j
            for i in range(cols):
                x = x0 + i
                base = top = None
                if a.inside(x, y):
                    t = a.grid[y][x]
                    if (x, y) in vis:
                        base = self.framed(a.skin.get(t, t))
                        m = mobs.get((x, y))
                        if m:
                            top = self.mob_tile(m) if not m.down else \
                                "corpse"
                        else:
                            top = a.items.get((x, y))
                    elif dim and a.seen[y * a.w + x]:
                        base = "~" + a.skin.get(t, t)
                elif a.edge:
                    base = self.framed(a.edge)
                if x == px and y == py:
                    top = you
                top = self.framed(top)
                idx = j * cols + i
                old = self.shown[idx]
                if old == (base, top):
                    continue
                self.shown[idx] = (base, top)
                bid, tid = self.cells[idx]
                if base != old[0]:
                    if base is None:
                        c.itemconfig(bid, state="hidden")
                    elif base[0] == "~":
                        c.itemconfig(bid, image=self.dimg[base[1:]],
                                     state="normal")
                    else:
                        c.itemconfig(bid, image=self.img[base],
                                     state="normal")
                if top != old[1]:
                    if top is None:
                        c.itemconfig(tid, state="hidden")
                    else:
                        c.itemconfig(tid, image=self.img[top],
                                     state="normal")
        c.delete("overlay")
        if self.overlay == "map":
            self.draw_map()
        elif self.overlay == "help":
            self.draw_text_box(HELP)
        elif self.overlay in ("sheet", "journal"):
            self.draw_text_box(self.overlay_text)
        elif self.overlay in ("won", "doom"):
            self.draw_text_box(self.overlay_text,
                               ACCENT if self.overlay == "won" else BAD)
        if self.menu:
            self.draw_menu()
        self.render_chrome()

    def flash(self, x, y, tile="hit"):
        cols, rows, ox, oy, ts = self.view
        i = x - self.pos[0] + cols // 2
        j = y - self.pos[1] + rows // 2
        if not (0 <= i < cols and 0 <= j < rows):
            return
        self.fx_token += 1
        token = self.fx_token
        self.canvas.coords(self.fx, ox + i * ts, oy + j * ts)
        self.canvas.itemconfig(self.fx, image=self.img[tile], state="normal")
        self.canvas.tag_raise(self.fx)

        def hide():
            if token == self.fx_token:
                self.canvas.itemconfig(self.fx, state="hidden")
        self.root.after(160, hide)

    def draw_text_box(self, text, color=INK):
        c = self.canvas
        W, H = c.winfo_width(), c.winfo_height()
        t = c.create_text(W / 2, H / 2, text=text, fill=color, font=F(*MONO),
                          justify="left", tags="overlay")
        x0, y0, x1, y1 = c.bbox(t)
        r = c.create_rectangle(x0 - 20, y0 - 16, x1 + 20, y1 + 16,
                               fill=PANEL, outline=ACCENT, width=2,
                               tags="overlay")
        c.tag_raise(t, r)


    def draw_map(self):
        c, a = self.canvas, self.get_area(("city",))
        W, H = c.winfo_width(), c.winfo_height()
        rows = []
        for y in range(a.h):
            row = []
            for x in range(a.w):
                if not a.seen[y * a.w + x]:
                    row.append("#000000")
                else:
                    t = a.grid[y][x]
                    row.append("#e0a040" if (x, y) in a.links else
                               "#f0e0a0" if t == "lamp" else self.avg[t])
            rows.append("{" + " ".join(row) + "}")
        img = tk.PhotoImage(width=a.w, height=a.h)
        img.put(" ".join(rows))
        z = max(1, min((W - 20) // a.w, (H - 50) // a.h))
        self.map_img = img.zoom(z)
        c.create_rectangle(0, 0, W, H, fill="black", tags="overlay")
        mx, my = (W - a.w * z) / 2, (H - a.h * z) / 2 + 10
        c.create_image(mx, my, image=self.map_img, anchor="nw",
                       tags="overlay")
        small = F("Helvetica", 9 if z < 7 else 11)
        for (x, y), name in a.labels.items():
            if a.seen[y * a.w + x] and (x, y) in a.links:
                c.create_text(mx + (x + 0.5) * z, my + y * z - 2,
                              text=name.replace("the ", "", 1),
                              fill="#ffffff", font=small, anchor="s",
                              tags="overlay")
        if self.area is a:
            px, py = self.pos
        else:
            px, py = self.city_pos or a.start
        c.create_rectangle(mx + px * z - 2, my + py * z - 2,
                           mx + (px + 1) * z + 2, my + (py + 1) * z + 2,
                           outline="#ffff00", width=2, tags="overlay")
        c.create_text(W / 2, my - 14, fill=ACCENT, font=F(*MONO), tags="overlay",
                      text="The Ring   (orange: hatches and ways down; any "
                           "key closes)")

    def render_chrome(self):
        p = self.p
        a = self.area
        here = a.name if a.kind != "city" else "The Ring: " + district(
            *self.pos)
        near = [a.labels[(self.pos[0] + dx, self.pos[1] + dy)]
                for dx, dy in DIRS + ((0, 0),)
                if (self.pos[0] + dx, self.pos[1] + dy) in a.labels]
        if near and a.kind == "city":
            here += ", by " + near[0]
        self.status.config(text=cap(here))
        left = DUE - self.turn
        self.turns.config(text="%s   (%s)" % (
            self.date_text(), "Due Diligence in %dh %02dm" % (
                left // 60, left % 60) if left > 0 else
            "THE DUE DILIGENCE IS HERE"))
        w = p["weapon"]
        lines = [p["name"], "%s, %s" % (p["class"], p["spec"]), "",
                 "Health %2d/%-2d" % (max(0, p["health"] or 0), p["maxhp"]),
                 "Wounds %d/%d" % (p["wounds"], p["maxwounds"]),
                 "Stress %d (min %d)" % (p["stress"], p["minstress"]),
                 "Armour %s, AP %d" % (p["armour"], p["ap"]),
                 "Credits %d" % p["credits"], ""]
        if w in WEAPONS and WEAPONS[w].shots:
            lines.append("%s %d/%d (+%d)" % (
                w, p["guns"].get(w, 0), WEAPONS[w].shots,
                p["items"].get(WEAPONS[w].ammo, 0)))
        else:
            lines.append("In hand: %s" % w)
        if a.vacuum and p["class"] != "Android":
            lines.append("Air: %d min" % p["air"])
        lines.append("")
        things = []
        for n, v in sorted(p["items"].items()):
            if v and n not in AMMO and not (n == w):
                things.append("%s%s" % (n, " x%d" % v if v > 1 else ""))
        if things:
            lines += ["Carrying"] + ["  " + t for t in things]
        if p["companion"]:
            lines += ["", "With you: %s" % self.world["people"][
                p["companion"]]["first"]]
        if self.aboard:
            lines += ["", "In the hold: %d" % len(self.aboard)]
        self.show_panel(lines)
        cond = []
        if p["out"]:
            cond.append("UNCONSCIOUS")
        if p["dying"]:
            cond.append("DYING (%d)" % p["dying"])
        if p["bleed"]:
            cond.append("BLEEDING %d" % p["bleed"])
        if p["burning"]:
            cond.append("ON FIRE")
        if p["punctured"]:
            cond.append("SUIT PUNCTURED")
        if p["held"]:
            cond.append("HELD")
        if self.air_bad():
            cond.append("BAD AIR")
        for k, label in (("adrenaline", "ADRENALINE"), ("stim", "STIMPAK"),
                         ("overwhelmed", "OVERWHELMED"),
                         ("cryosick", "CRYOSICK"), ("sedated", "SEDATED"),
                         ("rage", "RAGE"), ("heart", "HEART"),
                         ("sick", "SICK")):
            if k in p["on"]:
                cond.append(label)
        cond += [CONDITIONS[c].split(":")[0] for c in p["conds"]]
        self.condition.config(text="\n".join(cond))
        self.sound.tune = ("dig" if a.lead == "dig" else TUNE_OF[a.kind]) \
            if "won" not in self.flags else "inside"

    # ── Commands ──

    def toggle_map(self):
        if self.busy or self.talk:
            return
        self.overlay = None if self.overlay == "map" else "map"
        self.render()

    def show_help(self):
        if self.busy or self.talk:
            return
        self.overlay = None if self.overlay == "help" else "help"
        self.render()

    def zoom(self, d):
        z = max(-2, min(2, self.zoom_d + d))
        if z != self.zoom_d:
            self.zoom_d = z
            self.layout()

    def auto_scale(self):
        """Tiles big enough that the shorter side of the map shows about
        thirteen, plus however far the player has zoomed."""
        c = self.canvas
        short = min(c.winfo_width(), c.winfo_height())
        return max(1, min(MAX_ZOOM, round(short / (16 * 13)) + self.zoom_d))

    def on_resize(self, ev):
        if ev.widget is self.root:
            if getattr(self, "fit_job", None):
                self.root.after_cancel(self.fit_job)
            self.fit_job = self.root.after(80, self.fit)

    def fit(self, force=False):
        """Scale the fonts, the side panel and the buttons to the window:
        a wide window has the panel at the side and one row of buttons, a
        tall one (a phone held upright) the panel underneath and two."""
        self.fit_job = None
        if getattr(self, "small_dialog", None) and not force:
            return
        root = self.root
        W, H = root.winfo_width(), root.winfo_height()
        if W < 100 or H < 100:
            return
        tall = H > W * 1.15
        u = min(W / 620, H / 1000) if tall else min(W / 1000, H / 740)
        u = max(0.6, min(4.0, u)) * self.text_k
        if not force and abs(u - UI[0]) < 0.02 and \
                tall == getattr(self, "tall", None):
            return
        self.tall = tall
        set_fonts(u)
        n = len(self.btn)
        root.update_idletasks()
        each = max(b.winfo_reqwidth() for b in self.btn.values()) + S(4)
        rows = 2 if tall else 1
        while rows < n and -(-n // rows) * each > W:
            rows += 1
        per = -(-n // rows)
        for i, b in enumerate(self.btn.values()):
            b.grid(row=i // per, column=i % per, sticky="ew", padx=S(2),
                   pady=S(4))
        for col in range(n):
            self.bar.columnconfigure(col, weight=int(col < per),
                                     uniform="b" if col < per else "")
        sb = self.sidebar
        sb.pack_forget()
        if tall:
            sb.pack_propagate(True)
            sb.pack(side="bottom", fill="x", before=self.leftside)
            wrap = (W - S(50)) // 2
        else:
            sb.configure(width=S(250))
            sb.pack_propagate(False)
            sb.pack(side="right", fill="y", before=self.leftside)
            wrap = S(230)
        for w in (self.panel, self.panel2, self.condition):
            if int(w.cget("wraplength")):
                w.configure(wraplength=wrap if w is not self.condition or
                            not tall else W - S(24))
        if hasattr(self, "panel_lines"):
            self.show_panel(self.panel_lines)
        self.layout()

    def show_panel(self, lines):
        """The side panel: one column beside the map, or two underneath it
        on a phone held upright, split at the blank line nearest halfway."""
        self.panel_lines = lines
        if not self.tall or len(lines) < 8:
            self.panel.config(text="\n".join(lines))
            self.panel2.pack_forget()
            return
        mid = len(lines) // 2
        cuts = [i for i, line in enumerate(lines) if not line.strip()]
        cut = min(cuts, key=lambda i: abs(i - mid)) if cuts else mid
        if abs(cut - mid) > len(lines) // 4:
            cut = mid
        first, second = lines[:cut], lines[cut:]
        while second and not second[0].strip():
            second = second[1:]
        self.panel.config(text="\n".join(first))
        self.panel2.config(text="\n".join(second))
        if not self.panel2.winfo_manager():
            self.panel2.pack(side="left", fill="x", expand=True, anchor="n",
                             padx=(S(10), S(10)), pady=(S(8), 0))

    def fit_dialog(self, dlg):
        """Shrink a dialog that's too big for the window until it fits;
        everything goes back to its usual size when it closes."""
        root = self.root
        root.update_idletasks()
        self.fit()
        W, H = root.winfo_width(), root.winfo_height()
        if W < 100:
            return
        shrunk = False
        for _ in range(5):
            dlg.update_idletasks()
            k = min(1.0, (W - 8) / max(1, dlg.winfo_reqwidth()),
                    (H - 8) / max(1, dlg.winfo_reqheight()))
            if k >= 1.0:
                break
            shrunk = True
            set_fonts(UI[0] * k * 0.97)
            todo = [dlg]
            while todo:
                w = todo.pop()
                todo += w.winfo_children()
                try:
                    wl = int(w.cget("wraplength"))
                except (tk.TclError, ValueError):
                    continue
                if wl:
                    w.configure(wraplength=max(60, int(wl * k)))
        if shrunk:
            self.small_dialog = dlg

            def closed(e):
                if e.widget is dlg:
                    self.small_dialog = None
                    self.root.after_idle(self.fit, True)
            dlg.bind("<Destroy>", closed, add="+")

    def text_size(self, d):
        i = TEXT_SIZES.index(self.text_k) + d
        if 0 <= i < len(TEXT_SIZES):
            self.text_k = TEXT_SIZES[i]
            self.fit(True)
            self.say("(Text size %d%%.)" % round(self.text_k * 100), "info")

    def toggle_mute(self):
        self.sound.muted = not self.sound.muted
        self.render_chrome()

    def toggle_music(self):
        self.sound.music_off = not self.sound.music_off
        self.sound.tick()
        self.render_chrome()


    def ask_new_game(self):
        if self.busy:
            return
        if self.overlay in ("won", "doom"):
            self.new_game()
            return
        self.open_menu("Abandon this station and start again?", [("Yes, start again", self.new_game),
                              ("No, keep playing", lambda: None)])


def cap(s):
    return s[:1].upper() + s[1:]


def an(s):
    vowel = s[:1] in "aeiou" and not s.startswith(("uni", "use", "eu"))
    return ("an " if vowel else "a ") + s


def wrap(text, width):
    out, line = [], ""
    for word in text.split():
        if line and len(line) + 1 + len(word) > width:
            out.append(line)
            line = "  " + word if text.startswith("  ") else word
        else:
            line = (line + " " + word) if line else word
    if line:
        out.append(line)
    return out


