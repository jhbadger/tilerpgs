def make_people(rng):
    people = {}
    used = set()
    for role, (tile, sex, honorific, title, young) in ROLES.items():
        sex = sex or rng.choice("MF")
        name = None
        while not name or name in used or name.split()[1] in {
                n.split()[1] for n in used}:
            name = person_name(rng, sex)
        used.add(name)
        first, last = name.split()
        full = ("%s %s" % (honorific, name)) if honorific else name
        short = ("%s %s" % (honorific, last)) if honorific else first
        people[role] = {"first": first, "sex": sex, "tile": tile,
                        "name": full, "short": short, "title": title,
                        "young": young, "hon": honorific}
    return people


def make_person(world, role, x, y):
    who = world["people"][role]
    m = Mob(who["tile"], who["name"], x, y)
    m.role = role
    m.title = fill(who["title"], world)
    m.shop = SHOPS.get(role)
    m.mimic = role == world["mimic"]
    m.talk, m.greet = role_talk(world, role)
    return m


def fill(text, world):
    p = world["people"]
    names = {r: v["short"] for r, v in p.items()}
    names.update({r + "_full": v["name"] for r, v in p.items()})
    names.update({r + "_first": v["first"] for r, v in p.items()})
    for r, v in p.items():
        m = v["sex"] == "M"
        names.update({r + "_he": "he" if m else "she",
                      r + "_He": "He" if m else "She",
                      r + "_his": "his" if m else "her",
                      r + "_him": "him" if m else "her",
                      r + "_title": v["title"]})
    mi = p[world["mimic"]]
    names.update(mimic=mi["short"], mimic_full=mi["name"],
                 mimic_title=mi["title"],
                 mimic_he="he" if mi["sex"] == "M" else "she",
                 mimic_He="He" if mi["sex"] == "M" else "She",
                 mimic_his="his" if mi["sex"] == "M" else "her",
                 mimic_him="him" if mi["sex"] == "M" else "her",
                 doctor_short=p["doctor"]["name"].split()[-1],
                 numbers=NUMBERS)
    return text.format(**names)


