# ── Fitting the screen ──
#
# Every font is a named font sized in pixels, so the whole window can be
# scaled to the screen: Game.fit() works out how big everything should be
# from the window's size (a phone held upright gets a taller layout) and
# set_fonts() resizes every font at once.

FONTS = {}          # (family, size, style) -> tkfont.Font
STD_FONTS = {}      # Tk's own fonts (buttons, dialogs): name -> pixels
UI = [1.0]          # how much bigger than the design everything is
PT = [1.0]          # pixels to a point, at the design size
TEXT_SIZES = (0.8, 0.9, 1.0, 1.15, 1.3, 1.5, 1.75)


def S(n):
    """A length in pixels, scaled to the screen."""
    return max(1, round(n * UI[0]))


def font_px(size):
    return -max(6, round(size * UI[0] * PT[0]))


def F(family, size, style=""):
    """A font that grows and shrinks with the window."""
    key = (family, size, style or "")
    f = FONTS.get(key)
    if f is None:
        f = FONTS[key] = tkfont.Font(
            family=family, size=font_px(size),
            weight="bold" if "bold" in (style or "") else "normal",
            slant="italic" if "italic" in (style or "") else "roman")
    return f


def init_fonts(root):
    PT[0] = 1.0 if ANDROID else float(root.tk.call("tk", "scaling"))
    for name in tkfont.names(root):
        if name.startswith("Tk"):
            size = int(tkfont.nametofont(name).cget("size"))
            STD_FONTS[name] = 13 if ANDROID else (
                -size if size < 0 else size * PT[0])


def set_fonts(u):
    UI[0] = u
    for (family, size, style), f in FONTS.items():
        f.configure(size=font_px(size))
    for name, px in STD_FONTS.items():
        tkfont.nametofont(name).configure(size=-max(6, round(px * u)))

