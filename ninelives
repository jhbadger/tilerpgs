            rng.choice(models)
        cgs.append({
            "name": names[i], "fur": furs[i % len(furs)],
            "eyes": rng.choice(sorted(EYES)), "skin": rng.randrange(5),
            "model": model, "pers": rng.randrange(len(PERSONALITIES)),
            "likes": rng.choice(LIKES),
