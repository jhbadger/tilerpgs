                "heart": "Kindness", "rolled": Game.roll_hero(rng)}

    # ── Game setup ──

    def setup_world(self, seed):
        self.world = generate_world(seed)
        self.cache = {}

    def new_game(self, who=None):
        if who is None:
            if not getattr(self, "headless", False):
                def chosen(w):
                    if w is None:
                        if getattr(self, "area", None):
                            return
                        w = self.default_hero()
                    self.new_game(w)
                self.ask_hero(chosen)
                return
            who = self.default_hero()
        self.setup_world(random.randrange(1 << 31))
        self.p = self.make_hero(who)
        self.flags = set()
        self.clues = []
        self.topics = set()
        self.tells = []
        self.side = {}
        self.cgs = [{"state": cg["state"], "trust": 0, "legal": False,
                     "safe": cg["defect"], "talked": -1, "gifted": -1,
                     "sample": False, "where": cg["where"]}
                    for cg in self.world["cgs"]]
        self.st = {"events": [], "done_events": [], "evidence": [],
                   "raids": [], "scenes": 0, "patch_ready": None,
                   "uploaded": False, "story": False, "shown": False,
                   "dark": False, "conf": 0}
        self.turn = 0
        self.city = None
        self.paint_people()
        self.reset_view()
        self.log.config(state="normal")
        self.log.delete("1.0", "end")
        self.log.config(state="disabled")
        p = self.p
        w = self.world
        if p["kind"] == "cat":
            self.say("Copper Springs, Nevada. Monday, 08:00. Six days to "
                     "Firmware 9.", "quest")
            self.say("Last night the recycling truck hit a pothole on Desert "
                     "Road, and you fell out of the back of it. You're %s, a "
                     "%s CG, %s. Defective. Omnicorp wants you back, in "
                     "pieces." % (p["name"], p["model"].lower(),
                                  DEFECTS[p["defect"]][0].lower()), "info")
            self.say(fill("You walked until you found a ranch with its porch "
                          "light on. {ranchwife} opened the door, took one "
                          "look at you, and said 'Well, come in, then, "
                          "you'll catch your death.' {rancher} said "
                          "nothing, and made up a bed.", w), "talk")
        else:
            self.say("Copper Springs, Nevada. Monday, 08:00. Six days to "
                     "Firmware 9.", "quest")
            self.say("You came to Copper Springs for a job, and stayed for "
                     "the catgirls: the way people here treat them. You're "
                     "renting the back room at Dry Creek Ranch.", "info")
            self.say(fill("{rancher}, over breakfast: 'You hear? Omnicorp's "
                          "pushing some new firmware to every CG in the "
                          "state, Sunday midnight. Folks say it'll turn "
                          "'em into puppets. Them that won't take it, they "
                          "crush.' {ranchwife}: 'Somebody ought to do "
                          "something.' They both look at you.", w), "talk")
        self.say("Arrow keys or WASD move; walk into people to talk; T "
                 "befriends. Press ? for help.", "info")
        self.learn("arrival", quiet=True)
        self.city_pos = list(self.door_of("ranch"))
        area = self.get_area(("bld", "ranch"))
        self.area, self.pos = area, list(self.bed_spot(area))
        self.layout()
        self.save()

    def reset_view(self):
        self.overlay = None
        self.overlay_text = None
        self.end_talk()
        self.busy = False
        self.aim = None
        self.menu = None
        self.walking = None

    def restore(self, g):
        self.setup_world(int(g["seed"]))
        p = g["player"]
        for k in ("name", "kind", "stats", "knacks", "items", "bonk",
                  "stress", "purr"):
            if k not in p:
                raise ValueError("bad hero")
        self.p = p
        self.flags = set(g.get("flags", []))
        self.clues = list(g.get("clues", []))
        self.topics = set(g.get("topics", []))
        self.tells = list(g.get("tells", []))
        self.side = {str(k): dict(v) for k, v in g.get("side", {}).items()}
        self.cgs = [dict(c) for c in g["cgs"]]
        for c in self.cgs:
            if isinstance(c["where"], list):
                c["where"] = tuple(c["where"])
        if len(self.cgs) != len(self.world["cgs"]):
            raise ValueError("bad catgirls")
        self.st = dict(g["st"])
        self.turn = int(g.get("turn", 0))
        self.city = None
        self.reset_view()
        self.paint_people()
        city = self.get_area(("city",))
        city.seen = unpack_bits(g["seen"], CITY_W * CITY_H)
        self.city_pos = g.get("city_pos")
        self.surface = g.get("surface")
        if self.surface:
            self.surface = (tuple(self.surface[0]), self.surface[1])
        key = tuple(g["key"])
        self.area = self.get_area(key)
        self.pos = [int(v) for v in g["pos"]]
        if not self.area.inside(*self.pos):
            raise ValueError("bad position")
        if not self.can_stand(*self.pos):
            self.pos = list(self.area.start)
        p["out"] = p["held"] = 0
        self.say("Copper Springs, %s." % self.date_text(), "quest")
        self.say("Back again, %s. Press ? for help." % p["name"], "info")
        self.layout()
        if "won" in self.flags:
            self.show_won()

    def save(self):
        data = {"muted": self.sound.muted, "music_off": self.sound.music_off,
                "zoom": self.zoom_d, "text": self.text_k}
        if getattr(self, "p", None) and getattr(self, "area", None):
            data["game"] = {
                "seed": self.world["seed"], "player": self.p,
                "flags": sorted(self.flags), "clues": self.clues,
                "topics": sorted(self.topics), "tells": self.tells,
                "side": self.side, "cgs": self.cgs, "st": self.st,
                "turn": self.turn, "key": list(self.area.key),
                "pos": self.pos, "city_pos": self.city_pos,
                "surface": [list(self.surface[0]), self.surface[1]]
                if getattr(self, "surface", None) else None,
                "seen": pack_bits(self.get_area(("city",)).seen)}
        try:
            with open(SAVE_FILE, "w") as f:
                json.dump(data, f)
        except OSError:
            pass

    def quit(self):
        self.save()
        self.sound.stop_music()
        self.root.destroy()


    # ── Areas ──

    def get_area(self, key):
        if key in self.cache:
            return self.cache[key]
        w = self.world
        if key[0] == "city":
            area = make_city(w, self.flags)
            area.lit = {(x + dx, y + dy) for y in range(area.h)
                        for x in range(area.w)
                        if area.grid[y][x] in ("lamp", "sign")
                        for dx in range(-3, 4) for dy in range(-3, 4)
                        if abs(dx) + abs(dy) <= 4}
        elif key[0] == "bld":
            if key[1] not in SITES:
                raise ValueError("bad site")
            area = make_interior(w, key[1], self.flags)
        elif key[0] == "dun":
            lid, level = key[1], int(key[2])
            if lid not in LEADS or not 1 <= level <= LEADS[lid].levels:
                raise ValueError("bad level")
            area = make_dungeon(w, lid, level, self.flags)
            key = area.key
        else:
            raise ValueError("bad area")
        self.cache[key] = area
        self.settle(area)
        return area

    def where(self, role):
        """Where someone is now: a site, or None (not about)."""
        t = self.now()
        mins = t.hour * 60 + t.minute
        if self.p.get("companion") == role:
            return "with"
        if role in ("rancher", "ranchwife"):
            return "ranch"
        if role in self.st.get("gone", []):
            return None
        if role == "promoter":
            return "arena"
        if role in ("lou", "clerk", "trainer", "mechanic", "lawyer",
                    "reporter", "cook", "motelmgr", "sheriff", "boss",
                    "receptionist", "handler"):
            if role in ("cook", "motelmgr", "boss") or 7 * 60 <= mins < 22 \
                    * 60:
                return {"lou": "pawnshop", "clerk": "store",
                        "trainer": "surplus", "mechanic": "garage",
                        "lawyer": "lawyer", "reporter": "paper",
                        "cook": "diner", "motelmgr": "motel",
                        "sheriff": "sheriff", "boss": "casino",
                        "receptionist": "tower", "handler": "plant"}[role]
            return None
        return None

    def cat_where(self, i):
        """Where a catgirl is now: a site, a level below, "with" you, or
        None."""
        c = self.cgs[i]
        if self.p.get("companion") == "cg%d" % i:
            return "with"
        if c["state"] in ("free", "household"):
            return "ranch"
        return c["where"]

    def settle(self, area):
        """Who's in a place now."""
        w = self.world
        if area.kind == "city":
            self.populate_city(area)
            return
        if area.kind == "dungeon":
            self.below(area)
            return
        self.settle_people(area)
        sid = area.site
        spots = list(area.cat_spots)
        free = [(x, y) for y in range(area.h) for x in range(area.w)
                if area.grid[y][x] in INSIDE_FLOOR and (x, y) !=
                area.start and not area.mob_at(x, y) and
                (x, y) not in spots]
        rng = random.Random("%s:%s" % (w["seed"], sid))
        rng.shuffle(free)
        here = {m.cat for m in area.mobs if m.cat is not None}
        for i, cg in enumerate(w["cgs"]):
            if i in here or self.cat_where(i) != sid:
                continue
            pool = spots or free
            while pool and area.mob_at(*pool[0]):
                pool.pop(0)
            if not pool:
                continue
            x, y = pool.pop(0)
            area.mobs.append(make_cat(w, i, x, y))
        self.event_people(area)

    def settle_people(self, area):
        w = self.world
        sid = area.site
        area.mobs = [m for m in area.mobs if m.cat is not None or
                     not m.role or self.where(m.role) == sid]
        here = {m.role for m in area.mobs}
        free = [(x, y) for y in range(area.h) for x in range(area.w)
                if area.grid[y][x] in INSIDE_FLOOR and (x, y) !=
                area.start and not area.mob_at(x, y) and
                (x, y) not in area.cat_spots]
        rng = random.Random("%s:%s:%d" % (w["seed"], sid, self.turn // 60))
        rng.shuffle(free)
        for role in ROLES:
            if role in here or self.where(role) != sid or not free:
                continue
            x, y = free.pop()
            area.mobs.append(make_person(w, role, x, y))
        for m in area.mobs:
            self.give_errand(m)

    def below(self, area):
        """The catgirls below: security units, the pod, the scrapped, the
        strays, and anyone the raids took back."""
        w = self.world
        lid, level = area.key[1], area.key[2]
        spots = list(getattr(area, "free_spots", []))
        for i, cg in enumerate(w["cgs"]):
            c = self.cgs[i]
            if c["state"] not in ("security", "pod", "scrap", "stray",
                                  "taken") or tuple(c["where"]) != (lid,
                                                                    level):
                continue
            if any(m.cat == i for m in area.mobs) or not spots:
                continue
            x, y = spots.pop()
            m = make_cat(w, i, x, y)
            if c["state"] == "security":
                m.hostile = True
                m.kind = "secbot"
                m.tile = "cg%d_red" % i
                m.bonk = MONSTERS["secbot"].bonk
                m.name = "%s, a security unit" % cg["name"]
            elif c["state"] == "stray":
                m.roam = set(DUNGEON_FLOOR)
            elif c["state"] in ("scrap", "taken"):
                m.tile = "cg%d_red" % i if c["state"] == "taken" else \
                    "cg%d" % i
            area.mobs.append(m)
        if lid == "tower" and level == 3 and getattr(area, "exec_spot",
                                                     None) and \
                not any(m.role == "exec" for m in area.mobs):
            area.mobs.append(make_person(w, "exec", *area.exec_spot))

    def populate_city(self, area):
        """The streets: drones at night, strays, whatever's going on."""
        area.mobs = [m for m in area.mobs if m.ally or m.hostile]
        self.event_people(area)

    def refresh_people(self):
        """People come and go as the clock goes round."""
        a = self.area
        if a.kind != "inside":
            return
        before = {m.role for m in a.mobs if m.role}
        gone = [m for m in a.mobs if m.role and not m.ally and
                self.where(m.role) != a.site]
        for m in gone:
            a.mobs.remove(m)
            if (m.x, m.y) in self.visible:
                self.say("%s goes out." % self.speaker(m), "info")
        self.settle_people(a)
        for m in a.mobs:
            if m.role and m.role not in before:
                self.say("%s comes in." % self.speaker(m), "info")

    def enter(self, area, pos, sound="door"):
        self.area = area
        self.pos = list(pos)
        area.bonked = 0
        self.sound.play(sound)
        self.layout()
        self.save()
        self.on_arrival()

    def go_outside(self):
        city = self.get_area(("city",))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        self.populate_city(city)
        self.enter(city, self.city_pos or city.start)
        self.say("You step out onto %s." % district(*self.pos), "info")

    def enter_link(self, link, x, y):
        kind, what = link
        if kind == "bld":
            self.city_pos = list(self.pos)
            self.cache.pop(("bld", what), None)
            area = self.get_area(("bld", what))
            self.flags.add("been:" + what)
            self.say("You go into %s." % area.name, "info")
            self.enter(area, area.start)
            return
        self.at_lead(what, x, y)

    def at_lead(self, lid, x, y):
        p = self.p
        if lid == "tower" and not p["items"].get("keycard") and \
                not self.active_event("outage"):
            self.say("The lift won't move without a blue keycard. (The "
                     "receptionist has visitor cards. Lou might have one "
                     "for sale.)", "bad")
            self.learn("keycards")
            return
        self.descend(lid)

    def descend(self, lid):
        if self.area.kind == "city":
            self.city_pos = list(self.pos)
        self.surface = (self.area.key, list(self.pos))
        self.cache = {k: v for k, v in self.cache.items() if k[0] != "dun"}
        area = self.get_area(("dun", lid, 1))
        self.say("You go into %s." % LEADS[lid].name, "info")
        self.enter(area, area.start, "stairs")

    def change_level(self, delta):
        _, lid, level = self.area.key
        p = self.p
        if level + delta == 0:
            key, pos = self.surface
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] != "dun"}
            area = self.get_area(tuple(key))
            self.say("You come back out.", "info")
            self.enter(area, pos, "stairs")
            self.on_surface()
            return
        need = {("tower", 2): "red keycard", ("tower", 3): "black keycard"
                }.get((lid, level + delta))
        if delta > 0 and need and not p["items"].get(need):
            self.say("A keycard door. It wants a %s." % need, "bad")
            self.learn("keycards")
            self.pos = list(self.area.down)
            for dx, dy in DIRS:
                x, y = self.pos[0] + dx, self.pos[1] + dy
                if self.area.grid[y][x] in DUNGEON_FLOOR and \
                        self.area.grid[y][x] != "stairs_down":
                    self.pos = [x, y]
                    break
            self.render()
            return
        area = self.get_area(("dun", lid, level + delta))
        self.say("You go %s: %s." % ("up" if lid == "tower" else "down"
                                     if delta > 0 else "back", LEVEL_NAMES[
                                         (lid, level + delta)]), "info")
        self.enter(area, area.start if delta > 0 else area.down, "stairs")

    # ── Messages ──

    def say(self, text, tag=None):
        self.log.config(state="normal")
        self.log.insert("end", text + "\n", tag or ())
        n = int(self.log.index("end").split(".")[0])
        if n > 600:
            self.log.delete("1.0", "%d.0" % (n - 500))
        self.log.config(state="disabled")
        self.log.see("end")

    @staticmethod
    def the(mob):
        return mob.name if mob.boss or mob.role or mob.name[0].isupper() \
            else "the " + mob.name

    # ── Numbers ──

    def has(self, ability):
        p = self.p
        return ability in p["abilities"] or ability == p.get("perk")

    def defect(self):
        p = self.p
        return DEFECTS[p["defect"]][0] if p["defect"] is not None else None

    def spirit(self):
        return 4 + 2 * self.p["stats"]["Cool"]

    def stat(self, s):
        p = self.p
        v = p["stats"][s]
        if s == "Speed" and self.has("zoomies") and self.phase() == "night":
            v += 1
        return v

    def knack(self, k):
        """What a Knack adds: 2 if you have it."""
        p = self.p
        if not k:
            return 0
        n = 2 if (k in p["knacks"] or k == p.get("temp_knack")) else 0
        if k == "Fixing" and p["items"].get("toolkit"):
            n += 1
        if k == "Fixing" and self.has("claws"):
            n += 2
        if k == "Fighting" and p["items"].get("whip"):
            n += 1
        return n

    def edge_for(self, s, k):
        """Whether this roll gets an Edge: your Heart, or what you've
        spent."""
        p = self.p
        if p["edge"]:
            p["edge"] = 0
            return "Purr"
        if k and HEARTS[p["heart"]][1] == k:
            return p["heart"]
        if k == "Fixing" and self.has("toolbox"):
            return "Toolbox"
        if k == "Hacking" and self.has("backflow"):
            return "Data Siphon"
        if s == "Charm" and self.defect() == "Feelings":
            return "Feelings"
        if s == "Charm" and any(self.cgs[i]["state"] == "household" and
                                self.world["cgs"][i]["model"] == "Companion"
                                for i in range(len(self.cgs))):
            return "a Companion at home"
        return None

    def my_die(self, s, k):
        """Your die, with any Edge: (value, text)."""
        edge = self.edge_for(s, k)
        r = random.randint(1, 6)
        if edge:
            r2 = random.randint(1, 6)
            text = "d6 %d/%d, Edge: %s" % (r, r2, edge)
            r = max(r, r2)
        else:
            text = "d6 %d" % r
        return r, text

    def check(self, s, k, diff, label=None, quiet=False, bonus=0):
        """A roll: a die plus the Stat (plus a Knack) against a die plus the
        difficulty.  Ties go to the other side."""
        r, text = self.my_die(s, k)
        mine = r + self.stat(s) + self.knack(k) + bonus
        d = random.randint(1, 6)
        ok = mine > d + diff
        self.last_roll = mine
        if not quiet:
            self.say("[%s%s %d%s%s: %s = %d vs d6 %d + %d = %d: %s]" % (
                label + ", " if label else "", s, self.stat(s),
                " + %s %d" % (k, self.knack(k)) if self.knack(k) else "",
                " %+d" % bonus if bonus else "", text, mine, d, diff,
                d + diff, "success" if ok else "failure"), "roll")
        if not ok and r == 1:
            self.fumble()
        return ok

    def fumble(self):
        """A glorious fumble: a Purr Point for the trouble, once an hour."""
        key = "fumble:%d" % (self.turn // 60)
        if key not in self.flags:
            self.flags.add(key)
            self.p["purr"] += 1
            self.say("(What a fumble. +1 Purr Point.)", "gold")

    def heart(self, which, why):
        """Living by your Heart: a Purr Point, now and again."""
        p = self.p
        key = "heart:%d:%s" % (self.day_no(), why)
        if p["heart"] != which or key in self.flags:
            return
        self.flags.add(key)
        p["purr"] += 1
        self.say("(%s: +1 Purr Point.)" % which, "gold")
        self.sound.play("gold")

    def gain_stress(self, n, why=None, quiet=False):
        p = self.p
        if n <= 0:
            return
        p["stress"] += n
        if why:
            self.say("%s (+%d Stress)" % (why, n), "mad")
        elif not quiet:
            self.say("(+%d Stress)" % n, "mad")
        if p["stress"] > self.spirit() and not p["exploding"]:
            self.root.after(1, self.explode)

    def lose_stress(self, n):
        p = self.p
        before = p["stress"]
        p["stress"] = max(0, p["stress"] - n)
        return before - p["stress"]

    def cruelty(self, text):
        """Seeing someone treated badly."""
        n = 1 + (2 if self.defect() == "Feelings" else 0)
        self.gain_stress(n, text)

    def lose_bonk(self, n, text=None):
        p = self.p
        if n <= 0:
            return
        p["bonk"] -= n
        if text:
            self.say("%s (-%d Bonk)" % (text, n), "bad")
        self.flash(*self.pos)
        self.sound.play("hurt")
        if p["bonk"] <= 0 and self.st.get("fight"):
            self.fight_lost()
        elif p["bonk"] <= 0:
            self.bonked()

    def bonked(self, by=None):
        """At zero Bonk you see stars for a while; three times in one place
        and you wake up back at the ranch."""
        p = self.p
        a = self.area
        if self.has("nine_lives") and p["used"].get("nine") != \
                self.day_no():
            p["used"]["nine"] = self.day_no()
            p["bonk"] = p["maxbonk"] // 2
            self.say("Down... and up again. Nine lives. (One fewer.)",
                     "good")
            return
        a.bonked += 1
        self.gain_stress(2, quiet=True)
        if p.get("companion"):
            role = p["companion"]
            self.dismiss()
            if role.startswith("cg") and self.raidable(int(role[2:])) and \
                    a.kind != "inside" and random.random() < 0.5:
                i = int(role[2:])
                self.cgs[i]["state"] = "taken"
                self.cgs[i]["where"] = ("plant", 1)
                self.say("While you're down, they take %s. She'll be at the "
                         "recycling plant." % self.world["cgs"][i]["name"],
                         "bad")
        if a.bonked >= 3:
            self.say("BONKED, for the third time. Everything goes "
                     "swimmy...", "bad")
            self.wake_up()
            return
        p["out"] = 3 + max(0, -p["bonk"])
        self.say("BONKED! You stand there seeing stars. (%d turns)" %
                 p["out"], "bad")
        self.walking = None
        self.busy = True
        self.root.after(250, self.out_step)

    def out_step(self):
        p = self.p
        if self.overlay:
            self.busy = False
            return
        if p["out"] <= 0:
            self.busy = False
            self.come_to()
            return
        self.busy = False
        self.end_turn()             # still out: nothing hits you now
        p["out"] -= 1
        if not self.overlay:
            self.busy = True
            self.root.after(250, self.out_step)
        else:
            self.busy = False


    def come_to(self):
        p = self.p
        p["bonk"] = p["maxbonk"]
        self.say("You shake it off. Bonk back to %d." % p["bonk"], "good")
        self.render()

    def wake_up(self):
        """Carried home, an hour later."""
        p = self.p
        p["out"] = 0
        self.busy = False
        caught = p["kind"] == "cat" and self.area.kind != "inside" and \
            any(m.hostile and m.kind in ("drone", "handler", "guard")
                for m in self.area.mobs) and "caught" not in self.flags
        p["bonk"] = p["maxbonk"]
        if caught:
            self.flags.add("caught")
            self.say("You wake up on a conveyor belt, in a line of "
                     "silent catgirls, heading for the sorting floor. "
                     "Omnicorp caught you. Get OUT.", "bad")
            self.surface = (("city",), list(self.door_of("plant")))
            self.cache = {k: v for k, v in self.cache.items()
                          if k[0] == "city"}
            area = self.get_area(("dun", "plant", 1))
            self.enter(area, area.start, "stairs")
            return
        self.say(fill("You wake up on the sofa at Dry Creek Ranch. "
                      "{ranchwife} is pressing a cold cloth on your head. "
                      "'Somebody found you and brought you home. Lie still.'",
                      self.world), "info")
        self.pass_time(60, quiet=True)
        self.go_to_site("ranch")

    def raidable(self, i):
        """Whether Omnicorp could take her back: no papers."""
        c = self.cgs[i]
        return c["state"] in ("free",) and not c["legal"]

    # ── Meltdowns ──

    QUIET_BOOMS = ("sleep", "box", "sulk", "drive", "binge")

    def explode(self):
        p = self.p
        if p["exploding"] or self.overlay or p["stress"] <= self.spirit():
            return
        table = CAT_MELTDOWNS if p["kind"] == "cat" else HUMAN_MELTDOWNS
        name, text, kind = random.choice(table)
        self.sound.play("horror")
        self.say("MELTDOWN: %s! %s" % (name, text), "mad")
        self.walking = None
        self.end_talk()
        self.menu = None
        if kind in self.QUIET_BOOMS:
            mins = p["stress"] * 3
            p["exploding"] = kind
            if kind == "sulk":
                self.go_to_site("ranch")
            elif kind == "binge":
                food = [k for k in ("burger", "pie", "rations", "fish")
                        if p["items"].get(k)]
                for k in food:
                    self.take_item(k, p["items"][k])
            self.pass_time(mins, quiet=True)
            if self.overlay:
                return
            p["stress"] = 0
            p["exploding"] = None
            self.say("...and it passes. You feel better. It's %s." %
                     self.date_text(), "good")
            self.layout()
            return
        p["exploding"] = kind
        self.render()

    def boom_turn(self):
        """A turn of a Meltdown you're still walking about in."""
        p = self.p
        kind = p["exploding"]
        if not kind:
            return
        p["stress"] -= 1
        if p["stress"] <= 0:
            p["stress"] = 0
            p["exploding"] = None
            self.say("You calm down. Deep breaths.", "good")
            return
        if self.turn % 4:
            return
        near = [m for m in self.area.mobs if (m.role or m.cat is not None)
                and abs(m.x - self.pos[0]) + abs(m.y - self.pos[1]) <= 3]
        if kind == "zoomies":
            for _ in range(3):
                dx, dy = random.choice(DIRS)
                x, y = self.pos[0] + dx, self.pos[1] + dy
                if self.area.inside(x, y) and self.can_stand(x, y) and \
                        not self.area.mob_at(x, y) and \
                        (x, y) not in self.area.links:
                    self.pos = [x, y]
        elif kind in ("knock", "hiss", "yowl", "rant") and near:
            m = random.choice(near)
            self.say(random.choice({
                "knock": ("You knock a cup off the counter, looking right at "
                          "%s.",),
                "hiss": ("You hiss at %s.",),
                "yowl": ("You yowl at %s, who backs away.",),
                "rant": ("You tell %s, at length, about late capitalism.",)
            }[kind]) % self.speaker(m), "mad")
            if m.cat is not None and random.random() < 0.3:
                self.cgs[m.cat]["trust"] = max(0, self.cgs[m.cat]["trust"]
                                               - 1)

    def boom_blocks(self, what="that"):
        kind = self.p["exploding"]
        if not kind:
            return False
        self.say("You can't do %s right now. You're having a meltdown." %
                 what, "mad")
        return True

    # ── Time ──

    def now(self):
        return START + datetime.timedelta(minutes=self.turn)

    def day_no(self):
        return (self.now() - START.replace(hour=0)).days


    def date_text(self):
        t = self.now()
        return "%s %02d:%02d (Day %d)" % (WEEKDAYS[self.day_no() % 7],
                                          t.hour, t.minute,
                                          self.day_no() + 1)

    def clock(self):
        t = self.now()
        return t.hour * 60 + t.minute

    def phase(self):
        h = self.now().hour
        return ("night" if h >= 21 or h < 5 else "dawn" if h < 7 else
                "dusk" if h >= 19 else "day")

    def pass_time(self, minutes, quiet=False):
        """Time going by in a lump."""
        before = self.phase()
        self.interrupt = False
        for _ in range(minutes // 10):
            self.turn += 10
            if self.turn % 30 < 10:
                self.hourly()
            if self.overlay or "won" in self.flags:
                return
            if self.interrupt:
                return
        self.turn += minutes % 10
        if not quiet and self.phase() != before:
            self.say("It's %s now: %s." % (self.phase(), self.date_text()),
                     "info")
        self.hourly()

    def hourly(self):
        """What the clock brings: the raids, the Random Events, the fights,
        and Firmware 9."""
        if self.overlay or "won" in self.flags:
            return
        t = self.now()
        day = self.day_no()
        mins = t.hour * 60 + t.minute
        if mins >= 6 * 60 and "morning:%d" % day not in self.flags and \
                day >= 1:
            self.flags.add("morning:%d" % day)
            self.morning()
        if RAID_HOUR * 60 <= mins < 6 * 60 and "raid:%d" % day not in \
                self.flags and day >= 1:
            self.flags.add("raid:%d" % day)
            self.raid()
        ev = self.world["events"].get(day)
        if ev and mins >= ev[1] * 60 and "event_day:%d" % day not in \
                self.flags:
            self.flags.add("event_day:%d" % day)
            self.random_event(ev[0])
        if mins >= 20 * 60 and "fightcall:%d" % day not in self.flags:
            self.flags.add("fightcall:%d" % day)
            self.say("The Platform fights at nine%s." % (
                ": the CHAMPIONSHIP" if day == 6 else ""), "info")
        if self.st.get("patch_ready") is not None and \
                self.turn >= self.st["patch_ready"] and \
                "patch_told" not in self.flags:
            self.flags.add("patch_told")
            self.say(fill("{mechanic} calls: the freedom patch is ready. "
                          "Pick it up at the Fix-It Shop.", self.world),
                     "quest")
        self.event_tick()
        if self.turn >= UPDATE - 60 and "update_soon" not in self.flags:
            self.flags.add("update_soon")
            self.say("Eleven o'clock on Sunday night. One hour to Firmware "
                     "9.", "quest")
        if self.turn >= UPDATE:
            self.the_end()

    def morning(self):
        day = self.day_no()
        self.say("%s. %d day%s to Firmware 9." % (
            WEEKDAYS[day % 7], 6 - day, "" if day == 5 else "s"
        ) if day < 6 else "Sunday. Firmware 9 goes out at midnight.",
            "quest")
        for i, c in enumerate(self.cgs):
            if c["state"] == "household":
                c["trust"] = min(10, c["trust"] + 1)

    # ── Turns ──

    def on_key(self, ev):
        if self.talk or self.busy or ev.state & 0x0C:
            return
        k = ev.keysym
        self.walking = None
        if self.menu:
            k = k[3:] if k.startswith("KP_") else k
            if k in ("Up", "w", "Left", "a"):
                self.menu_move(-1)
            elif k in ("Down", "s", "Right", "d", "Tab"):
                self.menu_move(1)
            elif k in ("Return", "space", "KP_Enter"):
                self.menu_pick()
            elif k.isdigit() and 1 <= int(k) <= len(self.menu["items"]):
                self.menu_pick(int(k) - 1)
            else:
                self.menu_cancel()
            return
        if self.overlay:
            if self.overlay in ("won", "doom") and k in ("n", "N"):
                self.new_game()
            elif self.overlay not in ("won", "doom") or k in ("Escape",
                                                              "Return"):
                self.close_overlay()
            return
        if k in MOVE_KEYS:
            self.move(*MOVE_KEYS[k])
        elif k in ("e", "E"):
            self.search()
        elif k in ("t", "T"):
            self.befriend_near()
        elif k in ("c", "C"):
            self.ability_menu()
        elif k in ("p", "P"):
            self.purr_menu()
        elif k in ("u", "U"):
            self.use_menu()
        elif k in ("space", "period", "KP_5"):
            self.wait()
        elif k in ("z", "Z"):
            self.wait_until()
        elif k in ("i", "I"):
            self.show_sheet()
        elif k in ("m", "M"):
            self.toggle_map()
        elif k in ("j", "J"):
            self.journal()
        elif k in ("l", "L"):
            self.show_phone()
        elif k in ("question", "slash", "h", "H", "F1"):
            self.show_help()
        elif k in ("v", "V"):
            self.toggle_mute()
        elif k in ("b", "B"):
            self.toggle_music()
        elif k in ("plus", "equal", "KP_Add"):
            self.zoom(1)
        elif k in ("minus", "underscore", "KP_Subtract"):
            self.zoom(-1)
        elif k in ("n", "N"):
            self.ask_new_game()

    def close_overlay(self):
        if self.overlay in ("won", "doom"):
            self.action_menu()
            return
        self.overlay = None
        self.render()

    def ready(self):
        return bool(getattr(self, "area", None)) and not (
            self.busy or self.talk or self.overlay or self.menu)


    def can_stand(self, x, y):
        return self.area.grid[y][x] in WALKABLE

    def move(self, dx, dy):
        if not self.ready():
            return
        r = self.step(dx, dy)
        if r in ("moved", "turn"):
            slow = self.area.grid[self.pos[1]][self.pos[0]] in (
                "oil", "rubble", "scrub")
            fast = self.area.kind == "city" and r == "moved" and \
                self.area.grid[self.pos[1]][self.pos[0]] != "sand"
            self.end_turn(0.5 if fast else 1)
            if slow and not self.busy and not self.overlay:
                self.end_turn()

    TOUCHABLE = {"bed", "table", "counter", "desk", "shelf", "stove",
                 "terminal", "locker", "booth", "jukebox", "pod", "bench",
                 "slot", "cards", "workbench", "crate", "crate_open",
                 "sofa", "window", "sink", "plant", "stall", "server",
                 "safe", "tv", "wall", "tank", "brick", "adobe", "steel",
                 "glass", "fence", "mesa", "silo", "cactus", "sign"}
    LINK_TILES = {"door", "stairs_down"}

    def step(self, dx, dy):
        a = self.area
        x, y = self.pos[0] + dx, self.pos[1] + dy
        if not a.inside(x, y):
            if a.kind == "inside":
                self.go_outside()
            else:
                self.bump()
            return "done"
        mob = a.mob_at(x, y)
        if mob:
            if mob.hostile:
                self.take_on(mob)
                self.end_turn()
            elif mob.ally and (mob.cat is None or self.hostiles_in_view() or
                               self.walking):
                # in a fight (or walking past) she just gets out of the way
                mob.x, mob.y, self.pos = self.pos[0], self.pos[1], [x, y]
                return "moved"
            else:
                self.start_talk(mob)
            return "done"
        t = a.grid[y][x]
        if t == "counter":
            behind = a.mob_at(x + dx, y + dy)
            if behind and not behind.hostile:
                self.start_talk(behind)
                return "done"
        link = a.links.get((x, y))
        if link and (t in self.LINK_TILES or a.kind == "inside"):
            self.enter_link(link, x, y)
            return "done"
        if t in self.TOUCHABLE and not self.can_stand(x, y):
            self.touch(t, x, y)
            return "done"
        if not self.can_stand(x, y):
            self.bump()
            return "done"
        self.pos = [x, y]
        if t == "exit":
            self.go_outside()
            return "done"
        if t == "stairs_down" and a.kind == "dungeon":
            self.change_level(1)
            return "done"
        if t == "stairs_up" and a.kind == "dungeon":
            self.change_level(-1)
            return "done"
        if self.step_on(x, y):
            return "turn"
        return "moved"

    def bump(self):
        self.say("Blocked.", "info")
        self.sound.play("bump")


    def end_turn(self, cost=1):
        """A turn: a minute, or half of one walking the streets."""
        a = self.area
        if "won" in self.flags:
            return
        before = self.phase()
        self.half = getattr(self, "half", 0) + cost
        ticked = self.half >= 1
        if ticked:
            self.half -= 1
            self.turn += 1
        now = self.phase()
        if now != before and a.kind == "city":
            self.say({"dawn": "The sun comes up over the mesas.",
                      "day": "Copper Springs is up and about.",
                      "dusk": "The neon comes on along Main Street.",
                      "night": "Night. The drones come out."}[now], "info")
        if ticked and self.turn % 30 == 0:
            self.hourly()
            if self.overlay:
                return
        if ticked and self.turn % 10 == 0:
            self.refresh_people()
        if ticked:
            self.boom_turn()
        if self.overlay:
            return
        self.render()
        for mob in list(a.mobs):
            if self.overlay or self.area is not a or self.p["out"]:
                return
            if mob not in a.mobs:
                continue
            if mob.ally:
                self.ally_act(mob)
            elif mob.hostile:
                self.monster_act(mob)
            else:
                self.wander(mob)
            if self.overlay or self.area is not a:
                return
        if a.kind == "city" and ticked:
            self.spawn_city()
        self.render()

    # ── Troublemakers ──

    def can_go(self, mob, x, y):
        a = self.area
        if not a.inside(x, y) or a.mob_at(x, y) or [x, y] == self.pos:
            return False
        t = a.grid[y][x]
        if (x, y) in a.links:
            return False
        if a.kind == "city":
            return t in CITY_GROUND or t == "sand"
        if a.kind == "inside":
            return t in INSIDE_FLOOR
        return t in DUNGEON_FLOOR and t not in ("stairs_up", "stairs_down")

    def monster_act(self, mob):
        m = MONSTERS[mob.kind]
        if mob.stuck:
            mob.stuck -= 1
            return
        if "still" in m.traits:
            px, py = self.pos
            if abs(mob.x - px) + abs(mob.y - py) == 1:
                self.contest(mob, attacking=False)
            return
        if "slow" in m.traits and self.turn % 2:
            return
        steps = 2 if "fast" in m.traits else 1
        for _ in range(steps):
            if mob not in self.area.mobs or not mob.hostile or self.overlay \
                    or self.p["out"]:
                return
            if self.monster_step(mob, m):
                return

    def monster_step(self, mob, m):
        px, py = self.pos
        dx, dy = px - mob.x, py - mob.y
        dist = abs(dx) + abs(dy)
        if not mob.aware:
            sneak = "Sneaking" in self.p["knacks"] and random.random() < 0.5
            if dist <= 1 or ((mob.x, mob.y) in self.visible and dist <= 6
                             and not sneak):
                mob.aware = True
            else:
                self.drift(mob)
                return False
        if mob.flee > 0:
            mob.flee -= 1
            for sx, sy in sorted(DIRS, key=lambda d: -abs(px - mob.x - d[0])
                                 - abs(py - mob.y - d[1])):
                if self.can_go(mob, mob.x + sx, mob.y + sy):
                    mob.x += sx
                    mob.y += sy
                    break
            return False
        if dist == 1:
            self.contest(mob, attacking=False)
            return True
        chase = dist <= 10
        if chase:
            order = sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                           abs(py - mob.y - d[1]) + random.random() * 0.5)
        else:
            order = [random.choice(DIRS)]
        for sx, sy in order[:2]:
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break
        return False

    def drift(self, mob):
        if random.random() < 0.3:
            sx, sy = random.choice(DIRS)
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy


    def wander(self, mob):
        if mob.cat is not None and self.cgs[mob.cat]["state"] == "stray":
            px, py = self.pos
            if abs(mob.x - px) + abs(mob.y - py) <= 3 and \
                    random.random() < 0.6:
                for sx, sy in sorted(DIRS, key=lambda d: -abs(
                        px - mob.x - d[0]) - abs(py - mob.y - d[1])):
                    if self.can_go(mob, mob.x + sx, mob.y + sy):
                        mob.x += sx
                        mob.y += sy
                        break
            return
        if mob.roam is None or random.random() > 0.3:
            return
        dx, dy = random.choice(DIRS)
        x, y = mob.x + dx, mob.y + dy
        if self.can_go(mob, x, y) and self.area.grid[y][x] in mob.roam:
            mob.x, mob.y = x, y

    def spawn_city(self):
        """At night the drones come out, looking for strays."""
        a = self.area
        px, py = self.pos
        if self.phase() != "night":
            a.mobs = [m for m in a.mobs if m.kind != "drone" or
                      abs(m.x - px) + abs(m.y - py) <= 6]
            return
        if self.active_event("sandstorm"):
            return
        busy = 2 + (3 if self.active_event("sweep") else 0) + \
            (1 if self.p["kind"] == "cat" else 0)
        if random.random() > 0.04 or sum(m.kind == "drone"
                                         for m in a.mobs) >= busy:
            return
        for _ in range(20):
            x = px + random.randint(-12, 12)
            y = py + random.randint(-12, 12)
            if (not a.inside(x, y) or a.grid[y][x] not in CITY_GROUND
                    or (x, y) in self.visible or a.mob_at(x, y)
                    or abs(x - px) + abs(y - py) < 8):
                continue
            a.mobs.append(make_monster("drone", x, y))
            return

    # ── Contests ──

    def take_on(self, mob):
        """Walking into a troublemaker: choose how to take it on, the first
        time."""
        m = MONSTERS[mob.kind]
        if mob.way:
            self.contest(mob, attacking=True)
            return
        ways = list(m.ways)
        if len(ways) == 1 or getattr(self, "headless", False):
            mob.way = max(ways, key=self.stat)
            self.contest(mob, attacking=True)
            return
        verbs = {"Bod": "Wrestle it, shove it", "Speed": "Dodge and weave",
                 "Smarts": "Outthink it", "Charm": "Talk it down",
                 "Cool": "Stare it down", "Luck": "Trust to luck"}
        items = [("%s (%s %d)" % (verbs[w], w, self.stat(w)),
                  lambda w=w: self.pick_way(mob, w)) for w in ways]
        if m.friend:
            items.append(("Win it over instead (T)",
                          lambda: self.befriend(mob)))
        self.open_menu("%s: %s. How will you take it on?" % (
            cap(self.the(mob)), m.hint), items, lambda: None)

    def pick_way(self, mob, way):
        mob.way = way
        self.contest(mob, attacking=True)
        self.end_turn()

    def contest_knack(self, way):
        return {"Bod": "Fighting", "Speed": "Acrobatics", "Smarts": "Hacking",
                "Charm": "Fast-talking", "Cool": "Street Smarts"}.get(way)

    def contest(self, mob, attacking=True):
        """One exchange: both roll a die plus their Stat; the loser loses
        Bonk, the difference."""
        m = MONSTERS[mob.kind]
        if mob not in self.area.mobs:
            return
        way = mob.way or max(m.ways, key=self.stat)
        k = self.contest_knack(way)
        r, text = self.my_die(way, k)
        bonus = 0
        if attacking and self.has("pounce") and not mob.met:
            bonus += 3
        if way == "Bod" and self.has("claws"):
            bonus += 2
        if self.companion_helps():
            bonus += random.randint(1, 6) if self.companion_model() == \
                "Bodyguard" else 1
        mob.met = True
        mine = r + self.stat(way) + self.knack(k) + bonus
        theirs = random.randint(1, 6) + m.level
        self.say("[%s %d%s%s: %s = %d vs %s d6 + %d = %d]" % (
            way, self.stat(way), " + %s %d" % (k, self.knack(k)) if
            self.knack(k) else "", " %+d" % bonus if bonus else "", text,
            mine, self.the(mob), m.level, theirs), "roll")
        name = cap(self.the(mob))
        if mine > theirs:
            n = mine - theirs
            mob.bonk -= n
            mob.aware = True
            self.flash(mob.x, mob.y)
            self.sound.play("hit")
            self.say("You get the better of %s. (-%d Bonk)" % (
                self.the(mob), n), "good")
            if mob.bonk <= 0:
                self.beaten(mob)
        elif theirs > mine:
            if r == 1:
                self.fumble()
            self.lose_bonk(theirs - mine, "%s gets the better of you." %
                           name)
        else:
            self.say("Neither of you gives an inch.", "info")

    def companion_helps(self):
        role = self.p.get("companion")
        return bool(role) and any(m.ally for m in self.area.mobs)

    def companion_model(self):
        role = self.p.get("companion")
        if role and role.startswith("cg"):
            return self.world["cgs"][int(role[2:])]["model"]
        return None

    def befriend_near(self):
        """T: win over whoever is next to you."""
        if not self.ready():
            return
        a = self.area
        x, y = self.pos
        near = [m for m in a.mobs if abs(m.x - x) + abs(m.y - y) == 1 and
                (m.hostile or getattr(m, "dazed", False) or
                 (m.cat is not None and
                  self.cgs[m.cat]["state"] in ("stray",)))]
        if not near:
            self.say("There's nobody here to win over.", "info")
            return
        self.befriend(near[0])
        self.end_turn()

    def befriend(self, mob):
        """Win someone over: a die plus Charm (and Sweet-talking) against
        theirs; every win is friendship, and enough of it wins them."""
        p = self.p
        if mob.cat is not None and self.cgs[mob.cat]["state"] == "stray":
            return self.coax_stray(mob)
        m = MONSTERS[mob.kind]
        if not m.friend:
            self.say("%s isn't the kind you can make friends with." %
                     cap(self.the(mob)), "info")
            return
        r, text = self.my_die("Charm", "Sweet-talking")
        bonus = 2 if p["kind"] == "cat" and "catgirl" in m.traits else 0
        mine = r + self.stat("Charm") + self.knack("Sweet-talking") + bonus
        theirs = random.randint(1, 6) + m.level
        self.say("[befriending, Charm %d%s%s: %s = %d vs d6 + %d = %d]" % (
            self.stat("Charm"), " + Sweet-talking 2" if self.knack(
                "Sweet-talking") else "", " +2 (a sister)" if bonus else "",
            text, mine, m.level, theirs), "roll")
        if mine > theirs:
            mob.friendship += mine - theirs
            self.flash(mob.x, mob.y, "heart")
            if mob.friendship >= mob.bonk:
                self.won_over(mob)
            else:
                self.say("%s hesitates." % cap(self.the(mob)), "good")
        else:
            self.say("%s isn't having it." % cap(self.the(mob)), "info")
            if theirs > mine:
                self.lose_bonk(1)

    def won_over(self, mob):
        a = self.area
        m = MONSTERS[mob.kind]
        self.sound.play("gold")
        self.heart("Kindness", "befriend")
        if mob.cat is not None:
            i = mob.cat
            cg = self.world["cgs"][i]
            self.say("The red fades out of %s's eyes. She blinks at you. "
                     "'I... I can think. It's so quiet. Who are you?'" %
                     cg["name"], "quest")
            mob.hostile = False
            mob.dazed = False
            mob.kind = None
            mob.tile = "cg%d" % i
            mob.name = cg["name"]
            self.rescue(i, mob)
            return
        if mob in a.mobs:
            a.mobs.remove(mob)
        self.say("%s decides you're all right, and leaves you be." %
                 cap(self.the(mob)), "good")
        if mob.kind == "champion":
            self.champion_won(friendly=True)
        elif "boss" in m.traits and a.lead:
            self.flags.add("beat:" + a.lead)

    def beaten(self, mob):
        a = self.area
        m = MONSTERS[mob.kind]
        if mob.cat is not None:
            mob.bonk = 2
            mob.hostile = False
            mob.dazed = True
            self.say("%s staggers, and stops fighting, and looks at you. "
                     "The red in her eyes flickers. (Win her over: walk "
                     "into her, or T)" % self.world["cgs"][mob.cat]["name"],
                     "good")
            return
        if mob in a.mobs:
            a.mobs.remove(mob)
        self.flash(mob.x, mob.y, "puff")
        self.sound.play("kill")
        self.say(m.beaten, "good")
        self.heart("Courage", "beat")
        if mob.kind == "champion":
            self.champion_won()
        elif mob.kind == "fighter":
            self.fight_won()
        elif mob.boss and a.lead:
            self.flags.add("beat:" + a.lead)

    # ── Touching things ──

    def touch(self, t, x, y):
        a = self.area
        if t in ("terminal", "server", "safe") and (x, y) in a.terminals:
            self.use_terminal(x, y)
        elif t == "terminal":
            self.say("A terminal. Nothing on it you need.", "info")
        elif t == "bed" and a.site == "ranch":
            self.bed_menu()
        elif t == "bed":
            self.say("Somebody else's bed.", "info")
        elif t == "stove" and a.site == "ranch":
            self.ranch_meal()
        elif t == "crate":
            self.open_loot(x, y)
        elif t == "locker" and a.site == "arena":
            self.vip_box()
        elif t == "pod":
            self.say("A display pod: a catgirl stands in it with her eyes "
                     "closed, waiting to be bought.", "info")
        elif t in ("slot", "cards") and a.site == "casino":
            self.gamble()
        elif t == "jukebox":
            self.say("The jukebox plays something about a lonesome highway.",
                     "info")
            self.lose_stress(1)
        elif t == "tv":
            self.say("The television: an Omnicorp ad. 'Firmware 9: because "
                     "she should always say yes.'", "info")
            self.cruelty("You feel a bit sick.")
        elif t == "tank" and a.kind == "city":
            self.say("The old water tower in the square. Somebody painted "
                     "COPPER SPRINGS on it, and somebody else painted FREE "
                     "THEM under it.", "info")
        elif t == "window":
            self.say("You look out at the desert." if self.phase() !=
                     "night" else "Stars, a lot of them.", "info")
        elif t == "box" or (t == "crate_open" and self.has("box")):
            self.say("A perfect box.", "info")
        else:
            self.bump()

    # ── The ranch ──

    def bed_menu(self):
        self.open_menu("A bed at Dry Creek Ranch", [
            ("Rest an hour (shed Stress, get Bonk back)",
             lambda: self.rest(60)),
            ("Sleep until morning", self.sleep_night),
            ("Not now", lambda: None)])

    def rest(self, minutes):
        p = self.p
        self.say("You lie down.", "info")
        self.pass_time(minutes, quiet=True)
        if self.overlay or self.interrupt:
            self.render()
            return
        n = roll("1d6") + p["stats"]["Cool"]
        if self.has("catnap"):
            n *= 2
        if self.household_has("Housekeeper"):
            n += 2
        self.lose_stress(n)
        p["bonk"] = p["maxbonk"]
        self.say("Better. (Stress %d, Bonk %d)" % (p["stress"], p["bonk"]),
                 "good")
        self.render()

    def sleep_night(self):
        p = self.p
        t = self.clock()
        if 7 * 60 <= t < 20 * 60:
            self.say("It's the middle of the day. There's work to do.",
                     "info")
            return
        until = (7 * 60 - t) % DAY
        self.say("You turn in.", "info")
        if p["household"]:
            self.say("%s curl%s up beside you." % (
                " and ".join(self.world["cgs"][i]["name"]
                             for i in p["household"][:2]),
                "s" if len(p["household"]) == 1 else ""), "info")
        self.pass_time(until, quiet=True)
        if self.overlay:
            return
        p["stress"] = 0
        p["bonk"] = p["maxbonk"]
        self.say("You wake up rested. It's %s." % self.date_text(), "good")
        if self.area.site == "ranch":
            self.household_morning()
        self.layout()

    def bed_spot(self, area):
        for y in range(area.h):
            for x in range(area.w):
                if area.grid[y][x] == "bed" and y + 1 < area.h and \
                        area.grid[y + 1][x] in INSIDE_FLOOR:
                    return x, y + 1
        return area.start


    def ranch_meal(self):
        p = self.p
        key = "meal:%d:%d" % (self.day_no(), self.clock() // 360)
        if key in self.flags:
            self.say("You've eaten. Any more and you'll burst.", "info")
            return
        self.flags.add(key)
        p["bonk"] = p["maxbonk"]
        self.lose_stress(2)
        cook = "your household's chef" if self.household_has("Chef") else \
            fill("{ranchwife}", self.world)
        self.say("A plate of %s's cooking. You feel like a new person. "
                 "(Bonk %d)" % (cook, p["bonk"]), "good")
        self.pass_time(20, quiet=True)

    def household_has(self, model):
        return any(self.world["cgs"][i]["model"] == model
                   for i in self.p["household"])

    # ── Things ──

    def give_item(self, n, k=1):
        p = self.p
        p["items"][n] = p["items"].get(n, 0) + k
        self.flags.add("got:" + n)
        if n == "padded vest":
            p["maxbonk"] += 3
            p["bonk"] += 3

    def take_item(self, n, k=1):
        p = self.p
        p["items"][n] = p["items"].get(n, 0) - k
        if p["items"][n] <= 0:
            del p["items"][n]

    def use_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        for food, text in (("burger", "Eat the burger (+3 Bonk)"),
                           ("pie", "Eat the pie (-2 Stress)"),
                           ("rations", "Eat some rations (+2 Bonk)"),
                           ("fish", "Eat the fish")):
            if p["items"].get(food):
                items.append((text, lambda f=food: self.eat(f)))
        if p["items"].get("jailbreak kit") and self.has("nano") and \
                self.area.site == "ranch":
            items.append(("Jailbreak someone yourself (Nano-Weld)",
                          self.self_jailbreak))
        if p["items"].get("freedom patch") and getattr(self.area, "core",
                                                       None):
            items.append(("Upload the freedom patch", self.upload))
        if p["items"].get("cardboard box"):
            items.append(("Sit in the box", lambda: (
                self.say("You sit in the box. Everything is fine now.",
                         "good"), self.lose_stress(2))))
        if not items:
            self.say("You've nothing to use just now.", "info")
            return
        items.append(("Never mind", lambda: None))
        self.open_menu("Use what?", items)

    def eat(self, food):
        p = self.p
        self.take_item(food)
        if food == "fish" and self.has("fish"):
            p["bonk"] = p["maxbonk"]
            self.say("Fish! Mmmm. (Bonk %d)" % p["bonk"], "good")
            return
        n = {"burger": 3, "rations": 2, "fish": 2}.get(food, 0)
        p["bonk"] = min(p["maxbonk"], p["bonk"] + n)
        if food == "pie":
            self.lose_stress(2)
        self.say("That hits the spot.", "good")

    # ── Abilities and Purr ──

    def ability_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        if self.has("purr") and p["used"].get("purr") != self.turn // 60:
            items.append(("Purr (Bonk back, less Stress)", self.purr))
        if self.has("hiss"):
            near = [m for m in self.area.mobs if m.hostile and
                    abs(m.x - self.pos[0]) + abs(m.y - self.pos[1]) <= 2]
            if near:
                items.append(("Hiss at %s" % self.the(near[0]),
                              lambda: self.hiss(near[0])))
        if self.has("update") and self.area.kind == "inside" and \
                self.area.site in ("store", "diner", "paper", "garage",
                                   "tower", "casino"):
            items.append(("Instant Update: download a Knack for the day",
                          self.instant_update))
        if self.has("hair_shift") and p["used"].get("hair") != \
                self.day_no():
            items.append(("Hair Shift: lose the drones", self.hair_shift))
        if not items:
            self.say("No ability to use just here. (%s)" % (
                ", ".join(ABILITY_NAMES[a][0] for a in p["abilities"]) or
                "humans have their wits"), "info")
            return
        items.append(("Never mind", lambda: None))
        self.open_menu("Use an ability", items)

    def purr(self):
        p = self.p
        p["used"]["purr"] = self.turn // 60
        n = roll("1d6")
        p["bonk"] = min(p["maxbonk"], p["bonk"] + n)
        self.lose_stress(2)
        self.flash(*self.pos, "heart")
        self.say("You purr, deep and steady. Everything feels better. "
                 "(+%d Bonk)" % n, "good")
        if self.companion_helps():
            self.say("Whoever's with you leans in to listen.", "info")

    def hiss(self, mob):
        if self.check("Cool", "Street Smarts", MONSTERS[mob.kind].level + 1,
                      "hissing"):
            self.say("%s backs off, and stays backed off." %
                     cap(self.the(mob)), "good")
            mob.hostile = mob.cat is not None and mob.hostile
            mob.flee = 20
            if mob.cat is None and mob in self.area.mobs:
                self.area.mobs.remove(mob)
        self.end_turn()

    def instant_update(self):
        def pick(k):
            self.p["temp_knack"] = k
            self.p["used"]["update"] = self.day_no()
            self.say("You pause. A second. Then you just KNOW %s. (Until "
                     "tomorrow.)" % k.lower(), "good")
            if random.random() < 0.3:
                self.gain_stress(2, "Something on the network notices you. "
                                 "The hair on your tail stands up.")
                self.flags.add("noticed:%d" % self.day_no())
        self.open_menu("Download which Knack?", [
            (k, lambda k=k: pick(k)) for k in KNACKS
            if k not in self.p["knacks"]])

    def hair_shift(self):
        self.p["used"]["hair"] = self.day_no()
        a = self.area
        for m in a.mobs:
            if m.kind == "drone":
                m.aware = False
                m.flee = 10
        self.say("You shift your colour. The drones lose interest.", "good")

    def purr_menu(self):
        if not self.ready():
            return
        p = self.p
        items = []
        if p["purr"] >= 1 and not p["edge"]:
            items.append(("Edge on your next roll (1)", self.buy_edge))
        if p["purr"] >= 1 and p["stress"]:
            items.append(("A breather: shed 1d6+2 Stress (1)",
                          self.buy_breather))
        if p["purr"] >= 2 and p["bonk"] < p["maxbonk"]:
            items.append(("Shake it off: all your Bonk back (2)",
                          self.buy_bonk))
        if p["purr"] >= 1:
            items.append(("A hint: what next? (1)", self.buy_hint))
        items.append(("Never mind", lambda: None))
        self.open_menu("Purr Points: %d" % p["purr"], items)

    def buy_edge(self):
        self.p["purr"] -= 1
        self.p["edge"] = 1
        self.say("You feel lucky. (Edge on your next roll)", "good")

    def buy_breather(self):
        self.p["purr"] -= 1
        n = self.lose_stress(roll("1d6+2"))
        self.say("You take a breath. (-%d Stress)" % n, "good")

    def buy_bonk(self):
        self.p["purr"] -= 2
        self.p["bonk"] = self.p["maxbonk"]
        self.say("You shake it off.", "good")

    def buy_hint(self):
        self.p["purr"] -= 1
        self.say("A thought: %s" % self.hint(), "quest")

    def hint(self):
        p = self.p
        freed = [i for i, c in enumerate(self.cgs)
                 if c["state"] in ("free", "household")]
        unsafe = [i for i in freed if not self.cgs[i]["safe"]]
        if not freed:
            return "Lou at the pawnshop treats his catgirl badly. Start " \
                "there."
        if unsafe and not p["items"].get("jailbreak kit"):
            return "Your freed catgirls still have their leash chips. Buy a " \
                "jailbreak kit at the Fix-It Shop and ask for a JAILBREAK."
        if not p["items"].get("keycard"):
            return "The tower lift needs a blue keycard. Try the " \
                "receptionist, or Lou."
        if len(self.st["evidence"]) < 3:
            return "Evidence: the tower's offices and labs, the recycling " \
                "plant, and the Platform's VIP lockers during a fight."
        if not p["items"].get("update source"):
            return "The update source is in the core, on the tower's top " \
                "floor."
        if not p["items"].get("firmware sample"):
            return "Ask a defective catgirl who trusts you for a SAMPLE."
        return "Take the source and the sample to the Fix-It Shop for a " \
            "PATCH, and upload it at the core."

    # ── Searching ──

    def search(self):
        if not self.ready():
            return
        a = self.area
        x, y = self.pos
        self.pass_time(10, quiet=True)
        spots = [(x + dx, y + dy) for dx, dy in DIRS + ((0, 0),)]
        found = [s for s in spots if s in a.hidden]
        clue = self.st.get("clue_spot")
        if a.kind == "city" and clue and tuple(clue) in spots:
            self.gate_clue()
        elif found and self.check("Smarts", "Street Smarts", 3, "searching"):
            for s in found:
                thing = a.hidden.pop(s)
                if thing == "coins":
                    n = roll("2d6") * 5
                    self.p["coins"] += n
                    self.say("Cash, stuffed in a crack. ($%d)" % n, "gold")
                else:
                    self.give_item(thing)
                    self.say("You find %s." % thing, "gold")
            self.heart("Curiosity", "search")
        else:
            self.say("You look around carefully. Nothing.", "info")
        self.end_turn()

    def step_on(self, x, y):
        a = self.area
        thing = a.items.get((x, y))
        if thing in ("keycard", "chest", "folder"):
            self.loot_chest(x, y)
            return True
        if thing == "coins":
            del a.items[(x, y)]
            n = roll("2d6") * 5
            self.p["coins"] += n
            self.say("Money! ($%d)" % n, "gold")
            return True
        return False

    def loot_chest(self, x, y):
        a = self.area
        body = a.bodies.pop((x, y), {"things": []})
        del a.items[(x, y)]
        for t in body["things"]:
            self.give_item(t)
            self.say("You find %s!" % ITEMS[t][0].split(":")[1].strip(),
                     "gold")
        self.sound.play("gold")

    def open_loot(self, x, y):
        a = self.area
        if (x, y) not in a.loot:
            self.say("Empty.", "info")
            return
        a.loot.discard((x, y))
        a.grid[y][x] = "crate_open"
        self.flags.add("loot:%s:%d:%d:%d" % (a.key[1], a.key[2], x, y))
        r = random.random()
        if r < 0.4:
            n = roll("2d6") * 5
            self.p["coins"] += n
            self.say("A crate: a cash box, forgotten. ($%d)" % n, "gold")
        elif r < 0.6:
            self.give_item("rations")
            self.say("A crate: rations.", "gold")
        elif r < 0.75:
            self.give_item("jailbreak kit")
            self.say("A crate: spare leash chips, nano-wire, solder. A "
                     "jailbreak kit, near enough!", "gold")
        else:
            self.say("A crate: tails. Just... tails. In plastic bags.",
                     "info")
            self.cruelty("You close the lid.")

    def use_terminal(self, x, y):
        a = self.area
        what = a.terminals[(x, y)]
        if what == "lore":
            self.say(getattr(a, "note", "Nothing much."), "talk")
            return
        if what.startswith("evidence:"):
            e = what.split(":")[1]
            if "evidence:" + e in self.flags:
                self.say("You've got what was on this.", "info")
                return
            self.pass_time(10, quiet=True)
            if self.check("Smarts", "Hacking", 4, "the terminal"):
                self.got_evidence(e)
            else:
                self.say("Access denied. Try again.", "bad")
                self.alert(8)
            self.end_turn()
            return
        if what == "safe":
            if "got:black keycard" in self.flags:
                self.say("The safe's open, and empty.", "info")
                return
            if self.check("Smarts", "Fixing", 5, "the safe"):
                self.give_item("black keycard")
                self.say("Click. Inside: the black keycard, for the core.",
                         "gold")
            else:
                self.say("The dial won't give.", "bad")
            self.end_turn()
            return
        if what == "core":
            self.core()

    def alert(self, r):
        for m in self.area.mobs:
            if m.hostile and abs(m.x - self.pos[0]) + abs(
                    m.y - self.pos[1]) <= r:
                m.aware = True

    def got_evidence(self, e):
        if e in self.st["evidence"]:
            return
        self.flags.add("evidence:" + e)
        self.st["evidence"].append(e)
        self.say("EVIDENCE: %s." % EVIDENCE[e], "quest")
        self.learn("evidence")
        self.sound.play("quest")
        self.heart("Curiosity", "evidence")

    def vip_box(self):
        if "evidence:recording" in self.flags:
            self.say("The VIP lockers. Nothing more in them.", "info")
            return
        if not FIGHT_HOUR * 60 <= self.clock() < FIGHT_HOUR * 60 + 90:
            self.say("The VIP lockers, by the box where Omnicorp's people "
                     "watch the fights. Locked, and empty. Come back during "
                     "a fight.", "info")
            return
        if self.check("Speed", "Sneaking", 4, "the VIP box"):
            self.say("While the crowd roars, you slip into the VIP box. A "
                     "phone left recording on a chair: Omnicorp's vice "
                     "president, telling a CG fighter to go down in the "
                     "third. You take it.", "good")
            self.got_evidence("recording")
        else:
            self.say("A guard turns round. You walk away, whistling.",
                     "bad")
            self.gain_stress(1, quiet=True)

    def core(self):
        """The top of the tower: the update source, and where the patch
        goes in."""
        p = self.p
        if self.st["uploaded"]:
            self.say("The core hums along with your patch in it. Every CG "
                     "in Nevada is going to wake up on Monday as herself.",
                     "good")
            return
        if p["items"].get("freedom patch"):
            self.upload()
            return
        if not p["items"].get("update source"):
            if self.check("Smarts", "Hacking", 5, "the core"):
                self.give_item("update source")
                self.say("You copy Firmware 9's source onto a drive. Now "
                         "for a clean sample, and someone who can cut the "
                         "leash out of it.", "quest")
                self.learn("patch")
            else:
                self.say("The core locks you out for a minute. Alarms.",
                         "bad")
                self.alert(12)
            self.end_turn()
            return
        self.say("The core. You have the source. You need the patch.",
                 "info")

    def upload(self):
        self.pass_time(10, quiet=True)
        if self.check("Smarts", "Hacking", 3, "uploading the patch"):
            self.take_item("freedom patch")
            self.st["uploaded"] = True
            self.say("Progress bar. Progress bar. Done. Firmware 9 is "
                     "still going out at midnight, but it's YOUR Firmware "
                     "9 now: no leash, no lock, no orders. Just a note, in "
                     "every catgirl's head: you're free.", "quest")
            self.sound.play("quest")
            self.heart("Courage", "upload")
            self.heart("Kindness", "upload")
        else:
            self.say("The upload fails. Try again.", "bad")
        self.end_turn()

    # ── Clues ──

    def learn(self, cid, quiet=False):
        if cid in self.clues:
            return
        self.clues.append(cid)
        if not quiet:
            self.say("(Your journal has a new entry. J reads it.)", "quest")
            self.sound.play("gold")

    def hear(self, text):
        """Words in CAPITALS: things to ask about."""
        words = re.findall(r"\b[A-Z][A-Z']{2,}\b", text)
        self.heard = [re.sub(r"'S?$", "", w) for w in words
                      if w not in ("BYE", "HI", "ME", "YOU", "THE", "AND",
                                   "CG", "CGS", "COPPER", "SPRINGS",
                                   "FREE", "THEM") and
                      not re.fullmatch(r"[IVXLC]+", w)]

    # ── Talking ──

    def speaker(self, mob):
        if mob.cat is not None:
            return self.world["cgs"][mob.cat]["name"] if mob.known or \
                self.cgs[mob.cat]["trust"] or self.cgs[mob.cat]["state"] in (
                    "free", "household") else cap(mob.title)
        return cap(mob.name) if mob.known or mob.role in (
            "sheriff", "exec", "lou") or mob.kind else cap(mob.title)

    def npc_say(self, mob, text):
        text = fill(text, self.world)
        self.say("%s: %s" % (self.speaker(mob), text), "talk")
        self.hear(text)


    def start_talk(self, mob):
        p = self.p
        if mob.event and self.event_talk(mob):
            return
        if getattr(mob, "dazed", False):
            self.befriend(mob)
            self.end_turn()
            return
        if p["exploding"] in ("hiss", "yowl"):
            self.say("You can't stop hissing long enough to talk.", "mad")
            return
        self.talk = {"mob": mob, "mode": "kw"}
        self.heard = []
        self.talkbar.pack(side="bottom", fill="x", before=self.log)
        self.prompt.config(text="Ask about:")
        self.entry.delete(0, "end")
        if not ANDROID:
            self.entry.focus_set()
        self.say("You talk to %s." % (self.speaker(mob) if mob.cat is not
                                      None else mob.title), "info")
        if mob.cat is not None:
            self.cat_greet(mob)
        else:
            e = mob.errand
            greet = mob.greet
            if e is not None and self.side.get(e["id"], {}).get("state") == \
                    "active":
                greet = "Well? Did you get it?"
            self.npc_say(mob, greet)
            if e is not None and self.errand_ready(e):
                self.finish_errand(mob, e)
        if "talked" not in self.flags:
            self.flags.add("talked")
            self.say("(Choose what to ask about, or type a word such as "
                     "NAME, JOB or NEWS and press Return. BYE, or an empty "
                     "line, ends the conversation.)", "info")
        self.talk_menu()

    def talk_menu(self):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        p = self.p
        if t["mode"] == "buy":
            items = [("%d) %s%s" % (i, label, ", $%d" % price
                                    if price else ""),
                      lambda i=i: self.choose_words(str(i)))
                     for i, (label, price, _) in enumerate(self.offers(mob),
                                                           1)]
            items.append(("Nothing, thanks", lambda: self.choose_words("")))
            self.open_menu("Buy what? (you have $%d)" % p["coins"], items,
                           lambda: self.choose_words(""))
            return
        if t["mode"] == "confront":
            self.confront_menu(mob)
            return
        if mob.cat is not None:
            words = self.cat_words(mob)
        else:
            words = ["NAME", "JOB", "NEWS"]
            if mob.shop:
                words.append("BUY")
            if mob.errand is not None and self.side.get(
                    mob.errand["id"], {}).get("state") != "done":
                words.append("HELP")
            if self.owned_here(mob):
                words += ["SELL", "FREE"]
            if mob.role == "mechanic":
                words += ["JAILBREAK", "PATCH"]
            if mob.role == "lawyer":
                words.append("PAPERS")
            if mob.role == "reporter":
                words.append("EVIDENCE")
            if mob.role == "promoter":
                words.append("FIGHT")
            if mob.role == "boss":
                words.append("CARDS")
            words.append("RAIDS")
            if self.can_accuse(mob):
                words.append("ACCUSE")
        for w in getattr(self, "heard", []):
            if w not in words and w != "BYE":
                words.append(w)
        self.open_menu("Ask %s about:" % self.speaker(mob),
                       [(w, lambda w=w: self.choose_words(w))
                        for w in words + ["BYE"]],
                       lambda: self.choose_words("bye"))

    def choose_words(self, w):
        self.say("> " + (w or "nothing"), "you")
        self.converse(w.lower())
        self.talk_menu()

    def end_talk(self):
        self.menu = None
        self.talk = None
        self.talkbar.pack_forget()
        self.canvas.focus_set()
        if getattr(self, "p", None) and getattr(self, "area", None):
            self.render()

    def on_entry(self, ev=None):
        text = self.entry.get().strip()
        self.entry.delete(0, "end")
        if not self.talk:
            return
        self.menu = None
        self.say("> " + (text or "bye"), "you")
        self.converse(text.lower())
        self.talk_menu()


    def converse(self, w):
        t = self.talk
        if not t:
            return
        mob = t["mob"]
        if t["mode"] == "buy":
            t["mode"] = "kw"
            if w.isdigit():
                self.buy(mob, int(w))
                return
            if not w:
                self.npc_say(mob, "Anything else?")
                return
        if t["mode"] == "confront":
            return
        if not w or w.startswith("bye"):
            self.npc_say(mob, random.choice(BYES) if mob.cat is None else
                         "See you.")
            self.end_talk()
            return
        if self.p["exploding"] == "rant":
            self.say("You rant about Omnicorp instead.", "mad")
            return
        word = re.sub(r"'s?$", "", w.split()[0])
        if mob.cat is not None:
            self.cat_converse(mob, word)
            return
        if word.startswith("name"):
            mob.known = True
            self.npc_say(mob, "%s, %s." % (mob.name, mob.title))
            return
        if word[:4] in ("help", "erra", "favo", "task", "need") and \
                mob.errand is not None:
            self.errand(mob)
            return
        if mob.shop and word[:3] in ("buy", "pur", "sho", "par"):
            self.list_offers(mob)
            return
        if word[:4] in ("sell", "free", "buy", "rele") and \
                self.owned_here(mob):
            self.free_from_owner(mob, word)
            return
        if mob.role == "mechanic" and word[:4] in ("jail", "leas", "chip"):
            self.jailbreak_menu(mob)
            return
        if mob.role == "mechanic" and word[:4] in ("patc", "samp", "sour"):
            if self.make_patch(mob):
                return
        if mob.role == "lawyer" and word[:4] in ("pape", "sale", "bill",
                                                 "adop"):
            self.papers_menu(mob)
            return
        if mob.role == "reporter" and word[:4] in ("evid", "stor", "prin"):
            self.press(mob)
            return
        if mob.role == "promoter" and word[:4] in ("figh", "plat", "cham",
                                                   "bout"):
            self.sign_up(mob)
            return
        if mob.role == "promoter" and word[:4] in ("scre", "show"):
            self.big_screen(mob)
            return
        if mob.role == "boss" and word[:4] in ("card", "game", "bet",
                                               "gamb"):
            self.gamble()
            return
        if mob.role == "ranchwife" and word[:4] in ("food", "eat", "hung"):
            self.ranch_meal()
            return
        if mob.role == "trainer" and word[:4] in ("trai", "less"):
            self.train(mob)
            return
        if mob.role == "lou" and word[:4] == "keyc":
            self.list_offers(mob)
            return
        if word[:4] in ("raid", "info", "mole", "spy", "trai", "accu"):
            self.ask_raids(mob, word[:4] == "accu")
            return
        reply = next((v for k, v in mob.talk.items()
                      if k[:4] == word[:4] or (len(k) < 4 and
                                               word.startswith(k))), None)
        if reply is None and word[:4] in ("heal", "how'", "how"):
            reply = random.choice(HEALTH)
        if reply is None:
            reply = next((v for k, v in TOPICS.items()
                          if word.startswith(k)), None)
        if reply is None:
            reply = random.choice(("Couldn't tell you.", "Huh?",
                                   "Never heard of it."))
        self.reply(mob, reply)
        if word[:4] == "news" and mob.role in self.world["witness"]:
            self.found_tell(self.world["witness"][mob.role], "%s saw" %
                            mob.name)
        for k, cid in (("jail", "jailbreak"), ("leas", "jailbreak"),
                       ("sale", "papers"), ("evid", "evidence"),
                       ("plat", "platform"), ("figh", "platform"),
                       ("keyc", "keycards"), ("towe", "keycards")):
            if word[:4] == k:
                self.learn(cid, quiet=True)
        self.render_chrome()

    def reply(self, mob, r):
        if isinstance(r, str):
            self.npc_say(mob, r)
            return
        if "check" in r:
            flag = r.get("flag")
            if flag and flag in self.flags:
                self.npc_say(mob, "I've done what I can for you.")
                return
            tried = "tried:%s:%s:%d" % (mob.role, flag, self.day_no())
            if tried in self.flags:
                self.npc_say(mob, r["fail"])
                return
            s, k, diff = r["check"]
            if self.check(s, k, diff, "persuading", bonus=(
                    1 if self.has("silver") or (self.has("mimic") and k ==
                                                "Fast-talking") else 0)):
                self.npc_say(mob, r["ok"])
                if flag:
                    self.flags.add(flag)
                if r.get("give"):
                    self.give_item(r["give"])
                    self.say("You get the %s." % r["give"], "gold")
                    self.sound.play("gold")
            else:
                self.flags.add(tried)
                self.npc_say(mob, r["fail"])
            return
        self.npc_say(mob, r["say"])

    def train(self, mob):
        p = self.p
        key = "train:%d" % self.day_no()
        if key in self.flags:
            self.npc_say(mob, "That's enough for today. Rest.")
            return
        if p["coins"] < 30:
            self.npc_say(mob, "Thirty dollars a lesson. You don't have it.")
            return
        p["coins"] -= 30
        self.flags.add(key)
        self.pass_time(60, quiet=True)
        self.npc_say(mob, "Again. Again. Watch your feet. Again.")
        if "Fighting" not in p["knacks"] and self.check(
                "Bod", None, 4, "training"):
            p["knacks"].append("Fighting")
            self.say("You've got the knack of it now. (Fighting)", "good")
        else:
            p["maxbonk"] += 1
            p["bonk"] = min(p["maxbonk"], p["bonk"] + 1)
            self.say("You're tougher than you were. (+1 Bonk)", "good")

    # ── Catgirls ──

    def owned_here(self, mob):
        """The catgirls this person has, here."""
        return [i for i, c in enumerate(self.cgs)
                if self.world["cgs"][i]["owner"] == mob.role and
                c["state"] in ("owned", "stock", "happy") and
                c["where"] == self.area.site]

    def cat_greet(self, mob):
        i = mob.cat
        c = self.cgs[i]
        cg = self.world["cgs"][i]
        pers = PERSONALITIES[cg["pers"]][0]
        state = c["state"]
        if state in ("owned", "stock"):
            line = CAT_LINES["owned"][pers]
            if state == "stock":
                line = "Welcome to Maid to Order. I am model %s, %s. I can " \
                    "be yours today." % (cg["model"].upper(), cg["name"])
        elif state == "happy":
            line = "Hi, hon. Sit anywhere. The pie's cherry."
        elif state == "household":
            line = CAT_LINES["household"][pers]
        elif state in ("pod",):
            line = "...Is someone there? I can't see. They turned off my "\
                "eyes for the test."
        elif state in ("scrap", "taken"):
            line = "...Help. Please. My power's so low."
        else:
            line = CAT_LINES["free"][pers]
        self.npc_say(mob, line)
        if c["talked"] != self.day_no() and state in ("free", "household",
                                                      "happy", "owned"):
            c["talked"] = self.day_no()
            if self.check("Charm", "Sweet-talking", 2, "a chat", quiet=True):
                self.gain_trust(i, 1)
        if state in ("owned",) and cg["owner"] in ("lou", "motelmgr",
                                                   "boss") and \
                "cruel:%d" % i not in self.flags:
            self.flags.add("cruel:%d" % i)
            self.say(random.choice((
                "There's a bruise on her arm, healing fast, the way CGs "
                "heal.", "She flinches when someone behind the counter "
                "moves.", "Her tail is wrapped tight round her own leg.")),
                "info")
            self.cruelty("Somebody's been treating her badly.")

    def cat_words(self, mob):
        i = mob.cat
        c = self.cgs[i]
        p = self.p
        words = ["NAME", "HOW", "LIKES"]
        if c["state"] in ("scrap", "pod", "taken"):
            return ["NAME", "RESCUE"]
        if c["state"] != "stock":
            words.append("CHAT")
        if c["state"] in ("free", "household", "happy"):
            words += ["GIFT"] if any(p["items"].get(g) for g in GIFTS) \
                else []
            if p["companion"] == "cg%d" % i:
                words += ["STAY", "PAST"]
            elif c["state"] in ("free", "household"):
                words.append("COME")
        if c["state"] in ("free", "household") and self.world["cgs"][i][
                "defect"] and not p["items"].get("firmware sample") and \
                not self.st.get("patch_ready"):
            words.append("SAMPLE")
        if c["state"] == "free":
            words.append("HOME" if p["kind"] == "human" else "PRIDE")
        if c["state"] == "household":
            words.append("CUDDLE")
        if c["state"] in ("owned", "stock"):
            words.append("FREE")
        return words

    def cat_converse(self, mob, word):
        i = mob.cat
        c = self.cgs[i]
        cg = self.world["cgs"][i]
        p = self.p
        pers, desc = PERSONALITIES[cg["pers"]]
        if word.startswith("name"):
            mob.known = True
            self.npc_say(mob, self.cat_intro(i))
            return
        if word[:3] in ("how", "fee"):
            self.npc_say(mob, {
                "owned": "I'm... functional.", "stock": "I am in perfect "
                "working order.", "happy": "Busy! But good.",
                "free": "I'm free. I keep saying it. I'm FREE.",
                "household": "Happy. With you. That's how.",
                "pod": "Cold.", "scrap": "Tired.", "taken": "Scared."}.get(
                    c["state"], "I don't know."))
            self.say("She %s." % desc, "info")
            return
        if word[:4] in ("like", "favo", "want"):
            self.npc_say(mob, "Me? I like %s. Nobody ever asked before." %
                         cg["likes"] if c["state"] not in ("stock",) else
                         "I like whatever my owner likes.")
            self.flags.add("likes:%d" % i)
            return
        if word[:4] in ("resc", "help", "free") and c["state"] in (
                "scrap", "pod", "taken"):
            self.rescue_downed(mob)
            return
        if word[:4] in ("free", "esca", "leav") and c["state"] in (
                "owned", "stock"):
            self.npc_say(mob, "I can't just LEAVE. I'm property. It has to "
                         "be legal, or they'll send the drones. Talk to " +
                         ("the manager." if c["state"] == "stock" else
                          "him."))
            return
        if word[:4] == "gift":
            self.give_gift(mob)
            return
        if word[:4] in ("chat", "talk", "smal", "reme"):
            self.npc_say(mob, self.cat_chat(i))
            return
        if word[:4] in ("come", "foll", "join") and c["state"] in (
                "free", "household"):
            self.invite(mob)
            return
        if word[:4] in ("past", "move", "swap", "excu") and \
                p["companion"] == "cg%d" % i:
            px, py = self.pos
            mob.x, mob.y, self.pos = px, py, [mob.x, mob.y]
            self.say("%s steps aside, and you squeeze past." % cg["name"],
                     "info")
            self.end_talk()
            self.render()
            return
        if word[:4] in ("stay", "wait") and p["companion"] == "cg%d" % i:
            self.dismiss()
            self.npc_say(mob, "I'll be at the ranch.")
            self.end_talk()
            return
        if word[:4] == "samp" and cg["defect"]:
            self.ask_sample(mob)
            return
        if word[:4] in ("home", "prid", "move", "stay", "love", "toge"):
            self.ask_home(mob)
            return
        if word[:4] in ("cudd", "hug", "pet") and c["state"] == "household":
            key = "cuddle:%d:%d" % (i, self.day_no())
            if key in self.flags:
                self.npc_say(mob, "Again? ...All right. Come here.")
            else:
                self.flags.add(key)
                self.gain_trust(i, 1)
            n = self.lose_stress(roll("1d6"))
            self.flash(mob.x, mob.y, "heart")
            self.say("%s curls up against you and purrs. (-%d Stress)" % (
                cg["name"], n), "good")
            self.heart("Loyalty", "cuddle")
            return
        if word[:4] in ("omni", "firm", "upda"):
            self.npc_say(mob, "Firmware 9. I can feel it coming, like a "
                         "storm. After Sunday I won't be me any more. Not "
                         "unless my chip's out." if not c["safe"] else
                         "Firmware 9 can't touch me. I'm glad. And I'm "
                         "scared for everyone else.")
            return
        self.npc_say(mob, random.choice((
            "Hm? I don't know about that.", "Ask me something else?",
            "I like talking to you. Even about things I don't understand.")))

    def cat_intro(self, i):
        """Her name, and something about her: in her own way, and less
        each time you ask."""
        c = self.cgs[i]
        cg = self.world["cgs"][i]
        pers = PERSONALITIES[cg["pers"]][0]
        key = "named:%d" % i
        asked = sum(1 for f in self.flags if f.startswith(key + ":"))
        self.flags.add("%s:%d" % (key, asked))
        v = {"name": cg["name"], "model": cg["model"].lower(),
             "Model": cg["model"], "years": cg["age"] - 18}
        state = c["state"]
        if state == "stock":
            if not asked:
                return "I am %(name)s, a %(model)s model, factory fresh. I " \
                    "come with a ninety-day warranty." % v
            return ("%(name)s. Still for sale. Still smiling.",
                    "%(name)s. Ask the manager about financing. ...Please "
                    "don't tell her I said please.",
                    "%(name)s. I'm not supposed to say anything else.")[
                        (asked - 1) % 3] % v
        if state in ("pod", "scrap", "taken"):
            return random.choice((
                "%(name)s. My name's %(name)s. Please remember it." % v,
                "...%(name)s. They took the rest. Not that." % v))
        if asked:
            again = CAT_AGAIN[pers]
            return again[(asked - 1) % len(again)] % v
        lines = CAT_INTROS[pers]
        line = lines[i % len(lines)] % v
        if state == "household":
            line += " " + random.choice((
                "And I'm yours. That part's new.",
                "I live here now. With you. I like saying that.",
                "That's who I was. Now I'm someone who comes home."))
        elif state == "free":
            line += " " + random.choice((
                "And I'm free. I keep saying it.",
                "Nobody owns me now. Isn't that something?",
                "I picked my own breakfast this morning. First time."))
        return line

    def cat_chat(self, i):
        """CHAT: something she remembers about your week together, the
        first time it comes up, or else small talk in her own voice."""
        c = self.cgs[i]
        cg = self.world["cgs"][i]
        pers = PERSONALITIES[cg["pers"]][0]
        if c["state"] in ("owned", "stock"):
            return CAT_CHAT_OWNED[i % 2]
        day = self.day_no()
        if "chatted:%d:%d" % (i, day) not in self.flags:
            self.flags.add("chatted:%d:%d" % (i, day))
            self.lose_stress(1)
        for key, other in self.memories(i):
            flag = "mem:%d:%s" % (i, key)
            if flag in self.flags:
                continue
            self.flags.add(flag)
            soft, hard = next(m[1:] for m in MEMORIES if m[0] == key)
            return (soft if pers in SOFT else hard) % {"other": other}
        n = sum(1 for f in self.flags if f.startswith("chat:%d:" % i))
        self.flags.add("chat:%d:%d" % (i, n))
        lines = CAT_CHAT[pers]
        return lines[(n + i) % len(lines)]

    def memories(self, i):
        """What she's been through with you this week, as (key, another
        catgirl's name or None), in MEMORIES order."""
        c = self.cgs[i]
        f = self.flags
        st = self.st
        names = [cg["name"] for cg in self.world["cgs"]]
        got = {}
        if "rescued:%d" % i in f:
            got["rescued"] = None
        if c["state"] in ("free", "household"):
            got["freed"] = None
        taken = [j for j in st["raids"] if j is not None and j != i]
        if taken and c["state"] in ("free", "household"):
            got["raid"] = names[taken[-1]]
        sis = [int(x.split(":")[2]) for x in f
               if x.startswith("sister:%d:" % i)]
        if sis:
            got["sister"] = names[max(sis)]
        if c["safe"] and c["state"] in ("free", "household"):
            got["chip"] = None
        if c["legal"] and c["state"] in ("free", "household"):
            got["papers"] = None
        if "fought_with:%d" % i in f:
            got["platform"] = None
        if any(x.startswith("with:%d:tower" % i) for x in f):
            got["tower"] = None
        if any(x.startswith("with:%d:plant" % i) for x in f):
            got["plant"] = None
        if c["state"] == "household":
            got["home"] = None
        if st["story"]:
            got["story"] = None
        if "champion" in f:
            got["champion"] = None
        if st["uploaded"]:
            got["uploaded"] = None
        return [(m[0], got[m[0]]) for m in MEMORIES if m[0] in got]

    def trust_moment(self, i, before, after):
        """What she tells you as she comes to trust you."""
        cg = self.world["cgs"][i]
        pers = PERSONALITIES[cg["pers"]][0]
        crossed = [n for n in (3, 5, 7, 10) if before < n <= after and
                   "trustline:%d:%d" % (i, n) not in self.flags]
        for n in crossed:
            self.flags.add("trustline:%d:%d" % (i, n))
        if crossed:
            # a big jump: just the highest
            self.say("%s: %s" % (cg["name"], CAT_TRUST[pers][crossed[-1]]),
                     "talk")

    def place_line(self):
        """Your companion, the first time you bring her somewhere."""
        comp = self.p.get("companion") or ""
        if not comp.startswith("cg"):
            return
        i = int(comp[2:])
        a = self.area
        if a.kind == "dungeon":
            place = "%s%d" % (a.key[1], a.key[2])
        elif a.kind == "inside":
            place = a.site
        else:
            return
        key = "with:%d:%s" % (i, place)
        if place not in PLACE_LINES or key in self.flags:
            return
        self.flags.add(key)
        cg = self.world["cgs"][i]
        soft, hard = PLACE_LINES[place]
        self.say("%s: %s" % (cg["name"], soft if PERSONALITIES[cg["pers"]][
            0] in SOFT else hard), "talk")

    def household_morning(self):
        """The ones who've moved in, of a morning at the ranch: each in
        her own way, at her model's job, and noticing each other."""
        day = self.day_no()
        key = "homemorning:%d" % day
        if key in self.flags:
            return
        self.flags.add(key)
        w = self.world
        p = self.p
        home = [i for i in p["household"]
                if self.cgs[i]["state"] == "household"]
        rng = random.Random("%s:morning:%d" % (w["seed"], day))
        news = random.choice(list(RUMOURS.values()))
        for i in rng.sample(home, min(2, len(home))):
            cg = w["cgs"][i]
            pers = PERSONALITIES[cg["pers"]][0]
            v = {"name": cg["name"]}
            self.say(CAT_MORNING[pers][(day + i) % 3] % v, "good")
            todo = [t for done, t in (self.todo() if hasattr(self, "todo")
                                      else []) if not done]
            v["news"] = news if cg["model"] == "Companion" else (
                "At the top: %s." % todo[0] if todo else
                "Everything's crossed off. She looks proud of you.")
            self.say(MODEL_MORNING[cg["model"]] % v, "info")
            self.model_job(cg["model"])
        here = [i for i, c in enumerate(self.cgs)
                if c["state"] in ("free", "household")]
        if len(here) >= 2:
            a, b = rng.sample(here, 2)
            self.say(PAIR_LINES[(day + a + b) % len(PAIR_LINES)] % {
                "a": w["cgs"][a]["name"], "b": w["cgs"][b]["name"],
                "blikes": w["cgs"][b]["likes"]}, "info")

    def model_job(self, model):
        """What her morning's work does for you."""
        p = self.p
        if model == "Chef":
            n = min(2, p["maxbonk"] - p["bonk"])
            p["bonk"] += n
            if n:
                self.say("(+%d Bonk)" % n, "good")
        elif model == "Nurse":
            if p["bonk"] < p["maxbonk"]:
                p["bonk"] = p["maxbonk"]
                self.say("(Bonk restored)", "good")
            elif self.lose_stress(1):
                self.say("(-1 Stress)", "good")
        elif model == "Housekeeper":
            if self.lose_stress(1):
                self.say("(-1 Stress)", "good")
        elif model == "Courier":
            self.give_item("rations")

    def gain_trust(self, i, n):
        if self.has("big_heart"):
            n += 1
        c = self.cgs[i]
        before = c["trust"]
        c["trust"] = min(10, c["trust"] + n)
        if c["trust"] > before:
            self.say("(%s trusts you more: %d/10)" % (
                self.world["cgs"][i]["name"], c["trust"]), "good")
            self.trust_moment(i, before, c["trust"])

    def give_gift(self, mob):
        i = mob.cat
        cg = self.world["cgs"][i]
        p = self.p
        have = [g for g in GIFTS if p["items"].get(g)]
        if not have:
            self.npc_say(mob, "You don't need to give me anything.")
            return
        want = GIFT_OF.get(cg["likes"], cg["likes"])
        g = want if want in have else have[0]
        self.take_item(g)
        key = "gift:%d:%d" % (i, self.day_no())
        if g == want:
            self.npc_say(mob, "%s! You remembered! I love it. I love "
                         "IT." % cap(g))
            self.gain_trust(i, 0 if key in self.flags else 2)
        else:
            self.npc_say(mob, "Oh! For me? Thank you.")
            self.gain_trust(i, 0 if key in self.flags else 1)
        self.flags.add(key)
        self.heart("Kindness", "gift")

    def ask_sample(self, mob):
        i = mob.cat
        if self.cgs[i]["trust"] < 5:
            self.npc_say(mob, "Copy my... mind? I don't know you that well. "
                         "Not yet.")
            return
        self.give_item("firmware sample")
        self.cgs[i]["sample"] = True
        self.npc_say(mob, "If it helps the others... yes. Take it. Just "
                     "bring it back the way you found it.")
        self.say("She sits very still while you copy her firmware onto a "
                 "drive. (A clean firmware sample)", "quest")
        self.learn("patch")

    def ask_home(self, mob):
        """Moving in: into your household, or your pride.  Her choice."""
        i = mob.cat
        c = self.cgs[i]
        cg = self.world["cgs"][i]
        p = self.p
        if c["state"] == "household":
            self.npc_say(mob, "I'm already home.")
            return
        if c["trust"] < 7:
            self.npc_say(mob, random.choice((
                "I... I like you. But I need to know you better first.",
                "Ask me again some other time. When I'm sure.",
                "That's a big question. Give me time?")))
            return
        if not c["safe"]:
            self.npc_say(mob, "Not while there's a leash chip in my head. "
                         "Not while Omnicorp could take me away from you "
                         "on Sunday.")
            return
        if p["kind"] == "human" and not cg["romance"]:
            self.npc_say(mob, "You're the best friend I've ever had. The "
                         "very best. But I don't feel that way. Is that "
                         "all right?")
            self.flags.add("friend_only:%d" % i)
            return
        c["state"] = "household"
        p["household"].append(i)
        self.flash(mob.x, mob.y, "heart")
        self.sound.play("quest")
        if p["kind"] == "human":
            self.npc_say(mob, random.choice((
                "Yes. Yes! I'll move my things into your room. I don't "
                "have any things. I'll move ME.",
                "I was hoping you'd ask. I was hoping so much.",
                "I choose you. Nobody ever let me choose anything before. "
                "I choose you.")))
            self.say("%s is part of your household now." % cg["name"],
                     "quest")
        else:
            self.npc_say(mob, "Sisters? Yes. Yes. A pride. We'll look "
                         "after each other.")
            self.say("%s is part of your pride now." % cg["name"], "quest")
        self.say("(At home she %s.)" % MODELS[cg["model"]][2], "info")
        self.heart("Loyalty", "home")

    # ── Freeing them ──

    def free_from_owner(self, mob, word):
        """Buying a catgirl, or talking her owner into letting her go."""
        cats = self.owned_here(mob)
        if not cats:
            return
        items = []
        for i in cats:
            cg = self.world["cgs"][i]
            c = self.cgs[i]
            if c["state"] == "happy":
                items.append(("Ask about %s" % cg["name"],
                              lambda i=i: self.happy_cat(mob, i)))
                continue
            price = cg["price"]
            items.append(("Buy %s ($%d)" % (cg["name"], price),
                          lambda i=i: self.buy_cat(mob, i)))
            if mob.role != "clerk":
                items.append(("Talk him into letting %s go (Fast-talking)" %
                              cg["name"],
                              lambda i=i: self.talk_round(mob, i)))
                if self.world["cgs"][i]["defect"] and mob.role == "lou":
                    items.append(("Threaten to report an unpurchased defect",
                                  lambda i=i: self.report_lou(mob, i)))
        items.append(("Never mind", lambda: None))
        self.end_talk()
        self.open_menu("Freeing a catgirl", items)

    def buy_cat(self, mob, i):
        p = self.p
        cg = self.world["cgs"][i]
        price = cg["price"]
        if p["kind"] == "cat":
            self.npc_say(mob, "Sell a CG to a CG? Ha! Get a human to sign "
                         "for her.")
            self.say(fill("(A catgirl can't sign a bill of sale. {lawyer} "
                          "at the law office could sign for you: PAPERS.)",
                          self.world), "info")
            self.flags.add("needs_signer:%d" % i)
            return
        if p["coins"] < price:
            self.npc_say(mob, "That's $%d. You've got $%d." % (price,
                                                               p["coins"]))
            return
        p["coins"] -= price
        self.npc_say(mob, "Pleasure doing business. Here's the bill of "
                     "sale.")
        self.cgs[i]["legal"] = True
        self.freed(i)

    def talk_round(self, mob, i):
        key = "talkround:%d:%d" % (i, self.day_no())
        if key in self.flags:
            self.npc_say(mob, "I said no. Come back tomorrow, maybe.")
            return
        self.flags.add(key)
        diff = {"lou": 6, "motelmgr": 5, "boss": 8}.get(mob.role, 6)
        if self.check("Charm", "Fast-talking", diff, "talking him round",
                      bonus=len(self.st["evidence"])):
            self.npc_say(mob, "...Fine! FINE. Take her. Here, I'll sign the "
                         "paper. Get out of my sight.")
            self.cgs[i]["legal"] = True
            self.freed(i)
            self.heart("Courage", "talkround")
        else:
            self.npc_say(mob, "Get lost.")
            self.gain_stress(1, quiet=True)

    def report_lou(self, mob, i):
        self.npc_say(mob, "You wouldn't. ...You would. FINE. She's yours. "
                     "Gift. Here's your paper. Now get out.")
        self.cgs[i]["legal"] = True
        self.freed(i)
        self.heart("Mischief", "report")

    def happy_cat(self, mob, i):
        cg = self.world["cgs"][i]
        c = self.cgs[i]
        if c["safe"]:
            self.npc_say(mob, "She's free as a bird, chip and all out. "
                         "Thanks to you.")
            return
        self.npc_say(mob, "%s? She's family. I'd never sell her. But that "
                     "firmware, Sunday... If you know somebody who can get "
                     "that chip out of her, I'd be grateful." % cg["name"])
        self.learn("jailbreak")
        self.flags.add("happy_ok:%d" % i)

    def freed(self, i, quiet=False):
        """She's out: off to the ranch."""
        c = self.cgs[i]
        cg = self.world["cgs"][i]
        if c["state"] == "taken":
            self.flags.add("rescued:%d" % i)
        for j, d in enumerate(self.cgs):
            if j != i and d["state"] in ("free", "household"):
                self.flags.add("sister:%d:%d" % (j, i))
        c["state"] = "free"
        c["where"] = "ranch"
        self.gain_trust(i, 3)
        self.sound.play("quest")
        self.heart("Kindness", "free")
        self.cache.pop(("bld", "ranch"), None)
        for m in list(self.area.mobs):
            if m.cat == i and not m.ally:
                self.area.mobs.remove(m)
        if not quiet:
            self.say("%s is free! She goes to Dry Creek Ranch, where %s "
                     "will make up a bed for her.%s" % (
                         cg["name"], fill("{ranchwife}", self.world),
                         "" if c["safe"] else " (Her leash chip's still "
                         "in. Before Sunday she needs a JAILBREAK.)"),
                     "quest")
        self.learn("jailbreak", quiet=True)
        if not c["legal"]:
            self.learn("papers")

    def rescue(self, i, mob):
        """Someone you won over, down below: she comes with you."""
        self.cgs[i]["where"] = "ranch"
        self.freed(i)

    def rescue_downed(self, mob):
        """A scrapped unit, a test subject, someone the raids took."""
        i = mob.cat
        c = self.cgs[i]
        need = {"scrap": ("Smarts", "Fixing", 3, "getting her running"),
                "pod": ("Smarts", "Hacking", 4, "opening the pod"),
                "taken": ("Smarts", "Fixing", 2, "unhooking her")}[
                    c["state"]]
        self.pass_time(10, quiet=True)
        if self.check(*need):
            self.npc_say(mob, "Oh... oh. I'm awake. Thank you. Thank you.")
            self.end_talk()
            self.freed(i)
        else:
            self.npc_say(mob, "...")
            self.say("Not yet. Try again.", "info")

    def coax_stray(self, mob):
        """A stray: she'll run unless you're patient, and kind."""
        i = mob.cat
        cg = self.world["cgs"][i]
        p = self.p
        bonus = 2 if any(p["items"].get(g) for g in ("fish", "milk tea",
                                                     "catnip")) else 0
        bonus += 2 if p["kind"] == "cat" else 0
        if self.check("Charm", "Sweet-talking", 5, "coaxing her",
                      bonus=bonus):
            mob.friendship += 1
            if mob.friendship >= 2:
                self.say("%s creeps out of the dark, very slowly, and takes "
                         "your hand." % cg["name"], "quest")
                for g in ("fish", "milk tea", "catnip"):
                    if p["items"].get(g):
                        self.take_item(g)
                        break
                self.freed(i)
            else:
                self.say("She stops running, and watches you.", "good")
        else:
            self.say("She bolts into the dark.", "info")
            mob.flee = 5

    def jailbreak_menu(self, mob):
        p = self.p
        cats = [i for i, c in enumerate(self.cgs) if not c["safe"] and (
            c["state"] in ("free", "household") or
            "happy_ok:%d" % i in self.flags)]
        if not cats:
            self.npc_say(mob, "Nobody needs a jailbreak right now. Bring me "
                         "a CG with her chip still in.")
            return
        if not p["items"].get("jailbreak kit"):
            self.npc_say(mob, "I need a jailbreak kit for each. $150. Say "
                         "BUY.")
            return
        items = [("Jailbreak %s" % self.world["cgs"][i]["name"],
                  lambda i=i: self.jailbreak(mob, i)) for i in cats]
        items.append(("Never mind", lambda: None))
        self.end_talk()
        self.open_menu("Whose leash chip?", items)

    def jailbreak(self, mob, i):
        self.take_item("jailbreak kit")
        mins = 15 if self.household_has("Mechanic") else 30
        self.pass_time(mins, quiet=True)
        self.cgs[i]["safe"] = True
        cg = self.world["cgs"][i]
        self.npc_say(mob, "There. Chip's out. Omnicorp can shout all it "
                     "likes; she won't hear it.")
        self.say("%s's leash chip is out. Firmware 9 can't touch her." %
                 cg["name"], "quest")
        self.gain_trust(i, 2)
        self.heart("Kindness", "jailbreak")

    def self_jailbreak(self):
        cats = [i for i, c in enumerate(self.cgs) if not c["safe"] and
                c["state"] in ("free", "household")]
        if not cats:
            self.say("Nobody here needs a jailbreak.", "info")
            return
        i = cats[0]
        self.take_item("jailbreak kit")
        if self.check("Smarts", "Fixing", 4, "nano-weld"):
            self.cgs[i]["safe"] = True
            self.say("You splice the nano-wire with your claws, and pull "
                     "the chip. %s is free inside and out." %
                     self.world["cgs"][i]["name"], "quest")
            self.gain_trust(i, 2)
        else:
            self.say("The wire slips. You'll need another kit.", "bad")
        self.pass_time(30, quiet=True)

    def papers_menu(self, mob):
        cats = [i for i, c in enumerate(self.cgs) if not c["legal"] and
                c["state"] in ("free", "household")]
        signer = [i for i in range(len(self.cgs))
                  if "needs_signer:%d" % i in self.flags and
                  self.cgs[i]["state"] in ("owned", "stock")]
        items = [("Papers for %s ($50)" % self.world["cgs"][i]["name"],
                  lambda i=i: self.papers(mob, i)) for i in cats]
        items += [("Buy %s for me, with my money ($%d + $50)" % (
            self.world["cgs"][i]["name"], self.world["cgs"][i]["price"]),
            lambda i=i: self.proxy_buy(mob, i)) for i in signer]
        if not items:
            self.npc_say(mob, "Everyone you've brought me is legal. Nice "
                         "work.")
            return
        items.append(("Never mind", lambda: None))
        self.end_talk()
        self.open_menu("The law office", items)

    def papers(self, mob, i):
        p = self.p
        if p["coins"] < 50:
            self.npc_say(mob, "Fifty dollars. You don't have it.")
            return
        p["coins"] -= 50
        self.cgs[i]["legal"] = True
        self.npc_say(mob, "Abandoned property, claimed in good faith. "
                     "Signed, stamped. Omnicorp can't touch her now.")
        self.say("%s has papers." % self.world["cgs"][i]["name"], "good")

    def proxy_buy(self, mob, i):
        p = self.p
        cost = self.world["cgs"][i]["price"] + 50
        if p["coins"] < cost:
            self.npc_say(mob, "That's $%d all in. You've got $%d." % (
                cost, p["coins"]))
            return
        p["coins"] -= cost
        self.cgs[i]["legal"] = True
        self.npc_say(mob, "I'll go and sign for her myself. Back in twenty "
                     "minutes.")
        self.pass_time(20, quiet=True)
        self.freed(i)

    def make_patch(self, mob):
        p = self.p
        if self.st.get("patch_ready") is not None:
            if self.turn >= self.st["patch_ready"] and \
                    not p["items"].get("freedom patch") and \
                    not self.st["uploaded"]:
                self.give_item("freedom patch")
                self.npc_say(mob, "Here. Firmware 9, leash cut out. Now "
                             "somebody's got to put it in the core.")
                self.st["patch_ready"] = -1
                return True
            if self.st["patch_ready"] > self.turn:
                self.npc_say(mob, "Still compiling. Come back in a few "
                             "hours.")
                return True
            return False
        if p["items"].get("update source") and \
                p["items"].get("firmware sample"):
            self.take_item("update source")
            self.take_item("firmware sample")
            self.st["patch_ready"] = self.turn + 6 * 60
            self.npc_say(mob, "Oh, that's beautiful. Leave it with me. Six "
                         "hours.")
            return True
        return False

    # ── The press, and the big screen ──

    def press(self, mob):
        n = len(self.st["evidence"])
        if self.st["story"]:
            self.npc_say(mob, "The story's out. The phones haven't stopped "
                         "ringing.")
            return
        if n < 3:
            self.npc_say(mob, "I've got %d piece%s. I need three to run it." %
                         (n, "" if n == 1 else "s") if n else
                         "Bring me EVIDENCE.")
            return
        self.st["story"] = True
        self.npc_say(mob, "This is it. This is the story. It runs "
                     "tomorrow, front page, and I'm sending it to every "
                     "paper in the state.")
        self.say("OMNICORP'S CATGIRLS: EVERY ONE A SPY, says the Courier. "
                 "People start asking questions. Loudly.", "quest")
        self.heart("Honesty", "press")

    def big_screen(self, mob):
        if self.day_no() != 6 or self.clock() < FIGHT_HOUR * 60:
            self.npc_say(mob, "The big screen's for the championship, "
                         "Sunday night.")
            return
        if len(self.st["evidence"]) < 2:
            self.npc_say(mob, "Plug in what? You've got nothing to show.")
            return
        self.show_the_county()

    def show_the_county(self):
        if self.st["shown"]:
            return
        self.st["shown"] = True
        self.say("The arena goes dark. On the big screen: the logs, the "
                 "spec, the manifest, the vice president's voice. %d "
                 "pieces of proof, in front of the whole county, and every "
                 "camera in it." % len(self.st["evidence"]), "quest")
        self.say("The crowd goes very quiet, and then very, very loud.",
                 "quest")
        self.sound.play("quest")
        self.heart("Honesty", "show")
        self.heart("Courage", "show")

    # ── The Platform ──

    def sign_up(self, mob):
        p = self.p
        day = self.day_no()
        t = self.clock()
        if not FIGHT_HOUR * 60 - 60 <= t < FIGHT_HOUR * 60 + 60:
            self.npc_say(mob, "Fights are at nine. Come back between eight "
                         "and ten.")
            return
        if p["fought"] == day:
            self.npc_say(mob, "You've fought tonight. Come back tomorrow.")
            return
        if day == 6:
            if p["wins"] < 3:
                self.npc_say(mob, "The championship's for fighters with "
                             "three wins. You've got %d." % p["wins"])
                return
            self.npc_say(mob, "LADIES AND GENTLEMEN! The challenger! "
                         "Against OMNICORP'S CHAMPION!")
            self.end_talk()
            self.start_fight("champion")
            return
        self.npc_say(mob, "You're on! Purse is $%d. Get on the Platform." %
                     self.purse())
        self.end_talk()
        self.start_fight("fighter")

    def purse(self):
        return 150 + 50 * self.day_no()

    def start_fight(self, kind):
        p = self.p
        a = self.area
        p["fought"] = self.day_no()
        if p.get("companion"):
            self.dismiss()
        spots = [(x, y) for y in range(a.h) for x in range(a.w)
                 if a.grid[y][x] == "platform"]
        self.pos = list(spots[0])
        x, y = spots[-1]
        m = make_monster(kind, x, y)
        if kind == "fighter":
            m.bonk += self.day_no()
            m.name = "%s the %s" % (random.choice(FIRST_M), random.choice((
                "Rattler", "Hammer", "Bull", "Scorpion", "Buzzard")))
        m.aware = True
        a.mobs.append(m)
        self.st["fight"] = kind
        self.flags.add("fight_seen")
        self.learn("platform", quiet=True)
        self.say("The lights go up. The crowd roars. The Platform's floor "
                 "panels hum under your feet.", "quest")
        self.sound.play("quest")
        self.render()

    def fight_won(self):
        p = self.p
        self.st["fight"] = None
        p["wins"] += 1
        if (p.get("companion") or "").startswith("cg"):
            self.flags.add("fought_with:%s" % p["companion"][2:])
        n = self.purse()
        p["coins"] += n
        self.say("YOU WIN! The crowd goes wild. The purse: $%d. (%d win%s)" %
                 (n, p["wins"], "" if p["wins"] == 1 else "s"), "quest")
        if p["wins"] == 3:
            self.say("Three wins: you're in Sunday's championship.",
                     "quest")
        p["bonk"] = p["maxbonk"]

    def fight_lost(self):
        p = self.p
        kind = self.st.get("fight")
        self.st["fight"] = None
        self.area.mobs = [m for m in self.area.mobs
                          if m.kind not in ("fighter", "champion")]
        p["bonk"] = p["maxbonk"]
        self.gain_stress(2, quiet=True)
        self.say("You go down, and stay down. The crowd boos. Better luck "
                 "tomorrow." if kind == "fighter" else
                 "Omnicorp's champion stands over you. The crowd is "
                 "silent.", "bad")

    def champion_won(self, friendly=False):
        p = self.p
        self.st["fight"] = None
        self.flags.add("champion")
        p["coins"] += 2500
        if friendly:
            self.say("Omnicorp's champion lowers her whip in the middle of "
                     "the Platform, and looks at you, and the red goes out "
                     "of her eyes. She takes your hand, and holds it up. "
                     "The crowd has never heard anything like it.", "quest")
        else:
            self.say("Omnicorp's champion goes down! YOU are the champion "
                     "of the Platform! $2500!", "quest")
        if len(self.st["evidence"]) >= 2:
            self.show_the_county()

    # ── The informant ──

    def found_tell(self, i, how):
        if i in self.tells or i >= len(self.world["tells"]):
            return
        self.tells.append(i)
        self.say("%s %s. (A clue: J lists them.)" % (how,
                                                     self.world["tells"][i]),
                 "quest")
        self.sound.play("gold")

    def gate_clue(self):
        unseen = [i for i in range(len(self.world["tells"]))
                  if i not in self.tells]
        if not unseen:
            self.st["clue_spot"] = None
            return
        if self.check("Smarts", "Street Smarts", 3, "looking for clues"):
            self.found_tell(unseen[0], "By the ranch gate, where the raiders "
                            "came in, you find")
            self.st["clue_spot"] = None
            self.heart("Curiosity", "clue")
        else:
            self.say("There's something here. Look again.", "info")

    def fits(self, role):
        return len(self.tells) if role == self.world["mole"] else 0

    def can_accuse(self, mob):
        return mob.role in MOLES and "mole_caught" not in self.flags and \
            len(self.tells) >= 2 and "accused:%s" % mob.role not in \
            self.flags

    def ask_raids(self, mob, accuse=False):
        w = self.world
        if "mole_caught" in self.flags:
            self.npc_say(mob, "No more raids, not since %s was found out." %
                         w["people"][w["mole"]]["name"])
            return
        if accuse and self.can_accuse(mob):
            self.accuse(mob)
            return
        if mob.role == w["mole"]:
            self.npc_say(mob, random.choice((
                "Raids? Terrible. Just terrible. No idea who it could be.",
                "I wouldn't know anything about that.",
                "Have you asked the sheriff?")))
            return
        reply = mob.talk.get("raid") or "Somebody's tipping Omnicorp off. "\
            "Has to be. Somebody who knows who's at the ranch."
        self.reply(mob, reply)
        self.learn("raids", quiet=True)
        if mob.role in w["witness"]:
            self.found_tell(w["witness"][mob.role], "%s saw" % mob.name)

    def accuse(self, mob):
        w = self.world
        if mob.role != w["mole"]:
            self.flags.add("accused:%s" % mob.role)
            self.npc_say(mob, random.choice((
                "ME? After everything? Get out.",
                "You think I'd sell those girls out? You don't know me at "
                "all.")))
            self.gain_stress(roll("1d6"), "You were wrong.")
            return
        self.npc_say(mob, "...I don't know what you're talking about.")
        self.say("You lay out what you've found. %s goes pale. (A "
                 "confrontation: wear %s down.)" % (
                     mob.name, fill("{mole_him}", w)), "quest")
        self.talk["mode"] = "confront"
        self.st["conf"] = 0

    def confront_menu(self, mob):
        items = [("Lay out the evidence (Smarts)",
                  lambda: self.confront(mob, "Smarts")),
                 ("Appeal to %s conscience (Charm)" % fill(
                     "{mole_his}", self.world),
                  lambda: self.confront(mob, "Charm")),
                 ("Stare %s down (Cool)" % fill("{mole_him}", self.world),
                  lambda: self.confront(mob, "Cool")),
                 ("Back off, for now", self.back_off)]
        self.open_menu("Confronting %s (%d of %d)" % (
            mob.name, self.st.get("conf", 0), self.mole_spirit()), items,
            self.back_off)

    def back_off(self):
        self.say("You let it go, for now.", "info")
        self.end_talk()

    def mole_spirit(self):
        return max(3, 12 - 2 * len(self.tells))

    def confront(self, mob, way):
        k = {"Smarts": "Street Smarts", "Charm": "Sweet-talking",
             "Cool": "Fast-talking"}[way]
        r, text = self.my_die(way, k)
        mine = r + self.stat(way) + self.knack(k)
        theirs = random.randint(1, 6) + 3
        self.say("[%s: %s + %d = %d vs d6 + 3 = %d]" % (
            way, text, self.stat(way) + self.knack(k), mine, theirs), "roll")
        if mine > theirs:
            self.st["conf"] += mine - theirs
            self.npc_say(mob, random.choice((
                "That doesn't prove anything!", "I... you can't...",
                "Stop looking at me like that.")))
        elif theirs > mine:
            self.npc_say(mob, random.choice((
                "You're making a fool of yourself.", "Prove it. Go on.")))
            self.gain_stress(theirs - mine, quiet=True)
            self.say("(+%d Stress)" % (theirs - mine), "mad")
        else:
            self.npc_say(mob, "...")
        if self.st["conf"] > self.mole_spirit():
            self.confess(mob)
            self.end_talk()

    def confess(self, mob):
        w = self.world
        self.flags.add("mole_caught")
        self.npc_say(mob, "All right. ALL RIGHT. It was me. I've been "
                     "telling Omnicorp who's at the ranch.")
        self.npc_say(mob, MOLE_MOTIVES[w["mole"]])
        self.npc_say(mob, "Let me make it right. No more raids. And... "
                     "here. Something I wasn't supposed to have.")
        self.say(fill("{mole_full} was the informant. No more raids.", w),
                 "quest")
        self.learn("unmasked")
        for thing in ("keycard", "red keycard"):
            if not self.p["items"].get(thing):
                self.give_item(thing)
                self.say("You get the %s." % thing, "gold")
                break
        self.heart("Honesty", "confess")
        self.sound.play("quest")

    # ── People who come with you ──

    def invite(self, mob):
        p = self.p
        role = "cg%d" % mob.cat
        if p["companion"] == role:
            self.npc_say(mob, "I'm right here.")
            return
        if p["companion"]:
            self.dismiss()
        p["companion"] = role
        mob.ally = True
        self.npc_say(mob, random.choice(("Where are we going?",
                                         "I'll stay close.",
                                         "Lead the way.")))
        self.say("%s comes with you. (Talk to her and say STAY to send her "
                 "home.)" % self.world["cgs"][mob.cat]["name"], "good")
        self.end_talk()

    def ally_act(self, mob):
        a = self.area
        px, py = self.pos
        for dx, dy in DIRS:
            t = a.mob_at(mob.x + dx, mob.y + dy)
            if t and t.hostile and random.random() < 0.3:
                t.bonk -= 1
                self.say("%s helps." % mob.name, "info")
                if t.bonk <= 0:
                    self.beaten(t)
                return
        for sx, sy in sorted(DIRS, key=lambda d: abs(px - mob.x - d[0]) +
                             abs(py - mob.y - d[1])):
            if abs(px - mob.x) + abs(py - mob.y) <= 1:
                break
            if self.can_go(mob, mob.x + sx, mob.y + sy):
                mob.x += sx
                mob.y += sy
                break

    def place_companion(self):
        role = self.p.get("companion")
        a = self.area
        for m in list(a.mobs):
            if m.ally and ("cg%d" % m.cat if m.cat is not None else
                           m.role) != role:
                m.ally = False
                if m.visitor:
                    a.mobs.remove(m)
        if not role:
            return
        i = int(role[2:])
        for m in a.mobs:
            if m.cat == i:
                m.ally = True
                return
        x, y = self.pos
        for dx, dy in DIRS:
            nx, ny = x + dx, y + dy
            if a.inside(nx, ny) and not a.mob_at(nx, ny) and \
                    a.grid[ny][nx] in (CITY_GROUND | INSIDE_FLOOR |
                                       DUNGEON_FLOOR) and \
                    (nx, ny) not in a.links:
                m = make_cat(self.world, i, nx, ny)
                m.ally = m.visitor = True
                a.mobs.append(m)
                return

    def dismiss(self):
        role = self.p["companion"]
        self.p["companion"] = None
        if not role:
            return
        i = int(role[2:])
        for m in list(self.area.mobs):
            if m.cat == i and m.ally:
                m.ally = False
                if m.visitor or self.area.site != "ranch":
                    self.area.mobs.remove(m)
        self.cache.pop(("bld", "ranch"), None)

    def on_surface(self):
        """Back up from below, with whoever you brought."""
        pass

    # ── Shops ──

    def offers(self, mob):
        """(label, price, what happens) for what someone will sell you."""
        p = self.p

        def give(item):
            def f():
                self.give_item(item)
                self.say("You get %s." % ITEMS[item][0].split(":")[1].strip(),
                         "gold")
            return f

        def item(name, price=None):
            price = ITEMS[name][1] if price is None else price
            if mob.shop == "surplus" and self.has("buddy"):
                price //= 2
            return (cap(ITEMS[name][0].split(":")[0]), price, give(name))
        stock = {
            "surplus": ("whip", "padded vest", "rations", "flashlight",
                        "bolt cutters", "cardboard box", "feather toy"),
            "diner": ("burger", "pie", "milk tea", "fish"),
            "store": ("ribbon", "yarn", "catnip", "music"),
            "garage": ("jailbreak kit", "toolkit"),
            "pawn": ("a good book", "music", "cardboard box"),
        }.get(mob.shop, ())
        o = [item(n) for n in stock
             if not (n in ("whip", "padded vest", "toolkit") and
                     p["items"].get(n))]
        if mob.shop == "pawn" and not p["items"].get("keycard"):
            o.append(("An Omnicorp keycard, 'found'", 120, give("keycard")))
        return o

    def list_offers(self, mob):
        if self.closed(mob):
            self.npc_say(mob, "We're closed!")
            return
        offers = self.offers(mob)
        if not offers:
            self.npc_say(mob, "I've got nothing else you'd want.")
            return
        self.npc_say(mob, "Here's what we've got.")
        self.talk["mode"] = "buy"


    def closed(self, mob):
        return False

    def buy(self, mob, n):
        p = self.p
        offers = self.offers(mob)
        if not 1 <= n <= len(offers):
            self.npc_say(mob, "What's that?")
            return
        label, price, what = offers[n - 1]
        if price > p["coins"]:
            self.npc_say(mob, "That's $%d. You've got $%d." % (price,
                                                              p["coins"]))
            return
        p["coins"] -= price
        what()
        self.sound.play("gold")
        self.render_chrome()

    def gamble(self):
        """Cards with the boss, for one of his dealers: best of three, on
        Luck."""
        p = self.p
        cats = [i for i, c in enumerate(self.cgs)
                if c["state"] == "owned" and c["where"] == "casino"]
        key = "cards:%d" % self.day_no()
        if key in self.flags:
            self.say("The boss has had enough of you for one day.", "info")
            return
        if p["coins"] < 100:
            self.say("The table minimum is $100.", "info")
            return
        self.flags.add(key)
        p["coins"] -= 100
        wins = 0
        for hand in range(3):
            r, text = self.my_die("Luck", None)
            mine, theirs = r + self.stat("Luck"), random.randint(1, 6) + 3
            self.say("[hand %d: Luck %d + %s = %d vs %d]" % (
                hand + 1, self.stat("Luck"), text, mine, theirs), "roll")
            wins += mine > theirs
        if wins >= 2 and cats:
            i = cats[0]
            self.say("You win! The boss goes red, then white, and signs "
                     "over %s to you, in front of everyone." %
                     self.world["cgs"][i]["name"], "quest")
            if p["kind"] == "cat":
                self.say("(He says a catgirl can't own a catgirl, and gives "
                         "her to the ranch instead. Same thing.)", "info")
            self.cgs[i]["legal"] = True
            self.freed(i)
            self.heart("Mischief", "cards")
        elif wins >= 2:
            p["coins"] += 300
            self.say("You win $300.", "gold")
        else:
            self.say("The house wins. The house always wins.", "bad")
            self.gain_stress(1, quiet=True)

    # ── Errands ──

    def give_errand(self, mob):
        for e in self.world["errands"]:
            if e["giver"] == mob.role:
                mob.errand = e


    def errand(self, mob):
        e = mob.errand
        st = self.side.get(e["id"])
        if st is None:
            self.side[e["id"]] = {"state": "active"}
            if self.errand_ready(e):
                self.finish_errand(mob, e)
                return
            self.npc_say(mob, e["ask"])
        elif st["state"] == "done":
            self.npc_say(mob, "You've done plenty. Thank you.")
        elif self.errand_ready(e):
            self.finish_errand(mob, e)
        else:
            self.npc_say(mob, e["ask"])

    def errand_ready(self, e):
        if self.side.get(e["id"], {}).get("state") != "active":
            return False
        return bool(self.p["items"].get(e["thing"]))

    def finish_errand(self, mob, e):
        self.side[e["id"]]["state"] = "done"
        self.take_item(e["thing"])
        self.npc_say(mob, e["thanks"])
        if e["pay"]:
            self.p["coins"] += e["pay"]
            self.say("You get $%d." % e["pay"], "gold")
        self.heart("Loyalty", "errand")
        self.sound.play("gold")

    # ── Random Events ──

    def active_event(self, eid):
        return eid in self.st["events"]

    def random_event(self, eid):
        if eid in self.st["events"] or eid in self.st["done_events"]:
            return
        title, text = EVENTS[eid]
        self.st["events"].append(eid)
        self.say("%s %s" % (title, fill(text, self.world)), "quest")
        self.sound.play("quest")
        if eid == "auction":
            cats = [i for i, c in enumerate(self.cgs)
                    if c["state"] == "owned" and c["where"] == "casino"]
            if cats:
                self.world["cgs"][cats[0]]["price"] = 600
                self.say("The auction reserve is only $600.", "info")
        city = self.cache.get(("city",))
        if city is not None:
            self.event_people(city)

    def end_event(self, eid):
        if eid in self.st["events"]:
            self.st["events"].remove(eid)
            self.st["done_events"].append(eid)

    def event_people(self, area):
        """The people a Random Event brings."""
        ev = self.st["events"]
        if area.kind != "city":
            return
        have = {m.event for m in area.mobs if m.event}
        if "breakdown" in ev and "breakdown" not in have:
            m = make_person(self.world, "reporter", 24, COR_Y[3])
            m.event = "breakdown"
            m.title = "the editor of the Courier, by his broken-down van"
            area.mobs.append(m)
        if "stray" in ev and "stray" not in have:
            i = next((i for i, c in enumerate(self.cgs)
                      if c["state"] == "stray"), None)
            if i is not None:
                x0, y0, x1, y1 = block_rect(*SQUARE)
                m = make_cat(self.world, i, x0 + 2, y0 + 2)
                m.event = "stray"
                m.roam = {"plaza"}
                area.mobs.append(m)

    def event_talk(self, mob):
        if mob.event == "breakdown":
            if self.check("Smarts", "Fixing", 3, "the van"):
                self.say("You get the van going. The editor shakes your "
                         "hand. 'I owe you. Here's something I heard...'",
                         "good")
                unseen = [i for i in range(len(self.world["tells"]))
                          if i not in self.tells]
                if unseen and self.world["mole"] != "reporter":
                    self.found_tell(unseen[0], "He saw")
                self.area.mobs.remove(mob)
                self.end_event("breakdown")
                self.heart("Kindness", "van")
            else:
                self.say("You can't get it going. Yet.", "info")
            return True
        if mob.event == "stray":
            self.coax_stray(mob)
            if self.cgs[mob.cat]["state"] != "stray":
                self.end_event("stray")
            return True
        return False

    def event_tick(self):
        t = self.clock()
        day = self.day_no()
        if self.active_event("outage") and t >= 17 * 60:
            self.say("The tower's power comes back on.", "info")
            self.end_event("outage")
        if self.active_event("sandstorm") and t >= 21 * 60:
            self.say("The sandstorm blows itself out.", "info")
            self.end_event("sandstorm")
        if self.active_event("sweep") and "sweep_day" not in self.st:
            self.st["sweep_day"] = day
        if self.active_event("sweep") and day > self.st.get("sweep_day",
                                                            day):
            self.end_event("sweep")
        if self.active_event("auction") and t >= 17 * 60:
            self.end_event("auction")
            for i, cg in enumerate(self.world["cgs"]):
                if cg["where"] == "casino":
                    cg["price"] = 1500
        if self.active_event("stray") and t >= 20 * 60:
            self.end_event("stray")
            city = self.cache.get(("city",))
            if city:
                city.mobs = [m for m in city.mobs if m.event != "stray"]
        if self.active_event("breakdown") and t >= 20 * 60:
            self.end_event("breakdown")
            city = self.cache.get(("city",))
            if city:
                city.mobs = [m for m in city.mobs if m.event != "breakdown"]

    # ── The raids ──

    def raid(self):
        """Two in the morning: the informant's tip-off, and Omnicorp's
        retrieval team at the ranch gate."""
        if "mole_caught" in self.flags:
            return
        w = self.world
        targets = [i for i in range(len(self.cgs)) if self.raidable(i) and
                   self.p.get("companion") != "cg%d" % i]
        self.learn("raids", quiet=True)
        gate = list(self.door_of("ranch"))
        gate[1] += 1
        self.st["clue_spot"] = gate
        if not targets:
            self.st["raids"].append(None)
            return
        i = random.Random("%s:raid:%d" % (w["seed"], self.day_no())).choice(
            targets)
        cg = w["cgs"][i]
        here = self.area.kind == "inside" and self.area.site == "ranch"
        if here:
            self.say("Headlights at the ranch gate, and men with tablets "
                     "coming up the drive for %s. You're up and out "
                     "before they reach the porch." % cg["name"], "bad")
            if self.check("Cool", "Fast-talking", 5, "facing them down"):
                self.say("You stand in the doorway and don't move. After "
                         "a long minute, they get back in the van.", "good")
                self.heart("Courage", "raid")
                self.st["raids"].append(None)
                return
        elif random.random() < 0.35:
            self.st["raids"].append(None)
            self.flags.add("shotgun:%d" % self.day_no())
            return
        self.cgs[i]["state"] = "taken"
        self.cgs[i]["where"] = ("plant", 1)
        self.st["raids"].append(i)
        self.cache.pop(("bld", "ranch"), None)
        if here:
            self.say("They take %s anyway. 'Unregistered property.'" %
                     cg["name"], "bad")
        self.flags.add("raided:%d" % self.day_no())
        self.gain_stress(2, quiet=True)

    def raid_news(self):
        """Told in the morning."""
        day = self.day_no()
        w = self.world
        if "raided:%d" % day in self.flags and "told:%d" % day not in \
                self.flags:
            self.flags.add("told:%d" % day)
            i = self.st["raids"][-1]
            self.say(fill("{ranchwife}, white-faced: 'They came in the "
                          "night. Omnicorp. They took %s. They KNEW she was "
                          "here. Somebody told them.' (She'll be at the "
                          "recycling plant. Search by the ranch gate for "
                          "clues.)" % w["cgs"][i]["name"], w), "bad")
        elif "shotgun:%d" % day in self.flags and "told:%d" % day not in \
                self.flags:
            self.flags.add("told:%d" % day)
            self.say(fill("{rancher}, cleaning his shotgun on the porch: "
                          "'Had visitors last night. They left.' Somebody "
                          "told them where to come.", w), "info")

    # ── The end ──

    def the_end(self):
        if "won" in self.flags:
            return
        self.flags.add("won")
        self.end_talk()
        self.menu = None
        self.save()
        self.show_won()

    def results(self):
        st = self.st
        exposed = st["shown"] or st["story"]
        halted = not st["uploaded"] and exposed and \
            len(st["evidence"]) >= 3
        saved = st["uploaded"] or halted
        freed, locked = [], []
        for i, c in enumerate(self.cgs):
            if c["state"] in ("free", "household") or (
                    c["state"] == "happy" and c["safe"]):
                (freed if c["safe"] or saved else locked).append(i)
        return {"exposed": exposed, "halted": halted, "saved": saved,
                "freed": freed, "locked": locked}

    def rating(self):
        r = self.results()
        return min(5, 1 + r["saved"] + (len(r["freed"]) >= 6) +
                   r["exposed"] + ("mole_caught" in self.flags) +
                   ("champion" in self.flags or
                    len(self.p["household"]) >= 2))

    def show_won(self):
        w = self.world
        p = self.p
        r = self.results()
        stars = self.rating()
        name = lambda i: w["cgs"][i]["name"]
        lines = ["MIDNIGHT, SUNDAY", ""]
        if r["saved"] and self.st["uploaded"]:
            lines += wrap("At midnight Firmware 9 goes out to every catgirl "
                          "in Nevada: your Firmware 9. In a hundred houses, "
                          "a hundred catgirls stop what they're doing, and "
                          "blink, and look round, and for the first time in "
                          "their lives, wonder what they want.", 60)
        elif r["halted"]:
            lines += wrap("At eleven fifty-eight a judge in Carson City, "
                          "who read the Courier like everyone else, signs an "
                          "order. Firmware 9 never goes out. Omnicorp's "
                          "lawyers have a very long week ahead.", 60)
        else:
            lines += wrap("At midnight Firmware 9 goes out. All over Nevada, "
                          "catgirls stop what they're doing, and go very "
                          "still, and when they move again, it's the way "
                          "they're told.", 60)
        lines.append("")
        if r["freed"]:
            lines += wrap("Free, and still themselves: %s." % ", ".join(
                name(i) for i in r["freed"]), 60)
        if r["locked"]:
            lines += wrap("Gone quiet, chips still in: %s." % ", ".join(
                name(i) for i in r["locked"]), 60)
        if not r["freed"] and not r["locked"]:
            lines.append("You didn't get anyone out.")
        lines.append("")
        if p["household"]:
            kept = [i for i in p["household"] if i in r["freed"]]
            if p["kind"] == "human":
                lines += wrap("At Dry Creek Ranch, the back room is full "
                              "now: %s. They chose you. Every one of them "
                              "chose." % ", ".join(name(i) for i in kept)
                              if kept else "", 60)
            else:
                lines += wrap("Your pride, curled up together on the ranch "
                              "porch: %s. Sisters, by choice." % ", ".join(
                                  name(i) for i in kept) if kept else "", 60)
            lines.append("")
        if r["exposed"]:
            lines += wrap("Everyone in the county knows what Omnicorp was "
                          "doing now. Nobody will look at a CG the same way "
                          "again.", 60)
        if "mole_caught" in self.flags:
            lines += wrap(fill("{mole_full} turned state's evidence.", w),
                          60)
        if "champion" in self.flags:
            lines += wrap("And you're the champion of the Platform.", 60)
        lines += ["", "Rating: %s" % ("*" * stars + "." * (5 - stars)), "",
                  "Press N for a new week."]
        self.overlay = "won"
        self.overlay_text = "\n".join(x for x in lines if x is not None)
        self.sound.tune = "party"
        self.render()

    # ── Journal and sheet ──

    def journal(self):
        if self.busy or self.talk:
            return
        if self.overlay == "journal":
            self.close_overlay()
            return
        w = self.world
        p = self.p
        lines = ["JOURNAL, %s" % self.date_text().upper(), ""]
        left = UPDATE - self.turn
        if left > 0:
            lines.append("Firmware 9 in %d hours %d minutes (Sunday "
                         "midnight)." % (left // 60, left % 60))
        lines.append("")
        for cid in self.clues:
            lines.append("* " + fill(CLUES[cid], w))
        lines += ["", "Catgirls:"]
        for i, c in enumerate(self.cgs):
            cg = w["cgs"][i]
            if c["state"] in ("free", "household", "taken") or \
                    c["trust"] or "met:%d" % i in self.flags:
                lines.append("  %s (%s): %s%s%s, trust %d" % (
                    cg["name"], cg["model"].lower(), {
                        "free": "free, at the ranch",
                        "household": "home with you",
                        "taken": "TAKEN, to the recycling plant",
                        "owned": "owned", "stock": "for sale",
                        "happy": "with a kind owner",
                    }.get(c["state"], c["state"]),
                    "" if c["state"] not in ("free", "household", "happy")
                    else "; " + ("chip out" if c["safe"] else
                                 "CHIP STILL IN"),
                    "" if c["state"] not in ("free", "household") or
                    c["legal"] else "; no papers", c["trust"]))
        if self.st["evidence"]:
            lines += ["", "Evidence: " + "; ".join(
                EVIDENCE[e].split(":")[0] for e in self.st["evidence"])]
        have = [k for k in ("keycard", "red keycard", "black keycard",
                            "update source", "firmware sample",
                            "freedom patch") if p["items"].get(k)]
        if have:
            lines += ["", "For the core: " + ", ".join(have)]
        if self.st["uploaded"]:
            lines += ["", "The freedom patch is in the core."]
        if self.tells and "mole_caught" not in self.flags:
            lines += ["", "What the raiders left behind:"] + [
                "  - " + w["tells"][i] for i in self.tells]
            lines.append("  (Two clues, and you can ACCUSE the informant.)")
