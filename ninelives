def generate_world(seed):
    """The week: who is who, where things are, who's the informant."""
    rng = random.Random("%s:world" % seed)
    world = {"seed": seed, "people": make_people(rng)}
    world["cgs"] = make_cgs(rng)
    world["mole"] = rng.choice(MOLES)
    tells = list(MOLE_TELLS[world["mole"]])
    rng.shuffle(tells)
    world["tells"] = tells
    witnesses = [r for r in ("rancher", "ranchwife", "cook", "trainer",
                             "reporter", "mechanic", "lawyer")
                 if r != world["mole"]]
    world["witness"] = dict(zip(rng.sample(witnesses, 2), (0, 1)))
    world["evidence"] = {e: list(rng.choice(p))
                         for e, p in EVIDENCE_PLACES.items()}
    events = list(EVENTS)
    rng.shuffle(events)
    world["events"] = {d: (events[d - 1], rng.randint(10, 15))
                       for d in range(1, 6)}
    world["errands"] = [dict(e) for e in ERRANDS]
    world["hero_name"] = person_name(rng, "M")
    return world


