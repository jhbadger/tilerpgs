# Things on the floor: their tile, and what stepping on them gives.
FLOOR_ITEMS = {"folder", "keycard", "chest", "coins", "box"}

def grass(rng, base="#5a9a4a"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.12), shade(base, 0.88), "#6aaa52"], 0.4)
    for _ in range(5):
        x, y = rng.randrange(16), rng.randrange(1, 16)
        g[y][x] = g[y - 1][x] = shade(base, 1.25)
    return g


def boarding(rng, base="#9a6a3a", seam="#6a4420", width=4):
    """Floorboards, running across."""
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.07), shade(base, 0.93)], 0.3)
    for y in range(0, 16, width):
        rect(g, 0, y, 15, y, seam)
        x = rng.randrange(16)
        rect(g, x, y + 1, x, y + width - 1, seam)
    return g


def bricks(rng, base="#8a4a3a", mortar="#4a2a20"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.1), shade(base, 0.88)], 0.3)
    for y in range(0, 16, 4):
        rect(g, 0, y, 15, y, mortar)
        off = 0 if y % 8 == 0 else 4
        for x in range(off, 16, 8):
            rect(g, x, y, x, y + 3, mortar)
    return g


def flags(rng, base="#8a8478", seam="#5a564e"):
    """Flagstones."""
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.08), shade(base, 0.92)], 0.35)
    for y in (0, 7):
        rect(g, 0, y, 15, y, seam)
    for x, y0, y1 in ((5, 0, 7), (11, 7, 15), (0, 0, 15)):
        rect(g, x, y0, x, y1, seam)
    return g


def papered(rng, base, stripe, dado="#5a3a2a"):
    """A papered wall, striped, with a wooden dado below."""
    g = grid_of(base)
    for x in range(0, 16, 4):
        rect(g, x, 0, x, 10, stripe)
    rect(g, 0, 11, 15, 15, dado)
    rect(g, 0, 11, 15, 11, shade(dado, 1.4))
    speckle(g, rng, [shade(base, 0.96)], 0.05)
    return g


def concrete(rng, base="#a8a49c"):
    g = grid_of(base)
    speckle(g, rng, [shade(base, 1.06), shade(base, 0.92)], 0.35)
    return g


def draw_terrain(name, frame=0):
    """The pixels of a terrain tile (a list of 16 rows of colours)."""
    rng = random.Random(name + str(frame))
    # ── the town ──
    if name == "road":
        g = concrete(rng, "#4a4a50")
        return g
    if name == "crossing":
        g = concrete(rng, "#4a4a50")
        for x in range(0, 16, 4):
            rect(g, x, 0, x + 1, 15, "#e8e8e0")
        return g
    if name == "sidewalk":
        g = concrete(rng, "#b8b4ac")
        rect(g, 0, 7, 15, 7, "#9a968e")
        rect(g, 7, 0, 7, 15, "#9a968e")
        return g
    if name == "plaza":
        g = concrete(rng, "#c8bca8")
        for y in range(0, 16, 8):
            rect(g, 0, y, 15, y, "#a89c88")
        return g
    if name == "sand":
        g = grid_of("#d8b07a")
        speckle(g, rng, ["#c8a06a", "#e4c08a", "#b8905a"], 0.45)
        return g
    if name == "scrub":
        g = draw_terrain("sand")
        for _ in range(3):
            x, y = rng.randrange(2, 14), rng.randrange(4, 14)
            for dx, dy in ((0, 0), (-1, -1), (1, -1), (0, -2), (-2, -2),
                           (2, -2)):
                if 0 <= x + dx < 16 and 0 <= y + dy < 16:
                    g[y + dy][x + dx] = rng.choice(("#7a8a4a", "#5a6a3a"))
        return g
    if name == "lot":
        g = grid_of("#8a8478")
        speckle(g, rng, ["#7a746a", "#9a9488", "#6a645a"], 0.6)
        return g
    if name == "rail":
        g = draw_terrain("lot")
        for y in (2, 6, 10, 14):
            rect(g, 0, y, 15, y + 1, "#6a4a2a")
        rect(g, 4, 0, 4, 15, "#9a9aa0")
        rect(g, 11, 0, 11, 15, "#9a9aa0")
        return g
    if name == "lamp":
        g = draw_terrain("sidewalk")
        rect(g, 7, 4, 8, 15, "#3a3a3a")
        rect(g, 4, 1, 11, 4, "#f8e8a0" if frame else "#f0d070")
        return g
    if name == "cactus":
        g = draw_terrain("sand")
        rect(g, 6, 2, 9, 15, "#3a8a3a")
        rect(g, 2, 6, 3, 10, "#3a8a3a")
        rect(g, 2, 10, 6, 11, "#3a8a3a")
        rect(g, 12, 4, 13, 8, "#3a8a3a")
        rect(g, 9, 8, 13, 9, "#3a8a3a")
        rect(g, 7, 2, 7, 15, "#5aaa5a")
        return g
    if name == "mesa":
        g = grid_of("#a0502a")
        speckle(g, rng, ["#b0603a", "#8a4020", "#c07040"], 0.5)
        for y in range(2, 16, 5):
            rect(g, 0, y, 15, y, "#7a3a1a")
        return g
    if name == "brick":
        return bricks(rng, "#9a4a32", "#5a2a1a")
    if name == "adobe":
        g = grid_of("#d8a878")
        speckle(g, rng, ["#c89868", "#e4b888"], 0.3)
        rect(g, 0, 14, 15, 15, "#a87848")
        return g
    if name == "steel":
        g = grid_of("#8a9098")
        for x in range(0, 16, 3):
            rect(g, x, 0, x, 15, "#6a7078")
        return g
    if name == "glass":
        g = grid_of("#3a5a7a")
        for x in range(0, 16, 8):
            rect(g, x, 0, x, 15, "#c0c8d0")
        for y in range(0, 16, 8):
            rect(g, 0, y, 15, y, "#c0c8d0")
        rect(g, 2, 2, 4, 3, "#8ab0d0" if frame else "#6a90b0")
        return g
    if name == "fence":
        g = draw_terrain("sand")
        for y in range(16):
            for x in range(16):
                if (x + y) % 4 == 0 or (x - y) % 4 == 0:
                    g[y][x] = "#9a9aa0"
        return g
    if name == "gate":
        g = draw_terrain("lot")
        for y in range(16):
            for x in range(16):
                if ((x + y) % 4 == 0 or (x - y) % 4 == 0) and 2 < x < 13:
                    g[y][x] = "#c0c0c8"
        return g
    if name == "silo":
        g = grid_of("#c0c4c8")
        for x in range(0, 16, 4):
            rect(g, x, 0, x, 15, "#9a9ea2")
        return g
    if name == "tank":
        g = grid_of("#3a6a9a")
        for y in range(16):
            for x in range(16):
                if (x + y * 2 + frame) % 7 == 0:
                    g[y][x] = "#6a9ac8"
        return g
    if name == "sign":
        g = grid_of("#1a1a24")
        rect(g, 1, 4, 14, 11, "#f040a0" if frame else "#c02080")
        rect(g, 3, 6, 12, 9, "#ffd0f0")
        return g
    if name == "door":
        g = draw_terrain("adobe")
        rect(g, 3, 1, 12, 15, "#5a3a1a")
        rect(g, 4, 2, 11, 7, "#7a4a22")
        rect(g, 10, 9, 10, 9, "#e0c040")
        return g
    # ── indoors ──
    if name == "floor":
        return boarding(rng)
    if name == "boards":
        return boarding(rng, "#8a6a42", "#5a4228", 5)
    if name == "tiles":
        g = grid_of("#e8e4dc")
        for y in range(16):
            for x in range(16):
                if (x // 4 + y // 4) % 2:
                    g[y][x] = "#c03a3a"
        return g
    if name == "carpet":
        g = grid_of("#7a2a3a")
        speckle(g, rng, ["#8a3a4a", "#6a2030"], 0.3)
        return g
    if name == "mat":
        g = grid_of("#3a5a8a")
        rect(g, 0, 0, 15, 0, "#e8e8e8")
        rect(g, 0, 15, 15, 15, "#e8e8e8")
        return g
    if name == "wall":
        return papered(rng, "#d8c8a8", "#c8b494", "#6a4a2a")
    if name == "exit":
        g = boarding(rng)
        rect(g, 4, 6, 11, 15, "#3a2a1a")
        rect(g, 5, 6, 10, 6, "#f0e0a0")
        return g
    if name in ("bed", "table", "counter", "desk", "shelf", "stove",
