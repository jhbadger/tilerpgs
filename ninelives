def all_tiles():
    """name -> pixel rows, for every tile and animation frame."""
    tiles = {}
    for name in TERRAIN:
        tiles[name] = draw_terrain(name)
        if name in ANIMATED_TERRAIN:
            tiles[name + "@1"] = draw_terrain(name, 1)
    sprites = {}
    for name, (shape, pal) in PEOPLE.items():
        sprites[name] = art_pixels(pal, PERSON_SHAPES[shape])
    for name, (pal, rows) in ART.items():
        sprites[name] = art_pixels(pal, rows)
    sprites["secbot"] = art_pixels(*cat_art({"fur": "Silver", "eyes": "blue",
                                             "model": "Bodyguard"},
                                            red=True))
    sprites["champion"] = art_pixels(*cat_art({"fur": "Black",
                                               "eyes": "gold",
                                               "model": "Bodyguard"},
                                              red=True))
    still = {"hit", "heart", "sparkle", "puff", "zzz"} | FLOOR_ITEMS
    for name, px in sprites.items():
        tiles[name] = px
        SPRITES.add(name)
        if name in still:
            continue
        tiles[name + "@1"] = px[1:] + [[None] * 16]     # a bob: up a pixel
    return tiles

