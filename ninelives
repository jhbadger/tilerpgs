def pack_bits(b):
    return base64.b64encode(zlib.compress(bytes(b))).decode()


def unpack_bits(s, n):
    b = bytearray(zlib.decompress(base64.b64decode(s)))
    if len(b) != n:
        raise ValueError("bad map")
    return b

