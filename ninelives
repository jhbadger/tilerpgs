    @staticmethod
    def roll_hero(rng=random):
        """Stats, rolled on a die each, and a catgirl's lot."""
        return {"stats": {s: rng.randint(1, 6) for s in STATS},
                "perk": rng.randrange(len(HUMAN_PERKS)),
                "defect": rng.randrange(len(DEFECTS)),
                "abilities": [rng.randrange(6) for _ in range(3)],
                "fur": rng.choice(sorted(FUR)),
                "eyes": rng.choice(sorted(EYES)),
                "model": rng.choice(sorted(MODELS)),
                "skin": rng.randrange(5),
                "hair": rng.choice(HAIRSTYLES)}

    @staticmethod
    def make_hero(who):
        """The hero, from what the creation dialog chose."""
        r = who["rolled"]
        kind = who["kind"]
        stats = dict(r["stats"])
        knacks = []
        p = {"name": who["name"], "kind": kind, "heart": who["heart"],
             "stress": 0, "purr": 2, "coins": 200, "items": {},
             "companion": None, "used": {}, "edge": 0, "out": 0, "held": 0,
             "wins": 0, "fought": -1, "household": [], "exploding": None,
             "bonked": 0, "perk": None, "abilities": [], "defect": None,
             "look": None, "temp_knack": None}
        if kind == "human":
            bg = who["background"]
            _, knacks, mods = BACKGROUNDS[bg]
            knacks = [k for k in knacks if k in KNACKS]
            for s, n in mods.items():
                stats[s] = min(6, stats[s] + n)
            p["background"] = bg
            p["perk"] = HUMAN_PERKS[r["perk"]][0]
            if p["perk"] == "pocket":
                p["coins"] = 600
        else:
            model = r["model"]
            mods, knacks, _ = MODELS[model]
            for s, n in mods.items():
                stats[s] = min(6, stats[s] + n)
            knacks = list(knacks)
            p["model"] = model
            p["defect"] = r["defect"]
            p["abilities"] = [ABILITIES[t][r["abilities"][n]][0]
                              for n, t in enumerate(("Instinct", "Firmware",
                                                     "Quirk"))]
            p["look"] = {"fur": r["fur"], "eyes": r["eyes"], "model": model,
                         "skin": r["skin"], "hair": r.get("hair", "bob")}
            if DEFECTS[r["defect"]][0] == "Backflow":
                knacks.append("Hacking")
        p["stats"] = stats
        p["knacks"] = sorted(set(knacks))
        p["maxbonk"] = 4 + stats["Bod"] + stats["Cool"] + (
            4 if p["perk"] == "hard_head" else 0)
        p["bonk"] = p["maxbonk"]
        return p

    def tapped(self, ev):
        """A tap on the map, unless it's the tail of one on a dialog that
        just closed (on Android it can land on the map behind), or there's
        no game yet."""
        if time.time() < getattr(self, "tap_guard", 0) or \
                not getattr(self, "area", None):
            return
        self.on_tap(ev)

    def open_dialog(self):
        """Whether a dialog can open now (only one at a time)."""
        dlg = getattr(self, "dialog", None)
        try:
            if dlg is not None and dlg.winfo_exists():
                dlg.lift()
                return False
        except tk.TclError:
            pass
        return True

    def close_dialog(self, dlg=None):
        dlg = dlg or getattr(self, "dialog", None)
        if dlg is not None:
            try:
                dlg.destroy()
            except tk.TclError:
                pass
        if dlg is getattr(self, "dialog", None):
            self.dialog = None
        # a tap on a dialog button can land on the map behind it
        self.tap_guard = time.time() + 0.6

    def grab(self, dlg):
        try:
            dlg.grab_set()
        except tk.TclError:
            pass

