def block_rect(i, j, half=None):
    x0, x1 = COR_X[i] + 2, COR_X[i + 1] - 2
    y0, y1 = COR_Y[j] + 2, COR_Y[j + 1] - 2
    if half == "L":
        x1 = x0 + 4
    elif half == "R":
        x0 = x1 - 4
    return x0, y0, x1, y1


def district(x, y):
    """Where in town a square is."""
    for cy, name in STREETS.items():
        if abs(y - cy) <= 1 and COR_X[0] - 1 <= x <= COR_X[-1] + 1:
            near = min(COR_X, key=lambda c: abs(c - x))
            return name + (" at %s Avenue" % AVENUES[near]
                           if abs(near - x) <= 1 else "")
    for cx, name in AVENUES.items():
        if abs(x - cx) <= 1 and COR_Y[0] - 1 <= y <= COR_Y[-1] + 1:
            return name + " Avenue"
    x0, y0, x1, y1 = block_rect(*SQUARE)
    if x0 <= x <= x1 and y0 <= y <= y1:
        return "the town square"
    if not (COR_X[0] <= x <= COR_X[-1] and COR_Y[0] <= y <= COR_Y[-1]):
        return "the desert at the edge of town"
    return "a back lot"


def make_city(world, flags):
    """Copper Springs: the same every game but for what's been done."""
    rng = random.Random("copper springs")
    W, H = CITY_W, CITY_H
    g = [[("sand" if rng.random() < 0.8 else "scrub") for _ in range(W)]
         for _ in range(H)]
    area = Area("city", ("city",), g, "Copper Springs", edge="sand")
    for x in range(W):              # the railroad
        g[1][x] = "rail"
        g[2][x] = "lot"
    for y in range(H):
        for x in range(W):
            if (x < 2 or x >= W - 2 or y >= H - 2) and rng.random() < 0.35:
                g[y][x] = rng.choice(("mesa", "cactus", "scrub"))
    for j in range(3):
        for i in range(4):
            x0, y0, x1, y1 = block_rect(i, j)
            for y in range(y0 - 1, y1 + 2):
                for x in range(x0 - 1, x1 + 2):
                    g[y][x] = "lot"
    for y in COR_Y:                     # the streets: road, sidewalks
        for x in range(COR_X[0] - 1, COR_X[-1] + 2):
            g[y][x] = "road"
            for dy in (-1, 1):
                if g[y + dy][x] != "road":
                    g[y + dy][x] = "sidewalk"
    for x in COR_X:
        for y in range(COR_Y[0] - 1, COR_Y[-1] + 2):
            g[y][x] = "road"
            for dx in (-1, 1):
                if g[y][x + dx] != "road":
                    g[y][x + dx] = "sidewalk"
    for x in COR_X:
        for y in COR_Y:
            g[y][x] = "crossing"
    for y in range(COR_Y[0] - 1, COR_Y[-1] + 2, 4):     # streetlamps
        for x in (COR_X[0] - 1, COR_X[-1] + 1):
            if g[y][x] == "sidewalk":
                g[y][x] = "lamp"
    for x in range(COR_X[0] + 3, COR_X[-1], 5):
        for y in (COR_Y[1] - 1, COR_Y[1] + 1):
            if g[y][x] == "sidewalk":
                g[y][x] = "lamp"
    # the town square
    x0, y0, x1, y1 = block_rect(*SQUARE)
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = "plaza"
    for x, y in ((x0 + 1, y0 + 1), (x1 - 1, y0 + 1), (x0 + 1, y1 - 1),
                 (x1 - 1, y1 - 1)):
        g[y][x] = "lamp"
    g[(y0 + y1) // 2][(x0 + x1) // 2] = "tank"
    area.labels[((x0 + x1) // 2, (y0 + y1) // 2)] = "the town square"
    # the places
    for sid, (name, kind, (i, j, half), look) in SITES.items():
        bx0, by0, bx1, by1 = block_rect(i, j, half)
        for y in range(by0, by1 + 1):
            for x in range(bx0, bx1 + 1):
                g[y][x] = look
        if sid in ("casino", "arena", "store"):
            g[by0][(bx0 + bx1) // 2] = "sign"
        door = ((bx0 + bx1 + 1) // 2, by1)
        g[door[1]][door[0]] = "door"
        area.links[door] = ("bld", sid)
        area.labels[door] = name
    # the ranch: fenced, with a stock tank and the barn
    bx0, by0, bx1, by1 = block_rect(3, 2)
    for x in range(bx0 - 1, bx1 + 2):
        g[by0 - 1][x] = "fence"
    for y in range(by0 - 1, by1 + 2):
        g[y][bx0 - 1] = g[y][bx1 + 1] = "fence"
    g[by1 + 1][(bx0 + bx1 + 1) // 2 + 1] = "gate"
    for x in range(bx0 - 1, bx1 + 2):
        if g[by1 + 1][x] not in ("gate",):
            g[by1 + 1][x] = "fence"
    g[by1 + 1][(bx0 + bx1 + 1) // 2] = "lot"
    # the old mine
    x0, y0, x1, y1 = block_rect(2, 2)
    for y in range(y0, y1 + 1):
        for x in range(x0, x1 + 1):
            g[y][x] = "scrub" if (x + y) % 3 else "lot"
    for x, y in ((x0, y0), (x1, y0), (x0 + 2, y1)):
        g[y][x] = "silo"
    g[SHAFT[1]][SHAFT[0]] = "stairs_down"
    area.links[SHAFT] = ("lead", "mine")
    area.labels[SHAFT] = "the old copper mine"
    area.start = (COR_X[3] + 1, COR_Y[2] + 1)
    return area


