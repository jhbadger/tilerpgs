def make_interior(world, sid, flags):
    name, kind, _, _ = SITES[sid]
    floor, rows, cast = ROOMS[kind]
    g, spots, cat_spots = [], {}, []
    for y, row in enumerate(rows):
        line = []
        for x, ch in enumerate(row):
            if ch.isdigit():
                spots[cast[ch]] = (x, y)
                line.append(floor)
            elif ch == "x":
                cat_spots.append((x, y))
                line.append(floor)
            else:
                line.append(ROOM_TILES.get(ch, floor))
        g.append(line)
    area = Area("inside", ("bld", sid), g, name, edge=None)
    area.site = sid
    area.cat_spots = cat_spots
    for y, row in enumerate(rows):
        for x, ch in enumerate(row):
            if ch == "+":
                area.start = (x, y - 1)
            elif ch == "u":
                area.links[(x, y)] = ("lead", LIFT_LEADS[sid])
    for role, (x, y) in spots.items():
        if role in world["people"]:
            area.mobs.append(make_person(world, role, x, y))
    return area


