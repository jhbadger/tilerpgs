        talk["news"] = "The night they took one of the girls from the "\
            "ranch, I went out to the gate after. There was %s. Make of it "\
            "what you will." % world["tells"][n]
    return talk, greet


def blank(w, h, tile):
    return [[tile] * w for _ in range(h)]


def make_dungeon(world, lid, level, flags):
    """One level below or above: rooms and passages, its troublemakers and
    its things, the same each time it is made (but for what's been done)."""
    info = LEADS[lid]
    rng = random.Random("%s:%s:%d" % (world["seed"], lid, level))
    W, H = 36, 26
    last = level == info.levels
    for attempt in range(80):
        g = blank(W, H, "dwall")
        rooms = []
        want = rng.randint(6, 8)
        for _ in range(400):
            if len(rooms) >= want:
                break
            w, h = rng.randint(4, 8), rng.randint(3, 6)
            if last and len(rooms) == want - 1:
                w, h = 8, 5
            x, y = rng.randint(1, W - w - 1), rng.randint(1, H - h - 1)
            if any(x <= r[2] + 2 and r[0] <= x + w + 1 and
                   y <= r[3] + 2 and r[1] <= y + h + 1 for r in rooms):
                continue
            rooms.append((x, y, x + w - 1, y + h - 1))
        if len(rooms) < 5:
            continue
        rooms.sort(key=lambda r: r[0] + r[2] + rng.random())
        centers = [((r[0] + r[2]) // 2, (r[1] + r[3]) // 2) for r in rooms]

        def carve(a, b):
            (ax, ay), (bx, by) = a, b
            if rng.random() < 0.5:
                pts = [(x, ay) for x in range(min(ax, bx), max(ax, bx) + 1)]
                pts += [(bx, y) for y in range(min(ay, by), max(ay, by) + 1)]
            else:
                pts = [(ax, y) for y in range(min(ay, by), max(ay, by) + 1)]
                pts += [(x, by) for x in range(min(ax, bx), max(ax, bx) + 1)]
            for x, y in pts:
                g[y][x] = "dfloor"
        for r in rooms:
            for y in range(r[1], r[3] + 1):
                for x in range(r[0], r[2] + 1):
                    g[y][x] = "dfloor"
        for a, b in zip(centers, centers[1:]):
            carve(a, b)
        for _ in range(2):
            i, j = sorted(rng.sample(range(len(rooms) - 1), 2))
            carve(centers[i], centers[j])
        break
    end = rooms[-1]
    theme = THEMES[lid][level]
    name = LEVEL_NAMES[(lid, level)]
    area = Area("dungeon", ("dun", lid, level), g, "%s: %s" % (
        cap(info.name), name), dark=info.dark)
    area.skin = {"dwall": "dwall_" + theme, "dfloor": "dfloor_" + theme}
    area.lead = lid
    sx, sy = centers[0]
    g[sy][sx] = "stairs_up"
    area.start = (sx, sy)
    ex, ey = centers[-1]
    floor_spots = [(x, y) for y in range(H) for x in range(W)
                   if g[y][x] == "dfloor"]
    end_cells = {(x, y) for x in range(end[0], end[2] + 1)
                 for y in range(end[1], end[3] + 1)}

    def free(n, far=6, within=None):
        spots = [p for p in (within or floor_spots)
                 if g[p[1]][p[0]] == "dfloor" and p not in area.items
                 and abs(p[0] - sx) + abs(p[1] - sy) >= far
                 and not area.mob_at(*p) and p not in area.bodies
                 and p not in area.terminals]
        return rng.sample(spots, min(n, len(spots)))

    if not last:
        g[ey][ex] = "stairs_down"
        area.down = (ex, ey)
    if last and info.boss and "beat:%s" % lid not in flags:
        area.mobs.append(make_monster(info.boss, ex, ey, boss=True))
    inner = [(x, y) for r in rooms[1:-1] for x in range(r[0] + 1, r[2])
             for y in range(r[1] + 1, r[3])]
    if info.hazard:
        for x, y in free(rng.randint(3, 7), 3, inner):
            g[y][x] = info.hazard
    for n in range(rng.randint(2, 3)):
        x, y = rng.choice(inner or floor_spots)
        if g[y][x] != "dfloor" or (x, y) == (ex, ey) or (x, y) in end_cells:
            continue
        if "loot:%s:%d:%d:%d" % (lid, level, x, y) in flags:
            g[y][x] = "crate_open"
        else:
            g[y][x] = "crate"
            area.loot.add((x, y))
    lore = LORE.get((lid, level))
    if lore:
        for x, y in free(1, 5, inner):
            area.terminals[(x, y)] = "lore"
            g[y][x] = "terminal" if lid == "tower" else "crate_open"
            area.note = lore
    # evidence, keycards and the core
    for e, place in world["evidence"].items():
        if place == [lid, level] and "evidence:" + e not in flags:
            for x, y in free(1, 8, inner):
                area.terminals[(x, y)] = "evidence:" + e
                g[y][x] = "terminal"
    if (lid, level) == ("tower", 1) and "got:red keycard" not in flags:
        for x, y in free(1, 8):
            area.items[(x, y)] = "keycard"
            area.bodies[(x, y)] = {"who": None, "things": ["red keycard"]}
    if (lid, level) == ("tower", 2) and "got:black keycard" not in flags:
        for x, y in free(1, 10, [c for c in end_cells
                                  if c[0] not in (end[0], end[2]) and
                                  c[1] not in (end[1], end[3])]):
            g[y][x] = "safe"
            area.terminals[(x, y)] = "safe"
    if (lid, level) == ("tower", 3):
        area.core = (ex, ey)
        g[ey][ex] = "server"
        area.terminals[(ex, ey)] = "core"
        def doorway(c):
            return any((c[0] + dx, c[1] + dy) not in end_cells and
                       g[c[1] + dy][c[0] + dx] != "dwall"
                       for dx, dy in DIRS)
        edge = [c for c in end_cells if c != (ex, ey) and not doorway(c) and
                (c[0] in (end[0], end[2]) or c[1] in (end[1], end[3])) and
                not any(doorway((c[0] + dx, c[1] + dy)) for dx, dy in DIRS
                        if (c[0] + dx, c[1] + dy) in end_cells)]
        racks = free(4, 3, edge)
        for x, y in racks:
            g[y][x] = "server"

        def cut_off(people=()):
            """Squares of the core room (or the core itself) you can't
            reach from the stairs."""
            seen, q = {(sx, sy)}, deque([(sx, sy)])
            while q:
                x, y = q.popleft()
                for dx, dy in DIRS:
                    c = (x + dx, y + dy)
                    if c not in seen and c not in people and \
                            g[c[1]][c[0]] in DUNGEON_FLOOR:
                        seen.add(c)
                        q.append(c)
            return [c for c in end_cells if g[c[1]][c[0]] == "dfloor" and
                    c not in seen and c not in people] or (
                        [] if any((ex + dx, ey + dy) in seen
                                  for dx, dy in DIRS) else [(ex, ey)])
        while racks and cut_off():
            x, y = racks.pop()
            g[y][x] = "dfloor"
        if "exec_met" not in flags:
            # the vice president stands well inside the room, never in a
            # doorway, never between you and the core
            middle = [c for c in end_cells if c[0] not in (end[0], end[2])
                      and c[1] not in (end[1], end[3]) and
                      abs(c[0] - ex) + abs(c[1] - ey) > 1]
            area.exec_spot = next(
                (c for c in free(len(middle), 3, middle)
                 if not cut_off({c})), None)
    for x, y in free(rng.randint(1, 2), 4):     # found by searching
        area.hidden[(x, y)] = rng.choice(("coins", "coins", "rations"))
    n = 2 + level
    for x, y in free(n, 7):
        if (x, y) in end_cells and last and info.boss:
            continue
        kinds = info.monsters
        kind = kinds[min(len(kinds) - 1, rng.randrange(1 + level))] \
            if rng.random() < 0.7 else rng.choice(kinds)
        area.mobs.append(make_monster(kind, x, y, rng=rng))
    area.free_spots = [p for p in free(6, 8)]
    return area


